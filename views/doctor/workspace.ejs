            <div class="form-group">
              <label class="small font-weight-bold">Plan of Treatment</label>
              <textarea name="plan_of_treatment" class="form-control form-control-sm" rows="2">${escapeHtml(it.plan_of_treatment || '')}</textarea>
            </div>

            <div class="doc-section-title"><i class="fas fa-calculator mr-1"></i> Wells Model for Predicting DVT Probability (Page 3)</div>
            <div class="p-2 border rounded bg-light mb-2 small">
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_active_cancer" ${w.active_cancer ? 'checked' : ''}/> Active cancer (ongoing, within 6 months or palliative) (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_paralysis" ${w.paralysis ? 'checked' : ''}/> Paralysis, paresis or recent plaster immobilisation of lower extremity (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_bedridden" ${w.bedridden ? 'checked' : ''}/> Bedridden for ≥3 days, or major surgery within 12 weeks (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_tenderness" ${w.tenderness ? 'checked' : ''}/> Localised tenderness along distribution of deep venous system (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_entire_leg_swollen" ${w.entire_leg_swollen ? 'checked' : ''}/> Entire leg swollen (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_calf_swelling" ${w.calf_swelling ? 'checked' : ''}/> Calf swelling ≥3cm larger than asymptomatic side (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_pitting_oedema" ${w.pitting_oedema ? 'checked' : ''}/> Pitting oedema confined to symptomatic leg (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_superficial_veins" ${w.superficial_veins ? 'checked' : ''}/> Collateral superficial veins (non-varicose) (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="1" name="w_prev_dvt" ${w.prev_dvt ? 'checked' : ''}/> Previously documented DVT (+1)</label>
              <label class="d-block mb-1"><input type="checkbox" class="wells-item" data-points="-2" name="w_alt_diagnosis" ${w.alt_diagnosis ? 'checked' : ''}/> Alternative diagnosis at least as likely as DVT (-2)</label>
              <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                <span>Calculated Wells Score: <b id="wells_score_val">${w.total_score ?? 0}</b></span>
                <span id="wells_risk_label" class="badge ${ (w.total_score ?? 0) >= 2 ? 'badge-danger' : 'badge-success'}">${ (w.total_score ?? 0) >= 2 ? 'DVT Likely (≥2)' : 'DVT Unlikely (<2)'}</span>
              </div>
            </div>

            <div class="doc-section-title"><i class="fas fa-file-signature mr-1"></i> Informant Declaration (Gujarati &amp; English)</div>
            <div class="p-2 border rounded bg-light small mb-2">
              <p class="mb-1 text-muted">દર્દી / સંબંધી / દર્દીને લાવેલ વ્યક્તિ: મારી હાલની તથા ભૂતકાળની બીમારી મેં ઉપર જણાવેલ સંપૂર્ણ માહિતી મેં આપેલ છે.</p>
              <div class="form-row">
                <div class="form-group col-md-6"><label class="small font-weight-bold">Informant Name</label><input type="text" name="informant_name" class="form-control form-control-sm" value="${escapeHtml(dec.name || '')}"/></div>
                <div class="form-group col-md-6"><label class="small font-weight-bold">Signature / Relation</label><input type="text" name="informant_relation" class="form-control form-control-sm" value="${escapeHtml(dec.relation || 'Self')}"/></div>
              </div>
            </div>
          </form>
          `
        );

        // Auto BMI calculation
        $('#calc_wt, #calc_ht').on('input', function() {
          const w = parseFloat($('#calc_wt').val());
          const h = parseFloat($('#calc_ht').val()) / 100;
          if (w > 0 && h > 0) {
            $('#calc_bmi').val((w / (h * h)).toFixed(1));
          }
        });

        // Live Wells Calculator
        $('.wells-item').on('change', function() {
          let score = 0;
          $('.wells-item:checked').each(function() {
            score += parseInt($(this).data('points'), 10);
          });
          $('#wells_score_val').text(score);
          if (score >= 2) {
            $('#wells_risk_label').attr('class', 'badge badge-danger').text('DVT Likely (≥2)');
          } else {
            $('#wells_risk_label').attr('class', 'badge badge-success').text('DVT Unlikely (<2)');
          }
        });
      }

