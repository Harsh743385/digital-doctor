              </div>
            </div>
            <div class="form-group">
              <label class="small font-weight-bold">Adverse Reaction Status</label>
              <select name="adverse_reaction_flag" class="form-control form-control-sm">
                <option value="No Adverse Reaction">No Adverse Reaction</option>
                <option value="Adverse Reaction">Adverse Reaction Observed (See protocol)</option>
              </select>
            </div>
          </form>
          `
        );
      }

      // Save handler for all forms
      function saveCurrent() {
        let formId = '';
        let url = '';

        if (activeTab === 'initial' || activeTab === 'dvt') {
          formId = '#docInitialForm';
          url = DOC_URLS.initial.save;
          const form = $(formId);
          if (!form.length) return;

          // Assemble JSON payloads for rich models
          let wellsScore = 0;
          form.find('.wells-item:checked').each(function() { wellsScore += parseInt($(this).data('points'), 10); });

          const payload = {
            id: form.find('[name="id"]').val() || undefined,
            assessment_date: form.find('[name="assessment_date"]').val(),
            assessment_time: form.find('[name="assessment_time"]').val(),
            department: form.find('[name="department"]').val(),
            admitting_consultant: form.find('[name="admitting_consultant"]').val(),
            allergies: {
              blood_transfusion: form.find('[name="allergies_blood"]').is(':checked'),
              drug: form.find('[name="allergies_drug"]').is(':checked'),
              food: form.find('[name="allergies_food"]').is(':checked'),
              not_known: form.find('[name="allergies_not_known"]').is(':checked'),
              others: form.find('[name="allergies_others"]').is(':checked'),
              others_detail: form.find('[name="allergies_others_detail"]').val()
            },
            chief_complaints: form.find('[name="chief_complaints"]').val(),
            past_history_illness: form.find('[name="past_history_illness"]').val(),
            diet: form.find('[name="diet"]').val(),
            physical_activity: form.find('[name="physical_activity"]').val(),
            habit_history: {
              cig: { opt: form.find('[name="habit_cig_opt"]').val(), since: form.find('[name="habit_cig_since"]').val(), freq: form.find('[name="habit_cig_freq"]').val(), quit: form.find('[name="habit_cig_quit"]').val() },
              tob: { opt: form.find('[name="habit_tob_opt"]').val(), since: form.find('[name="habit_tob_since"]').val(), freq: form.find('[name="habit_tob_freq"]').val(), quit: form.find('[name="habit_tob_quit"]').val() },
              alc: { opt: form.find('[name="habit_alc_opt"]').val(), since: form.find('[name="habit_alc_since"]').val(), freq: form.find('[name="habit_alc_freq"]').val(), quit: form.find('[name="habit_alc_quit"]').val() },
              drg: { opt: form.find('[name="habit_drg_opt"]').val(), since: form.find('[name="habit_drg_since"]').val(), freq: form.find('[name="habit_drg_freq"]').val(), quit: form.find('[name="habit_drg_quit"]').val() }
            },
            past_medical_history: {
              htn: { opt: form.find('[name="med_htn_opt"]').val(), since: form.find('[name="med_htn_since"]').val(), th: form.find('[name="med_htn_th"]').val() },
              dm:  { opt: form.find('[name="med_dm_opt"]').val(), since: form.find('[name="med_dm_since"]').val(), th: form.find('[name="med_dm_th"]').val() },
              cad: { opt: form.find('[name="med_cad_opt"]').val(), since: form.find('[name="med_cad_since"]').val(), th: form.find('[name="med_cad_th"]').val() },
              copd:{ opt: form.find('[name="med_copd_opt"]').val(), since: form.find('[name="med_copd_since"]').val(), th: form.find('[name="med_copd_th"]').val() },
              tb:  { opt: form.find('[name="med_tb_opt"]').val(), since: form.find('[name="med_tb_since"]').val(), th: form.find('[name="med_tb_th"]').val() },
              ca:  { opt: form.find('[name="med_ca_opt"]').val(), since: form.find('[name="med_ca_since"]').val(), th: form.find('[name="med_ca_th"]').val() }
            },
            general_exam: {
              spo2: form.find('[name="g_spo2"]').val(),
              temp: form.find('[name="g_temp"]').val(),
              pulse: form.find('[name="g_pulse"]').val(),
              bp: form.find('[name="g_bp"]').val(),
              rr: form.find('[name="g_rr"]').val(),
              weight: form.find('[name="g_weight"]').val(),
              height: form.find('[name="g_height"]').val(),
              bmi: form.find('[name="g_bmi"]').val(),
              pain_score: form.find('[name="g_pain_score"]').val(),
              pain_location: form.find('[name="g_pain_location"]').val()
            },
            systemic_exam: {
              cvs:  { nad: form.find('[name="s_cvs_nad"]').is(':checked'), findings: form.find('[name="s_cvs_find"]').val() },
              resp: { nad: form.find('[name="s_resp_nad"]').is(':checked'), findings: form.find('[name="s_resp_find"]').val() },
              cns:  { nad: form.find('[name="s_cns_nad"]').is(':checked'), findings: form.find('[name="s_cns_find"]').val() },
              gi:   { nad: form.find('[name="s_gi_nad"]').is(':checked'), findings: form.find('[name="s_gi_find"]').val() },
              gu:   { nad: form.find('[name="s_gu_nad"]').is(':checked'), findings: form.find('[name="s_gu_find"]').val() }
            },
            provisional_diagnosis: form.find('[name="provisional_diagnosis"]').val(),
            investigations_advised: form.find('[name="investigations_advised"]').val(),
            plan_of_treatment: form.find('[name="plan_of_treatment"]').val(),
            wells_dvt: {
              active_cancer: form.find('[name="w_active_cancer"]').is(':checked'),
              paralysis: form.find('[name="w_paralysis"]').is(':checked'),
              bedridden: form.find('[name="w_bedridden"]').is(':checked'),
              tenderness: form.find('[name="w_tenderness"]').is(':checked'),
              entire_leg_swollen: form.find('[name="w_entire_leg_swollen"]').is(':checked'),
              calf_swelling: form.find('[name="w_calf_swelling"]').is(':checked'),
              pitting_oedema: form.find('[name="w_pitting_oedema"]').is(':checked'),
              superficial_veins: form.find('[name="w_superficial_veins"]').is(':checked'),
              prev_dvt: form.find('[name="w_prev_dvt"]').is(':checked'),
              alt_diagnosis: form.find('[name="w_alt_diagnosis"]').is(':checked'),
              total_score: wellsScore
            },
            informant_declaration: {
              name: form.find('[name="informant_name"]').val(),
              relation: form.find('[name="informant_relation"]').val()
            }
          };

          docApi(url, payload).done(r => {
            toastr.success(r.msg || 'Saved successfully');
            closeDocDrawer();
            renderFeature();
          }).fail(e => toastr.error(e.responseJSON?.msg || 'Error saving record'));
          return;
        }

        if (activeTab === 'progress') { formId = '#docNoteForm'; url = DOC_URLS.progress.save; }
        if (activeTab === 'crossref') { formId = '#docCrossrefForm'; url = DOC_URLS.crossref.save; }
        if (activeTab === 'mohandover') { formId = '#docMoHandoverForm'; url = DOC_URLS.mohandover.save; }
        if (activeTab === 'sbar') { formId = '#docSbarForm'; url = DOC_URLS.sbar.save; }
        if (activeTab === 'blood') { formId = '#docBloodForm'; url = DOC_URLS.blood.save; }

        const form = $(formId);
        if (!form.length) return;
        const serialized = {};
        form.serializeArray().forEach(it => { serialized[it.name] = it.value; });

        docApi(url, serialized).done(r => {
          toastr.success(r.msg || 'Record saved successfully');
          closeDocDrawer();
          renderFeature();
        }).fail(e => toastr.error(e.responseJSON?.msg || 'Error saving record'));
      }

      // Delete handlers
      function deleteNote(id) {
        Swal.fire({ title: 'Delete note?', text: 'Cannot be undone', icon: 'warning', showCancelButton: true }).then(r => {
          if (r.isConfirmed) docApi(DOC_URLS.progress.del, { id }).done(() => renderFeature());
        });
      }
      function deleteCrossref(id) {
        Swal.fire({ title: 'Delete referral?', icon: 'warning', showCancelButton: true }).then(r => {
          if (r.isConfirmed) docApi(DOC_URLS.crossref.del, { id }).done(() => renderFeature());
        });
      }
      function deleteMoHandover(id) {
        Swal.fire({ title: 'Delete handover?', icon: 'warning', showCancelButton: true }).then(r => {
          if (r.isConfirmed) docApi(DOC_URLS.mohandover.del, { id }).done(() => renderFeature());
        });
      }
      function deleteSbar(id) {
        Swal.fire({ title: 'Delete SBAR record?', icon: 'warning', showCancelButton: true }).then(r => {
          if (r.isConfirmed) docApi(DOC_URLS.sbar.del, { id }).done(() => renderFeature());
        });
      }
      function deleteBlood(id) {
        Swal.fire({ title: 'Delete Blood Transfusion record?', icon: 'warning', showCancelButton: true }).then(r => {
          if (r.isConfirmed) docApi(DOC_URLS.blood.del, { id }).done(() => renderFeature());
        });
      }

      // Initialize
      $(document).ready(function() {
        $('#docTabs .pill').on('click', function() {
          switchTab($(this).data('tab'));
        });
        renderFeature();
      });

      return {
        getActiveTab,
        switchTab,
        openPdfPrint,
        openInitialAssessmentForm,
        openNewProgressNote,
        openCrossReferenceForm,
        openMoHandoverForm,
        openSbarForm,
        openBloodTransfusionForm,
        saveCurrent,
        deleteNote,
        deleteCrossref,
        deleteMoHandover,
        deleteSbar,
        deleteBlood
      };
    })();
  </script>
</body>
</html>

