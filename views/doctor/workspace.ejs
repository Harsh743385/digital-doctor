<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <style>
    :root {
      --doc-blue: #0284C7;
      --doc-blue-d: #0369A1;
      --doc-blue-l: #F0F9FF;
      --doc-blue-bd: #BAE6FD;
    }
    #doc-embed-root { background: var(--grey-50); color: var(--grey-900); font-family: 'Inter', 'Segoe UI', Arial, sans-serif; }
    html.drawer-open, body.drawer-open { overflow: hidden !important; }
    #doc-embed-root .doc-shell { padding: 14px 18px 60px; max-width: 100%; margin: 0; }

    /* Doctor Pill Tabs Navigation */
    .doc-pills {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 10px;
      padding: 14px;
      background: #fff;
      border: 1px solid var(--grey-200);
      border-radius: 14px;
      list-style: none;
      margin: 0;
    }
    .doc-pills li { list-style: none; }
    .doc-pills .pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 999px;
      background: #fff;
      border: 1px solid var(--grey-200);
      color: var(--grey-700);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      transition: all 0.15s ease;
      text-align: center;
    }
    .doc-pills .pill:hover {
      border-color: var(--doc-blue);
      color: var(--doc-blue-d);
      background: var(--doc-blue-l);
    }
    .doc-pills .pill.active {
      background: linear-gradient(135deg, var(--doc-blue), var(--doc-blue-d));
      color: #fff;
      border-color: var(--doc-blue);
      box-shadow: 0 4px 10px rgba(2, 132, 199, 0.25);
    }

    /* Cards & Section Panels */
    .dcard {
      background: #fff;
      border: 1px solid var(--grey-200);
      border-radius: 14px;
      margin-top: 14px;
      box-shadow: var(--shadow-sm);
    }
    .dcard-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--grey-200);
      flex-wrap: wrap;
      gap: 12px;
      background: #fafbfc;
      border-top-left-radius: 14px;
      border-top-right-radius: 14px;
    }
    .dcard-head h4 { font-size: 16px; font-weight: 800; margin: 0; color: var(--grey-900); }
    .dcard-body { padding: 22px; min-height: 380px; }

    /* Patient Switcher Header */
    .patient-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 14px;
      background: #fff;
      border: 1px solid var(--grey-200);
      border-radius: 14px;
      padding: 14px 18px;
      box-shadow: var(--shadow-sm);
    }

    /* Custom Doctor Form Tables */
    .table-doc {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 16px;
      border: 1px solid var(--grey-200);
    }
    .table-doc th {
      background: #f1f5f9;
      color: var(--grey-700);
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 8px 10px;
      border: 1px solid var(--grey-200);
    }
    .table-doc td {
      padding: 8px 10px;
      border: 1px solid var(--grey-200);
      font-size: 13px;
      vertical-align: middle;
    }

    /* Form section banners */
    .doc-section-title {
      font-size: 13px;
      font-weight: 800;
      color: var(--doc-blue-d);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 2px solid var(--doc-blue-bd);
      padding-bottom: 4px;
      margin: 22px 0 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Drawer */
    .drawer-backdrop { position: fixed; inset: 0; background: rgba(15, 23, 42, .45); z-index: 1040; display: none; }
    .drawer-backdrop.open { display: block; }
    .drawer {
      position: fixed; top: 0; right: -850px; height: 100%; width: min(850px, 95vw);
      background: #fff; box-shadow: -8px 0 24px rgba(0,0,0,.18); z-index: 1050;
      display: flex; flex-direction: column; transition: right .25s ease;
    }
    .drawer.open { right: 0; }
    .drawer-head {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 22px; border-bottom: 1px solid var(--grey-200); background: #fafbfc;
    }
    .drawer-head h4 { margin: 0; font-size: 17px; font-weight: 800; color: var(--grey-900); }
    .drawer-head .sub { font-size: 12px; color: var(--grey-500); margin-top: 2px; }
    .drawer-body { flex: 1; overflow-y: auto; padding: 22px; }
    .drawer-foot {
      padding: 14px 22px; border-top: 1px solid var(--grey-200);
      display: flex; gap: 10px; justify-content: flex-end; background: #fafbfc;
    }

    /* Score badges */
    .score-badge-likely { background: #fee2e2; color: #b91c1c; font-weight: 700; border-radius: 6px; padding: 4px 10px; }
    .score-badge-unlikely { background: #dcfce7; color: #15803d; font-weight: 700; border-radius: 6px; padding: 4px 10px; }
  </style>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div id="doc-embed-root">
    <div class="doc-shell">
      <!-- Patient Information & Switcher Banner -->
      <div class="patient-banner">
        <div style="display:flex; align-items:center; gap:14px;">
          <div style="width:48px;height:48px;background:linear-gradient(135deg, var(--doc-blue), var(--doc-blue-d));color:#fff;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 10px rgba(2,132,199,.3);">
            <i class="fas fa-user-md"></i>
          </div>
          <div>
            <div style="font-size:17px;font-weight:800;color:var(--grey-900);">
              <%= patient.full_name %>
              <span class="badge badge-primary font-weight-bold ml-2">Digital Doctor Station</span>
            </div>
            <div style="font-size:12.5px;color:var(--grey-500);margin-top:2px;">
              UHID: <b><%= patient.uhid %></b> &nbsp;·&nbsp;
              IPD: <b><%= patient.ipd_number %></b> &nbsp;·&nbsp;
              <%= patient.age %> &nbsp;·&nbsp; <%= patient.gender %> &nbsp;·&nbsp;
              <span class="badge badge-light font-weight-bold"><%= patient.ward || 'Special Ward' %> (<%= patient.bed_number || 'SW-01' %>)</span>
              &nbsp;·&nbsp; Consultant: <b><%= patient.admitting_consultant || 'Dr. Sanghavi' %></b>
            </div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <!-- Patient Switcher Dropdown -->
          <div class="dropdown">
            <button class="btn btn-soft btn-sm dropdown-toggle font-weight-bold" type="button" data-toggle="dropdown">
              <i class="fas fa-users mr-1"></i> Switch Patient (<%= allPatients.length %>)
            </button>
            <div class="dropdown-menu dropdown-menu-right" style="min-width: 280px; max-height: 350px; overflow-y: auto;">
              <h6 class="dropdown-header text-uppercase font-weight-bold">Select In-Patient</h6>
              <% allPatients.forEach(p => { %>
                <a class="dropdown-item d-flex justify-content-between align-items-center <%= p.id == patient.id ? 'active font-weight-bold' : '' %>"
                   href="/cms/digital-doctor?patient_id=<%= p.id %>">
                  <div>
                    <div><%= p.full_name %></div>
                    <small class="text-muted"><%= p.uhid %> · <%= p.bed_number %></small>
                  </div>
                  <% if (p.id == patient.id) { %>
                    <i class="fas fa-check"></i>
                  <% } %>
                </a>
              <% }) %>
            </div>
          </div>

          <a href="/cms/digital-nursing?patient_id=<%= patient.id %>" class="btn btn-soft btn-sm text-teal font-weight-bold">
            <i class="fas fa-user-nurse mr-1"></i> Nursing Chart
          </a>

          <button id="btnPrintOfficialPdf" class="btn btn-danger btn-sm font-weight-bold" onclick="DigitalDoctor.openPdfPrint()">
            <i class="fas fa-file-pdf mr-1"></i> Print Official PDF Form
          </button>
        </div>
      </div>

      <!-- 7 Digital Doctor Submodules Navigation Tabs -->
      <ul class="doc-pills" id="docTabs">
        <li><div class="pill active" data-tab="initial"><i class="fas fa-stethoscope"></i> Initial Assessment</div></li>
        <li><div class="pill" data-tab="progress"><i class="fas fa-file-medical-alt"></i> Consultant Notes</div></li>
        <li><div class="pill" data-tab="crossref"><i class="fas fa-exchange-alt"></i> Cross Reference Visit</div></li>
        <li><div class="pill" data-tab="mohandover"><i class="fas fa-clipboard-list"></i> MO Handover Sheet</div></li>
        <li><div class="pill" data-tab="sbar"><i class="fas fa-project-diagram"></i> Doctor SBAR Handover</div></li>
        <li><div class="pill" data-tab="dvt"><i class="fas fa-calculator"></i> DVT Risk Score</div></li>
        <li><div class="pill" data-tab="blood"><i class="fas fa-tint"></i> Blood Transfusion</div></li>
      </ul>

      <!-- Main Clinical Card -->
      <div class="dcard">
        <div class="dcard-head">
          <h4 id="dcardTitle">Doctor Initial Assessment on Admission</h4>
          <div class="actions" id="dcardActions"></div>
        </div>
        <div class="dcard-body">
          <div id="docFeatureBody"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Slide-In Drawer for Recording/Editing Doctor Forms -->
  <div class="drawer-backdrop" id="docDrawerBackdrop"></div>
  <div class="drawer" id="docDrawer">
    <div class="drawer-head">
      <div>
        <h4 id="docDrawerTitle">Doctor Form Entry</h4>
        <div class="sub" id="docDrawerSub">Anand Surgical Hospital Pvt Ltd</div>
      </div>
      <button type="button" class="btn btn-soft btn-icon" onclick="closeDocDrawer()"><i class="fas fa-times"></i></button>
    </div>
    <div class="drawer-body" id="docDrawerBody"></div>
    <div class="drawer-foot">
      <button type="button" class="btn btn-soft" onclick="closeDocDrawer()">Cancel</button>
      <button type="button" class="btn btn-primary font-weight-bold" id="docDrawerSaveBtn" onclick="DigitalDoctor.saveCurrent()">
        <i class="fas fa-save mr-1"></i> Save Clinical Record
      </button>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <!-- Presco Digital Doctor Client Script -->
  <script>
    const PID = <%= patient.id %>;
    const HID = <%= hospital.id %>;
    const PNM = "<%= patient.full_name %>";
    const PUHID = "<%= patient.uhid %>";
    const PIPD = "<%= patient.ipd_number %>";
    const PBED = "<%= patient.bed_number || 'SW-01' %>";
    const PWARD = "<%= patient.ward || 'Special Ward' %>";
    const CSRF = $('meta[name="csrf-token"]').attr('content');

    const DOC_URLS = {
      initial:   { list: "/cms/ajax/doctor/assessment/list", save: "/cms/ajax/doctor/assessment/save", del: "/cms/ajax/doctor/assessment/delete" },
      progress:  { list: "/cms/ajax/doctor/notes/list", save: "/cms/ajax/doctor/notes/save", del: "/cms/ajax/doctor/notes/delete" },
      crossref:  { list: "/cms/ajax/doctor/cross-reference/list", save: "/cms/ajax/doctor/cross-reference/save", del: "/cms/ajax/doctor/cross-reference/delete" },
      mohandover:{ list: "/cms/ajax/doctor/mo-handover/list", save: "/cms/ajax/doctor/mo-handover/save", del: "/cms/ajax/doctor/mo-handover/delete" },
      sbar:      { list: "/cms/ajax/doctor/sbar/list", save: "/cms/ajax/doctor/sbar/save", del: "/cms/ajax/doctor/sbar/delete" },
      blood:     { list: "/cms/ajax/doctor/blood-transfusion/list", save: "/cms/ajax/doctor/blood-transfusion/save", del: "/cms/ajax/doctor/blood-transfusion/delete" }
    };

    function docApi(url, data, method) {
      return $.ajax({
        url,
        type: method || 'POST',
        data: $.extend({ _token: CSRF, hospital_id: HID, patient_id: PID }, data || {})
      });
    }

    function openDocDrawer(title, sub, bodyHtml) {
      $('#docDrawerTitle').text(title);
      $('#docDrawerSub').text(sub || (PNM + ' (UHID: ' + PUHID + ')'));
      $('#docDrawerBody').html(bodyHtml);
      $('#docDrawer').addClass('open');
      $('#docDrawerBackdrop').addClass('open');
      $('html, body').addClass('drawer-open');
    }

    function closeDocDrawer() {
      $('#docDrawer').removeClass('open');
      $('#docDrawerBackdrop').removeClass('open');
      $('#docDrawerBody').empty();
      $('html, body').removeClass('drawer-open');
    }
    $(document).on('click', '#docDrawerBackdrop', closeDocDrawer);

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Digital Doctor Core Controller ──
    const DigitalDoctor = (function() {
      let activeTab = 'initial';
      let activeRecordCache = null;

      function getActiveTab() { return activeTab; }

      function setHead(title, actionsHtml) {
        $('#dcardTitle').text(title);
        $('#dcardActions').html(actionsHtml || '');
      }

      function switchTab(name) {
        activeTab = name;
        $('#docTabs .pill').removeClass('active');
        $(`#docTabs .pill[data-tab="${name}"]`).addClass('active');
        renderFeature();
      }

      function openPdfPrint() {
        let formType = 'initial-assessment';
        if (activeTab === 'progress') formType = 'progress-notes';
        if (activeTab === 'crossref') formType = 'cross-reference';
        if (activeTab === 'mohandover') formType = 'mo-handover';
        if (activeTab === 'sbar') formType = 'sbar-handover';
        if (activeTab === 'blood') formType = 'blood-transfusion';
        if (activeTab === 'dvt') formType = 'initial-assessment';

        window.open(`/cms/ajax/doctor/print/${formType}?patient_id=${PID}`, '_blank');
      }

      function renderFeature() {
        const body = $('#docFeatureBody').html('<div class="text-center p-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>');

        switch (activeTab) {
          case 'initial':
            setHead(
              'Doctor Initial Assessment on Admission (PDF Pages 1–3)',
              `<button class="btn btn-primary btn-sm font-weight-bold" onclick="DigitalDoctor.openInitialAssessmentForm()">
                <i class="fas fa-edit mr-1"></i> Edit / Record Assessment
               </button>
               <button class="btn btn-outline-danger btn-sm font-weight-bold ml-2" onclick="DigitalDoctor.openPdfPrint()">
                <i class="fas fa-print mr-1"></i> Print Form
               </button>`
            );
            docApi(DOC_URLS.initial.list).done(r => {
              body.empty();
              if (!r.data || r.data.length === 0) {
                body.html(`
                  <div class="text-center p-5 text-muted">
                    <i class="fas fa-stethoscope fa-3x mb-3 text-primary opacity-50"></i>
                    <h5>No Doctor Initial Assessment recorded yet for this patient.</h5>
                    <p class="text-secondary">Capture full admission clinical history, habits, past medical, general examination, systemic review, and Wells DVT risk score.</p>
                    <button class="btn btn-primary btn-sm mt-2 font-weight-bold" onclick="DigitalDoctor.openInitialAssessmentForm()">
                      <i class="fas fa-plus mr-1"></i> Start Initial Assessment
                    </button>
                  </div>
                `);
                return;
              }
              const it = r.data[0];
              activeRecordCache = it;
              renderInitialAssessmentView(body, it);
            });
            break;

          case 'progress':
            setHead(
              "Attending Consultant's Notes / Progress Notes (PDF Page 4 - ASH/115/F)",
              `<button class="btn btn-primary btn-sm font-weight-bold" onclick="DigitalDoctor.openNewProgressNote()">
                <i class="fas fa-plus mr-1"></i> Add Consultant Note
               </button>
               <button class="btn btn-outline-danger btn-sm font-weight-bold ml-2" onclick="DigitalDoctor.openPdfPrint()">
                <i class="fas fa-print mr-1"></i> Print ASH/115/F
               </button>`
            );
            docApi(DOC_URLS.progress.list).done(r => {
              body.empty();
              if (!r.data || r.data.length === 0) {
                body.html(`
                  <div class="text-center p-5 text-muted">
                    <i class="fas fa-file-medical-alt fa-3x mb-3 text-primary opacity-50"></i>
                    <h5>No Consultant Notes recorded for this admission.</h5>
                    <button class="btn btn-primary btn-sm mt-2 font-weight-bold" onclick="DigitalDoctor.openNewProgressNote()">
                      <i class="fas fa-plus mr-1"></i> Add First Note
                    </button>
                  </div>
                `);
                return;
              }
              let html = `
                <table class="table-doc">
                  <thead>
                    <tr>
                      <th style="width:110px;">Date</th>
                      <th style="width:90px;">Time</th>
                      <th>Particulars (Clinical Notes & Recommendations)</th>
                      <th style="width:160px;">Consultant Signature</th>
                      <th style="width:60px;">Action</th>
                    </tr>
                  </thead>
                  <tbody>
              `;
              r.data.forEach(n => {
                html += `
                  <tr>
                    <td><b>${n.note_date}</b></td>
                    <td>${n.note_time}</td>
                    <td style="white-space: pre-wrap;">${escapeHtml(n.particulars)}</td>
                    <td><span class="badge badge-light border font-weight-bold text-primary"><i class="fas fa-signature mr-1"></i>${escapeHtml(n.signature || n.consultant_name)}</span></td>
                    <td>
                      <button class="btn btn-soft btn-sm text-danger" onclick="DigitalDoctor.deleteNote(${n.id})"><i class="fas fa-trash"></i></button>
                    </td>
                  </tr>
                `;
              });
              html += '</tbody></table>';
              body.html(html);
            });
            break;

          case 'crossref':
            setHead(
              "Cross Reference Visit Notes (PDF Pages 5–6 - ASH/130/F & ASH 130/B)",
              `<button class="btn btn-primary btn-sm font-weight-bold" onclick="DigitalDoctor.openCrossReferenceForm()">
                <i class="fas fa-plus mr-1"></i> New Cross Reference
               </button>
               <button class="btn btn-outline-danger btn-sm font-weight-bold ml-2" onclick="DigitalDoctor.openPdfPrint()">
                <i class="fas fa-print mr-1"></i> Print Referral Note
               </button>`
            );
            docApi(DOC_URLS.crossref.list).done(r => {
              body.empty();
              if (!r.data || r.data.length === 0) {
                body.html(`
                  <div class="text-center p-5 text-muted">
                    <i class="fas fa-exchange-alt fa-3x mb-3 text-primary opacity-50"></i>
                    <h5>No cross reference / specialty referral recorded.</h5>
                    <button class="btn btn-primary btn-sm mt-2 font-weight-bold" onclick="DigitalDoctor.openCrossReferenceForm()">
                      <i class="fas fa-plus mr-1"></i> Create Cross Reference
                    </button>
                  </div>
                `);
                return;
              }
              r.data.forEach(x => {
                body.append(`
                  <div class="p-3 mb-3 border rounded bg-white shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-user-md mr-1"></i> ${escapeHtml(x.referred_consultant_name || 'Specialist Referral')} 
                        <span class="badge badge-info ml-2">${x.speciality || 'Specialty'}</span>
                        <span class="badge ${x.cross_reference_type === 'Emergency' ? 'badge-danger' : 'badge-light border'}">${x.cross_reference_type}</span>
                      </h6>
                      <div>
                        <span class="text-muted small mr-2">Visit: <b>${x.visit_date || '—'} ${x.visit_time || ''}</b></span>
                        <button class="btn btn-soft btn-sm text-danger" onclick="DigitalDoctor.deleteCrossref(${x.id})"><i class="fas fa-trash"></i></button>
                      </div>
                    </div>
                    <div class="small mb-2"><b>Reason:</b> ${escapeHtml(x.reason_for_cross_reference)}</div>
                    <div class="p-2 rounded bg-light small mb-2">
                      <b>Referred Doctor's Notes:</b><br/>
                      <span style="white-space: pre-wrap;">${escapeHtml(x.referred_doctor_notes || 'Pending visit note')}</span>
                    </div>
                    <div class="row small">
                      <div class="col-md-6"><b>Impression:</b> ${escapeHtml(x.impression || '—')}</div>
                      <div class="col-md-6"><b>Advice:</b> ${escapeHtml(x.advice || '—')}</div>
                    </div>
                    <div class="mt-2 text-muted small border-top pt-2 d-flex justify-content-between">
                      <span>Disposition: <b>${x.refer_again_status || 'The Patient does not need to be referred again.'}</b></span>
                      <span>Referring Consultant: <b>${escapeHtml(x.referring_consultant_name || 'Attending')}</b></span>
                    </div>
                  </div>
                `);
              });
            });
            break;

          case 'mohandover':
            setHead(
              "Medical Officer Hand Over Sheet (PDF Page 7 - ASH/240/F)",
              `<button class="btn btn-primary btn-sm font-weight-bold" onclick="DigitalDoctor.openMoHandoverForm()">
                <i class="fas fa-plus mr-1"></i> New MO Shift Handover
               </button>
               <button class="btn btn-outline-danger btn-sm font-weight-bold ml-2" onclick="DigitalDoctor.openPdfPrint()">
                <i class="fas fa-print mr-1"></i> Print Handover Sheet
               </button>`
            );
            docApi(DOC_URLS.mohandover.list).done(r => {
              body.empty();
              if (!r.data || r.data.length === 0) {
                body.html(`
                  <div class="text-center p-5 text-muted">
                    <i class="fas fa-clipboard-list fa-3x mb-3 text-primary opacity-50"></i>
                    <h5>No MO Shift Handovers logged yet.</h5>
                    <button class="btn btn-primary btn-sm mt-2 font-weight-bold" onclick="DigitalDoctor.openMoHandoverForm()">
                      <i class="fas fa-plus mr-1"></i> Record Shift Handover
                    </button>
                  </div>
                `);
                return;
              }
              r.data.forEach(h => {
                body.append(`
                  <div class="p-3 mb-3 border rounded bg-white shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <h6 class="m-0 font-weight-bold">Date: ${h.handover_date} · Patient: ${escapeHtml(h.patient_name || PNM)}</h6>
                      <button class="btn btn-soft btn-sm text-danger" onclick="DigitalDoctor.deleteMoHandover(${h.id})"><i class="fas fa-trash"></i></button>
                    </div>
                    <div class="small text-muted mb-2">Diagnosis: <b>${escapeHtml(h.diagnosis || '—')}</b> | Recorded by: <b>${escapeHtml(h.recorded_by || 'MO')}</b></div>
                    <div class="row">
                      <div class="col-md-4 mb-2">
                        <div class="p-2 border rounded bg-light" style="min-height: 120px;">
                          <b class="text-primary small text-uppercase">Morning Shift:</b>
                          <div class="small mt-1" style="white-space: pre-wrap;">${escapeHtml(h.morning_shift_notes || '—')}</div>
                        </div>
                      </div>
                      <div class="col-md-4 mb-2">
                        <div class="p-2 border rounded bg-light" style="min-height: 120px;">
                          <b class="text-warning small text-uppercase">Evening Shift:</b>
                          <div class="small mt-1" style="white-space: pre-wrap;">${escapeHtml(h.evening_shift_notes || '—')}</div>
                        </div>
                      </div>
                      <div class="col-md-4 mb-2">
                        <div class="p-2 border rounded bg-light" style="min-height: 120px;">
                          <b class="text-dark small text-uppercase">Night Shift:</b>
