                      <div class="small mt-1 text-muted">Stratification: <b class="${isLikely ? 'text-danger' : 'text-success'}">${isLikely ? 'DVT Likely (≥ 2 points)' : 'DVT Unlikely (< 2 points)'}</b></div>
                    </div>
                    <button class="btn btn-primary btn-sm" onclick="DigitalDoctor.openInitialAssessmentForm('wells-section')">Update Score</button>
                  </div>
