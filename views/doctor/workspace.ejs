                    <tr><td>Recently bedridden for ≥3 days, or major surgery within 12 weeks requiring anaesthesia</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.bedridden ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Localised tenderness along the distribution of the deep venous system</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.tenderness ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Entire leg swollen</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.entire_leg_swollen ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Calf swelling at least 3cm larger than asymptomatic side</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.calf_swelling ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Pitting oedema confined to the symptomatic leg</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.pitting_oedema ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Collateral superficial veins (non-varicose)</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.superficial_veins ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>Previously documented DVT</td><td class="text-center font-weight-bold">1</td><td class="text-center">${w.prev_dvt ? '<i class="fas fa-check text-danger"></i> Yes' : 'No'}</td></tr>
                    <tr><td>An alternative diagnosis is at least as likely as DVT</td><td class="text-center font-weight-bold">-2</td><td class="text-center">${w.alt_diagnosis ? '<i class="fas fa-check text-success"></i> Yes (-2)' : 'No'}</td></tr>
                  </tbody>
                </table>
              `);
