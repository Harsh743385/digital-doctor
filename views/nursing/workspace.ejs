          <div class="input-grid cols-2">
            <div><label class="form-label">Time</label><input type="time" name="record_time" class="form-control" value="${nowHM()}"></div>
            <div><label class="form-label">Test Type</label><select name="test_type" class="form-control"><option>Fasting (F)</option><option>Post-Prandial (PP)</option><option selected>Random (RBS)</option><option>Pre-Dinner</option></select></div>
          </div>
          <div class="form-group mt-3">
            <label class="form-label">Glucose Value (mg/dL) *</label>
            <input type="number" step="0.1" name="glucose_value" class="form-control" placeholder="e.g. 135" required>
          </div>
          <div class="section-title">Insulin Administration (If Applicable)</div>
          <div class="input-grid cols-2">
            <div><label class="form-label">Insulin Type</label><input type="text" name="insulin_type" class="form-control" placeholder="e.g. Regular Human Insulin"></div>
            <div><label class="form-label">Insulin Dose</label><input type="text" name="insulin_dose" class="form-control" placeholder="e.g. 4 Units SC"></div>
          </div>
        </form>
      `);
    }

    function stopMed(id) {
      if (confirm('Discontinue this medication order?')) {
        api(URLS.emar.stop, { id }).done(() => {
          toastr.success('Medication discontinued');
          DigitalNursing.reloadList();
        });
      }
    }

    function deleteMed(id) {
      if (confirm('Delete this medication order?')) {
        api(URLS.emar.del, { id }).done(() => {
          toastr.success('Order deleted');
          DigitalNursing.reloadList();
        });
      }
    }

    function deleteAssessment(id) {
      if (confirm('Delete this assessment?')) {
        api(URLS.assessment.del, { id }).done(() => {
          toastr.success('Assessment deleted');
          DigitalNursing.reloadList();
        });
      }
    }

    function deleteVitals(id) {
      if (confirm('Delete this vitals record?')) {
        api(URLS.vitals.del, { id }).done(() => {
          toastr.success('Vitals deleted');
          DigitalNursing.reloadList();
        });
      }
    }

    function deleteIo(id) {
      if (confirm('Delete this I/O entry?')) {
        api(URLS.io.del, { id }).done(() => {
          toastr.success('I/O entry deleted');
          DigitalNursing.reloadList();
        });
      }
    }

    function deleteNote(id) {
      if (confirm('Delete this progress note?')) {
        api(URLS.notes.del, { id }).done(() => {
          toastr.success('Note deleted');
          DigitalNursing.reloadList();
        });
      }
    }

    function auditDiabetic(id) {
      api(URLS.diabetic.audit, { id }).done(r => {
        toastr.success(r.msg);
        DigitalNursing.reloadList();
      });
    }

    function escapeHtml(str) {
      return String(str || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // Initialize Digital Nursing on load
    $(document).ready(function() {
      DigitalNursing.reloadList();
    });
  </script>
</body>
</html>
