<!-- Script Logic for Repeat Every 25 Seconds & Fun Interactivity -->
<script>
  (function () {
    let popupTimer = null;
    let progressTimer = null;
    const INTERVAL_SECONDS = 25;
    let secondsLeft = INTERVAL_SECONDS;

    function getOverlay() {
      return document.getElementById('salaryIncrementOverlay');
    }

    function showSalaryPopup() {
      const overlay = getOverlay();
      if (!overlay) return;
      overlay.classList.add('sh-active');
      stopProgressBar();
    }

    window.closeSalaryPopup = function () {
      const overlay = getOverlay();
      if (!overlay) return;
      overlay.classList.remove('sh-active');
      scheduleNextPopup();
    };

    function scheduleNextPopup() {
      if (popupTimer) clearTimeout(popupTimer);
      secondsLeft = INTERVAL_SECONDS;
      startProgressBar();

      popupTimer = setTimeout(function () {
        showSalaryPopup();
      }, INTERVAL_SECONDS * 1000);
    }

    function startProgressBar() {
      stopProgressBar();
      const bar = document.getElementById('shTimerBar');
      const start = Date.now();
      const totalMs = INTERVAL_SECONDS * 1000;

      progressTimer = setInterval(function () {
        const elapsed = Date.now() - start;
        const pct = Math.min(100, (elapsed / totalMs) * 100);
        if (bar) bar.style.width = pct + '%';
        if (elapsed >= totalMs) {
          stopProgressBar();
        }
      }, 100);
    }

    function stopProgressBar() {
      if (progressTimer) clearInterval(progressTimer);
      const bar = document.getElementById('shTimerBar');
      if (bar) bar.style.width = '0%';
    }

    // Playful dodge when hovering over reject button
    window.dodgeRejectButton = function (btn) {
      const randomX = (Math.random() - 0.5) * 80;
      const randomY = (Math.random() - 0.5) * 40;
      btn.style.transform = `translate(${randomX}px, ${randomY}px)`;
      setTimeout(() => {
        btn.style.transform = 'translate(0, 0)';
      }, 700);
    };

    // Confetti & Celebration when Management Approves Hike!
    window.approveSalaryHike = function (btn) {
      btn.disabled = true;
      btn.innerHTML = '🎉 100% HIKE GRANTED! 💸🚀';
      btn.style.background = 'linear-gradient(135deg, #059669, #047857)';

      const successBox = document.getElementById('hikeSuccessMsg');
      if (successBox) successBox.style.display = 'block';

      triggerConfetti();

      // Close automatically after 4 seconds and restart cycle
      setTimeout(function () {
        btn.disabled = false;
        btn.innerHTML = '<span class="sh-btn-emoji">🚀</span> APPROVE SALARY HIKE! 💰';
        btn.style.background = '';
        if (successBox) successBox.style.display = 'none';
        closeSalaryPopup();
      }, 4000);
    };

    // Lightweight HTML5 Canvas Confetti Engine
    function triggerConfetti() {
      const canvas = document.getElementById('shConfettiCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const particles = [];
      const colors = ['#10b981', '#f59e0b', '#3b82f6', '#ec4899', '#8b5cf6', '#ef4444', '#fbbf24'];

      for (let i = 0; i < 120; i++) {
        particles.push({
          x: canvas.width / 2,
          y: canvas.height / 2,
          r: Math.random() * 6 + 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 0.5) * 14 - 3,
          gravity: 0.25,
          alpha: 1,
          decay: Math.random() * 0.015 + 0.01
        });
      }

      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let alive = false;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.alpha -= p.decay;

          if (p.alpha > 0) {
            alive = true;
            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        });

        if (alive) {
          requestAnimationFrame(render);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      render();
    }

    // Initialize on page load: show immediately after 800ms
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(showSalaryPopup, 800);
      });
    } else {
      setTimeout(showSalaryPopup, 800);
    }
  })();
</script>