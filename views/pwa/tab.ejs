                    } catch (e) {
                        this.pagesError = String(e && e.message || e);
                        this.viewerRecords = [];
                    } finally {
                        this.pagesLoading = false;
                    }
                },

                // Fetch one category's pages and RETURN them (vs loadCategoryPages,
                // which assigns this.viewerRecords + owns the loading/error state).
                // Used by loadAllCategoryPages to fan out across categories. Soft-
                // fails to [] so one slow/broken category can't sink the whole
                // aggregate.
                async _fetchCategoryPages(patientId, catId) {
                    const controller = new AbortController();
                    const timeoutId = setTimeout(() => controller.abort(), 12000);
                    try {
                        const url = './api/patients/' + encodeURIComponent(patientId)
                                  + '/categories/' + encodeURIComponent(catId) + '/pages';
                        const resp = await fetch(url, {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                            signal: controller.signal,
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return []; }
                        if (!resp.ok) return [];
                        const data = await resp.json();
                        return Array.isArray(data && data.pages) ? data.pages : [];
                    } catch (_) {
                        return [];
                    } finally {
                        clearTimeout(timeoutId);
                    }
                },

                buildStubRecords(cat) {
                    const n = Math.max(0, cat.count | 0);
                    const today = new Date();
                    return Array.from({ length: n }, (_, k) => {
                        const d = new Date(today);
                        d.setDate(today.getDate() - k);
                        const dd = String(d.getDate()).padStart(2, '0');
                        const mm = d.toLocaleString('en-IN', { month: 'short' });
                        const yyyy = d.getFullYear();
                        return {
                            id: `${cat.i}-${k + 1}`,
                            pageNo: n - k,
                            date: `${dd}-${mm}-${yyyy}`,
                            author: ['Dr. R. Mehta', 'Nurse S. Patel', 'Dr. A. Khan'][k % 3],
                        };
                    });
                },

                // Thumbnail footer date strip tap. With p_id 97 it opens the
                // Transfer-page dialog; otherwise it falls back to opening the
                // page (the card's normal action) since .stop swallowed it.
                onFooterDateClick(rec) {
                    if (this.me.can_transfer_page) { this.openTransferDialog(rec); }
                    else { this.openDetail(rec); }
                },

                openTransferDialog(rec) {
                    if (!rec) return;
                    if (!this.me.can_transfer_page) { this.openDetail(rec); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    this.transferRec = rec;
                    this.transferDateTime = this._toLocalInput(rec.createdAt);
                    this.transferOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Open the native datetime picker for the dialog input.
                openTransferPicker() {
                    const el = document.getElementById('transferDt');
                    if (el && typeof el.showPicker === 'function') {
                        try { el.showPicker(); return; } catch (_) {}
                    }
                    if (el) el.focus();
                },

                // 'YYYY-MM-DD HH:MM:SS' → 'YYYY-MM-DDTHH:MM' for datetime-local.
                _toLocalInput(s) {
                    if (!s) return '';
                    return String(s).replace(' ', 'T').slice(0, 16);
                },

                async confirmTransferPage() {
                    if (this.transferBusy) return;
                    const rec = this.transferRec;
                    if (!rec || !rec.id) { this.transferOpen = false; return; }
                    if (!this.transferDateTime) { this.showToast('Pick a date & time', 'error'); return; }
                    this.transferBusy = true;

                    // 'YYYY-MM-DDTHH:MM' → 'YYYY-MM-DD HH:MM:SS' for the server.
                    let dt = this.transferDateTime.replace('T', ' ');
                    if (dt.length === 16) dt += ':00';

                    try {
                        const fd = new FormData();
                        fd.append('datetime', dt);
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        const url = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                  + '/pages/' + encodeURIComponent(rec.id) + '/transfer';
                        const resp = await fetch(url, {
                            method: 'POST',
                            credentials: 'same-origin',
                            body: fd,
                            headers: Object.assign(
                                { 'Accept': 'application/json' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed. Try again.', 'error'); return; }
                        if (!resp.ok) {
                            const data = await resp.json().catch(() => null);
                            throw new Error((data && data.error) || ('HTTP ' + resp.status));
                        }
                        this.transferOpen = false;
                        this.transferRec = null;
                        this.showToast('Page transferred', 'success');
                        // Reload the current category so the new order/date shows.
                        if (this.viewerCategory && this.viewerCategory.isAll) {
                            await this.openCategory(this.viewerCategory);
                        } else if (this.viewerCategory && this.viewerCategory.id) {
                            await this.loadCategoryPages(this.selectedPatientId, this.viewerCategory.id);
                        }
                    } catch (e) {
                        this.showToast('Transfer failed: ' + (e && e.message || e), 'error');
                    } finally {
                        this.transferBusy = false;
                    }
                },

                openDetail(rec) {
                    const i = this.viewerRecords.findIndex(r => r.id === rec.id);
                    this.viewerActiveIndex  = Math.max(0, i);
                    this.viewerActiveRecord = this.viewerRecords[this.viewerActiveIndex] || rec;
                    this.viewerMode = 'detail';
                    this.$nextTick(() => {
                        // Jump the slider to the picked page without animation.
                        const el = this.$refs.pageSlider;
                        if (el) {
                            const prev = el.style.scrollBehavior;
                            el.style.scrollBehavior = 'auto';
                            el.scrollLeft = this.viewerActiveIndex * el.clientWidth;
                            requestAnimationFrame(() => { el.style.scrollBehavior = prev || 'smooth'; });
                        }
