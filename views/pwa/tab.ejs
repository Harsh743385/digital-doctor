                    </div>
                    <!-- Delete (existing template only) -->
                    <button type="button" x-show="tplEditingId != null" @click="tplDeleteConfirmOpen = true" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Delete template" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    <!-- Reset -->
                    <button type="button" @click="tplResetCanvas()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 shrink-0" title="Reset"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></button>
                    <!-- Cancel -->
                    <button type="button" @click="tplCancelEdit()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Cancel"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button>
                </div>
            </div>

            <!-- Body: template grid (main) + category selector (right drawer) -->
            <div class="flex-1 min-h-0 relative flex">
                <div class="flex-1 min-w-0 overflow-auto p-3" :class="(tplView === 'edit' || tplView === 'detail') ? 'overflow-hidden' : 'overflow-auto p-3'">
                    <!-- ══ PAGE VIEWER (viewpager) — SWIPE to move between saved
                         templates, same as the Register Book page viewer. Open /
                         n/n / Add live in the app bar above. ══ -->
                    <div x-show="tplView === 'detail'" class="h-full" style="display: none;">
                        <div class="h-full overflow-x-auto flex snap-x snap-mandatory rb-slider" x-ref="tplSlider" id="tplSlider" @scroll.passive="tplOnSliderScroll()">
                            <template x-for="(t, i) in tplPages" :key="t.id"></template>
                        </div>
                    </div>

                    <!-- ══ CANVAS EDITOR ══ -->
                    <div x-show="tplView === 'edit'" class="h-full flex flex-col" style="display: none;">
                        <div class="flex-1 min-h-0 bg-slate-200 relative z-0 overflow-hidden flex items-stretch" @touchstart="tplTouchStart($event)" @touchmove="tplTouchMove($event)" @touchend="tplTouchEnd($event)" @touchcancel="tplTouchEnd($event)">
                            <div class="relative shadow-lg w-full h-full" :style="tplPageStyle()" style="width:100%; height:100%;">
                                <!-- Category form background — display only, below
                                     the canvas and pointer-events-none so it can
                                     never intercept strokes. -->
                                <img x-show="tplBgUrl()" :src="tplBgUrl()" alt="" draggable="false" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none z-0" src="https://prescoipd.com/v1/ipd/pwa/ipd" style="display: none;">
                                <div x-show="!tplBgUrl()" class="absolute inset-0 bg-white pointer-events-none z-0"></div>
                                <!-- Drawing canvas — id as well as x-ref, because the
                                     buttons that open the editor sit in x-if blocks
                                     (see _rbCanvasEl for the full story). -->
                                <canvas x-ref="tplCanvas" id="tplCanvas" class="absolute inset-0 w-full h-full z-10" :style="'touch-action:none;' + (tplTool === 'eraser' ? 'cursor:cell;' : 'cursor:crosshair;')" @pointerdown="tplPointerDown($event)" @pointermove="tplPointerMove($event)" @pointerup="tplPointerUp($event)" @pointerleave="tplPointerUp($event)" @pointercancel="tplPointerUp($event)" style="touch-action:none;cursor:crosshair;"></canvas>

                                <!-- Pending image placement: a movable, pinch-scalable
                                     / rotatable overlay positioned in canvas-pixel
                                     space (%), so it zooms and pans WITH the page.
                                     Only the item box captures pointers. -->
                                <template x-if="_tplPlacing"></template>
                            </div>

                            <!-- Placement bar — size / rotate / Cancel / Place. Shown
                                 only while an image is pending, like the IPD editor. -->
                            <div x-show="_tplPlacing" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-30 bg-white/95 border border-slate-200 rounded-full shadow-lg px-2 py-1.5 flex items-center gap-1" style="display: none;">
                                <span class="hidden sm:inline text-[11px] text-slate-500 px-2" x-text="(_tplPlacing &amp;&amp; _tplPlacing.resizable === false &amp;&amp; _tplPlacing.rotatable === false) ? 'Drag to position, then Place' : 'Drag to move · pinch to resize/rotate'">Drag to move · pinch to resize/rotate</span>
                                <!-- Resize hidden for fixed-size items (stamps), as in IPD. -->
                                <button type="button" x-show="!(_tplPlacing &amp;&amp; _tplPlacing.resizable === false)" @click="_tplScalePlacement(0.9)" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Smaller">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="minus" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-minus"><path d="M5 12h14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_tplPlacing &amp;&amp; _tplPlacing.resizable === false)" @click="_tplScalePlacement(1.1)" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Bigger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_tplPlacing &amp;&amp; _tplPlacing.rotatable === false)" @click="_tplRotatePlacement(-90)" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate left">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                </button>
                                <button type="button" x-show="!(_tplPlacing &amp;&amp; _tplPlacing.rotatable === false)" @click="_tplRotatePlacement(90)" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate right">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                                </button>
                                <div class="w-px h-6 bg-slate-200 mx-1"></div>
                                <button type="button" @click="_tplCancelPlacement()" class="px-3 py-1.5 rounded-full text-slate-600 hover:bg-slate-100 text-sm font-medium flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                                    <span>Cancel</span>
                                </button>
                                <button type="button" @click="_tplCommitPlacement()" class="px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                    <span>Place</span>
                                </button>
                            </div>
                            <!-- Hidden inputs: gallery picker and camera capture. -->
                            <input type="file" accept="image/*" x-ref="tplFileInput" id="tplFileInput" class="hidden" @change="tplOnPickImage($event)">
                            <input type="file" accept="image/*" capture="environment" x-ref="tplCamInput" id="tplCamInput" class="hidden" @change="tplOnPickImage($event)">
                            <!-- Stylus-only hint (auto-hides). Shared showStylusHint
                                 state, raised by _flashStylusHint on a mouse tap. -->
                            <div x-show="showStylusHint" x-transition.opacity="" class="absolute top-3 left-1/2 -translate-x-1/2 bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full shadow flex items-center gap-2 pointer-events-none z-30" style="display:none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-tool" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-pen-tool"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                                <span>Use a stylus to draw on this canvas</span>
                            </div>
                        </div>
                    </div>
                    <!-- ══ RECYCLE BIN — deleted templates (page_status = 1) across
                         every category, ordered by category then most-recently
                         deleted. ══ -->
                    <div x-show="tplView === 'recycle'" style="display: none;">
                        <div class="flex items-center justify-between gap-2 mb-3">
                            <button type="button" @click="tplExitRecycle()" class="inline-flex items-center gap-1 text-sm text-slate-600 hover:text-slate-800">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back
                            </button>
                            <div class="font-semibold text-slate-700 flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> Recycle Bin</div>
                            <button type="button" @click="tplLoadRecycle()" class="p-1.5 rounded-full border border-slate-200 bg-white text-slate-500 hover:bg-slate-50" title="Refresh"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></button>
                        </div>
