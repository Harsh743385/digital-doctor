                                        <span x-show="!_selectionClipboard" class="ml-auto text-[10px] text-slate-400">empty</span>
                                    </button>
                                </div>
                            </div>
                            <button type="button" @click="doRefresh()" class="p-1.5 rounded hover:bg-slate-200 text-slate-600" title="Reset to starting state">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="refresh-cw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-refresh-cw"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
                            </button>
                            <div class="w-px h-5 bg-slate-300 mx-1"></div>
                            <!-- Delete page — only when editing an existing page
                                 AND the user holds the delete-page grant (p_id 63). -->
                            <button x-show="_editingRecordId !== null &amp;&amp; me.can_delete_pages" type="button" @click="confirmDeleteOpen = true" class="p-1.5 rounded hover:bg-rose-100 text-rose-600" title="Delete page" style="display: none;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                            <button type="button" @click="cancelEdit()" class="p-1.5 rounded hover:bg-rose-100 text-rose-600" title="Cancel">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                            </button>
                            <div class="w-px h-5 bg-slate-300 mx-1"></div>
                            <!-- Forms drawer — kept available while editing so
                                 the right drawer is reachable in every mode. -->
                            <button type="button" @click="rightOpen = !rightOpen" class="p-1.5 rounded hover:bg-slate-200 text-slate-600" title="Forms">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="menu" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-menu"><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Full-screen canvas area below the appbar. -->
                <!-- The "page" sits centered inside this wrap and locks its -->
                <!-- aspect ratio to the category image (default 1536x1968). -->
                <!-- The canvas backing-store keeps the image's NATIVE size -->
                <!-- so saved strokes land at the correct resolution. -->
                <!-- When editLocked is false (unlocked), 2-finger pinch on -->
                <!-- this wrap zooms & pans the form; stylus still draws. -->
                <div x-ref="canvasWrap" class="flex-1 relative overflow-hidden bg-slate-200 min-h-0 flex items-stretch" @pointerdown="onTouchDown($event)" @pointermove="onTouchMove($event)" @pointerup="onTouchEnd($event)" @pointercancel="onTouchEnd($event)">
                    <div x-ref="canvasPage" class="canvas-page" :style="'transform: translate(' + panX + 'px,' + panY + 'px) scale(' + zoom + ');'
                                + ' transform-origin: center center;'
                                + ' transition: ' + (_pinchActive ? 'none' : 'transform 120ms ease-out') + ';'" style="transform: translate(0px,0px) scale(1); transform-origin: center center; transition: transform 120ms ease-out;">

                        <!-- Background: real category image when present, ruled-paper fallback otherwise.
                             Display-only <img> behind the canvas — never painted via drawImage,
                             so no crossorigin required and S3 buckets without CORS still serve it. -->
                        <img x-show="bgImageUrl" :src="bgImageUrl" @load="onBgImageLoaded($event)" @error="onBgImageError($event)" alt="" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none" draggable="false" style="display:none" src="https://prescoipd.com/v1/ipd/pwa/ipd">
                        <div x-show="!bgImageUrl" class="absolute inset-0 form-paper">
                            <!-- Same rule as the viewer: no watermark for the
                                 synthetic "All IPD Categories" row. -->
                            <div x-show="viewerCategory &amp;&amp; !viewerCategory.isAll" class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" style="display: none;">
                                <span class="text-7xl md:text-9xl font-black text-slate-200/40 rotate-[-20deg] tracking-widest text-center px-6" x-text="(viewerCategory &amp;&amp; viewerCategory.label || '').toUpperCase()"></span>
                            </div>
                        </div>

                        <!-- Drawing canvas (stylus only). touch-none keeps the browser
                             from scrolling/zooming while the user draws. -->
                        <canvas x-ref="penCanvas" class="absolute inset-0 w-full h-full touch-none" :style="editTool === 'eraser' ? 'cursor: cell;' : 'cursor: crosshair;'" @pointerdown="onPointerDown($event)" @pointermove="onPointerMove($event)" @pointerup="onPointerUp($event)" @pointercancel="onPointerUp($event)" @pointerleave="onPointerUp($event)" style="cursor: crosshair;"></canvas>

                        <!-- Pending image placement (camera / gallery). A movable,
                             pinch-scalable overlay positioned in canvas-pixel space
                             (via %), so it sits exactly where it will be drawn and
                             zooms/pans WITH the page. Only the image box captures
                             pointers; the rest stays inert. -->
                        <template x-if="_placing"></template>

                        <!-- Stylus-only hint (auto-hides after a moment). -->
                        <div x-show="showStylusHint" x-transition.opacity="" class="absolute top-3 left-1/2 -translate-x-1/2 bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full shadow flex items-center gap-2 pointer-events-none" style="display:none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-tool" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-pen-tool"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                            <span>Use a stylus to draw on this canvas</span>
                        </div>

                    </div>

                    <!-- Image-placement action bar (camera / gallery). Lives in
                         canvasWrap coords (NOT transformed), so it stays put while
                         the user moves/scales the pending image.

                         TOP-RIGHT and DARK on purpose: a white bar centred at the
                         bottom vanished against the white form paper and sat over
                         the part of the page being positioned. Offset below the
                         patient strip (z-30, pinned top-0) when one is shown. -->
                    <div x-show="_placing" :class="selectedPatient ? 'top-16' : 'top-3'" class="absolute right-3 z-40 flex items-center gap-1 bg-slate-900/95 text-slate-100 rounded-full shadow-2xl ring-1 ring-white/15 px-2 py-1.5 top-16" style="display:none">
                        <span class="hidden sm:inline text-[11px] text-slate-300 px-2" x-text="(_placing &amp;&amp; _placing.resizable === false &amp;&amp; _placing.rotatable === false) ? 'Drag to position, then Place' : 'Drag to move · pinch to resize/rotate'">Drag to move · pinch to resize/rotate</span>
                        <!-- Resize (hidden for fixed-size items, e.g. stamps). -->
                        <button type="button" x-show="!(_placing &amp;&amp; _placing.resizable === false)" @click="_scalePlacement(0.9)" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Smaller">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="minus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-minus"><path d="M5 12h14"></path></svg>
                        </button>
                        <button type="button" x-show="!(_placing &amp;&amp; _placing.resizable === false)" @click="_scalePlacement(1.1)" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Larger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                        </button>
                        <!-- Rotate in 90° steps (hidden for non-rotatable items,
                             e.g. selection pastes). -->
                        <button type="button" x-show="!(_placing &amp;&amp; _placing.rotatable === false)" @click="_rotatePlacement(-90)" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Rotate left 90°">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                        </button>
                        <button type="button" x-show="!(_placing &amp;&amp; _placing.rotatable === false)" @click="_rotatePlacement(90)" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Rotate right 90°">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                        </button>
                        <div class="w-px h-5 bg-white/25 mx-1"></div>
                        <button type="button" @click="_cancelPlacement()" class="px-3 py-1.5 rounded-full text-slate-200 hover:bg-white/15 text-sm font-medium flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                            <span>Cancel</span>
                        </button>
                        <button type="button" @click="_commitPlacement()" class="px-3 py-1.5 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white text-sm font-semibold flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            <span>Place</span>
                        </button>
                    </div>

                    <!-- ══ SELECTION BOX (selective copy) ══════════════════════
                         Appears CENTRED as soon as the mode opens — no drag is
                         needed to summon it — and is moved/resized with a
                         FINGER (any pointer type works). Lives in canvasWrap
                         coords, so the zoom transform never shifts it.

                         template x-if, not x-show: an x-show element that also
                         carries :style has its display:none clobbered by the
                         style binding. -->
                    <template x-if="selectionMode === 'copy' &amp;&amp; _selectionRect"></template>

                    <!-- Selection action bar. Deliberately identical in position
                         and colour to the placement bar above — same top-right
                         anchor, same dark pill — so the two modes read the same
                         and neither disappears against the white form. -->
                    <div x-show="selectionMode === 'copy'" :class="selectedPatient ? 'top-16' : 'top-3'" class="absolute right-3 z-40 flex items-center gap-1 bg-slate-900/95 text-slate-100 rounded-full shadow-2xl ring-1 ring-white/15 px-2 py-1.5 top-16" style="display:none">
                        <span class="hidden sm:inline text-[11px] text-slate-300 px-2">Drag to move · drag a corner to resize</span>
                        <button type="button" @click="_resetSelectionToCentre()" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Recentre selection">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="crosshair" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-crosshair"><circle cx="12" cy="12" r="10"></circle><line x1="22" x2="18" y1="12" y2="12"></line><line x1="6" x2="2" y1="12" y2="12"></line><line x1="12" x2="12" y1="6" y2="2"></line><line x1="12" x2="12" y1="22" y2="18"></line></svg>
                        </button>
                        <div class="w-px h-5 bg-white/25 mx-1"></div>
                        <button type="button" @click="cancelSelectiveCopy()" class="px-3 py-1.5 rounded-full text-slate-200 hover:bg-white/15 text-sm font-medium flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                            <span>Cancel</span>
                        </button>
                        <button type="button" @click="confirmSelectiveCopy()" class="px-3 py-1.5 rounded-full bg-sky-500 hover:bg-sky-400 text-white text-sm font-semibold flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            <span>Copy</span>
                        </button>
                    </div>

                    <!-- Patient-details overlay (edit mode): the SAME details
                         shown in the page viewer, pinned just below the app bar
                         and overlaying the canvas. It's a sibling of the
                         (transformed) canvas-page, so it stays fixed in place
                         while the form zooms/pans. Collapsible via the shared
                         patientDetailsOpen state. @pointerdown.stop keeps taps
                         on it from starting a canvas pan/pinch. -->
                    <div x-show="selectedPatient" @pointerdown.stop="" class="canvas-pt-strip absolute inset-x-0 top-0 z-30 px-4 py-2 max-h-[45vh] overflow-y-auto backdrop-blur-sm rounded-b-lg" style="background-color: rgba(30, 41, 59, 0.74);">
                        <!-- Identity row: avatar · name · gender-age chip · relative,
                             with the collapse toggle pinned to the right. -->
                        <div class="flex items-start gap-2">
                            <div class="flex items-center flex-wrap gap-x-2.5 gap-y-1 flex-1 min-w-0">
                                <template x-if="selectedPatient &amp;&amp; (selectedPatient.photoSrc || selectedPatient.photo)"></template>
                                <template x-if="!(selectedPatient &amp;&amp; (selectedPatient.photoSrc || selectedPatient.photo))"></template><span class="w-9 h-9 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center text-xs font-bold border border-teal-200 shrink-0" x-text="(selectedPatient &amp;&amp; selectedPatient.initials) || '?'">JA</span>
                                <span class="text-[15px] font-bold text-slate-900 leading-tight" x-text="(selectedPatient &amp;&amp; selectedPatient.name) || patientName">JAGDISHBHAI AHUJA</span>
                                <span x-show="selectedPatient &amp;&amp; (genderLabel(selectedPatient.gender) || selectedPatient.age)" class="inline-flex items-center px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 text-[11px] font-semibold border border-teal-100 whitespace-nowrap" x-text="[genderLabel(selectedPatient &amp;&amp; selectedPatient.gender), (selectedPatient &amp;&amp; selectedPatient.age) ? (selectedPatient.age + ' yrs') : ''].filter(Boolean).join(' · ')" style="">Male · 42 Y, 2 M, 12 D yrs</span>
                                <span x-show="selectedPatient &amp;&amp; selectedPatient.relative_name" class="text-xs text-slate-400 italic" x-text="'(' + ((selectedPatient &amp;&amp; selectedPatient.relative_salutation) ? selectedPatient.relative_salutation + ' ' : '') + (selectedPatient &amp;&amp; selectedPatient.relative_name) + ')'" style="display: none;">()</span>
                            </div>
                            <button type="button" @click="patientDetailsOpen = !patientDetailsOpen" class="shrink-0 -mt-0.5 p-1 rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition" :title="patientDetailsOpen ? 'Hide details' : 'Show details'" :aria-expanded="patientDetailsOpen ? 'true' : 'false'" aria-label="Toggle patient details" title="Show details" aria-expanded="false">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform rotate-180" :class="patientDetailsOpen ? '' : 'rotate-180'"><polyline points="18 15 12 9 6 15"></polyline></svg>
                            </button>
                        </div>

                        <!-- Detail grid: stacked label / value cells (collapsible). -->
                        <div x-show="patientDetailsOpen" class="mt-2 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-5 gap-y-2" style="display: none;">
                            <div class="flex flex-col min-w-0 leading-tight">
                                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">UHID</span>
                                <span class="text-xs font-semibold text-slate-800 font-mono truncate" :title="(selectedPatient &amp;&amp; selectedPatient.uhid) || patientUhid" x-text="(selectedPatient &amp;&amp; selectedPatient.uhid) || patientUhid" title="AS6767">AS6767</span>
                            </div>
                            <div class="flex flex-col min-w-0 leading-tight">
                                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">IPD No</span>
                                <span class="text-xs font-semibold text-slate-800 font-mono truncate" :title="(selectedPatient &amp;&amp; selectedPatient.ipd) || patientIp" x-text="(selectedPatient &amp;&amp; selectedPatient.ipd) || patientIp" title="IP/2026-2027/1619">IP/2026-2027/1619</span>
                            </div>
                            <div x-show="selectedPatient &amp;&amp; selectedPatient.doctor" class="flex flex-col min-w-0 leading-tight" style="">
                                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">Consultant</span>
                                <span class="text-xs font-semibold text-slate-800 truncate" :title="selectedPatient &amp;&amp; (selectedPatient.doctor + (selectedPatient.consultant_unit ? ' (' + selectedPatient.consultant_unit + ')' : ''))" x-text="selectedPatient &amp;&amp; (selectedPatient.doctor + (selectedPatient.consultant_unit ? ' (' + selectedPatient.consultant_unit + ')' : ''))" title="DR NARENDRA SHANGHAVI">DR NARENDRA SHANGHAVI</span>
                            </div>
                            <div x-show="selectedPatient &amp;&amp; selectedPatient.admitted_at" class="flex flex-col min-w-0 leading-tight" style="">
                                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">DOA</span>
                                <span class="text-xs font-semibold text-slate-800 truncate" x-text="selectedPatient &amp;&amp; fmtDateTime(selectedPatient.admitted_at)">25-09-2026 08:30 am</span>
                            </div>
                            <div x-show="selectedPatient &amp;&amp; selectedPatient.discharged_at" class="flex flex-col min-w-0 leading-tight" style="display: none;">
                                <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">DOD</span>
                                <span class="text-xs font-semibold text-slate-800 truncate" x-text="selectedPatient &amp;&amp; fmtDateTime(selectedPatient.discharged_at)"></span>
                            </div>
                            <template x-for="f in (selectedPatient &amp;&amp; selectedPatient.header_fields) || []" :key="f.label"></template>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Recycle Bin overlay                                           -->
        <!-- ============================================================ -->
        <div x-show="binOpen" x-transition.opacity="" class="fixed inset-0 z-50 bg-slate-100 flex flex-col" style="display:none">
            <!-- Header -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0" :style="binKind === 'recycle' ? 'background-color:#dc2626;'
                       : binKind === 'discard' ? 'background-color:#0ea5e9;'
                       : 'background-color:#f59e0b;'" style="background-color:#dc2626;">
                <button type="button" @click="binOpen = false; binPreview = null" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg" x-text="binKind === 'recycle' ? 'Recycle Bin' : binKind === 'discard' ? 'Discard Bin' : 'Offline Bin'">Recycle Bin</div>
                    <div class="text-xs opacity-90 truncate" x-text="'Patient: ' + patientName">Patient: JAGDISHBHAI AHUJA</div>
                </div>
                <div class="text-xs px-2.5 py-1 rounded-full bg-white/15 font-medium">
                    <span x-text="currentBinItems().length">0</span>
                    <span x-show="currentBinItems().length === 1" style="display: none;">page</span>
                    <span x-show="currentBinItems().length !== 1">pages</span>
                </div>
            </div>

            <!-- List -->
            <div class="flex-1 overflow-auto p-3 md:p-6">
                <div class="max-w-4xl mx-auto">
                    <template x-if="binLoading"></template>
                    <template x-if="!binLoading &amp;&amp; currentBinItems().length === 0"></template><div class="text-center py-12 text-slate-500">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-200 text-slate-400 mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" :data-lucide="binKind === 'offline' ? 'cloud-off' : 'trash-2'" style="width:28px;height:28px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </div>
                            <div class="font-semibold text-slate-700" x-text="binKind === 'offline' ? 'No offline pages' : binKind === 'recycle' ? 'Recycle bin is empty' : 'Bin is empty'">Recycle bin is empty</div>
                            <p class="text-sm mt-1" x-text="binKind === 'offline' ? 'Pages saved offline for this patient will appear here.' : 'Deleted pages will appear here.'">Deleted pages will appear here.</p>
                        </div>

                    <div class="space-y-3">
                        <template x-for="item in currentBinItems()" :key="item.id"></template>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Recycle Bin — full-screen page preview (category form background  -->
        <!-- + saved strokes). Opened by tapping a bin thumbnail; z above the  -->
        <!-- bin overlay (z-50). Back / Esc closes it.                         -->
        <!-- ============================================================ -->
        <div x-show="binPreview" x-transition.opacity="" @keydown.escape.window="binPreview = null" class="fixed inset-0 z-[97] bg-slate-100 flex flex-col" style="display:none">
            <!-- Header: ← back · category · page / deleted info. -->
            <div class="px-3 py-3 flex items-center gap-2 text-white shrink-0" :style="'background-color:' + ((binPreview &amp;&amp; binPreview.catColorHex) || '#dc2626') + ';'" style="background-color:#dc2626;">
                <button type="button" @click="binPreview = null" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate" x-text="binPreview &amp;&amp; binPreview.catLabel"></div>
                    <div class="text-xs opacity-90 truncate" x-text="binPreview &amp;&amp; binPreview.originalRecord
                                 ? ('Page ' + (binPreview.originalRecord.pageNo || '—') + (binPreview.deletedAt ? ' · deleted ' + binPreview.deletedAt : ''))
                                 : ''"></div>
                </div>
            </div>
            <!-- Page: form background with the strokes composited on top. Both
                 object-contain at the same box, so they stay aligned. -->
            <div class="flex-1 min-h-0 overflow-auto bg-slate-200 p-3 flex items-center justify-center">
                <div class="relative w-full h-full">
                    <img x-show="binPreview &amp;&amp; binPreview.catBgUrl" :src="binPreview &amp;&amp; binPreview.catBgUrl" alt="" class="absolute inset-0 w-full h-full object-contain select-none pointer-events-none" style="display: none;">
                    <img x-show="binPreview &amp;&amp; binPreview.originalRecord &amp;&amp; binPreview.originalRecord.image" :src="binPreview &amp;&amp; binPreview.originalRecord &amp;&amp; binPreview.originalRecord.image" alt="" class="absolute inset-0 w-full h-full object-contain select-none pointer-events-none" style="display: none;">
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Page edit history — FULL-SCREEN (like the recycle bin) with a     -->
        <!-- transparent background. Shows the current page (category template  -->
        <!-- + saved strokes from the notes column) and the edit log from       -->
        <!-- pma_notes_logs (newest first): who edited and when. Opened by the   -->
        <!-- app-bar watch icon (left of Forms).                               -->
        <!-- ============================================================ -->
        <div x-show="pageLogsOpen" x-transition.opacity="" @keydown.escape.window="pageLogsOpen = false" class="fixed inset-0 z-[80] bg-transparent flex flex-col" style="display:none">
            <!-- Header bar -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-sky-600 shadow">
                <button type="button" @click="pageLogsOpen = false" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate">Page Edit History</div>
                    <div class="text-xs opacity-90 truncate" x-text="'Patient: ' + (patientName || '—')">Patient: JAGDISHBHAI AHUJA</div>
                </div>
                <!-- Set the shown version as the current note. Live page →
                     reverts it (pma_patient_notes1.notes); deleted page (recycle
                     bin) → restores it with this version. Hidden for documents. -->
                <button type="button" @click="setCurrentNote()" x-show="!pageLogIsDoc" :disabled="settingNote || pageLogsLoading || pageLogs.length === 0" class="px-3 py-1.5 rounded-full text-sm font-semibold bg-orange-500 hover:bg-orange-600 text-white shadow disabled:opacity-50 flex items-center gap-1.5 shrink-0" title="Set the shown version as the current note" disabled="disabled">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check-circle" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check-circle"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
                    <span>Set as Current Note</span>
                </button>
                <!-- Toggle the change-highlight (added vs erased) overlay. Only
                     meaningful for form strokes — hidden for uploaded documents. -->
                <button type="button" @click="togglePageDiff()" x-show="!pageLogIsDoc" class="px-3 py-1.5 rounded-full text-sm font-medium flex items-center gap-1.5 transition shrink-0 bg-white/20 hover:bg-white/30 text-white" :class="pageLogDiff ? 'bg-white text-sky-700' : 'bg-white/20 hover:bg-white/30 text-white'" title="Highlight changes vs the previous version">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="git-compare" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-git-compare"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><path d="M11 18H8a2 2 0 0 1-2-2V9"></path></svg>
                    <span>Highlight changes</span>
                </button>
                <div class="text-xs px-2.5 py-1 rounded-full bg-white/15 font-medium">
                    <span x-text="pageLogs.length">0</span>
                    <span x-show="pageLogs.length === 1" style="display: none;">edit</span>
                    <span x-show="pageLogs.length !== 1">edits</span>
                </div>
            </div>

            <!-- Body: swipeable version viewer (book-style, like the page
                 viewer). Swipe / tap the dots to flip between versions; the
                 highlight toggle overlays added/erased per version. -->
            <div class="flex-1 min-h-0 flex flex-col">
                <!-- Loading / empty -->
                <template x-if="pageLogsLoading"></template>
                <template x-if="!pageLogsLoading &amp;&amp; pageLogs.length === 0"></template><div class="flex-1 flex items-center justify-center text-sm text-white/90">No edit history for this page.</div>

                <!-- Swipeable versions — CSS scroll-snap, one version per slide. -->
                <div x-show="!pageLogsLoading &amp;&amp; pageLogs.length &gt; 0" x-ref="logSlider" @scroll.debounce.80ms="onLogScroll($event)" class="flex-1 min-h-0 min-w-0 overflow-x-auto overflow-y-hidden snap-x snap-mandatory flex" style="scroll-behavior: smooth; display: none;">
                    <template x-for="(log, i) in pageLogs" :key="i"></template>
                </div>

                <!-- Legend (diff mode) -->
                <div x-show="!pageLogsLoading &amp;&amp; pageLogs.length &gt; 0 &amp;&amp; pageLogDiff" class="shrink-0 flex items-center justify-center gap-3 text-xs text-white py-1.5" style="display: none;">
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-emerald-500"></span>Added</span>
                    <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-rose-500"></span>Erased</span>
                </div>

                <!-- Version dots (clickable) -->
                <div x-show="!pageLogsLoading &amp;&amp; pageLogs.length &gt; 1" class="shrink-0 flex items-center justify-center gap-1.5 py-3 flex-wrap px-4" style="display: none;">
                    <template x-for="(log, i) in pageLogs" :key="'dot-' + i"></template>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Admission Card chooser — With Header vs Without Header.         -->
        <!-- Opened from Digital NABH → Admission Form. Each choice loads    -->
        <!-- the server-rendered PDF in the in-app viewer below.             -->
        <!-- ============================================================ -->
        <div x-show="admissionChooserOpen" x-transition.opacity="" @keydown.escape.window="admissionChooserOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-teal-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-clipboard-plus"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="M9 14h6"></path><path d="M12 17v-6"></path></svg>
                    <div class="flex-1 font-semibold">Admission Card</div>
                    <button type="button" @click="admissionChooserOpen = false" class="p-1 -mr-1 rounded hover:bg-white/10" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600 mb-4">
                        Choose how to render the admission card for
                        <b x-text="patientName || 'this patient'">JAGDISHBHAI AHUJA</b>.
                    </p>
                    <div class="flex flex-col gap-2">
                        <button type="button" @click="openAdmissionPdf(0)" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-teal-600 hover:bg-teal-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-file-text"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                            <span>With Header</span>
                        </button>
                        <button type="button" @click="openAdmissionPdf(6)" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-teal-700 bg-teal-50 border border-teal-200 hover:bg-teal-100 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-file"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path></svg>
                            <span>Without Header</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Embedded web page — an IPD app page (Digital Nursing, Digital     -->
        <!-- Requisition, …) shown IN the main pane (in-flow, below the app    -->
        <!-- header, like the form viewer). It's an HTML page so an iframe     -->
        <!-- renders fine in the WebView. Title + header colour are set per    -->
        <!-- item by openWebPage(). Mutually exclusive with main / docView /   -->
        <!-- viewer; the drawers (fixed z-40) still overlay it. Opening it is   -->
        <!-- gated by the unsaved-edit prompt.                                 -->
        <!-- ============================================================ -->
        <div x-show="webOpen" class="flex-1 min-h-0 bg-slate-100 flex flex-col relative">
            <!-- Pane header: title · patient (+ Print in pdf mode). No back button
                 — the app header above stays visible, so the Patients / Forms
                 drawers navigate away. -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-cyan-600" :class="webHeaderClass">
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate" x-text="webTitle">Digital Nursing</div>
                    <div class="text-xs opacity-90 truncate" x-text="'Patient: ' + (patientName || '—')">Patient: JAGDISHBHAI AHUJA</div>
                </div>
                <button type="button" x-show="webMode === 'pdf'" @click="printWebPdf()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Print" title="Print" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="printer" aria-hidden="true" style="width:21px;height:21px;display:block;" class="lucide lucide-printer"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>
                </button>
            </div>
            <!-- WEB mode: HTML page in an iframe. src bound only while shown so
                 closing / switching to pdf stops the page. -->
            <iframe x-show="webOpen &amp;&amp; webMode === 'web'" :src="(webOpen &amp;&amp; webMode === 'web') ? webUrl : ''" class="flex-1 min-h-0 w-full border-0 bg-white" :title="webTitle" allow="camera; microphone; clipboard-write" src="/cms/digital-nursing" title="Digital Nursing" style=""></iframe>
            <!-- PDF mode: PDF.js canvases appended here by _renderPdf(). -->
            <div x-show="webMode === 'pdf'" id="webPdfBox" class="flex-1 min-h-0 overflow-auto bg-slate-200 p-3 flex flex-col items-center gap-3" style="display: none;"></div>

            <!-- Floating "Edit" pencil — bottom-right, shown only over an
                 editable preview PDF (Operative Notes / Discharge Summary via
                 webEditVisible) and only when editing is allowed (not
                 view-only). Re-opens that document's web form so the user can
                 amend it. Colour follows the pane header (webHeaderClass). -->
            <button type="button" x-show="webEditVisible &amp;&amp; !viewOnlyActive()" @click="editCurrentDoc()" class="absolute bottom-5 right-5 z-20 inline-flex items-center gap-2 rounded-full text-white pl-4 pr-5 py-3 shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white/50 transition bg-cyan-600" :class="webHeaderClass" :title="'Edit ' + webTitle" :aria-label="'Edit ' + webTitle" style="display:none" title="Edit Digital Nursing" aria-label="Edit Digital Nursing">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pencil" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-pencil"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg>
                <span class="text-sm font-semibold">Edit</span>
            </button>

            <!-- Floating "Do signature" — bottom-LEFT, orange. Mirrors the Edit
                 pencil opposite it: same visibility rule (an editable preview
                 PDF — Operative Notes / Discharge Summary — and not view-only),
                 fixed orange rather than the pane colour so it reads as its own
                 action wherever it appears. -->
            <button type="button" x-show="webEditVisible &amp;&amp; !viewOnlyActive()" @click="doSignature(webTitle)" class="absolute bottom-5 left-5 z-20 inline-flex items-center gap-2 rounded-full text-white bg-orange-500 hover:bg-orange-600 pl-4 pr-5 py-3 shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-300 transition" :title="'Do signature on ' + webTitle" :aria-label="'Do signature on ' + webTitle" style="display:none" title="Do signature on Digital Nursing" aria-label="Do signature on Digital Nursing">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block" aria-hidden="true">
                    <path d="M3 17c3 0 4-9 7-9s3 7 6 7 2-4 5-4"></path><path d="M3 21h18"></path>
                </svg>
                <span class="text-sm font-semibold">Do signature</span>
            </button>
        </div>

        <!-- ============================================================ -->
        <!-- PDF viewer — full-screen in-app viewer ON TOP of the app. Reused  -->
        <!-- by every PDF item (Admission Card, MRD Checklist, …). It floats    -->
        <!-- over the main screen, whose ongoing task is left untouched under-  -->
        <!-- neath; the back button (or Esc) returns straight to it. Toolbar    -->
        <!-- actions (WhatsApp / Share) are toggled per item; Print is always   -->
        <!-- shown. PDF renders with PDF.js (the WebView can't show a PDF in an -->
        <!-- iframe natively).                                                 -->
        <!-- ============================================================ -->
        <div x-show="pdfOpen" x-transition.opacity="" @keydown.escape.window="closePdfViewer()" class="fixed inset-0 z-[60] bg-slate-100 flex flex-col" style="display:none">
            <!-- Title bar: ← back · title/patient · [WhatsApp] · [Share] · Print. -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-teal-600" :class="pdfHeaderClass">
                <button type="button" @click="closePdfViewer()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate" x-text="pdfTitle"></div>
                    <div class="text-xs opacity-90 truncate" x-text="'Patient: ' + (patientName || '—')">Patient: JAGDISHBHAI AHUJA</div>
                </div>

                <!-- WhatsApp: tap → dropdown of recipients (Patient / Consultant
                     / Referred Dr. / Relative). Each POSTs to the IPD app's
                     send-admission-card-whatsapp endpoint (shared session).
                     Admission card only. -->
                <div class="relative" x-show="pdfShowWhatsapp" style="display: none;">
                    <button type="button" @click="waMenuOpen = !waMenuOpen" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40 disabled:opacity-50" :disabled="waSending" aria-label="Send on WhatsApp" title="Send on WhatsApp">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" style="display:block;">
                            <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.815zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.15-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"></path>
                        </svg>
                    </button>
                    <!-- Recipient menu (colours mirror the IPD app). -->
                    <div x-show="waMenuOpen" x-transition.opacity="" @click.outside="waMenuOpen = false" class="absolute right-0 top-full mt-1.5 w-56 rounded-lg shadow-2xl overflow-hidden z-20 text-sm font-medium text-slate-800" style="display:none">
                        <button type="button" @click="sendAdmissionWhatsapp('send_admission_card_to_patient')" class="w-full text-left px-4 py-3 bg-amber-300 hover:bg-amber-400 transition">Send to Patient</button>
                        <button type="button" @click="sendAdmissionWhatsapp('send_admission_card_to_consultant')" class="w-full text-left px-4 py-3 bg-green-300 hover:bg-green-400 transition">Send to Consultant</button>
                        <button type="button" @click="sendAdmissionWhatsapp('send_admission_card_to_reference')" class="w-full text-left px-4 py-3 bg-sky-300 hover:bg-sky-400 transition">Send to Referred Dr.</button>
                        <button type="button" @click="sendAdmissionWhatsapp('send_admission_card_to_relative')" class="w-full text-left px-4 py-3 bg-purple-300 hover:bg-purple-400 transition">Send to Relative</button>
                    </div>
                </div>

                <!-- Share the PDF (Web Share API → file when supported). -->
                <button type="button" @click="sharePdf()" x-show="pdfShowShare" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Share" title="Share" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="share-2" aria-hidden="true" style="width:21px;height:21px;display:block;" class="lucide lucide-share-2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
                </button>

                <!-- Print the rendered PDF. -->
                <button type="button" @click="printPdf()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Print" title="Print">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="printer" aria-hidden="true" style="width:21px;height:21px;display:block;" class="lucide lucide-printer"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>
                </button>
            </div>
            <!-- PDF rendered inline with PDF.js (the tablet runs in an Android
                 WebView, which can't display a PDF in an iframe natively) so the
                 PDF shows directly in this viewer — no manual open. Canvases are
                 appended into this box by _renderPdf(). -->
            <div id="pdfViewerBox" class="flex-1 min-h-0 overflow-auto bg-slate-200 p-3 flex flex-col items-center gap-3"></div>

            <!-- Floating "Do signature" — bottom-LEFT, orange. Only for the
                 documents that carry it (pdfSignVisible, set per item by
                 openPdfViewer → currently MRD Checklist Count); the admission
                 card and other read-only streams don't show it. -->
            <button type="button" x-show="pdfSignVisible &amp;&amp; !viewOnlyActive()" @click="doSignature(pdfTitle)" class="absolute bottom-5 left-5 z-20 inline-flex items-center gap-2 rounded-full text-white bg-orange-500 hover:bg-orange-600 pl-4 pr-5 py-3 shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-300 transition" :title="'Do signature on ' + pdfTitle" :aria-label="'Do signature on ' + pdfTitle" style="display:none" title="Do signature on " aria-label="Do signature on ">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block" aria-hidden="true">
                    <path d="M3 17c3 0 4-9 7-9s3 7 6 7 2-4 5-4"></path><path d="M3 21h18"></path>
                </svg>
                <span class="text-sm font-semibold">Do signature</span>
            </button>
        </div>

        <!-- ============================================================ -->
        <!-- DIET RECORDS — full-screen window (Digital NABH → Diet Records).  -->
        <!-- App bar: back · "Diet Records" + the patient line · Assign Diet.  -->
        <!-- Floats over the main screen, which is left untouched underneath;  -->
        <!-- back / Esc returns straight to it.                                -->
        <!-- ============================================================ -->
        <div x-show="dietOpen" x-transition.opacity="" @keydown.escape.window="closeDietRecords()" class="fixed inset-0 z-[90] bg-slate-100 flex flex-col" style="display:none">
            <!-- App bar -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-lime-600">
                <button type="button" @click="closeDietRecords()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate">Diet Records</div>
                    <!-- Name (with salutation) (age/gender) [IPD No] -->
                    <div class="text-xs opacity-90 truncate" x-text="dietPatientLine() || '—'">JAGDISHBHAI AHUJA (42 Y, 2 M, 12 D/Male) [IP/2026-2027/1619]</div>
                </div>
                <button type="button" @click="assignDiet()" class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-white/15 hover:bg-white/25 px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-white/40" title="Assign Diet" aria-label="Assign Diet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="utensils" aria-hidden="true" style="width:17px;height:17px;display:block;" class="lucide lucide-utensils"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><path d="M7 2v20"></path><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path></svg>
                    <span>Assign Diet</span>
                </button>
            </div>

            <!-- Body — this patient's assign history, newest day first, one
                 group per date (same shape as the documents grid). -->
            <div class="flex-1 min-h-0 overflow-auto p-4">
                <div class="max-w-3xl mx-auto">
                    <div x-show="dietListLoading" class="flex items-center justify-center gap-2 text-slate-500 py-16" style="display: none;">
                        <svg class="animate-spin" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span>Loading diet records…</span>
                    </div>

                    <div x-show="!dietListLoading &amp;&amp; dietList.length === 0" class="text-center text-slate-500 py-16">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-lime-100 text-lime-600 mb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="utensils" aria-hidden="true" style="width:26px;height:26px;display:block;" class="lucide lucide-utensils"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path><path d="M7 2v20"></path><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path></svg>
                        </div>
                        <div class="font-medium text-slate-700">No diet records yet</div>
                        <div class="text-xs mt-1">Use <span class="font-semibold">Assign Diet</span> to add one.</div>
                    </div>

                    <template x-for="grp in groupedDietByDate()" :key="grp.day"></template>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- PATIENT FEEDBACK FORM — "Fill Feedback Form here". Floating     -->
        <!-- full-screen window over the app: app bar (title + patient),     -->
        <!-- the form in an iframe, and a GET WELL SOON strip at the foot.   -->
        <!-- Which URL loads is per-hospital (feedbackFormUrl()).            -->
        <!-- ============================================================ -->
        <div x-show="feedbackFormOpen" x-transition.opacity="" @keydown.escape.window="closeFeedbackForm()" class="fixed inset-0 z-[96] bg-slate-900/50" style="display:none">
            <div class="absolute inset-2 sm:inset-4 rounded-xl overflow-hidden shadow-2xl bg-white flex flex-col">
                <!-- App bar -->
                <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-orange-600">
                    <button type="button" @click="closeFeedbackForm()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                    </button>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-lg truncate">Patient Feedback Form</div>
                        <div class="text-xs opacity-90 truncate" x-text="patientNameAge() || '—'">JAGDISHBHAI AHUJA (42 Y, 2 M, 12 D/Male)</div>
                    </div>
                    <!-- An off-site form (the g.co links) usually refuses to be
                         framed, so offer the browser as the way out. -->
                    <button type="button" x-show="feedbackFormExternal" @click="openFeedbackFormInBrowser()" class="shrink-0 inline-flex items-center gap-1.5 rounded-lg bg-white/15 hover:bg-white/25 px-3 py-2 text-sm font-semibold" title="Open in browser" aria-label="Open in browser" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="external-link" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-external-link"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
                        <span>Open in browser</span>
                    </button>
                </div>

                <!-- The form. src bound only while open so closing stops it. -->
                <iframe x-show="feedbackFormOpen" :src="feedbackFormOpen ? feedbackFormUrl : ''" class="flex-1 min-h-0 w-full border-0 bg-white" title="Patient Feedback Form" allow="camera; microphone; clipboard-write" src="/pwa/files/saved_resource(1).html" style="display: none;"></iframe>

                <!-- Static well-wish strip. -->
                <div class="shrink-0 bg-orange-50 border-t border-orange-200 py-3 text-center">
                    <span class="font-bold text-2xl tracking-wide text-orange-700">GET WELL SOON</span>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- REQUEST TO PATIENT FOR FEEDBACK — confirmation. Two ways to     -->
        <!-- collect it: fill the form on this tablet, or WhatsApp the link  -->
        <!-- to the patient's number.                                        -->
        <!-- ============================================================ -->
        <div x-show="feedbackAskOpen" x-transition.opacity="" @keydown.escape.window="feedbackAskOpen = false" class="fixed inset-0 z-[92] bg-slate-900/50 flex items-end sm:items-center justify-center sm:p-4" style="display:none" @click.self="feedbackAskOpen = false">
            <div class="bg-white w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl shadow-2xl">
                <div class="px-5 py-4 border-b border-slate-200 flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="star" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
                    </span>
                    <span class="font-semibold text-slate-800 leading-snug">Send Hospital Feedback Request on Whatsapp</span>
                </div>
                <div class="p-5 text-sm text-slate-700">
                    Are you sure want to Request for Hospital Feedback?
                </div>
                <!-- Stacked on the tablet so the two long labels never truncate. -->
                <div class="px-5 py-3 border-t border-slate-200 flex flex-col sm:flex-row sm:justify-end gap-2">
                    <button type="button" @click="feedbackAskOpen = false" :disabled="feedbackSending" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg disabled:opacity-40 sm:order-1">Cancel</button>
                    <button type="button" @click="feedbackFillHere()" :disabled="feedbackSending" class="px-4 py-2 rounded-lg border border-orange-300 bg-orange-50 text-orange-700 hover:bg-orange-100 text-sm font-semibold disabled:opacity-50 sm:order-2">
                        Fill Feedback Form here
                    </button>
                    <button type="button" @click="feedbackSendWhatsapp()" :disabled="feedbackSending" class="px-4 py-2 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold inline-flex items-center justify-center gap-2 disabled:opacity-50 sm:order-3">
                        <svg x-show="feedbackSending" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="feedbackSending ? 'Sending…' : 'Send Link to Whatsapp'">Send Link to Whatsapp</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- CLINICAL SCALE TYPE — the Digital NABH row's chooser. A         -->
        <!-- dropdown of the scales: Apache II Score · GCS Score.            -->
        <!-- ============================================================ -->
        <div x-show="clinicalScaleOpen" x-transition.opacity="" @keydown.escape.window="clinicalScaleOpen = false" class="fixed inset-0 z-[92] bg-slate-900/50 flex items-end sm:items-center justify-center sm:p-4" style="display:none" @click.self="clinicalScaleOpen = false">
            <div class="bg-white w-full sm:max-w-sm sm:rounded-2xl rounded-t-2xl shadow-2xl overflow-hidden">
                <div class="px-5 py-3.5 bg-fuchsia-600 text-white flex items-center gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="gauge" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-gauge"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
                    <span class="flex-1 font-semibold">Clinical Scale Type</span>
                    <button type="button" @click="clinicalScaleOpen = false" class="p-1 -mr-1 rounded hover:bg-white/10" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>
                <!-- Options -->
                <div class="py-1">
                    <template x-for="s in clinicalScales" :key="s"></template><button type="button" @click="pickClinicalScale(s)" class="w-full text-left px-5 py-3.5 text-sm font-medium text-slate-700 hover:bg-fuchsia-50 hover:text-fuchsia-700 transition flex items-center gap-2 border-b border-slate-100 last:border-b-0">
                            <span class="flex-1 truncate" x-text="s">Apache II Score</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-right" aria-hidden="true" class="lucide lucide-chevron-right text-slate-300" style="width:18px;height:18px;display:block;"><path d="m9 18 6-6-6-6"></path></svg>
                        </button><button type="button" @click="pickClinicalScale(s)" class="w-full text-left px-5 py-3.5 text-sm font-medium text-slate-700 hover:bg-fuchsia-50 hover:text-fuchsia-700 transition flex items-center gap-2 border-b border-slate-100 last:border-b-0">
                            <span class="flex-1 truncate" x-text="s">GCS Score</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-right" aria-hidden="true" class="lucide lucide-chevron-right text-slate-300" style="width:18px;height:18px;display:block;"><path d="m9 18 6-6-6-6"></path></svg>
                        </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- DELETE DIET RECORD — long-press a history row. Names the       -->
        <!-- interval, who assigned it and when, so the user can tell two   -->
        <!-- same-day rows apart before confirming.                         -->
        <!-- ============================================================ -->
        <div x-show="dietDeleteRec" x-transition.opacity="" @keydown.escape.window="dietDeleteRec = null" class="fixed inset-0 z-[94] bg-slate-900/50 flex items-end sm:items-center justify-center sm:p-4" style="display:none" @click.self="dietDeleteRec = null">
            <div class="bg-white w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl shadow-2xl">
                <div class="px-5 py-4 border-b border-slate-200 flex items-center gap-2.5">
                    <span class="w-9 h-9 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </span>
                    <span class="font-semibold text-slate-800">Delete Diet Record?</span>
                </div>
                <div class="p-5 text-sm text-slate-700 leading-relaxed">
                    <div class="font-semibold" x-text="(dietDeleteRec &amp;&amp; dietDeleteRec.interval) || '—'">—</div>
                    <div class="text-slate-500 mt-1" x-text="dietDeleteRec
                                 ? ('{Diet assign By ' + &quot;'&quot; + (dietDeleteRec.assigned_by || '—') + &quot;'&quot;
                                    + ' at ' + fmtDateTime(dietDeleteRec.assign_at) + '}')
                                 : ''"></div>
                </div>
                <div class="px-5 py-3 border-t border-slate-200 flex justify-end gap-2">
                    <button type="button" @click="dietDeleteRec = null" :disabled="dietDeleting" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg disabled:opacity-40">No</button>
                    <button type="button" @click="dietDeleteConfirmed()" :disabled="dietDeleting" class="px-5 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                        <svg x-show="dietDeleting" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="dietDeleting ? 'Deleting…' : 'Yes'">Yes</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- ASSIGN DIET — dialog over the Diet Records window. Centred     -->
        <!-- title, then "Select Diet Interval" with a searchable dropdown   -->
        <!-- fed by mst_diet_interval for the session hospital.              -->
        <!-- ============================================================ -->
        <div x-show="dietAssignOpen" x-transition.opacity="" @keydown.escape.window="closeAssignDiet()" class="fixed inset-0 z-[92] bg-slate-900/50 flex items-end sm:items-center justify-center sm:p-4" style="display:none" @click.self="closeAssignDiet()">
            <div class="bg-white w-full sm:max-w-lg sm:rounded-2xl rounded-t-2xl shadow-2xl">
                <!-- Title — centred, with the patient it applies to. -->
                <div class="relative px-12 py-4 border-b border-slate-200">
                    <div class="text-center font-semibold text-slate-800 leading-snug" x-text="(dietEditId === null ? 'Assign Diet for ' : 'Update Diet of ')
                                 + &quot;'&quot; + patientNameAge() + &quot;'&quot;">Assign Diet for 'JAGDISHBHAI AHUJA (42 Y, 2 M, 12 D/Male)'</div>
                    <button type="button" @click="closeAssignDiet()" class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>

                <div class="p-5">
                    <!-- Label + searchable dropdown, side by side. Hidden
                         outright when this hospital has no diet intervals — a
                         dropdown that can never have an option is noise. -->
                    <div x-show="dietIntervalOptions.length &gt; 0" class="flex items-center gap-3" style="display: none;">
                        <label class="shrink-0 text-sm font-medium text-slate-700">Select Diet Interval<span class="text-rose-600">&nbsp;*</span></label>
                        <div class="relative flex-1 min-w-0" @click.outside="dietIntervalListOpen = false">
                            <button type="button" @click="dietIntervalListOpen = !dietIntervalListOpen; dietIntervalSearch = ''" class="w-full flex items-center justify-between gap-2 text-sm border rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-lime-500 focus:ring-1 focus:ring-lime-200 border-slate-300 text-slate-500" :class="dietIntervalId !== null ? 'border-lime-400 text-slate-800' : 'border-slate-300 text-slate-500'">
                                <span class="truncate" x-text="dietIntervalLabel()">Select interval…</span>
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none transition-transform" :class="dietIntervalListOpen ? 'rotate-180' : ''">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                            <div x-show="dietIntervalListOpen" x-transition.opacity="" class="absolute z-30 left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-64 overflow-y-auto" style="display:none">
                                <div class="sticky top-0 bg-white border-b border-slate-100 p-1.5">
                                    <input type="search" x-model="dietIntervalSearch" placeholder="Search interval…" class="w-full text-sm border border-slate-200 rounded px-2 py-1.5 focus:outline-none focus:border-lime-400 focus:ring-1 focus:ring-lime-200">
                                </div>
                                <div x-show="dietIntervalLoading" class="px-3 py-3 text-sm text-slate-400" style="display: none;">Loading intervals…</div>
                                <template x-for="opt in filterOptions(dietIntervalOptions, dietIntervalSearch)" :key="opt.id"></template>
                                <div x-show="!dietIntervalLoading &amp;&amp; filterOptions(dietIntervalOptions, dietIntervalSearch).length === 0" class="px-3 py-3 text-sm text-slate-400">No matching interval.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Diet Type — mst_diet_type (a GLOBAL master, not
                         per-hospital), active rows only. -->
                    <div x-show="dietTypeOptions.length &gt; 0" class="flex items-center gap-3 mt-4" style="display: none;">
                        <label class="shrink-0 text-sm font-medium text-slate-700">Select Diet Type<span class="text-rose-600">&nbsp;*</span></label>
                        <div class="relative flex-1 min-w-0" @click.outside="dietTypeListOpen = false">
                            <button type="button" @click="dietTypeListOpen = !dietTypeListOpen; dietTypeSearch = ''" class="w-full flex items-center justify-between gap-2 text-sm border rounded-lg px-3 py-2 bg-white focus:outline-none focus:border-lime-500 focus:ring-1 focus:ring-lime-200 border-slate-300 text-slate-500" :class="dietTypeId !== null ? 'border-lime-400 text-slate-800' : 'border-slate-300 text-slate-500'">
                                <span class="truncate" x-text="dietTypeLabel()">Select diet type…</span>
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none transition-transform" :class="dietTypeListOpen ? 'rotate-180' : ''">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                            <div x-show="dietTypeListOpen" x-transition.opacity="" class="absolute z-30 left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg max-h-64 overflow-y-auto" style="display:none">
                                <div class="sticky top-0 bg-white border-b border-slate-100 p-1.5">
                                    <input type="search" x-model="dietTypeSearch" placeholder="Search diet type…" class="w-full text-sm border border-slate-200 rounded px-2 py-1.5 focus:outline-none focus:border-lime-400 focus:ring-1 focus:ring-lime-200">
                                </div>
                                <div x-show="dietTypeLoading" class="px-3 py-3 text-sm text-slate-400" style="display: none;">Loading diet types…</div>
                                <template x-for="opt in filterOptions(dietTypeOptions, dietTypeSearch)" :key="opt.id"></template>
                                <div x-show="!dietTypeLoading &amp;&amp; filterOptions(dietTypeOptions, dietTypeSearch).length === 0" class="px-3 py-3 text-sm text-slate-400">No matching diet type.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Remark — optional free text. -->
                    <div class="flex items-start gap-3 mt-4">
                        <label for="dietRemark" class="shrink-0 text-sm font-medium text-slate-700 pt-2">Remark (If any)</label>
                        <textarea id="dietRemark" x-model="dietRemark" rows="2" maxlength="255" placeholder="Type a remark…" class="flex-1 min-w-0 text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-lime-200 focus:border-lime-500 resize-none"></textarea>
                    </div>

                    <!-- Who + when — both fixed at open time, not editable. -->
                    <div class="mt-4 space-y-1 text-sm text-slate-600">
                        <div>
                            <span class="font-medium text-slate-700">Diet assign By User :</span>
                            <span x-text="dietAssignByLabel || '—'">—</span>
                        </div>
                        <div>
                            <span class="font-medium text-slate-700">Diet assign Date :</span>
                            <span x-text="dietAssignAtLabel || '—'">—</span>
                        </div>
                    </div>

                    <!-- Outside the picked interval's window → the assign is
                         refused, and the allowed window is spelled out. -->
                    <div x-show="dietIntervalError" class="mt-3 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2.5 text-sm text-rose-700 leading-snug" style="display:none" x-text="dietIntervalError"></div>

                    <!-- Nothing configured → the matching dropdown above is
                         hidden, so say why the dialog is (partly) bare. -->
                    <div x-show="!dietIntervalLoading &amp;&amp; dietIntervalOptions.length === 0" class="text-sm text-slate-500 text-center py-2">
                        No diet intervals are set up for this hospital.
                    </div>
                    <div x-show="!dietTypeLoading &amp;&amp; dietTypeOptions.length === 0" class="text-sm text-slate-500 text-center py-2">
                        No active diet types are set up.
                    </div>
                    <div x-show="(dietIntervalLoading &amp;&amp; dietIntervalOptions.length === 0) || (dietTypeLoading &amp;&amp; dietTypeOptions.length === 0)" class="text-sm text-slate-400 text-center py-2" style="display: none;">Loading…</div>
                </div>

                <!-- Footer — Cancel · Assign Diet. Assign stays TAPPABLE with
                     the compulsory fields empty: submitAssignDiet() is what
                     tells the user which one is missing (a disabled button
                     would just sit there saying nothing). -->
                <div class="px-5 py-3 border-t border-slate-200 flex justify-end gap-2">
                    <button type="button" @click="closeAssignDiet()" :disabled="dietSaving" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-lg disabled:opacity-40">Cancel</button>
                    <button type="button" @click="submitAssignDiet()" :disabled="dietSaving" class="px-5 py-2 rounded-lg bg-lime-600 hover:bg-lime-700 text-white text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                        <svg x-show="dietSaving" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="dietSaving
                                      ? (dietEditId === null ? 'Assigning…' : 'Updating…')
                                      : (dietEditId === null ? 'Assign Diet' : 'Update Diet')">Assign Diet</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- IPD History — past admissions for a returning patient. Opened     -->
        <!-- from the amber history icon on a card. Lists each prior           -->
        <!-- discharged admission (photo, IPD No., admit + discharge time);    -->
        <!-- tap a row → that admission's Full Patient File. A single past      -->
        <!-- admission skips this list and opens the file directly.            -->
        <!-- ============================================================ -->
        <div x-show="ipdHistoryOpen" x-transition.opacity="" @keydown.escape.window="ipdHistoryOpen = false" class="fixed inset-0 z-[55] bg-black/40 flex items-end sm:items-center justify-center" style="display:none">
            <div @click.outside="ipdHistoryOpen = false" class="w-full sm:max-w-lg bg-white rounded-t-2xl sm:rounded-2xl shadow-2xl flex flex-col max-h-[85vh] overflow-hidden">
                <!-- Header -->
                <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-amber-600">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-white/15">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"></path><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"></path><path d="M12 7v5l4 2"></path></svg>
                    </span>
                    <div class="flex-1 min-w-0">
                        <div class="font-semibold text-base truncate">IPD History</div>
                        <div class="text-xs opacity-90 truncate" x-text="'Past admissions: ' + (ipdHistoryPatientName || '—')">Past admissions: —</div>
                    </div>
                    <button type="button" @click="ipdHistoryOpen = false" class="p-2 rounded hover:bg-white/10" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>

                <!-- Loading -->
                <div x-show="ipdHistoryLoading" class="flex items-center justify-center gap-2 text-slate-500 text-sm py-10" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="loader" aria-hidden="true" class="lucide lucide-loader animate-spin" style="width:18px;height:18px;display:block;"><path d="M12 2v4"></path><path d="m16.2 7.8 2.9-2.9"></path><path d="M18 12h4"></path><path d="m16.2 16.2 2.9 2.9"></path><path d="M12 18v4"></path><path d="m4.9 19.1 2.9-2.9"></path><path d="M2 12h4"></path><path d="m4.9 4.9 2.9 2.9"></path></svg>
                    <span>Loading history…</span>
                </div>

                <!-- Empty -->
                <div x-show="!ipdHistoryLoading &amp;&amp; ipdHistoryItems.length === 0" class="text-center text-sm text-slate-500 py-10">No past admissions found.</div>

                <!-- List -->
                <ul x-show="!ipdHistoryLoading &amp;&amp; ipdHistoryItems.length &gt; 0" class="flex-1 min-h-0 overflow-auto divide-y divide-slate-100" style="display: none;">
                    <template x-for="h in ipdHistoryItems" :key="h.id"></template>
                </ul>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Eye viewer — floating, non-modal patient-file flip window opened  -->
        <!-- from the edit-toolbar eye icon. Shows one "leaf" at a time in     -->
        <!-- order (admission PDF → handwritten → documents/reports →          -->
        <!-- operative → discharge) with « » page navigation and a category    -->
        <!-- filter. The outer layer is pointer-events-none so the editor      -->
        <!-- behind stays usable; only the card itself captures input.         -->
        <!-- ============================================================ -->
        <div x-show="eyeOpen" x-transition.opacity="" @keydown.escape.window="closeEye()" class="fixed inset-0 z-[58] pointer-events-none" style="display:none">
            <div class="pointer-events-auto absolute bg-white shadow-2xl border border-slate-300 flex flex-col overflow-hidden rounded-2xl" :class="eyeFull ? 'rounded-none' : 'rounded-2xl'" :style="eyeCardStyle()" style="left:50%;top:50%;width:50vw;height:50vh;transform:translate(calc(-50% + 0px), calc(-50% + 0px));">
                <!-- Header — doubles as the drag handle (when unlocked and not
                     fullscreen). @pointerdown starts a pointer-captured drag. -->
                <div class="px-4 py-2.5 flex items-center gap-3 border-b border-slate-200 bg-slate-50 shrink-0 select-none cursor-move" :class="(!eyeLocked &amp;&amp; !eyeFull) ? 'cursor-move' : ''" style="touch-action:none;" @pointerdown="eyeDragStart($event)">
                    <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-teal-50 text-teal-600 flex-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="eye" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </span>
                    <div class="flex-1 min-w-0 font-semibold text-teal-700 truncate" x-text="eyePatientName || 'Patient File'">Patient File</div>
                    <div class="flex-none text-sm font-semibold text-slate-600 tabular-nums" x-text="'Pages: ' + eyeLeaves.length">Pages: 0</div>
                    <button type="button" @click="closeEye()" class="flex-none p-1.5 rounded hover:bg-slate-200 text-slate-500" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>

                <!-- Filter row: [lock position] · category dropdown · [fullscreen] -->
                <div class="px-3 py-2 flex items-center gap-2 border-b border-slate-100 shrink-0">
                    <!-- Lock the window position. Locked → drag disabled, stays at
                         its last spot; unlocked → movable again. -->
                    <button type="button" @click="eyeLocked = !eyeLocked; $nextTick(() =&gt; window.lucide &amp;&amp; window.lucide.createIcons())" class="flex-none inline-flex items-center justify-center w-9 h-9 rounded-lg border transition border-slate-300 text-slate-600 hover:bg-slate-100" :class="eyeLocked ? 'border-rose-300 bg-rose-50 text-rose-600' : 'border-slate-300 text-slate-600 hover:bg-slate-100'" :title="eyeLocked ? 'Position locked — tap to unlock &amp; move' : 'Lock window position'" :aria-label="eyeLocked ? 'Unlock position' : 'Lock position'" title="Lock window position" aria-label="Lock position">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock-open" aria-hidden="true" :data-lucide="eyeLocked ? 'lock' : 'lock-open'" style="width:16px;height:16px;display:block;" class="lucide lucide-lock-open"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                    </button>
                    <div class="relative flex-1 min-w-0" x-data="{ open: false, q: '' }">
                        <button type="button" @click="open = !open; if (open) { q = ''; $nextTick(() =&gt; $refs.eyeCatSearch &amp;&amp; $refs.eyeCatSearch.focus()); }" class="w-full flex items-center gap-2 border border-slate-300 rounded-lg px-3 py-1.5 text-sm bg-white text-slate-700 hover:bg-slate-50">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="filter" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-filter text-slate-400 flex-none"><path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z"></path></svg>
                            <span class="flex-1 truncate text-left" x-text="eyeCat || 'All IPD Categories'">All IPD Categories</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" :data-lucide="open ? 'chevron-up' : 'chevron-down'" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down flex-none"><path d="m6 9 6 6 6-6"></path></svg>
                        </button>
                        <div x-show="open" @click.outside="open = false" x-transition.opacity="" class="absolute left-0 top-full mt-1 z-10 w-full bg-white border border-slate-200 rounded-lg shadow-lg overflow-hidden" style="display:none">
                            <!-- Search box — filters the category list live. -->
                            <div class="p-2 border-b border-slate-100">
                                <div class="flex items-center gap-2 border border-slate-300 rounded-md px-2 py-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-search text-slate-400 flex-none"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                                    <input type="search" x-ref="eyeCatSearch" x-model="q" placeholder="Search category" @click.stop="" class="flex-1 min-w-0 outline-none text-sm bg-transparent placeholder-slate-400">
                                </div>
                            </div>
                            <div class="max-h-56 overflow-auto">
                                <button type="button" x-show="'all ipd categories'.includes(q.toLowerCase())" @click="eyeSelectCat(''); open = false" class="w-full text-left px-3 py-2 text-sm flex items-center justify-between hover:bg-teal-50 border-b border-slate-100 text-teal-700 font-semibold bg-teal-50" :class="eyeCat === '' ? 'text-teal-700 font-semibold bg-teal-50' : 'text-slate-700'">
                                    <span>All IPD Categories</span>
                                    <span class="text-xs text-slate-400 ml-2" x-text="eyeLeaves.length">0</span>
                                </button>
                                <template x-for="c in eyeCategories().filter(c =&gt; c.name.toLowerCase().includes(q.toLowerCase()))" :key="c.name"></template>
                                <div x-show="eyeCategories().filter(c =&gt; c.name.toLowerCase().includes(q.toLowerCase())).length === 0 &amp;&amp; !'all ipd categories'.includes(q.toLowerCase())" class="px-3 py-2 text-xs text-slate-400" style="display: none;">No matching category.</div>
                            </div>
                        </div>
                    </div>
                    <!-- Toggle fullscreen ↔ quarter-screen for THIS window. -->
                    <button type="button" @click="eyeToggleFull()" class="flex-none inline-flex items-center justify-center w-9 h-9 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100" :title="eyeFull ? 'Restore to quarter screen' : 'Expand to full screen'" :aria-label="eyeFull ? 'Restore' : 'Full screen'" title="Expand to full screen" aria-label="Full screen">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="maximize-2" aria-hidden="true" :data-lucide="eyeFull ? 'minimize-2' : 'maximize-2'" style="width:16px;height:16px;display:block;" class="lucide lucide-maximize-2"><path d="M15 3h6v6"></path><path d="m21 3-7 7"></path><path d="m3 21 7-7"></path><path d="M9 21H3v-6"></path></svg>
                    </button>
                </div>

                <!-- Body -->
                <div class="flex-1 min-h-0 relative bg-slate-200">
                    <!-- Loading -->
                    <div x-show="eyeLoading" class="absolute inset-0 flex items-center justify-center gap-2 text-slate-500 text-sm" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="loader" aria-hidden="true" class="lucide lucide-loader animate-spin" style="width:18px;height:18px;display:block;"><path d="M12 2v4"></path><path d="m16.2 7.8 2.9-2.9"></path><path d="M18 12h4"></path><path d="m16.2 16.2 2.9 2.9"></path><path d="M12 18v4"></path><path d="m4.9 19.1 2.9-2.9"></path><path d="M2 12h4"></path><path d="m4.9 4.9 2.9 2.9"></path></svg>
                        <span>Loading file…</span>
                    </div>
                    <!-- Empty -->
                    <div x-show="!eyeLoading &amp;&amp; eyeFilteredLeaves().length === 0" class="absolute inset-0 flex items-center justify-center text-sm text-slate-500 px-6 text-center">
                        No records to show.
                    </div>
                    <!-- Current leaf. The page fills the window WIDTH edge-to-edge
                         (in both quarter & fullscreen) and the body scrolls
                         vertically for anything taller than the window.
                         ZOOM lives on the inner layer below, so magnifying a page
                         only ever affects what's inside THIS window — the form
                         behind it is untouched — and the overflow-auto box turns
                         into the pan surface once the page is bigger than the card.
                         Two-finger pinch is handled here (single-finger touches fall
                         through to normal scrolling). -->
                    <div x-show="!eyeLoading &amp;&amp; eyeFilteredLeaves().length &gt; 0" class="absolute inset-0 overflow-auto" @touchstart="eyeTouchStart($event)" @touchmove="eyeTouchMove($event)" @touchend="eyeTouchEnd($event)" @touchcancel="eyeTouchEnd($event)" @dblclick="eyeZoomReset()" style="display: none;">
                        <!-- Zoom layer. The magnification is real LAYOUT size —
                             width/min-height of (zoom × 100)% of the scroll box — not
                             CSS `zoom` and not a transform:
                               • `zoom` cancels out here: every child is `w-full`, so
                                 zooming the layer shrinks its own coordinate space by
                                 the same factor and the page renders unchanged (this
                                 is why 400% looked identical to 100%);
                               • `transform` doesn't affect layout, so the scroll box
                                 wouldn't grow and there'd be nothing to pan.
                             Sizing the layer instead makes the overflow-auto parent
                             scroll in both axes, and every child follows because they
                             are all percentage-sized off this layer. -->
                        <div class="flex flex-col items-center" :style="eyeZoomStyle()" style="width:100%; min-height:100%;">
                            <!-- Handwritten / image leaf. A handwritten page FILLS the
                                 whole body (flex-1 → full width AND full height) so it
                                 covers the screen with no empty space; both the form
                                 template and the ink overlay object-fill the same box,
                                 so they stay pixel-aligned. Uploaded IMAGE docs keep
                                 their natural aspect (flex-none) and scroll. -->
                            <template x-if="eyeCurrent() &amp;&amp; (eyeCurrent().type === 'hw' || eyeCurrent().type === 'image')"></template>
                            <!-- PDF leaf (admission / document pdf / operative / discharge).
                                 flex-none so tall PDFs keep their height and the body
                                 scrolls instead of the box being flex-shrunk/clipped. -->
                            <div x-show="eyeCurrent() &amp;&amp; eyeCurrent().type === 'pdf'" id="eyeLeafBox" class="flex-none w-full flex flex-col items-center gap-2 py-2" style="display: none;"></div>
                        </div>
                    </div>

                    <!-- Prev « — left edge, vertically centred -->
                    <button type="button" @click="eyePrev()" x-show="!eyeLoading &amp;&amp; eyeIndex &gt; 0" class="absolute left-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/55 hover:bg-slate-900/75 text-white flex items-center justify-center shadow-lg z-10" aria-label="Previous page" style="display:none">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 17l-5-5 5-5"></path><path d="M11 17l-5-5 5-5"></path></svg>
                    </button>
                    <!-- Next » — right edge, vertically centred -->
                    <button type="button" @click="eyeNext()" x-show="!eyeLoading &amp;&amp; eyeIndex &lt; eyeFilteredLeaves().length - 1" class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/55 hover:bg-slate-900/75 text-white flex items-center justify-center shadow-lg z-10" aria-label="Next page" style="display:none">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 17l5-5-5-5"></path><path d="M13 17l5-5-5-5"></path></svg>
                    </button>
                </div>

                <!-- Footer: zoom controls · position + current leaf label -->
                <div x-show="!eyeLoading &amp;&amp; eyeFilteredLeaves().length &gt; 0" class="px-2 py-1.5 border-t border-slate-200 bg-slate-50 shrink-0 flex items-center gap-2" style="display: none;">
                    <!-- Zoom — affects ONLY the page inside this window. Tap the
                         percentage to snap back to 100%. -->
                    <div class="flex-none flex items-center gap-0.5">
                        <button type="button" @click="eyeZoomOut()" :disabled="eyeZoom &lt;= 1" class="w-7 h-7 rounded-md border border-slate-300 bg-white text-slate-600 hover:bg-slate-100 disabled:opacity-40 flex items-center justify-center" title="Zoom out" aria-label="Zoom out" disabled="disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="minus" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-minus"><path d="M5 12h14"></path></svg>
                        </button>
                        <button type="button" @click="eyeZoomReset()" class="min-w-[42px] h-7 px-1 rounded-md border border-slate-300 bg-white text-[11px] font-semibold text-slate-600 hover:bg-slate-100 tabular-nums" title="Reset zoom to 100%" aria-label="Reset zoom" x-text="Math.round(eyeZoom * 100) + '%'">100%</button>
                        <button type="button" @click="eyeZoomIn()" :disabled="eyeZoom &gt;= 4" class="w-7 h-7 rounded-md border border-slate-300 bg-white text-slate-600 hover:bg-slate-100 disabled:opacity-40 flex items-center justify-center" title="Zoom in" aria-label="Zoom in">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                        </button>
                    </div>
                    <div class="flex-1 min-w-0 text-[11px] text-slate-500 text-center truncate">
                        <span class="font-semibold text-slate-700" x-text="'Page ' + (eyeIndex + 1) + ' of ' + eyeFilteredLeaves().length">Page 1 of 0</span>
                        <span x-show="eyeCurrent() &amp;&amp; eyeCurrent().label" x-text="' · ' + (eyeCurrent() ? eyeCurrent().label : '')" style="display: none;"> · </span>
                    </div>
                    <!-- Balances the zoom cluster so the page label stays centred. -->
                    <div class="flex-none w-[96px]" aria-hidden="true"></div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Full Patient File — full-screen in-app viewer that stitches the   -->
        <!-- whole record in order: Admission PDF → Handwritten pages →        -->
        <!-- Documents & Reports → Operative Notes PDF → Discharge Summary.    -->
        <!-- PDFs render with PDF.js (WebView can't show iframe PDFs); note    -->
        <!-- pages / image documents render as <img>. A sticky section nav     -->
        <!-- jumps between sections. Floats over the main screen.              -->
        <!-- ============================================================ -->
        <div x-show="fullFileOpen" x-transition.opacity="" @keydown.escape.window="closeFullFile()" class="fixed inset-0 z-[60] bg-slate-100 flex flex-col" style="display:none">
            <!-- Header -->
            <div class="px-4 py-3 flex items-center gap-3 text-white shrink-0 bg-indigo-600">
                <button type="button" @click="closeFullFile()" class="p-2 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <div class="flex-1 min-w-0">
                    <div class="font-semibold text-lg truncate">Full Patient File</div>
                    <div class="text-xs opacity-90 truncate" x-text="'Patient: ' + (fullFilePatientName || '—')">Patient: —</div>
                </div>
            </div>

            <!-- Floating patient details — collapsible card pinned to the top-right
                 over the viewer. Collapse it to a pill so it doesn't block pages.
                 Fed by the patient object passed to openFullFile(p). -->
            <div x-show="fullFileOpen &amp;&amp; fullFilePatient" class="absolute z-30" style="top:6.25rem;right:0.75rem;display:none">
                <!-- Collapsed pill -->
                <button type="button" x-show="!fullFileInfoOpen" @click="fullFileInfoOpen = true" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-indigo-600 text-white text-xs font-semibold shadow-lg hover:bg-indigo-700" style="display:none">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Patient
                </button>
                <!-- Expanded card -->
                <div x-show="fullFileInfoOpen" class="w-64 max-w-[78vw] bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
                    <div class="px-3 py-2 bg-indigo-600 text-white flex items-center gap-2">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span class="flex-1 text-sm font-semibold truncate" x-text="fullFilePatient ? fullFilePatient.name : ''"></span>
                        <button type="button" @click="fullFileInfoOpen = false" class="p-1 rounded hover:bg-white/15" aria-label="Collapse">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path></svg>
                        </button>
                    </div>
                    <template x-if="fullFilePatient"></template>
                </div>
            </div>

            <!-- Section navigator -->
            <div class="shrink-0 bg-white border-b border-slate-200 flex gap-1 px-3 py-2 overflow-x-auto">
                <template x-for="s in fullFileSections" :key="s.id"></template><button type="button" @click="scrollFullFile(s.id)" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-indigo-50 text-indigo-700 border-indigo-300" :class="fullFileActive === s.id ? 'bg-indigo-50 text-indigo-700 border-indigo-300' : 'text-slate-500 border-transparent hover:bg-slate-100'">
                        <span x-text="s.num + '. ' + s.label">1. Admission</span>
                    </button><button type="button" @click="scrollFullFile(s.id)" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition text-slate-500 border-transparent hover:bg-slate-100" :class="fullFileActive === s.id ? 'bg-indigo-50 text-indigo-700 border-indigo-300' : 'text-slate-500 border-transparent hover:bg-slate-100'">
                        <span x-text="s.num + '. ' + s.label">2. Handwritten</span>
                    </button><button type="button" @click="scrollFullFile(s.id)" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition text-slate-500 border-transparent hover:bg-slate-100" :class="fullFileActive === s.id ? 'bg-indigo-50 text-indigo-700 border-indigo-300' : 'text-slate-500 border-transparent hover:bg-slate-100'">
                        <span x-text="s.num + '. ' + s.label">3. Documents</span>
                    </button><button type="button" @click="scrollFullFile(s.id)" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition text-slate-500 border-transparent hover:bg-slate-100" :class="fullFileActive === s.id ? 'bg-indigo-50 text-indigo-700 border-indigo-300' : 'text-slate-500 border-transparent hover:bg-slate-100'">
                        <span x-text="s.num + '. ' + s.label">4. Operative</span>
                    </button><button type="button" @click="scrollFullFile(s.id)" class="whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-semibold border transition text-slate-500 border-transparent hover:bg-slate-100" :class="fullFileActive === s.id ? 'bg-indigo-50 text-indigo-700 border-indigo-300' : 'text-slate-500 border-transparent hover:bg-slate-100'">
                        <span x-text="s.num + '. ' + s.label">5. Discharge</span>
                    </button>
            </div>

            <!-- Loading -->
            <div x-show="fullFileLoading" class="flex-1 flex items-center justify-center text-slate-500 text-sm gap-2" style="display: none;">
                <svg class="animate-spin" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                Loading patient file…
            </div>

            <!-- Body -->
            <div x-show="!fullFileLoading" id="ffScroll" class="flex-1 min-h-0 overflow-auto bg-slate-200 p-3 sm:p-4 flex flex-col items-center gap-4">
                <div class="w-full max-w-3xl flex flex-col gap-6">

                    <!-- 1. Admission Form -->
                    <section id="ff-sec-admission" class="scroll-mt-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-700 mb-2">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md text-white text-xs font-bold bg-teal-600">1</span> Admission Form
                        </div>
                        <div id="ffAdmissionBox" class="bg-slate-100 rounded-lg p-2 flex flex-col items-center gap-2 min-h-[120px]"></div>
                    </section>

                    <!-- 2. Handwritten pages -->
                    <section id="ff-sec-handwritten" class="scroll-mt-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-700 mb-2">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md text-white text-xs font-bold bg-emerald-600">2</span> Handwritten Pages
                            <span class="text-xs font-medium text-slate-400 ml-1" x-text="'(' + fullFileData.handwritten.length + ')'">(0)</span>
                        </div>
                        <template x-if="fullFileData.handwritten.length === 0"></template><div class="text-sm text-slate-400 bg-white rounded-lg border border-slate-200 px-4 py-6 text-center">No handwritten pages.</div>
                        <!-- Category filter — searchable single-select dropdown.
                             Shown only when there's more than one category. open/q
                             are local; the selection binds to fullFileHwCategory. -->
                        <div x-show="fullFileHwCategories().length &gt; 1" class="mb-3" x-data="{ open: false, q: '' }" @click.outside="open = false" style="display: none;">
                            <div class="text-[11px] font-semibold text-slate-400 uppercase tracking-wide mb-1">Filter by category</div>
                            <div class="relative w-full sm:w-80">
                                <button type="button" @click="open = !open; q = ''" class="w-full flex items-center justify-between gap-2 px-3 py-2 rounded-lg border bg-white text-sm transition border-slate-300 hover:border-emerald-300" :class="open ? 'border-emerald-400 ring-2 ring-emerald-100' : 'border-slate-300 hover:border-emerald-300'">
                                    <span class="truncate text-slate-700" x-text="fullFileHwCategory ? (fullFileHwCategory + ' (' + fullFileHandwrittenFiltered().length + ')') : ('All categories (' + fullFileData.handwritten.length + ')')">All categories (0)</span>
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-slate-400 transition-transform" :class="open ? 'rotate-180' : ''"><path d="M6 9l6 6 6-6"></path></svg>
                                </button>
                                <div x-show="open" x-transition.opacity="" style="display:none" class="absolute z-20 mt-1 w-full bg-white border border-slate-200 rounded-lg shadow-lg overflow-hidden">
                                    <div class="p-2 border-b border-slate-100">
                                        <input x-model="q" type="text" placeholder="Search category…" class="w-full px-2.5 py-1.5 text-sm border border-slate-200 rounded-md focus:outline-none focus:border-emerald-400">
                                    </div>
                                    <div class="max-h-60 overflow-auto py-1">
                                        <button type="button" @click="fullFileHwCategory = ''; fullFileHwIndex = 0; open = false; q = ''" class="w-full text-left px-3 py-2 text-sm flex items-center justify-between hover:bg-emerald-50 text-emerald-700 font-semibold bg-emerald-50" :class="fullFileHwCategory === '' ? 'text-emerald-700 font-semibold bg-emerald-50' : 'text-slate-700'">
                                            <span>All categories</span>
                                            <span class="text-xs text-slate-400 ml-2" x-text="fullFileData.handwritten.length">0</span>
                                        </button>
                                        <template x-for="c in fullFileHwCategories().filter(c =&gt; c.name.toLowerCase().includes(q.toLowerCase()))" :key="c.name"></template>
                                        <div x-show="fullFileHwCategories().filter(c =&gt; c.name.toLowerCase().includes(q.toLowerCase())).length === 0" class="px-3 py-2 text-xs text-slate-400">No matching category.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- One page at a time, with prev/next icons pinned to the
                             vertical centre of the left/right sides. -->
                        <template x-if="fullFileHandwrittenFiltered().length &gt; 0"></template>
                    </section>

                    <!-- 3. Documents & Reports -->
                    <section id="ff-sec-documents" class="scroll-mt-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-700 mb-2">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md text-white text-xs font-bold bg-pink-600">3</span> Documents &amp; Reports
                            <span class="text-xs font-medium text-slate-400 ml-1" x-text="'(' + fullFileData.documents.length + ')'">(0)</span>
                        </div>
                        <template x-if="fullFileData.documents.length === 0"></template><div class="text-sm text-slate-400 bg-white rounded-lg border border-slate-200 px-4 py-6 text-center">No other documents or reports.</div>
                        <div class="flex flex-col gap-3">
                            <template x-for="d in fullFileData.documents" :key="d.id"></template>
                        </div>
                    </section>

                    <!-- 4. Operative Notes -->
                    <section id="ff-sec-operative" class="scroll-mt-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-700 mb-2">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md text-white text-xs font-bold bg-rose-600">4</span> Operative Notes
                        </div>
                        <template x-if="!fullFileData.operative"></template><div class="text-sm text-slate-400 bg-white rounded-lg border border-slate-200 px-4 py-6 text-center">No operative notes.</div>
                        <div x-show="fullFileData.operative" id="ffOperativeBox" class="bg-slate-100 rounded-lg p-2 flex flex-col items-center gap-2 min-h-[120px]" style="display: none;"></div>
                    </section>

                    <!-- 5. Discharge Summary -->
                    <section id="ff-sec-discharge" class="scroll-mt-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-700 mb-2">
                            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md text-white text-xs font-bold bg-blue-600">5</span> Discharge Summary
                        </div>
                        <template x-if="!fullFileData.discharge"></template><div class="text-sm text-slate-400 bg-white rounded-lg border border-slate-200 px-4 py-6 text-center">No discharge summary.</div>
                        <div x-show="fullFileData.discharge" id="ffDischargeBox" class="bg-slate-100 rounded-lg p-2 flex flex-col items-center gap-2 min-h-[120px]" style="display: none;"></div>
                    </section>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Discard-page confirmation modal                                -->
        <!-- ============================================================ -->
        <div x-show="confirmDiscardOpen" x-transition.opacity="" @keydown.escape.window="confirmDiscardOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-rose-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="alert-triangle" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-alert-triangle"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                    <div class="flex-1 font-semibold">Discard page?</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600">
                        Your changes on this page will be lost. This can't be undone.
                    </p>
                    <div class="flex justify-end gap-2 mt-5">
                        <button type="button" @click="confirmDiscardOpen = false" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            Keep editing
                        </button>
                        <button type="button" @click="confirmDiscard()" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-rose-600 hover:bg-rose-700">
                            Discard page
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Unsaved-edit exit guard: shown when the user navigates away   -->
        <!-- (switch patient / category / close viewer) while the canvas   -->
        <!-- editor has un-saved strokes. Save page · Discard · Keep.      -->
        <!-- ============================================================ -->
        <div x-show="confirmExitOpen" x-transition.opacity="" @keydown.escape.window="confirmExitCancel()" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-amber-500 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="alert-triangle" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-alert-triangle"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                    <div class="flex-1 font-semibold">Unsaved changes</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600">
                        You have unsaved changes on this page. Do you want to save them
                        before leaving, or discard them?
                    </p>
                    <div class="flex flex-col gap-2 mt-5">
                        <button type="button" @click="confirmExitSave()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                            <span>Save page</span>
                        </button>
                        <button type="button" @click="confirmExitDiscard()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Discard changes</span>
                        </button>
                        <button type="button" @click="confirmExitCancel()" class="w-full px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            Keep editing
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- "Saving IPD Page" progress dialog (live save in flight).      -->
        <!-- Blocking + dismiss-less: cleared when the save completes/fails -->
        <!-- (see _saveEditLive's finally).                                -->
        <!-- ============================================================ -->
        <div x-show="savingOpen" x-transition.opacity="" class="fixed inset-0 z-[70] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-xs overflow-hidden">
                <div class="px-5 py-3 bg-teal-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                    <div class="flex-1 font-semibold">Saving IPD Page</div>
                </div>
                <div class="p-5 flex items-center gap-3">
                    <span class="inline-block w-6 h-6 rounded-full border-2 border-teal-200 border-t-teal-600 animate-spin shrink-0"></span>
                    <p class="text-sm text-slate-600">Please Wait....</p>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Upload-failed decision dialog. Shown after the 2 upload        -->
        <!-- attempts fail. The page stays on screen exactly as-is behind   -->
        <!-- this modal; the user decides: Retry / Save offline / Keep      -->
        <!-- editing. z above the saving dialog.                            -->
        <!-- ============================================================ -->
        <div x-show="uploadFailedOpen" x-transition.opacity="" @keydown.escape.window="dismissFailedSave()" class="fixed inset-0 z-[72] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-rose-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="cloud-off" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-cloud-off"><path d="M10.94 5.274A7 7 0 0 1 15.71 10h1.79a4.5 4.5 0 0 1 4.222 6.057"></path><path d="M18.796 18.81A4.5 4.5 0 0 1 17.5 19H9A7 7 0 0 1 5.79 5.78"></path><path d="m2 2 20 20"></path></svg>
                    <div class="flex-1 font-semibold">Upload failed</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600">
                        The page couldn't be uploaded after 2 attempts. Your work is
                        still here on the page — nothing was lost. What would you like
                        to do?
                    </p>
                    <!-- Exact server / bucket exception (when the server answered
                         with one; blank for a pure network drop). -->
                    <div x-show="_failedSave &amp;&amp; _failedSave.error" class="mt-3 text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg px-3 py-2 break-words whitespace-pre-wrap max-h-32 overflow-auto" x-text="_failedSave &amp;&amp; _failedSave.error" style="display: none;"></div>
                    <div class="flex flex-col gap-2 mt-5">
                        <button type="button" @click="retryFailedSave()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-teal-600 hover:bg-teal-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                            <span>Retry upload</span>
                        </button>
                        <button type="button" @click="saveFailedOffline()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-amber-500 hover:bg-amber-600 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="cloud-off" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-cloud-off"><path d="M10.94 5.274A7 7 0 0 1 15.71 10h1.79a4.5 4.5 0 0 1 4.222 6.057"></path><path d="M18.796 18.81A4.5 4.5 0 0 1 17.5 19H9A7 7 0 0 1 5.79 5.78"></path><path d="m2 2 20 20"></path></svg>
                            <span>Save offline</span>
                        </button>
                        <button type="button" @click="dismissFailedSave()" class="w-full px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            Keep editing
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Delete-page confirmation modal (existing-page edits only)     -->
        <!-- ============================================================ -->
        <!-- Gallery|Labs folder dropdown — anchored under the clicked folder icon. -->
        <div x-show="folderMenuOpen" @click.outside="folderMenuOpen = false" @keydown.escape.window="folderMenuOpen = false" class="fixed z-[70] w-60 max-h-72 overflow-auto bg-white rounded-lg shadow-2xl border border-slate-200 py-1" :style="'top:' + folderMenuTop + 'px; right:' + folderMenuRight + 'px;'" style="top: 0px; right: 0px; display: none;">
            <div class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-slate-400 border-b border-slate-100" x-text="folderMenuTitle"></div>
            <template x-if="folderMenuLoading"></template>
            <template x-if="!folderMenuLoading"></template><div>
                    <!-- Fixed first option (id 0). -->
                    <button type="button" @click="selectDocFolder({ id: 0, folder_name: 'Other Document' })" class="w-full text-left px-3 py-2 text-sm hover:bg-slate-50 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="folder" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                        <span>Other Document</span>
                    </button>
                    <template x-for="f in folderMenuItems" :key="f.id"></template>
                </div>
        </div>

        <!-- Patient Details modal — floating read-only patient view, opened by
             tapping a card avatar. Identity header + the hospital's ENABLED
             admission fields (detail_fields, mhaf.status = 1). Empty fields are
             dropped server-side, so every rendered row has a value. -->
        <div x-show="patientDetailsModalOpen" x-transition.opacity="" @keydown.escape.window="closePatientDetailsModal()" @click="closePatientDetailsModal()" class="fixed inset-0 z-[80] bg-slate-900/50 flex items-start sm:items-center justify-center p-4 overflow-y-auto" style="display:none">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg my-auto max-h-[88vh] overflow-hidden flex flex-col" @click.stop="">
                <!-- Title bar -->
                <div class="px-5 pt-4 pb-3 border-b-2 border-sky-500 flex items-start gap-3">
                    <h2 class="flex-1 text-xl font-bold text-sky-800">Patient Details</h2>
                    <button type="button" @click="closePatientDetailsModal()" class="shrink-0 w-8 h-8 rounded-full hover:bg-slate-100 text-slate-500 flex items-center justify-center" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>

                <!-- Section-wise view. Every row is a DEFAULT field (not gated by
                     the admission-field config); each is hidden only when its
                     value is empty (server-side clean → '' for blanks). Sections
                     hide entirely when all their rows are empty. -->
                <template x-if="detailPatient"></template>

                <div class="px-5 py-3 border-t border-slate-100 flex justify-end">
                    <button type="button" @click="closePatientDetailsModal()" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-sky-600 hover:bg-sky-700">
                        Close
                    </button>
                </div>
            </div>
        </div>

        <!-- Bed-transfer / Consultant history sub-modal — stacks ABOVE the
             Patient Details modal (z-[90] > z-[80]). Same list frame for both;
             rows render by historyKind. -->
        <div x-show="historyModalOpen" x-transition.opacity="" @keydown.escape.window="closeHistoryModal()" @click="closeHistoryModal()" class="fixed inset-0 z-[90] bg-slate-900/50 flex items-start sm:items-center justify-center p-4 overflow-y-auto" style="display:none">
            <div class="bg-white rounded-2xl shadow-2xl w-full my-auto max-h-[85vh] overflow-hidden flex flex-col max-w-md" :class="(historyKind === 'bed' || historyKind === 'consultant') ? 'max-w-3xl' : 'max-w-md'" @click.stop="">
                <div class="px-5 pt-4 pb-3 border-b-2 border-sky-500 flex items-start gap-3">
                    <h2 class="flex-1 text-lg font-bold text-sky-800" x-text="historyTitle"></h2>
                    <button type="button" @click="closeHistoryModal()" class="shrink-0 w-8 h-8 rounded-full hover:bg-slate-100 text-slate-500 flex items-center justify-center" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>
                <div class="p-4 overflow-y-auto">
                    <div x-show="historyLoading" class="py-6 text-center text-sm text-teal-600" style="display: none;">Loading…</div>
                    <div x-show="!historyLoading &amp;&amp; historyError" class="py-6 text-center text-sm text-rose-600" x-text="historyError" style="display: none;"></div>
                    <div x-show="!historyLoading &amp;&amp; !historyError &amp;&amp; historyItems.length === 0" class="py-6 text-center text-sm text-slate-400">No history found.</div>

                    <!-- Bed transfer: full Floor/Bed, transferred-by, date/time and
                         duration on each bed (last row runs till discharge / now). -->
                    <template x-if="historyKind === 'bed'"></template>

                    <!-- Consultant history: full table — consultant (+ unit),
                         who assigned them, assign date/time and the period each
                         was active (last row runs till discharge / now). -->
                    <template x-if="historyKind === 'consultant'"></template>
                </div>
                <div class="px-5 py-3 border-t border-slate-100 flex justify-end">
                    <button type="button" @click="closeHistoryModal()" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-sky-600 hover:bg-sky-700">
                        Close
                    </button>
                </div>
            </div>
        </div>

        <!-- Set Remark & Directory (Gallery|Labs) -->
        <div x-show="docRemarkDirOpen" x-transition.opacity="" @keydown.escape.window="docRemarkDirOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden">
                <div class="px-5 py-3 bg-teal-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="message-square-text" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-message-square-text"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path><path d="M7 11h10"></path><path d="M7 15h6"></path><path d="M7 7h8"></path></svg>
                    <div class="flex-1 font-semibold">Set Remark &amp; Directory — <span x-text="drdTitle"></span></div>
                </div>
                <div class="p-5 space-y-4">
                    <!-- Free-text remark -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Remark</label>
                        <input type="text" x-model="drdRemark" maxlength="255" placeholder="Enter remark…" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
                    </div>
                    <!-- Directory -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 mb-1">Select File Upload Directory</label>
                        <select x-model.number="drdFolderId" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
                            <option :value="0" value="0">Other Document</option>
                            <template x-for="f in drdFolders" :key="f.id"></template>
                        </select>
                    </div>
                    <div class="flex justify-end gap-2 pt-1">
                        <button type="button" @click="docRemarkDirOpen = false" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            Cancel
                        </button>
                        <!-- Save stays visible for everyone; without the
                             add-remark/directory grant (p_id 88; privileged roles
                             1/2/10 always allowed) saveDocRemarkDir() refuses with
                             a toast instead of saving. -->
                        <button type="button" @click="saveDocRemarkDir()" :disabled="drdSaving || !drdSelectedNoteId" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 disabled:opacity-50 flex items-center gap-1.5" disabled="disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                            Save
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clone-page confirmation -->
        <div x-show="cloneConfirmOpen" x-transition.opacity="" @keydown.escape.window="cloneConfirmOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-sky-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="copy" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                    <div class="flex-1 font-semibold">Clone Page</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600">Would you want to make Duplicate this IPD Page?</p>
                    <div class="flex justify-end gap-2 mt-5">
                        <button type="button" @click="cloneConfirmOpen = false" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            No
                        </button>
                        <button type="button" @click="confirmClone()" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-sky-600 hover:bg-sky-700 flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="copy" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                            Yes, Clone
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lock-category confirmation -->
        <div x-show="lockConfirmOpen" x-transition.opacity="" @keydown.escape.window="lockConfirmOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-pink-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock" aria-hidden="true" x-show="lockAction === 'lock' || lockAction === 'lock-note'" style="width: 18px; height: 18px;" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock-open" aria-hidden="true" x-show="lockAction === 'unlock' || lockAction === 'unlock-note'" style="width: 18px; height: 18px; display: none;" class="lucide lucide-lock-open"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                    <div class="flex-1 font-semibold" x-text="lockAction === 'lock-note'
                             ? ('Lock Note for ' + patientName)
                             : (lockAction === 'unlock-note'
                                 ? ('UnLock Note for ' + patientName)
                                 : ((lockAction === 'lock' ? 'Lock Category ' : 'UnLock Category ') + ((lockTarget &amp;&amp; lockTarget.label) || '') + ' for ' + patientName))">Lock Category  for JAGDISHBHAI AHUJA</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600" x-text="lockAction === 'lock'
                           ? 'Once you Lock this category you cannot edit existing or create new pages for same category.'
                           : (lockAction === 'lock-note'
                               ? 'Once you Lock this Page you cannot create new pages or clone(Copy) for same Page.'
                               : (lockAction === 'unlock-note'
                                   ? 'Once you UnLock this Page you can create new pages or clone(Copy) for same Page.'
                                   : 'Once you UnLock this category you can create new pages for same category.'))">Once you Lock this category you cannot edit existing or create new pages for same category.</p>
                    <div class="flex justify-end gap-2 mt-5">
                        <button type="button" @click="lockConfirmOpen = false" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                            Cancel
                        </button>
                        <button type="button" @click="confirmLockCategory()" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-pink-600 hover:bg-pink-700 flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock" aria-hidden="true" x-show="lockAction === 'lock' || lockAction === 'lock-note'" style="width: 14px; height: 14px;" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock-open" aria-hidden="true" x-show="lockAction === 'unlock' || lockAction === 'unlock-note'" style="width: 14px; height: 14px; display: none;" class="lucide lucide-lock-open"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                            <span x-text="(lockAction === 'lock' || lockAction === 'lock-note') ? 'Lock' : 'UnLock'">Lock</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Uploaded-document HARD delete confirmation (grid multi-select +
             page-viewer trash). Permanently removes the file(s) from the
             patient record and storage. -->
        <div x-show="docDeleteConfirmOpen" x-transition.opacity="" @keydown.escape.window="docDeleteConfirmOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                <div class="px-5 py-3 bg-rose-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <div class="flex-1 font-semibold" x-text="'Delete ' + docDeleteTargets.length + (docDeleteTargets.length === 1 ? ' file' : ' files')">Delete 0 files</div>
                </div>
                <div class="p-5">
                    <p class="text-sm text-slate-600">
                        Are you sure you want to permanently delete
                        <b x-text="docDeleteTargets.length">0</b>
                        <span x-text="docDeleteTargets.length === 1 ? 'file' : 'files'">files</span>?
                        This removes <span x-text="docDeleteTargets.length === 1 ? 'it' : 'them'">them</span>
                        from the patient record and storage. This action cannot be undone.
                    </p>
                    <div class="flex justify-end gap-2 mt-5">
                        <button type="button" @click="docDeleteConfirmOpen = false" :disabled="docDeleteBusy" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100 disabled:opacity-50">
                            Cancel
                        </button>
                        <button type="button" @click="confirmDocDelete()" :disabled="docDeleteBusy" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-rose-600 hover:bg-rose-700 disabled:opacity-60 flex items-center gap-1.5">
                            <svg x-show="docDeleteBusy" class="animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" x-show="!docDeleteBusy" style="width: 14px; height: 14px;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span x-text="docDeleteBusy ? 'Deleting…' : 'Delete'">Delete</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Transfer page to another position (footer date strip → p_id 97).
             Rewrites the page's written datetime so it re-orders in its
             category. -->
        <div x-show="transferOpen" x-transition.opacity="" @keydown.escape.window="transferOpen = false" class="fixed inset-0 z-[60] bg-slate-900/50 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden">
                <div class="px-5 py-3 bg-indigo-600 text-white flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar-clock" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-calendar-clock"><path d="M16 14v2.2l1.6 1"></path><path d="M16 2v3"></path><path d="M21 7.338V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2.338"></path><path d="M3 9h5.859"></path><path d="M8 2v3"></path><circle cx="16" cy="16" r="6"></circle></svg>
                    <div class="flex-1 font-semibold">Transfer page to another position</div>
                </div>
                <div class="p-5 space-y-4">
                    <div class="text-sm text-slate-600">
                        Actual Page Created at :
                        <span class="font-semibold text-slate-800" x-text="transferRec ? fmtDateTime(transferRec.createdAt) : ''"></span>
                    </div>
                    <div class="text-sm text-slate-600">
                        <label for="transferDt" class="block mb-1">Change New DateTime of Page Written at datetime</label>
                        <div class="relative">
                            <input id="transferDt" type="datetime-local" x-model="transferDateTime" class="w-full rounded-lg border border-slate-300 px-3 py-2 pr-10 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400">
                            <!-- Native picker icon trigger (calendar-clock). -->
                            <button type="button" @click="openTransferPicker()" class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-md text-slate-500 hover:bg-slate-100 flex items-center justify-center" aria-label="Pick date &amp; time" title="Pick date &amp; time">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar-clock" aria-hidden="true" style="width:17px;height:17px;display:block;" class="lucide lucide-calendar-clock"><path d="M16 14v2.2l1.6 1"></path><path d="M16 2v3"></path><path d="M21 7.338V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2.338"></path><path d="M3 9h5.859"></path><path d="M8 2v3"></path><circle cx="16" cy="16" r="6"></circle></svg>
                            </button>
