                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="stamp" aria-hidden="true" x-show="!s.thumbUrl" style="width: 14px; height: 14px; color: rgb(148, 163, 184); display: none;" class="lucide lucide-stamp"><path d="M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-6 0c0 2 1 2 1 3.5V13"></path><path d="M20 15.5a2.5 2.5 0 0 0-2.5-2.5h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1z"></path><path d="M5 22h14"></path></svg>
                                    </span>
                                    <span class="flex-1 truncate" :title="s.name" x-text="s.name" title="M.D.(Respiratory Medicine)">M.D.(Respiratory Medicine)</span>
                                </button><button type="button" @click="rbPlaceStamp(s)" class="w-full text-left px-3 py-2 flex items-center gap-2.5 hover:bg-slate-50 text-sm text-slate-700">
                                    <span class="inline-flex items-center justify-center w-9 h-7 rounded bg-slate-50 border border-slate-200 overflow-hidden shrink-0">
                                        <img x-show="s.thumbUrl" :src="s.thumbUrl" alt="" draggable="false" class="max-w-full max-h-full object-contain" src="blob:https://prescoipd.com/6ea9ee27-0e90-4fb1-bf92-15295b2e3a44" style="">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="stamp" aria-hidden="true" x-show="!s.thumbUrl" style="width: 14px; height: 14px; color: rgb(148, 163, 184); display: none;" class="lucide lucide-stamp"><path d="M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-6 0c0 2 1 2 1 3.5V13"></path><path d="M20 15.5a2.5 2.5 0 0 0-2.5-2.5h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1z"></path><path d="M5 22h14"></path></svg>
                                    </span>
                                    <span class="flex-1 truncate" :title="s.name" x-text="s.name" title="MLC Stamp">MLC Stamp</span>
                                </button>
                        </div>
                    </div>
                    <!-- Copy (sub-options: whole page / selective region) -->
                    <div class="relative shrink-0">
                        <button type="button" @click="rbCopyMenuOpen=!rbCopyMenuOpen; rbPasteMenuOpen=false; rbGalleryOpen=false; rbColorOpen=false" :class="(rbCopyMenuOpen || rbSelectionMode === 'copy') ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Copy"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="copy" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg></button>
                        <div x-show="rbCopyMenuOpen" @click.outside="rbCopyMenuOpen=false" class="absolute top-full mt-1 right-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg py-1 w-56" style="display: none;">
                            <button type="button" @click="rbCopyPage()" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="copy" aria-hidden="true" style="width:15px;height:15px;" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg> Copy page</button>
                            <button type="button" @click="rbStartSelectiveCopy()" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="box-select" aria-hidden="true" style="width:15px;height:15px;" class="lucide lucide-box-select"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg> Selective copy</button>
                        </div>
                    </div>
                    <!-- Paste (sub-options) -->
                    <div class="relative shrink-0">
                        <button type="button" @click="rbPasteMenuOpen=!rbPasteMenuOpen; rbCopyMenuOpen=false; rbGalleryOpen=false; rbColorOpen=false" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Paste"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-paste" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-clipboard-paste"><path d="M11 14h10"></path><path d="M16 4h2a2 2 0 0 1 2 2v1.344"></path><path d="m17 18 4-4-4-4"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 1.793-1.113"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect></svg></button>
                        <div x-show="rbPasteMenuOpen" @click.outside="rbPasteMenuOpen=false" class="absolute top-full mt-1 right-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg py-1 w-56" style="display: none;">
                            <button type="button" @click="rbPastePage()" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-paste" aria-hidden="true" style="width:15px;height:15px;" class="lucide lucide-clipboard-paste"><path d="M11 14h10"></path><path d="M16 4h2a2 2 0 0 1 2 2v1.344"></path><path d="m17 18 4-4-4-4"></path><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 1.793-1.113"></path><rect x="8" y="2" width="8" height="4" rx="1"></rect></svg> Paste page</button>
                            <button type="button" @click="rbSelectivePaste()" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="box-select" aria-hidden="true" style="width:15px;height:15px;" class="lucide lucide-box-select"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg> Selective paste</button>
                            <button type="button" @click="rbPasteIpdPage()" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-100 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-copy" aria-hidden="true" style="width:15px;height:15px;" class="lucide lucide-clipboard-copy"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path><path d="M16 4h2a2 2 0 0 1 2 2v4"></path><path d="M21 14H11"></path><path d="m15 10-4 4 4 4"></path></svg> Paste IPD-Register Page</button>
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Delete page — only when editing an existing page (hidden for a new page). Confirms first. -->
                    <button type="button" x-show="rbEditingPageId != null" @click="rbDeleteConfirmOpen = true" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Delete page" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    <!-- Reset -->
                    <button type="button" @click="rbReset()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 shrink-0" title="Reset"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></button>
                    <!-- Cancel -->
                    <button type="button" @click="rbCancelEdit()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Cancel"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button>
                </div>
            </div>

            <!-- Body: pages area (main) + category selector (right drawer) -->
            <div class="flex-1 min-h-0 relative flex">
                <!-- MAIN: pages of the selected category. In EDIT and DETAIL
                     (page-viewer) modes it drops its padding + scroll so the page
                     fills the whole area edge-to-edge (fullscreen, like IPD); only
                     the grid keeps p-3 + scroll. -->
                <div class="flex-1 min-w-0 overflow-auto p-3" :class="(rbPageView === 'edit' || rbPageView === 'detail' || (rbPageView === 'gallery' &amp;&amp; rbDocView === 'detail') || (rbPageView === 'grid' &amp;&amp; rbActiveCat &amp;&amp; !rbActiveCat.is_other &amp;&amp; rbPages.length === 0)) ? 'overflow-hidden' : 'overflow-auto p-3'">
                    <!-- No category chosen yet -->
                    <div x-show="!rbActiveCat &amp;&amp; rbPageView !== 'recycle'" class="h-full flex flex-col items-center justify-center text-center text-slate-500 py-16">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="book-open" aria-hidden="true" style="width:40px;height:40px;" class="lucide lucide-book-open text-slate-300"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg>
                        <div class="mt-3 font-medium text-slate-600">Choose a register book</div>
                        <div class="text-sm text-slate-400">Pick a category from the list to see its pages.</div>
                        <button type="button" @click="rbRightOpen = true" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-800 text-white text-sm font-medium">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="book-open" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-book-open"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg> Open list
                        </button>
                    </div>

                    <!-- RECYCLE BIN (soft-deleted pages) -->
                    <div x-show="rbPageView === 'recycle'" style="display: none;">
                        <div class="flex items-center justify-between mb-3">
                            <button type="button" @click="rbExitRecycle()" class="inline-flex items-center gap-1 text-sm text-slate-600 hover:text-slate-800">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back
                            </button>
                            <div class="font-semibold text-slate-700 flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> Recycle Bin</div>
                            <button type="button" @click="rbLoadRecycle()" class="p-1.5 rounded-full border border-slate-200 bg-white text-slate-500 hover:bg-slate-50" title="Refresh"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></button>
                        </div>
                        <div x-show="rbRecycleLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading…</div>
                        <div x-show="!rbRecycleLoading &amp;&amp; rbRecycleError" class="text-center text-rose-600 py-16" x-text="rbRecycleError" style="display: none;"></div>
                        <template x-if="!rbRecycleLoading &amp;&amp; !rbRecycleError &amp;&amp; rbRecycle.length === 0"></template><div class="text-center text-slate-500 py-16">Recycle bin is empty.</div>
                        <!-- Card list — SAME structure as the IPD recycle bin
                             (coloured top strip + form-template thumbnail with saved
                             strokes + metadata + Restore). The IPD "Page Log" button
                             is intentionally omitted (register pages aren't patient-
                             scoped and have no page-log). -->
                        <div class="max-w-4xl mx-auto space-y-3">
                            <template x-for="pg in rbRecycle" :key="pg.id"></template>
                        </div>
                    </div>

                    <!-- OTHER DOCUMENTS (gallery) — hospital-scoped uploaded image /
                         PDF files (book_type_id 1993). Same grid → preview → delete
                         flow as the IPD Other Documents, minus remark & directory. -->
                    <div x-show="rbActiveCat &amp;&amp; rbActiveCat.is_other &amp;&amp; rbPageView === 'gallery'" :class="rbDocView === 'detail' ? 'h-full' : ''" class="" style="display: none;">
                        <div x-show="rbDocsLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading documents…</div>
                        <div x-show="!rbDocsLoading &amp;&amp; rbDocsError" class="text-center text-rose-600 py-16" x-text="rbDocsError" style="display: none;"></div>
                        <!-- Empty state (like IPD): icon + message + Add affordance. -->
                        <template x-if="!rbDocsLoading &amp;&amp; !rbDocsError &amp;&amp; rbDocs.length === 0"></template><div class="text-center text-slate-500 py-20">
                                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-200 text-slate-400 mb-4">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                                </div>
                                <div class="font-medium text-slate-700 mb-4">No documents yet</div>
                                <button type="button" @click="rbAddOtherDocument()" class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add document
                                </button>
                            </div>

                        <template x-if="!rbDocsLoading &amp;&amp; !rbDocsError &amp;&amp; rbDocs.length"></template>
                    </div>

                    <!-- PAGES GRID — like the IPD viewer: category heading, date
                         groups, 3-up cards with datetime header + page# badge +
                         image + Created/Modified footer. -->
                    <div x-show="rbActiveCat &amp;&amp; !rbActiveCat.is_other &amp;&amp; rbPageView === 'grid'" :class="!rbPagesLoading &amp;&amp; !rbPagesError &amp;&amp; rbPages.length === 0 ? 'h-full' : ''" class="h-full" style="display: none;">
                        <div x-show="rbPagesLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading pages…</div>
                        <div x-show="!rbPagesLoading &amp;&amp; rbPagesError" class="text-center text-rose-600 py-16" x-text="rbPagesError" style="display: none;"></div>
                        <!-- No pages yet → show a blank "Page 1" of this register's
                             form template filling the area (like the IPD empty
                             state), not a text message. It's display-only — the
                             app-bar "Page 1 / 1 · Open" button starts writing the
                             first page (same flow as IPD). -->
                        <template x-if="!rbPagesLoading &amp;&amp; !rbPagesError &amp;&amp; rbPages.length === 0"></template><div class="h-full overflow-hidden bg-slate-200 flex flex-col">
                                <div class="bg-white shadow-xl w-full flex-1 flex flex-col">
                                    <div class="h-2 shrink-0" :style="'background-color:' + ((rbActiveCat &amp;&amp; rbActiveCat.color) || '#0d9488') + ';'" style="background-color:#0d9488;"></div>
                                    <div class="flex-1 relative overflow-hidden">
                                        <img x-show="rbActiveBgUrl()" :src="rbActiveBgUrl()" alt="" draggable="false" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none" src="https://prescoipd.com/v1/ipd/pwa/ipd" style="display: none;">
                                        <div x-show="!rbActiveBgUrl()" class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
                                            <span class="text-5xl md:text-7xl font-black text-slate-200/50 rotate-[-20deg] tracking-widest text-center px-4" x-text="(rbActiveCat &amp;&amp; rbActiveCat.book_type || '').toUpperCase()"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <!-- Date filter (dropdown + optional pickers + "Showing …") -->
                        <div x-show="!rbPagesLoading &amp;&amp; !rbPagesError &amp;&amp; rbPages.length" class="mb-3" style="display: none;">
                            <div class="flex items-center gap-2 flex-wrap">
                                <div class="relative shrink-0">
                                    <button type="button" @click="rbFilterMenuOpen = !rbFilterMenuOpen" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 text-sm font-medium hover:bg-slate-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="sliders-horizontal" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-sliders-horizontal"><path d="M10 5H3"></path><path d="M12 19H3"></path><path d="M14 3v4"></path><path d="M16 17v4"></path><path d="M21 12h-9"></path><path d="M21 19h-5"></path><path d="M21 5h-7"></path><path d="M8 10v4"></path><path d="M8 12H3"></path></svg>
                                        <span x-text="rbFilterModeLabel()">Default (This Month)</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down text-slate-400"><path d="m6 9 6 6 6-6"></path></svg>
                                    </button>
                                    <div x-show="rbFilterMenuOpen" @click.outside="rbFilterMenuOpen = false" class="absolute top-full mt-1 left-0 z-40 w-60 bg-white border border-slate-200 rounded-lg shadow-lg py-1" style="display: none;">
                                        <button type="button" @click="rbSetFilterMode('default')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-teal-700 font-semibold" :class="rbFilterMode === 'default' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> Reset Filter to Default
                                        </button>
                                        <button type="button" @click="rbSetFilterMode('between')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-slate-700" :class="rbFilterMode === 'between' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar-range" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-calendar-range"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M16 2v3"></path><path d="M3 9h18"></path><path d="M8 2v3"></path><path d="M17 13h-6"></path><path d="M13 17H7"></path><path d="M7 13h.01"></path><path d="M17 17h.01"></path></svg> Between Date Forms
                                        </button>
                                        <button type="button" @click="rbSetFilterMode('datewise')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-slate-700" :class="rbFilterMode === 'datewise' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-calendar"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg> Datewise forms
                                        </button>
                                    </div>
                                </div>
                                <!-- Between: from → to (max 3 months, clamped on change) -->
                                <template x-if="rbFilterMode === 'between'"></template>
                                <!-- Datewise: a single day -->
                                <template x-if="rbFilterMode === 'datewise'"></template>
                            </div>
                            <div class="text-xs font-semibold text-slate-500 mt-1.5" x-text="rbFilterLabel()">Showing From  To </div>
                        </div>

                        <!-- Category name — sits directly under the "Showing …" line. -->
                        <div x-show="rbPages.length" class="text-lg font-bold text-teal-700 mb-1" x-text="rbActiveCat &amp;&amp; rbActiveCat.book_type" style="display: none;"></div>
                        <!-- Nothing matched the active date filter (pages exist, but none in range) — below the category name. -->
                        <template x-if="!rbPagesLoading &amp;&amp; !rbPagesError &amp;&amp; rbPages.length &gt; 0 &amp;&amp; rbGroupedPages().length === 0"></template>
                        <!-- Date groups -->
                        <template x-for="grp in rbGroupedPages()" :key="grp.day"></template>
                    </div>

                    <!-- PAGE DETAIL (viewpager) — SWIPE to navigate (like IPD);
                         Open / n/n / Add live in the app bar. -->
                    <div x-show="rbActiveCat &amp;&amp; rbPageView === 'detail'" class="h-full" style="display: none;">
                        <div class="h-full overflow-x-auto flex snap-x snap-mandatory rb-slider" x-ref="rbSlider" id="rbSlider" @scroll.passive="rbOnSliderScroll()">
                            <template x-for="(pg, i) in rbFilteredPages()" :key="pg.id"></template>
                        </div>
                    </div>

                    <!-- ══ PAGE EDITOR (canvas) ══ -->
                    <div x-show="rbActiveCat &amp;&amp; rbPageView === 'edit'" class="h-full flex flex-col" style="display: none;">
                        <!-- Canvas stage — full-screen category background with the
                             handwritten canvas overlaid at the same dimensions. -->
                        <!-- items-stretch (NOT items-center/justify-center) so the
                             page box fills the whole stage edge-to-edge like IPD —
                             no margins. z-0 keeps the canvas below the edit toolbar. -->
                        <div class="flex-1 min-h-0 bg-slate-200 relative z-0 overflow-hidden flex items-stretch" x-ref="rbCanvasWrap" @touchstart="rbTouchStart($event)" @touchmove="rbTouchMove($event)" @touchend="rbTouchEnd($event)" @touchcancel="rbTouchEnd($event)">
                            <div class="relative shadow-lg w-full h-full" x-ref="rbCanvasPage" :style="rbPageStyle()" style="width:100%; height:100%;">
                                <!-- Background template — z-0 and pointer-events-none:
                                     it is DISPLAY-ONLY and sits BELOW the canvas, so it
                                     can never intercept the strokes (this is the IPD
                                     layering, made explicit). -->
                                <img x-show="rbEditBgUrl()" :src="rbEditBgUrl()" alt="" draggable="false" @load="rbOnEditBgLoaded($event)" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none z-0" src="https://prescoipd.com/v1/ipd/pwa/ipd" style="display: none;">
                                <!-- blank fallback so the page box is visible before/without a template -->
                                <div x-show="!rbEditBgUrl()" class="absolute inset-0 bg-white pointer-events-none z-0"></div>
                                <!-- Drawing canvas — z-10, ON TOP of the background; the
                                     only layer that receives pointer events. -->
                                <!-- id= AS WELL AS x-ref: the editor is opened from
                                     buttons that live inside `template x-if` blocks,
                                     which Alpine destroys on the very tick that
                                     starts the edit — and a DETACHED caller can no
                                     longer resolve $refs. See _rbCanvasEl(). -->
                                <canvas x-ref="rbCanvas" id="rbCanvas" class="absolute inset-0 w-full h-full z-10" :style="'touch-action:none;' + (rbEditTool === 'eraser' ? 'cursor:cell;' : 'cursor:crosshair;')" @pointerdown="rbPointerDown($event)" @pointermove="rbPointerMove($event)" @pointerup="rbPointerUp($event)" @pointerleave="rbPointerUp($event)" @pointercancel="rbPointerUp($event)" style="touch-action:none;cursor:crosshair;"></canvas>

                                <!-- Pending image/stamp/selection placement: a movable,
                                     pinch-scalable/rotatable overlay positioned in
                                     canvas-pixel space (%), so it zooms/pans WITH the
                                     page. Only the item box captures pointers. -->
                                <template x-if="_rbPlacing"></template>
                            </div>
                            <!-- Stylus-only hint (auto-hides). Shared showStylusHint
                                 state; only ever visible while the RB editor is open. -->
                            <div x-show="showStylusHint" x-transition.opacity="" class="absolute top-3 left-1/2 -translate-x-1/2 bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full shadow flex items-center gap-2 pointer-events-none z-30" style="display:none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-tool" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-pen-tool"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                                <span>Use a stylus to draw on this canvas</span>
                            </div>

                            <!-- ══ SELECTION BOX (selective copy) ══════════════
                                 Same logic as the patient-page editor: the box
                                 appears CENTRED as soon as the mode opens — no
                                 stylus marquee drag is needed to summon it —
                                 and is moved/resized with a FINGER (any pointer
                                 type works). Lives in rbCanvasWrap coords, so
                                 the zoom transform never shifts it.

                                 template x-if, not x-show: an x-show element
                                 that also carries :style has its display:none
                                 clobbered by the style binding. -->
                            <template x-if="rbSelectionMode === 'copy' &amp;&amp; _rbSelectionRect"></template>

                            <!-- Selection action bar. Dark pill at the top-right,
                                 exactly as the patient page: a white bar would
                                 vanish against the white register page and sit
                                 over the very area being selected. -->
                            <div x-show="rbSelectionMode === 'copy'" class="absolute top-3 right-3 z-40 flex items-center gap-1 bg-slate-900/95 text-slate-100 rounded-full shadow-2xl ring-1 ring-white/15 px-2 py-1.5" style="display:none">
                                <span class="hidden sm:inline text-[11px] text-slate-300 px-2">Drag to move · drag a corner to resize</span>
                                <button type="button" @click="_rbResetSelectionToCentre()" class="w-8 h-8 rounded-full hover:bg-white/15 text-slate-200 flex items-center justify-center" title="Recentre selection">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="crosshair" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-crosshair"><circle cx="12" cy="12" r="10"></circle><line x1="22" x2="18" y1="12" y2="12"></line><line x1="6" x2="2" y1="12" y2="12"></line><line x1="12" x2="12" y1="6" y2="2"></line><line x1="12" x2="12" y1="22" y2="18"></line></svg>
                                </button>
                                <div class="w-px h-5 bg-white/25 mx-1"></div>
                                <button type="button" @click="rbCancelSelectiveCopy()" class="px-3 py-1.5 rounded-full text-slate-200 hover:bg-white/15 text-sm font-medium flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                                    <span>Cancel</span>
                                </button>
                                <button type="button" @click="rbConfirmSelectiveCopy()" class="px-3 py-1.5 rounded-full bg-sky-500 hover:bg-sky-400 text-white text-sm font-semibold flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                    <span>Copy</span>
                                </button>
                            </div>

                            <!-- Placement action bar (resize / rotate / cancel / place).
                                 Lives in wrap coords so it stays put while the user
                                 moves the pending item. -->
                            <div x-show="_rbPlacing" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-40 flex items-center gap-1 bg-white rounded-full shadow-xl border border-slate-200 px-2 py-1.5" style="display:none">
                                <span class="hidden sm:inline text-[11px] text-slate-500 px-2" x-text="(_rbPlacing &amp;&amp; _rbPlacing.resizable === false &amp;&amp; _rbPlacing.rotatable === false) ? 'Drag to position, then Place' : 'Drag to move · pinch to resize/rotate'">Drag to move · pinch to resize/rotate</span>
                                <button type="button" x-show="!(_rbPlacing &amp;&amp; _rbPlacing.resizable === false)" @click="_rbScalePlacement(0.9)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Smaller">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="minus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-minus"><path d="M5 12h14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_rbPlacing &amp;&amp; _rbPlacing.resizable === false)" @click="_rbScalePlacement(1.1)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Larger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_rbPlacing &amp;&amp; _rbPlacing.rotatable === false)" @click="_rbRotatePlacement(-90)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate left 90°">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                </button>
                                <button type="button" x-show="!(_rbPlacing &amp;&amp; _rbPlacing.rotatable === false)" @click="_rbRotatePlacement(90)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate right 90°">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                                </button>
                                <div class="w-px h-5 bg-slate-200 mx-1"></div>
                                <button type="button" @click="_rbCancelPlacement()" class="px-3 py-1.5 rounded-full text-slate-600 hover:bg-slate-100 text-sm font-medium flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                                    <span>Cancel</span>
                                </button>
                                <button type="button" @click="_rbCommitPlacement()" class="px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                    <span>Place</span>
                                </button>
                            </div>
                            <!-- hidden file input for gallery/place-image -->
                            <input type="file" accept="image/*" x-ref="rbFileInput" class="hidden" @change="rbOnPickImage($event)">
                        </div>
                    </div>
                </div>

                <!-- Right-drawer backdrop (full screen) -->
                <div x-show="rbRightOpen" x-transition.opacity="" @click="rbRightOpen = false" class="fixed inset-0 z-[65] bg-slate-900/40" style="display:none"></div>

                <!-- RIGHT DRAWER: category selector — FULL screen height -->
                <aside x-show="rbRightOpen" x-transition:enter="transition transform ease-out duration-200" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition transform ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="fixed inset-y-0 right-0 z-[70] w-[92vw] max-w-md bg-white border-l border-slate-200 shadow-2xl flex flex-col" style="display:none">
                    <!-- Recycle bin at the very top — the SAME red pill the IPD
                         forms drawer uses (icon + label, rounded-full, red-500),
                         not a full-width row. -->
                    <div class="shrink-0 px-3 py-2 border-b border-slate-100 bg-white flex items-center justify-end">
                        <button type="button" @click="rbOpenRecycle()" class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-white font-semibold text-sm shadow bg-red-500 hover:bg-red-600" :class="rbPageView === 'recycle' ? 'bg-red-600' : 'bg-red-500 hover:bg-red-600'" title="Recycle Bin" aria-label="Recycle Bin">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Recycle Bin</span>
                        </button>
                    </div>
                    <!-- Search bar (ditto IPD) + All Bunched dropdown + Close -->
                    <div class="shrink-0 px-3 py-2 flex items-center gap-2 border-b border-slate-100 bg-white">
                        <div class="flex-1 flex items-center gap-2 border border-slate-300 rounded-lg px-3 py-1.5 bg-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:16px;height:16px;color:#64748b;display:block;" class="lucide lucide-search"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                            <input type="search" placeholder="Search Register Book Form" x-model="rbSearch" class="flex-1 outline-none text-sm bg-transparent placeholder-slate-400">
                        </div>
                        <!-- Bunch filter — ditto copy of the IPD forms bunch picker -->
                        <div x-show="rbBunchVisible()" class="relative shrink-0" style="display: none;">
                            <button type="button" @click="rbBunchOpen = !rbBunchOpen" class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm bg-white text-slate-700 flex items-center gap-1.5 min-w-[8rem] hover:bg-slate-50">
                                <span class="inline-block w-3 h-3 rounded border border-slate-300 flex-shrink-0" :style="rbBunch &amp;&amp; rbBunch !== '#00000000' ? ('background-color: ' + rbBunch + ';') : 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                                <span class="flex-1 truncate text-left" x-text="rbBunchLabel()">All Bunches</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" :data-lucide="rbBunchOpen ? 'chevron-up' : 'chevron-down'" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"></path></svg>
                            </button>
                            <div x-show="rbBunchOpen" @click.outside="rbBunchOpen = false" x-transition.opacity="" class="absolute right-0 top-full mt-1 z-30 min-w-[15rem] max-h-72 overflow-auto bg-white border border-slate-200 rounded-lg shadow-lg" style="display:none">
                                <button type="button" @click="rbSelectBunch(null)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:bg-slate-50 border-b border-slate-100 transition font-semibold text-slate-800 bg-slate-50" :class="!rbBunch ? 'font-semibold text-slate-800 bg-slate-50' : 'text-slate-700'">
                                    <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                                    <span class="flex-1">All Bunches</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="!rbBunch" style="width: 14px; height: 14px;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                </button>
                                <template x-for="opt in rbBunchOptions()" :key="opt.colorHex"></template>
                            </div>
                        </div>
                        <button type="button" @click="rbRightOpen = false" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-500 flex items-center justify-center shrink-0" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                        </button>
                    </div>
                    <!-- Category list — tap to open its pages -->
                    <div class="flex-1 min-h-0 overflow-auto p-3 space-y-2">
                        <div x-show="rbLoading" class="text-center text-slate-400 py-8 text-sm" style="display: none;">Loading…</div>
                        <div x-show="!rbLoading &amp;&amp; rbError" class="text-center text-rose-600 py-8 text-sm" x-text="rbError" style="display: none;"></div>
                        <template x-for="(row, i) in rbFiltered()" :key="row.book_id"></template>

                        <!-- Other Documents — a hospital-scoped gallery of uploaded
                             image / PDF files (book_id 1993), below the category list.
                             Same capture/upload/view flow as the IPD Other Documents. -->
                        <button type="button" @click="rbOpenOtherDocuments()" class="w-full text-left rounded-xl border border-teal-200 bg-teal-50/60 shadow-sm hover:shadow transition flex items-stretch overflow-hidden mt-1" :class="rbActiveCat &amp;&amp; rbActiveCat.is_other ? 'ring-2 ring-teal-600' : ''">
                            <div class="w-11 shrink-0 flex items-center justify-center text-white" style="background-color:#0d9488">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="folder" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0 px-3 py-2.5">
                                <div class="font-semibold text-slate-800 text-sm truncate">Other Documents</div>
                                <div class="text-[10px] text-slate-400">Uploaded image / PDF documents</div>
                            </div>
                            <div class="shrink-0 self-center pr-3 text-right">
                                <div class="text-lg font-bold leading-none text-teal-700" x-text="rbDocs.length">0</div>
                                <div class="text-[9px] uppercase tracking-wide text-slate-400">files</div>
                            </div>
                        </button>
                    </div>
                </aside>

