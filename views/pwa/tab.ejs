                // Native-bridge push fallback for the Android WebView wrapper
                // (PrescoWrapper), which lacks the Web Push API. Bridge contract:
                //   JS → Native:  wrapper.registerPush(vapidPublicKey)  (any of the
                //     method names probed below). The wrapper registers with the OS
                //     (e.g. FCM) and produces a WEB-PUSH-SHAPED subscription
                //     { endpoint, keys:{ p256dh, auth } } — returned synchronously
                //     (object or JSON string) OR delivered asynchronously via:
                //   Native → JS:
                //     window.PrescoPush.onSubscription(subJsonOrString) → persisted
                //     window.PrescoPush.onMessage(payloadJsonOrString)  → foreground toast
                // The wrapper bridges FCM ↔ web-push so the SERVER path
                // (push_subscriptions + VAPID) stays unchanged. Returns true when a
                // native bridge was found + asked to register, false otherwise.
                _initPushNativeBridge(vapidKey) {
                    // Callbacks the native side can invoke at any time.
                    const P = (window.PrescoPush = window.PrescoPush || {});
                    P.onSubscription = (sub) => {
                        const parsed = (typeof sub === 'string') ? this._tryParseJson(sub) : sub;
                        if (parsed && parsed.endpoint) this._savePushSubscription(parsed);
                    };
                    P.onMessage = (payload) => { if (this._showPushToast) this._showPushToast(payload); };

                    // JS → Native: probe the same bridge objects/methods style as
                    // _openNativeApp, passing the VAPID public key to register.
                    const objs = [
                        window.PrescoWrapper, window.PrescoBridge, window.Android,
                        window.AndroidBridge, window.NativeBridge, window.JSBridge, window.external,
                    ];
                    const methods = [
                        'registerPush', 'registerWebPush', 'subscribePush',
                        'enablePush', 'registerForPush', 'startPush',
