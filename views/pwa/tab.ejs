                    });
                },

                // Fired by the slider's scroll event. Snaps the active
                // page state to whichever page is closest to centered.
                onPageScroll(e) {
                    const el = e.target;
                    if (!el || !el.clientWidth) return;
                    const idx = Math.round(el.scrollLeft / el.clientWidth);
                    if (idx >= 0 && idx < this.viewerRecords.length && idx !== this.viewerActiveIndex) {
                        this.viewerActiveIndex  = idx;
                        this.viewerActiveRecord = this.viewerRecords[idx];
                    }
                },

                // Programmatic page flip (used by the indicator dots).
                goToPage(index) {
                    const el = this.$refs.pageSlider;
                    if (!el) return;
                    const clamped = Math.max(0, Math.min(this.viewerRecords.length - 1, index));
                    el.scrollTo({ left: clamped * el.clientWidth, behavior: 'smooth' });
