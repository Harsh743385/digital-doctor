                            // native bridge instead.
                            this._initPushNativeBridge(key);
                            return;
                        }

                        // Permission: request once. If the user has blocked it we
                        // never re-prompt (permission stays 'denied').
                        let perm = Notification.permission;
                        if (perm === 'default') {
                            try { perm = await Notification.requestPermission(); } catch (_) { return; }
                        }
