                    // here too so the dots update instantly.
                    this.viewerActiveIndex  = clamped;
                    this.viewerActiveRecord = this.viewerRecords[clamped] || null;
                },

                // Edit the currently-visible page. The record's image (if
                // any) is pre-loaded onto the edit canvas and the record id
                // is tagged so Save updates this record in place — and the
                // edit appbar exposes the Delete button for this existing
                // page.
                editCurrentPage() {
                    if (this._checkReadOnly()) return;
                    if (this._checkEditPages()) return;
                    if (this._checkDischargeEditWindow()) return;
                    const rec = this.viewerActiveRecord;
                    if (!rec) { this.startEdit(); return; }
                    // A locked page (lock_unlock = 1) can't be modified until
                    // it's unlocked — block the edit and tell the user.
                    if (rec.isLocked) { this.showToast('You cannot Edit Locked Page', 'error'); return; }
                    // Prefer the same-origin proxy URL for the canvas paint
                    // — direct S3 URLs taint the canvas when the bucket has
                    // no CORS headers, which then makes Save throw on the
                    // next edit. The proxy streams the same bytes via our
                    // own /pwa/... origin so the canvas stays clean.
