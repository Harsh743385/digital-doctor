        const PATIENTS = [
            { id: 1, name: 'Mr.IQBAL IBRAHIM KUKDA',   uhid: '00012345', ipd: 'IPD-9876', ward: 'General Ward', bed: 'GW-12', gender: '1', age: '54', initials: 'IK', photo: '', admission_reason: 'Fever & Dehydration',   floor: '1st Floor', department: 'Medicine',      mlc: false, allergic: true,  precautive: false, doctor: 'Dr. S. Mehta',     other_consultants: 'R. Khanna, T. Bose', referred_by: 'A. Kapoor', pmode: '0', provisional_diagnosis: 'Acute gastroenteritis', final_diagnosis: 'Viral gastroenteritis' },
            { id: 2, name: 'Mrs.PRIYA SHARMA',         uhid: '00012346', ipd: 'IPD-9881', ward: 'ICU',          bed: 'ICU-03', gender: '2', age: '37', initials: 'PS', photo: '', admission_reason: 'Post-op observation', floor: '2nd Floor', department: 'Critical Care', mlc: false, allergic: false, precautive: true,  doctor: 'Dr. A. Rao',       referred_by: 'B. Menon, C. Pillai', pmode: '1', provisional_diagnosis: 'Post-op monitoring', final_diagnosis: '' },
