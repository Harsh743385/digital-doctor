                            </button><button type="button" @click="tplSelectCategory(cat)" class="w-full text-left rounded-xl border border-slate-200 bg-white shadow-sm hover:shadow transition flex items-stretch overflow-hidden" :class="tplActiveCat &amp;&amp; tplActiveCat.i === cat.i ? 'ring-2 ring-slate-800' : ''" :style="tplRowTint(cat)" style="background-color:#0000000033;">
                                <!-- Serial tile, same design as the RB / AF drawers. -->
                                <div class="w-11 shrink-0 flex flex-col items-center justify-center text-white font-bold bg-slate-500">
                                    <span class="text-base leading-none" x-text="i + 1">352</span>
                                </div>
                                <!-- Name wraps to at most TWO lines, then ellipsises. -->
                                <div class="flex-1 min-w-0 px-3 py-2.5 self-center">
                                    <div class="font-semibold text-slate-800 text-sm leading-tight line-clamp-2" x-text="cat.label || '—'">Urology Renal Ureteric Colic Form</div>
                                </div>
                                <!-- Saved-template total for this category. -->
                                <div class="shrink-0 self-center pr-3 text-right">
                                    <div class="text-lg font-bold leading-none text-slate-700" x-text="tplCountFor(cat)">0</div>
                                    <div class="text-[9px] uppercase tracking-wide text-slate-400">templates</div>
                                </div>
                            </button>
                    </div>
                </aside>

                <!-- Right-drawer backdrop -->
                <div x-show="tplRightOpen" x-transition.opacity="" @click="tplRightOpen = false" class="fixed inset-0 z-[65] bg-slate-900/40"></div>

                <!-- Floating "New template" — grid mode only, once a category is
                     chosen. Unlike the Register Book FAB this stays visible when the
                     category is EMPTY, because the templates empty-state has no Open
                     button of its own. Hidden while the drawer is open so it can't
                     sit on top of the category list. -->
                <button type="button" x-show="tplActiveCat &amp;&amp; tplView === 'grid' &amp;&amp; !tplLoading &amp;&amp; !tplRightOpen" @click="tplNew()" class="absolute bottom-5 right-5 z-20 w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg flex items-center justify-center active:scale-95 transition" title="New template" aria-label="New template" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:26px;height:26px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                </button>
            </div>

            <!-- Exit confirmation — mirrors the Register Book section's dialog. -->
            <div x-show="tplExitConfirmOpen" x-transition.opacity="" class="fixed inset-0 z-[110] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="tplExitConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-log-out"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Exit from IPD Page Templates.</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Exit from IPD Page Templates section.</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="tplExitConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="closeTemplates()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Exit</button>
                    </div>
                </div>
            </div>

            <!-- Remark editor — free text saved to pma_template.note_remark. -->
            <div x-show="tplRemarkOpen" x-transition.opacity="" class="fixed inset-0 z-[124] bg-slate-900/60 flex items-center justify-center p-4" style="display: none;">
                <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-5 text-slate-800">
                    <div class="font-semibold text-lg mb-0.5" x-text="(_tplRemarkItem &amp;&amp; _tplRemarkItem.name) ? 'Edit remark' : 'Add remark'">Add remark</div>
                    <div class="text-xs text-slate-500 mb-3">Free text, saved to this template's remark.</div>
                    <textarea x-model="tplRemarkText" maxlength="250" rows="3" placeholder="Type a remark…" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                    <div class="text-[11px] text-slate-400 text-right mt-1"><span x-text="(tplRemarkText || '').length">0</span>/250</div>
                    <div class="flex justify-end gap-2 mt-3">
                        <button type="button" @click="tplCloseRemark()" :disabled="tplRemarkSaving" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Cancel</button>
                        <button type="button" @click="tplSaveRemark()" :disabled="tplRemarkSaving" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                            <svg x-show="tplRemarkSaving" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <span x-text="tplRemarkSaving ? 'Saving…' : 'Save'">Save</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Delete confirmation (soft-delete → page_status 1) -->
            <div x-show="tplDeleteConfirmOpen" x-transition.opacity="" class="fixed inset-0 z-[120] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="tplDeleteConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Delete this template</h2>
                    <p class="mt-2 text-sm text-slate-500">It will no longer be listed for this category.</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="tplDeleteConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="tplDelete()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Delete</button>
                    </div>
                </div>
            </div>

            <!-- Unsaved-strokes guard — Save / Discard / Keep editing, like the
                 Register Book editor's exit dialog. -->
            <div x-show="tplExitOpen" x-transition.opacity="" class="fixed inset-0 z-[121] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="tplExitOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6">
                    <h2 class="text-lg font-semibold text-slate-800 text-center">Unsaved changes</h2>
                    <p class="mt-2 text-sm text-slate-500 text-center">This template has changes that haven't been saved.</p>
                    <div class="mt-5 space-y-2">
                        <button type="button" @click="tplExitSave()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg> Save template
                        </button>
                        <button type="button" @click="tplExitDiscard()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> Discard changes
                        </button>
                        <button type="button" @click="tplExitOpen = false" class="w-full px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">Keep editing</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edge-swipe catchers. A cross-origin iframe (the embedded Digital NABH
             web pages) swallows touch events, so the window swipe handler never
             sees an edge swipe that starts on it. These thin transparent strips
             sit over the iframe's left/right edges (BELOW the app header so they
             don't block its buttons) and re-expose the gesture: a touch that
             starts here is captured by the strip and bubbles to the window
             touchstart/touchend handlers. Only present while the iframe is shown;
             the canvas / PDF panes don't need them (their touches reach window). -->
        <div x-show="webOpen &amp;&amp; webMode === 'web'" class="fixed left-0 z-30" style="top: 3.25rem; bottom: 0px; width: 26px;" aria-hidden="true"></div>
        <div x-show="webOpen &amp;&amp; webMode === 'web'" class="fixed right-0 z-30" style="top: 3.25rem; bottom: 0px; width: 26px;" aria-hidden="true"></div>

        <!-- Left drawer: Patient list -->
        <aside x-show="leftOpen" x-transition:enter="transition transform ease-out duration-200" x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition transform ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="-translate-x-full" class="fixed inset-y-0 left-0 z-40 w-[92vw] max-w-2xl bg-white shadow-2xl flex flex-col" style="display: none;">
            <!-- Header -->
            <div class="px-4 py-3 border-b border-slate-200 flex items-center justify-between bg-white">
                <div class="min-w-0 flex-1 pr-2">
                    <!-- HOME — leave the IPD shell and go back to the modules
                         home screen (home.blade.php at /pwa/). -->
                    <button type="button" @click="openModulesHome()" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition" title="Home — modules">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                        <span>Home</span>
                    </button>

                    <!-- Offline-upload progress — pages saved with no internet are
                         queued and uploaded when the connection returns. Shows
                         "UP : uploaded/total" while any page is pending or was
                         just synced (amber = still uploading, green = all done). -->
                    <span x-show="(offlineUploaded + offlinePending) &gt; 0" class="ml-2 inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold align-middle whitespace-nowrap bg-emerald-100 text-emerald-700 border border-emerald-300" :class="offlinePending &gt; 0
                                  ? 'bg-amber-100 text-amber-700 border border-amber-300'
                                  : 'bg-emerald-100 text-emerald-700 border border-emerald-300'" :title="offlinePending &gt; 0
                                  ? (offlinePending + ' page(s) saved offline, waiting to upload')
                                  : 'All offline pages uploaded'" title="All offline pages uploaded" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="cloud-upload" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-cloud-upload"><path d="M12 13v8"></path><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path><path d="m8 17 4-4 4 4"></path></svg>
                        <span>UP&nbsp;:&nbsp;<span x-text="offlineUploaded">0</span>/<span x-text="offlineUploaded + offlinePending">0</span></span>
                    </span>

                    <!-- Inline loading / error chip (count moved to the mode
                         dropdown badge — see modeCounts[patientMode]). -->
                    <div class="text-xs text-slate-500 flex items-center gap-1.5 flex-wrap" x-show="patientsLoading || patientsError || patientsOffline">
                        <span x-show="patientsLoading" class="text-teal-600" style="display: none;">Loading…</span>
                        <span x-show="patientsOffline &amp;&amp; !patientsLoading" class="text-amber-600" title="Showing the last cached patient list — you're offline" style="">Offline (cached)</span>
                        <span x-show="patientsError &amp;&amp; !patientsLoading" class="text-rose-600" :title="patientsError" title="" style="display: none;">Refresh failed</span>
                    </div>
                </div>
                <button type="button" class="mr-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-semibold transition" @click="refreshApp()" title="Refresh the app to the latest version" aria-label="Refresh app">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                    <span>Refresh</span>
                </button>
                <button type="button" class="mr-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-sky-200 bg-white text-sky-700 hover:bg-sky-50 text-xs font-semibold transition" @click="downloadLog()" title="Download activity log (presco-ipd-log)" aria-label="Download activity log">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-file-text"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                    <span>Activity Log</span>
                </button>
                <button type="button" class="mr-1 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-rose-200 bg-white text-rose-600 hover:bg-rose-50 text-xs font-semibold transition" @click="downloadErrorLog()" title="Download error log (presco-ipd-log)" aria-label="Download error log">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="alert-triangle" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-alert-triangle"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                    <span>Errors</span>
                </button>
                <button type="button" class="p-1 rounded hover:bg-slate-100 text-slate-500" @click="settingsOpen = true; $nextTick(() =&gt; window.lucide &amp;&amp; window.lucide.createIcons())" title="Settings" aria-label="Settings">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="settings" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-settings"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
            </div>

            <!-- Mode filter: Live / History / Cancelled dropdown.
                 Button background tints to match the active mode so the
                 colour of the patient rows below is self-explanatory.
                 Tap to expand the dropdown options. -->
            <div class="px-3 pt-3 pb-1 bg-white relative">
                <button type="button" @click="!me.hide_patient_modes &amp;&amp; (patientModeOpen = !patientModeOpen)" class="w-full flex items-center justify-between gap-2 border rounded-lg px-3 py-2 text-sm font-medium transition bg-emerald-50 border-emerald-300 text-emerald-800 hover:bg-emerald-100" :class="patientMode === 'live'      ? 'bg-emerald-50 border-emerald-300 text-emerald-800 hover:bg-emerald-100' :
                                patientMode === 'history'   ? 'bg-red-50 border-red-300 text-red-800 hover:bg-red-100' :
                                                              'bg-orange-50 border-orange-300 text-orange-800 hover:bg-orange-100'">
                    <span class="flex items-center gap-2 min-w-0">
                        <span class="inline-block w-2 h-2 rounded-full flex-shrink-0 bg-emerald-500" :class="patientMode === 'live'    ? 'bg-emerald-500' :
                                      patientMode === 'history' ? 'bg-red-500' :
                                                                  'bg-orange-500'"></span>
                        <span class="truncate" x-text="patientMode === 'live'    ? 'Live Mode' :
                                      patientMode === 'history' ? 'History Mode' :
                                                                  'Cancelled Admissions'">Live Mode</span>
                        <!-- Count badge on the active mode -->
                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-white/70 font-semibold flex-shrink-0 tabular-nums" x-text="modeCounts[patientMode]">28</span>
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" x-show="!me.hide_patient_modes" :data-lucide="patientModeOpen ? 'chevron-up' : 'chevron-down'" style="width: 16px; height: 16px;" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"></path></svg>
                </button>

                <!-- Dropdown menu. Sits absolutely so it doesn't push the
                     list below; click-outside closes it. -->
                <div x-show="patientModeOpen" @click.outside="patientModeOpen = false" x-transition.opacity="" class="absolute z-30 left-3 right-3 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-lg overflow-hidden" style="display:none">
                    <button type="button" @click="setPatientMode('live');      patientModeOpen = false" class="w-full text-left px-3 py-2.5 text-sm flex items-center gap-2 hover:bg-emerald-50 transition bg-emerald-50 font-semibold text-emerald-800" :class="patientMode === 'live' ? 'bg-emerald-50 font-semibold text-emerald-800' : 'text-slate-700'">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
                        <span class="flex-1">Live Mode</span>
                        <span class="text-xs px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-semibold tabular-nums" x-text="modeCounts.live">28</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="patientMode === 'live'" style="width: 14px; height: 14px;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                    </button>
                    <button type="button" x-show="!me.hide_patient_modes" @click="setPatientMode('history');   patientModeOpen = false" :disabled="modesLocked()" class="w-full text-left px-3 py-2.5 text-sm flex items-center gap-2 transition border-t border-slate-100 opacity-40 cursor-not-allowed" :class="modesLocked() ? 'opacity-40 cursor-not-allowed' : (patientMode === 'history' ? 'bg-red-50 font-semibold text-red-800 hover:bg-red-50' : 'text-slate-700 hover:bg-red-50')" disabled="disabled">
                        <span class="inline-block w-2 h-2 rounded-full bg-red-500 flex-shrink-0"></span>
                        <span class="flex-1">History Mode</span>
                        <span x-show="modesLocked()" class="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-500 font-medium flex items-center gap-1" style="">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="wifi-off" aria-hidden="true" style="width:11px;height:11px;display:block;" class="lucide lucide-wifi-off"><path d="M12 20h.01"></path><path d="M8.5 16.429a5 5 0 0 1 7 0"></path><path d="M5 12.859a10 10 0 0 1 5.17-2.69"></path><path d="M19 12.859a10 10 0 0 0-2.007-1.523"></path><path d="M2 8.82a15 15 0 0 1 4.177-2.643"></path><path d="M22 8.82a15 15 0 0 0-11.288-3.764"></path><path d="m2 2 20 20"></path></svg>Online only
                        </span>
