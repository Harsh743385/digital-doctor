                                        <template x-for="c in palette" :key="c"></template><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-slate-900 ring-2 ring-slate-400 ring-offset-1" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #0000FF;" title="Color #0000FF"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #111827;" title="Color #111827"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #dc2626;" title="Color #dc2626"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #16a34a;" title="Color #16a34a"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #ec4899;" title="Color #ec4899"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #eab308;" title="Color #eab308"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #8b4513;" title="Color #8b4513"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #f97316;" title="Color #f97316"></button><button type="button" @click="editColor = c; colorOptsOpen = false" class="w-8 h-8 rounded-full border-2 transition border-white shadow-sm hover:scale-110" :style="'background-color: ' + c + ';'" :class="editColor === c ? 'border-slate-900 ring-2 ring-slate-400 ring-offset-1' : 'border-white shadow-sm hover:scale-110'" :title="'Color ' + c" style="background-color: #7c3aed;" title="Color #7c3aed"></button>
