                        <!-- RIGHT: utilities -->
                        <div class="flex items-center gap-1">
                            <button type="button" @click="editLocked = !editLocked; $nextTick(() =&gt; window.lucide &amp;&amp; window.lucide.createIcons())" class="p-1.5 rounded transition bg-emerald-500 text-white" :class="editLocked ? 'bg-rose-500 text-white' : 'bg-emerald-500 text-white'" :title="editLocked ? 'Unlock' : 'Lock'" title="Lock">
