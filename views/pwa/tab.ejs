                        </li><li>
                            <button type="button" @click="selectPatient(p)" class="w-full text-left pl-2 pr-4 py-3 focus:outline-none transition rounded-xl border border-slate-200 border-l-4 shadow-sm bg-white hover:bg-[#f5f6f6] border-l-green-500" :class="patientRowClass(p)">
