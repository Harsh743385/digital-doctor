                },

                // GET /pwa/api/patients/{patient}/categories/{cat}/pages —
                // saved form pages for one (patient, cat) pair. Each row
                // already carries an S3-presigned `image` URL (10-min expiry)
                // so the viewer's <img> can render it directly.
                //
                // A 12-second AbortController timeout guarantees the viewer
                // never sits on "Loading…" indefinitely — if the server hangs
                // (slow query, missed index, dead replica), the request is
                // aborted and the user sees the "Couldn't load pages" panel
                // with a Retry button instead of a frozen UI.
                async loadCategoryPages(patientId, catId) {
                    this.pagesLoading = true;
                    this.pagesError = '';
                    const controller = new AbortController();
                    const timeoutMs = 12000;
                    const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
                    try {
                        const url = './api/patients/' + encodeURIComponent(patientId)
                                  + '/categories/' + encodeURIComponent(catId) + '/pages';
                        const resp = await fetch(url, {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                            signal: controller.signal,
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        const pages = Array.isArray(data && data.pages) ? data.pages : [];
                        // Snapshot the page list for offline viewing FIRST (deep
                        // copy, before rec.image is rewritten to a session-only
                        // blob URL below). On offline restore the images are
                        // re-resolved from the page-image blob store anyway.
                        idbKvSet(this._pagesCacheKey(patientId, catId),
                            { pages: JSON.parse(JSON.stringify(pages)) }).catch(() => {});
                        // Show already-cached page images straight from IndexedDB
                        // (avoids a presigned re-fetch on re-views), then render.
                        await this._applyCachedPageImages(pages);
                        this.viewerRecords = pages;
                        // Fold in any pages still queued offline for this category.
                        await this._mergeOfflinePages(patientId, catId);
                        // Download + store the blobs for any page not yet cached.
                        this._cachePageImages(pages, patientId, catId);
                    } catch (e) {
                        // Offline / failed. Fall back to the cached page list for
                        // this (patient, cat) so the saved pages still show; their
                        // images come from the page-image blob store.
                        let restored = false;
                        try {
                            const cachedPages = await idbKvGet(this._pagesCacheKey(patientId, catId));
                            if (cachedPages && Array.isArray(cachedPages.pages)) {
                                const pages = cachedPages.pages;
                                // Resolve each page's stored image blob before
                                // render so the saved strokes show offline.
                                await this._applyCachedPageImages(pages);
                                this.viewerRecords = pages;
                                this.pagesError = '';
                                await this._mergeOfflinePages(patientId, catId);
                                this._cachePageImages(pages, patientId, catId);
                                restored = true;
                            }
                        } catch (_) { /* fall through */ }
                        if (!restored) {
