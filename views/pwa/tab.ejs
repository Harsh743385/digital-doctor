                    <h2 class="text-lg font-semibold text-slate-800">Delete this Register Page</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Delete this page</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="rbDeleteConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="rbDeleteConfirmPage()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Delete</button>
                    </div>
                </div>
            </div>

            <!-- Other Documents — full-screen preview. Image renders vertically /
                 full width (scrollable); PDF renders in-panel via PDF.js. Above
                 the RB overlay (z-99); below the capture sheets (z-112+). -->
            <div x-show="rbDocPreviewOpen" class="fixed inset-0 z-[108] bg-slate-900/90 flex flex-col" style="display:none">
                <div class="shrink-0 flex items-center gap-2 px-3 py-2.5 bg-slate-900 text-white">
                    <button type="button" @click="rbCloseDocPreview()" class="p-1.5 rounded hover:bg-white/15" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                    </button>
                    <div class="flex-1 min-w-0 font-medium truncate" x-text="rbDocPreviewItem ? ('Document · ' + _rbFmt(rbDocPreviewItem.added, 'dt')) : 'Document'">Document</div>
                    <button type="button" x-show="rbDocPreviewItem" @click="rbOpenDocRemark(rbDocPreviewItem)" class="p-1.5 rounded hover:bg-white/15" :title="rbDocPreviewItem &amp;&amp; rbDocPreviewItem.remark ? 'Edit remark' : 'Add remark'" aria-label="Remark" title="Add remark" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pencil-line" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-pencil-line"><path d="M13 21h8"></path><path d="m15 5 4 4"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
                    </button>
                    <button type="button" x-show="rbDocPreviewItem" @click="rbAskDeleteDoc(rbDocPreviewItem)" class="p-1.5 rounded hover:bg-rose-500/30 text-rose-300" title="Delete" aria-label="Delete" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                </div>
                <div class="flex-1 min-h-0 overflow-auto">
                    <template x-if="rbDocPreviewItem &amp;&amp; rbDocPreviewItem.kind === 'image'"></template>
                    <template x-if="rbDocPreviewItem &amp;&amp; rbDocPreviewItem.kind === 'pdf'"></template>
                </div>
            </div>

            <!-- Delete Other Document confirmation (HARD delete, like IPD). -->
            <div x-show="rbDocDeleteConfirmOpen" x-transition.opacity="" class="fixed inset-0 z-[122] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="rbDocDeleteConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Delete this Document</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Delete this document</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="rbDocDeleteConfirmOpen = false" :disabled="rbDocDeleteBusy" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50 disabled:opacity-50">No</button>
                        <button type="button" @click="rbDeleteDoc()" :disabled="rbDocDeleteBusy" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700 disabled:opacity-50 inline-flex items-center justify-center gap-2">
                            <svg x-show="rbDocDeleteBusy" class="animate-spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <span x-text="rbDocDeleteBusy ? 'Deleting…' : 'Delete'">Delete</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Other Document remark editor (remark ONLY — no directory). -->
            <div x-show="rbDocRemarkOpen" x-transition.opacity="" class="fixed inset-0 z-[124] bg-slate-900/60 flex items-center justify-center p-4" style="display: none;">
                <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-5 text-slate-800">
                    <div class="font-semibold text-lg mb-0.5" x-text="(_rbDocRemarkItem &amp;&amp; _rbDocRemarkItem.remark) ? 'Edit remark' : 'Add remark'">Add remark</div>
                    <div class="text-xs text-slate-500 mb-3">Free text, saved to the document's remark.</div>
                    <textarea x-model="rbDocRemarkText" maxlength="255" rows="3" placeholder="Type a remark…" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                    <div class="text-[11px] text-slate-400 text-right mt-1"><span x-text="(rbDocRemarkText || '').length">0</span>/255</div>
                    <div class="flex justify-end gap-2 mt-3">
                        <button type="button" @click="rbCloseDocRemark()" :disabled="rbDocRemarkSaving" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Cancel</button>
                        <button type="button" @click="rbSaveDocRemark()" :disabled="rbDocRemarkSaving" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                            <svg x-show="rbDocRemarkSaving" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <span x-text="rbDocRemarkSaving ? 'Saving…' : 'Save'">Save</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Audit & Feedback — full clone of the Register Book window,   -->
        <!-- backed by mst_audit + pma_feedback. Reached past the         -->
        <!-- administrative-password gate (openAuditFeedback).            -->
        <!-- ============================================================ -->
        <div x-show="afOpen" x-transition.opacity="" @keydown.escape.window="afDocRemarkOpen ? afCloseDocRemark() : (afDocDeleteConfirmOpen ? (afDocDeleteConfirmOpen = false) : (afDocPreviewOpen ? afCloseDocPreview() : ((afPageView === 'gallery' &amp;&amp; afDocView === 'detail') ? afDocBackToGrid() : (afDeleteConfirmOpen ? (afDeleteConfirmOpen = false) : (afEditExitOpen ? afEditExitCancel() : (afExitConfirmOpen ? (afExitConfirmOpen = false) : (afPageView === 'edit' ? afCancelEdit() : (afRightOpen ? (afRightOpen = false) : afConfirmExit()))))))))" class="fixed inset-0 z-[99] bg-slate-100 flex flex-col" style="display:none">
            <!-- Header (normal) — hidden in edit mode (no back button while editing).
                 `relative` so the detail cluster can be absolutely centred. -->
            <div x-show="afPageView !== 'edit'" class="relative shrink-0 flex items-center gap-1.5 px-3 py-3 text-white shadow" style="background-color:#67C2FF;">
                <!-- Back — confirms before leaving the Audit & Feedback section.
                     Shown in every non-edit view. -->
                <button type="button" @click="afConfirmExit()" class="p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <!-- Home — in the page viewer AND in the document pager; returns to
                     the corresponding grid. -->
                <button type="button" x-show="afPageView === 'detail'" @click="afHome()" class="p-1.5 rounded hover:bg-white/15 shrink-0" title="Home" aria-label="Home" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                </button>
                <button type="button" x-show="afPageView === 'gallery' &amp;&amp; afDocView === 'detail'" @click="afDocBackToGrid()" class="p-1.5 rounded hover:bg-white/15 shrink-0" title="Home" aria-label="Home" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                </button>
                <!-- In detail mode the title is capped so it truncates well before
                     the absolutely-centred Open · n/n · Add cluster. -->
                <div class="flex-1 min-w-0" :class="(afPageView === 'detail' || afPageView === 'gallery' || (afPageView === 'grid' &amp;&amp; afActiveCat &amp;&amp; afPages.length === 0)) ? 'max-w-[38%]' : ''">
                    <div class="font-semibold text-base truncate" x-text="afActiveCat ? afActiveCat.book_type : 'Audit &amp; Feedback'">Audit &amp; Feedback</div>
                    <div x-show="afActiveCat" class="text-[11px] text-white/70 truncate" x-text="(afActiveCat &amp;&amp; afActiveCat.category_code) || 'Audit form pages'" style="display: none;">Audit form pages</div>
                </div>

                <!-- Detail cluster: Open · page n/n · Add — absolutely CENTRED in
                     the app bar (independent of the title width on the left).
                     Navigation is by SWIPE — no prev/next arrows. -->
                <template x-if="afPageView === 'detail'"></template>

                <!-- Empty-state cluster (grid, no pages) — SAME as IPD: "Page 1 / 1"
                     + an orange Open button that starts the first page. The bottom
                     floating + button is hidden in this state (see below). -->
                <template x-if="afActiveCat &amp;&amp; afPageView === 'grid' &amp;&amp; !afPagesLoading &amp;&amp; !afPagesError &amp;&amp; afPages.length === 0"></template>

                <!-- Other Documents (gallery) cluster — file count + an Add button
                     to open the image/PDF capture sheet. Absolutely centred, like
                     the page clusters. -->
                <template x-if="afActiveCat &amp;&amp; afActiveCat.is_other &amp;&amp; afPageView === 'gallery'"></template>

                <!-- Right drawer (category selector) — the ONLY right-side icon,
                     pinned to the far right end (ml-auto) so it can't overlap the
                     centred Open · n/n · Add cluster in the page viewer. Opens the
                     audit form list, so a separate list icon isn't needed. -->
                <button type="button" @click="afRightOpen = !afRightOpen" class="relative ml-auto p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Audit forms">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-check" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>
                </button>
            </div>

            <!-- Header (EDIT mode) — editing tools live in the app bar, like IPD.
                 No back button here; Save / Cancel end the edit. Popovers drop down. -->
            <div x-show="afPageView === 'edit'" class="shrink-0 bg-slate-50 border-b border-slate-200 text-slate-600 shadow-sm relative z-30" style="display: none;">
                <!-- flex-wrap (NOT overflow-x-auto) so the row never clips the
                     tool dropdowns that open below it; on narrow screens the
                     toolbar wraps to a second line instead of scroll-clipping. -->
                <div class="flex flex-wrap items-center justify-center gap-1.5 px-2 py-2">
                    <!-- Pen -->
                    <div class="relative shrink-0">
                        <button type="button" @click="afToolTap('pen')" :class="afEditTool === 'pen' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center bg-slate-800 text-white" title="Pen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-line" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-pen-line"><path d="M13 21h8"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
                        </button>
                        <div x-show="afPenOpen" @click.outside="afPenOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Pen size <span x-text="afPenSize">2</span></div>
                            <input type="range" min="1" max="20" x-model.number="afPenSize" class="w-full">
                        </div>
                    </div>
                    <!-- Eraser -->
                    <div class="relative shrink-0">
                        <button type="button" @click="afToolTap('eraser')" :class="afEditTool === 'eraser' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Eraser">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="eraser" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-eraser"><path d="M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21"></path><path d="m5.082 11.09 8.828 8.828"></path></svg>
                        </button>
                        <div x-show="afEraserOpen" @click.outside="afEraserOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Eraser size <span x-text="afEraserSize">24</span></div>
                            <input type="range" min="6" max="80" x-model.number="afEraserSize" class="w-full">
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Undo / Redo -->
                    <button type="button" @click="afUndo()" :disabled="!afCanUndo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Undo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="undo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-undo-2"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg></button>
                    <button type="button" @click="afRedo()" :disabled="!afCanRedo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Redo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="redo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-redo-2"><path d="m15 14 5-5-5-5"></path><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"></path></svg></button>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Colour -->
                    <div class="relative shrink-0">
                        <button type="button" @click="afColorOpen=!afColorOpen; afGalleryOpen=false; afPasteMenuOpen=false" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Colour">
                            <span class="w-5 h-5 rounded-full border-2 border-slate-300" :style="'background-color:' + afEditColor" style="background-color:#0000FF"></span>
                        </button>
                        <div x-show="afColorOpen" @click.outside="afColorOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 grid grid-cols-4 gap-2 w-44" style="display: none;">
                            <template x-for="col in afPalette" :key="col"></template><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#0000FF; border-color:#0f172a"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#111827; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#dc2626; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#16a34a; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#ec4899; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#eab308; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#8b4513; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#f97316; border-color:transparent"></button><button type="button" @click="afSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (afEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#7c3aed; border-color:transparent"></button>
                            <input type="color" x-model="afEditColor" class="col-span-4 w-full h-8 mt-1 rounded border border-slate-200">
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>

                    <!-- SAVE (centre) -->
                    <button type="button" @click="afSaveEdit()" :disabled="afSaving" class="mx-2 inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-emerald-500 text-white text-sm font-semibold hover:bg-emerald-600 disabled:opacity-60 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                        <span x-text="afSaving ? 'Saving…' : 'Save'">Save</span>
                    </button>
                    <!-- n/n page count -->
