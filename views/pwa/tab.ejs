                                // (best-effort; never blocks the app).
                                this._initPushNotifications();
                            } else {
                                // 200 without a user_id — no usable session. Fall
                                // back to the demo feeds so the lists don't hang on
                                // the loading state.
                                this._seedDemoData();
                            }
                        } else {
                            this._seedDemoData();
                        }
                    } catch (_) {
                        // /api/me unreachable — could be a static host OR a cold
                        // OFFLINE start. If we have a cached identity + category
                        // list from a prior online session, restore them so the
                        // category drawer (with its offline-cached template
                        // images) still works. Patients/masters need the network,
                        // so they stay on their demo/empty state.
                        const cachedMe = this._loadCachedMe();
                        if (cachedMe && cachedMe.user_id) {
                            this.me = cachedMe;
                            this.csrfToken = '';
                            this.$nextTick(() => window.lucide && window.lucide.createIcons());
                            // loadCategories tries the network first, then falls
                            // back to the cached list on failure (offline).
                            this.loadCategories();
                            // Stamps too — network-first, IndexedDB fallback so
                            // the gallery menu lists them on an offline cold start.
                            this.loadStamps();
                            // Restore the Live patient drawer on an offline cold
                            // start: loadPatients() tries the network, then its
                            // catch falls back to the complete cached census so
                            // all live patients are visible without a connection.
                            this.loadPatients();
                        } else {
                            // No backend and no cached session — a static /
                            // design-review host. Show the demo feeds (and clear
                            // the loading states) instead of a perpetual spinner.
                            this._seedDemoData();
                        }
                    }
                },

                // GET /pwa/api/patients — paginated patient list for the
                // session's hospital scoped by the current mode + filters.
                //
                //   append=false  (default) — REPLACE this.patients (fresh
                //                              page-1 fetch on mode/filter
                //                              change or initial load).
                //   append=true             — APPEND the returned rows to
                //                              this.patients (called by
                //                              loadMorePatients on scroll).
                async loadPatients(append = false) {
                    // Always normalise filter state before building URL
                    // params. Catches the Alpine `.number`-on-null trap
                    // (NaN) so every call path — setPatientMode, refresh,
                    // scroll-loadMore, filter change — gets clean params.
                    this._normalizeFilters();

                    if (append) {
                        this.patientsLoadingMore = true;
                    } else {
                        this.patientsLoading = true;
                    }
                    this.patientsError = '';

                    // Offline fast-path: if the device reports no connectivity, skip
                    // the network entirely (a stale SW could hand back a cached
                    // page-1 with HTTP 200 and hide the offline state). Restore the
                    // COMPLETE Live census straight from IndexedDB so EVERY live
                    // patient shows — not just the first page. Appends are
                    // network-only (no offline infinite-scroll).
                    // Covers BOTH first-page loads AND infinite-scroll appends: when
                    // the device reports no connectivity, never hit the network.
                    // Snap History/Cancelled → Live, then show the COMPLETE cached
                    // census in one shot (no paging offline — the whole list shows,
                    // so scrolling for "more" just reveals everyone, never errors).
                    // Confirmed-offline only (see _looksOffline): a WebView cold
                    // start briefly reports navigator.onLine === false while the
                    // network is actually up, and trusting it here used to freeze the
                    // drawer on the cached census until the next poll recovered it.
                    if (await this._looksOffline()) {
                        this.isOnline = false;   // confirmed offline — keep the flag honest
                        this._snapToLiveOffline();
                        try {
                            if (await this._showCachedCensus(this.patientMode)) {
                                this.patientsLoading = false;
                                this.patientsLoadingMore = false;
                                this.$nextTick(() => window.lucide && window.lucide.createIcons());
                                return;
                            }
                        } catch (_) { /* no snapshot — handled just below */ }
                        // Offline with nothing cached: don't fetch (futile) and don't
                        // error — just stop the spinners and flag offline.
                        this.patientsOffline = true;
                        this.patientsHasMore = false;
                        this.patientsLoading = false;
                        this.patientsLoadingMore = false;
                        return;
                    }

                    // One-shot scroll-depth restore. A fresh app load re-inits with
                    // patientsPage = 1; if the user had scrolled the (clean) list
                    // last session, restore that depth here so the FIRST online
                    // fetch pulls the whole prior list back in one go instead of
                    // showing only the newest page. Only for the clean/unfiltered
                    // view (a mode/filter change deliberately wants page 1), and
                    // only once — subsequent loads page normally.
                    if (!append && !this._patientsDepthRestored) {
                        this._patientsDepthRestored = true;
                        if (this.patientsPage <= 1 && this._patientsViewIsClean()) {
                            const depth = this._readPatientsDepth(this.patientMode);
                            if (depth > 1) this.patientsPage = depth;
                        }
                    }

                    try {
                        // Server-side search is faster than client-side filtering
                        // for large wards; trim() so a single space doesn't trigger.
                        const q = (this.patientSearch || '').trim();
                        const params = [];

                        // Defensive URL builders — gate every server-side
                        // type so a NaN/empty/garbage value can't leak past
                        // and trigger a 422 (which then breaks every
                        // subsequent fetch because the catch leaves the
                        // stale list on screen).
                        //
                        //  intParam(key, val, minAllowed=1)
                        //    → only sends an integer >= minAllowed. NaN,
                        //      null, '', non-finite, and Number()-of-string
                        //      that parses to NaN all drop silently.
                        //  strParam(key, val)
                        //    → trims to non-empty string then sends.
                        const intParam = (key, val, minAllowed = 1) => {
                            if (val === null || val === undefined || val === '') return;
                            const raw = (typeof val === 'number') ? val : Number(val);
                            if (!Number.isFinite(raw)) return;
                            const n = Math.trunc(raw);
                            if (n < minAllowed) return;
                            params.push(key + '=' + n);
                        };
                        const strParam = (key, val) => {
                            if (val === null || val === undefined) return;
                            const s = String(val).trim();
                            if (s === '' || s === 'NaN') return;
                            params.push(key + '=' + encodeURIComponent(s));
                        };
                        //  intArrayParam(key, arr)
                        //    → sends one `key[]=id` pair per valid integer id in
                        //      the array (multi-select filters). Garbage ids drop
                        //      the same way intParam guards a single value.
                        const intArrayParam = (key, arr) => {
                            if (!Array.isArray(arr)) return;
                            arr.forEach((val) => {
                                const raw = (typeof val === 'number') ? val : Number(val);
                                if (!Number.isFinite(raw)) return;
                                const n = Math.trunc(raw);
                                if (n < 1) return;
                                params.push(encodeURIComponent(key) + '[]=' + n);
                            });
                        };

                        if (this.patientMode && this.patientMode !== 'live') {
                            strParam('mode', this.patientMode);
                        }
                        if (q) strParam('q', q);

                        intParam('floor_id',             this.filterFloorId);
                        intParam('dept_id',              this.filterDeptId);
                        intArrayParam('ward_id',             this.filterWardIds);
                        intParam('unit_id',              this.filterUnitId);
                        intArrayParam('consultant_id',       this.filterConsultantIds);
                        intArrayParam('other_consultant_id', this.filterOtherConsultantIds);
                        intArrayParam('reason_id',           this.filterReasonIds);
                        intParam('discharge_reason',     this.filterDischargeReasonId);
                        // pmode allows 0 (Cash) so its lower bound is 0, not 1.
                        intParam('pmode',                this.filterPmode, 0);
                        // pmode_sub can be an int id (Insurance/Corporate) or
                        // a name string (TPA/Scheme/Reimbursement) — always
                        // send as a string and let server validation handle it.
                        strParam('pmode_sub',            this.filterPmodeSub);

                        // "24 hrs No File Activity" — only when the hospital flag
                        // is on AND the user picked it. Server restricts to
                        // patients with no page saved/edited in the last 24h.
                        if (this.me && this.me.no_ipd_file_activity === 1 && this.filterNoActivity === 1) {
                            strParam('no_activity', '1');
                        }

                        // Date range — ISO yyyy-mm-dd strings from native
                        // <input type="date">. Server's `date` validator
                        // happily accepts this format; we drop empty values
                        // via strParam.
                        strParam('date_from',            this.filterDateFrom);
                        strParam('date_to',              this.filterDateTo);

                        // Sort order — 'date' is the default, only send
                        // when the user picked something else (currently
                        // 'bed', which the server applies in Live mode only).
                        if (this.filterSort && this.filterSort !== 'date') {
                            strParam('sort', this.filterSort);
                        }

                        // Pagination. The client owns the page size (SIZE), sent
                        // on every request so it can't drift from the server
                        // default. Two shapes:
                        //   • append (infinite scroll) — one page of SIZE at the
                        //     current page number (always >= 2).
                        //   • non-append (page-1 / restore) — page 1, but with a
                        //     limit of patientsPage × SIZE so a restored scroll
                        //     depth reloads as a single request. Capped at
                        //     maxRestorePages × SIZE (= the server's 200 clamp) so
                        //     there's never a gap before the next append page.
                        const SIZE = this.patientsPageSize;
                        let fetchPage, fetchLimit;
                        if (append) {
                            fetchPage  = this.patientsPage;   // >= 2 (set by loadMorePatients)
                            fetchLimit = SIZE;
                        } else {
                            fetchPage  = 1;
                            const depth = Math.max(1, Math.min(this.patientsPage, this.patientsMaxRestorePages));
                            fetchLimit  = depth * SIZE;
                            // Keep patientsPage in lock-step with what we actually
                            // fetched, so the next append continues without a gap.
                            this.patientsPage = depth;
                        }
                        intParam('limit', fetchLimit, 1);
                        // page=1 is the server default, so only send when >= 2.
                        intParam('page', fetchPage, 2);
                        const url = './api/patients' + (params.length ? '?' + params.join('&') : '');
                        // Bound the wait. When the interface is still "online" but
                        // there's no real internet, fetch() would otherwise hang on
                        // the browser's ~30s TCP timeout before we can fall back to
                        // the cache. Abort after 7s so the cached list shows fast.
                        const ac = new AbortController();
                        const to = setTimeout(() => ac.abort(), 7000);
                        let resp;
                        try {
                            resp = await fetch(url, {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' },
                                signal: ac.signal,
                            });
                        } finally {
                            clearTimeout(to);
                        }
                        if (resp.status === 401) {
                            window.location.assign('./login');
                            return;
                        }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        const list = Array.isArray(data && data.patients) ? data.patients : [];
                        // Replace on first-page fetches, append on infinite-scroll loads.
                        this.patients = append ? [...this.patients, ...list] : list;
                        this.patientsLive = true;
                        this.patientsOffline = false;
                        // Cache + attach each avatar so it survives offline.
                        this._warmPatientPhotos(this.patients);
                        // Pagination + per-mode count badges, straight off the response.
                        this.patientsTotal   = (data && data.total)    || 0;
                        this.patientsHasMore = !!(data && data.has_more);
                        // Remember how far the clean (unfiltered) list is scrolled so
                        // an app resume/reload can restore it (see the one-shot above).
                        // Filtered/searched views are skipped so they never overwrite
                        // the clean depth — after a reload the filters reset to their
                        // defaults, so it's the clean depth we need to bring back.
                        if (this._patientsViewIsClean()) {
                            this._persistPatientsDepth(this.patientMode, this.patientsPage);
                        }
                        if (data && data.mode_counts) {
                            this.modeCounts = {
                                live:      data.mode_counts.live      || 0,
                                history:   data.mode_counts.history   || 0,
                                cancelled: data.mode_counts.cancelled || 0,
                            };
                        }
                        // Snapshot the page-1 census for this mode so an offline
                        // reload still shows a patient list. Appends (page > 1)
                        // aren't cached — offline browse is page-1 only.
                        if (!append) {
                            idbKvSet(this._patientsCacheKey(this.patientMode), {
                                patients:    list,
                                total:       this.patientsTotal,
                                mode_counts: this.modeCounts,
                            }).catch(() => {});
                        }

                        // Re-seat the currently-selected patient — but only
                        // for first-page (replace) loads. On infinite-scroll
                        // appends, the user is likely already viewing a
                        // patient and we don't want their selection to jump.
                        if (append) {
                            return; // skip everything below; just appended rows.
                        }

                        // Re-seat the selection. IMPORTANT: a refresh (e.g. an
                        // offline→online recovery) reloads only page-1, so the
                        // selected patient often ISN'T in this page. Never clear a
                        // live selection just because it's absent from the current
                        // page — keep the patient AND their open page exactly as-is.
                        const stillThere = list.find(p => p.id === this.selectedPatientId);
                        if (stillThere) {
                            // Selected patient is in this page → refresh their row data.
                            this.selectedPatientId = stillThere.id;
                            this.selectedPatient = stillThere;
                            this.patientName = stillThere.name || '';
                            this.patientUhid = stillThere.uhid || '';
                            this.patientIp   = stillThere.ipd  || '';
                            if (this.categoriesLive) {
                                this.loadPatientCategoryCounts(stillThere.id);
                            }
                        } else if (this.selectedPatientId) {
                            // Selected patient isn't on this page (paginated further
                            // down, or beyond page-1 after a recovery). KEEP the
                            // existing selection + open page — do NOT blank it.
                            // Refresh their category counts now that we're online.
                            if (this.categoriesLive) {
                                this.loadPatientCategoryCounts(this.selectedPatientId);
                            }
                        } else {
                            // Nothing was selected — leave nothing selected (no
                            // auto-pick of the first patient; the user chooses).
                            this.selectedPatientId = null;
                            this.selectedPatient = null;
                            this.patientName = '';
                            this.patientUhid = '';
                            this.patientIp   = '';
                        }
                    } catch (e) {
                        // Offline / server down. For a first-page load, fall back
                        // to the last cached census for this mode so the drawer
                        // still lists patients (per-patient counts need the
                        // network, so badges sit at 0). Appends just stop.

                        // Distinguish a connectivity-loss failure (offline / aborted
                        // / network error) from an HTTP status error (server
                        // reachable). Only the former falls back to the offline
                        // cache; an HTTP 4xx/5xx in History must NOT bounce the user.
                        const offlineLike = (navigator.onLine === false)
                            || (e && e.name === 'AbortError')
                            || (e instanceof TypeError);
                        plog(offlineLike ? 'warn' : 'error', 'patients',
                            'loadPatients(' + (append ? 'append' : 'page1') + ', mode=' + this.patientMode + ') failed: '
                            + (e && (e.message || e.name) || e));

                        if (offlineLike) {
                            // History/Cancelled aren't cached → snap to Live first.
                            if (this.patientMode !== 'live') {
                                this.patientsOffline = true;
                                this._snapToLiveOffline();
                            }
                            // Show the COMPLETE cached census in one shot. This also
                            // covers an infinite-scroll append that failed offline:
                            // there's no "next page" offline, so the scroll-load just
                            // reveals EVERYONE instead of throwing "Refresh failed".
                            let shown = false;
                            try { shown = await this._showCachedCensus(this.patientMode); } catch (_) {}
                            // No snapshot, but a list is already on screen — keep it
                            // and just flag offline (never blank a good list).
                            if (!shown && this.patientsLive && Array.isArray(this.patients) && this.patients.length) {
                                this.patientsOffline = true;
                                this.patientsError   = '';
                                this.patientsHasMore = false;
                                shown = true;
                            }
                            if (shown) return;
                            // Truly nothing to show. An append stops paging silently
                            // (keeps the partial list); only a first-page load
                            // surfaces the error so the user knows it never loaded.
                            if (append) {
                                this.patientsHasMore = false;
                            } else {
                                this.patientsError = String(e && e.message || e);
                            }
                            return;
                        }

                        // Non-offline failure (HTTP 4xx/5xx, parse error).
                        let restored = false;
                        if (!append) {
                            try {
                                const cached = await this._restoreCachedPatients(this.patientMode);
                                if (cached && Array.isArray(cached.patients) && cached.patients.length) {
                                    this.patients        = cached.patients;
                                    this.patientsLive    = true;
                                    this.patientsOffline = true;
                                    this.patientsError   = '';
                                    this.patientsTotal   = cached.total || cached.patients.length;
                                    this.patientsHasMore = false;
                                    if (cached.mode_counts) this.modeCounts = cached.mode_counts;
                                    const keep = cached.patients.find(p => p.id === this.selectedPatientId);
                                    if (keep) { this.selectedPatient = keep; }
                                    restored = true;
                                }
                            } catch (_) { /* fall through */ }
                            if (!restored && this.patientsLive && Array.isArray(this.patients) && this.patients.length) {
                                this.patientsOffline = true;
                                this.patientsError   = '';
                                this.patientsHasMore = false;
                                restored = true;
                            }
                        } else {
                            // Append HTTP error — keep the partial list, stop paging,
                            // and never surface "Refresh failed" for a scroll-load.
                            this.patientsHasMore = false;
                            restored = true;
                        }
                        if (!restored) {
                            this.patientsError = String(e && e.message || e);
                        }
                    } finally {
                        // Always clear BOTH flags — the path branched on
                        // `append` at the top, but finally has to handle
                        // either case (e.g. an early `return` for append
                        // success still passes through here).
                        this.patientsLoading = false;
                        this.patientsLoadingMore = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Infinite-scroll handler — fires (passively) on every scroll
                // event on the patient list container. Triggers loadMore
                // when the user is within 120px of the bottom, has more
                // pages to load, and isn't already loading. The 120px
                // threshold is small enough that fast scrolls trigger near
                // the actual end but large enough to give the next page
                // a head-start so the user doesn't see a hard stop.
                onPatientListScroll(e) {
                    const el = e && e.target;
                    if (!el || !this.patientsLive) return;
                    if (this.patientsLoading || this.patientsLoadingMore) return;
                    if (!this.patientsHasMore) return;
                    const nearBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 120;
                    if (nearBottom) {
                        this.loadMorePatients();
                    }
                },

                // Append-next-page wrapper. Bumps page, fetches with
                // append=true so the response rows get pushed onto the
                // tail of this.patients instead of replacing it.
                async loadMorePatients() {
                    if (this.patientsLoadingMore || !this.patientsHasMore) return;
                    this.patientsPage = (this.patientsPage || 1) + 1;
                    await this.loadPatients(true);
                },

                // Snapshot the COMPLETE Live census (every page, UNFILTERED) into
                // its own offline cache so ALL live patients — not just the on-
                // screen page of 10 or whatever filter is active — stay visible
                // when the tablet loses connectivity. Runs in the background after
                // an online load and on reconnect; any failure is swallowed so we
                // simply keep the previous snapshot. The on-screen list is driven
                // by loadPatients() and is untouched by this.
                async prefetchAllLivePatients() {
                    if (this._prefetchingLive) return;            // already running
                    if (navigator.onLine === false) return;       // nothing to fetch
                    if (!this.me || !this.me.user_id) return;     // no session yet
                    this._prefetchingLive = true;
                    try {
                        const all = [];
                        let page = 1, total = 0, modeCounts = null;
                        const LIMIT = 200;                         // server clamps 1..200
                        // Walk every page (mode defaults to 'live', no filters) until
                        // the server reports no more rows. Hard-stop at 50 pages
                        // (10k patients) as a runaway guard.
                        for (;;) {
                            const resp = await fetch('./api/patients?limit=' + LIMIT + '&page=' + page, {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' },
                            });
                            if (!resp.ok) return;                  // give up; keep old snapshot
                            const data = await resp.json();
                            const list = Array.isArray(data && data.patients) ? data.patients : [];
                            all.push(...list);
                            // Warm each patient's photo into IndexedDB (best-effort)
                            // so EVERY live patient's avatar is available offline,
                            // not just the on-screen page.
                            list.forEach((p) => { this._cachePatientPhoto(p && p.id); });
                            total = (data && data.total) || all.length;
                            if (data && data.mode_counts) modeCounts = data.mode_counts;
                            if (!(data && data.has_more) || list.length === 0) break;
                            page += 1;
                            if (page > 50) break;
                        }
                        await idbKvSet(this._patientsFullCacheKey('live'), {
                            patients:    all,
                            total,
                            mode_counts: modeCounts || this.modeCounts,
                        });
                    } catch (_) {
                        // offline / transient — previous snapshot stays intact
                    } finally {
                        this._prefetchingLive = false;
                    }
                },

                // Read back the best offline snapshot for a mode: the COMPLETE
                // Live census first (so all patients show), then the per-mode
                // page-1 cache as a fallback (and the only option for
                // history/cancelled). Returns null when nothing is cached.
                async _restoreCachedPatients(mode) {
                    let cached = null;
                    if (mode === 'live') {
                        try { cached = await idbKvGet(this._patientsFullCacheKey('live')); } catch (_) {}
                    }
                    if (!cached) {
                        try { cached = await idbKvGet(this._patientsCacheKey(mode)); } catch (_) {}
                    }
                    return (cached && Array.isArray(cached.patients)) ? cached : null;
                },

                // ── Offline patient photos ──────────────────────────────────
                // Patient avatars come from presigned S3 URLs that fail offline
                // (and expire). We proxy the BYTES same-origin and cache them in
                // IndexedDB keyed by patient_id so the avatar renders offline.
                //
                // _ensurePatientPhoto: for a displayed patient — set p.photoSrc
                // from the cached blob (works offline), and warm the cache from
                // the proxy once per session when online.
                async _ensurePatientPhoto(p) {
                    if (!p || p.id == null) return;
                    // Reuse an object URL we already minted for this patient.
                    if (this._photoUrlById[p.id]) { p.photoSrc = this._photoUrlById[p.id]; }
                    else {
                        try {
                            const rec = await idbGet(STORE_PATIENT_IMG, p.id);
                            if (rec && rec.blob && rec.blob.size) {
                                const u = URL.createObjectURL(rec.blob);
                                this._photoUrlById[p.id] = u;
                                p.photoSrc = u;
                            }
                        } catch (_) {}
                    }
                    // Refresh bytes from the same-origin proxy once per session.
                    if (navigator.onLine !== false && !this._photoWarmed[p.id]) {
                        this._photoWarmed[p.id] = true;
                        try {
                            const resp = await fetch('./api/patients/' + p.id + '/photo', {
                                credentials: 'same-origin', cache: 'no-store',
                            });
                            if (resp.ok) {
                                const blob = await resp.blob();
                                if (blob && blob.size) {
                                    try { await idbPut(STORE_PATIENT_IMG, { id: p.id, blob, updatedAt: Date.now() }); } catch (_) {}
                                    if (this._photoUrlById[p.id]) { try { URL.revokeObjectURL(this._photoUrlById[p.id]); } catch (_) {} }
                                    const u = URL.createObjectURL(blob);
                                    this._photoUrlById[p.id] = u;
                                    p.photoSrc = u;
                                }
                            }
                        } catch (_) { delete this._photoWarmed[p.id]; /* allow retry */ }
                    }
                },
                // Warm photos for a whole list (best-effort, fire-and-forget).
                _warmPatientPhotos(list) {
                    if (!Array.isArray(list)) return;
                    list.forEach((p) => { this._ensurePatientPhoto(p); });
                },
                // Cache-only warm (no object URL) for patients NOT on screen — used
                // by the full-census prefetch so every live patient's photo is
                // available offline, not just the visible page.
                async _cachePatientPhoto(id) {
                    if (id == null || this._photoWarmed[id] || navigator.onLine === false) return;
                    this._photoWarmed[id] = true;
                    try {
                        const resp = await fetch('./api/patients/' + id + '/photo', {
                            credentials: 'same-origin', cache: 'no-store',
                        });
                        if (resp.ok) {
                            const blob = await resp.blob();
                            if (blob && blob.size) { try { await idbPut(STORE_PATIENT_IMG, { id, blob, updatedAt: Date.now() }); } catch (_) {} }
                        }
                    } catch (_) { delete this._photoWarmed[id]; }
                },

                // Load the cached census for `mode` into the list state and mark it
                // offline. REPLACES the list with the full snapshot and sets
                // patientsHasMore = false — offline there is no paging, the whole
                // census shows at once (so an infinite-scroll load offline simply
                // reveals everyone instead of trying to fetch a "next page").
                // Returns true if a non-empty snapshot was shown. Shared by the
                // offline fast-path and the fetch catch.
                async _showCachedCensus(mode) {
                    const cached = await this._restoreCachedPatients(mode);
                    if (cached && Array.isArray(cached.patients) && cached.patients.length) {
                        this.patients        = cached.patients;
                        this.patientsLive    = true;
                        this.patientsOffline = true;
                        this.patientsError   = '';
                        this.patientsTotal   = cached.total || cached.patients.length;
                        this.patientsHasMore = false;
                        if (cached.mode_counts) this.modeCounts = cached.mode_counts;
                        const keep = cached.patients.find(p => p.id === this.selectedPatientId);
                        if (keep) { this.selectedPatient = keep; }
                        // Attach cached avatars (IndexedDB-only when offline).
                        this._warmPatientPhotos(this.patients);
                        return true;
                    }
                    return false;
                },

                // Switch the patient drawer's Live/History/Cancelled dropdown.
                // Tapping the active mode is a no-op; tapping a new mode
                // refetches /api/patients with the new flag/status bucket
                // (defined server-side in PwaPatientsController). The search
                // box's current text is preserved across the switch. Page
                // resets to 1 — different mode = different result set.
                //
                // Also clears the discharge-reason filter (the dropdown
                // belongs to a specific mode bucket) and re-fetches its
                // options if the new mode is history or cancelled.
                // True when ONLY Live mode is usable: no internet (OS-level) or
                // the patient list is currently served from the offline cache.
                // History / Cancelled are not snapshotted for offline use, so the
                // dropdown locks them in this state.
                modesLocked() { return !this.isOnline || this.patientsOffline; },

                // True when there's no usable internet — the device is offline
                // (navigator.onLine false) OR it's on a network whose backend is
                // unreachable (captive portal / "connected, no internet", which
                // surfaces as patientsOffline after a failed live fetch). Drives
                // the bottom no-internet marquee strip.
                noInternet() { return !this.isOnline || this.patientsOffline; },

                // Snap History/Cancelled → Live (the only mode available offline)
                // and clear the mode-specific filters. Pure state change — does NOT
                // fetch; the caller decides whether to reload.
                _snapToLiveOffline() {
                    if (this.patientMode === 'live') return false;
                    this.patientMode = 'live';
                    this.patientsPage = 1;
                    this.filterDischargeReasonId = null;
                    this.dischargeReasonOptions = [];
                    this.patientModeOpen = false;
                    return true;
                },

                // Single connectivity probe: a tiny, SW-bypassing, session-free GET
                // to /api/ping. Ground truth for "is the backend reachable RIGHT
                // NOW", used everywhere instead of trusting navigator.onLine.
                //
                //   • ANY HTTP response (even 401/500) means the network + server
                //     are reachable → returns true. Only a thrown fetch (DNS/TCP/TLS
                //     failure or the timeout abort) means offline → returns false.
                //   • /api/ping does no DB or session work, so it answers in ~1ms;
                //     a stable connection can't look slow enough to read as offline.
                async _pingBackend(timeoutMs = 4000) {
                    try {
                        const ac = new AbortController();
                        const to = setTimeout(() => ac.abort(), timeoutMs);
                        try {
                            const resp = await fetch('./api/ping', {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' },
                                signal: ac.signal,
                            });
                            return !!resp;   // reachable, regardless of status code
                        } finally { clearTimeout(to); }
                    } catch (_) {
                        return false;        // network error / timeout → truly offline
                    }
                },

                // Should we drop into offline mode? navigator.onLine === false alone
                // is NOT trusted (it's false for seconds on a WebView cold start and
                // flaps on some networks). When navigator claims online we believe it
                // (a captive-portal / dead-backend case is caught later by the fetch
                // itself); only when it claims offline do we CONFIRM with a real
                // ping, so a healthy connection is never mistaken for offline.
                async _looksOffline() {
                    if (navigator.onLine !== false) return false;   // trust "online"
                    return !(await this._pingBackend(2500));        // confirm "offline"
                },

                // While the drawer is showing the offline cache, probe the server
                // for connectivity. On success, recover into online mode.
                async _probeConnectivityIfOffline() {
                    if (!this.patientsOffline) return;          // only while offline-cached
                    if (this._recovering) return;               // recovery already running
                    if (!(this.me && this.me.user_id)) return;  // need a session to refresh
                    if (await this._pingBackend(4000)) this._recoverOnline();
                },

                // Detect a SILENT loss of internet while the app still thinks it
                // is online — navigator.onLine stays true on a captive-portal /
                // WAN drop and no 'offline' event fires, so a fetch is the only
                // way to know. A short SW-bypassing GET to /api/me that fails
                // (twice, to avoid flapping on a single blip) flips the app into
                // offline-cached mode, which surfaces the no-internet marquee and
                // arms _probeConnectivityIfOffline() to auto-recover later.
                async _detectLostConnectivity() {
                    if (this.patientsOffline) return;       // already offline-cached
                    if (this._recovering || this._detecting) return;
                    if (!(this.me && this.me.user_id)) return;
                    this._detecting = true;
                    try {
                        // Require THREE consecutive failed pings (spaced ~1s apart) to
                        // declare offline. A single slow/dropped request no longer trips
                        // the banner — the frequent false "Offline" flashes on a stable
                        // connection came from flipping after just two back-to-back
                        // misses against the heavier /api/me (DB + session).
                        for (let i = 0; i < 3; i++) {
                            if (await this._pingBackend(4000)) {
                                // Reachable → still (or again) online. Also restores
                                // isOnline if a prior confirmed 'offline' event left it
                                // false and the 'online' event never fired to recover it
                                // (captive-portal / silent WAN recovery).
                                this.isOnline = true;
                                return;
                            }
                            if (i < 2) await new Promise((r) => setTimeout(r, 1000));
                        }
                        this.patientsOffline = true;        // surfaces the marquee + arms recovery
                        this.isOnline = false;
                        plog('warn', 'net', 'Lost backend connectivity (3 failed pings) — showing no-internet strip');
                    } finally {
                        this._detecting = false;
                    }
                },

                // Auto-shift from Offline (cached) back to live online mode. Called
                // by the browser `online` event AND the connectivity probe above.
                // Re-fetches every feed; a successful loadPatients() clears
                // patientsOffline (which unlocks History/Cancelled and drops the
                // "Offline (cached)" chip). Guarded so overlapping triggers
                // (event + probe firing together) only refresh once.
                async _recoverOnline() {
                    if (this._recovering) return;
                    this._recovering = true;
                    const wasOffline = this.patientsOffline;
                    try {
                        this.isOnline = true;
                        if (!(this.me && this.me.user_id)) return;
                        this.loadMasters();
                        this.loadCategories();
                        this.loadStamps();
                        // Awaited so we know whether the list actually came back
                        // online (clears patientsOffline) before toasting.
                        await this.loadPatients();
                        if (!this.patientsOffline) {
                            this.prefetchAllLivePatients();   // refresh the offline census
                            if (wasOffline) { this.showToast('Back online'); plog('info', 'net', 'Recovered to online mode'); }
                            // Upload anything the user saved while offline.
                            if (this.offlinePending > 0) this._flushWriteQueue();
                        }
                    } catch (_) {
                        // Probe said reachable but the refresh raced a flake — leave
                        // patientsOffline as-is; the next probe tick retries.
                    } finally {
                        this._recovering = false;
                    }
                },

                setPatientMode(mode) {
                    if (this.patientMode === mode) return;
                    // Permission (p_id 61): History / Cancelled are hidden for
                    // this user — Live is the only allowed mode. Belt-and-braces
                    // in case a switch is triggered outside the (hidden) buttons.
                    if (mode !== 'live' && this.me && this.me.hide_patient_modes) {
                        this.patientModeOpen = false;
                        return;
                    }
                    // Offline: only Live mode is available. History / Cancelled
                    // need the network (they aren't cached), so block the switch
                    // and tell the user instead of blanking the list / erroring.
                    if (mode !== 'live' && this.modesLocked()) {
                        this.showToast('History & Cancelled need internet — only Live is available offline', 'error');
                        this.patientModeOpen = false;
                        return;
                    }
                    this.patientMode = mode;
                    this.patientsPage = 1;
                    this.filterDischargeReasonId = null;
                    this.dischargeReasonOptions = [];
                    // Bed-list sort is Live-only; switch History/Cancelled
                    // back to the date sort so the UI stays consistent.
                    if (mode !== 'live' && this.filterSort === 'bed') {
                        this.filterSort = 'date';
                    }
                    if (mode === 'history' || mode === 'cancelled') {
                        this.loadDischargeReasons(mode);
                    }
                    if (this.me && this.me.user_id) {
                        this.loadPatients();
                    }
                },

                // Reset every secondary filter (location, care-team, payment,
                // discharge reason, dates, search, sort) and refetch. Mode
                // stays as-is so the user keeps their Live/History/Cancelled
                // context. Page resets to 1 via onFilterChange.
                resetFilters() {
                    this.filterFloorId = null;
                    this.filterDeptId = null;
                    this.filterWardIds = [];
                    this.filterUnitId = null;
                    this.filterConsultantIds = [];
                    this.filterOtherConsultantIds = [];
                    this.filterReasonIds = [];
                    this.filterDischargeReasonId = null;
                    this.filterPmode = null;
                    this.filterPmodeSub = null;
                    this.filterNoActivity = null;
                    this.pmodeSubOptions = [];
                    this.filterDateFrom = '';
                    this.filterDateTo = '';
                    this.patientSearch = '';
                    this.filterSort = 'date';
                    this.onFilterChange();
                },

                // GET /pwa/api/masters/discharge-reasons?mode=…
                // Loads the in-use reason list for the current bucket
                // (history → discharge reasons; cancelled → cancellation
                // reasons; nothing for live). Silent on failure — empty
                // options hide the dropdown via x-show.
                async loadDischargeReasons(mode) {
                    try {
                        const resp = await fetch('./api/masters/discharge-reasons?mode=' + encodeURIComponent(mode), {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) return;
                        const data = await resp.json();
                        this.dischargeReasonOptions = Array.isArray(data && data.items) ? data.items : [];
                    } catch (_) { /* silent */ }
                },

                // Label that swaps with the active mode.
                dischargeReasonLabel() {
                    return this.patientMode === 'cancelled' ? 'Cancellation Reason' : 'Discharge Reason';
                },


                // Floor / Department / Ward / Unit / Consultant / Admission-Type
                // filter lists. Two phases so app startup NEVER waits on the
                // network for these masters:
                //   1. hydrate — apply the last cached snapshot from IDB to the
                //      dropdowns IMMEDIATELY (a local read, no network).
                //   2. background refresh — fetch the live masters off the startup
                //      critical path; when they land, swap them onto the screen
                //      and re-snapshot the cache.
                // The dropdowns therefore appear instantly from cache on every
                // start and silently upgrade to fresh data once the background
                // reply arrives. A cold first-run (empty cache) simply shows
                // nothing until that first refresh completes — expected.
                async loadMasters() {
                    // Phase 1 — instant hydrate from the offline cache.
                    await this._hydrateMastersFromCache();
                    // Phase 2 — refresh from the network as a background task so
                    // it doesn't compete with the initial patient-list load. Runs
                    // when the browser is idle (bounded by a short timeout so it
                    // still happens promptly on a busy main thread).
                    const bg = () => this._refreshMastersFromNetwork();
                    if (typeof requestIdleCallback === 'function') {
                        requestIdleCallback(bg, { timeout: 3000 });
                    } else {
                        setTimeout(bg, 0);
                    }
                },

                // Apply the cached masters snapshot to the filter dropdowns. Safe
                // on every startup; a miss (cold first-run) leaves the current
                // (empty) options untouched so the background refresh can fill them.
                async _hydrateMastersFromCache() {
                    try {
                        const c = await idbKvGet(this._mastersCacheKey());
                        if (c) {
                            this.floorOptions         = c.floors   || [];
                            this.deptOptions          = c.depts    || [];
                            this.wardOptions          = c.wards    || [];
                            this.unitOptions          = c.units    || [];
                            this.consultantOptions    = c.cons     || [];
                            this.admissionTypeOptions = c.admTypes || [];
                        }
                    } catch (_) { /* leave existing options */ }
                },

                // Background master refresh: fetch the live lists, then swap them
                // onto the screen and re-snapshot the cache. On a total failure
                // (offline) it does nothing — the cache hydrate already populated
                // the dropdowns. De-duped via _mastersRefreshing so overlapping
                // triggers (startup + online-recovery) don't double-fetch.
                async _refreshMastersFromNetwork() {
                    if (this._mastersRefreshing) return;
                    this._mastersRefreshing = true;
                    try {
                        // Returns the items array on success, or null on ANY failure
                        // (so we can tell "server says empty" from "couldn't reach the
                        // server" — the latter must NOT overwrite good cached lists).
                        const fetchMaster = async (path) => {
                            try {
                                const resp = await fetch('./api/masters/' + path, {
                                    credentials: 'same-origin',
                                    cache: 'no-store',
                                    headers: { 'Accept': 'application/json' },
                                });
                                if (resp.status === 401) { window.location.assign('./login'); return null; }
                                if (!resp.ok) return null;
                                const data = await resp.json();
                                return Array.isArray(data && data.items) ? data.items : [];
                            } catch (_) { return null; }
                        };
                        // Other Consultants binds to the same list as Consultants
                        // (both are "any active doctor for this hospital") — fetch
                        // once and share via consultantOptions to save a round-trip.
                        const results = await Promise.all([
                            fetchMaster('floors'),
                            fetchMaster('departments'),
                            fetchMaster('wards'),
                            fetchMaster('units'),
                            fetchMaster('consultants'),
                            fetchMaster('admission-types'),
                        ]);
                        // Only overwrite the (cache-hydrated) options when at least
                        // one call actually reached the server — otherwise a transient
                        // offline blip would wipe good cached lists with empties.
                        if (results.some(r => r !== null)) {
                            const [floors, depts, wards, units, cons, admTypes] =
                                results.map(r => Array.isArray(r) ? r : []);
                            this.floorOptions         = floors;
                            this.deptOptions          = depts;
                            this.wardOptions          = wards;
                            this.unitOptions          = units;
                            this.consultantOptions    = cons;
                            this.admissionTypeOptions = admTypes;
                            idbKvSet(this._mastersCacheKey(), { floors, depts, wards, units, cons, admTypes }).catch(() => {});
                        }
                    } finally {
                        this._mastersRefreshing = false;
                    }
                },

                // Any of the filter dropdowns changed — refetch the patient
                // list with the new constraints. Reset page=1 so the new
                // filter starts from the top.
                //
                // CRITICAL: normalise every filter value before refetching.
                // Alpine's `x-model.number` on a `<option :value="null">All</option>`
                // produces NaN (parseFloat(null) = NaN), and NaN sneaks past
                // the strict-null URL-param check for pmode/pmode_sub —
                // resulting in `?pmode=NaN`, which the server's `integer`
                // validation rejects with 422, the catch block leaves the
                // stale filtered list on screen, and the user sees "only the
                // last filtered record" because the reset never reached the
                // wire. Coercing NaN/'' → null here makes the reset clean.
                onFilterChange() {
                    this._normalizeFilters();
                    this.patientsPage = 1;
                    if (this.me && this.me.user_id) {
                        this.loadPatients();
                    }
                },

                // Defensive: coerce any filter-state value that should be
                // "no filter" into a literal null. Catches NaN (from .number
                // on a null option), empty strings, and undefined.
                _normalizeFilters() {
                    const norm = (v) => {
                        if (v === null || v === undefined || v === '') return null;
                        if (typeof v === 'number' && Number.isNaN(v))   return null;
                        return v;
                    };
                    const normIds = (arr) => {
                        if (!Array.isArray(arr)) return [];
                        const out = [];
                        arr.forEach((v) => {
                            const n = Math.trunc(Number(v));
                            if (Number.isFinite(n) && n >= 1 && !out.includes(n)) out.push(n);
                        });
                        return out;
                    };
                    this.filterFloorId            = norm(this.filterFloorId);
                    this.filterDeptId             = norm(this.filterDeptId);
                    this.filterUnitId             = norm(this.filterUnitId);
                    // Multi-select arrays: keep only finite positive ints and
                    // drop duplicates so a garbage toggle can't leak a NaN/dup
                    // into the ward_id[] / consultant_id[] / reason_id[] params.
                    this.filterWardIds            = normIds(this.filterWardIds);
                    this.filterConsultantIds      = normIds(this.filterConsultantIds);
                    this.filterOtherConsultantIds = normIds(this.filterOtherConsultantIds);
                    this.filterReasonIds          = normIds(this.filterReasonIds);
                    this.filterPmode              = norm(this.filterPmode);
                    this.filterPmodeSub           = norm(this.filterPmodeSub);
                    this.filterDischargeReasonId  = norm(this.filterDischargeReasonId);
                    // Dates are strings; map null/undefined to '' so the
                    // <input type="date"> binding stays valid.
                    if (this.filterDateFrom === null || this.filterDateFrom === undefined) this.filterDateFrom = '';
                    if (this.filterDateTo   === null || this.filterDateTo   === undefined) this.filterDateTo   = '';
                },

                // Payment-type dropdown changed. Reset the cascading sub
                // value, fetch the matching sub-master (Cash types / TPA
                // list / Insurance companies / Scheme names / Corporate
                // types / Credit cos.), then refetch the patient list.
                // All (null) and Package (6 — master not wired) skip the fetch.
                async onPmodeChange() {
                    this.filterPmodeSub = null;
                    this.pmodeSubOptions = [];
                    const p = this.filterPmode;
                    const hasSub = (p === 0 || p === 1 || p === 2 || p === 3 || p === 4 || p === 5);
                    if (hasSub) {
                        this.pmodeSubLoading = true;
                        try {
                            const resp = await fetch('./api/masters/pmode-sub?pmode=' + encodeURIComponent(p), {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' },
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return; }
                            if (resp.ok) {
                                const data = await resp.json();
                                this.pmodeSubOptions = Array.isArray(data && data.items) ? data.items : [];
                            }
                        } catch (_) { /* silent */ }
                        finally { this.pmodeSubLoading = false; }
                    }
                    this.onFilterChange();
                },

                // Label shown above the sub-mode dropdown. Matches the
                // user's payment-type ordering, not the pmode numeric value.
                pmodeSubLabel() {
                    return ({
                        0: 'Cash Type',
                        1: 'TPA Provider',
                        2: 'Scheme',
                        3: 'Insurance Co.',
                        4: 'Corporate',
                        5: 'Reimbursement Co.',
                    })[this.filterPmode] || '';
                },

                // Returns the Tailwind class string for one patient card.
                // Each row is a rounded, bordered card (see the button markup);
                // here we set the body fill and the left-edge accent colour,
                // which is keyed to the PAYMENT MODE (pmode) so the funding
                // type is glanceable. The selected card adds a slate tint and a
                // teal ring, but KEEPS its pmode left edge.
                //
                // Class strings are full literals so Tailwind's CDN JIT picks
                // them up when scanning this file — concatenated class names
                // like `border-l-${x}` would not be detected.
                patientRowClass(p) {
                    const left   = this.pmodeLeftBorder(p);
                    const isSel  = (p && p.id === this.selectedPatientId);
                    // WhatsApp-style list items: white rows with WhatsApp's light
                    // hover (#f5f6f6) and selected (#f0f2f5) greys — no selection
                    // ring, matching WhatsApp.
                    const body   = isSel
                        ? 'bg-[#f0f2f5]'
                        : 'bg-white hover:bg-[#f5f6f6]';
                    return body + ' ' + left;
                },

                // Left-edge border colour by payment mode (mst_patient.pmode):
                //   0 Cash          → transparent (no funding accent)
                //   1 TPA           → red
                //   2 Scheme        → green
                //   3 Insurance     → blue
                //   4 Corporate     → pink
                //   5 Reimbursement → orange
                //   6 Package       → brown
                // Unknown/blank falls back to transparent.
                pmodeLeftBorder(p) {
                    return ({
                        '0': 'border-l-transparent',
                        '1': 'border-l-red-500',
                        '2': 'border-l-green-500',
                        '3': 'border-l-blue-500',
                        '4': 'border-l-pink-500',
                        '5': 'border-l-orange-500',
                        '6': 'border-l-[#8B4513]',
                    })[String((p && p.pmode) ?? '').trim()] || 'border-l-transparent';
                },

                // Insurance/claim workflow status → chip label. 0 (and any
                // code without a label) renders nothing. Codes per spec.
                _CLAIM_LABELS: {
                    1:  'Claim Query Raised',
                    2:  'Claim Under Process',
                    3:  'Claim Initial Approval',
                    4:  'Claim Approved',
                    5:  'Query 1',
                    6:  'Query 1 solved',
                    7:  'Query 2',
                    8:  'Query 2 solved',
                    9:  'Claim Pre-Authorization',
                    10: 'Claim Query Updated',
                    11: 'Pre Authorization Approved',
                    12: 'Discharged',
                    13: 'Claim Initiated',
                    14: 'Claim Approved',
                    15: 'Payment Done',
                    16: 'Claim Rejected',
                },
                claimLabel(status) {
                    return this._CLAIM_LABELS[parseInt(status, 10)] || '';
                },
                // Approved / paid states (4, 11, 15) are green; every other
                // labelled state is red.
                claimBg(status) {
                    const s = parseInt(status, 10);
                    return (s === 4 || s === 11 || s === 15) ? '#81C784' : '#E57373';
                },

                // Highlight classes for a filter <select>: teal fill + border
                // when a non-default value is selected, neutral slate otherwise.
                // Drives the "show which filters are active" affordance now that
                // the field labels are gone.
                filterSelectClass(active) {
                    return active
                        ? 'border-teal-500 bg-teal-50 text-teal-800 font-medium ring-1 ring-teal-200'
                        : 'border-slate-300 bg-white text-slate-700';
                },

                // Toggle one id in a multi-select filter array (Ward /
                // Consultant / Other Consultant / Admission Type), then refetch
                // via onFilterChange (which also de-dupes + normalises the
                // array). The dropdown stays open so the user can pick several
                // in a row — click-outside (or the trigger) closes it.
                toggleFilterId(field, id) {
                    const n = Math.trunc(Number(id));
                    if (!Number.isFinite(n) || n < 1) return;
                    const arr = Array.isArray(this[field]) ? this[field] : [];
                    const i = arr.indexOf(n);
                    if (i === -1) { arr.push(n); } else { arr.splice(i, 1); }
                    this[field] = arr;
                    this.onFilterChange();
                },

                // Trigger label for a multi-select dropdown:
                //   none picked → "All {plural}"  (matches the old first option)
                //   one picked  → that option's name
                //   many picked → "{singular} (N)"
                multiLabel(ids, options, singular) {
                    const arr = Array.isArray(ids) ? ids : [];
                    if (arr.length === 0) return 'All ' + singular;
                    if (arr.length === 1) {
                        const opt = (options || []).find((o) => Number(o.id) === Number(arr[0]));
                        return opt ? opt.name : (singular + ' (1)');
                    }
                    return singular + ' (' + arr.length + ')';
                },

                // Case-insensitive option filter for a searchable dropdown.
                // Empty/blank term returns the full list unchanged.
                filterOptions(options, term) {
                    const list = Array.isArray(options) ? options : [];
                    const t = String(term || '').trim().toLowerCase();
                    if (t === '') return list;
                    return list.filter((o) => String(o.name || '').toLowerCase().includes(t));
                },

                // Patient-name colour by gender (mst_patient.gender):
                //   '1' = Male   → blue
                //   '2' = Female → pink
                //   else ('3'/Other/blank) → purple
                patientNameColor(p) {
                    const g = String((p && p.gender) || '').trim();
                    if (g === '1') return 'text-blue-600';
                    if (g === '2') return 'text-pink-600';
                    return 'text-purple-600';
                },

                // Gender/age pill colour by gender (mst_patient.gender) — text,
                // background, and border kept in step:
                //   '1' = Male   → blue
                //   '2' = Female → pink
                //   else ('3'/Other/blank) → purple
                genderPillClass(p) {
                    const g = String((p && p.gender) || '').trim();
                    if (g === '1') return 'bg-blue-50 text-blue-600 border-blue-100';
                    if (g === '2') return 'bg-pink-50 text-pink-600 border-pink-100';
                    return 'bg-purple-50 text-purple-600 border-purple-100';
                },

                // Gender code ('1'/'2'/'3') → label for the header. Blank gender
                // returns '' so the header can hide it.
                genderLabel(g) {
                    const v = String(g || '').trim();
                    if (v === '1') return 'Male';
                    if (v === '2') return 'Female';
                    if (v === '3') return 'Other';
                    return '';
                },

                // A patient is "flagged" when any clinical alert applies —
                // MLC (medico-legal), allergic, or universal precaution. Drives
                // the light-red highlight on the IPD/UHID pills and the name.
                isFlagged(p) {
                    return !!(p && (p.mlc || p.allergic || p.precautive));
                },

                // "Floor - Department - Ward" for the patient card, skipping
                // any segment the tenant hasn't set (blank floor/dept/ward).
                floorDeptWard(p) {
                    return [p && p.floor, p && p.department, p && p.ward]
                        .map(v => (v == null ? '' : String(v).trim()))
                        .filter(v => v !== '')
                        .join(' - ');
                },

                // Floor · Department · Bed, joined with a middle dot — the plain-text
                // line shown under the consultant on the card (ward is shown on its
                // own line beneath it).
                floorDeptBed(p) {
                    return [p && p.floor, p && p.department, p && p.bed]
                        .map(v => (v == null ? '' : String(v).trim()))
                        .filter(v => v !== '')
                        .join(' · ');
                },

                // Floor · Department · Ward (no bed) — the bed name is rendered
                // separately so it can be shown bold, joined with a "-" suffix.
                // Ward now sits inline in this sequence instead of on its own line.
                floorDept(p) {
                    return [p && p.floor, p && p.department, p && p.ward]
                        .map(v => (v == null ? '' : String(v).trim()))
                        .filter(v => v !== '')
                        .join(' · ');
                },

                // Consulting doctor for the card: name shown EXACTLY as stored in
                // the master (no "Dr." stripping), with the consultant's unit in
                // ( ) braces appended when present (mirrors the patient header).
                docName(p) {
                    const name = String((p && p.doctor) || '').trim();
                    if (!name) return '';
                    const unit = String((p && p.consultant_unit) || '').trim();
                    return unit ? (name + ' (' + unit + ')') : name;
                },

                // GET /pwa/api/categories — mst_category rows for the session's
                // hospital_id with the user's per-cat permission gate applied.
                // Server returns the same shape the demo FORM_CATEGORIES uses
                // (i / label / count / color / colorHex / bgHex / locked) so
                // the existing row + viewer renderers don't change.
                async loadCategories() {
                    this.categoriesLoading = true;
                    this.categoriesError = '';
                    try {
                        const resp = await fetch('./api/categories', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) {
                            window.location.assign('./login');
                            return;
                        }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        const list = Array.isArray(data && data.categories) ? data.categories : [];
                        // Snapshot the raw list (keyed by hospital) so a later
                        // OFFLINE cold-start can restore it (see the catch below).
                        this._persistCategories(this.me && this.me.hospital_id, list);
                        this.categoriesOffline = false;
                        // Swap in the live list, prefixed with the synthetic
                        // "All IPD Categories" row at ordinal 0. Its badge shows
                        // the patient's TOTAL saved pages across every category
                        // (allCategoriesCount(), reactive) and opening it
                        // aggregates all pages in category-display order. The
                        // server list is already ordered by category_position
                        // with i = 1..N, so prefixing i:0 keeps the "0, 1, 2…"
                        // numbering intact. _recomputeCategoryCountsForCurrentPatient
                        // is run elsewhere when a patient is picked, so counts
                        // stay accurate against whichever patient is selected.
                        this.categories = [this._makeAllCategoryRow(), ...list];
                        this.categoriesLive = true;
                        // Ensure the WHOLE hospital form set is stored offline:
                        // check each category's template against IndexedDB and
                        // download the missing ones (cached ones cost no network).
                        // `track:true` drives the footer progress badge. Revoke
                        // the previous load's blob URLs first.
                        //
                        // Deferred to idle: this walks EVERY category, hits
                        // IndexedDB per row and downloads templates two at a
                        // time. Run inline it competes with the drawer's first
                        // paint for the main thread. Same background-task shape
                        // loadMasters() uses for its network refresh — the short
                        // timeout keeps it prompt on a busy thread.
                        this._revokeCatImageUrls();
                        this._prefetchFormsWhenIdle(this.categories);
                        // Drop any stale per-patient record cache that was
                        // keyed to demo cat ids; counts re-derive on next
                        // patient selection.
                        this._patientRecords = {};

                        // Race-safe: if a patient is already selected (likely
                        // because loadPatients() finished before this), fetch
                        // their per-category counts now so the badges populate.
                        // The earlier counts-fetch in loadPatients() short-
                        // circuits when categoriesLive is false, so we own
                        // the responsibility here.
                        if (this.selectedPatientId) {
                            this.loadPatientCategoryCounts(this.selectedPatientId);
                        }
                    } catch (e) {
                        // Network failed (offline / server down). Fall back to the
                        // last cached category list so the drawer still works —
                        // the template images come from IndexedDB via
                        // prefetchCategoryForms → cacheCategoryImage's offline path.
                        // Per-patient counts need the network, so badges stay at 0.
                        const cached = this._loadCachedCategories(this.me && this.me.hospital_id);
                        if (Array.isArray(cached) && cached.length) {
                            this.categories = [this._makeAllCategoryRow(), ...cached];
                            this.categoriesLive = true;
                            this.categoriesOffline = true;
                            this.categoriesError = '';
                            this._revokeCatImageUrls();
                            this._prefetchFormsWhenIdle(this.categories);
                            this._patientRecords = {};
                        } else {
                            this.categoriesError = String(e && e.message || e);
                        }
                    } finally {
                        this.categoriesLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // ── actions ──
                selectPatient(p) {
                    // Leaving an unsaved edit? Ask to save/discard first.
                    if (this._guardEditExit(() => this.selectPatient(p))) return;
                    // Changing patient → reset to a FRESH main screen (like a fresh
                    // app open): close every main pane, drop the open form +
                    // category selection, and snap the right drawer back to its
                    // first tab (Hand Written).
                    this.docViewOpen = false;   // close any open documents grid
                    this.webOpen = false;       // and any embedded web page
                    this.pdfOpen = false;       // and any floating PDF viewer
                    this.viewerOpen = false;    // and the form-page viewer
                    this.viewerMode = 'grid';
                    this.viewerCategory = null;
                    this.viewerRecords = [];
                    this.viewerActiveRecord = null;
                    this.viewerActiveIndex = 0;
                    this.activeTab = 'hand-written';   // right drawer → first tab
                    this.activeDoc = '';
                    this.selectedCategoryIndex = null; // drop past selection position
                    this.selectedCategoryLabel = '';
                    // Back to the first page of category rows — a new patient
                    // changes which disabled categories qualify (count > 0), and
                    // the user should not land part-way down a list they never
                    // scrolled. Also keeps the drawer's first paint to one page.
                    this.resetCategoryWindow();
                    // NOTE: patientDetailsOpen is intentionally NOT reset here. It
                    // defaults to FOLDED (collapsed); once the user expands or folds
                    // it, that choice persists across patient switches / page opens —
                    // it only opens/collapses when the user does it themselves.
                    this.selectedPatientId = p.id;
                    this.selectedPatient = p;
                    this.patientName = p.name;
                    this.patientUhid = p.uhid;
                    this.patientIp   = p.ipd;
                    // Hand off from the patient list to the categories drawer.
                    this.leftOpen  = false;
                    this.rightOpen = true;
                    // Refresh category counts to reflect THIS patient's pages.
                    // Live mode: fetch from /api/patients/{id}/category-counts.
                    // Demo mode: read from the in-memory _patientRecords store.
                    if (this.patientsLive) {
                        this.loadPatientCategoryCounts(p.id);
                    } else {
                        this._recomputeCategoryCountsForCurrentPatient();
                    }
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // ── Patient Details modal ──
                // Opened by tapping a card avatar. Read-only floating view of one
                // patient; does NOT change the selected patient or the main panes.
                openPatientDetailsModal(p) {
                    if (!p) return;
                    this.detailPatient = p;
                    this.patientDetailsModalOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                closePatientDetailsModal() {
                    this.patientDetailsModalOpen = false;
                    this.detailPatient = null;
                },

                // ── Bed-transfer / Consultant history sub-modal ──
                openBedTransferHistory() {
                    this._openHistory('bed', 'Bed Transfer History',
                        './api/patients/' + encodeURIComponent(this.detailPatient && this.detailPatient.id) + '/bed-transfer-history');
                },
                openConsultantHistory() {
                    this._openHistory('consultant', "Consultant's History",
                        './api/patients/' + encodeURIComponent(this.detailPatient && this.detailPatient.id) + '/consultant-history');
                },
                async _openHistory(kind, title, url) {
                    if (!(this.detailPatient && this.detailPatient.id)) return;
                    this.historyKind    = kind;
                    this.historyTitle   = title;
                    this.historyItems   = [];
                    this.historyError   = '';
                    this.historyLoading = true;
                    this.historyModalOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    try {
                        const resp = await fetch(url, {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.historyItems = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        this.historyError = 'Could not load history';
                    } finally {
                        this.historyLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },
                closeHistoryModal() {
                    this.historyModalOpen = false;
                    this.historyItems = [];
                },

                // Absolute IPD URL built from APP_URL (me.app_url — carries the
                // /v1/ipd prefix), so the deployment host is never hardcoded. Pass
                // a leading-slash path like '/cms/digital-nursing'. Falls back to
                // the prod host only if the session (me) hasn't resolved yet.
                _ipdUrl(path) {
                    const base = (this.me && this.me.app_url) || 'https://prescoipd.com/v1/ipd';
                    return base + (path || '');
                },

                // Edit patient record — open the IPD edit-patient page in its own
                // individual full floating screen (the z-[98] iframe overlay used
                // by the Settings drawer), NOT the shared main pane. Keeps the
                // patient list untouched behind it; the window's close/Esc returns.
                editPatientRecord(p) {
                    if (!p || !p.id) return;
                    // Application-tool permission (p_id 83; roles 1/2/10 bypass).
                    if (!(this.me && this.me.can_edit_patient)) {
                        this.showToast('You have not authority to Edit Patient Record.', 'error');
                        return;
                    }
                    // Editing needs the live IPD page — blocked with no network.
                    if (!this.isOnline || navigator.onLine === false) {
                        this.showToast('Check Your Internet Connection, You cannot edit this page. Might have no Internet Connection.', 'error');
                        return;
                    }
                    // Open the floating window WITHOUT selecting the patient — the
                    // form is self-contained (URL carries patient_id), and calling
                    // selectPatient() here would pop the right categories drawer.
                    // URL = APP_URL + '/cms/edit-patient-details?patient_id=<id>'.
                    const url = this._ipdUrl('/cms/edit-patient-details')
                        + '?patient_id=' + encodeURIComponent(p.id);
                    this._openExternal(url, 'Edit Patient');
                },

                // Discharge patient — open the IPD discharge-form page in its own
                // individual full floating screen (same z-[98] overlay as Edit).
                // The URL base is APP_URL from env (me.app_url, carries /v1/ipd),
                // so the host is never hardcoded. Blocked offline (live CMS page).
                dischargePatient(p) {
                    if (!p || !p.id) return;
                    // Application-tool permission (p_id 79; roles 1/2/10 bypass).
                    if (!(this.me && this.me.can_discharge_patient)) {
                        this.showToast('You have not authority to Discharge Patient.', 'error');
                        return;
                    }
                    if (!this.isOnline || navigator.onLine === false) {
                        this.showToast('Check Your Internet Connection, You cannot discharge this patient. Might have no Internet Connection.', 'error');
                        return;
                    }
                    // Open the floating window WITHOUT selecting the patient — the
                    // form is self-contained (URL carries patient_id), and calling
                    // selectPatient() here would pop the right categories drawer.
                    const hospitalId = (this.me && this.me.hospital_id) || '';
                    const url = this._ipdUrl('/cms/patient/discharge-form')
                        + '?patient_id=' + encodeURIComponent(p.id)
                        + '&hospital_id=' + encodeURIComponent(hospitalId);
                    this._openExternal(url, 'Discharge Patient');
                },

                // Exchange Bed (Settings-drawer menu) — open the IPD bed-exchange
                // page in the floating full-screen window (z-[98] iframe overlay),
                // same as Edit / Discharge. Base is APP_URL from env (me.app_url),
                // never a hardcoded host. The menu item is not patient-scoped, so
                // patient_id carries the currently selected patient when there is
                // one and stays empty otherwise (the CMS page then picks the
                // patient itself); hospital_id comes from the session.
                openExchangeBed() {
                    // Live CMS page — unusable with no network.
                    if (!this.isOnline || navigator.onLine === false) {
                        this.showToast('Check Your Internet Connection, You cannot exchange bed. Might have no Internet Connection.', 'error');
                        return;
                    }
                    const patientId  = this.selectedPatientId || '';
                    const hospitalId = (this.me && this.me.hospital_id) || '';
                    const url = this._ipdUrl('/cms/patient/exchange-bed')
                        + '?patient_id=' + encodeURIComponent(patientId)
                        + '&hospital_id=' + encodeURIComponent(hospitalId);
                    this._openExternal(url, 'Exchange Bed');
                },

                // GET /pwa/api/patients/{id}/category-counts — count of saved
                // form pages per cat_id, used to render the red "(N)" badges
                // in the right drawer. Silent on failure (counts stay at 0).
                async loadPatientCategoryCounts(patientId) {
                    if (!patientId) return;
                    // Drop the previous patient's counts BEFORE anything async
                    // starts. The payment-category fetch below seeds its badges
                    // from this map, and now that the two run concurrently it can
                    // resolve first — without the reset it would briefly paint the
                    // last patient's numbers on this patient's payment forms.
                    this._latestCategoryCounts = {};
                    this._latestCategoryLocks  = {};
                    // Fire the payment-mode forms NOW, alongside the counts fetch
                    // rather than after it. These are two independent endpoints;
                    // chaining them made the drawer's wall time counts + payments
                    // ADDED instead of whichever is slower. They are already
                    // written to land in either order (each applies the shared
                    // counts map when it arrives — last writer wins), so running
                    // them concurrently needs no other change.
                    this.loadPatientPaymentCategories(patientId);
                    // Offline, the /category-counts endpoint is unreachable and
                    // leaving the badges untouched would show the PREVIOUS
                    // patient's counts. Rebuild them from local data (cached page
                    // lists + the offline write queue) so the drawer is per-patient
                    // correct without a manual category refresh.
                    if (navigator.onLine === false) {
                        await this._recomputeOfflineCategoryCounts(patientId);
                        return;
                    }
                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(patientId) + '/category-counts', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) return;
                        const data = await resp.json();
                        const counts = (data && data.counts) || {};
                        const locks  = (data && data.locks)  || {};
                        // Cache the latest counts so loadPatientPaymentCategories
                        // can apply them to payment rows when they arrive (the
                        // two endpoints land in either order — last writer wins
                        // on count assignment, both look at the same map).
                        this._latestCategoryCounts = counts;
                        this._latestCategoryLocks  = locks;
                        // Gallery|Labs doc-button badges — virtual upload buckets.
                        this.docCounts.other      = counts[1993] || 0;
                        this.docCounts.lab        = counts[1994] || 0;
                        this.docCounts.bill       = counts[1997] || 0;
                        this.docCounts.radiology  = counts[1998] || 0;
                        this.docCounts.cardiology = counts[1999] || 0;
                        this.docCounts.audio      = counts[1991] || 0;
                        this.docCounts.video      = counts[1992] || 0;
                        // Operative Notes badge — count of tbl_operative_notes_details
                        // rows for this patient (separate key, not a cat_id bucket).
                        this.docCounts.operative  = (data && data.operative_count) || 0;
                        // Discharge Summary badge — count of tbl_discharge_summary
                        // rows; also decides web-form vs preview-PDF on click.
                        this.docCounts.discharge  = (data && data.discharge_count) || 0;
                        // Apply by cat.id (live data path); leave demo cats untouched.
                        this.categories.forEach((cat) => {
                            if (cat.id !== undefined && cat.id !== null) {
                                cat.count = counts[cat.id] || 0;
                                cat.isLocked = !!locks[cat.id];
                            }
                        });
                        // Payment categories may already be loaded — apply
                        // counts to them too so the badges stay consistent.
                        this.paymentCategories.forEach((cat) => {
                            if (cat.id !== undefined && cat.id !== null) {
                                cat.count = counts[cat.id] || 0;
                            }
                        });
                    } catch (_) {
                        // Request failed mid-flight (dropped offline / server
                        // unreachable) — same stale-count risk as a cold offline
                        // start, so rebuild the badges from local data.
                        await this._recomputeOfflineCategoryCounts(patientId);
                    }
                    // Counts just changed, so disabled categories with pages may
                    // have become visible — re-render their Lucide icons (the
                    // "Restricted" ban + any lock) now that the rows exist.
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    // (loadPatientPaymentCategories was fired at the top of this
                    // method so the two requests overlap — see the note there.)
                },

                // Loads the patient's payment-mode forms (TPA / Insurance /
                // Scheme / Corporate). Empty = section stays hidden. Called
                // from the same hook that loads category counts so the drawer
                // stays consistent.
                async loadPatientPaymentCategories(patientId) {
                    if (!patientId) {
                        this.paymentCategories      = [];
                        this.paymentCategoriesLabel = '';
                        return;
                    }
                    this.paymentCategoriesLoading = true;
                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(patientId) + '/payment-categories', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) {
                            this.paymentCategories      = [];
                            this.paymentCategoriesLabel = '';
                            return;
                        }
                        const data = await resp.json();
                        this.paymentCategories      = Array.isArray(data && data.items) ? data.items : [];
                        this.paymentCategoriesLabel = (data && data.pmodeLabel) || '';
                        // Payment forms (hospital_id = 0) are LIVE-INTERNET ONLY —
                        // never prefetched/cached offline (they render straight from
                        // the presigned bgUrl; cacheCategoryImage also skips them).
                        // Inherit counts if loadPatientCategoryCounts already
                        // ran for this patient — the counts map covers every
                        // cat_id the patient has saved pages for, regardless
                        // of which list it lands in.
                        const counts = this._latestCategoryCounts || {};
                        const locks  = this._latestCategoryLocks  || {};
                        this.paymentCategories.forEach((cat) => {
                            if (cat.id !== undefined && cat.id !== null) {
                                cat.count = counts[cat.id] || 0;
                                cat.isLocked = !!locks[cat.id];
                            }
                        });
                    } catch (_) {
                        this.paymentCategories      = [];
                        this.paymentCategoriesLabel = '';
                    } finally {
                        this.paymentCategoriesLoading = false;
                    }
                },

                _recomputeCategoryCountsForCurrentPatient() {
                    const recs = this._patientRecords[this.selectedPatientId] || {};
                    this.categories.forEach((cat) => {
                        const list = recs[cat.i] || [];
                        cat.count = list.length;
                    });
                    // Local records don't track the virtual upload buckets
                    // (1993/1994/1997/1998/1999); clear them so a previous live
                    // patient's count can't linger.
                    this.docCounts.other = 0;
                    this.docCounts.lab = 0;
                    this.docCounts.bill = 0;
                    this.docCounts.radiology = 0;
                    this.docCounts.cardiology = 0;
                    this.docCounts.audio = 0;
                    this.docCounts.video = 0;
                    this.docCounts.operative = 0;
                    this.docCounts.discharge = 0;
                },

                // Offline per-patient category counts. The live /category-counts
                // endpoint needs the network; offline we rebuild each badge from
                // local data so a patient switch shows THIS patient's counts (not
                // the previously-selected patient's lingering values):
                //   base  = last-cached server page list per category
                //           (pages:{pid}:{cid}, only for categories opened online)
                //   delta = the offline write queue for this patient
                //           (queued create +1, delete -1; an in-place update of an
                //            existing page doesn't change the count)
                // Categories with no local data read 0 (server counts are
                // unavailable offline) — matching the "badges sit at 0 offline"
                // rule, but now correctly scoped to the selected patient and
                // including anything saved offline.
                async _recomputeOfflineCategoryCounts(patientId) {
                    if (!patientId) return;
                    const base = {};   // catId -> count

                    // Base from cached server page lists (categories opened online).
                    const cats = (this.categories || []).filter(c => c && c.id != null && !c.isAll);
                    await Promise.all(cats.map(async (c) => {
                        try {
                            const cached = await idbKvGet(this._pagesCacheKey(patientId, c.id));
                            if (cached && Array.isArray(cached.pages)) base[c.id] = cached.pages.length;
                        } catch (_) { /* ignore */ }
                    }));

                    // Apply offline write-queue deltas for this patient.
                    let items = [];
                    try { items = await idbGetAll(STORE_WRITE_Q); } catch (_) { items = []; }
                    (items || []).forEach((it) => {
                        if (!it || String(it.patientId) !== String(patientId) || it.catId == null) return;
                        if (it.op === 'create')      base[it.catId] = (base[it.catId] || 0) + 1;
                        else if (it.op === 'delete')  base[it.catId] = Math.max(0, (base[it.catId] || 0) - 1);
                        // 'update' overwrites an existing page in place — no change.
                    });

                    // Assign; categories/payment rows with no local data read 0.
                    this.categories.forEach((cat) => {
                        if (cat.id != null && !cat.isAll) cat.count = base[cat.id] || 0;
                    });
                    this.paymentCategories.forEach((cat) => {
                        if (cat.id != null) cat.count = base[cat.id] || 0;
                    });
                    // Virtual doc buckets (1993/1994/1997/1998/1999/1991/1992) and
                    // operative/discharge can't be counted offline — clear them so a
                    // previous patient's badges don't linger.
                    this.docCounts.other = 0;      this.docCounts.lab = 0;
                    this.docCounts.bill = 0;       this.docCounts.radiology = 0;
                    this.docCounts.cardiology = 0; this.docCounts.audio = 0;
                    this.docCounts.video = 0;      this.docCounts.operative = 0;
                    this.docCounts.discharge = 0;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Synthetic "All IPD Categories" row (ordinal 0). No real
                // cat_id — `isAll` flags it so openCategory() aggregates pages
                // instead of hitting one category endpoint, and the badge uses
                // allCategoriesCount() instead of a stored count.
                _makeAllCategoryRow() {
                    return {
                        i: 0,
                        id: null,
                        isAll: true,
                        label: 'All IPD Categories',
                        count: 0,
                        color: null,
                        colorHex: null,
                        bgHex: null,
                        bgUrl: '',
                        locked: false,
                        code: '',
                    };
                },

                // Total saved pages for the current patient across every real
                // category (excludes the synthetic All row). Reactive — reads
                // each category's `count`, so the All badge updates live as
                // counts load or pages are saved/deleted elsewhere.
                allCategoriesCount() {
                    return this.categories.reduce(
                        (sum, c) => sum + (c.isAll ? 0 : (parseInt(c.count, 10) || 0)),
                        0
                    );
                },

                // Per-page category context for the viewer. In the All view
                // each page carries its own category's template/colour/label
                // (tagged in loadAllCategoryPages); otherwise everything comes
                // from the single open viewerCategory.
                recCatBgUrl(rec) {
                    if (this.viewerCategory && this.viewerCategory.isAll) return (rec && rec.catBgUrl) || '';
                    return (this.viewerCategory && this.viewerCategory.bgUrl) || '';
                },
                recCatColorHex(rec) {
                    if (this.viewerCategory && this.viewerCategory.isAll) return (rec && rec.catColorHex) || '#0d9488';
                    return (this.viewerCategory && this.viewerCategory.colorHex) || '#0d9488';
                },
                recCatLabel(rec) {
                    if (this.viewerCategory && this.viewerCategory.isAll) return (rec && rec.catLabel) || '';
                    return (this.viewerCategory && this.viewerCategory.label) || '';
                },

                // Active page's number for the "Page N / M" indicator: the
                // CONTINUOUS number across all categories in the All view
                // (matches the grid's globalNo), else the per-category pageNo.
                // The denominator is always viewerRecords.length (the All view's
                // grand total; a single category's page count otherwise).
                activePageNo() {
                    const rec = this.viewerActiveRecord;
                    if (!rec) return 1;
                    if (this.viewerCategory && this.viewerCategory.isAll) {
                        return rec.globalNo || rec.pageNo || 1;
                    }
                    return rec.pageNo || 1;
                },

                // The app bar's page-scoped icons (template, star) are shown ONLY
                // while a SAVED page is open in the page viewer — never on the
                // patient list, the home screen, or an uploaded document. Both
                // buttons call this one helper so their visibility cannot drift;
                // each then adds its own grant (template p_id 93, star p_id 94).
                savedPageInViewer() {
                    return !!(this.viewerOpen && this.viewerMode === 'detail');
                },

                // The template icon needs a CATEGORY, not a page: it is shown for
                // every category the user opens — grid, an open page, and an EMPTY
                // category with no pages at all (that is exactly when starting
                // from a template is most useful). Never in the editor (the app
                // bar itself is hidden there) and never on the synthetic "All IPD
                // Categories" row unless a page is open, since that row is a
                // rollup with no templates of its own. Grant: p_id 93.
                templateIconVisible() {
                    if (!this.viewerOpen || this.viewerMode === 'edit') return false;
                    if (!(this.me && this.me.can_page_template_icon)) return false;
                    const cat = this.viewerCategory;
                    if (cat && cat.isAll) {
                        // In the All view only an open page identifies a category.
                        return this.viewerMode === 'detail' && !!this.viewerActiveRecord;
                    }
                    return !!(cat && Number(cat.id) > 0);
                },

                // ── template picker: "Select IPD page Template for <category>" ─
                // The app-bar template icon (p_id 93). A floating list of the
                // templates saved for THIS page's category — search, 10 per page,
                // and Get Template to drop one onto the page. The grant is
                // re-checked here as well as on the button, so no other code path
                // can reach it without p_id 93.
                openTemplatesForCurrentPage() {
                    if (!(this.me && this.me.can_page_template_icon)) return;
                    // _resolveEditCategory maps the "All" view onto the open
                    // page's real category; look the full row up so the picker
                    // has the label (title) and bgUrl (preview backdrop) too.
                    const target = this._resolveEditCategory({});
                    let cat = (this.categories || []).find((c) => c && c.id === target.id);
                    if (!cat && this.viewerCategory && !this.viewerCategory.isAll) cat = this.viewerCategory;
                    if (!cat && target && Number(target.id) > 0) {
                        cat = { id: target.id, label: '', bgUrl: target.bgUrl || '' };
                    }
                    if (!cat || !(Number(cat.id) > 0)) {
                        this.showToast('Open a category first', 'error');
                        return;
                    }
                    this.tplPickCat     = cat;
                    this.tplPickItems   = [];
                    this.tplPickError   = '';
                    this.tplPickSearch  = '';
                    this.tplPickPage    = 1;
                    this.tplPickBusyId  = null;
                    this.tplPickOpen    = true;
                    this.loadTemplatePicker(cat);
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                closeTemplatePicker() {
                    if (this.tplPickBusyId !== null) return;   // a fetch is in flight
                    this.tplPickPreviewUrl = '';
                    this.tplPickOpen = false;
                },

                async loadTemplatePicker(cat) {
                    const id = cat && (cat.id != null ? cat.id : cat.i);
                    if (id == null) return;
                    this.tplPickLoading = true;
                    this.tplPickError   = '';
                    try {
                        const resp = await fetch('./api/page-templates?category=' + encodeURIComponent(id), {
                            credentials: 'same-origin', cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 403) { this.tplPickError = 'You have not authority to Use IPD Page Templates.'; return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data  = await resp.json();
                        const items = Array.isArray(data && data.items) ? data.items : [];
                        // Newest first, same rule the templates grid uses (don't
                        // depend on the server's order — the tablet may be talking
                        // to an older deployment).
                        items.sort((a, b) => {
                            const da = String((a && a.added) || '').replace('T', ' ');
                            const db = String((b && b.added) || '').replace('T', ' ');
                            if (da !== db) return da < db ? 1 : -1;
                            return (Number(b && b.id) || 0) - (Number(a && a.id) || 0);
                        });
                        this.tplPickItems = items.map((t) => Object.assign({}, t, {
                            image: t.has_image
                                ? ('./api/page-templates/' + encodeURIComponent(t.id) + '/image'
                                   + '?v=' + encodeURIComponent(t.version || t.updated || t.added || t.id))
                                : '',
                            _added: this._rbFmt(t.added, 'dt'),
                        }));
                    } catch (_) {
                        this.tplPickError = 'Could not load templates. Check your connection.';
                    } finally {
                        this.tplPickLoading = false;
                        this.tplPickPage = 1;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Search filter (label, and the author so "saved by" also finds it).
                tplPickFiltered() {
                    const q = (this.tplPickSearch || '').trim().toLowerCase();
                    if (!q) return this.tplPickItems;
                    return this.tplPickItems.filter((t) => {
                        const name = String(t.name || ('Template ' + t.id)).toLowerCase();
                        return name.includes(q) || String(t.author || '').toLowerCase().includes(q);
                    });
                },
                tplPickTotalPages() {
                    return Math.max(1, Math.ceil(this.tplPickFiltered().length / this.tplPickPerPage));
                },
                // The visible page's rows, each carrying its running serial number
                // (continuing across pages: 11, 12, … on page 2).
                tplPickRows() {
                    const per   = this.tplPickPerPage;
                    const page  = Math.min(Math.max(1, this.tplPickPage), this.tplPickTotalPages());
                    const start = (page - 1) * per;
                    return this.tplPickFiltered().slice(start, start + per).map((t, i) =>
                        Object.assign({}, t, { _sr: start + i + 1 })
                    );
                },
                tplPickGo(page) {
                    const total = this.tplPickTotalPages();
                    this.tplPickPage = Math.min(Math.max(1, page), total);
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // The category's form image, painted BEHIND every template preview
                // (list + full-size). A saved template is a strokes-only PNG, so
                // without the form behind it the handwriting floats on white.
                tplPickBgUrl() {
                    return (this.tplPickCat && this.tplPickCat.bgUrl) || '';
                },

                // The form as a CSS background ON the template image itself, sized
                // 100% × 100% of that element. The <img> is laid out at its own
                // natural aspect ratio (max-w/max-h only), so its box IS the
                // rendered note — which makes the form come out at exactly the
                // handwritten page's dimensions instead of being fitted separately
                // into whatever box the preview happens to have.
                tplPickBgStyle() {
                    const u = this.tplPickBgUrl();
                    if (!u) return '';
                    return 'background-image:url("' + String(u).replace(/"/g, '%22') + '");'
                         + 'background-size:100% 100%;background-repeat:no-repeat;background-position:center;';
                },

                // Tap a preview in the list → see that template page full-size.
                tplPickPreview(row) {
                    if (!row || !row.image) return;
                    this.tplPickPreviewName = row.name || ('Template ' + row.id);
                    this.tplPickPreviewUrl  = row.image;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // "Get Template" — start a NEW blank page in this category and paint
                // the template onto it at full page size, then hand the editor over
                // so the user can write on it and Save.
                //
                // It goes through startEdit({ paste }) — the same queue whole-page
                // Paste uses — so the image is painted only AFTER the canvas has
                // been sized to the category's page, drawn to fill the backing
                // store (i.e. exactly the page dimensions), and snapshotted as the
                // page's starting state. Nothing is written server-side until the
                // user taps Save, so a wrong pick costs nothing.
                async tplPickGet(row) {
                    if (this.tplPickBusyId !== null) return;
                    if (!row || !row.image) { this.showToast('This template has no image', 'error'); return; }
                    const cat = this.tplPickCat;
                    if (!cat || !(Number(cat.id) > 0)) { this.showToast('No category for this template', 'error'); return; }
                    this.tplPickBusyId = row.id;
                    try {
                        // Fetch the bytes first: a data URL paints without a second
                        // network hop, and a failure here is reported instead of
                        // silently opening an empty page (the painter skips a load
                        // error by design).
                        const resp = await fetch(row.image, { credentials: 'same-origin', cache: 'no-store' });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const blob    = await resp.blob();
                        const dataUrl = await new Promise((res, rej) => {
                            const fr = new FileReader();
                            fr.onload  = () => res(String(fr.result || ''));
                            fr.onerror = () => rej(new Error('read failed'));
                            fr.readAsDataURL(blob);
                        });
                        if (!dataUrl) throw new Error('empty image');

                        this.tplPickPreviewUrl = '';
                        this.tplPickOpen = false;
                        // startEdit enforces read-only / edit-rights / locked-category
                        // / after-discharge rules and toasts its own reason, so a
                        // refusal is already explained to the user.
                        this.startEdit({ paste: dataUrl, catId: cat.id, catBgUrl: cat.bgUrl || '' });
                        this.$nextTick(() => {
                            if (this.viewerMode === 'edit') {
                                this.showToast('New page created from the template — edit and Save');
                            }
                        });
                    } catch (e) {
                        plog('warn', 'template', 'get template failed: ' + (e && e.message || e));
                        this.showToast('Could not load that template', 'error');
                    } finally {
                        this.tplPickBusyId = null;
                    }
                },

                // ── star: save the open page as an IPD Page Template ──────────
                // The star in the app bar (left of the log icon), shown while a
                // SAVED page is open in the viewer. It names the template first,
                // then the server files that page's own image under
                // IPD/<hospital>/template/T_<category>_<timestamp>.png and inserts
                // the pma_template row. The image never round-trips through the
                // tablet — the client sends the page id and the label only.
                starCurrentPage() {
                    if (!(this.me && this.me.can_star_page_template)) return;   // p_id 94
                    const rec = this.viewerActiveRecord;
                    if (!this.selectedPatientId || !(rec && Number(rec.id) > 0)) {
                        this.showToast('Open a saved page first', 'error');
                        return;
                    }
                    this.tplSaveName = '';
                    this.tplSaveBusy = false;
                    this.tplSaveOpen = true;
                    this.$nextTick(() => {
                        window.lucide && window.lucide.createIcons();
                        const el = document.getElementById('tplSaveName');
                        if (el) el.focus();
                    });
                },

                closeTemplateNameDialog() {
                    if (this.tplSaveBusy) return;
                    this.tplSaveOpen = false;
                },

                async saveCurrentPageAsTemplate() {
                    if (this.tplSaveBusy) return;
                    const rec  = this.viewerActiveRecord;
                    const name = (this.tplSaveName || '').trim();
                    if (!(rec && Number(rec.id) > 0)) { this.showToast('No saved page is open', 'error'); return; }
                    if (!name) { this.showToast('Enter a name for the template', 'error'); return; }

                    this.tplSaveBusy = true;
                    try {
                        const body = new FormData();
                        body.append('page', rec.id);
                        body.append('name', name);
                        if (this.deviceId)  body.append('device_id', this.deviceId);
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch('./api/page-templates/from-page', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: this.csrfToken
                                ? { 'X-CSRF-TOKEN': this.csrfToken, 'Accept': 'application/json' }
                                : { 'Accept': 'application/json' },
                            body,
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 403) { this.showToast('You have not authority to use IPD Pages Templates.', 'error'); return; }
                        if (!resp.ok) {
                            // Surface the server's reason (bucket / validation) rather
                            // than a bare status — these failures are worth reading.
                            const data = await resp.json().catch(() => null);
                            this.showToast((data && data.error) || ('Could not save the template (HTTP ' + resp.status + ')'), 'error', false, 12000);
                            return;
                        }
                        this.tplSaveOpen = false;
                        this.tplSaveName = '';
                        this.showToast('Template saved');
                        // The Templates drawer badge counts by category — refresh it
                        // so the new template shows up without reopening the window.
                        this.tplLoadCounts().catch(() => {});
                    } catch (e) {
                        plog('warn', 'template', 'save from page failed: ' + (e && e.message || e));
                        this.showToast('Network error — the template was not saved', 'error');
                    } finally {
                        this.tplSaveBusy = false;
                    }
                },

                // App-bar watch icon → open the log for whatever is being viewed:
                // a saved form page (page viewer) OR an uploaded document
                // (Other Documents … Bill Records detail view). Documents have no
                // category template behind them, so catBgUrl is blank.
                openPageLogsForCurrent() {
                    if (this.docViewOpen && this.docViewMode === 'detail') {
                        const doc = this.activeDocFile;
                        if (doc && Number(doc.id) > 0) {
                            this.openPageLogs({ noteId: doc.id, catBgUrl: '', isDoc: true });
                        } else {
                            this.showToast('No document to show history for', 'error');
                        }
                        return;
                    }
                    this.openPageLogs();   // form-page viewer
                },

                // Open the page edit log. Without opts it uses the CURRENT viewer
                // page (the active record's `id` is pma_patient_notes1.id == the
                // pma_notes_logs.note_id). Opts let the recycle bin / documents
                // open it for another note: { noteId, catBgUrl }.
                async openPageLogs(opts) {
                    // View-page-log grant (p_id 89). The button is already hidden
                    // without it; guard here too so no code path opens the log.
                    // Privileged roles (1/2/10) are granted server-side.
                    if (!(this.me && this.me.can_view_page_log)) return;
                    opts = opts || {};
                    const rec    = this.viewerActiveRecord;
                    const noteId = (opts.noteId != null) ? opts.noteId : (rec && rec.id);
                    if (!this.selectedPatientId || !(Number(noteId) > 0)) {
                        this.showToast('No saved page to show history for', 'error');
                        return;
                    }
                    this.pageLogNoteId   = noteId;
                    this.pageLogCatBgUrl = (opts.catBgUrl != null)
                        ? opts.catBgUrl
                        : (rec ? this.recCatBgUrl(rec) : '');
                    this.pageLogIsDoc    = !!opts.isDoc;
                    this.pageLogs = [];
                    this.pageLogActiveIndex = 0;
                    this.pageLogDiff = false;
                    this.pageLogsLoading = true;
                    this.pageLogsOpen = true;
                    try {
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                            + '/pages/' + encodeURIComponent(noteId) + '/logs',
                            { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.pageLogs = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        plog('warn', 'pagelogs', 'load failed: ' + (e && e.message || e));
                        this.showToast('Could not load page history', 'error');
                    } finally {
                        this.pageLogsLoading = false;
                        this.pageLogActiveIndex = 0;
                        this.$nextTick(() => {
                            window.lucide && window.lucide.createIcons();
                            // Start on the current version (leftmost slide).
                            const el = this.$refs.logSlider;
                            if (el) el.scrollLeft = 0;
                        });
                    }
                },

                // "Set as current note" — revert the LIVE page to the SHOWN
                // version (server writes the version's key into
                // pma_patient_notes1.notes + bumps `updated`). On success the open
                // viewer record is refreshed so the page reflects the revert.
                async setCurrentNote() {
                    if (this.settingNote) return;
                    const note = this.pageLogNoteId;
                    const ver  = this.pageLogs[this.pageLogActiveIndex];
                    if (!this.selectedPatientId || !(Number(note) > 0) || !ver || !ver.id) {
                        this.showToast('No version selected', 'error');
                        return;
                    }
                    this.settingNote = true;
                    this.showToast('Setting current note…');
                    try {
                        const body = new URLSearchParams();
                        body.append('log_id', ver.id);
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                            + '/pages/' + encodeURIComponent(note) + '/set-current-note',
                            { method: 'POST', credentials: 'same-origin',
                              headers: Object.assign(
                                  { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                                  this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}),
                              body: body.toString() }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap again', 'error'); return; }
                        const res = await resp.json().catch(() => ({}));
                        const ok  = resp.ok && res && res.ok;
                        if (ok) {
                            const img = res.image || ver.image;
                            if (res.action === 'restored') {
                                // Deleted page is live again — drop it from the bin
                                // and refresh the category counts.
                                this._serverBinItems = (this._serverBinItems || []).filter((x) => x.noteId !== note);
                                if (this.selectedPatientId && this.patientsLive) {
                                    this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                                }
                            } else {
                                // Live page reverted — reflect it in the open viewer:
                                // point the page at the selected version's image and
                                // bump updatedAt so the versioned image cache refreshes.
                                if (this.viewerActiveRecord && this.viewerActiveRecord.id === note) {
                                    if (img) this.viewerActiveRecord.image = img;
                                    if (res.updatedAt) this.viewerActiveRecord.updatedAt = res.updatedAt;
                                }
                                const idx = this.viewerRecords.findIndex((r) => r.id === note);
                                if (idx >= 0) {
                                    this.viewerRecords[idx] = Object.assign({}, this.viewerRecords[idx], {
                                        image: img || this.viewerRecords[idx].image,
                                        updatedAt: res.updatedAt || this.viewerRecords[idx].updatedAt,
                                    });
                                }
                            }
                            // Done — close the history screen.
                            this.pageLogsOpen = false;
                            this.pageLogDiff  = false;
                        }
                        this.showToast(ok ? (res.msg || 'Set as current note') : ((res && res.error) || 'Could not set the note'), ok ? 'success' : 'error');
                    } catch (e) {
                        plog('warn', 'pagelogs', 'set current note failed: ' + (e && e.message || e));
                        this.showToast('Something went wrong', 'error');
                    } finally {
                        this.settingNote = false;
                    }
                },

                // Swipe carousel → keep the active-version index in sync with
                // the scroll position (drives the dots + first-version note).
                onLogScroll(e) {
                    const el = (e && e.target) ? e.target : this.$refs.logSlider;
                    if (!el || !el.clientWidth) return;
                    const i = Math.round(el.scrollLeft / el.clientWidth);
                    this.pageLogActiveIndex = Math.max(0, Math.min(this.pageLogs.length - 1, i));
                },
                // Tap a dot → snap the carousel to that version.
                goToLogVersion(i) {
                    const el = this.$refs.logSlider;
                    const clamped = Math.max(0, Math.min(this.pageLogs.length - 1, i));
                    this.pageLogActiveIndex = clamped;
                    if (el) el.scrollTo({ left: clamped * el.clientWidth, behavior: 'smooth' });
                },
                // Toggle the change-highlight overlay (added green / erased red).
                togglePageDiff() {
                    this.pageLogDiff = !this.pageLogDiff;
                    if (this.pageLogDiff) this.$nextTick(() => this.renderAllDiffs());
                },
                _loadImg(src) {
                    return new Promise((resolve, reject) => {
                        const img = new Image();
                        img.onload = () => resolve(img);
                        img.onerror = reject;
                        img.src = src;   // same-origin proxy → canvas stays untainted
                    });
                },
                // Render the change-highlight for EVERY version slide at once so
                // swiping is instant. Each version i is diffed against i+1 (the
                // older one): inked now-but-not-before = added (green), before-
                // but-not-now = erased (red), unchanged = faint slate. Strokes are
                // transparent PNGs, so alpha = "inked". Each version's pixels are
                // loaded once (reused as both "current" for slide i and "previous"
                // for slide i-1).
                async renderAllDiffs() {
                    const token = (this._diffToken = (this._diffToken || 0) + 1);
                    try {
                        let W = 0, H = 0;
                        const datas = [];
                        for (let i = 0; i < this.pageLogs.length; i++) {
                            const log = this.pageLogs[i];
                            if (!log || !log.imageProxy) { datas[i] = null; continue; }
                            try {
                                const img = await this._loadImg(log.imageProxy);
                                if (token !== this._diffToken) return;
                                if (!W) { W = img.naturalWidth || img.width || 1000; H = img.naturalHeight || img.height || 1400; }
                                const c = document.createElement('canvas');
                                c.width = W; c.height = H;
                                c.getContext('2d').drawImage(img, 0, 0, W, H);
                                datas[i] = c.getContext('2d').getImageData(0, 0, W, H).data;
                            } catch (_) { datas[i] = null; }
                        }
                        if (!W || token !== this._diffToken) return;
                        const T = 28;   // alpha threshold for "inked"
                        for (let i = 0; i < this.pageLogs.length; i++) {
                            const canvas = document.getElementById('logDiff-' + i);
                            const cur = datas[i];
                            if (!canvas || !cur) continue;
                            const prev = datas[i + 1] || null;   // older version
                            canvas.width = W; canvas.height = H;
                            const octx = canvas.getContext('2d');
                            const out  = octx.createImageData(W, H);
                            const od   = out.data;
                            for (let p = 0; p < cur.length; p += 4) {
                                const cInk = cur[p + 3] > T;
                                if (!prev) {                    // first version — no diff
                                    if (cInk) { od[p] = 30; od[p + 1] = 41; od[p + 2] = 59; od[p + 3] = 255; }
                                    else { od[p + 3] = 0; }
                                    continue;
                                }
                                const pInk = prev[p + 3] > T;
                                if (cInk && !pInk) {            // added
                                    od[p] = 5; od[p + 1] = 150; od[p + 2] = 105; od[p + 3] = 255;
                                } else if (!cInk && pInk) {     // erased
                                    od[p] = 225; od[p + 1] = 29; od[p + 2] = 72; od[p + 3] = 255;
                                } else if (cInk && pInk) {      // unchanged
                                    od[p] = 100; od[p + 1] = 116; od[p + 2] = 139; od[p + 3] = 150;
                                } else {
                                    od[p + 3] = 0;              // empty
                                }
                            }
                            octx.putImageData(out, 0, 0);
                        }
                    } catch (e) {
                        plog('warn', 'pagelogs', 'diff render failed: ' + (e && e.message || e));
                    }
                },

                // Resolve a category's template image — CACHE-FIRST, even when
                // online. Policy:
                //   1. If a blob is stored in IndexedDB for this cat_id, show it
                //      immediately (offline storage wins; no image is fetched
                //      from the network for the display).
                //   2. Only when NO blob is stored do we fetch from the online
                //      proxy, then store it for next time.
                //   3. The cat_name is still honoured as a change token: if the
                //      stored name differs from the current one, we refresh in
                //      the BACKGROUND (the cached copy already showed in step 1)
                //      and swap to the new image when it arrives.
                // Mutates cat.bgUrl to a local object URL — reactive, so the
                // viewer picks it up. Best-effort throughout.
                // Returns true when the form image is available offline after
                // this call (either it was already stored, or it was just
                // downloaded + stored); false when it couldn't be cached.
                async cacheCategoryImage(cat) {
                    if (!cat || !cat.id) return false;
                    // Payment forms (hospital_id = 0, flagged liveOnly) are never
                    // cached — they must load from the live presigned URL only
                    // (accessible on live internet). Keep cat.bgUrl as the server's
                    // live URL; don't fetch/store a blob or swap it out.
                    if (cat.liveOnly) return false;
                    const catId   = cat.id;
                    const catName = cat.label || '';

                    let cached = null;
                    try { cached = await idbGetCatImage(catId); } catch (_) { cached = null; }

                    const haveBlob     = !!(cached && cached.blob);
                    const nameChanged  = !cached || cached.catName !== catName;

                    // (1) Cache-first display: show the stored blob right away.
                    if (haveBlob) {
                        cat.bgUrl = this._catObjectUrl(cached.blob);
                    }

                    // (2)/(3) Hit the network only to FILL a missing image, or to
                    // REFRESH one whose category name changed. A cached, same-name
                    // image needs nothing — return without touching the network.
                    if (haveBlob && !nameChanged) return true;

                    // ?v=<cat_name> doubles as the service-worker cache key so a
                    // renamed category can't be served a stale cached response.
                    // The proxy holds a PHP-FPM worker during its S3 fetch, so a
                    // burst can transiently 503/502/429 (worker pool busy) — retry
                    // those with backoff so every form still ends up cached.
                    const url = './api/categories/' + encodeURIComponent(catId)
                              + '/image?v=' + encodeURIComponent(catName);
                    const TRANSIENT = [502, 503, 429];
                    for (let attempt = 0; attempt < 3; attempt++) {
                        // Bound EACH attempt with a 15s timeout. A hung proxy/S3
                        // fetch with no timeout is the root cause of the
                        // "downloading forms" banner getting stuck forever.
                        const ac = new AbortController();
                        const to = setTimeout(() => ac.abort(), 15000);
                        try {
                            const resp = await fetch(url, {
                                credentials: 'same-origin',
                                headers: { 'Accept': 'image/*' },
                                signal: ac.signal,
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return haveBlob; }
                            if (TRANSIENT.includes(resp.status)) {
                                // Server busy — wait and retry (300ms, 600ms).
                                if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                                plog('error', 'forms', 'Category ' + catId + ' "' + catName + '" image proxy busy (HTTP ' + resp.status + ') after 3 tries');
                                return haveBlob;
                            }
                            if (!resp.ok) {
                                plog('error', 'forms', 'Category ' + catId + ' "' + catName + '" image HTTP ' + resp.status + ' (no template / server error)');
                                return haveBlob;          // genuine error (e.g. 404 no template)
                            }
                            const blob = await resp.blob();
                            if (!blob || blob.size === 0) {
                                plog('error', 'forms', 'Category ' + catId + ' "' + catName + '" image came back EMPTY (0 bytes)');
                                return haveBlob;
                            }
                            // Persist AND read back to CONFIRM it's really stored.
                            // A swallowed quota/private-mode/blocked-DB write was
                            // the cause of "download complete but offline shows
                            // nothing" — now we verify and report it.
                            let persisted = false;
                            try {
                                await idbPutCatImage({ catId, catName, blob, updatedAt: Date.now() });
                                const back = await idbGetCatImage(catId);
                                persisted = !!(back && back.blob && back.blob.size > 0);
                            } catch (e) {
                                plog('error', 'forms', 'Category ' + catId + ' "' + catName + '" could NOT be saved to IndexedDB (quota/private-mode/blocked?): ' + (e && e.message || e));
                            }
                            cat.bgUrl = this._catObjectUrl(blob);   // show this session regardless
                            if (!persisted) {
                                plog('warn', 'forms', 'Category ' + catId + ' "' + catName + '" displayed but NOT persisted — will be missing offline');
                            }
                            // Only report success when the image is genuinely on
                            // disk, so the prefetch's "ready" count reflects what's
                            // actually available offline.
                            return persisted || haveBlob;
                        } catch (e) {
                            // Abort (timeout) / network error (offline, SW 503).
                            const reason = (e && e.name === 'AbortError') ? 'timeout (15s)' : (e && (e.message || e.name) || e);
                            if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                            plog('error', 'forms', 'Category ' + catId + ' "' + catName + '" image fetch failed: ' + reason);
                            return haveBlob;
                        } finally {
                            clearTimeout(to);
                        }
                    }
                    return haveBlob;
                },

                // Small awaitable delay (ms) used for retry backoff.
                _sleep(ms) {
                    return new Promise((resolve) => setTimeout(resolve, ms));
                },

                // Cache one saved-page image blob for offline viewing, and rewrite
                // rec.image to the local blob URL. The key includes the page's
                // `updatedAt` VERSION — an edit keeps the same page id but writes a
                // new image, so a plain `page:{id}` key would serve the stale first
                // version forever. Cache-first per version: stored blob wins;
                // otherwise fetch the bytes via the same-origin proxy and store.
                // Returns true when the page image is available offline afterwards.
                async cachePageImage(rec, patientId, catId) {
                    if (!rec || !rec.id) return false;
                    const key = 'page:' + rec.id + ':' + (rec.updatedAt || '');

                    let cached = null;
                    try { cached = await idbGet(STORE_PAGE_IMG, key); } catch (_) { cached = null; }
                    if (cached && cached.blob) {
                        rec.image = this._catObjectUrl(cached.blob);
                        return true;
                    }

                    // Not stored → pull bytes through the same-origin proxy (the
                    // presigned S3 URL can't be read as a blob due to bucket CORS).
                    const proxy = rec.imageProxy
                        || ('./api/patients/' + encodeURIComponent(patientId)
                            + '/categories/' + encodeURIComponent(catId)
                            + '/pages/' + encodeURIComponent(rec.id) + '/image');
                    const TRANSIENT = [502, 503, 429];
                    for (let attempt = 0; attempt < 3; attempt++) {
                        // 15s per-attempt timeout so a hung proxy can't freeze the
                        // page-image cache pass (same fix as cacheCategoryImage).
                        const ac = new AbortController();
                        const to = setTimeout(() => ac.abort(), 15000);
                        try {
                            const resp = await fetch(proxy, {
                                credentials: 'same-origin',
                                headers: { 'Accept': 'image/*' },
                                signal: ac.signal,
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return false; }
                            if (TRANSIENT.includes(resp.status)) {
                                if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                                plog('error', 'forms', 'Page ' + rec.id + ' image proxy busy (HTTP ' + resp.status + ') after 3 tries');
                                return false;
                            }
                            if (!resp.ok) { plog('error', 'forms', 'Page ' + rec.id + ' image HTTP ' + resp.status); return false; }
                            const blob = await resp.blob();
                            if (!blob || blob.size === 0) { plog('error', 'forms', 'Page ' + rec.id + ' image EMPTY (0 bytes)'); return false; }
                            let persisted = false;
                            try {
                                await idbPut(STORE_PAGE_IMG, { key, blob, updatedAt: Date.now() });
                                const back = await idbGet(STORE_PAGE_IMG, key);
                                persisted = !!(back && back.blob && back.blob.size > 0);
                            } catch (e) { plog('error', 'forms', 'Page ' + rec.id + ' could NOT be saved to IndexedDB: ' + (e && e.message || e)); }
                            rec.image = this._catObjectUrl(blob);
                            if (!persisted) plog('warn', 'forms', 'Page ' + rec.id + ' displayed but NOT persisted — missing offline');
                            return persisted;
                        } catch (e) {
                            const reason = (e && e.name === 'AbortError') ? 'timeout (15s)' : (e && (e.message || e.name) || e);
                            if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                            plog('error', 'forms', 'Page ' + rec.id + ' image fetch failed: ' + reason);
                            return false;
                        } finally {
                            clearTimeout(to);
                        }
                    }
                    return false;
                },

                // Pre-apply already-stored page-image blobs (rewrite rec.image to
                // the local blob URL) BEFORE the grid renders, so re-views and the
                // offline path display straight from IndexedDB without fetching
                // the presigned URL first. Awaited; cheap (indexed reads).
                async _applyCachedPageImages(records) {
                    await Promise.all((records || []).map(async (r) => {
                        if (!r || !r.id) return;
                        try {
                            // Versioned key (id + updatedAt) so an edited page only
                            // hits its OWN cached version — never the stale first one.
                            const rec = await idbGet(STORE_PAGE_IMG, 'page:' + r.id + ':' + (r.updatedAt || ''));
                            if (rec && rec.blob) r.image = this._catObjectUrl(rec.blob);
                        } catch (_) { /* leave presigned */ }
                    }));
                },

                // Download + store the image blobs for any page not yet cached
                // (bounded concurrency so the page-image proxy doesn't exhaust
                // PHP-FPM workers → 503). Pages already showing a blob: URL (from
                // _applyCachedPageImages) are skipped — they're cached already.
                async _cachePageImages(records, patientId, catId) {
                    const recs = (records || []).filter((r) =>
                        r && r.id && !(typeof r.image === 'string' && r.image.startsWith('blob:'))
                    );
                    if (!recs.length) return;
                    await this._runLimited(recs, 2, (r) => this.cachePageImage(r, patientId, catId));
                },

                // Mint + track an object URL for a cached blob.
                _catObjectUrl(blob) {
                    const u = URL.createObjectURL(blob);
                    this._catImageObjectUrls.push(u);
                    return u;
                },

                // Revoke object URLs from a previous category load.
                _revokeCatImageUrls() {
                    (this._catImageObjectUrls || []).forEach((u) => {
                        try { URL.revokeObjectURL(u); } catch (_) { /* ignore */ }
                    });
                    this._catImageObjectUrls = [];
                },

                // Run the offline form prefetch as a BACKGROUND task, so the
                // category drawer paints first. The prefetch is a bulk job (one
                // IndexedDB check per category, then downloads two at a time) and
                // nothing on screen waits for it — the footer progress badge
                // fills in as it goes. Mirrors loadMasters()'s idle-refresh
                // pattern, timeout included so a busy main thread can't starve it.
                _prefetchFormsWhenIdle(cats) {
                    const bg = () => this.prefetchCategoryForms(cats, true);
                    if (typeof requestIdleCallback === 'function') {
                        requestIdleCallback(bg, { timeout: 3000 });
                    } else {
                        setTimeout(bg, 0);
                    }
                },

                // Ensure EVERY category form for this hospital is stored offline.
                // Runs on each app load (from loadCategories): for every category
                // that has a template, cacheCategoryImage() serves the stored blob
                // if present and downloads + stores it if not — so a freshly
                // logged-in hospital's whole form set is pulled down once and is
                // then available offline. `track` drives the footer progress
                // badge (forms cached / total); pass false for the silent
                // payment-form pass. Cached forms cost no network (cache-first),
                // so re-running this every load only fetches the genuinely
                // missing ones.
                async prefetchCategoryForms(cats, track = false) {
                    const all   = (cats || []).filter((c) => c && c.id);
                    const forms = all.filter((c) => c.bgUrl);
                    const noTpl = all.filter((c) => !c.bgUrl);
                    if (track) {
                        this.formsCacheTotal = forms.length;
                        this.formsCacheReady = 0;
                        this.formsCaching    = false;
                    }
                    // Categories with no template URL can't be cached at all — log
                    // them so it's clear WHY they won't appear offline.
                    if (noTpl.length) {
                        plog('warn', 'forms', noTpl.length + ' categor(ies) have no template URL (bgUrl) and can\'t be cached offline: '
                            + noTpl.map((c) => c.id + ':' + (c.label || '')).join(', '));
                    }
                    if (!forms.length) return;

                    // try/finally so the "downloading forms" banner is ALWAYS
                    // cleared — even if something below throws — and can never get
                    // stuck on.
                    let ready = 0, failed = 0;
                    try {
                        // Pre-scan offline storage so the loader only shows when there
                        // is actually something to download. Already-cached forms count
                        // as ready immediately; the spinner reflects only the missing set.
                        const cachedFlags = await Promise.all(forms.map((c) => this._isFormCached(c)));
                        ready = cachedFlags.filter(Boolean).length;
                        if (track) {
                            this.formsCacheReady = ready;
                            this.formsCaching    = ready < forms.length; // missing > 0
                        }

                        // Cache-first display + download-missing for every form, with
                        // BOUNDED CONCURRENCY (each proxy request holds a PHP-FPM worker
                        // during its S3 fetch; firing all at once exhausts the pool → 503).
                        await this._runLimited(forms, 2, async (c, i) => {
                            const ok = await this.cacheCategoryImage(c)
                                .catch((e) => { plog('error', 'forms', 'cacheCategoryImage threw for ' + c.id + ': ' + (e && e.message || e)); return false; });
                            if (!cachedFlags[i]) {
                                if (ok) { ready++; if (track) this.formsCacheReady = ready; }
                                else { failed++; }
                            }
                        });
                        if (track) this.formsCacheReady = Math.min(ready, forms.length);

                        plog(failed ? 'warn' : 'info', 'forms',
                            'Forms offline cache: ' + Math.min(ready, forms.length) + '/' + forms.length + ' ready'
                            + (failed ? (', ' + failed + ' FAILED (see errors above)') : '')
                            + (noTpl.length ? (', ' + noTpl.length + ' have no template') : ''));
                    } catch (e) {
                        plog('error', 'forms', 'Forms prefetch crashed: ' + (e && e.message || e));
                    } finally {
                        if (track) this.formsCaching = false;   // never leave the banner stuck
                    }
                },

                // Run an async fn over items with at most `limit` in flight at
                // once (a tiny worker-pool). Used to keep the form prefetch from
                // saturating the server's PHP-FPM workers (→ 503). Never rejects;
                // per-item errors are swallowed by the caller's fn.
                async _runLimited(items, limit, fn) {
                    const list = items || [];
                    const n = Math.max(1, Math.min(limit, list.length));
                    let next = 0;
                    const worker = async () => {
                        while (next < list.length) {
                            const i = next++;
                            try { await fn(list[i], i); } catch (_) { /* swallow */ }
                        }
                    };
                    await Promise.all(Array.from({ length: n }, () => worker()));
                },

                // Cheap "is this form already in offline storage?" check used by
                // the prefetch pre-scan to decide whether to show the loader.
                async _isFormCached(cat) {
                    if (!cat || !cat.id || !cat.bgUrl) return false;
                    try {
                        const rec = await idbGetCatImage(cat.id);
                        return !!(rec && rec.blob && rec.catName === (cat.label || ''));
                    } catch (_) { return false; }
                },

                // ── Offline metadata cache (localStorage) ───────────────────
                // Small JSON snapshots — identity + the raw category list — that
                // let a cold OFFLINE start render the category drawer (the blob
                // images live in IndexedDB). Category list is keyed by hospital
                // so switching tenants doesn't surface the wrong list. All
                // wrapped: private-mode / disabled storage degrades to no-cache.
                _persistMe(me) {
                    try { localStorage.setItem('pwa.me', JSON.stringify(me)); } catch (_) { /* ignore */ }
                },
                // Drop the cached identity. Called on logout and on a 401 so the
                // offline cold-start fast-path in loadMe() can never restore a
                // previous account's identity after the session has ended.
                _clearCachedMe() {
                    try { localStorage.removeItem('pwa.me'); } catch (_) { /* ignore */ }
                    this.csrfToken = '';
                },

                // Pull the hospital's employees + face embeddings from the HRMS
                // sync (server-proxied at ./api/employees) and cache them in
                // IndexedDB (KV key 'employees') for OFFLINE face login. The
                // server already drops rows with empty face_embeddings; we guard
                // again here. Silent on failure — a later online load retries.
                async loadEmployees() {
                    if (!this.me || !this.me.user_id) return;
                    if (navigator.onLine === false) return;   // keep the cached copy
                    try {
                        const resp = await fetch('./api/employees', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) return;
                        if (!resp.ok) return;
                        const data = await resp.json();
                        const list = Array.isArray(data && data.employees) ? data.employees : [];
                        // Keep rows that have a key (presco_user_id) AND a usable
                        // face embedding — those are what offline face-match needs.
                        const clean = list.filter((e) =>
                            e && e.presco_user_id != null
                            && e.face_embeddings != null && e.face_embeddings !== ''
                            && !(Array.isArray(e.face_embeddings) && e.face_embeddings.length === 0));
                        // One record per presco_user_id in the dedicated store.
                        await idbReplaceAll(STORE_EMPLOYEES, clean);
                        plog('info', 'employees', 'cached ' + clean.length + ' employee faces for offline');
                    } catch (e) {
                        plog('warn', 'employees', 'sync failed: ' + (e && e.message || e));
                    }
                },
                _loadCachedMe() {
                    try { return JSON.parse(localStorage.getItem('pwa.me') || 'null'); } catch (_) { return null; }
                },

                // Friendly label for the single-letter gm_user_master.user_type
                // code (A/D/N/… — see AssignRolePermission docblock) shown as
                // "<label> Account" on the Settings card. Falls back to the raw
                // code, then 'User'.
                accountTypeLabel() {
                    const map = {
                        A: 'Admin', D: 'Doctor', N: 'Nurse', R: 'Reception', K: 'Doctor',
                        L: 'Lab Assistant', P: 'Pharmacy', O: 'Owner', G: 'Guest', S: 'Super Admin',
                    };
                    const t = ((this.me && this.me.user_type) || '').toString().trim().toUpperCase();
                    return map[t] || t || 'User';
                },

                // Up-to-two-letter initials from the signed-in user's name for the
                // profile-card avatar (first + last word). Falls back to a person
                // glyph placeholder when no name is cached.
                userInitials() {
                    const name = ((this.me && this.me.user_name) || '').toString().trim();
                    if (!name) return '👤';
                    const parts = name.split(/\s+/).filter(Boolean);
                    const first = parts[0] ? parts[0][0] : '';
                    const last  = parts.length > 1 ? parts[parts.length - 1][0] : '';
                    return (first + last).toUpperCase() || first.toUpperCase();
                },

                // Resolve the tablet's Device Id (Android ID) + Serial No for the
                // Settings card. Reads the value the /pwa home screen already
                // cached (same-origin localStorage), then refreshes from the local
                // device bridge — the same 127.0.0.1:47100-47102 GET /device the
                // fingerprint capture probes. The bridge returns { androidId } (and
                // a serial field on wrappers that expose one). Stays '' when the
                // bridge isn't running; the card then shows '—'.
                // Settings-drawer menu tap. Logout posts the session-ending form
                // (same as the old Account panel); every other item is a
                // placeholder until its destination is wired.
                settingsMenuTap(item) {
                    if (!item) return;
                    if (item.action === 'logout') { this._doLogout(); return; }
                    // Application-tool permission gate (other_permissions p_id;
                    // roles 1/2/10 bypass server-side). Blocked items toast their
                    // authority message instead of opening.
                    if (item.perm && !(this.me && this.me[item.perm])) {
                        this.showToast(item.denyMsg || 'You have not permission for this action.', 'error');
                        return;
                    }
                    // item.action → an in-app screen (past the permission gate).
                    if (item.action === 'register-book-master') { this.openRegisterBookMaster(); return; }
                    // IPD Page Templates → in-app window: category drawer + the
                    // selected category's saved template pages as a grid.
                    if (item.action === 'ipd-page-templates') { this.openTemplates(); return; }
                    // Audit & Feedback → gate behind the administrative (audit /
                    // super-audit) password before proceeding.
                    if (item.action === 'audit-feedback') { this.openAuditGate(); return; }
                    // Exchange Bed → IPD bed-exchange page in the floating window.
                    if (item.action === 'exchange-bed') { this.openExchangeBed(); return; }
                    // item.nativeApp → launch an installed Android app by package.
                    if (item.nativeApp) { this._openNativeApp(item.nativeApp, item.notInstalledMsg); return; }
                    // item.link → URL is composed server-side (DB/AES); fetch it,
                    // then open it. `external` items (Prescoflow Ticket / Mart)
                    // forbid iframe embedding (X-Frame-Options) so they open at
                    // top level instead of the in-app floating window.
                    if (item.link) { this._openMenuLink(item.link, item.label, item.landscape, item.external, item.confirmClose); return; }
                    // item.url is a full, ready destination — open it the same way.
                    // item.url is a ready destination. A leading-slash value is an
                    // IPD path (e.g. '/cms/patient-registration') → prefix APP_URL;
                    // a full URL is opened as-is.
                    if (item.url) {
                        const u = item.url.charAt(0) === '/' ? this._ipdUrl(item.url) : item.url;
                        this._openExternal(u, item.label, item.landscape, item.confirmClose); return;
                    }
                    this.showToast('“' + item.label + '” is coming soon.');
                },
                // Launch a third-party Android app by package name through the
                // native WebView bridge. Web JS can neither launch an app nor
                // detect whether it's installed, so this goes through the wrapper's
                // injected interface (the same channel the fingerprint bridge uses).
                // The bridge's openApp(pkg) launches the app and returns false when
                // it isn't installed → we toast. No bridge (plain browser / older
                // wrapper) → we also toast, since there's nothing to launch.
                _openNativeApp(pkg, msg) {
                    msg = msg || 'App not installed';
                    const objs = [
                        window.PrescoWrapper, window.PrescoBridge, window.Android,
                        window.AndroidBridge, window.NativeBridge, window.JSBridge, window.external,
                    ];
                    const methods = [
                        'openApp', 'launchApp', 'openApplication', 'launchApplication',
                        'openPackage', 'launchPackage', 'startApp',
                    ];
                    for (let i = 0; i < objs.length; i++) {
                        const o = objs[i];
                        if (!o) continue;
                        for (let j = 0; j < methods.length; j++) {
                            if (typeof o[methods[j]] !== 'function') continue;
                            try {
                                const r = o[methods[j]](pkg);
                                // Bridge signals a missing app via false / "false" /
                                // {installed:false} / {ok:false}; anything else = launched.
                                if (r === false || r === 'false'
                                    || (r && (r.installed === false || r.ok === false))) {
                                    this.showToast(msg, 'error');
                                }
                            } catch (_) {
                                this.showToast(msg, 'error');
                            }
                            return;
                        }
                    }
                    // No native launcher available.
                    this.showToast(msg, 'error');
                },
                // Show a URL in the floating full-screen window (iframe overlay),
                // closing the Settings drawer behind it. `landscape` forces the
                // window to landscape: a best-effort screen-orientation lock, with
                // a CSS 90° rotation (.ext-landscape) as the always-works fallback
                // when the device stays portrait.
                // `confirmClose` makes the X button / Esc ask before closing.
                _openExternal(url, title, landscape, confirmClose) {
                    if (!url) return;
                    this.extUrl   = url;
                    this.extTitle = title || 'Presco';
                    this.extLandscape = !!landscape;
                    this.extConfirmClose    = !!confirmClose;
                    this.extExitConfirmOpen = false;
                    this.settingsOpen = false;
                    this.extOpen  = true;
                    if (landscape) {
                        try {
                            if (screen.orientation && screen.orientation.lock) {
                                screen.orientation.lock('landscape').catch(() => {});
                            }
                        } catch (_) { /* unsupported / needs fullscreen — CSS handles it */ }
                    }
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                // Close REQUEST (X button / Esc). Windows flagged confirmClose
                // put up the exit dialog first; everything else closes at once.
                _requestCloseExternal() {
                    if (this.extConfirmClose) {
                        this.extExitConfirmOpen = true;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }
                    this._closeExternal();
                },
                // Close the floating window and release any orientation lock.
                _closeExternal() {
                    this.extExitConfirmOpen = false;
                    this.extConfirmClose    = false;
                    this.extOpen = false;
                    if (this.extLandscape) {
                        try { screen.orientation && screen.orientation.unlock && screen.orientation.unlock(); } catch (_) {}
                    }
                    this.extLandscape = false;
                },

                // ── Register Book Master (view-only full-screen window) ──
                // ══════════════════════════════════════════════════════════
                // IPD PAGE TEMPLATES
                // ══════════════════════════════════════════════════════════
                openTemplates() {
                    this.settingsOpen = false;
                    this.tplActiveCat = null;
                    this.tplPages     = [];
                    this.tplError     = '';
                    this.tplSearch    = '';
                    this.tplBunch     = '';
                    this.tplBunchOpen = false;
                    this.tplView      = 'grid';
                    this.tplEditingId = null;
                    this.tplRightOpen = true;    // land on the category list
                    this.tplOpen      = true;
                    // The category list is already loaded for the Forms drawer; only
                    // fetch if it somehow isn't.
                    if (!this.categories || this.categories.length <= 1) this.loadCategories();
                    // Stamps are the shared list; make sure it's there for the
                    // editor's Add-image menu even if nothing else loaded it yet.
                    if (!this.stamps || this.stamps.length === 0) this.loadStamps();
                    this.tplLoadCounts();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                // Back / Escape → confirm before leaving. Unsaved editor strokes are
                // settled FIRST (Save / Discard / Keep editing); the exit prompt then
                // follows automatically, so a tap on Back is never silently swallowed
                // and work is never dropped. Mirrors rbConfirmExit.
                tplConfirmExit() {
                    if (this.tplView === 'edit' && this._tplDirty()) {
                        this._tplPendingExit = true;
                        this.tplExitOpen = true;
                        return;
                    }
                    this.tplExitConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                // Called after the unsaved-strokes prompt resolves (save or discard).
                _tplAfterExitGuard() {
                    if (!this._tplPendingExit) return;
                    this._tplPendingExit = false;
                    this.tplExitConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                closeTemplates() {
                    this.tplExitConfirmOpen = false;
                    this.tplExitOpen        = false;
                    this._tplPendingExit    = false;
                    this.tplOpen      = false;
                    this.tplRightOpen = false;
                },
                // Every REAL IPD page category — the synthetic "All IPD Categories"
                // aggregate row is a per-patient view and meaningless for templates.
                tplCategoriesAll() {
                    return (this.categories || []).filter((c) => c && !c.isAll);
                },
                // …narrowed by the drawer's search box AND the colour-bunch filter.
                tplCategories() {
                    const q = (this.tplSearch || '').trim().toLowerCase();
                    const bunch = (this.tplBunch || '').toLowerCase();
                    return this.tplCategoriesAll()
                        .filter((c) => !bunch || String(c.colorHex || '#00000000').toLowerCase() === bunch)
                        .filter((c) => !q || String(c.label || '').toLowerCase().indexOf(q) >= 0);
                },
                // Row background tint — the IPD category list already ships `bgHex`
