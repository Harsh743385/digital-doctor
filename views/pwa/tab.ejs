                        const o = objs[i];
                        if (!o) continue;
                        for (let j = 0; j < methods.length; j++) {
                            if (typeof o[methods[j]] !== 'function') continue;
                            try {
                                const r = o[methods[j]](vapidKey);
                                // Some bridges return the subscription synchronously;
                                // others deliver it later via PrescoPush.onSubscription.
                                if (r && r !== true) {
                                    const parsed = (typeof r === 'string') ? this._tryParseJson(r) : r;
                                    if (parsed && parsed.endpoint) this._savePushSubscription(parsed);
                                }
                            } catch (_) {}
                            return true;   // bridge present + asked to register
