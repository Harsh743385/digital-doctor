                        this.showToast('Could not save', 'error');
                    } finally {
                        this.drdSaving = false;
                    }
                },

                // ── Clone (duplicate) the current page ──
                openCloneConfirm() {
                    // Clone grant (p_id 74). The control is already hidden without
                    // it; guard here too so no code path clones the page.
                    if (!(this.me && this.me.can_clone_pages)) {
                        this.showToast('You have not authority to Duplicate/Clone page', 'error');
                        return;
                    }
                    const rec = this.viewerActiveRecord;
                    if (!rec || !rec.id) return;
                    if (rec.isLocked) { this.showToast('This page is locked', 'error'); return; }
                    this.cloneConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                confirmClone() {
                    this.cloneConfirmOpen = false;
                    const rec = this.viewerActiveRecord;
                    if (!rec) return;
                    // Open the edit canvas pre-filled with this page's strokes, but
                    // as a NEW page (no editingRecordId) so Save creates a fresh
                    // page (POST). In the All view, target the page's own category.
                    this.startEdit({
                        paste:    rec.imageProxy || rec.image || null,
                        catId:    rec.catId != null ? rec.catId : undefined,
