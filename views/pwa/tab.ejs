                    if (!this.me.can_lock_pages) { this.showToast('You have not authority to Lock IPD Page.', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    this.lockTarget = rec;
                    this.lockAction = 'lock-note';
                    this.lockConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Unlock a single page (note) from the thumbnail view.
                openUnlockNoteConfirm(rec) {
                    if (!rec || !rec.isLocked) return;
                    // Unlocking is gated by the per-user application-tool right
                    // (other_permissions p_id = 36 / roles 1,2,10). The server
                    // re-checks too; this just gives immediate feedback.
                    if (!this.me.can_unlock_pages) { this.showToast('You have not authority to Unlock IPD Page.', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    this.lockTarget = rec;
                    this.lockAction = 'unlock-note';
                    this.lockConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                async confirmLockCategory() {
                    const cat = this.lockTarget;
                    const lock = this.lockAction !== 'unlock';
                    this.lockConfirmOpen = false;
                    if (!cat || !this.selectedPatientId) return;

                    // Per-page lock/unlock branches off to its own endpoint.
                    if (this.lockAction === 'lock-note' || this.lockAction === 'unlock-note') {
                        await this._setNoteLock(cat, this.lockAction === 'lock-note');
                        return;
                    }

                    // Demo mode: flip locally, no server call.
                    if (!this.categoriesLive) {
                        cat.isLocked = lock;
                        this.showToast(lock ? 'Category locked' : 'Category unlocked');
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }

                    try {
                        const body = new URLSearchParams();
                        body.append('lock', lock ? '1' : '0');
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                + '/categories/' + encodeURIComponent(cat.id) + '/lock',
                            {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: Object.assign(
                                    { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                                    this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                                ),
                                body: body.toString(),
                            }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) { this.showToast(lock ? 'Could not lock category' : 'Could not unlock category', 'error'); return; }
                        cat.isLocked = lock;
                        this.showToast(lock ? 'Category locked' : 'Category unlocked');
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    } catch (_) {
                        this.showToast(lock ? 'Could not lock category' : 'Could not unlock category', 'error');
                    }
                },

                async _setNoteLock(rec, lock) {
                    // Demo mode: flip locally, no server call.
                    if (!this.categoriesLive) {
                        rec.isLocked = lock;
                        this.showToast(lock ? 'Page locked' : 'Page unlocked');
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }
                    try {
                        const body = new URLSearchParams();
                        body.append('lock', lock ? '1' : '0');
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                + '/pages/' + encodeURIComponent(rec.id) + '/unlock',
                            {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: Object.assign(
                                    { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                                    this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                                ),
                                body: body.toString(),
                            }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) { this.showToast(lock ? 'Could not lock page' : 'Could not unlock page', 'error'); return; }
                        rec.isLocked = lock;
                        this.showToast(lock ? 'Page locked' : 'Page unlocked');
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    } catch (_) {
                        this.showToast(lock ? 'Could not lock page' : 'Could not unlock page', 'error');
                    }
                },

                // ── Gallery | Labs row actions: remark + folder ──
                // Placeholder behaviour — surfaces a toast for now. Wire these
                // to the real remark dialog / folder view when defined.
                openDocRemark(name) { this.showToast('Remark: ' + name); },

                // Folder dropdown — fetch tbl_folder_mst names for this doc
                // category and open a small dropdown anchored under the icon.
                // A fixed "Other Document" (id 0) option is always listed first.
                async openDocFolder(name, catId, ev) {
                    try {
                        const r = ev && ev.currentTarget && ev.currentTarget.getBoundingClientRect();
                        if (r) {
                            this.folderMenuTop   = Math.round(r.bottom + 4);
                            this.folderMenuRight = Math.round(window.innerWidth - r.right);
                        }
                    } catch (_) {}
                    this.folderMenuTitle   = name;
                    this.folderMenuItems   = [];
                    this.folderMenuLoading = true;
                    this.folderMenuOpen    = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    if (this.categoriesLive) {
                        try {
                            const resp = await fetch('./api/folders/' + encodeURIComponent(catId), {
                                credentials: 'same-origin',
                                cache: 'no-store',
                                headers: { 'Accept': 'application/json' },
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return; }
                            if (resp.ok) {
                                const data = await resp.json();
                                this.folderMenuItems = Array.isArray(data && data.folders) ? data.folders : [];
                            }
                        } catch (_) { /* silent */ }
                    }
                    this.folderMenuLoading = false;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                selectDocFolder(f) {
                    this.folderMenuOpen = false;
                    this.showToast('Folder: ' + (f && f.folder_name ? f.folder_name : ''));
                },

                // Page thumbnail → "Set Remark & Directory" dialog for ONE page
                // (note). Prefills the page's current remark + directory, then
                // loads the directory list for the page's category.
                async openNoteRemarkDir(rec, catIdOverride) {
                    if (!rec) return;
                    // In multi-select mode the whole card (incl. the remark strip)
                    // toggles selection instead of opening the remark editor.
                    if (this.docSelectMode) { this.toggleDocSelect(rec); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    const catId = (catIdOverride !== undefined && catIdOverride !== null && catIdOverride !== '')
                        ? catIdOverride
                        : ((this.viewerCategory && this.viewerCategory.isAll)
                            ? (rec.catId || (this.viewerCategory && this.viewerCategory.id))
                            : (this.viewerCategory && this.viewerCategory.id));
                    this.drdTitle = rec.pageNo ? ('Page ' + rec.pageNo) : (rec.name || rec.label || 'Document');
                    this.drdCatId = catId || 0;
                    this.drdSelectedNoteId = rec.id;
                    // Doc items carry the remark in `label`; pages in `note_remark`.
                    this.drdRemark = (rec.note_remark !== undefined && rec.note_remark !== null && rec.note_remark !== '')
                        ? rec.note_remark : (rec.label || '');
