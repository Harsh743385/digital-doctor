            <div class="px-3 py-2 border-b border-slate-200 bg-white">
                <div class="flex items-center gap-2 bg-slate-100 border border-slate-100 rounded-full px-4 py-2.5 focus-within:bg-white focus-within:border-blue-300 focus-within:ring-1 focus-within:ring-blue-200 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:16px;height:16px;color:#64748b;display:block;flex:none;" class="lucide lucide-search"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                    <input type="search" placeholder="Search by name, UHID, IP number…" x-model="patientSearch" class="flex-1 outline-none text-sm bg-transparent placeholder-slate-400 min-w-0">
                    <!-- Clear-search affordance — only renders when the input
                         has text. Tapping resets the search to '' so the
                         drawer falls back to the full mode-filtered list. -->
                    <button type="button" x-show="patientSearch" @click="patientSearch = ''" class="p-0.5 rounded text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex-none" title="Clear search" aria-label="Clear search" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                    <!-- Date-range picker trigger. Sits inside the search row,
                         right of the search input. Opens the single-calendar
                         range dialog; tints teal and shows a dot when a range
                         is active. A thin divider separates it from the input. -->
                    <span class="w-px self-stretch bg-slate-200 flex-none"></span>
                    <button type="button" @click="openDatePicker()" class="relative p-1 rounded-md flex-none transition text-slate-400 hover:text-slate-600 hover:bg-slate-100" :class="(filterDateFrom || filterDateTo) ? 'text-teal-600 bg-teal-50' : 'text-slate-400 hover:text-slate-600 hover:bg-slate-100'" :title="patientMode === 'live' ? 'Filter by admission date' : 'Filter by discharge date'" aria-label="Filter by date" title="Filter by admission date">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar-days" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-calendar-days"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M8 13h.01"></path><path d="M12 13h.01"></path><path d="M16 13h.01"></path><path d="M8 17h.01"></path><path d="M12 17h.01"></path><path d="M16 17h.01"></path></svg>
                        <span x-show="filterDateFrom || filterDateTo" class="absolute top-0 right-0 w-1.5 h-1.5 rounded-full bg-teal-500 ring-2 ring-white" style="display: none;"></span>
                    </button>
                </div>
            </div>

            <!-- List. Infinite-scroll: when the user nears the bottom of
                 this container, loadMorePatients() pulls the next page and
                 appends to the list. Throttled in onPatientListScroll() so
                 the handler doesn't fire on every pixel of scroll. -->
            <div class="flex-1 overflow-auto bg-slate-100" @scroll.passive="onPatientListScroll($event)">
                <!-- Empty state — suppressed while the first page is still
                     loading so the app shows nothing (the "Loading…" chip in the
                     header covers it) instead of a premature "No patients". -->
                <template x-if="filteredPatients().length === 0 &amp;&amp; !patientsLoading"></template>
                <ul class="p-2 space-y-2">
                    <template x-for="p in filteredPatients()" :key="p.id"></template><li>
                            <button type="button" @click="selectPatient(p)" class="w-full text-left pl-2 pr-4 py-3 focus:outline-none transition rounded-xl border border-slate-200 border-l-4 shadow-sm bg-[#f0f2f5] border-l-red-500" :class="patientRowClass(p)">
                                <div class="flex items-start gap-3">
                                    <!-- Avatar: circular S3 photo when present;
                                         a teal two-letter initials disc otherwise.
                                         A photo that fails to load (expired URL /
                                         CORS) clears p.photo so the initials show.
                                         Pinned to the top of the card. Tapping the
                                         avatar opens the Patient Details modal
                                         (@click.stop so it doesn't select the row). -->
                                    <div class="flex-none self-start cursor-pointer" role="button" tabindex="0" title="View patient details" @click.stop="openPatientDetailsModal(p)" @keydown.enter.stop="openPatientDetailsModal(p)">
                                        <!-- Prefer the offline-cached blob (p.photoSrc,
                                             an object URL) over the presigned S3 URL
                                             (p.photo) so the avatar shows offline. On
                                             load failure, drop the failed source and
                                             fall back: photoSrc → photo → initials. -->
                                        <template x-if="p.photoSrc || p.photo"></template>
                                        <template x-if="!(p.photoSrc || p.photo)"></template><span class="w-16 h-16 rounded-2xl flex items-center justify-center text-lg font-semibold bg-blue-50 text-blue-600 border border-blue-200" x-text="p.initials || '?'">JA</span>
                                    </div>

                                    <!-- Details column -->
                                    <div class="min-w-0 flex-1">
                                        <!-- Name (with salutation) + age in braces —
                                             shown FIRST. Colour by gender: 1=Male
                                             blue, 2=Female pink, else purple. Age
                                             hidden when empty. Flagged patients get
                                             a light-red highlight. -->
                                        <div class="flex items-center gap-2 min-w-0">
                                            <div class="text-lg font-semibold truncate text-slate-900" :class="isFlagged(p) ? 'text-red-700 bg-red-50 rounded px-1 -mx-1' : 'text-slate-900'">
                                                <span x-text="p.name">JAGDISHBHAI AHUJA</span>
                                                <!-- Relative (salutation + name) in
                                                     { } braces, when present. -->
                                                <span x-show="p.relative_name" class="font-normal text-sm text-slate-500" x-text="'{' + (p.relative_salutation ? p.relative_salutation + ' ' : '') + (p.relative_name || '') + '}'" style="display: none;">{}</span>
                                            </div>
                                            <span x-show="p.gender || p.age" class="flex-none inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap bg-blue-50 text-blue-600 border-blue-100" :class="genderPillClass(p)" x-text="genderAgePill(p)">Male · 42 Y, 2 M, 12 D</span>
                                        </div>

                                        <!-- Then IPD No. / UHID No. as rounded pill
                                             badges with their own background colours.
                                             Clamped to 2 lines. -->
                                        <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-[11px] overflow-hidden" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">
                                            <!-- Flagged patients (MLC / allergic /
                                                 precaution) get a light-red pill +
                                                 name highlight; otherwise the pills
                                                 keep their teal / indigo colours. -->
                                            <span x-show="p.ipd" class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 bg-slate-100 text-slate-600 border-slate-200" :class="isFlagged(p) ? 'bg-red-50 text-red-700 border-red-200' : 'bg-slate-100 text-slate-600 border-slate-200'">
                                                <span class="font-medium text-slate-500" :class="isFlagged(p) ? 'text-red-500' : 'text-slate-500'">IPD No.</span>
                                                <span class="font-semibold" x-text="p.ipd">IP/2026-2027/1619</span>
                                            </span>
                                            <span x-show="p.uhid" class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 bg-slate-100 text-slate-600 border-slate-200" :class="isFlagged(p) ? 'bg-red-50 text-red-700 border-red-200' : 'bg-slate-100 text-slate-600 border-slate-200'">
                                                <span class="font-medium text-slate-500" :class="isFlagged(p) ? 'text-red-500' : 'text-slate-500'">UHID No.</span>
                                                <span class="font-semibold" x-text="p.uhid">AS6767</span>
                                            </span>
                                        </div>

                                        <!-- MLC badge (red highlighter) + admission
                                             reason. The Floor / Department / Bed
                                             details that used to sit here now render
                                             below the consultant (plain, no box). -->
                                        <div class="mt-1 flex items-start gap-1.5 text-[11px]" x-show="p.mlc || p.admission_reason" style="display: none;">
                                            <span x-show="p.mlc" class="flex-none inline-flex items-center rounded-md bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">MLC</span>
                                            <span x-show="p.admission_reason" class="min-w-0 truncate rounded-full border border-orange-200 bg-orange-50 px-2 py-0.5 font-medium text-orange-700" x-text="p.admission_reason" style="display: none;"></span>
                                        </div>

                                        <!-- Clinical-flag badges: AL = allergic,
                                             UP = universal precaution. (MLC sits
                                             on the floor-details row above.) -->
                                        <div class="mt-1 flex flex-wrap items-center gap-1.5" x-show="p.allergic || p.precautive" style="display: none;">
                                            <span x-show="p.allergic" title="Allergic" class="inline-flex items-center rounded-md bg-amber-100 text-amber-800 border border-amber-300 text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">AL</span>
                                            <span x-show="p.precautive" title="Universal Precaution" class="inline-flex items-center rounded-md bg-violet-100 text-violet-800 border border-violet-300 text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">UP</span>
                                        </div>

                                        <!-- Consulting doctor (next line) —
                                             name only, no label, no "Dr." prefix.
                                             Highlighted (teal + bold) and italic
                                             so the consultant stands out from the
                                             other care-team lines below. -->
                                        <div class="mt-0.5" x-show="docName(p)">
                                            <span class="inline-block max-w-full truncate rounded-full border border-blue-200 bg-blue-50 px-2 py-0.5 text-[11px] font-semibold italic text-blue-700" x-text="docName(p)">DR NARENDRA SHANGHAVI</span>
                                        </div>

                                        <!-- Floor · Department · Ward - Bed (plain
                                             text, no background), shifted to just under
                                             the consultant. Floor/department/ward render
                                             as one sequence joined with middle dots, and
                                             the bed name is bold, joined with a "-"
                                             suffix. Bed class on its own line when set. -->
                                        <div class="mt-1" x-show="floorDept(p) || p.bed || p.bed_class">
                                            <div class="text-[12px] font-medium text-slate-700 overflow-hidden" style="-webkit-line-clamp: 2; -webkit-box-orient: vertical;" x-show="floorDept(p) || p.bed">
                                                <span x-show="floorDept(p)" x-text="floorDept(p)">THIRD FLOOR</span>
                                                <span x-show="p.bed"><span x-show="floorDept(p)"> - </span><span class="font-bold" x-text="p.bed">GENERAL(01)  BED-08</span></span>
                                            </div>
                                            <div class="text-[10px] text-slate-400 truncate" x-show="p.bed_class" x-text="p.bed_class">GENERAL WARD</div>
                                        </div>

                                        <!-- Other consultants (below consulting
                                             doctor), comma-separated when present. -->
                                        <div class="text-[11px] text-slate-500 mt-0.5 truncate" x-show="p.other_consultants" style="display: none;">
                                            <span class="text-slate-400">Other Consultants:</span>
                                            <span class="font-medium text-slate-600" x-text="p.other_consultants"></span>
                                        </div>

                                        <!-- Referred-by doctor(s), next line,
                                             only when present. Comma-separated. -->
                                        <div class="text-[11px] mt-0.5" x-show="p.referred_by" style="display: none;">
                                            <span class="text-slate-400">Referred By Dr. </span>
                                            <span class="inline-block max-w-full truncate align-bottom font-medium text-cyan-700" x-text="p.referred_by"></span>
                                        </div>

                                        <!-- Provisional Diagnosis (field_id 15
                                             floating_view) — server sends '' when
                                             the toggle is off, hiding this line. -->
                                        <div class="text-[11px] text-slate-500 mt-0.5" x-show="p.provisional_diagnosis" style="display: none;">
                                            <span class="text-slate-400">Provisional Diagnosis:</span>
                                            <span class="font-medium text-slate-600" x-text="p.provisional_diagnosis"></span>
                                        </div>

                                        <!-- Final Diagnosis (field_id 16
                                             floating_view). -->
                                        <div class="text-[11px] text-slate-500 mt-0.5" x-show="p.final_diagnosis" style="display: none;">
                                            <span class="text-slate-400">Final Diagnosis:</span>
                                            <span class="font-medium text-slate-600" x-text="p.final_diagnosis"></span>
                                        </div>

                                        <!-- Admission → Discharge span (History /
                                             Cancelled only): centered between the
                                             consultant line and the payment row.
                                             Shown when both timestamps exist. -->
                                        <div class="mt-1 flex justify-center" x-show="patientMode !== 'live' &amp;&amp; p.admitted_at &amp;&amp; p.discharged_at" style="display: none;">
                                            <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 text-indigo-700 px-3 py-0.5 text-[11px] whitespace-nowrap">
                                                <span class="font-medium" x-text="fmtDateTime(p.admitted_at)">25-09-2026 08:30 am</span>
                                                <span class="mx-1.5 text-indigo-400 font-semibold">TO</span>
                                                <span class="font-medium" x-text="fmtDateTime(p.discharged_at)"></span>
                                            </span>
                                        </div>

                                        <!-- Payment type — "Cash" / "TPA" etc.,
                                             with the selected option in (braces)
                                             when one exists.  Claim-status chip
                                             (when set) sits at the right end. -->
                                        <div class="mt-0.5 flex items-center justify-between gap-2 text-[11px]" x-show="p.pmode_label || p.pmode_remark || claimLabel(p.claim_status)">
                                            <div class="min-w-0 flex items-center gap-1.5">
                                                <div class="flex-none truncate rounded-full border border-gray-300 bg-gray-100 px-2 py-0.5 text-gray-700" x-show="p.pmode_label">
                                                    <span class="font-semibold" x-text="p.pmode_label">TPA</span><span x-show="p.pmode_option" class="text-gray-500" x-text="' (' + p.pmode_option + ')'"> (IFFCO TOKIO General Insurance Co. Ltd.)</span>
                                                </div>
                                                <!-- Free-text payment remark next to the
                                                     payment pill, when present. Truncates
                                                     if long; full text on hover/title. -->
                                                <span x-show="p.pmode_remark" class="min-w-0 truncate italic text-gray-500" :title="p.pmode_remark" x-text="p.pmode_remark" title="" style="display: none;"></span>
                                            </div>
                                            <!-- x-if (not x-show): when there's no
                                                 label — claim_status 0 or any
                                                 unmapped code — the chip must not
                                                 render AT ALL. With x-show the
                                                 sibling :style binding re-applies the
                                                 style attribute and clobbers x-show's
                                                 display:none, leaking an empty red
                                                 box at the row end. x-if drops it
                                                 from the DOM, so no red shows. -->
                                            <template x-if="claimLabel(p.claim_status)"></template>
                                        </div>

                                        <!-- (Departmental discharge milestones used to
                                             render here, inside this narrow column, so
                                             each long pill took a line of its own. They
                                             now run as a full-width strip below the card
                                             body — see "Discharge clearance strip".) -->
                                    </div>

                                    <!-- Blood group — droplet sits just LEFT of the
                                         hospital-stay details, with extra left spacing
                                         (ml-3). Shown only when set; the short value
                                         (e.g. B+) is overlaid centered inside the red
                                         blood-drop. self-start keeps it aligned with
                                         the stay duration at the top of the row. -->
                                    <span x-show="p.blood_group" class="relative flex-none self-start ml-3" style="width: 26px; height: 30px; display: none;" :title="'Blood Group: ' + p.blood_group" aria-label="Blood group" title="Blood Group: ">
                                        <svg viewBox="0 0 30 34" width="26" height="30" style="display:block;filter:drop-shadow(0 1px 1.5px rgba(0,0,0,0.25));">
                                            <path d="M15 2 C15 2 5 14 5 22 a10 10 0 0 0 20 0 C25 14 15 2 15 2 Z" fill="#dc2626"></path>
                                        </svg>
                                        <span class="absolute inset-0 flex items-center justify-center text-white font-bold" style="font-size:9px;line-height:1;padding-top:7px;" x-text="p.blood_group"></span>
                                    </span>

                                    <!-- Hospitalization duration, pinned to the
                                         RIGHT end of the row (mirrors the avatar on
                                         the left) with a thin vertical divider before
                                         it. Live mode → admission→now (ticks each
                                         minute via nowTick, caption "Admitted").
                                         History/Cancelled → admission→discharge
                                         (caption "Stay"). 'NA' shown when the span is
                                         negative. Hidden when there's no admit time,
                                         or no discharge time outside Live mode. -->
                                    <!-- Right rail: stay-duration pill (when admitted)
                                         with a file-icon "N pages" badge beneath it.
                                         The badge shows the total written pages and
                                         opens the Full Patient File viewer; @click.stop
                                         keeps it from triggering the card's select. -->
                                    <div class="flex-none flex flex-col items-end gap-1.5">
                                        <!-- Admission duration — plain text with a
                                             colour-coded status dot (no background),
                                             pinned to the top-right corner. Red dot for
                                             a long-stay highlight, amber otherwise. -->
                                        <template x-if="p.admitted_at &amp;&amp; (patientMode === 'live' || p.discharged_at)"></template><span class="inline-flex items-center gap-1 text-sm font-semibold tabular-nums whitespace-nowrap text-red-600" :class="isLongStayHighlight(p) ? 'text-red-600' : 'text-slate-700'">
                                                <span class="w-1.5 h-1.5 rounded-full flex-none bg-red-500" :class="isLongStayHighlight(p) ? 'bg-red-500' : 'bg-amber-400'"></span>
                                                <span x-text="hospitalizeDuration(p.admitted_at, patientMode === 'live' ? null : p.discharged_at)">40d 13h 0m</span>
                                            </span>
                                        <!-- IPD History icon + written-pages badge on
                                             one row. The history icon sits to the LEFT
                                             of the "N pages" badge and only renders when
                                             this patient's mr_number matches a prior
                                             discharged admission in the same hospital
                                             (p.has_ipd_history) → a returning patient. -->
                                        <!-- OPD History · IPD History · pages — all three
                                             are labelled pills of the same size, and the
                                             row WRAPS so a narrow drawer stacks them
                                             instead of squashing. The labels shorten to
                                             "OPD"/"IPD" below sm so nothing truncates. -->
                                        <div class="flex items-center justify-end flex-wrap gap-1.5">
                                            <!-- Gated by the CACHED mst_hospital flags
                                                 (me.opd_history / me.patient_history_display,
                                                 1 = show). Read from `me`, which is
                                                 persisted to localStorage at login and
                                                 rewritten by Refresh app — never a
                                                 per-tap lookup, so this works offline. -->
                                            <template x-if="me &amp;&amp; me.opd_history === 1"></template>
                                            <template x-if="p.has_ipd_history &amp;&amp; me &amp;&amp; me.patient_history_display === 1"></template>
                                            <!-- Total written pages, grey badge →
                                                 opens the Full Patient File viewer. -->
                                            <span role="button" tabindex="0" @click.stop="openFullFile(p)" @keydown.enter.stop="openFullFile(p)" class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-slate-100 text-slate-600 px-2 py-1 text-[11px] font-semibold whitespace-nowrap hover:bg-slate-200 cursor-pointer transition" title="Open full patient file">
                                                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M16 13H8M16 17H8M10 9H8"></path>
                                                </svg>
                                                <span x-text="(p.page_count || 0) + ' pages'">14 pages</span>
                                            </span>
                                        </div>
                                        <!-- Edit patient record — large icon below the
                                             stay-duration; opens the IPD edit-patient
                                             page for this patient. @click.stop keeps it
                                             from triggering the card's select. -->
                                        <span role="button" tabindex="0" @click.stop="editPatientRecord(p)" @keydown.enter.stop="editPatientRecord(p)" class="mt-0.5 inline-flex items-center justify-center w-11 h-11 rounded-full border border-blue-200 bg-blue-50 text-blue-600 hover:bg-blue-100 cursor-pointer transition" title="Edit patient record" aria-label="Edit patient record">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="square-pen" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg>
                                        </span>
                                        <!-- Discharge patient — large icon below the
                                             edit icon; opens the IPD discharge-form
                                             page for this patient in the floating
                                             window. @click.stop keeps it from
                                             triggering the card's select. -->
                                        <span role="button" tabindex="0" @click.stop="dischargePatient(p)" @keydown.enter.stop="dischargePatient(p)" class="mt-1.5 inline-flex items-center justify-center w-11 h-11 rounded-full border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100 cursor-pointer transition" title="Discharge patient" aria-label="Discharge patient">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-log-out"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                                        </span>
                                    </div>
                                </div>

                                <!-- ── Discharge clearance strip ──────────────────
                                     Departmental sign-offs: Clinical, Pharmacy,
                                     Implant, OT Pharmacy, Lab, Radiology, Billing —
                                     each shown only once its timestamp is recorded.
                                     Sits OUTSIDE the three-column body so it spans the
                                     full card width, starting at the left edge under
                                     the patient photo. Inside the details column the
                                     pills were ~330px each in a ~55%-width box, so
                                     every one wrapped onto its own line; short
                                     department names + a year-less timestamp now fit
                                     several per row. Full label and timestamp stay in
                                     the tooltip. -->
                                <div class="mt-2 pt-2 border-t border-slate-200" x-show="(p.discharge_milestones || []).length" style="display: none;">
                                    <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                                        <span class="inline-flex items-center gap-1 text-[9px] font-bold uppercase tracking-wider text-slate-400 whitespace-nowrap">
                                            <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                                <path d="M20 6 9 17l-5-5"></path>
                                            </svg>
                                            <span>Discharge Cleared</span>
                                        </span>
                                        <template x-for="ms in (p.discharge_milestones || [])" :key="ms.label"></template>
                                    </div>
                                </div>

                                <!-- Discharge Summary ready banner (bottom of the
                                     card) — shown when tbl_discharge_summary.status = 1
                                     for this patient. -->
                                <div x-show="p.discharge_summary_ready" class="mt-2 rounded-lg border border-red-300 bg-red-400 text-yellow-100 px-3 py-0.5 text-[11px] font-semibold text-center" x-text="'Discharge Summary Ready For ' + p.name + ' ' + (p.ds_discharge_date || '') + ' ' + (p.ds_discharge_time || '') + '.'" style="display: none;">Discharge Summary Ready For JAGDISHBHAI AHUJA  .</div>
                            </button>
                        </li><li>
