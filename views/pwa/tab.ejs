                // from the loaded category rows (their cached thumbUrl).
                rbBgForBook(bookId) {
                    const row = this.rbRows.find((r) => r.book_id === bookId);
                    return (row && row.thumbUrl) || '';
                },
                // Confirm-dialog "Delete" → close the dialog and soft-delete the
                // page (moves it to the recycle bin via rbDeleteEditingPage).
