                _patientsViewIsClean() {
                    if ((this.patientSearch || '').trim() !== '') return false;
                    if (this.filterFloorId != null || this.filterDeptId != null || this.filterUnitId != null) return false;
                    if (this.filterPmode != null || this.filterPmodeSub != null || this.filterDischargeReasonId != null) return false;
                    if (this.filterNoActivity === 1) return false;
                    if ((this.filterWardIds || []).length || (this.filterConsultantIds || []).length
                        || (this.filterOtherConsultantIds || []).length || (this.filterReasonIds || []).length) return false;
                    if ((this.filterDateFrom || '') !== '' || (this.filterDateTo || '') !== '') return false;
                    if (this.filterSort && this.filterSort !== 'date') return false;
                    return true;
                },
                // Separate key for the COMPLETE census snapshot (every page,
                // unfiltered) — kept apart from the per-mode page-1 cache above so
                // the on-screen filtered view never overwrites the full offline list.
                _patientsFullCacheKey(mode) { return 'patients-full:' + this._hid() + ':' + (mode || 'live'); },
                _mastersCacheKey()      { return 'masters:'  + this._hid(); },
                _pagesCacheKey(patientId, catId) { return 'pages:' + patientId + ':' + catId; },

                // Is this row the currently-open category? Drives the
                // translucent-blue selection highlight in the category lists.
                // Live categories carry a stable `id`; the demo fallback rows
                // only have `i`, so match on id when both have one, else on i.
                isCatSelected(cat) {
                    const v = this.viewerCategory;
                    if (!v || !cat) return false;
                    if (v.id != null && cat.id != null) return v.id === cat.id;
                    return v.i === cat.i;
                },

                // Drop the Hand Written tab's category selection (highlight + the
                // "Last selected" hint). Called when a button on ANOTHER tab opens
                // a view in the main pane, so the old Hand Written row no longer
                // looks selected.
                _clearHandWrittenSelection() {
                    this.viewerCategory = null;
                    this.selectedCategoryIndex = null;
                    this.selectedCategoryLabel = '';
                },

                async openCategory(cat) {
                    // Switching forms with unsaved strokes? Ask to save/discard.
                    if (this._guardEditExit(() => this.openCategory(cat))) return;
                    this.selectedCategoryIndex = cat.i;
                    this.selectedCategoryLabel = cat.label;
                    this.viewerCategory = cat;
                    // Re-arm the one-shot grid/detail bg refresh for this open.
                    this._viewerBgRetried = false;
                    this.viewerActiveRecord = null;
                    this.viewerActiveIndex = 0;
                    this.docViewOpen = false;   // never both panes at once
                    this.webOpen = false;
                    this.pdfOpen = false;       // close any floating PDF viewer
                    this.viewerOpen = true;
                    this.rightOpen = false;

                    // "All IPD Categories": aggregate every category's pages
                    // in category-display order (live mode only — the demo
                    // path below reads its seeded stub records for cat.i === 0).
                    if (cat.isAll && this.categoriesLive && this.selectedPatientId) {
                        this.viewerRecords = [];
                        this.viewerMode = 'empty';
