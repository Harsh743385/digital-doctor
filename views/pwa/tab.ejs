                            </button>
                        </li>
                </ul>

                <!-- Infinite-scroll footer rows. Inside the scroll
                     container on purpose so they slide into view as the
                     user reaches the bottom:
                       • Loading more  — spinner while the next page fetches
                       • Reached end   — subtle "All N patients loaded" hint
                     The empty-state template above already covers patients.length === 0. -->
                <div x-show="patientsLive &amp;&amp; patientsLoadingMore" class="px-4 py-3 text-center text-xs text-teal-600 flex items-center justify-center gap-1.5" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="loader" aria-hidden="true" class="lucide lucide-loader animate-spin" style="width:14px;height:14px;display:block;"><path d="M12 2v4"></path><path d="m16.2 7.8 2.9-2.9"></path><path d="M18 12h4"></path><path d="m16.2 16.2 2.9 2.9"></path><path d="M12 18v4"></path><path d="m4.9 19.1 2.9-2.9"></path><path d="M2 12h4"></path><path d="m4.9 4.9 2.9 2.9"></path></svg>
                    <span>Loading more…</span>
                </div>
                <div x-show="patientsLive &amp;&amp; !patientsHasMore &amp;&amp; !patientsLoadingMore &amp;&amp; patients.length &gt; 0 &amp;&amp; patientsTotal &gt; 0" class="px-4 py-3 text-center text-[11px] text-slate-400" x-text="'All ' + patientsTotal + ' patient' + (patientsTotal === 1 ? '' : 's') + ' loaded'" style="">All 28 patients loaded</div>
            </div>

        </aside>

        <!-- Right drawer: Forms browser -->
        <aside x-show="rightOpen" x-transition:enter="transition transform ease-out duration-200" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition transform ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="fixed inset-y-0 right-0 z-40 w-[92vw] max-w-2xl bg-white shadow-2xl flex flex-col" style="display: none;">
            <!-- Patient name banner. With no patient selected it reads
                 "No Patient selected" and the whole drawer body below is blank. -->
            <div class="px-4 py-3 border-b border-slate-200 flex items-center gap-2 bg-white">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-blue-50 text-blue-600" :class="selectedPatientId ? 'bg-blue-50 text-blue-600' : 'bg-slate-100 text-slate-400'">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="user" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </span>
                <div class="flex-1 font-semibold text-base truncate text-blue-700" :class="selectedPatientId ? 'text-blue-700' : 'text-slate-400'" x-text="selectedPatientId ? ('Patient Name : ' + patientName) : 'No Patient selected'">Patient Name : JAGDISHBHAI AHUJA</div>
                <!-- Offline Bin — pages saved offline (queued, awaiting upload)
                     for this patient. Sits to the LEFT of the Recycle Bin. -->
                <button type="button" x-show="selectedPatientId" @click="openBin('offline')" class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-white font-semibold text-sm shadow bg-amber-500 hover:bg-amber-600" title="Offline Bin" aria-label="Offline Bin" style="">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="cloud-off" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-cloud-off"><path d="M10.94 5.274A7 7 0 0 1 15.71 10h1.79a4.5 4.5 0 0 1 4.222 6.057"></path><path d="M18.796 18.81A4.5 4.5 0 0 1 17.5 19H9A7 7 0 0 1 5.79 5.78"></path><path d="m2 2 20 20"></path></svg>
                    <span>Offline Bin</span>
                </button>
                <!-- Recycle Bin — delete icon + label, at the right end of the
                     banner (shown when a patient is selected). -->
                <button type="button" x-show="selectedPatientId &amp;&amp; !me.hide_recycle_bin" @click="openBin('recycle')" class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-white font-semibold text-sm shadow bg-red-500 hover:bg-red-600" title="Recycle Bin" aria-label="Recycle Bin" style="">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Recycle Bin</span>
                </button>
                <!-- Close: the search-row X is hidden with no patient, so the
                     drawer stays closeable from here in that state. -->
                <button type="button" x-show="!selectedPatientId" @click="rightOpen = false" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-500" aria-label="Close" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                </button>
            </div>

            <!-- Search row -->
            <div x-show="selectedPatientId" class="px-3 py-2 flex items-center gap-2 border-b border-slate-100 bg-white" style="">
                <div class="flex-1 flex items-center gap-2 border border-slate-300 rounded-lg px-3 py-1.5 bg-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:16px;height:16px;color:#64748b;display:block;" class="lucide lucide-search"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                    <!-- Narrowing the search re-filters the list, so drop back to
                         the first page of rows (otherwise a search run after
                         scrolling would render every match at once). -->
                    <input type="search" placeholder="Search Category" x-model="search" @input="resetCategoryWindow()" class="flex-1 outline-none text-sm bg-transparent placeholder-slate-400">
                </div>
                <!-- Bunch filter — colored dropdown grouping categories by
                     category_color_code. First entry is the "All Bunches"
                     reset. The "#00000000" (transparent) bucket gets the
                     literal label "Blank Color". Hidden when every category
                     shares the blank code (bunchFilterVisible() → false). -->
                <div x-show="bunchFilterVisible()" class="relative" style="">
                    <button type="button" @click="bunchFilterOpen = !bunchFilterOpen" class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm bg-white text-slate-700 flex items-center gap-1.5 min-w-[8rem] hover:bg-slate-50">
                        <span class="inline-block w-3 h-3 rounded border border-slate-300 flex-shrink-0" :style="bunchFilter ? ('background-color: ' + bunchFilter + ';') : 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                        <span class="flex-1 truncate text-left" x-text="bunchFilterLabel()">All Bunches</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" :data-lucide="bunchFilterOpen ? 'chevron-up' : 'chevron-down'" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <div x-show="bunchFilterOpen" @click.outside="bunchFilterOpen = false" x-transition.opacity="" class="absolute right-0 top-full mt-1 z-30 min-w-[14rem] max-h-72 overflow-auto bg-white border border-slate-200 rounded-lg shadow-lg" style="display:none">
                        <button type="button" @click="selectBunch(null)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:bg-slate-50 border-b border-slate-100 transition font-semibold text-slate-800 bg-slate-50" :class="!bunchFilter ? 'font-semibold text-slate-800 bg-slate-50' : 'text-slate-700'">
                            <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                            <span class="flex-1">All Bunches</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="!bunchFilter" style="width: 14px; height: 14px;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                        </button>
                        <template x-for="opt in bunchOptions()" :key="opt.colorHex"></template><button type="button" @click="selectBunch(opt.colorHex)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:brightness-95 transition border-b border-slate-100" :style="opt.colorHex !== '#00000000' ? ('background-color: ' + opt.colorHex + '33;') : ''" :class="bunchFilter === opt.colorHex ? 'font-semibold' : ''" style="">
                                <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" :style="opt.colorHex === '#00000000'
                                                ? 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'
                                                : ('background-color: ' + opt.colorHex + ';')" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                                <span class="flex-1 truncate text-slate-800" x-text="opt.displayLabel">Blank Color</span>
                                <span class="text-[11px] text-slate-500 tabular-nums" x-text="'(' + opt.count + ')'">(313)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="bunchFilter === opt.colorHex" style="width: 14px; height: 14px; display: none;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            </button><button type="button" @click="selectBunch(opt.colorHex)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:brightness-95 transition border-b border-slate-100" :style="opt.colorHex !== '#00000000' ? ('background-color: ' + opt.colorHex + '33;') : ''" :class="bunchFilter === opt.colorHex ? 'font-semibold' : ''" style="background-color: #81d4fa33;">
                                <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" :style="opt.colorHex === '#00000000'
                                                ? 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'
                                                : ('background-color: ' + opt.colorHex + ';')" style="background-color: #81d4fa;"></span>
                                <span class="flex-1 truncate text-slate-800" x-text="opt.displayLabel">#81d4fa</span>
                                <span class="text-[11px] text-slate-500 tabular-nums" x-text="'(' + opt.count + ')'">(23)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="bunchFilter === opt.colorHex" style="width: 14px; height: 14px; display: none;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            </button><button type="button" @click="selectBunch(opt.colorHex)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:brightness-95 transition border-b border-slate-100" :style="opt.colorHex !== '#00000000' ? ('background-color: ' + opt.colorHex + '33;') : ''" :class="bunchFilter === opt.colorHex ? 'font-semibold' : ''" style="background-color: #ef9a9a33;">
                                <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" :style="opt.colorHex === '#00000000'
                                                ? 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'
                                                : ('background-color: ' + opt.colorHex + ';')" style="background-color: #ef9a9a;"></span>
                                <span class="flex-1 truncate text-slate-800" x-text="opt.displayLabel">#ef9a9a</span>
                                <span class="text-[11px] text-slate-500 tabular-nums" x-text="'(' + opt.count + ')'">(4)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="bunchFilter === opt.colorHex" style="width: 14px; height: 14px; display: none;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            </button><button type="button" @click="selectBunch(opt.colorHex)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:brightness-95 transition border-b border-slate-100" :style="opt.colorHex !== '#00000000' ? ('background-color: ' + opt.colorHex + '33;') : ''" :class="bunchFilter === opt.colorHex ? 'font-semibold' : ''" style="background-color: #fff59d33;">
                                <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" :style="opt.colorHex === '#00000000'
                                                ? 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'
                                                : ('background-color: ' + opt.colorHex + ';')" style="background-color: #fff59d;"></span>
                                <span class="flex-1 truncate text-slate-800" x-text="opt.displayLabel">#fff59d</span>
                                <span class="text-[11px] text-slate-500 tabular-nums" x-text="'(' + opt.count + ')'">(2)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="bunchFilter === opt.colorHex" style="width: 14px; height: 14px; display: none;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            </button><button type="button" @click="selectBunch(opt.colorHex)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:brightness-95 transition border-b border-slate-100" :style="opt.colorHex !== '#00000000' ? ('background-color: ' + opt.colorHex + '33;') : ''" :class="bunchFilter === opt.colorHex ? 'font-semibold' : ''" style="background-color: #ffab9133;">
                                <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" :style="opt.colorHex === '#00000000'
                                                ? 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'
                                                : ('background-color: ' + opt.colorHex + ';')" style="background-color: #ffab91;"></span>
                                <span class="flex-1 truncate text-slate-800" x-text="opt.displayLabel">#ffab91</span>
                                <span class="text-[11px] text-slate-500 tabular-nums" x-text="'(' + opt.count + ')'">(11)</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="bunchFilter === opt.colorHex" style="width: 14px; height: 14px; display: none;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                            </button>
                    </div>
                </div>
                <button type="button" @click="refresh()" :disabled="categoriesLoading" class="w-9 h-9 rounded-full bg-sky-500 hover:bg-sky-600 text-white flex items-center justify-center shadow" :class="categoriesLoading ? 'opacity-60 cursor-wait' : ''" :title="selectedPatientId ? 'Refresh this patient\'s category list' : 'Refresh categories'" aria-label="Refresh" title="Refresh this patient's category list">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="refresh-cw" aria-hidden="true" :class="categoriesLoading ? 'animate-spin' : ''" style="width:16px;height:16px;display:block;" class="lucide lucide-refresh-cw animate-spin"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
                </button>
                <button type="button" @click="rightOpen = false" class="w-9 h-9 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-500" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                </button>
            </div>

            <!-- Tabs -->
            <div x-show="selectedPatientId" class="grid grid-cols-3 border-b border-slate-200 bg-white" style="">
                <template x-for="t in tabs" :key="t.key"></template><button type="button" @click="activeTab = t.key" class="flex items-center justify-center gap-1.5 py-2.5 text-sm font-medium border-b-2 transition-colors border-transparent text-slate-600 hover:bg-slate-50" :class="activeTab === t.key
                            ? 'bg-sky-50 border-sky-400 text-slate-800'
                            : 'border-transparent text-slate-600 hover:bg-slate-50'">
                        <span x-text="t.emoji">✍️</span>
                        <span x-text="t.label">Hand Written</span>
                    </button><button type="button" @click="activeTab = t.key" class="flex items-center justify-center gap-1.5 py-2.5 text-sm font-medium border-b-2 transition-colors bg-sky-50 border-sky-400 text-slate-800" :class="activeTab === t.key
                            ? 'bg-sky-50 border-sky-400 text-slate-800'
                            : 'border-transparent text-slate-600 hover:bg-slate-50'">
                        <span x-text="t.emoji"></span>
                        <span x-text="t.label">Digital NABH</span>
                    </button><button type="button" @click="activeTab = t.key" class="flex items-center justify-center gap-1.5 py-2.5 text-sm font-medium border-b-2 transition-colors border-transparent text-slate-600 hover:bg-slate-50" :class="activeTab === t.key
                            ? 'bg-sky-50 border-sky-400 text-slate-800'
                            : 'border-transparent text-slate-600 hover:bg-slate-50'">
                        <span x-text="t.emoji">🖼️</span>
                        <span x-text="t.label">Gallery | Labs</span>
                    </button>
            </div>

            <!-- Drawer body: Hand Written tab carries all the form content
                 (main category list + payment forms + saved pages). Other
                 tabs render an empty-state placeholder for now. Hidden (blank)
                 until a patient is selected. -->
            <div x-show="selectedPatientId" class="flex-1 overflow-auto bg-white" @scroll.passive="onCategoryListScroll($event)" style="">
                <!-- Offline-prefetch loader — sticky banner while the hospital's
                     form templates are being downloaded + stored for offline use.
                     Spinner + live count + a thin progress bar. Auto-hides when
                     the prefetch pass finishes. -->
                <div x-show="formsCaching" x-transition.opacity="" class="sticky top-0 z-20 bg-teal-50 border-b border-teal-100 px-4 py-2">
                    <div class="flex items-center gap-2 text-xs font-medium text-teal-700">
                        <svg class="animate-spin flex-none" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span class="flex-1 min-w-0 truncate">Saving forms for offline use…</span>
                        <span class="tabular-nums flex-none"><span x-text="formsCacheReady">300</span>/<span x-text="formsCacheTotal">352</span></span>
                    </div>
                    <div class="mt-1.5 h-1 rounded-full bg-teal-100 overflow-hidden">
                        <div class="h-full bg-teal-500 transition-all duration-300" :style="'width: ' + (formsCacheTotal &gt; 0 ? Math.round((formsCacheReady / formsCacheTotal) * 100) : 0) + '%;'" style="width: 85%;"></div>
                    </div>
                </div>

                <!-- ── HAND WRITTEN TAB ──────────────────────────────────── -->
                <div x-show="activeTab === 'hand-written'" style="display: none;">

                    <!-- Main hospital-scoped category list. Card rows, identical in
                         shape to the IPD Page Templates drawer: serial tile · name
                         (max two lines) · page count, tinted by the category colour
                         and ring-highlighted while selected. -->
                    <ul class="p-3 space-y-2">
                        <template x-for="(cat, idx) in visibleCategories()" :key="cat.id || cat.i"></template><li>
                                <button type="button" @click="openCategory(cat)" class="w-full text-left rounded-xl border border-slate-200 bg-white shadow-sm hover:shadow transition flex items-stretch overflow-hidden" :class="isCatSelected(cat) ? 'ring-2 ring-blue-600' : ''" :style="ipdRowTint(cat)" style="">
                                    <!-- Serial tile. The pinned "All Categories" row
                                         gets the teal tile so it still reads as the
                                         aggregate, not category number 1. -->
                                    <div class="w-11 shrink-0 flex flex-col items-center justify-center text-white font-bold bg-teal-600" :class="cat.isAll ? 'bg-teal-600' : 'bg-slate-500'">
                                        <!-- x-if, not x-show: catSerialNo() is 0 for the
                                             All row, and lucide swaps the <i> for an
                                             <svg>, which an x-show binding wouldn't survive. -->
                                        <template x-if="cat.isAll"></template><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layers" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-layers"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>
                                        <template x-if="!cat.isAll"></template>
                                    </div>
                                    <!-- Name wraps to at most TWO lines, then ellipsises. -->
                                    <div class="flex-1 min-w-0 px-3 py-2.5 self-center">
                                        <div class="text-slate-800 text-sm leading-tight line-clamp-2 font-bold" :class="cat.isAll ? 'font-bold' : 'font-semibold'" x-text="cat.label || '—'">All IPD Categories</div>
                                    </div>
