                    } catch (_) {
                        // Fallback: hard-navigate to the login screen.
                        window.location.assign('./login');
                    }
                },

                // ── Web-push notifications (laravel-notification-channels/webpush) ──
                // Subscribe THIS tablet's browser to push after login, keyed to the
                // signed-in user, so the same server notifications that reach the
                // IPD web app (bed/floor changes, patient register/discharge,
                // requisition created) also reach the tablet. Best-effort: every
                // failure is swallowed so push never blocks the app.
                async _initPushNotifications() {
                    try {
                        const key = this.me && this.me.vapid_public_key;
                        if (!key || !(this.me && this.me.user_id)) return;   // no VAPID / not logged in

                        // One-time: a FOREGROUND push → in-app toast. Fed by the SW
                        // (web-push path) OR the native wrapper (PrescoPush.onMessage).
                        if (!this._pushMsgListenerAdded) {
                            this._pushMsgListenerAdded = true;
                            this._showPushToast = (payload) => {
                                const p = (typeof payload === 'string') ? this._tryParseJson(payload) : payload;
                                const msg = p && [p.title, p.body].filter(Boolean).join(' — ');
