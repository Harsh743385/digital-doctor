    <!-- PWA bootstrap: SW registration + install-prompt capture -->
    <script>
        // Service worker — relative path so the PWA installs cleanly under
        // any sub-directory (e.g. https://app.example.com/pwa/).
        if ('serviceWorker' in navigator) {
            // When a NEW service worker takes control (after a deploy bumps
            // sw.js / CACHE_NAME), reload ONCE so the page runs under it
            // immediately — otherwise the old SW keeps serving the old shell +
            // cached /api/ responses and offline fixes never take effect. The
            // SW's skipWaiting()/clients.claim() trigger this controllerchange.
            let __swReloaded = false;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
                if (__swReloaded) return;
                __swReloaded = true;
                window.location.reload();
            });
            window.addEventListener('load', () => {
                // Scope = the PARENT directory (…/pwa), not …/pwa/, so the SW also
                // controls the modules Home screen at …/pwa (no trailing slash) —
                // letting it load offline — alongside every …/pwa/* sub-page.
                // Derived from the current path so it's correct under any mount
                // point; falls back to './' (the old /pwa/ scope) if anything's off.
                let swScope = './';
                try {
                    const dir = location.pathname.replace(/\/[^/]*$/, '');   // /pwa/ipd -> /pwa
                    if (dir && dir !== '/') swScope = dir;
                } catch (_) {}
                navigator.serviceWorker.register('./sw.js', { scope: swScope })
                    .then((reg) => {
                        try { reg.update(); } catch (_) {}
                        // Actively poll for a new shell so deployed changes appear
                        // WITHOUT a logout/login. The browser only auto-checks the
                        // SW on navigation + ~every 24h; we check far more often:
                        //   - every 30s while the app is open, and
                        //   - whenever it regains focus / comes back online.
                        // When a new SW is found it installs → skipWaiting →
                        // activate → controllerchange → the reload above fires.
                        const checkForUpdate = () => { try { reg.update(); } catch (_) {} };
                        setInterval(checkForUpdate, 30000);
                        document.addEventListener('visibilitychange', () => { if (!document.hidden) checkForUpdate(); });
                        window.addEventListener('online', checkForUpdate);
                    })
                    .catch((e) => console.warn('[pwa] SW registration failed:', e));
            });
        }

        // Push the page edge-to-edge so the OS status/navigation bars overlay
        // it instead of shrinking it.
        //
        // ONLY skip when we're already in true fullscreen (manifest
        // display:fullscreen honoured). In 'standalone' — which is how an
        // installed Chrome PWA runs until the fullscreen manifest is picked up
        // — the Android status + navigation bars STILL show and reserve space,
        // shrinking the work area (see the consent-screen report). The
        // Fullscreen API fixes that, but only from a user gesture, so we arm a
        // listener that requests fullscreen on the first tap/key. It re-arms if
        // the user later swipes out of fullscreen, so the bedside screen stays
        // edge-to-edge for the whole session.
        (function attachFullscreenOnFirstGesture() {
            // Skip inside the native WebView wrapper — it owns immersive
            // fullscreen; calling requestFullscreen there triggers
            // onShowCustomView and re-parents the page. Detected via UA marker.
            if (/PrescoWrapper/i.test(navigator.userAgent)) return;
            const isFullscreen = () => !!(window.matchMedia
                && window.matchMedia('(display-mode: fullscreen)').matches)
                || !!document.fullscreenElement;
            if (isFullscreen()) return;

            const el = document.documentElement;
            const req = el.requestFullscreen
                     || el.webkitRequestFullscreen
                     || el.msRequestFullscreen;
            if (!req) return;   // iOS Safari etc. — no Fullscreen API; manifest only

            const goFullscreen = () => {
                if (!document.fullscreenElement) {
                    try { req.call(el).catch(() => {}); } catch (_) {}
                }
            };
            // Not {once:true}: keep listening so a swipe-to-exit re-enters
            // fullscreen on the next interaction. goFullscreen no-ops while
            // already fullscreen, so it costs nothing.
            window.addEventListener('pointerdown', goFullscreen, { capture: true });
            window.addEventListener('keydown', goFullscreen, { capture: true });
        })();

        // Hold beforeinstallprompt so the in-app button can replay it
        // (Chrome / Edge fire this once per visit).
        window.__deferredInstall = null;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            window.__deferredInstall = e;
            window.dispatchEvent(new Event('pwa-installable'));
        });
        window.addEventListener('appinstalled', () => {
            window.__deferredInstall = null;
            window.dispatchEvent(new Event('pwa-installed'));
        });
    </script>

