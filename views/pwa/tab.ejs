                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                async saveDocRemarkDir() {
                    // Add-remark/directory grant (p_id 88). The dialog is viewable
                    // by everyone; saving requires the grant. Privileged roles
                    // (1/2/10) are granted server-side.
                    if (!(this.me && this.me.can_add_remark_dir)) {
                        this.showToast('You have not authority to Set Remark / Directory.', 'error');
                        return;
                    }
                    if (!this.drdSelectedNoteId) return;
                    this.drdSaving = true;
                    try {
                        const body = new URLSearchParams();
                        body.append('note_remark', this.drdRemark || '');
                        body.append('folder_id', String(this.drdFolderId || 0));
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch('./api/patients/' + encodeURIComponent(this.selectedPatientId)
                            + '/other-documents/' + encodeURIComponent(this.drdSelectedNoteId) + '/remark', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: Object.assign(
                                { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                            body: body.toString(),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) { this.showToast('Could not save', 'error'); return; }
                        // Reflect the change on the page record AND/OR doc record.
                        const rec = (this.viewerRecords || []).find(r => Number(r.id) === Number(this.drdSelectedNoteId));
                        if (rec) { rec.note_remark = this.drdRemark; rec.folder_id = this.drdFolderId; }
                        const doc = (this.docExisting || []).find(r => Number(r.id) === Number(this.drdSelectedNoteId));
