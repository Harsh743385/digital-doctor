                        <div class="flex-1 min-w-0 px-4 py-4 self-center">
                            <div class="font-semibold text-slate-800 text-base leading-snug line-clamp-2">Discharge Summary</div>
                        </div>
                        <div class="shrink-0 self-center pl-2 pr-4 text-right">
                            <div class="text-2xl font-bold leading-none tabular-nums text-slate-700" :class="docCounts.discharge &gt; 0 ? 'text-red-600' : 'text-slate-700'" x-text="docCounts.discharge">0</div>
                            <div class="text-[10px] uppercase tracking-wide text-slate-400">records</div>
                        </div>
                    </button>
                </div>

                <!-- ── OTHER TABS (placeholder) ────────────────────────────
                     Fallback empty-state for any tab without its own content.
                     (All four tabs currently have content, so this is inert.) -->
                <div x-show="activeTab !== 'hand-written' &amp;&amp; activeTab !== 'modules' &amp;&amp; activeTab !== 'gallery-labs' &amp;&amp; activeTab !== 'digital-nabh'" class="px-6 py-10 text-center text-sm text-slate-500" style="display: none;">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-400 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="folder" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                    </div>
                    <div class="font-medium text-slate-700">No forms here yet</div>
                    <div class="text-xs mt-1">Forms live under the Hand Written tab.</div>
                </div>

                <!-- ── MODULES TAB — account actions (Sign out lives here now) ── -->
                <div x-show="activeTab === 'modules'" class="px-6 py-6" style="display: none;">
                    <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-2">Account</div>
                    <form x-show="me.user_id" method="POST" :action="logoutUrl" action="https://prescoipd.com/v1/ipd/pwa/logout" style="">
                        <input type="hidden" name="_token" :value="csrfToken" value="GsMZ089OL6REykHKtondnN9gl3xXeq4H7fqUUC3c">
                        <button type="submit" class="w-full text-left flex items-center gap-2.5 px-4 py-3 rounded-lg border border-rose-200 bg-rose-50 text-rose-700 hover:bg-rose-100 text-base font-medium transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-log-out"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                            <span class="flex-1 min-w-0 truncate">Sign out</span>
                            <span class="w-3 h-3 rounded-full flex-shrink-0 transition-colors bg-rose-300" :class="activeDoc === 'Sign out' ? 'bg-rose-500' : 'bg-rose-300'"></span>
                        </button>
                    </form>
                    <p x-show="!me.user_id" class="text-sm text-slate-500" style="display: none;">Not signed in.</p>

                    <!-- Activity / error log — recorded locally, exportable as a
                         presco-ipd-log text file the user can save to Documents. -->
                    <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-6 mb-2" x-init="refreshLogCount()">Activity Log</div>
                    <p class="text-xs text-slate-500 mb-2.5 leading-relaxed">
                        All activity and errors are recorded on this device
                        (<span class="font-semibold tabular-nums" x-text="logCount">3044</span> entries).
                        Download the <span class="font-semibold">presco-ipd-log</span> file to review
                        error logs / bug reasons or share it for support.
                    </p>
                    <div class="flex gap-2">
                        <button type="button" @click="downloadLog()" class="flex-1 text-left flex items-center gap-2.5 px-4 py-3 rounded-lg border border-sky-200 bg-sky-50 text-sky-700 hover:bg-sky-100 text-base font-medium transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="download" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-download"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>
                            <span class="flex-1 min-w-0 truncate">Download log</span>
                            <span class="tabular-nums font-semibold text-sky-600" x-text="'(' + logCount + ')'">(3044)</span>
                        </button>
                        <button type="button" @click="clearLog()" class="flex items-center justify-center gap-2 px-4 py-3 rounded-lg border border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 text-base font-medium transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Clear</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Footer count -->
            <div class="px-3 py-2 border-t border-slate-200 text-xs text-slate-500 text-center bg-white flex items-center justify-center gap-1.5">
                <!-- Reports the FILTERED total, not the rendered slice, so
                     windowing stays invisible here. _catRealLen is kept current
                     by visibleCategories() (one filter pass per render instead
                     of another full one just for this count). Both numbers skip
                     the pinned "All IPD Categories" row — it's an aggregate view,
                     not a category, and has no form image behind it. -->
                <span><span x-text="_catRealLen">300</span> of <span x-text="categoriesRealTotal()">352</span> categories</span>
                <span>·</span>
                <span x-text="activeTabLabel()">Digital NABH</span>
                <span x-show="categoriesLoading" class="text-teal-600" style="display: none;">· loading…</span>
                <span x-show="categoriesLive &amp;&amp; !categoriesOffline &amp;&amp; !categoriesLoading &amp;&amp; !categoriesError" class="text-emerald-600" style="display: none;">· live</span>
                <span x-show="categoriesOffline &amp;&amp; !categoriesLoading" class="text-amber-600" title="Showing the last cached category list — you're offline" style="">· offline (cached)</span>
                <span x-show="categoriesError &amp;&amp; !categoriesLoading" class="text-rose-600" :title="categoriesError" title="" style="display: none;">· refresh failed</span>
                <!-- Offline form-prefetch status: saving (spinner) → ready ✓ → partial. -->
                <span x-show="formsCaching" class="text-teal-600 inline-flex items-center gap-1" title="Saving form templates for offline use" style="">
                    <span>·</span>
                    <svg class="animate-spin" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" style="display:inline-block;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                    <span>saving forms offline <span x-text="formsCacheReady">300</span>/<span x-text="formsCacheTotal">352</span></span>
                </span>
                <span x-show="!formsCaching &amp;&amp; formsCacheTotal &gt; 0 &amp;&amp; formsCacheReady &gt;= formsCacheTotal" class="text-emerald-600" title="All form templates are saved for offline use" style="display: none;">· forms saved offline</span>
                <span x-show="!formsCaching &amp;&amp; formsCacheTotal &gt; 0 &amp;&amp; formsCacheReady &lt; formsCacheTotal" class="text-amber-600" :title="formsCacheReady + ' of ' + formsCacheTotal + ' form templates cached (reconnect to finish)'" title="300 of 352 form templates cached (reconnect to finish)" style="display: none;">· forms <span x-text="formsCacheReady">300</span>/<span x-text="formsCacheTotal">352</span> offline</span>
            </div>
        </aside>

        <!-- ============================================================ -->
        <!-- Uploaded Documents — main-window grid of a category's uploaded   -->
        <!-- files (shown after a successful upload). Tap a thumbnail → the   -->
        <!-- full-screen page viewer (openExistingPreview).                   -->
        <!-- ============================================================ -->
        <div x-show="docViewOpen" class="flex-1 min-h-0 bg-slate-100 flex flex-col relative" style="display:none">
            <!-- GRID — mirrors the pages grid view; tap a tile → detail page viewer. -->
            <div x-show="docViewMode === 'grid'" class="flex-1 min-h-0 overflow-auto p-2 md:p-3">
                <div class="max-w-6xl mx-auto">
                    <!-- Multi-select delete toolbar (long-press a card to enter). -->
                    <div x-show="docSelectMode" class="sticky top-0 z-20 mb-2 flex items-center gap-2 rounded-lg bg-rose-600 text-white px-3 py-2 shadow" style="display: none;">
                        <button type="button" @click="exitDocSelect()" class="shrink-0 w-8 h-8 rounded-full hover:bg-white/20 flex items-center justify-center" title="Cancel" aria-label="Cancel selection">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                        <span class="flex-1 font-semibold text-sm" x-text="docSelectedIds.length + ' selected'">0 selected</span>
                        <button type="button" @click="toggleSelectAllDocs()" class="shrink-0 px-3 py-1.5 rounded-lg text-sm font-medium bg-white/15 hover:bg-white/25" x-text="docSelectedIds.length === docExisting.length ? 'Clear all' : 'Select all'">Clear all</button>
                        <button type="button" @click="askDeleteSelected()" :disabled="!docSelectedIds.length" class="shrink-0 px-3 py-1.5 rounded-lg text-sm font-semibold bg-white text-rose-700 hover:bg-rose-50 disabled:opacity-50 flex items-center gap-1.5" disabled="disabled">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            <span>Delete</span>
                        </button>
                    </div>
                    <template x-if="docExistingLoading"></template>
                    <template x-if="!docExistingLoading &amp;&amp; docExisting.length === 0"></template><div class="text-center text-slate-500 py-16">
                            <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-slate-200 text-slate-400 mb-3">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                            </div>
                            <div class="font-medium text-slate-700">No documents yet</div>
                        </div>

                    <!-- Category title (teal, like the pages grid) -->
                    <div x-show="!docExistingLoading &amp;&amp; docExisting.length" class="text-base font-semibold truncate mb-1" :style="'color:' + docCatColor" x-text="docViewTitle" style="color: rgb(13, 148, 136); display: none;"></div>

                    <!-- Date groups, newest first -->
                    <template x-for="grp in groupedDocByDate()" :key="grp.day"></template>
                </div>
            </div>

            <!-- DETAIL — swipeable page slider (same as category pages, NO edit
                 button; the "Page N / N" count shows in the top app bar). -->
            <div x-show="docViewMode === 'detail'" class="flex-1 min-h-0 flex flex-col" style="display:none">
                <!-- Swipeable horizontal pages — scroll-snap (swipe to flip). -->
                <div x-ref="docSlider" @scroll.debounce.80ms="onDocScroll($event)" class="flex-1 min-h-0 min-w-0 overflow-x-auto overflow-y-hidden snap-x snap-mandatory flex bg-slate-200" style="scroll-behavior: smooth;">
                    <template x-for="(d, i) in docExisting" :key="d.id"></template>
                </div>

                <!-- Page dots (clickable) -->
                <div class="px-4 py-2 border-t border-slate-200 bg-white flex items-center justify-center gap-1.5 shrink-0 overflow-x-auto">
                    <template x-for="(d, i) in docExisting" :key="d.id"></template>
                </div>
            </div>

            <!-- Floating "+" → open the upload dialog (grid mode only). Hidden in
                 read-only mode (p_id 56) and when this category's upload grant is
                 missing (p_id 65/64/43/102/27) — the report list stays viewable. -->
            <button type="button" x-show="!viewOnlyActive() &amp;&amp; docUploadAllowed &amp;&amp; docViewMode === 'grid'" @click="addDocUpload()" class="absolute bottom-5 right-5 w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg flex items-center justify-center active:scale-95 transition" aria-label="Upload new files" title="Upload new files">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </button>
        </div>

        <!-- ============================================================ -->
        <!-- Form-page viewer — fills the main pane in-flow when a category   -->
        <!-- is tapped (grid / detail / canvas all render here, below the     -->
        <!-- app header). NOT a full-screen activity: the top app header stays -->
        <!-- visible so the patient + forms drawers remain reachable, and the  -->
        <!-- drawers (fixed, z-40) overlay this pane when opened.              -->
        <!-- ============================================================ -->
        <div x-show="viewerOpen" class="flex-1 min-h-0 bg-slate-100 flex flex-col relative" style="display:none">
            <!-- Patient-identity header — professional banner: avatar + name +
                 gender/age chip + relative, then a responsive grid of stacked
                 LABEL / value detail cells (UHID, IPD, Consultant, DOA, and the
                 dynamic float-view fields). Patient details live ONLY here.
                 Hidden while editing. -->
            <div class="px-4 py-2.5 border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white shrink-0 max-h-[30vh] overflow-y-auto" x-show="viewerMode !== 'edit'">
                <!-- Identity row: avatar · name · gender-age chip · relative,
                     with the collapse toggle pinned to the right. -->
                <div class="flex items-start gap-2">
                    <div class="flex items-center flex-wrap gap-x-2.5 gap-y-1 flex-1 min-w-0">
                        <template x-if="selectedPatient &amp;&amp; (selectedPatient.photoSrc || selectedPatient.photo)"></template>
                        <template x-if="!(selectedPatient &amp;&amp; (selectedPatient.photoSrc || selectedPatient.photo))"></template><span class="w-9 h-9 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center text-xs font-bold border border-teal-200 shrink-0" x-text="(selectedPatient &amp;&amp; selectedPatient.initials) || '?'">JA</span>
                        <span class="text-[15px] font-bold text-slate-900 leading-tight" x-text="(selectedPatient &amp;&amp; selectedPatient.name) || patientName">JAGDISHBHAI AHUJA</span>
                        <span x-show="selectedPatient &amp;&amp; (genderLabel(selectedPatient.gender) || selectedPatient.age)" class="inline-flex items-center px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 text-[11px] font-semibold border border-teal-100 whitespace-nowrap" x-text="[genderLabel(selectedPatient &amp;&amp; selectedPatient.gender), (selectedPatient &amp;&amp; selectedPatient.age) ? (selectedPatient.age + ' yrs') : ''].filter(Boolean).join(' · ')" style="">Male · 42 Y, 2 M, 12 D yrs</span>
                        <span x-show="selectedPatient &amp;&amp; selectedPatient.relative_name" class="text-xs text-slate-400 italic" x-text="'(' + ((selectedPatient &amp;&amp; selectedPatient.relative_salutation) ? selectedPatient.relative_salutation + ' ' : '') + (selectedPatient &amp;&amp; selectedPatient.relative_name) + ')'" style="display: none;">()</span>
                    </div>
                    <!-- Collapse / expand the detail grid below. -->
                    <button type="button" @click="patientDetailsOpen = !patientDetailsOpen" class="shrink-0 -mt-0.5 p-1 rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition" :title="patientDetailsOpen ? 'Hide details' : 'Show details'" :aria-expanded="patientDetailsOpen ? 'true' : 'false'" aria-label="Toggle patient details" title="Show details" aria-expanded="false">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform rotate-180" :class="patientDetailsOpen ? '' : 'rotate-180'"><polyline points="18 15 12 9 6 15"></polyline></svg>
                    </button>
                </div>

                <!-- Detail grid: stacked label / value cells (collapsible). -->
                <div x-show="patientDetailsOpen" class="mt-2 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-5 gap-y-2" style="display: none;">
                    <div class="flex flex-col min-w-0 leading-tight">
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">UHID</span>
                        <span class="text-xs font-semibold text-slate-800 font-mono truncate" :title="(selectedPatient &amp;&amp; selectedPatient.uhid) || patientUhid" x-text="(selectedPatient &amp;&amp; selectedPatient.uhid) || patientUhid" title="AS6767">AS6767</span>
                    </div>
                    <div class="flex flex-col min-w-0 leading-tight">
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">IPD No</span>
                        <span class="text-xs font-semibold text-slate-800 font-mono truncate" :title="(selectedPatient &amp;&amp; selectedPatient.ipd) || patientIp" x-text="(selectedPatient &amp;&amp; selectedPatient.ipd) || patientIp" title="IP/2026-2027/1619">IP/2026-2027/1619</span>
                    </div>
                    <div x-show="selectedPatient &amp;&amp; selectedPatient.doctor" class="flex flex-col min-w-0 leading-tight" style="">
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">Consultant</span>
                        <span class="text-xs font-semibold text-slate-800 truncate" :title="selectedPatient &amp;&amp; (selectedPatient.doctor + (selectedPatient.consultant_unit ? ' (' + selectedPatient.consultant_unit + ')' : ''))" x-text="selectedPatient &amp;&amp; (selectedPatient.doctor + (selectedPatient.consultant_unit ? ' (' + selectedPatient.consultant_unit + ')' : ''))" title="DR NARENDRA SHANGHAVI">DR NARENDRA SHANGHAVI</span>
                    </div>
                    <div x-show="selectedPatient &amp;&amp; selectedPatient.admitted_at" class="flex flex-col min-w-0 leading-tight" style="">
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">DOA</span>
                        <span class="text-xs font-semibold text-slate-800 truncate" x-text="selectedPatient &amp;&amp; fmtDateTime(selectedPatient.admitted_at)">25-09-2026 08:30 am</span>
                    </div>
                    <div x-show="selectedPatient &amp;&amp; selectedPatient.discharged_at" class="flex flex-col min-w-0 leading-tight" style="display: none;">
                        <span class="text-[9px] uppercase tracking-wider text-slate-400 font-semibold">DOD</span>
                        <span class="text-xs font-semibold text-slate-800 truncate" x-text="selectedPatient &amp;&amp; fmtDateTime(selectedPatient.discharged_at)"></span>
                    </div>
                    <!-- Dynamic float-view fields (configured order). -->
                    <template x-for="f in (selectedPatient &amp;&amp; selectedPatient.header_fields) || []" :key="f.label"></template>
                </div>
            </div>

            <!-- ============= MODE: GRID (saved pages, grouped category → date) ===== -->
            <div x-show="viewerMode === 'grid'" class="flex-1 min-h-0 overflow-auto p-2 md:p-3">
                <div class="max-w-6xl mx-auto space-y-2">
                    <template x-for="grp in groupedViewerRecords()" :key="grp.key"></template>
                </div>
            </div>

            <!-- Floating "+" (new page) — bottom-right of the viewer pane (which
                 is `relative`). Shown only when the category already has pages
                 (grid/detail) — NOT in empty mode (no previous page) and NOT
                 while editing or in the read-only All grid. In grid view this is
                 the ONLY add affordance (the app-bar "+" is hidden there). -->
            <button x-show="!viewOnlyActive() &amp;&amp; viewerOpen &amp;&amp; (viewerMode === 'grid' || viewerMode === 'detail') &amp;&amp; (!(viewerCategory &amp;&amp; viewerCategory.isAll) || viewerMode === 'detail')" type="button" @click="startEdit()" class="absolute bottom-6 right-6 z-10 w-14 h-14 rounded-full bg-teal-600 hover:bg-teal-700 text-white shadow-lg flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-teal-300" style="display:none" aria-label="New page" title="New page">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:28px;height:28px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
            </button>

            <!-- ============= MODE: EMPTY (no records yet OR loading) ============= -->
            <div x-show="viewerMode === 'empty'" class="flex-1 min-h-0 flex flex-col" style="display: none;">
                <template x-if="pagesLoading"></template>
                <template x-if="!pagesLoading &amp;&amp; pagesError"></template>
                <!-- No records yet → a default blank "Page 1 of 1" filling the
                     pane, with the Open button on TOP. Open starts the first
                     entry (replaces the old "Create new form" empty state). -->
                <template x-if="!pagesLoading &amp;&amp; !pagesError"></template><div class="flex-1 min-h-0 flex flex-col">
                        <!-- All-view "no pages" note. For a normal category the
                             page indicator (Page 1 / 1) is shown in the app bar. -->
                        <div class="px-4 py-2 border-b border-slate-200 bg-white flex items-center shrink-0" x-show="viewerCategory &amp;&amp; viewerCategory.isAll" style="display: none;">
                            <div class="text-sm text-slate-700">No saved pages in any category yet</div>
                        </div>
                        <!-- Full-area page: the template fills the ENTIRE section
                             (both width and height — stretched to fit the screen).
                             It's a display-only <img>, so this is purely visual
                             and doesn't change the saved page data. -->
                        <div class="flex-1 min-h-0 overflow-hidden bg-slate-200 flex flex-col">
                            <div class="bg-white shadow-xl w-full h-full flex flex-col">
                                <div class="h-2 shrink-0" :style="'background-color: ' + (viewerCategory ? (viewerCategory.colorHex || '#0d9488') : '#0d9488') + ';'" style="background-color: #0d9488;"></div>
                                <div class="flex-1 relative overflow-hidden">
                                    <img x-show="viewerCategory &amp;&amp; viewerCategory.bgUrl" :src="viewerCategory &amp;&amp; viewerCategory.bgUrl" @error="onViewerBgError($event)" alt="" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none" draggable="false" style="display: none;">
                                    <!-- Category-name watermark on a page with no form
                                         template. Skipped for the synthetic "All IPD
                                         Categories" row (isAll): it isn't a real form,
                                         so watermarking a blank page with it is noise. -->
                                    <div x-show="viewerCategory &amp;&amp; !viewerCategory.isAll &amp;&amp; !viewerCategory.bgUrl" class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" style="display: none;">
