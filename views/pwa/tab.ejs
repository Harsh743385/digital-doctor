                    try {
                        const resp = await fetch('./api/register-books/' + encodeURIComponent(this.rbActiveCat.book_id) + '/pages/' + encodeURIComponent(pg.id), {
                            method: 'DELETE', credentials: 'same-origin',
                            headers: this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken, 'Accept': 'application/json' } : { 'Accept': 'application/json' },
                        });
