                    this.drdFolders = [];
                    this.docRemarkDirOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    // Directories for this page's category (tbl_folder_mst).
                    try {
                        const fresp = await fetch('./api/folders/' + encodeURIComponent(this.drdCatId), {
                            credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' },
                        });
                        if (fresp.ok) {
                            const fdata = await fresp.json();
                            this.drdFolders = Array.isArray(fdata && fdata.folders) ? fdata.folders : [];
                        }
