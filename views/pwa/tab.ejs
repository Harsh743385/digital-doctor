                    } else if (this.categoriesLive && cat.id && this.selectedPatientId) {
                        // Open in a "loading" empty state immediately so the
                        // tap feels instant; swap in the fetched pages when
                        // the request resolves.
                        this.viewerRecords = [];
                        this.viewerMode = 'empty';
                        await this.loadCategoryPages(this.selectedPatientId, cat.id);
