        // ── Offline cache for category printed-form template images ──────────
        // Category template images are stored in IndexedDB keyed by cat_id, with
        // the category name (cat_name) alongside as a change token. On load we
        // serve the local blob when the stored name still matches; if the name
        // changed (category re-configured) we re-download the bytes via the
        // same-origin proxy and overwrite the record. This makes templates work
        // offline and immune to the presigned-URL expiry. All wrapped so a
        // browser without IndexedDB (or a blocked private-mode quota) just
        // degrades to the network bgUrl.
        // Single IndexedDB ("presco-pwa") backing the whole offline layer:
        //   category_images — blob per cat_id (validated by cat_name)
        //   page_images     — saved-page image blob per page key
        //   stamp_images    — blob per stamp_id (validated by stamp_name)
        //   kv              — JSON snapshots (me / patients / masters / page lists / stamp lists)
        //   write_queue     — offline create/edit/delete ops awaiting sync
        //   logs            — activity + error log (exported as presco-ipd-log)
        //   patient_photos  — blob per patient_id (face photo, for offline avatar)
        // Bump PWA_DB_VERSION when adding a store; onupgradeneeded is idempotent.
        const PWA_DB          = 'presco-pwa';
        const PWA_DB_VERSION  = 9;
        const STORE_CAT_IMG   = 'category_images';
        const STORE_PAGE_IMG  = 'page_images';
        const STORE_STAMP_IMG = 'stamp_images';
        // Register Book Master CATEGORY (template) images, one blob per book_id.
        // Handwritten register-book notes are deliberately NOT cached here.
        const STORE_RBOOK_IMG = 'register_book_images';
        // Register-book PAGE overlay images (the drawn strokes), one blob per
        // pma_register_book page id — cached for offline viewing/editing.
        const STORE_RBOOK_PAGE_IMG = 'register_book_page_images';
        // Audit & Feedback template images (keyed by book_id = audit_id) +
        // page overlay images. Clone of the Register Book offline stores.
        const STORE_AUDIT_IMG = 'audit_feedback_images';
        const STORE_AUDIT_PAGE_IMG = 'audit_feedback_page_images';
        const STORE_KV        = 'kv';
        const STORE_WRITE_Q   = 'write_queue';
        const STORE_LOGS      = 'logs';
        const STORE_PATIENT_IMG = 'patient_photos';
        // Employees + face embeddings (HRMS sync) for offline face login,
        // one record per presco_user_id.
        const STORE_EMPLOYEES = 'employees';

        // ── Page-upload retry policy ────────────────────────────────────────
        // A handwritten-page save that fails (network reject OR server error) is
        // retried up to this many TOTAL attempts before the page is parked in the
        // offline queue. A short pause between attempts lets a momentary blip
        // (Wi-Fi roam, brief server hiccup) clear before we try again. Tune here.
        const SAVE_UPLOAD_MAX_ATTEMPTS   = 2;
        const SAVE_UPLOAD_RETRY_DELAY_MS = 800;

        // ── Thumb-impression (fingerprint) capture service ──────────────────
        // The browser can't read a USB scanner directly. Each vendor ships a
        // small agent that runs ON THE TABLET and exposes a localhost HTTP(S)
        // endpoint which captures a fingerprint and returns it as a base64
        // IMAGE (usually BMP). Both supported devices are listed as profiles
        // below; capture tries every profile's endpoints until one answers, so
        // whichever scanner is attached just works — no device picker needed.
        //
        // Per-device profile fields:
        //   name      : shown in the "captured on <name>" toast.
        //   endpoints : tried in order until one answers (different agent
        //               builds bind different ports). HTTPS first; the agent
        //               ships its own localhost TLS cert.
        //   method    : capture verb (usually POST).
        //   body      : request payload (string); '' for none.
        //   headers   : request headers.
        //
        // Shared response parsing (same for every device):
        //   imageKeys : JSON field names that may hold a base64 image (any
        //               depth). MFS100 uses `BitmapData`.
        //   imageXmlTags : XML element/attribute names for the same.
        //   defaultMime : MIME for raw base64 with no data: prefix (BMP). The
        //               image is re-encoded to PNG before it's placed.
        //   timeoutMs : per-endpoint request timeout.
        const THUMB_CAPTURE = {
            devices: [
                {
                    // ThumbScanner / HRMS-Biometric bridge (the app you run in
                    // parallel). NanoHTTPD server on 127.0.0.1:47100-47102,
                    // GET /capture, returns { image_b64, width, height, quality,
                    // nfiq, vendor, model, captured_at }. Tried FIRST.
                    // NOTE: this only works if that server sends CORS headers
                    // (Access-Control-Allow-Origin) AND the page origin can reach
                    // http:// (mixed-content) — otherwise use the native
                    // @JavascriptInterface bridge (Option A), which has neither
                    // limitation.
                    name: 'Presco/HRMS Bridge',
                    endpoints: [
                        'http://127.0.0.1:47100/capture',
                        'http://localhost:47100/capture',
                        'http://127.0.0.1:47101/capture',
                        'http://localhost:47101/capture',
                        'http://127.0.0.1:47102/capture',
                        'http://localhost:47102/capture',
                    ],
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                },
                {
                    // Mantra MFS100 client/RD service. On success it returns
                    // JSON { ErrorCode:"0", BitmapData:"<base64 bmp>", ... };
                    // a non-zero ErrorCode means no-finger / timeout / busy.
                    name: 'Mantra MFS100',
                    endpoints: [
                        'https://localhost:8005/mfs100/capture',
                        'https://127.0.0.1:8005/mfs100/capture',
                        'http://localhost:8005/mfs100/capture',
                        'http://127.0.0.1:8005/mfs100/capture',
                        'https://localhost:11100/mfs100/capture',
                        'https://127.0.0.1:11100/mfs100/capture',
                        'https://localhost:11101/mfs100/capture',
                    ],
                    method: 'POST',
                    // MFS100 expects a PidOptions XML body; format="0" → image.
                    // NOTE: Content-Type is text/plain ON PURPOSE — text/xml /
                    // application/json are NOT CORS-simple, so the browser would
                    // fire an OPTIONS preflight the local agent usually doesn't
                    // answer (→ opaque "Failed to fetch"). text/plain is a simple
                    // type → no preflight; the agent still parses the XML body.
                    body: '<?xml version="1.0"?><PidOptions ver="1.0"><Opts fCount="1" fType="0" iCount="0" iType="0" pCount="0" pType="0" format="0" pidVer="2.0" timeout="25000" pTimeout="30000" posh="UNKNOWN" env="P" /></PidOptions>',
                    headers: { 'Content-Type': 'text/plain', 'Accept': 'application/json, text/xml, */*' },
                },
                {
                    // Morpho / IDEMIA image agent.
                    name: 'Morpho / IDEMIA',
                    endpoints: [
                        'https://localhost:8003/capture',
                        'https://127.0.0.1:8003/capture',
                        'http://localhost:8003/capture',
                        'http://127.0.0.1:8003/capture',
                    ],
                    method: 'POST',
                    // text/plain to dodge the CORS preflight (see MFS100 note).
                    body: JSON.stringify({ Quality: 60, TimeOut: 25 }),
                    headers: { 'Content-Type': 'text/plain', 'Accept': 'application/json, text/xml, */*' },
                },
            ],
            imageKeys: ['BitmapData', 'ImageData', 'FingerImage', 'Image', 'Data', 'bmp', 'base64', 'isoImage', 'image_b64'],
            imageXmlTags: ['BitmapData', 'ImageData', 'Image', 'Data'],
            defaultMime: 'image/bmp',
            // Overall wait for a single capture attempt. Must be >= the native
            // scanner timeout (25s) so the PWA doesn't give up before the device
            // returns — a human needs ~15-20s to reach the reader and press.
            timeoutMs: 35000,
        };

        // ── Native-wrapper JS bridge (preferred over the HTTP service) ───────
        // When the PWA runs inside a WebView/kiosk wrapper that owns the
        // scanner (it shows native "device ready" toasts), capture goes through
        // an injected JS interface, NOT a localhost HTTP port. We try the
        // bridge first, then fall back to HTTP. These are CANDIDATE names — the
        // diagnostic scan (_scanThumbBridges) logs whatever the wrapper actually
        // injected so the exact one can be confirmed and added here.
        //   objectPaths : injected objects that may hold a capture method.
        //   methodNames : capture method names tried on each object + on window.
        // The method may return the image synchronously (base64 / data URL /
        // {BitmapData}), as a Promise, or via a single callback(arg).
        const THUMB_BRIDGE = {
            objectPaths: [
                'PrescoScanner', 'Android', 'AndroidBridge', 'AndroidInterface', 'JSBridge', 'NativeBridge',
                'DeviceBridge', 'PrescoBridge', 'MantraBridge', 'MorphoBridge', 'BiometricBridge',
                'FingerBridge', 'ScannerBridge', 'external',
            ],
            methodNames: [
                'captureThumb', 'captureThumbImpression', 'captureFingerprint', 'captureFinger',
                'scanThumb', 'scanFingerprint', 'getThumb', 'getFingerprint', 'getThumbImpression',
                'thumbCapture', 'fingerCapture', 'mfs100Capture', 'morphoCapture', 'capture',
                'CaptureFinger', 'StartCapture',
            ],
            // iOS WKWebView: there's no injected object with methods — the page
            // triggers capture via window.webkit.messageHandlers.<name>.postMessage(body),
            // and native returns the image through window.onThumbImpressionResult
            // (evaluateJavaScript). Handler names tried, and the body sent.
            messageHandlers: [
                'PrescoScanner', 'prescoScanner', 'captureThumb', 'thumbImpression',
                'fingerprint', 'scanner', 'biometric', 'captureFingerprint', 'thumb',
            ],
            postBody: 'captureThumb',
        };

        function idbOpen() {
            return new Promise((resolve, reject) => {
                if (!('indexedDB' in window)) { reject(new Error('no-indexeddb')); return; }
                let req, settled = false;
                const finish = (fn, arg) => { if (!settled) { settled = true; fn(arg); } };
                try { req = indexedDB.open(PWA_DB, PWA_DB_VERSION); }
                catch (e) { reject(e); return; }
                // A DB version upgrade is blocked when another tab/window holds an
                // OLDER version open. Without handling it, idbOpen() (and every
                // cache read/write that depends on it) hangs forever — a real
                // cause of the "downloading forms" banner getting stuck on a fresh
                // open. Log it and let the safety timeout below reject.
                req.onblocked = () => {
                    try { (_rawConsole && _rawConsole.warn) && _rawConsole.warn('[presco-ipd] idb open blocked (another tab on older version)'); } catch (_) {}
                };
                // Never hang forever — reject after 8s so callers fall back to
                // the network instead of freezing.
                setTimeout(() => finish(reject, new Error('idb-open-timeout')), 8000);
                req.onupgradeneeded = () => {
                    const db = req.result;
                    if (!db.objectStoreNames.contains(STORE_CAT_IMG))   db.createObjectStore(STORE_CAT_IMG,   { keyPath: 'catId' });
                    if (!db.objectStoreNames.contains(STORE_PAGE_IMG))  db.createObjectStore(STORE_PAGE_IMG,  { keyPath: 'key' });
                    if (!db.objectStoreNames.contains(STORE_STAMP_IMG)) db.createObjectStore(STORE_STAMP_IMG, { keyPath: 'id' });
                    if (!db.objectStoreNames.contains(STORE_KV))        db.createObjectStore(STORE_KV,        { keyPath: 'key' });
                    if (!db.objectStoreNames.contains(STORE_WRITE_Q))  db.createObjectStore(STORE_WRITE_Q,  { keyPath: 'id', autoIncrement: true });
                    if (!db.objectStoreNames.contains(STORE_LOGS))     db.createObjectStore(STORE_LOGS,     { keyPath: 'id', autoIncrement: true });
                    if (!db.objectStoreNames.contains(STORE_PATIENT_IMG)) db.createObjectStore(STORE_PATIENT_IMG, { keyPath: 'id' });
                    if (!db.objectStoreNames.contains(STORE_EMPLOYEES)) db.createObjectStore(STORE_EMPLOYEES, { keyPath: 'presco_user_id' });
                    if (!db.objectStoreNames.contains(STORE_RBOOK_IMG)) db.createObjectStore(STORE_RBOOK_IMG, { keyPath: 'book_id' });
                    if (!db.objectStoreNames.contains(STORE_RBOOK_PAGE_IMG)) db.createObjectStore(STORE_RBOOK_PAGE_IMG, { keyPath: 'id' });
                    if (!db.objectStoreNames.contains(STORE_AUDIT_IMG)) db.createObjectStore(STORE_AUDIT_IMG, { keyPath: 'book_id' });
                    if (!db.objectStoreNames.contains(STORE_AUDIT_PAGE_IMG)) db.createObjectStore(STORE_AUDIT_PAGE_IMG, { keyPath: 'id' });
                };
                req.onsuccess = () => finish(resolve, req.result);
                req.onerror   = () => finish(reject, req.error);
            });
        }

        // ── Generic store ops (all soft-rejecting; callers swallow errors) ──
        function idbGet(store, key) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const req = db.transaction(store, 'readonly').objectStore(store).get(key);
                req.onsuccess = () => resolve(req.result || null);
                req.onerror   = () => reject(req.error);
            }));
        }
        function idbPut(store, value) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const tx = db.transaction(store, 'readwrite');
                tx.objectStore(store).put(value);
                tx.oncomplete = () => resolve(true);
                tx.onerror    = () => reject(tx.error);
            }));
        }
        function idbDelete(store, key) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const tx = db.transaction(store, 'readwrite');
                tx.objectStore(store).delete(key);
                tx.oncomplete = () => resolve(true);
                tx.onerror    = () => reject(tx.error);
            }));
        }
        function idbGetAll(store) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const req = db.transaction(store, 'readonly').objectStore(store).getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror   = () => reject(req.error);
            }));
        }
        function idbAdd(store, value) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const tx  = db.transaction(store, 'readwrite');
                const req = tx.objectStore(store).add(value);
                let id;
                req.onsuccess = () => { id = req.result; };
                tx.oncomplete = () => resolve(id);
                tx.onerror    = () => reject(tx.error);
            }));
        }
        // Replace a whole keyed store atomically: clear, then bulk-put items.
        function idbReplaceAll(store, items) {
            return idbOpen().then((db) => new Promise((resolve, reject) => {
                const tx = db.transaction(store, 'readwrite');
                const os = tx.objectStore(store);
                os.clear();
                (items || []).forEach((it) => { try { os.put(it); } catch (_) {} });
                tx.oncomplete = () => resolve(true);
                tx.onerror    = () => reject(tx.error);
            }));
        }

        // Category-image convenience (keyPath catId), unchanged callers.
        function idbGetCatImage(catId) { return idbGet(STORE_CAT_IMG, catId); }
        function idbPutCatImage(rec)   { return idbPut(STORE_CAT_IMG, rec); }
        // JSON snapshot convenience (kv store, keyPath 'key').
        function idbKvGet(key)       { return idbGet(STORE_KV, key).then((r) => (r ? r.data : null)); }
        function idbKvSet(key, data) { return idbPut(STORE_KV, { key, data, updatedAt: Date.now() }); }
        // Delete every kv entry whose key starts with any of the given prefixes.
        function idbKvDeletePrefixes(prefixes) {
            return idbOpen().then((db) => new Promise((resolve) => {
                try {
                    const tx = db.transaction(STORE_KV, 'readwrite');
                    const req = tx.objectStore(STORE_KV).openCursor();
                    req.onsuccess = (e) => {
                        const cur = e.target.result;
                        if (!cur) return;
                        const k = cur.key;
                        if (typeof k === 'string' && prefixes.some((p) => k.indexOf(p) === 0)) {
                            try { cur.delete(); } catch (_) {}
                        }
                        cur.continue();
                    };
                    tx.oncomplete = () => resolve(true);
                    tx.onerror    = () => resolve(false);
                } catch (_) { resolve(false); }
            }));
        }

        // ── Activity / error log ─────────────────────────────────────────────
        // Every activity + error is appended to the `logs` IndexedDB store and
        // can be exported as a plain-text file named "presco-ipd-log" (Modules
        // tab → Download log). A PWA can't silently write to the device's
        // Documents folder, so the export is a normal download the user saves
        // wherever they like (e.g. internal storage → Documents). Ring-buffered
        // so it never grows unbounded; logging itself never throws.
        const PLOG_MAX = 3000;                 // keep the newest N entries
        let _plogSeq = 0;
        // Capture the RAW console methods up front so plog() can mirror to the
        // console without recursing through the console.error/warn wrappers
        // installed below.
        const _rawConsole = {
            log:   (console.log   || function () {}).bind(console),
            info:  (console.info  || console.log || function () {}).bind(console),
            warn:  (console.warn  || console.log || function () {}).bind(console),
            error: (console.error || console.log || function () {}).bind(console),
        };
        function _plogFmt(v) {
            if (typeof v === 'string') return v;
            if (v instanceof Error) return (v.stack || (v.name + ': ' + v.message));
            try { return JSON.stringify(v); } catch (_) { return String(v); }
        }
        // Log timestamp in IST (India Standard Time, UTC+05:30). The offset is
        // fixed rather than read from the device so logs read as IST even on a
        // tablet set to another timezone. Format: "YYYY-MM-DD HH:mm:ss.SSS +05:30 IST".
        function _plogStamp() {
            try {
                const ist = new Date(Date.now() + (5.5 * 60 * 60 * 1000)); // shift UTC → IST
                const p = (n, w) => String(n).padStart(w || 2, '0');
                return ist.getUTCFullYear() + '-' + p(ist.getUTCMonth() + 1) + '-' + p(ist.getUTCDate())
                    + ' ' + p(ist.getUTCHours()) + ':' + p(ist.getUTCMinutes()) + ':' + p(ist.getUTCSeconds())
                    + '.' + p(ist.getUTCMilliseconds(), 3) + ' +05:30 IST';
            } catch (_) { return ''; }
        }
        async function plog(level, tag, message) {
            const entry = {
                ts: _plogStamp(),
                level: String(level || 'info'),
                tag: String(tag || ''),
                message: _plogFmt(message).slice(0, 4000),
            };
            try { (_rawConsole[entry.level] || _rawConsole.log)('[presco-ipd]', entry.tag, entry.message); } catch (_) {}
            try {
                await idbAdd(STORE_LOGS, entry);
                if ((++_plogSeq % 50) === 0) { _plogTrim(); }   // periodic trim
            } catch (_) { /* logging must never throw */ }
        }
        async function _plogTrim() {
            try {
                const all = await idbGetAll(STORE_LOGS);
                if (all.length <= PLOG_MAX) return;
                const ids = all.map((r) => r.id).sort((a, b) => a - b).slice(0, all.length - PLOG_MAX);
                for (const id of ids) { await idbDelete(STORE_LOGS, id); }
            } catch (_) {}
        }
        async function plogExportText(levels) {
            let all = [];
            try { all = await idbGetAll(STORE_LOGS); } catch (_) {}
            // Optional level filter (e.g. ['error','warn'] for the error log).
            let scope = 'all activity';
            if (Array.isArray(levels) && levels.length) {
                const set = new Set(levels.map((s) => String(s).toLowerCase()));
                all = all.filter((r) => set.has(String(r.level || '').toLowerCase()));
                scope = levels.join(' + ');
            }
            all.sort((a, b) => (a.id || 0) - (b.id || 0));
            const ua = (() => { try { return navigator.userAgent; } catch (_) { return ''; } })();
            const head = 'Presco IPD — log (' + scope + ')\n'
                + 'Generated : ' + _plogStamp() + '\n'
                + 'Entries   : ' + all.length + '\n'
                + 'User Agent: ' + ua + '\n'
                + '------------------------------------------------------------\n';
            const body = all.map((r) =>
                '[' + (r.ts || '') + '] ' + String(r.level || 'info').toUpperCase().padEnd(5)
                + ' ' + (r.tag ? (r.tag + ': ') : '') + (r.message || '')
            ).join('\n');
            return head + body + '\n';
        }
        async function plogCount() {
            try { return (await idbGetAll(STORE_LOGS)).length; } catch (_) { return 0; }
        }
        async function plogClear() {
            try { for (const r of await idbGetAll(STORE_LOGS)) { await idbDelete(STORE_LOGS, r.id); } } catch (_) {}
        }

        // App-wide capture: uncaught errors, unhandled promise rejections, and
        // anything sent to console.error / console.warn all land in the log.
        window.addEventListener('error', (e) => {
            const where = (e && e.filename) ? (' @ ' + e.filename + ':' + (e.lineno || 0) + ':' + (e.colno || 0)) : '';
            plog('error', 'window', ((e && (e.message || (e.error && e.error.message))) || 'Uncaught error') + where);
        });
        window.addEventListener('unhandledrejection', (e) => {
            plog('error', 'promise', (e && e.reason) != null ? e.reason : 'Unhandled rejection');
        });
        ['error', 'warn'].forEach((lvl) => {
            console[lvl] = function (...args) {
                try { plog(lvl, 'console', args.map(_plogFmt).join(' ')); } catch (_) {}
                try { _rawConsole[lvl](...args); } catch (_) {}
            };
        });
        plog('info', 'boot', 'PWA shell loaded');

        // How many category rows the drawer renders per page. Sized so the
        // first page comfortably overfills a tablet screen (so there's no
        // visible gap before the scroll handler appends the next one) while
        // staying small enough that the drawer paints in one frame.
        const CATEGORIES_PAGE = 40;

        const TABS = [
            { key: 'hand-written', label: 'Hand Written',  emoji: '✍️' },
            { key: 'digital-nabh', label: 'Digital NABH',  emoji: ''   },
            { key: 'gallery-labs', label: 'Gallery | Labs', emoji: '🖼️' },
            // Modules tab hidden per request (Sign out lives on the home screen).
        ];

        // Gallery|Labs document buttons that support the image/PDF capture +
        // upload flow. Keyed by the EXACT label passed to openDoc(); each maps
