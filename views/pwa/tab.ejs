                    this.placeThumbImpression('rb');
                },
                // ── stamps (reuses the shared stamp system + Use-stamps grant) ──
                async rbPlaceStamp(s) {
                    this.rbGalleryOpen = false;
                    if (!(this.me && this.me.can_use_stamps)) {
                        this.showToast('You have not authority to Use Stamps.', 'error');
                        return;
                    }
                    if (!this._rbCtx) return;
                    const blob = await this._ensureStampBlob(s);
                    if (!blob) { this.showToast('Stamp image unavailable offline', 'error'); return; }
                    const url = URL.createObjectURL(blob);
                    const img = new Image();
                    img.onload = () => {
                        const cw = this._rbPlaceCanvasW(), ch = this._rbPlaceCanvasH();
                        const r = Math.min((cw * 0.35) / img.width, (ch * 0.35) / img.height, 1);
                        this._rbBeginPlacement(url, img.width * r, img.height * r, { resizable: false });
                    };
                    img.onerror = () => { try { URL.revokeObjectURL(url); } catch (_) {} };
                    img.src = url;
                },
                // ══ Selective region copy / paste ═════════════════════════
                // Same logic as the patient-page editor (startSelectiveCopy &
                // friends): the selection is a BOX, not a drag-to-draw stylus
                // marquee — opening the mode drops a rectangle on the visible
                // part of the page and the user nudges it into place with a
                // fingertip, then taps Copy. Requiring a stylus drag to even
                // summon the selection made the feature unusable one-handed.
                rbStartSelectiveCopy() {
                    this.rbCopyMenuOpen = false;
                    if (!this.rbEditLocked) { this.showToast('Lock the canvas (draw mode) to select a region', 'error'); return; }
                    this.rbSelectionMode = 'copy';
                    this._rbSelDrag = null;
                    // Wait for the overlay to exist before measuring the wrap.
                    this.$nextTick(() => {
                        this._rbResetSelectionToCentre();
                        window.lucide && window.lucide.createIcons();
                    });
                },
                rbCancelSelectiveCopy() {
                    this.rbSelectionMode = 'none';
                    this._rbSelectionRect = null;
                    this._rbSelDrag = null;
                },
                // Drop a default box in the centre of whatever part of the page
                // is actually on screen — 60% x 40% of the visible page area, so
                // it is big enough to grab but never starts off-screen when the
                // page is zoomed or panned.
                _rbResetSelectionToCentre() {
                    const wrap = this.$refs.rbCanvasWrap;
                    const page = this.$refs.rbCanvasPage;
                    if (!wrap) return;
                    const wr = wrap.getBoundingClientRect();
                    const pr = page ? page.getBoundingClientRect() : wr;
                    // Visible intersection of the page and its viewport.
                    const left   = Math.max(pr.left,   wr.left);
                    const right  = Math.min(pr.right,  wr.right);
                    const top    = Math.max(pr.top,    wr.top);
                    const bottom = Math.min(pr.bottom, wr.bottom);
                    const vw = Math.max(0, right - left);
                    const vh = Math.max(0, bottom - top);
                    if (vw < 8 || vh < 8) {          // page entirely off-screen
                        this._rbSelectionRect = { x: wr.width * 0.2, y: wr.height * 0.3, w: wr.width * 0.6, h: wr.height * 0.4 };
                        return;
                    }
                    const w = Math.max(80, vw * 0.6);
                    const h = Math.max(80, vh * 0.4);
                    this._rbSelectionRect = {
                        x: (left - wr.left) + (vw - w) / 2,
                        y: (top  - wr.top)  + (vh - h) / 2,
                        w, h,
                    };
                },
                // ── box drag / resize (works with finger, stylus or mouse) ──
                rbSelDown(mode, e) {
                    if (!this._rbSelectionRect) return;
                    this._rbSelDrag = {
                        mode,
                        x0: e.clientX,
                        y0: e.clientY,
                        rect0: Object.assign({}, this._rbSelectionRect),
                    };
                    try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
                },
                rbSelMove(e) {
                    const d = this._rbSelDrag;
                    if (!d) return;
                    const wrap = this.$refs.rbCanvasWrap;
                    if (!wrap) return;
                    const wr = wrap.getBoundingClientRect();
                    const MIN = 48;                            // keep it grabbable
                    const dx = e.clientX - d.x0;
                    const dy = e.clientY - d.y0;
                    const r0 = d.rect0;
                    let r;

                    if (d.mode === 'move') {
                        r = { x: r0.x + dx, y: r0.y + dy, w: r0.w, h: r0.h };
                    } else {
                        let l = r0.x, t = r0.y, rt = r0.x + r0.w, b = r0.y + r0.h;
                        if (d.mode.indexOf('w') >= 0) l  = r0.x + dx;
                        if (d.mode.indexOf('e') >= 0) rt = r0.x + r0.w + dx;
                        if (d.mode.indexOf('n') >= 0) t  = r0.y + dy;
                        if (d.mode.indexOf('s') >= 0) b  = r0.y + r0.h + dy;
                        // Don't let a corner cross its opposite edge.
                        if (rt - l < MIN) { if (d.mode.indexOf('w') >= 0) l = rt - MIN; else rt = l + MIN; }
                        if (b  - t < MIN) { if (d.mode.indexOf('n') >= 0) t = b  - MIN; else b  = t + MIN; }
                        r = { x: l, y: t, w: rt - l, h: b - t };
                    }

                    // Keep the whole box inside the viewport so it can never be
                    // dragged somewhere it cannot be grabbed back from.
                    r.w = Math.min(r.w, wr.width);
                    r.h = Math.min(r.h, wr.height);
                    r.x = Math.max(0, Math.min(r.x, wr.width  - r.w));
                    r.y = Math.max(0, Math.min(r.y, wr.height - r.h));
                    this._rbSelectionRect = r;
                },
                rbSelUp(e) {
                    this._rbSelDrag = null;
                    try { e.target.releasePointerCapture(e.pointerId); } catch (_) {}
                },
                // rbCanvasWrap coords -> canvas backing-store pixels.
                _rbWrapToCanvas(wx, wy) {
                    const canvas = this._rbCanvasEl();
                    const wrap = this.$refs.rbCanvasWrap;
                    if (!canvas || !wrap) return { x: wx, y: wy };
                    const wr = wrap.getBoundingClientRect();
                    const cr = canvas.getBoundingClientRect();
                    const sx = cr.width  ? canvas.width  / cr.width  : 1;
                    const sy = cr.height ? canvas.height / cr.height : 1;
                    return {
                        x: ((wx + wr.left) - cr.left) * sx,
                        y: ((wy + wr.top)  - cr.top)  * sy,
                    };
                },
                // Crop the selected region out of the canvas into the clipboard.
                rbConfirmSelectiveCopy() {
                    const r = this._rbSelectionRect;
                    const canvas = this._rbCanvasEl();
                    if (!r || !canvas) { this.rbCancelSelectiveCopy(); return; }

                    const p0 = this._rbWrapToCanvas(r.x, r.y);
                    const p1 = this._rbWrapToCanvas(r.x + r.w, r.y + r.h);
                    let x = Math.round(Math.min(p0.x, p1.x));
                    let y = Math.round(Math.min(p0.y, p1.y));
                    let w = Math.round(Math.abs(p1.x - p0.x));
                    let h = Math.round(Math.abs(p1.y - p0.y));

                    // The box may overhang the page — clamp to the canvas so the
                    // crop never asks for pixels that don't exist.
                    const nx = Math.max(0, x);
                    const ny = Math.max(0, y);
                    w = Math.min(w - (nx - x), canvas.width  - nx);
                    h = Math.min(h - (ny - y), canvas.height - ny);
                    x = nx; y = ny;

                    if (w < 4 || h < 4) {
                        this.showToast('Selection is outside the page — move it over the form and try again.', 'error');
                        return;                                 // keep the box up
                    }
                    const tmp = document.createElement('canvas');
                    tmp.width = w; tmp.height = h;
                    tmp.getContext('2d').drawImage(canvas, x, y, w, h, 0, 0, w, h);
                    try {
                        // srcW/srcH: the page this region came from, so a paste
                        // onto a different-resolution book page restores the same
                        // ON-PAGE size instead of the same pixel count.
                        this._rbSelectionClipboard = {
                            dataUrl: tmp.toDataURL('image/png'), w, h,
                            srcW: canvas.width, srcH: canvas.height,
                        };
                        this.showToast('Area copied — use Paste to place it on a new page.', 'success');
                    } catch (_) {
                        this.showToast('Could not copy that area.', 'error');
                    }
                    this.rbCancelSelectiveCopy();
                },
                // Paste the last selection into the placement overlay (drag-and-place,
                // no resize/rotate); the clip stays on the clipboard for re-use.
                rbSelectivePaste() {
                    this.rbPasteMenuOpen = false;
                    const clip = this._rbSelectionClipboard;
                    if (!clip || !clip.dataUrl) { this.showToast('Select an area first (Copy ▸ Selective copy)', 'error'); return; }
                    if (!this._rbCtx) return;
                    let w = clip.w, h = clip.h;
                    // Books don't all share a page resolution: pasting raw pixels
                    // onto a higher-resolution page would cover a smaller FRACTION
                    // of it and read as shrunken. Rescale by the page-size ratio so
                    // the region covers the same portion of the page it did when it
                    // was copied (same rule as the patient page).
                    const cw = this._rbPlaceCanvasW(), ch = this._rbPlaceCanvasH();
                    if (clip.srcW && clip.srcH && (clip.srcW !== cw || clip.srcH !== ch)) {
                        const s = Math.min(cw / clip.srcW, ch / clip.srcH);   // keep aspect
                        w = clip.w * s;
                        h = clip.h * s;
                    }
                    this._rbBeginPlacement(clip.dataUrl, w, h, { resizable: false, rotatable: false });
                },
                // ── save ──
                async rbSaveEdit() {
                    if (this.rbSaving || !this.rbActiveCat) return;
                    const c = this._rbCanvasEl(); if (!c) return;
                    // GUARD: the saved overlay of an EXISTING page failed to load, so
                    // the canvas doesn't hold that page's strokes. Saving now would
                    // upload a blank (or partly redrawn) page over real handwriting
                    // and the old S3 object is deleted server-side — unrecoverable.
                    if (this.rbEditingPageId != null && this._rbOverlayFailed) {
                        this.showToast('This page’s saved writing could not be loaded — close and reopen it before saving, so your existing notes are not overwritten.', 'error', false, 15000);
                        return;
                    }
                    this.rbSaving = true;
                    // Register Book uses a sticky toast rather than the IPD-style
                    // blocking "Saving IPD Page" dialog. It stays up until the
                    // success/error toast below replaces it.
                    this.showToast('Saving Register Book Page', 'success', true);
                    try {
                        const blob = await new Promise((res) => c.toBlob(res, 'image/png'));
                        if (!blob) { this.showToast('Could not export the page', 'error'); return; }
                        const book = this.rbActiveCat.book_id;
                        const isEdit = this.rbEditingPageId != null;
                        const url = './api/register-books/' + encodeURIComponent(book) + '/pages'
                                  + (isEdit ? '/' + encodeURIComponent(this.rbEditingPageId) : '');
                        const body = new FormData();
                        body.append('file', blob, 'register_page.png');
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch(url, {
                            method: 'POST', credentials: 'same-origin',
                            headers: this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken, 'Accept': 'application/json' } : { 'Accept': 'application/json' },
                            body,
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { this.showToast('Session expired — refresh and retry', 'error'); return; }
                        if (resp.status === 403) { this.showToast('You have not authority to Use Register Book.', 'error'); return; }
                        if (!resp.ok) {
                            // Surface the EXACT server / bucket exception (long toast).
                            const data = await resp.json().catch(() => null);
                            const msg = (data && data.error) || ('HTTP ' + resp.status);
                            this.showToast('Upload failed: ' + msg, 'error', false, 15000);
                            return;
                        }
                        this.showToast(isEdit ? 'Page updated' : 'Page saved');
                        // Which page to land on: the one just edited, or the id the
                        // server minted for a brand-new page.
                        const data   = await resp.json().catch(() => null);
                        const savedId = isEdit
                            ? this.rbEditingPageId
                            : (data && data.page && data.page.id != null ? data.page.id : null);
                        const at = this.rbActivePageIndex;
                        // Drop this page's CACHED overlay blob before reloading:
                        // its bytes are now stale, and the version-gated read in
                        // cacheRegisterPageImage would otherwise be the only thing
                        // standing between the grid/viewer and the old image.
                        if (savedId != null) { try { await idbDelete(STORE_RBOOK_PAGE_IMG, Number(savedId)); } catch (_) {} }
                        // Reload the pages (re-caches overlays), then STAY in the page
                        // viewer showing the page we just wrote — the user drops back
                        // to the grid only via Home / Back, never automatically.
                        await this.rbLoadPages(book);
                        // A NEW page changes this category's page count — refresh the
                        // category list so the drawer/bunch totals reflect it (an
                        // edit reuses the same row, so the count is unchanged).
                        if (!isEdit) this.loadRegisterBooks();
                        this.rbEditingPageId = null;
                        // Pages are ordered NEWEST FIRST, so a new page lands at
                        // index 0 — that's the fallback when the saved id can't be
                        // found (e.g. an active date filter excludes it).
                        this._rbShowInViewer(savedId, isEdit ? at : 0);
                    } catch (e) {
                        // Network-level failure (no server response body) — show the
                        // exact error text, held long enough to read.
                        this.showToast('Save failed: ' + ((e && e.message) || 'Check your connection.'), 'error', false, 15000);
                    } finally {
                        this.rbSaving = false;
                    }
                },
                // ── Bunch filter — ditto copy of the IPD forms bunch picker.
                // Groups categories by category_color_code (colorHex), labels each
                // colour-bunch by its category_code, "#00000000"/blank → "Blank
                // Color". Carries per-bunch category + page totals.
                rbBunchOptions() {
                    const norm = (v) => (v || '').toString().toLowerCase();
                    const map = new Map();
                    this.rbRows.forEach((r) => {
                        if (r.is_all) return;
                        const key = norm(r.color) || '#00000000';
                        if (!map.has(key)) {
                            map.set(key, { colorHex: key, label: (r.category_code && String(r.category_code).trim()) || '', count: 1, pages: (r.page_count || 0) });
                        } else {
                            const e = map.get(key);
                            e.count += 1; e.pages += (r.page_count || 0);
                            if (!e.label && r.category_code) e.label = String(r.category_code).trim();
                        }
                    });
                    const opts = Array.from(map.values()).map((o) => ({
                        ...o,
                        displayLabel: o.colorHex === '#00000000' ? 'Blank Color' : (o.label || o.colorHex),
                    }));
                    opts.sort((a, b) => (a.colorHex === '#00000000' ? -1 : b.colorHex === '#00000000' ? 1 : 0));
                    return opts;
                },
                rbBunchVisible() {
                    const opts = this.rbBunchOptions();
                    if (opts.length <= 1 && (opts[0] && opts[0].colorHex === '#00000000')) return false;
                    return opts.length > 0;
                },
                rbBunchLabel() {
                    if (!this.rbBunch) return 'All Bunches';
                    const m = this.rbBunchOptions().find((o) => o.colorHex === this.rbBunch);
                    return m ? m.displayLabel : 'All Bunches';
                },
                rbSelectBunch(colorHex) { this.rbBunch = colorHex || ''; this.rbBunchOpen = false; },
                // Total written pages across all categories (for the "All" row).
                rbTotalPages() { return this.rbRows.reduce((s, r) => s + (r.is_all ? 0 : (r.page_count || 0)), 0); },
                // Search (book_type) + Bunch (colour) filter. Rows arrive already
                // ordered by category_position DESCENDING from the server.
                // Serial no. for the drawer row at display index `i` — a running
                // 1..N over the REAL categories, in the order shown, so it stays
                // continuous when search / bunch filters hide rows. The pinned
                // "All Register Book Forms" row is an aggregate, not a category, so
                // it isn't counted (its tile shows the layers icon instead).
                // Deliberately NOT category_position: that's master data and can be
                // sparse, duplicated or 0.
                // Row background tint from category_color_code, like the IPD forms
                // drawer: the IPD list uses `bgHex` = colorHex + '33' (a ~20% alpha
                // wash) so the colour reads as a row tint rather than a solid block.
                // RB rows carry the normalised hex in `color`, so the same suffix is
                // applied here. No colour → return '' and the `bg-white` class wins.
                // The whole inline style is produced here (nothing static on the
                // element) so there's nothing for the binding to clobber.
                _rowTintFromHex(hex) {
                    const h = String(hex || '').trim();
                    if (!h || h === '#00000000' || h.toLowerCase() === 'transparent') return '';
                    // Already carries an alpha channel (#rrggbbaa) → use as-is.
                    return 'background-color:' + (h.length > 7 ? h : (h + '33')) + ';';
                },
                // Row tint for the IPD drawer's category cards — the same rule the
                // Templates / RB drawers use. A DB colour (category_color_code →
                // bgHex) is alpha-blended so the card stays readable; the legacy
                // named tints (ROW_COLOR) are already pastel, so they're used neat.
                // The pinned "All Categories" row stays plain, like RB's All row.
                ipdRowTint(cat) {
                    if (!cat || cat.isAll) return '';
                    if (cat.bgHex) return this._rowTintFromHex(cat.bgHex);
                    return cat.color ? ('background-color:' + (ROW_COLOR[cat.color] || '') + ';') : '';
                },
                rbRowTint(row) {
                    if (!row || row.is_all) return '';   // the pinned "All" row stays plain
                    return this._rowTintFromHex(row.color);
                },
                // Same O(1) shape as the IPD drawer's catSerialNo: the pinned "All"
                // row (when present) occupies index 0, so a real category at display
                // index i is the i-th serial.
                rbRowSerial(i) {
                    const list = this.rbFiltered();
                    return (list[0] && list[0].is_all) ? (Number(i) || 0) : ((Number(i) || 0) + 1);
                },
                rbFiltered() {
                    const q = (this.rbSearch || '').trim().toLowerCase();
                    const norm = (v) => (v || '').toString().toLowerCase();
                    const bunch = this.rbBunch;   // '' = All Bunches; else a colorHex
                    const pinned = [];
                    const rest = [];
                    this.rbRows.forEach((r) => {
                        if (r.is_all) { pinned.push(r); return; }   // always kept at index 0
                        if (bunch && (norm(r.color) || '#00000000') !== norm(bunch)) return;
                        if (q && (r.book_type || '').toLowerCase().indexOf(q) < 0) return;
                        rest.push(r);
                    });
                    return pinned.concat(rest);
                },
                rbStatusLabel(row) { return (row && row.active) ? 'Active' : 'Inactive'; },
                // Orientation/rotation is only meaningful for addressograph + stamp
                // entries (per product) — detect by book_type / category_code keyword.
                rbHasOrientation(row) {
                    const s = (((row && row.book_type) || '') + ' ' + ((row && row.category_code) || '')).toLowerCase();
                    return s.indexOf('addressograph') >= 0 || s.indexOf('stamp') >= 0;
                },
                // Portrait/Landscape + rotation angle, mirroring the IPD register-book
                // model (orientation '1' = landscape; rotation '1' = 90°, '2' = -90°).
                rbOrientationLabel(row) {
                    return (row && String(row.orientation) === '1') ? 'Landscape' : 'Portrait';
                },
                rbRotationDeg(row) {
                    if (row && String(row.rotation) === '1') return 90;
                    if (row && String(row.rotation) === '2') return -90;
                    return 0;
                },
                // Legible text colour (dark/light) for a category background tint.
                rbTextOn(color) {
                    const c = (color || '').replace('#', '');
                    if (c.length < 6) return '#0f172a';
                    const r = parseInt(c.slice(0, 2), 16), g = parseInt(c.slice(2, 4), 16), b = parseInt(c.slice(4, 6), 16);
                    return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.6 ? '#0f172a' : '#ffffff';
                },

                // ══ Audit & Feedback methods (clone of Register Book) ════
                // ── Audit & Feedback (view-only full-screen window) ──
                openAuditFeedback() {
                    this.afOpen        = true;
                    this.afRightOpen   = true;    // show the category selector first
                    this.afActiveCat   = null;
                    this.afPages       = [];
                    this.afPageView    = 'grid';
                    this.afDetail      = null;
                    this.afSearch      = '';
                    this.afBunch       = '';
                    this.afFilterDefault();       // grid date filter → this month
                    this.settingsOpen  = false;   // close the settings drawer behind it
                    this.loadAuditFeedbacks();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                closeAuditFeedback() {
                    this.afExitConfirmOpen = false;
                    this.afOpen      = false;
                    this.afActiveCat = null;
                    this.afPages     = [];
                    this.afDetail    = null;
                    // Tear down the Other Documents gallery + its capture routing.
                    this.afDocPreviewOpen = false;
                    this.afDocPreviewItem = null;
                    this.afDocDeleteConfirmOpen = false;
                    this.afDocRemarkOpen = false;
                    this.docContext  = 'ipd';
                    this._revokeAfImageUrls();
                },
                // Back button → confirm before leaving the Audit & Feedback section.
                // Guarded: unsaved editor strokes prompt Save/Discard first.
                afConfirmExit() {
                    if (this._afGuardEditExit(() => this.afConfirmExit())) return;
                    this.afExitConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                // Home → the register-book pages grid (or the category list when
                // no register is open). Guarded against unsaved editor strokes.
                afHome() {
                    if (this._afGuardEditExit(() => this.afHome())) return;
                    this.afEditingPageId = null;
                    if (this.afActiveCat) { this.afPageView = 'grid'; }
                    else { this.afPageView = 'grid'; this.afRightOpen = true; }
                },
                // `:v2` — abandons ascending snapshots cached by older builds; see
                // _rbCacheKey.
                _afCacheKey() { return 'audit-feedback:v2:' + ((this.me && this.me.hospital_id) || 'default'); },
                // Category list order — ASCENDING by category_position, matching the
                // Register Book drawer; see _rbSortCats for why the order is enforced
                // client-side rather than left to the server.
                // `book_type` is the AF payload's label field too.
                _afSortCats(items) {
                    return (Array.isArray(items) ? items.slice() : []).sort((a, b) => {
                        const pa = Number((a && a.position) || 0), pb = Number((b && b.position) || 0);
                        if (pa !== pb) return pa - pb;
                        return String((a && a.book_type) || '').localeCompare(String((b && b.book_type) || ''));
                    });
                },
                // Synthetic "All" entry pinned at index 0 of the list (book_id 0).
                // Not from the DB and never cached; excluded from the category
                // chips. Tapping it clears the filters (show every form).
                _afAllEntry() {
                    return {
                        book_id: 0, book_type: 'All Audit & Feedback Forms', category_code: '',
                        color: '#0f172a', position: 0, orientation: '0', rotation: '0',
                        active: true, has_image: false, image_name: '', is_all: true,
                    };
                },
                async loadAuditFeedbacks() {
                    this.afLoading = true;
                    this.afError   = '';
                    try {
                        const resp = await fetch('./api/audit-feedback', {
                            credentials: 'same-origin', cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 403) { this.afRows = []; this.afError = 'You have not authority to Use Audit & Feedback.'; return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data  = await resp.json();
                        const items = this._afSortCats(Array.isArray(data && data.items) ? data.items : []);
                        // "All Audit & Feedback Forms" (book_id 0) pinned at index 0.
                        this.afRows = [this._afAllEntry()].concat(items);
                        // Cache the DB rows only (not the synthetic entry) so the
                        // master renders offline next time.
                        try { await idbKvSet(this._afCacheKey(), items); } catch (_) {}
                    } catch (_) {
                        // Offline / failed → restore the cached list (category data +
                        // images both served from the offline cache below).
                        let cached = null;
                        try { cached = await idbKvGet(this._afCacheKey()); } catch (_) {}
                        if (Array.isArray(cached)) {
                            this.afRows = [this._afAllEntry()].concat(this._afSortCats(cached));
                        } else {
                            this.afRows  = [this._afAllEntry()];
                            this.afError = 'Could not load audit forms. Check your connection.';
                        }
                    } finally {
                        this.afLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        // Warm every CATEGORY image into IndexedDB + mint thumbnails
                        // (cache-first, so it shows from cached blobs when offline).
                        // Handwritten notes are never cached.
