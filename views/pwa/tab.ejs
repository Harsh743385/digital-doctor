                                                <span x-show="p.relative_name" class="font-normal text-sm text-slate-500" x-text="'{' + (p.relative_salutation ? p.relative_salutation + ' ' : '') + (p.relative_name || '') + '}'" style="display: none;">{}</span>
                                            </div>
                                            <span x-show="p.gender || p.age" class="flex-none inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap bg-pink-50 text-pink-600 border-pink-100" :class="genderPillClass(p)" x-text="genderAgePill(p)">Female · 51 Y, 1 M,</span>
                                        </div>

                                        <!-- Then IPD No. / UHID No. as rounded pill
                                             badges with their own background colours.
