                    });
                },

                // ── Delete the page currently being edited ──
                confirmDelete() {
                    this.confirmDeleteOpen = false;
                    this._deleteCurrentEdit();
                },

                async _deleteCurrentEdit() {
                    // Delete-page grant (p_id 63). The Delete control is already
                    // hidden without it; guard here too so no code path deletes.
                    if (!(this.me && this.me.can_delete_pages)) {
                        this.showToast('You have not authority to Delete pages', 'error');
                        return;
                    }
                    const id = this._editingRecordId;
                    if (!id || !this.viewerCategory) return;
                    const idx = this.viewerRecords.findIndex(r => r.id === id);
                    if (idx < 0) {
                        // Already gone — just exit edit mode.
                        this._editingRecordId = null;
                        this.backToGrid();
                        return;
                    }

                    // Live mode: send DELETE to the server. Server moves the
                    // row to pma_patient_notes1_history, writes a type='3'
                    // log entry, and removes from pma_patient_notes1.
                    // On success we splice from viewerRecords and bump the
                    // count. On failure we leave the UI alone + toast.
                    const isLive = this.categoriesLive
                                && this._editCatId
                                && this.selectedPatientId;

                    // A page that is still only in the offline queue (id
                    // "offline-<qid>", no live server row). Delete it locally:
                    //  - a queued NEW page → just drop the pending upload.
                    //  - an offline EDIT of an existing server page → convert the
                    //    queued op to a delete so the server row is removed on sync.
                    const isOfflinePage = typeof id === 'string' && id.indexOf('offline-') === 0;

                    if (isOfflinePage) {
                        const qid = parseInt(id.slice('offline-'.length), 10);
                        let entry = null;
                        if (!isNaN(qid)) entry = await idbGet(STORE_WRITE_Q, qid).catch(() => null);
                        if (entry && entry.op === 'update' && entry.serverPageId) {
                            // Keep one queued op, now a delete of the server page.
                            await idbPut(STORE_WRITE_Q, { ...entry, op: 'delete', blob: null, updatedAt: Date.now() }).catch(() => {});
                        } else {
                            if (!isNaN(qid)) await idbDelete(STORE_WRITE_Q, qid).catch(() => {});
                            this.offlinePending = Math.max(0, this.offlinePending - 1);
                        }
                        plog('info', 'save', 'Offline page deleted (qid ' + qid + ')');
                    } else if (isLive) {
                        const ok = await this._deletePageLive(id);
                        if (!ok) {
                            // Server delete failed; keep the page in the
                            // list, abort the bin-move + edit-exit.
                            return;
                        }
                    } else {
                        // Demo / static path — keep the legacy in-memory
                        // recycle bin so the design-review build still works.
                        let preview = null;
                        try { preview = this.$refs.penCanvas && this.$refs.penCanvas.toDataURL('image/png'); }
                        catch (_) { /* tainted canvas — ignore */ }
                        const rec = this.viewerRecords[idx];
                        const recForBin = { ...rec, image: preview || rec.image || null };
                        if (!this._recycleBin[this.selectedPatientId]) {
                            this._recycleBin[this.selectedPatientId] = [];
                        }
                        this._recycleBin[this.selectedPatientId].unshift({
                            id: `bin-${Date.now()}-${rec.id}`,
                            originalRecord: recForBin,
                            catIndex:    this.viewerCategory.i,
                            catLabel:    this.viewerCategory.label,
                            catColorHex: this.viewerCategory.colorHex || '#0d9488',
                            deletedBy:   'You',
                            deletedAt:   new Date().toLocaleString('en-IN', {
                                day: '2-digit', month: 'short', year: 'numeric',
                                hour: '2-digit', minute: '2-digit',
                            }),
                        });
                        this._persistCurrentCategoryRecords();
                    }

                    // Common to both paths: drop from the local list, bump
                    // counts, exit edit mode, and surface success.
                    this.viewerRecords.splice(idx, 1);
                    const isAllView = !!(this.viewerCategory && this.viewerCategory.isAll);
                    const cat = this.categories.find(c =>
                        isLive ? c.id === this._editCatId : c.i === this.viewerCategory.i
                    );
                    if (cat) {
                        // In the All view viewerRecords spans all categories, so
                        // decrement the saved-into category by one; otherwise it
                        // equals this single category's page list length.
                        cat.count = isAllView
                            ? Math.max(0, (parseInt(cat.count, 10) || 0) - 1)
                            : this.viewerRecords.length;
                    }
                    if (!isAllView && this.viewerCategory) {
                        this.viewerCategory.count = this.viewerRecords.length;
                    }
                    // All view: renumber the continuous page numbers after removal.
                    if (isAllView) {
                        this.viewerRecords.forEach((r, i) => { r.globalNo = i + 1; });
                    }
                    this._editingRecordId = null;
                    this._clearCanvas();
                    if (isLive) {
                        this.showToast('Page deleted');
                    }

                    if (this.viewerRecords.length === 0) {
                        // No pages left — drop into the empty state.
                        this.viewerActiveRecord = null;
                        this.viewerActiveIndex = 0;
                        this.viewerMode = 'empty';
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }
                    // Show the previous page in the slider (clamp to 0).
                    this._showDetailAt(Math.max(0, idx - 1));
                },

                // DELETE /pwa/api/patients/{p}/categories/{c}/pages/{id}
                // sent as POST + _method=DELETE so Laravel's web middleware
                // (CSRF, session) sees it as a normal form submission.
                // Returns true on success, false on failure (caller leaves
                // the UI alone on false so the user can retry).
                async _deletePageLive(pageId) {
                    const fd = new FormData();
                    fd.append('_method', 'DELETE');
                    if (this.csrfToken) fd.append('_token', this.csrfToken);

                    try {
                        const url = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                  + '/categories/' + encodeURIComponent(this._editCatId)
                                  + '/pages/' + encodeURIComponent(pageId);
                        const resp = await fetch(url, {
                            method: 'POST',
                            credentials: 'same-origin',
                            body: fd,
                            headers: Object.assign(
                                { 'Accept': 'application/json' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                        });

                        if (resp.status === 401) { window.location.assign('./login'); return false; }
                        if (resp.status === 419) {
                            await this.loadMe();
                            this.showToast('Session refreshed. Tap delete again.', 'error');
                            return false;
                        }
                        if (!resp.ok) {
                            const data = await resp.json().catch(() => null);
                            throw new Error((data && data.error) || ('HTTP ' + resp.status));
                        }
                        return true;
                    } catch (e) {
                        this.showToast('Delete failed: ' + (e && e.message || e), 'error');
                        return false;
                    }
                },

                // True iff the canvas pixels haven't moved since the initial
                // snapshot was taken (= user opened the page and hasn't
                // drawn anything yet).
                _isCanvasUnchanged() {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return true;
                    // FAST PATH. The compare below re-encodes the whole canvas to
                    // a PNG data URL — at the editor's native 1536x1968 that is a
                    // ~3-megapixel synchronous encode plus a multi-megabyte string
                    // compare, seconds of blocked main thread on a tablet. It sits
                    // on the exit guard, so it ran before the UI could respond to
                    // ANY navigation out of the editor (tapping another patient
                    // included — the drawer couldn't paint until it finished).
                    //
                    // _editMutations counts every pixel-mutating action since the
                    // snapshot was taken, so zero mutations proves the canvas is
                    // untouched without looking at a single pixel. This is the
                    // common case: open a page, don't draw, navigate away.
                    // Anything above zero still falls through to the exact compare
                    // — undo-back-to-the-original must still read as unchanged.
                    if (!this._editMutations && this._initialSnapshot) return true;
                    if (!this._initialSnapshot) return this._isCanvasBlank();
                    try { return canvas.toDataURL('image/png') === this._initialSnapshot; }
                    catch (_) { return false; }
                },

                // Single-tap selects the tool; a quick second tap on the same
                // tool opens its size popover. Custom double-tap detection
                // works across mouse / stylus / touch (browser dblclick on
                // touch is unreliable, especially with touch-action: none).
                // Eraser tap — gated by p_id 71 (direct) / p_id 38 (password).
                // Direct access → normal tool tap. Password users must re-validate
                // EVERY time they switch to the eraser; once it's already the
                // active tool, taps pass through so the double-tap size popover
                // works without re-prompting. No access → toast.
                selectEraser(e) {
                    if (this.me && this.me.can_use_eraser) {
                        this.toolTap('eraser', e);
                        return;
                    }
                    if (this.me && this.me.can_eraser_password) {
                        if (this.editTool === 'eraser') { this.toolTap('eraser', e); return; }
                        this.openEraserPasswordDialog();
                        return;
                    }
                    this.showToast('You have not authority to use Eraser', 'error');
                },

                openEraserPasswordDialog() {
                    this.eraserPwValue = '';
                    this.eraserPwChecking = false;
                    this.eraserPwOpen = true;
                    this.$nextTick(() => {
                        const el = this.$refs.eraserPwInput;
                        if (el) el.focus();
                        window.lucide && window.lucide.createIcons();
                    });
                },

                // Validate the entered password against the hospital eraser
                // password. Fast path: compare a SHA-256 of the input to the hash
                // cached at login (me.eraser_password_hash) — instant + offline,
                // no per-attempt round-trip. Falls back to the server validator
                // when the hash isn't cached or crypto.subtle is unavailable. On
                // success select the eraser for this use only (no session latch —
                // re-prompted next switch); on failure toast and keep the dialog
                // open for a retry.
                async submitEraserPassword() {
                    if (this.eraserPwChecking) return;
                    const pw = (this.eraserPwValue || '').trim();
                    if (!pw) { this.showToast('Enter the eraser password', 'error'); return; }
                    this.eraserPwChecking = true;
                    try {
                        const ok = await this._checkEraserPassword(pw);
                        if (ok) {
                            this.eraserPwOpen = false;
                            this.eraserPwValue = '';
                            this.toolTap('eraser');
                            this.showToast('Eraser unlocked');
                        } else {
                            this.eraserPwValue = '';
                            this.showToast('Wrong Eraser password', 'error');
                        }
                    } catch (_) {
                        this.showToast('Wrong Eraser password', 'error');
                    } finally {
                        this.eraserPwChecking = false;
                    }
                },
                // ── Administrative-password gate for "Audit & Feedback" ──────
                // Open the dialog (closing the Settings drawer behind it).
                openAuditGate() {
                    this.settingsOpen = false;
                    this.auditPwValue = '';
                    this.auditPwOpen  = true;
                    this.$nextTick(() => {
                        window.lucide && window.lucide.createIcons();
                        if (this.$refs.auditPwInput) this.$refs.auditPwInput.focus();
                    });
                },
                // Validate the entered password against EITHER the audit or the
                // super-audit password. Match → proceed; no match → toast and keep
                // the dialog open for a retry.
                async submitAuditPassword() {
                    if (this.auditPwChecking) return;
                    const pw = (this.auditPwValue || '').trim();
                    if (!pw) { this.showToast('Please input Administrative Password.', 'error'); return; }
                    this.auditPwChecking = true;
                    try {
                        const ok = await this._checkAuditPassword(pw);
                        if (ok) {
                            this.auditPwOpen  = false;
                            this.auditPwValue = '';
                            this._openAuditFeedback();
                        } else {
                            this.auditPwValue = '';
                            this.showToast('Wrong Password.', 'error');
                        }
                    } catch (_) {
                        this.showToast('Wrong Password.', 'error');
                    } finally {
                        this.auditPwChecking = false;
                    }
                },
                // True when `pw` matches the audit OR super-audit password — compare
                // a SHA-256 of the input to the hashes cached at login. Returns false
                // if neither password is configured (nothing to match against).
                async _checkAuditPassword(pw) {
                    const a = (this.me && this.me.audit_password_hash) || '';
                    const s = (this.me && this.me.super_audit_password_hash) || '';
                    if (!(a || s) || !(window.crypto && window.crypto.subtle)) return false;
                    const h = await this._sha256Hex(pw);
                    return (!!a && h === a) || (!!s && h === s);
                },
                // Proceed past the gate — the actual Audit & Feedback screen.
                // TODO: wire the real Audit & Feedback destination here.
                _openAuditFeedback() {
                    this.showToast('Administrative access granted.', 'success');
                    this.openAuditFeedback();
                },
                // True when `pw` matches the hospital eraser password. Prefers the
                // cached SHA-256 hash (instant, offline); falls back to the server
                // validator if the hash isn't cached or hashing fails.
                async _checkEraserPassword(pw) {
                    const cached = this.me && this.me.eraser_password_hash;
                    if (cached && window.crypto && window.crypto.subtle) {
                        try {
                            return (await this._sha256Hex(pw)) === cached;
                        } catch (_) { /* fall through to the server validator */ }
                    }
                    return await this._validateEraserPasswordServer(pw);
                },
                // Lowercase-hex SHA-256 of a string (matches PHP hash('sha256', …)).
                async _sha256Hex(text) {
                    const buf = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
                    const bytes = new Uint8Array(buf);
                    let hex = '';
                    for (let i = 0; i < bytes.length; i++) hex += bytes[i].toString(16).padStart(2, '0');
                    return hex;
                },
                // Fallback: POST the password to the server validator (the original
                // path). Used when no cached hash is available.
                async _validateEraserPasswordServer(pw) {
                    const body = new URLSearchParams();
                    body.append('password', pw);
                    if (this.csrfToken) body.append('_token', this.csrfToken);
                    const resp = await fetch('./api/validate-eraser-password', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: Object.assign(
                            { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
                            this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                        ),
                        body: body.toString(),
                    });
                    if (resp.status === 401) { window.location.assign('./login'); return false; }
                    const data = resp.ok ? await resp.json().catch(() => ({})) : {};
                    return !!(data && data.ok);
                },

                // ══ App-bar popovers ══════════════════════════════════════════
                // The edit app bar scrolls horizontally so it never wraps, which
                // makes it an overflow container — an absolutely-positioned
                // child would be clipped. The popovers are therefore
                // position:fixed (.appbar-pop) and anchored here, against the
                // button that opened them.
                //
                // Coordinates are written as INDIVIDUAL style properties rather
                // than through an :style binding: a binding rewrites the whole
                // style attribute and would wipe the display:none that x-show
                // depends on.
                _placePopover(id, btn, align) {
                    if (!btn) return;
                    this.$nextTick(() => {
                        const el = document.getElementById(id);
                        if (!el) return;
                        const r = btn.getBoundingClientRect();
                        const gap = 8;
                        const vw = window.innerWidth;
                        const vh = window.innerHeight;
                        // offsetWidth is valid here because x-show has already
                        // made the element visible by the time $nextTick runs.
                        const w = el.offsetWidth || 224;
                        let left = (align === 'right') ? (r.right - w) : r.left;
                        left = Math.max(gap, Math.min(left, vw - w - gap));
                        el.style.top  = Math.round(r.bottom + gap) + 'px';
                        el.style.left = Math.round(left) + 'px';
                        el.style.right = 'auto';
                        // Never run off the bottom on a short screen.
                        el.style.maxHeight = Math.max(160, Math.round(vh - r.bottom - gap * 2)) + 'px';
                        el.style.overflowY = 'auto';
                    });
                },

                // A fixed popover cannot follow its button once the bar scrolls,
                // so close them all instead of letting one float loose.
                _closeAppbarPopovers() {
                    this.penOptsOpen = false;
                    this.eraserOptsOpen = false;
                    this.inkOptsOpen = false;
                    this.colorOptsOpen = false;
                    this.galleryMenuOpen = false;
                    this.copyMenuOpen = false;
                    this.pasteMenuOpen = false;
                },

                toolTap(tool, _e) {
                    const now = Date.now();
                    const isDouble = this._lastToolTap.tool === tool
                                  && (now - this._lastToolTap.ts) < 350;
                    this.editTool = tool;
                    // Close any sibling popovers when switching tools.
                    if (tool === 'pen')    this.eraserOptsOpen = false;
                    if (tool === 'eraser') this.penOptsOpen    = false;
                    // Switching away from the pen abandons any half-written
                    // phrase — the ink stays on the canvas, just un-recognised.
                    if (tool !== 'pen') this._inkReset();
                    this.inkOptsOpen = false;
                    if (isDouble) {
                        this._lastToolTap = { tool: null, ts: 0 };
                        // Stroke-change grant (p_id 59). Selecting the tool above
                        // is ungated; only opening the size popover is. Privileged
                        // roles (1/2/10) are granted server-side.
                        if (!(this.me && this.me.can_change_stroke)) {
                            this.showToast('You have not authority to Change Pen/Eraser Stroke.', 'error');
                        } else {
                            const btn = _e && _e.currentTarget;
                            if (tool === 'pen') {
                                this.penOptsOpen = !this.penOptsOpen;
                                if (this.penOptsOpen) this._placePopover('pop-pen', btn);
                            }
                            if (tool === 'eraser') {
                                this.eraserOptsOpen = !this.eraserOptsOpen;
                                if (this.eraserOptsOpen) this._placePopover('pop-eraser', btn);
                            }
                        }
                    } else {
                        this._lastToolTap = { tool, ts: now };
                    }
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // ── canvas setup (stylus only) ──
                // The canvas backing-store size is the IMAGE's native pixel
                // size (default 1536x1968). The CSS size is whatever fits
                // the screen (set by the .canvas-page aspect-ratio rule),
                // so the canvas auto-scales for editing while saves stay at
                // the source resolution.
                initCanvas() {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return;
                    const W = this.bgNaturalW || this._DEFAULT_W;
                    const H = this.bgNaturalH || this._DEFAULT_H;
                    // Only resize if dimensions actually changed; resizing
                    // clears the canvas, so we don't want to do it on every
                    // re-render.
                    if (canvas.width !== W || canvas.height !== H) {
                        canvas.width  = W;
                        canvas.height = H;
                    }
                    const ctx = canvas.getContext('2d');
                    ctx.setTransform(1, 0, 0, 1, 0, 0);
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';
                    this._ctx = ctx;
                    this._drawing = false;
                    // A fresh/resized canvas invalidates any pending ink phrase.
                    this._inkReset();
                },

                // Stylus filter — only pointers reporting pointerType==='pen'
                // get to draw. Mouse/finger taps surface the "Use a stylus"
                // hint and are otherwise ignored.
                _isStylus(e) {
                    return e.pointerType === 'pen';
                },

                _flashStylusHint() {
                    this.showStylusHint = true;
                    clearTimeout(this._stylusHintTimer);
                    this._stylusHintTimer = setTimeout(() => { this.showStylusHint = false; }, 1800);
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Map screen coords -> canvas internal coords (which are in
                // image-pixel space, not CSS-pixel space).
                _canvasPoint(e) {
                    const canvas = this.$refs.penCanvas;
                    const rect = canvas.getBoundingClientRect();
                    const sx = rect.width  ? canvas.width  / rect.width  : 1;
                    const sy = rect.height ? canvas.height / rect.height : 1;
                    return {
                        x: (e.clientX - rect.left) * sx,
                        y: (e.clientY - rect.top)  * sy,
                    };
                },

                // Ratio between canvas-internal pixels and CSS pixels at
                // the current display size. Stroke widths are multiplied
                // by this so a line looks the same visual thickness no
                // matter how the page is scaled to fit the viewport.
                _displayScale() {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return 1;
                    const rect = canvas.getBoundingClientRect();
                    if (!rect.width) return 1;
                    // rect.width already includes the CSS zoom transform on the
                    // page, so canvas.width/rect.width SHRINKS as you zoom in —
                    // which would store thinner strokes that look narrow back at
                    // normal size. Multiply by zoom to factor the transform out,
                    // keeping stroke width constant in canvas-pixel space (a line
                    // drawn while zoomed-in is the same thickness at normal page
                    // size as one drawn un-zoomed).
                    return (canvas.width / rect.width) * (this.zoom || 1);
                },

                onPointerDown(e) {
                    if (this._placing) return;                 // image placement in progress — don't draw
                    // Stylus always draws (palm-rejection style — touches
                    // are handled separately on the wrap, not here).
                    if (e.pointerType === 'touch') return;     // let wrap pinch-handler take it
                    if (e.pointerType === 'mouse') { this._flashStylusHint(); return; }
                    if (e.pointerType !== 'pen') return;
                    if (!this._ctx) this.initCanvas();
                    // Selective-copy mode owns the canvas: the selection box
                    // handles its own pointers, and nothing should draw ink
                    // underneath it.
                    if (this.selectionMode === 'copy') return;
                    // Snapshot for undo BEFORE the stroke starts.
                    this._pushUndo();
                    const { x, y } = this._canvasPoint(e);
                    // Ink → Text: open a new stroke in the pending-ink buffer and
                    // hold off the idle recogniser while the pen is down.
                    this._inkBeginStroke(x, y);
                    this._drawing = true;
                    this._lastX = x;
                    this._lastY = y;
                    // Seed the quadratic-smoothing midpoint at the start point so
                    // the first curve segment has somewhere to begin (see
                    // onPointerMove).
                    this._lastMidX = x;
                    this._lastMidY = y;
                    // Draw a tiny dot so a single tap is visible.
                    this._configureStroke(e);
                    this._ctx.beginPath();
                    this._ctx.moveTo(x, y);
                    this._ctx.lineTo(x + 0.01, y + 0.01);
                    this._ctx.stroke();
                    try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
                },

                onPointerMove(e) {
                    if (e.pointerType !== 'pen') return;
                    if (this.selectionMode === 'copy') return;
                    if (!this._drawing) return;
                    // A fast stylus emits many input samples between animation
                    // frames; the browser delivers them coalesced into a single
                    // pointermove. Replay each sample and stitch them with
                    // quadratic curves whose endpoints are the segment MIDPOINTS
                    // and whose control point is the actual sample — the standard
                    // smoothing that turns a faceted polyline into a smooth curve,
                    // so circles/arcs draw cleanly instead of line-by-line.
                    const coalesced = (typeof e.getCoalescedEvents === 'function')
                        ? e.getCoalescedEvents()
                        : null;
                    const samples = (coalesced && coalesced.length) ? coalesced : [e];
                    for (const ev of samples) {
                        const { x, y } = this._canvasPoint(ev);
                        this._inkAddPoint(x, y);
                        const midX = (this._lastX + x) / 2;
                        const midY = (this._lastY + y) / 2;
                        this._configureStroke(ev);
                        this._ctx.beginPath();
                        this._ctx.moveTo(this._lastMidX, this._lastMidY);
                        this._ctx.quadraticCurveTo(this._lastX, this._lastY, midX, midY);
                        this._ctx.stroke();
                        this._lastX = x;
                        this._lastY = y;
                        this._lastMidX = midX;
                        this._lastMidY = midY;
                    }
                },

                onPointerUp(e) {
                    if (e.pointerType !== 'pen') return;
                    if (this.selectionMode === 'copy') return;
                    if (!this._drawing) return;
                    // Finish the stroke exactly at the final pen position: the
                    // quadratic smoothing only drew up to the last midpoint, so
                    // bridge that midpoint to the true last point.
                    this._configureStroke(e);
                    this._ctx.beginPath();
                    this._ctx.moveTo(this._lastMidX, this._lastMidY);
                    this._ctx.lineTo(this._lastX, this._lastY);
                    this._ctx.stroke();
                    this._drawing = false;
                    try { e.target.releasePointerCapture(e.pointerId); } catch (_) {}
                    // A fresh stroke invalidates the redo history.
                    this._redoStack = [];
                    // Ink → Text: close the stroke and arm the idle timer. The
                    // user may keep writing — each new stroke re-arms it, so the
                    // whole phrase is recognised as one unit.
                    this._inkEndStroke();
                },

                // ── pinch zoom + pan (touch pointers only) ──
                // Active only when editLocked === false. Stylus pointers fall
                // through to the canvas drawing handlers above. TWO fingers
                // pinch-zoom + pan; ONE finger pans the image once it's already
                // zoomed in (no pinch needed to drag it around).
                _isZoomedIn() { return this.zoom > this._ZOOM_MIN + 0.01; },

                onTouchDown(e) {
                    if (e.pointerType !== 'touch') return;
                    if (this._placing) return;   // placement overlay owns gestures
                    // While a selection box is up, a finger belongs to the box —
                    // panning the page underneath it would just fight the drag.
                    if (this.selectionMode === 'copy') return;
                    if (this.editLocked) return;
                    this._touches.set(e.pointerId, { x: e.clientX, y: e.clientY });
                    if (this._touches.size === 2) {
                        // Second finger → start a pinch; cancel any single pan.
                        this._panStart = null;
                        const pts = [...this._touches.values()];
                        const dx = pts[1].x - pts[0].x;
                        const dy = pts[1].y - pts[0].y;
                        this._pinchStart = {
                            dist:  Math.hypot(dx, dy) || 1,
                            midX:  (pts[0].x + pts[1].x) / 2,
                            midY:  (pts[0].y + pts[1].y) / 2,
                            zoom0: this.zoom,
                            panX0: this.panX,
                            panY0: this.panY,
                        };
                        this._pinchActive = true;
                    } else if (this._touches.size === 1 && this._isZoomedIn()) {
                        // Single finger while zoomed in → drag-to-pan.
                        this._panStart = {
                            x: e.clientX, y: e.clientY,
                            panX0: this.panX, panY0: this.panY,
                        };
                        this._pinchActive = true;
                    }
                    try { e.currentTarget.setPointerCapture(e.pointerId); } catch (_) {}
                },

                onTouchMove(e) {
                    if (e.pointerType !== 'touch') return;
                    if (!this._touches.has(e.pointerId)) return;
                    this._touches.set(e.pointerId, { x: e.clientX, y: e.clientY });

                    // Two fingers → pinch zoom + pan.
                    if (this._touches.size === 2 && this._pinchStart) {
                        const pts = [...this._touches.values()];
                        const dx = pts[1].x - pts[0].x;
                        const dy = pts[1].y - pts[0].y;
                        const dist = Math.hypot(dx, dy) || 1;
                        const midX = (pts[0].x + pts[1].x) / 2;
                        const midY = (pts[0].y + pts[1].y) / 2;
                        // Zoom: ratio of current finger distance to initial.
                        const z = Math.max(this._ZOOM_MIN, Math.min(this._ZOOM_MAX,
                            this._pinchStart.zoom0 * (dist / this._pinchStart.dist)));
                        // Pan: midpoint delta from initial midpoint.
                        this.zoom = z;
                        this.panX = this._pinchStart.panX0 + (midX - this._pinchStart.midX);
                        this.panY = this._pinchStart.panY0 + (midY - this._pinchStart.midY);
                        // Snap back to neutral when fully zoomed out.
                        if (z <= this._ZOOM_MIN + 0.01) { this.panX = 0; this.panY = 0; }
                        return;
                    }

                    // One finger → pan the (zoomed-in) image.
                    if (this._touches.size === 1 && this._panStart) {
                        this.panX = this._panStart.panX0 + (e.clientX - this._panStart.x);
                        this.panY = this._panStart.panY0 + (e.clientY - this._panStart.y);
                    }
                },

                onTouchEnd(e) {
                    if (e.pointerType !== 'touch') return;
                    this._touches.delete(e.pointerId);
                    try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
                    if (this._touches.size < 2) {
                        this._pinchStart = null;
                    }
                    if (this._touches.size === 1 && !this.editLocked && this._isZoomedIn()) {
                        // Lifted from a pinch to one finger → keep panning with
                        // the finger that's still down (no need to re-touch).
                        const pt = [...this._touches.values()][0];
                        this._panStart = { x: pt.x, y: pt.y, panX0: this.panX, panY0: this.panY };
                        this._pinchActive = true;
                    } else if (this._touches.size === 0) {
                        this._panStart = null;
                        this._pinchActive = false;
                    }
                    // Refresh the lock-button icon: unlock <-> move follows the
                    // zoom state once a gesture settles.
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                resetZoom() {
                    this.zoom = 1;
                    this.panX = 0;
                    this.panY = 0;
                    // Zoom is back to fit → lock-button icon returns to unlock.
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                _configureStroke(e) {
                    // Line width starts from the user-set size (penSize /
                    // eraserSize, in CSS px), then multiplies by the
                    // display scale so widths read consistently regardless
                    // of how the page is fit to the screen. Pen also adds
                    // a small pressure modulation (eraser does not).
                    const pressure = e.pressure && e.pressure > 0 ? e.pressure : 0.5;
                    const scale = this._displayScale();
                    if (this.editTool === 'eraser') {
                        this._ctx.globalCompositeOperation = 'destination-out';
                        this._ctx.strokeStyle = 'rgba(0,0,0,1)';
                        this._ctx.lineWidth = this.eraserSize * scale;
                    } else {
                        this._ctx.globalCompositeOperation = 'source-over';
                        this._ctx.strokeStyle = this.editColor;
                        // Pen modulates 50-100% of penSize by stylus pressure.
                        this._ctx.lineWidth = this.penSize * (0.5 + 0.5 * pressure) * scale;
                    }
                },

                // ══════════════════════════════════════════════════════════════
                // Ink → Text — ML Kit Digital Ink Recognition
                // ──────────────────────────────────────────────────────────────
                // ML Kit ships Android/iOS SDKs only (no JS build), so the page
                // does the ink CAPTURE and the native wrapper does the
                // RECOGNITION. Contract (pwa/android-wrapper/ink/INK_BRIDGE.md):
                //
                //   window.PrescoInk.recognize('<json>')   → void, async result
                //   window.PrescoInk.status()              → '{"ready":bool,…}'
                //   window.PrescoInk.prepare('<langTag>')  → void (model download)
                //
                //   json = { language, writingArea:{width,height}, preContext,
                //            strokes:[ [ {x,y,t}, … ], … ] }
                //
                // The wrapper answers by calling one of:
                //   window.onInkRecognitionResult('<text or json>')
                //   window.onInkRecognitionError('<message>')
                //
                // Points are in CANVAS-pixel space (the form's native resolution)
                // and writingArea carries the canvas size, which is what ML Kit
                // uses to normalise the ink — so zoom/fit never affects accuracy.
                // ══════════════════════════════════════════════════════════════

                // Collect the native recogniser object, whatever name the wrapper
                // registered it under. Returns { recognize, status, prepare } with
                // bound functions, or null when nothing is injected (plain
                // browser / iOS without the handler).
                _inkBridge() {
                    const names = ['PrescoInk', 'PrescoDigitalInk', 'PrescoMLKit', 'DigitalInk', 'InkBridge'];
                    for (const n of names) {
                        let obj; try { obj = window[n]; } catch (_) { continue; }
                        if (!obj) continue;
                        for (const m of ['recognize', 'recognizeInk', 'recognizeHandwriting']) {
                            try {
                                if (typeof obj[m] === 'function') {
                                    return {
                                        name: n,
                                        recognize: obj[m].bind(obj),
                                        status:  (typeof obj.status  === 'function') ? obj.status.bind(obj)  : null,
                                        prepare: (typeof obj.prepare === 'function') ? obj.prepare.bind(obj) : null,
                                    };
                                }
                            } catch (_) {}
                        }
                    }
                    // iOS WKWebView: postMessage in, window.onInkRecognitionResult out.
                    try {
                        const mh = window.webkit && window.webkit.messageHandlers;
                        if (mh && mh.prescoInk && typeof mh.prescoInk.postMessage === 'function') {
                            return {
                                name: 'webkit.prescoInk',
                                recognize: (json) => { mh.prescoInk.postMessage(json); },
                                status: null,
                                prepare: null,
                            };
                        }
                    } catch (_) {}
                    return null;
                },

                // ══════════════════════════════════════════════════════════════
                // Engine 2: the Presco Handwriting Agent — a SEPARATE installed
                // app that runs ML Kit behind a loopback HTTP server.
                // ──────────────────────────────────────────────────────────────
                // addJavascriptInterface only reaches WebViews inside the same
                // app, so a standalone recogniser app cannot inject
                // window.PrescoInk here. It exposes a socket instead, exactly
                // like the fingerprint agent this page already talks to on
                // 127.0.0.1:47100-47102. Ink uses the adjacent range.
                //
                // Loopback is exempt from mixed-content blocking, so an HTTPS
                // page may call http://127.0.0.1 — provided the agent returns
                // CORS headers (it does) and, for Chrome's Private Network
                // Access check, Access-Control-Allow-Private-Network (it does).
                // ══════════════════════════════════════════════════════════════

                // Probe the port range once and remember the winner. Returns the
                // base URL ('http://127.0.0.1:47110') or null when the agent app
                // is not installed / not running.
                async _findInkAgent(force) {
                    if (this._inkAgentBase && !force) return this._inkAgentBase;
                    for (const host of ['127.0.0.1', 'localhost']) {
                        for (const port of this._INK_AGENT_PORTS) {
                            const base = 'http://' + host + ':' + port;
                            try {
                                const ctrl = new AbortController();
                                const timer = setTimeout(() => ctrl.abort(), 1200);
                                let resp;
                                try {
                                    resp = await fetch(base + '/ping', {
                                        method: 'GET', mode: 'cors', cache: 'no-store', signal: ctrl.signal,
                                    });
                                } finally { clearTimeout(timer); }
                                if (!resp || !resp.ok) continue;
                                const j = await resp.json().catch(() => null);
                                if (j && j.ok && j.service === 'presco-ink') {
                                    this._inkAgentBase = base;
                                    plog('info', 'ink', 'handwriting agent found at ' + base);
                                    return base;
                                }
                            } catch (_) { /* not listening here — try the next */ }
                        }
                    }
                    this._inkAgentBase = null;
                    return null;
                },

                // NOTE ON CONTENT-TYPE. These POSTs deliberately send
                // 'text/plain' even though the body is JSON.
                //
                // 'application/json' is NOT a CORS-safelisted content type, so
                // the browser fires an OPTIONS preflight before every call. A
                // preflight to a loopback address from an HTTPS page is the
                // fragile part of this transport — it additionally has to pass
                // Chrome's Private Network Access check. 'text/plain' IS
                // safelisted, which makes these "simple requests": no preflight,
                // nothing to fail. The agent reads the raw body regardless of
                // the declared type, so nothing is lost.
                _INK_AGENT_CT: 'text/plain;charset=UTF-8',

                // Ask the agent which languages this tablet can actually serve,
                // and what state each model is in. Offering a language whose
                // model ML Kit does not have just produces a failed phrase, so
                // the picker annotates them instead.
                async _inkAgentLanguages() {
                    const base = await this._findInkAgent();
                    if (!base) return null;
                    const tags = this.inkLangs.map(l => l.tag).join(',');
                    try {
                        const ctrl = new AbortController();
                        const timer = setTimeout(() => ctrl.abort(), 2000);
                        let resp;
                        try {
                            resp = await fetch(base + '/ink/languages?tags=' + encodeURIComponent(tags), {
                                method: 'GET', mode: 'cors', cache: 'no-store', signal: ctrl.signal,
                            });
                        } finally { clearTimeout(timer); }
                        if (!resp.ok) return null;
                        const j = await resp.json().catch(() => null);
                        if (!j || !j.ok) return null;
                        return j;
                    } catch (_) { return null; }
                },

                // Refresh the per-language badges shown in the picker.
                async refreshInkLangStates() {
                    const j = await this._inkAgentLanguages();
                    if (!j) { this.inkLangStates = {}; return; }
                    const out = {};
                    for (const l of this.inkLangs) {
                        const s = (j.states && j.states[l.tag]) || null;
                        out[l.tag] = s
                            ? (s.supported ? s.state : 'UNSUPPORTED')
                            : 'UNKNOWN';
                    }
                    this.inkLangStates = out;
                    plog('info', 'ink', 'agent supports ' + (j.count || 0) + ' languages; picker states '
                        + JSON.stringify(out));
                },

                // Short human label for a language's model state in the picker.
                inkLangBadge(tag) {
                    switch (this.inkLangStates[tag]) {
                        case 'READY':          return 'installed';
                        case 'DOWNLOADING':    return 'downloading…';
                        case 'CHECKING':       return 'checking…';
                        case 'NOT_DOWNLOADED': return 'tap to download';
                        case 'UNSUPPORTED':    return 'unavailable';
                        case 'FAILED':         return 'failed — retry';
                        default:               return '';
                    }
                },

                // Ask the agent to download/warm a language model. Fire-and-forget.
                async _inkAgentPrepare(lang) {
                    const base = await this._findInkAgent();
                    if (!base) return;
                    try {
                        await fetch(base + '/ink/prepare', {
                            method: 'POST', mode: 'cors', cache: 'no-store',
                            headers: { 'Content-Type': this._INK_AGENT_CT },
                            body: JSON.stringify({ language: lang }),
                        });
                    } catch (_) {}
                },

                // POST one phrase. Returns {ok:true,text} / {ok:false,error},
                // or null when the agent could not be reached at all.
                async _recognizeViaAgent(payload) {
                    const base = await this._findInkAgent();
                    if (!base) return null;
                    try {
                        const ctrl = new AbortController();
                        const timer = setTimeout(() => ctrl.abort(), this._INK_TIMEOUT_MS);
                        let resp;
                        try {
                            resp = await fetch(base + '/ink/recognize', {
                                method: 'POST', mode: 'cors', cache: 'no-store',
                                headers: { 'Content-Type': this._INK_AGENT_CT },
                                body: payload,
                                signal: ctrl.signal,
                            });
                        } finally { clearTimeout(timer); }
                        if (!resp.ok) return { ok: false, error: 'HTTP ' + resp.status };
                        const j = await resp.json().catch(() => null);
                        if (!j) return { ok: false, error: 'bad response' };
                        if (!j.ok) return { ok: false, error: j.error || 'RECOGNITION_FAILED' };
                        return { ok: true, text: String(j.text || '').trim() };
                    } catch (e) {
                        // Agent went away mid-session (app stopped/updated) —
                        // forget the cached base so the next try re-probes.
                        this._inkAgentBase = null;
                        if (e && e.name === 'AbortError') return { ok: false, error: 'timeout' };
                        return { ok: false, error: 'agent unreachable: ' + ((e && e.message) || e) };
                    }
                },

                // Pick the best available engine, in quality order:
                //   1. in-app native bridge  (wrapper rebuilt with InkBridge)
                //   2. loopback agent app    (Presco Handwriting Agent installed)
                //   3. browser API           (Chromium with on-device models)
                async _inkEngine() {
                    const bridge = this._inkBridge();
                    if (bridge) return { kind: 'native', bridge };
                    const base = await this._findInkAgent();
                    if (base) return { kind: 'agent', base };
                    if (this._inkWebSupported()) return { kind: 'web' };
                    return null;
                },

                // ── Fallback engine: the browser's own Handwriting Recognition
                // API (navigator.createHandwritingRecognizer). Same idea as ML
                // Kit and also fully ON-DEVICE — no handwriting leaves the
                // tablet — so it is safe for patient data. Used automatically
                // whenever the native bridge is absent, which is what makes the
                // feature work in a plain browser and in a wrapper that has not
                // been rebuilt with InkBridge yet.
                //
                // Availability is limited (Chromium, and only where the platform
                // ships handwriting models), so this is a fallback, not a
                // replacement for the native bridge.
                _inkWebSupported() {
                    try {
                        return typeof navigator !== 'undefined'
                            && typeof navigator.createHandwritingRecognizer === 'function'
                            && typeof window.HandwritingStroke === 'function';
                    } catch (_) { return false; }
                },

                // 'en-US' → ['en-US', 'en']. The web API generally wants the
                // primary subtag, the native bridge wants the full BCP-47 tag,
                // so try the specific one first and fall back.
                _inkLangCandidates() {
                    const tag = this.inkLang || 'en-US';
                    const primary = String(tag).split('-')[0];
                    return (primary && primary !== tag) ? [tag, primary] : [tag];
                },

                // Create (and cache) a recogniser for the selected language.
                // Returns null when the browser has no model for it.
                async _inkWebRecognizer() {
                    if (!this._inkWebSupported()) return null;
                    if (this._inkWebRec && this._inkWebRecLang === this.inkLang) return this._inkWebRec;
                    try { this._inkWebRec && this._inkWebRec.finish(); } catch (_) {}
                    this._inkWebRec = null;
                    this._inkWebRecLang = null;
                    for (const lang of this._inkLangCandidates()) {
                        try {
                            const support = await navigator.queryHandwritingRecognizerSupport({ languages: [lang] });
                            if (!support || support.languages === false) continue;
                            const rec = await navigator.createHandwritingRecognizer({ languages: [lang] });
                            if (!rec) continue;
                            this._inkWebRec = rec;
                            this._inkWebRecLang = this.inkLang;
                            plog('info', 'ink', 'browser recogniser ready for ' + lang);
                            return rec;
                        } catch (e) {
                            plog('warn', 'ink', 'browser recogniser rejected ' + lang + ': ' + (e && e.message || e));
                        }
                    }
                    return null;
                },

                // Recognise via the browser API. Returns the text, '' when the
                // model read nothing, or null when the engine is unusable (so
                // the caller can tell "unreadable" from "no engine").
                async _recognizeViaWeb(strokes) {
                    const rec = await this._inkWebRecognizer();
                    if (!rec) return null;
                    // Canvas points are in the form's NATIVE pixel space (up to
                    // 1536x1968). These models are trained on screen-scale ink,
                    // so convert to CSS pixels — the size the user actually
                    // wrote at — before handing them over.
                    const scale = this._displayScale() || 1;
                    let drawing = null;
                    try {
                        drawing = rec.startDrawing({
                            recognitionType: 'text',
                            inputType: 'stylus',
                            alternatives: 1,
                        });
                        for (const s of strokes) {
                            const hs = new window.HandwritingStroke();
                            for (const p of s) {
                                hs.addPoint({ x: p.x / scale, y: p.y / scale, t: p.t });
                            }
                            drawing.addStroke(hs);
                        }
                        const preds = await drawing.getPrediction();
                        const first = (preds && preds.length) ? preds[0] : null;
                        return (first && first.text) ? String(first.text).trim() : '';
                    } catch (e) {
                        plog('warn', 'ink', 'browser recognition failed: ' + (e && e.message || e));
                        return null;
                    } finally {
                        try { drawing && drawing.finish(); } catch (_) {}
                    }
                },

                // Toolbar tap. Single = toggle the mode, double = language picker.
                async inkToTextTap(_e) {
                    const now = Date.now();
                    const isDouble = this._lastToolTap.tool === 'ink'
                                  && (now - this._lastToolTap.ts) < 350;
                    if (isDouble) {
                        this._lastToolTap = { tool: null, ts: 0 };
                        this.inkOptsOpen = !this.inkOptsOpen;
                        this.penOptsOpen = false;
                        this.eraserOptsOpen = false;
                        // Pull fresh per-language model states while the picker
                        // is open, so "installed / downloading / unavailable"
                        // reflects the tablet right now.
                        if (this.inkOptsOpen) {
                            this._placePopover('pop-ink', _e && _e.currentTarget);
                            this.refreshInkLangStates();
                        }
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }
                    this._lastToolTap = { tool: 'ink', ts: now };
                    if (this.inkToText) { this.setInkToText(false); return; }

                    // Probing the agent is a network call — re-probe from scratch
                    // on an explicit tap so installing the agent app takes effect
                    // without reloading the page.
                    this._inkAgentBase = null;
                    const engine = await this._inkEngine();
                    if (!engine) {
                        const inWrapper = /PrescoWrapper/i.test(navigator.userAgent || '');
                        plog('warn', 'ink', 'no recognition engine (inWrapper=' + inWrapper + ')');
                        this.showToast(
                            'Handwriting to text needs the Presco Handwriting Agent app — install it on this tablet, then tap this button again.',
                            'error', false, 7000);
                        return;
                    }
                    // Writing with the eraser selected makes no sense here.
                    this.editTool = 'pen';
                    this.setInkToText(true);
                    // Warm the language model so the first phrase isn't delayed.
                    if (engine.kind === 'native') {
                        try { engine.bridge.prepare && engine.bridge.prepare(this.inkLang); } catch (_) {}
                    } else if (engine.kind === 'agent') {
                        this._inkAgentPrepare(this.inkLang);
                    } else {
                        this._inkWebRecognizer().catch(() => {});
                    }
                    plog('info', 'ink', 'mode ON via ' + engine.kind
                        + (engine.base ? ' (' + engine.base + ')' : '')
                        + (engine.bridge ? ' (' + engine.bridge.name + ')' : ''));
                    this.showToast('Handwriting to text is ON — write, then pause; your writing becomes text.', 'success', false, 4000);
                },

                setInkToText(on) {
                    this.inkToText = !!on;
                    if (!this.inkToText) this._inkReset();
                    this.inkOptsOpen = false;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                setInkLang(tag) {
                    this.inkLang = tag;
                    this.inkOptsOpen = false;
                    this._inkReset();
                    const bridge = this._inkBridge();
                    try { bridge && bridge.prepare && bridge.prepare(tag); } catch (_) {}
                    if (!bridge) {
                        // Kick the download, then re-read states so the badge
                        // flips to "downloading…" without another tap.
                        this._inkAgentPrepare(tag).then(() => this.refreshInkLangStates());
                    }
                    const l = this.inkLangs.find(x => x.tag === tag);
                    this.showToast('Handwriting language: ' + ((l && l.label) || tag), 'success');
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Drop everything pending WITHOUT touching the canvas — the ink
                // pixels stay exactly as drawn, only the recognition buffer goes.
                // Called on mode-off, tool switch, undo/redo, clear and canvas init.
                _inkReset() {
                    clearTimeout(this._inkIdleTimer);
                    this._inkIdleTimer = null;
                    this._inkStrokes = [];
                    this._inkCurStroke = null;
                    this._inkSnapshot = null;
                },

                _inkActive() {
                    return this.inkToText && this.editTool === 'pen' && !this.inkBusy;
                },

                _inkBeginStroke(x, y) {
                    if (!this._inkActive()) return;
                    // Pen is down again — the phrase isn't finished yet.
                    clearTimeout(this._inkIdleTimer);
                    this._inkIdleTimer = null;
                    if (!this._inkStrokes.length) {
                        // First stroke of a phrase: remember the canvas as it is
                        // NOW (before any of this ink) so the strokes can be
                        // wiped precisely once the text comes back.
                        this._inkT0 = performance.now();
                        try { this._inkSnapshot = this.$refs.penCanvas.toDataURL('image/png'); }
                        catch (_) { this._inkSnapshot = null; }   // tainted canvas → bbox-clear fallback
                    }
                    this._inkCurStroke = [{ x, y, t: Math.round(performance.now() - this._inkT0) }];
                },

                _inkAddPoint(x, y) {
                    if (!this._inkCurStroke) return;
                    this._inkCurStroke.push({ x, y, t: Math.round(performance.now() - this._inkT0) });
                },

                _inkEndStroke() {
                    if (!this._inkCurStroke) return;
                    if (this._inkCurStroke.length) this._inkStrokes.push(this._inkCurStroke);
                    this._inkCurStroke = null;
                    if (!this._inkStrokes.length) return;
                    clearTimeout(this._inkIdleTimer);
                    this._inkIdleTimer = setTimeout(() => this._recognizeInk(), this._INK_IDLE_MS);
                },

                // Bounding box of the pending ink, in canvas pixels, padded by
                // half the pen width so the wipe covers the full stroke.
                _inkBBox() {
                    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
                    for (const s of this._inkStrokes) {
                        for (const p of s) {
                            if (p.x < minX) minX = p.x;
                            if (p.y < minY) minY = p.y;
                            if (p.x > maxX) maxX = p.x;
                            if (p.y > maxY) maxY = p.y;
                        }
                    }
                    if (!isFinite(minX)) return null;
                    const pad = Math.max(2, this.penSize * this._displayScale());
                    return {
                        x: minX - pad, y: minY - pad,
                        w: (maxX - minX) + pad * 2,
                        h: (maxY - minY) + pad * 2,
                    };
                },

                // Hand the pending ink to the native recogniser and swap in the
                // text it returns. Any failure leaves the handwriting untouched.
                async _recognizeInk() {
                    this._inkIdleTimer = null;
                    if (!this.inkToText || this.inkBusy) return;
                    if (!this._inkStrokes.length) return;
                    // The editor may have closed (save / navigate) while the idle
                    // timer was pending — never paint into a canvas nobody is on.
                    if (this.viewerMode !== 'edit') { this._inkReset(); return; }
                    const engine = await this._inkEngine();
                    if (!engine) { this._inkReset(); return; }
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) { this._inkReset(); return; }

                    const strokes  = this._inkStrokes;
                    const snapshot = this._inkSnapshot;
                    const box      = this._inkBBox();
                    // Take ownership of the buffer immediately so strokes drawn
                    // during the round-trip start a fresh phrase instead of being
                    // swallowed by this one.
                    this._inkStrokes = [];
                    this._inkCurStroke = null;
                    this._inkSnapshot = null;
                    if (!box) return;

                    this.inkBusy = true;
                    let text = '';

                    // Both native transports take the SAME payload, so it is
                    // built once whichever one answers.
                    const payload = JSON.stringify({
                        language: this.inkLang,
                        writingArea: { width: canvas.width, height: canvas.height },
                        preContext: '',
                        strokes: strokes.map(s => s.map(p => ({
                            x: Math.round(p.x * 100) / 100,
                            y: Math.round(p.y * 100) / 100,
                            t: p.t,
                        }))),
                    });

                    // ── Loopback agent path (separate Handwriting Agent app) ──
                    if (engine.kind === 'agent') {
                        let out;
                        try {
                            out = await this._recognizeViaAgent(payload);
                        } finally {
                            this.inkBusy = false;
                        }
                        if (!out || !out.ok) {
                            const err = (out && out.error) || 'agent unreachable';
                            plog('warn', 'ink', 'agent recognition failed: ' + err);
                            this.showToast('[agent] ' + this._friendlyInkError(err), 'error', false, 7000);
                            return;
                        }
                        text = out.text;
                        if (!text) {
                            plog('info', 'ink', 'agent returned no text — ink left as-is');
                            this.showToast('Could not read that handwriting — left as ink.', 'error');
                            return;
                        }
                        plog('info', 'ink', 'recognised "' + text + '" via agent (' + strokes.length + ' strokes)');
                        this._applyInkText(text, box, snapshot);
                        return;
                    }

                    // ── Browser fallback path ──
                    if (engine.kind === 'web') {
                        try {
                            const webText = await this._recognizeViaWeb(strokes);
                            if (webText === null) {
                                plog('warn', 'ink', 'browser recogniser unavailable for ' + this.inkLang);
                                this.showToast(
                                    'Handwriting recognition is not available for ' + this.inkLang + ' in this browser — your writing was left as ink.',
                                    'error', false, 5000);
                                return;
                            }
                            text = webText;
                        } finally {
                            this.inkBusy = false;
                        }
                        if (!text) {
                            plog('info', 'ink', 'browser recogniser returned no text — ink left as-is');
                            this.showToast('Could not read that handwriting — left as ink.', 'error');
                            return;
                        }
                        plog('info', 'ink', 'recognised "' + text + '" via browser (' + strokes.length + ' strokes)');
                        this._applyInkText(text, box, snapshot);
                        return;
                    }

                    // ── In-app native bridge path ──
                    const bridge = engine.bridge;
                    try {
                        const resultP = new Promise((resolve) => { this._inkResolve = resolve; });
                        let immediate;
                        try { immediate = bridge.recognize(payload); } catch (_) { immediate = undefined; }
                        if (immediate && typeof immediate.then === 'function') {
                            try { immediate = await immediate; } catch (_) { immediate = undefined; }
                        }
                        let out;
                        if (immediate !== undefined && immediate !== null && immediate !== true && immediate !== '') {
                            out = { ok: true, data: immediate };            // synchronous bridge
                        } else {
                            const timeoutP = new Promise((resolve) => setTimeout(
                                () => resolve({ ok: false, error: 'timeout' }), this._INK_TIMEOUT_MS));
                            out = await Promise.race([resultP, timeoutP]);  // async-callback bridge
                        }
                        this._inkResolve = null;
                        if (!out || !out.ok) {
                            plog('warn', 'ink', 'recognition failed: ' + ((out && out.error) || 'no result'));
                            this.showToast('[in-app] ' + this._friendlyInkError((out && out.error) || ''), 'error', false, 7000);
                            return;                                          // ink stays as drawn
                        }
                        text = this._inkResultToText(out.data);
                    } catch (e) {
                        this._inkResolve = null;
                        plog('warn', 'ink', 'recognition threw: ' + (e && e.message || e));
                        return;
                    } finally {
                        this.inkBusy = false;
                    }

                    if (!text) {
                        plog('info', 'ink', 'recogniser returned no text — ink left as-is');
                        this.showToast('Could not read that handwriting — left as ink.', 'error');
                        return;
                    }
                    plog('info', 'ink', 'recognised "' + text + '" (' + strokes.length + ' strokes)');
                    this._applyInkText(text, box, snapshot);
                },

                // Accept a plain string, a JSON string, or an object from the
                // bridge. Recognised candidates may arrive as {text} / {candidates:[…]}.
                _inkResultToText(raw) {
                    if (raw === null || raw === undefined) return '';
                    let v = raw;
                    if (typeof v === 'string') {
                        const s = v.trim();
                        if (!s) return '';
                        if (s.startsWith('{') || s.startsWith('[')) {
                            try { v = JSON.parse(s); } catch (_) { return s; }
                        } else {
                            return s;
                        }
                    }
                    if (Array.isArray(v)) {
                        const first = v[0];
                        return (typeof first === 'string') ? first.trim() : this._inkResultToText(first);
                    }
                    if (v && typeof v === 'object') {
                        if (typeof v.text === 'string') return v.text.trim();
                        if (Array.isArray(v.candidates) && v.candidates.length) return this._inkResultToText(v.candidates[0]);
                        if (typeof v.result === 'string') return v.result.trim();
                    }
                    return '';
                },

                // Map an engine error to something a nurse can act on. Anything
                // unrecognised keeps the RAW code in the message — swallowing it
                // leaves nobody able to diagnose a tablet in the field.
                _friendlyInkError(raw) {
                    const code = String(raw || '').trim();
                    const s = code.toLowerCase();
                    if (s.includes('timeout') || s.includes('timed out'))
                        return 'Handwriting recognition timed out — your writing was left as ink.';
                    if (s.includes('model_not_downloaded') || s.includes('model') || s.includes('download'))
                        return 'The handwriting model is still downloading — connect to Wi-Fi, open the Handwriting Agent app and tap "Download English model".';
                    if (s.includes('unsupported') || s.includes('language'))
                        return 'This language is not available for handwriting recognition on this device.';
                    if (s.includes('unreachable') || s.includes('failed to fetch') || s.includes('networkerror'))
                        return 'Could not reach the Handwriting Agent — make sure the agent app is installed and running on this device.';
                    if (s.includes('no_strokes') || s.includes('bad_payload'))
                        return 'Handwriting could not be sent for recognition (' + code + ') — your writing was left as ink.';
                    if (s.startsWith('http '))
                        return 'The Handwriting Agent returned an error (' + code + ') — your writing was left as ink.';
                    return 'Handwriting recognition failed'
                        + (code ? ' (' + code + ')' : '')
                        + ' — your writing was left as ink.';
                },

                // Replace the recognised handwriting with the text, in place:
                // wipe exactly the pixels the ink occupied, then draw the text
                // inside the same bounding box (same colour as the ink). The whole
                // swap is ONE undo step, so a wrong reading is one tap away from
                // the original handwriting.
                //
                // The wipe is scoped to the ink's BOUNDING BOX, never the whole
                // canvas: the user can keep writing during the round-trip, and a
                // full-canvas restore of the pre-phrase snapshot would erase those
                // newer strokes. Restoring just the box puts back whatever was
                // underneath the handwriting and leaves everything else alone.
                _applyInkText(text, box, snapshot) {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas || !this._ctx) return;
                    this._pushUndo();
                    const paint = () => {
                        const ctx = this._ctx;
                        ctx.save();
                        ctx.setTransform(1, 0, 0, 1, 0, 0);
                        ctx.globalCompositeOperation = 'source-over';
                        // Type size follows the handwriting: the ink box height is
                        // ascender-to-descender, so ~0.78 of it is the em size.
                        let fontPx = Math.max(14, Math.round(box.h * 0.78));
                        const family = '"Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
                        ctx.textBaseline = 'alphabetic';
                        ctx.fillStyle = this.editColor;
                        // Never let the text run off the right edge — shrink to fit
                        // the space that is actually available from the ink's left.
                        const avail = Math.max(40, canvas.width - box.x - 8);
                        ctx.font = fontPx + 'px ' + family;
                        let w = ctx.measureText(text).width;
                        if (w > avail) {
                            fontPx = Math.max(12, Math.floor(fontPx * (avail / w)));
                            ctx.font = fontPx + 'px ' + family;
                            w = ctx.measureText(text).width;
                        }
                        // Baseline sits where a writer's baseline sits inside the
                        // ink box — descenders take roughly the bottom fifth.
                        const baseline = box.y + box.h * 0.80;
                        ctx.fillText(text, box.x, baseline);
                        ctx.restore();
                        this._redoStack = [];
                    };
                    // Clip the box to the backing store — a stroke that ran off the
                    // edge would otherwise produce a source rect drawImage rejects.
                    const clip = {
                        x: Math.max(0, Math.floor(box.x)),
                        y: Math.max(0, Math.floor(box.y)),
                    };
                    clip.w = Math.min(canvas.width  - clip.x, Math.ceil(box.x + box.w) - clip.x);
                    clip.h = Math.min(canvas.height - clip.y, Math.ceil(box.y + box.h) - clip.y);

                    const wipeFlat = () => {
                        const ctx = this._ctx;
                        ctx.save();
                        ctx.setTransform(1, 0, 0, 1, 0, 0);
                        ctx.clearRect(clip.x, clip.y, clip.w, clip.h);
                        ctx.restore();
                    };

                    if (snapshot && clip.w > 0 && clip.h > 0) {
                        // Put back the pre-phrase pixels for the ink's box only.
                        const img = new Image();
                        img.onload = () => {
                            const ctx = this._ctx;
                            ctx.save();
                            ctx.setTransform(1, 0, 0, 1, 0, 0);
                            ctx.globalCompositeOperation = 'source-over';
                            ctx.clearRect(clip.x, clip.y, clip.w, clip.h);
                            // The snapshot is the same backing-store size as the
                            // canvas, so source and destination rects match 1:1.
                            try {
                                ctx.drawImage(img, clip.x, clip.y, clip.w, clip.h,
                                                   clip.x, clip.y, clip.w, clip.h);
                            } catch (_) { /* already cleared — good enough */ }
                            ctx.restore();
                            paint();
                        };
                        img.onerror = () => { wipeFlat(); paint(); };
                        img.src = snapshot;
                    } else {
                        // Tainted canvas (no snapshot) — clear the ink's box outright.
                        wipeFlat();
                        paint();
                    }
                },

                // ── undo / redo (snapshot-based) ──
                _pushUndo() {
                    if (!this.$refs.penCanvas) return;
                    // Every mutating action snapshots here first, so this is the
                    // choke point that keeps _editMutations honest (see the note
                    // on _isCanvasUnchanged). Counted even if the snapshot throws
                    // on a tainted canvas — the pixels still changed.
                    this._editMutations++;
                    try {
                        this._undoStack.push(this.$refs.penCanvas.toDataURL('image/png'));
                        if (this._undoStack.length > 40) this._undoStack.shift();
                    } catch (_) { /* tainted canvas — ignore */ }
                },

                _restoreFromDataUrl(dataUrl, onDone) {
                    // Repaints the whole canvas (undo / redo / reset), so it is a
                    // mutation for _editMutations purposes — restoring to the
                    // original still has to fall through to the exact compare.
                    this._editMutations++;
                    const img = new Image();
                    img.onload = () => {
                        const canvas = this.$refs.penCanvas;
                        const ctx = this._ctx;
                        ctx.save();
                        ctx.setTransform(1, 0, 0, 1, 0, 0);
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        // Always draw the snapshot to fill the full canvas
                        // backing-store so a paste / undo stays aligned even
                        // if the canvas was resized to a larger image.
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                        ctx.restore();
                        if (typeof onDone === 'function') onDone();
                    };
                    img.onerror = () => {
                        // Image failed to load (usually a CORS rejection
                        // when the S3 bucket doesn't send Access-Control-
                        // Allow-Origin). Skip the paint so the canvas stays
                        // clean — user can still draw fresh strokes on top
                        // and Save works because the canvas isn't tainted.
                        // The previously-saved image is unchanged on the
                        // server; we just can't trace it onto the editor.
                        if (typeof onDone === 'function') onDone();
                    };
                    // Cross-origin images painted via drawImage taint the
                    // canvas — once tainted, toBlob() / toDataURL() throw
                    // SecurityError forever (the cause of the recurring
                    // "Could not capture the page" error after editing a
                    // saved page). Setting crossOrigin BEFORE setting src
                    // makes the browser request the image with CORS; if S3
                    // responds with Access-Control-Allow-Origin, the canvas
                    // stays clean. data: URLs (undo/redo snapshots) don't
                    // need CORS and the check skips them.
                    if (typeof dataUrl === 'string' && /^https?:/i.test(dataUrl)) {
                        img.crossOrigin = 'anonymous';
                    }
                    img.src = dataUrl;
                },

                doUndo() {
                    if (!this._undoStack.length) return;
                    // A pending ink phrase is anchored to a snapshot that undo is
                    // about to invalidate — drop it rather than wipe the wrong pixels.
                    this._inkReset();
                    try { this._redoStack.push(this.$refs.penCanvas.toDataURL('image/png')); } catch (_) {}
                    const prev = this._undoStack.pop();
                    this._restoreFromDataUrl(prev);
                },

                doRedo() {
                    if (!this._redoStack.length) return;
                    this._inkReset();
                    try { this._undoStack.push(this.$refs.penCanvas.toDataURL('image/png')); } catch (_) {}
                    const next = this._redoStack.pop();
                    this._restoreFromDataUrl(next);
                },

                // Reset — restores the canvas to the state it had at the
                // start of this edit session (after any queued paste was
                // painted). Wipes everything the user has drawn since.
                // Pushes an undo entry first so the reset itself is undoable.
                doRefresh() {
                    if (!this.$refs.penCanvas) return;
                    this._pushUndo();
                    if (this._initialSnapshot) {
                        this._restoreFromDataUrl(this._initialSnapshot);
                    } else {
                        // No snapshot captured yet — fall back to clear.
                        const ctx = this._ctx;
                        const c = this.$refs.penCanvas;
                        ctx.save();
                        ctx.setTransform(1, 0, 0, 1, 0, 0);
                        ctx.clearRect(0, 0, c.width, c.height);
                        ctx.restore();
                    }
                    this._redoStack = [];
                },

                // ── Copy page / Paste page (whole canvas) ──
                // Copy/paste grant (p_id 90). The Copy/Paste controls are already
                // hidden without it; guard every entry point too so no code path
                // copies or pastes. Returns false + toasts when blocked.
                _canCopyPaste() {
                    if (this.me && this.me.can_copy_paste_pages) return true;
                    this.showToast('You have not authority to Copy/Paste page.', 'error');
                    return false;
                },

                async copyPage() {
                    if (!this._canCopyPaste()) return;
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return;
                    try {
                        this._pageClipboard = canvas.toDataURL('image/png');
                        // Remember which category this was copied from — paste is
                        // gated to a NEW page of the SAME category (see pastePage).
                        this._pageClipboardCatId = this._editCatId;
                        const blob = await new Promise(r => canvas.toBlob(r, 'image/png'));
                        if (blob && navigator.clipboard && window.ClipboardItem) {
                            await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                        }
                    } catch (e) {
                        console.warn('[pwa] copyPage failed', e);
                    }
                },

                // The category id the user is currently working in — the paste
                // target. In edit mode it's the page's resolved category; from the
                // grid/detail it's the open category (null in the aggregate "All"
                // view, which can't be a single paste target).
                _currentTargetCatId() {
                    if (this.viewerMode === 'edit') return this._editCatId;
                    return (this.viewerCategory && !this.viewerCategory.isAll && this.viewerCategory.id) || null;
                },

                // Both ids present and equal (string-compared so 5 === '5').
                _sameCategory(a, b) {
                    return a != null && b != null && String(a) === String(b);
                },

                // Paste page rules:
                //   - In-app copied content lands on a NEW page of the SAME
                //     category only; pasting into another category errors out.
                //   - The copied content is single-use: it's consumed on the
                //     first paste so it can't be pasted again.
                //   - It only fills a NEW BLANK page (a blank edit canvas, or a
                //     fresh edit session opened from the grid). Pasting while an
                //     existing saved page — or any page that already has content —
                //     is open is REFUSED with an error: it must never overwrite or
                //     auto-save existing page content.
                // An external screenshot (system clipboard, no source category)
                // isn't gated/consumed — it behaves like inserting a fresh image.
                async pastePage() {
                    if (!this._canCopyPaste()) return;
                    let url, internal = false, srcCat = null;
                    if (this._pageClipboard) {
                        url = this._pageClipboard; internal = true; srcCat = this._pageClipboardCatId;
                    } else {
                        url = await this._resolveClipboardImage();
                    }
                    if (!url) { this.showToast('Nothing to paste', 'error'); return; }

                    if (internal && !this._sameCategory(this._currentTargetCatId(), srcCat)) {
                        this.showToast('Copied page can be pasted only on a new page of the same category.', 'error');
                        return;
                    }

                    if (this.viewerMode === 'edit') {
                        // Whole-page paste fills a NEW BLANK page only. It must NOT
                        // overwrite an existing saved page or a page that already
                        // has content (and must never auto-save it). Refuse with an
                        // error in those cases.
                        if (this._editingRecordId || !this._isCanvasBlank()) {
                            this.showToast('Page paste works only on a new blank page — it can\'t replace an existing page.', 'error');
                            return;
                        }
                        // Newly opened blank page — paste here.
                        this._pushUndo();
                        this._restoreFromDataUrl(url);
                        if (internal) this._consumePageClipboard();
                        return;
                    }
                    // Not in the editor (grid / detail) — open a fresh NEW page
                    // pre-loaded with the clipboard.
                    this.startEdit({ paste: url });
                    if (internal) this._consumePageClipboard();
                },

                // Single-use: drop the copied page so it can't be pasted twice.
                _consumePageClipboard() {
                    this._pageClipboard = null;
                    this._pageClipboardCatId = null;
                },

                // Pull an image off the system clipboard first (so screenshots
                // taken outside the PWA can be pasted in); fall back to our
                // own _pageClipboard buffer.
                async _resolveClipboardImage() {
                    try {
                        if (navigator.clipboard && navigator.clipboard.read) {
                            const items = await navigator.clipboard.read();
                            for (const item of items) {
                                const type = item.types.find(t => t.startsWith('image/'));
                                if (type) {
                                    const blob = await item.getType(type);
                                    return URL.createObjectURL(blob);
                                }
                            }
                        }
                    } catch (_) { /* fall through */ }
                    return this._pageClipboard || null;
                },

                // True iff the canvas has zero non-transparent pixels.
                _isCanvasBlank() {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas || !this._ctx) return true;
                    try {
                        const data = this._ctx.getImageData(0, 0, canvas.width, canvas.height).data;
                        for (let i = 3; i < data.length; i += 4) {
                            if (data[i] !== 0) return false;
                        }
                        return true;
                    } catch (_) {
                        return false; // conservative — assume content if the read fails
                    }
                },

                // ══ Selective copy / paste (region) ═══════════════════════════
                // The selection is a BOX, not a drag-to-draw marquee: opening
                // the mode drops a rectangle in the middle of the page, and the
                // user nudges it into place with a fingertip. Requiring a stylus
                // drag to even summon the selection was the old behaviour and
                // made the feature unusable one-handed at a bedside.
                startSelectiveCopy() {
                    if (!this._canCopyPaste()) return;
                    this.selectionMode = 'copy';
                    this._selDrag = null;
                    // Wait for the overlay to exist before measuring the wrap.
                    this.$nextTick(() => {
                        this._resetSelectionToCentre();
                        window.lucide && window.lucide.createIcons();
                    });
                },

                cancelSelectiveCopy() {
                    this.selectionMode = 'none';
                    this._selectionRect = null;
                    this._selDrag = null;
                },

                // Drop a default box in the centre of whatever part of the page
                // is actually on screen — 60% x 40% of the visible page area, so
                // it is big enough to grab but never starts off-screen when the
                // form is zoomed or panned.
                _resetSelectionToCentre() {
                    const wrap = this.$refs.canvasWrap;
                    const page = this.$refs.canvasPage;
                    if (!wrap) return;
                    const wr = wrap.getBoundingClientRect();
                    const pr = page ? page.getBoundingClientRect() : wr;
                    // Visible intersection of the page and its viewport.
                    const left   = Math.max(pr.left,   wr.left);
                    const right  = Math.min(pr.right,  wr.right);
                    const top    = Math.max(pr.top,    wr.top);
                    const bottom = Math.min(pr.bottom, wr.bottom);
                    const vw = Math.max(0, right - left);
                    const vh = Math.max(0, bottom - top);
                    if (vw < 8 || vh < 8) {          // page entirely off-screen
                        this._selectionRect = { x: wr.width * 0.2, y: wr.height * 0.3, w: wr.width * 0.6, h: wr.height * 0.4 };
                        return;
                    }
                    const w = Math.max(80, vw * 0.6);
                    const h = Math.max(80, vh * 0.4);
                    this._selectionRect = {
                        x: (left - wr.left) + (vw - w) / 2,
                        y: (top  - wr.top)  + (vh - h) / 2,
                        w, h,
                    };
                },

                // Corner handle placement — half outside the box on both axes.
                _selHandleStyle(hnd) {
                    const off = '-14px';                       // half of w-7 (28px)
                    const v = (hnd[0] === 'n') ? 'top:' + off + ';' : 'bottom:' + off + ';';
                    const h = (hnd[1] === 'w') ? 'left:' + off + ';' : 'right:' + off + ';';
                    return v + h + 'touch-action:none;';
                },

                // ── box drag / resize (works with finger, stylus or mouse) ──
                selDown(mode, e) {
                    if (!this._selectionRect) return;
                    this._selDrag = {
                        mode,
                        x0: e.clientX,
                        y0: e.clientY,
                        rect0: Object.assign({}, this._selectionRect),
                    };
                    try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
                },

                selMove(e) {
                    const d = this._selDrag;
                    if (!d) return;
                    const wrap = this.$refs.canvasWrap;
                    if (!wrap) return;
                    const wr = wrap.getBoundingClientRect();
                    const MIN = 48;                            // keep it grabbable
                    const dx = e.clientX - d.x0;
                    const dy = e.clientY - d.y0;
                    const r0 = d.rect0;
                    let r;

                    if (d.mode === 'move') {
                        r = { x: r0.x + dx, y: r0.y + dy, w: r0.w, h: r0.h };
                    } else {
                        let l = r0.x, t = r0.y, rt = r0.x + r0.w, b = r0.y + r0.h;
                        if (d.mode.indexOf('w') >= 0) l  = r0.x + dx;
                        if (d.mode.indexOf('e') >= 0) rt = r0.x + r0.w + dx;
                        if (d.mode.indexOf('n') >= 0) t  = r0.y + dy;
                        if (d.mode.indexOf('s') >= 0) b  = r0.y + r0.h + dy;
                        // Don't let a corner cross its opposite edge.
                        if (rt - l < MIN) { if (d.mode.indexOf('w') >= 0) l = rt - MIN; else rt = l + MIN; }
                        if (b  - t < MIN) { if (d.mode.indexOf('n') >= 0) t = b  - MIN; else b  = t + MIN; }
                        r = { x: l, y: t, w: rt - l, h: b - t };
                    }

                    // Keep the whole box inside the viewport so it can never be
                    // dragged somewhere it cannot be grabbed back from.
                    r.w = Math.min(r.w, wr.width);
                    r.h = Math.min(r.h, wr.height);
                    r.x = Math.max(0, Math.min(r.x, wr.width  - r.w));
                    r.y = Math.max(0, Math.min(r.y, wr.height - r.h));
                    this._selectionRect = r;
                },

                selUp(e) {
                    this._selDrag = null;
                    try { e.target.releasePointerCapture(e.pointerId); } catch (_) {}
                },

                // canvasWrap coords -> canvas backing-store pixels.
                _wrapToCanvas(wx, wy) {
                    const canvas = this.$refs.penCanvas;
                    const wr = this.$refs.canvasWrap.getBoundingClientRect();
                    const cr = canvas.getBoundingClientRect();
                    const sx = cr.width  ? canvas.width  / cr.width  : 1;
                    const sy = cr.height ? canvas.height / cr.height : 1;
                    return {
                        x: ((wx + wr.left) - cr.left) * sx,
                        y: ((wy + wr.top)  - cr.top)  * sy,
                    };
                },

                // Crop the selected region out of the canvas into the clipboard.
                confirmSelectiveCopy() {
                    const r = this._selectionRect;
                    const canvas = this.$refs.penCanvas;
                    if (!r || !canvas) { this.cancelSelectiveCopy(); return; }

                    const p0 = this._wrapToCanvas(r.x, r.y);
                    const p1 = this._wrapToCanvas(r.x + r.w, r.y + r.h);
                    let x = Math.round(Math.min(p0.x, p1.x));
                    let y = Math.round(Math.min(p0.y, p1.y));
                    let w = Math.round(Math.abs(p1.x - p0.x));
                    let h = Math.round(Math.abs(p1.y - p0.y));

                    // The box may overhang the page — clamp to the canvas so the
                    // crop never asks for pixels that don't exist.
                    const nx = Math.max(0, x);
                    const ny = Math.max(0, y);
                    w = Math.min(w - (nx - x), canvas.width  - nx);
                    h = Math.min(h - (ny - y), canvas.height - ny);
                    x = nx; y = ny;

                    if (w < 4 || h < 4) {
                        this.showToast('Selection is outside the page — move it over the form and try again.', 'error');
                        return;                                 // keep the box up
                    }
                    // Crop into a fresh off-screen canvas so the clipboard
                    // payload is just the selected pixels.
                    const tmp = document.createElement('canvas');
                    tmp.width = w; tmp.height = h;
                    tmp.getContext('2d').drawImage(canvas, x, y, w, h, 0, 0, w, h);
                    try {
                        // srcW/srcH: the page this region came from. Kept so a
                        // paste onto a different-resolution template can restore
                        // the same on-page size instead of the same pixel count.
                        this._selectionClipboard = {
                            dataUrl: tmp.toDataURL('image/png'), w, h,
                            srcW: canvas.width, srcH: canvas.height,
                        };
                        this.showToast('Area copied — use Paste to place it on a new page.', 'success');
                    } catch (_) {
                        this.showToast('Could not copy that area.', 'error');
                    }
                    this.cancelSelectiveCopy();
                },

                // Selective paste rule (mirrors Paste page): the selection
                // ALWAYS lands on a newly added page — never on top of
                // existing strokes. Same three-branch flow:
                //   - edit + blank canvas: paste here
                //   - edit + has strokes:  save current, then start new + paste
                //   - grid / empty:        start new + paste
                selectivePaste() {
                    if (!this._canCopyPaste()) return;
                    if (!this._selectionClipboard) return;
                    const clip = this._selectionClipboard;

                    // Unlike whole-page paste, a selection is REUSABLE and flexible:
                    //   - pasteable multiple times onto ANY category page (it stays
                    //     on the clipboard until a new selection is copied),
                    //   - lands on the CURRENT page — a new blank page OR an
                    //     existing page with content alike (it doesn't force a new
                    //     page the way whole-page paste does),
                    //   - and enters the interactive placement overlay so the user
                    //     can DRAG it where they want (resize/rotate too), then tap
                    //     Place to commit.
                    // So no category gate and no consume here.
                    if (this.viewerMode === 'edit') {
                        this._beginSelectionPlacement(clip);
                        return;
                    }
                    // Not in the editor (grid / detail) — open a fresh edit session,
                    // then drop into placement once the canvas is ready.
                    this.startEdit({ pasteSelection: clip });
                },

                // Enter the placement overlay for a selection clip: DRAG to position
                // then tap Place. Pasted regions are placed as-is — no resize, no
                // rotate. The clip stays on the clipboard, so it can be pasted again.
                _beginSelectionPlacement(clip) {
                    if (!clip || !clip.dataUrl) return;
                    if (!this._ctx) this.initCanvas();
                    const cw = this._placeCanvasW(), ch = this._placeCanvasH();
                    let w = clip.w, h = clip.h;
                    // Templates do not all share a resolution. Pasting raw pixels
                    // onto a higher-resolution page would occupy a smaller
                    // FRACTION of it and so look shrunken, even though the pixel
                    // count is unchanged. Rescale by the page-size ratio so the
                    // region covers the same portion of the page it did when
                    // copied — that is what "same size" means to the user, since
                    // both pages render into the same screen area.
                    if (clip.srcW && clip.srcH && (clip.srcW !== cw || clip.srcH !== ch)) {
                        const s = Math.min(cw / clip.srcW, ch / clip.srcH);   // keep aspect
                        w = clip.w * s;
                        h = clip.h * s;
                    }
                    this._beginPlacement(clip.dataUrl, w, h, { resizable: false, rotatable: false, fit: 1 });
                },

                _paintSelectionClip(clip, onDone) {
                    if (!clip || !this._ctx) return;
                    const img = new Image();
                    img.onload = () => {
                        const canvas = this.$refs.penCanvas;
                        const cx = canvas.width / 2;
                        const cy = canvas.height / 2;
                        const x = Math.round(cx - clip.w / 2);
                        const y = Math.round(cy - clip.h / 2);
                        this._ctx.save();
                        this._ctx.setTransform(1, 0, 0, 1, 0, 0);
                        this._ctx.globalCompositeOperation = 'source-over';
                        this._ctx.drawImage(img, x, y);
                        this._ctx.restore();
                        if (typeof onDone === 'function') onDone();
                    };
                    img.src = clip.dataUrl;
                },

                // Lazy file input — shared helper so camera + gallery can
                // both feed into the same insertion path.
                _ensureFileInput(refKey, withCapture) {
                    if (this[refKey]) return this[refKey];
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = 'image/*';
                    if (withCapture) input.capture = 'environment';
                    input.style.display = 'none';
                    input.addEventListener('change', () => {
                        const f = input.files && input.files[0];
                        // Crop first — placement opens on the cropped image.
                        if (f) this._openCropper(f, (b) => this._insertImageFile(b));
                        input.value = '';
                    });
                    document.body.appendChild(input);
                    this[refKey] = input;
                    return input;
                },

                pickFromGallery() {
                    this._ensureFileInput('_fileInput', false).click();
                },

                captureFromCamera() {
                    // The capture="environment" hint asks the OS for the rear
                    // camera. On desktops with no camera the OS shows the
                    // normal file picker instead — no failure path needed.
                    this._ensureFileInput('_cameraInput', true).click();
                },

                // ══ IMAGE CROP ════════════════════════════════════════════
                // Gate between "a photo was picked / captured" and "place it
                // on the page": the image opens full-screen with a draggable
                // crop box (starting at the whole image), and only what the
                // box keeps is handed to `onDone` — which is the editor's own
                // _insertImageFile / _rbInsertImageFile / _afInsertImageFile /
                // _tplInsertImageFile, i.e. the placement overlay opens with
                // the CROPPED image. Cancelling drops the photo, so nothing
                // reaches the canvas uncropped.
                // `onCancel` (optional) fires when the user cancels or the image
                // can't be read — the document-upload queue uses it to move on to
                // the next picked file instead of stalling.
                _openCropper(file, onDone, onCancel) {
                    if (!file) return;
                    const url = URL.createObjectURL(file);
                    const img = new Image();
                    img.onload = () => {
                        this._cropDrag = null;
                        this._cropBusy = false;
                        this._cropDone = onDone;
                        this._cropCancel = onCancel || null;
                        // box/rect are filled by _cropFit() once the stage is
                        // laid out (the <img> @load fires right after this).
                        this._crop = {
                            url,
                            iw: img.naturalWidth  || img.width,
                            ih: img.naturalHeight || img.height,
                            box: { x: 0, y: 0, w: 0, h: 0 },
                            rect: { x: 0, y: 0, w: 0, h: 0 },
                        };
                        this.$nextTick(() => {
                            this._cropFit();
                            window.lucide && window.lucide.createIcons();
                        });
                    };
                    img.onerror = () => {
                        try { URL.revokeObjectURL(url); } catch (_) {}
                        this.showToast('That image could not be opened', 'error');
                        if (typeof onCancel === 'function') onCancel();
                    };
                    img.src = url;
                },

                // Letterbox the image inside the stage and (re)fit the crop box.
                // On a re-fit (rotation / resize) the box keeps the same share
                // of the image rather than jumping back to full frame.
                _cropFit() {
                    const c = this._crop;
                    if (!c || !c.iw || !c.ih) return;
                    // $refs can be empty for nodes inside a template x-if, so
                    // fall back to the id.
                    const stage = this.$refs.cropStage || document.getElementById('cropStage');
                    if (!stage) return;
                    const r = stage.getBoundingClientRect();
                    if (!r.width || !r.height) return;
                    const s = Math.min(r.width / c.iw, r.height / c.ih);
                    const w = c.iw * s, h = c.ih * s;
                    const old = c.box;
                    if (old && old.w > 0 && old.h > 0 && c.rect && c.rect.w > 0) {
                        const kx = w / old.w, ky = h / old.h;
                        c.rect = {
                            x: c.rect.x * kx, y: c.rect.y * ky,
                            w: c.rect.w * kx, h: c.rect.h * ky,
                        };
                    } else {
                        c.rect = { x: 0, y: 0, w, h };      // start: whole image
                    }
                    c.box = { x: (r.width - w) / 2, y: (r.height - h) / 2, w, h };
                },

                _resetCrop() {
                    const c = this._crop;
                    if (!c || !c.box.w) return;
                    c.rect = { x: 0, y: 0, w: c.box.w, h: c.box.h };
                },

                // The crop box itself; the 9999px shadow dims everything
                // outside it, so the kept region reads at a glance.
                _cropRectStyle() {
                    const c = this._crop;
                    if (!c) return 'display:none;';
                    return 'left:'   + (c.box.x + c.rect.x) + 'px;'
                         + 'top:'    + (c.box.y + c.rect.y) + 'px;'
                         + 'width:'  + c.rect.w + 'px;'
                         + 'height:' + c.rect.h + 'px;'
                         + 'box-shadow: 0 0 0 9999px rgba(15,23,42,0.72);'
                         + 'touch-action:none;';
                },

                // ── crop box drag / resize (finger, stylus or mouse) ──
                _cropDown(mode, e) {
                    if (!this._crop) return;
                    this._cropDrag = {
                        mode,
                        x0: e.clientX, y0: e.clientY,
                        rect0: { ...this._crop.rect },
                    };
                    try { e.currentTarget.setPointerCapture(e.pointerId); } catch (_) {}
                },
                _cropMove(e) {
                    const d = this._cropDrag, c = this._crop;
                    if (!d || !c) return;
                    const dx = e.clientX - d.x0, dy = e.clientY - d.y0;
                    const B = c.box, MIN = 32;
                    const r = { ...d.rect0 };
                    if (d.mode === 'move') {
                        r.x = Math.max(0, Math.min(d.rect0.x + dx, B.w - r.w));
                        r.y = Math.max(0, Math.min(d.rect0.y + dy, B.h - r.h));
                    } else {
                        if (d.mode === 'nw' || d.mode === 'sw') {          // west edge
                            const nx = Math.max(0, Math.min(d.rect0.x + dx, d.rect0.x + d.rect0.w - MIN));
                            r.w = d.rect0.w + (d.rect0.x - nx);
                            r.x = nx;
                        } else {                                          // east edge
                            r.w = Math.max(MIN, Math.min(d.rect0.w + dx, B.w - d.rect0.x));
                        }
                        if (d.mode === 'nw' || d.mode === 'ne') {          // north edge
                            const ny = Math.max(0, Math.min(d.rect0.y + dy, d.rect0.y + d.rect0.h - MIN));
                            r.h = d.rect0.h + (d.rect0.y - ny);
                            r.y = ny;
                        } else {                                          // south edge
                            r.h = Math.max(MIN, Math.min(d.rect0.h + dy, B.h - d.rect0.y));
                        }
                    }
                    c.rect = r;
                },
                _cropUp(e) {
                    try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
                    this._cropDrag = null;
                },

                // Bake the crop at the image's OWN resolution (stage px →
                // natural px), then hand the blob to the waiting editor.
                _applyCrop() {
                    const c = this._crop;
                    if (!c || this._cropBusy) return;
                    if (!c.box.w || !c.box.h) return;
                    const done = this._cropDone;
                    const sx = c.iw / c.box.w, sy = c.ih / c.box.h;
                    const x = Math.max(0, Math.round(c.rect.x * sx));
                    const y = Math.max(0, Math.round(c.rect.y * sy));
                    const w = Math.max(1, Math.min(Math.round(c.rect.w * sx), c.iw - x));
                    const h = Math.max(1, Math.min(Math.round(c.rect.h * sy), c.ih - y));
                    const url = c.url;
                    this._cropBusy = true;
                    // A FRESH Image (never one stored on the Alpine state —
                    // drawImage rejects a reactive proxy), same as the
                    // placement commit path does.
                    const img = new Image();
                    img.onload = () => {
                        try {
                            const cv = document.createElement('canvas');
                            cv.width = w; cv.height = h;
                            cv.getContext('2d').drawImage(img, x, y, w, h, 0, 0, w, h);
                            cv.toBlob((b) => this._finishCrop(b, done), 'image/png');
                        } catch (_) {
                            this._finishCrop(null, done);
                        }
                    };
                    img.onerror = () => this._finishCrop(null, done);
                    img.src = url;
                },
                _finishCrop(blob, done) {
                    this._cropBusy = false;
                    const cancelled = this._cropCancel;
                    this._closeCrop();
                    if (!blob) {
                        this.showToast('Could not crop that image', 'error');
                        if (typeof cancelled === 'function') cancelled();
                        return;
                    }
                    if (typeof done === 'function') done(blob);
                },
                _cancelCrop() {
                    if (this._cropBusy) return;
                    const cancelled = this._cropCancel;
                    this._closeCrop();
                    if (typeof cancelled === 'function') cancelled();
                },
                _closeCrop() {
                    const c = this._crop;
                    this._crop = null;
                    this._cropDrag = null;
                    this._cropDone = null;
                    this._cropCancel = null;
                    if (c && c.url) { try { URL.revokeObjectURL(c.url); } catch (_) {} }
                },

                // Drop a picked / captured image into the canvas. Instead of
                // baking it immediately, enter interactive placement: the image
                // shows as a movable + pinch-scalable overlay (initially 50% of
                // the canvas, centered), committed onto the page only when the
                // user taps "Place" (_commitPlacement). The object URL is kept
                // alive until commit/cancel.
                _insertImageFile(file) {
                    if (!this._ctx) this.initCanvas();
                    const url = URL.createObjectURL(file);
                    const img = new Image();
                    img.onload = () => {
                        // Via the helpers, NOT $refs.penCanvas directly: a bare
                        // deref throws inside this load handler when the ref is
                        // momentarily unavailable, and the exception is swallowed
                        // — the image then never appears and nothing is reported.
                        const cw = this._placeCanvasW(), ch = this._placeCanvasH();
                        const maxW = cw * 0.5, maxH = ch * 0.5;
                        const r = Math.min(maxW / img.width, maxH / img.height, 1);
                        const w = img.width * r, h = img.height * r;
                        const x = (cw - w) / 2,  y = (ch - h) / 2;
                        this._placeTouches.clear();
                        this._placeStart = null;
                        // Store only plain data (NOT the Image element — Alpine
                        // would proxy it and ctx.drawImage rejects a proxy). A
                        // fresh Image is created from the url at commit time.
                        // snap90:false — camera/gallery images twist to ANY angle.
                        // The addressograph family + thumb impression go through
                        // _beginPlacement and snap to 90° steps instead. Start angle
                        // follows the page orientation/rotation (landscape pages).
                        this._placing = { url, x, y, w, h, rot: this._placementInitialRot(), snap90: false, resizable: true };
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    };
                    img.onerror = () => { try { URL.revokeObjectURL(url); } catch (_) {} };
                    img.src = url;
                },

                // Canvas backing-store dimensions (placement coords live here).
                _placeCanvasW() { const c = this.$refs.penCanvas; return (c && c.width)  || this.bgNaturalW || this._DEFAULT_W; },
                _placeCanvasH() { const c = this.$refs.penCanvas; return (c && c.height) || this.bgNaturalH || this._DEFAULT_H; },

                // Screen-pixel → canvas-pixel scale (X/Y), accounting for how the
                // page is fit AND the current zoom (penCanvas rect includes the
                // CSS transform), so a finger drag moves the image 1:1 on screen.
                _placeScale() {
                    const c = this.$refs.penCanvas;
                    if (!c) return { sx: 1, sy: 1 };
                    const rect = c.getBoundingClientRect();
                    return {
                        sx: rect.width  ? c.width  / rect.width  : 1,
                        sy: rect.height ? c.height / rect.height : 1,
                    };
                },

                // Clamp the pending image's w/h/x/y so it stays inside the canvas
                // (keeping aspect ratio when resizing).
                _clampPlacement(p) {
                    const cw = this._placeCanvasW(), ch = this._placeCanvasH();
                    const minW = cw * 0.05;
                    if (p.w < minW)  { const k = minW / p.w; p.w *= k; p.h *= k; }
                    if (p.w > cw)    { const k = cw  / p.w; p.w *= k; p.h *= k; }
                    if (p.h > ch)    { const k = ch  / p.h; p.w *= k; p.h *= k; }
                    p.x = Math.max(0, Math.min(p.x, cw - p.w));
                    p.y = Math.max(0, Math.min(p.y, ch - p.h));
                },

                // Scale around the image center (used by the +/- buttons for
                // devices without pinch). factor > 1 grows, < 1 shrinks.
                _scalePlacement(factor) {
                    const p = this._placing;
                    if (!p || p.resizable === false) return;   // stamps are fixed-size
                    const cx = p.x + p.w / 2, cy = p.y + p.h / 2;
                    p.w *= factor; p.h *= factor;
                    p.x = cx - p.w / 2; p.y = cy - p.h / 2;
                    this._clampPlacement(p);
                },

                // Rotate the pending placement by `deg` degrees around its centre
                // (the ± rotate buttons). 90° steps keep snap90 items on their
                // grid; free-rotate images can still pinch-twist to any angle.
                _rotatePlacement(deg) {
                    const p = this._placing;
                    if (!p || p.rotatable === false) return;   // selection pastes don't rotate
                    p.rot = (p.rot || 0) + deg * Math.PI / 180;
                },

                onPlaceDown(e) {
                    if (!this._placing) return;
                    if (e.pointerType === 'touch') {
                        this._placeTouches.set(e.pointerId, { x: e.clientX, y: e.clientY });
                    }
                    const p = this._placing;
                    if (this._placeTouches.size === 2) {
                        const pts = [...this._placeTouches.values()];
                        this._placeStart = {
                            mode: 'pinch',
                            dist: Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y) || 1,
                            ang0: Math.atan2(pts[1].y - pts[0].y, pts[1].x - pts[0].x),
                            rot0: p.rot || 0,
                            w0: p.w, h0: p.h,
                            cx0: p.x + p.w / 2, cy0: p.y + p.h / 2,
                        };
                    } else {
                        this._placeStart = {
                            mode: 'move',
                            startX: e.clientX, startY: e.clientY,
                            x0: p.x, y0: p.y,
                        };
                    }
                    try { e.currentTarget.setPointerCapture(e.pointerId); } catch (_) {}
                },

                onPlaceMove(e) {
                    if (!this._placing || !this._placeStart) return;
                    const p = this._placing;
                    if (e.pointerType === 'touch' && this._placeTouches.has(e.pointerId)) {
                        this._placeTouches.set(e.pointerId, { x: e.clientX, y: e.clientY });
                    }
                    if (this._placeStart.mode === 'pinch' && this._placeTouches.size >= 2) {
                        const pts = [...this._placeTouches.values()];
                        // Scale on pinch — skipped for fixed-size items (stamps),
                        // which can still be dragged and rotated.
                        if (p.resizable !== false) {
                            const dist = Math.hypot(pts[1].x - pts[0].x, pts[1].y - pts[0].y) || 1;
                            const ratio = dist / this._placeStart.dist;
                            p.w = this._placeStart.w0 * ratio;
                            p.h = this._placeStart.h0 * ratio;
                            p.x = this._placeStart.cx0 - p.w / 2;
                            p.y = this._placeStart.cy0 - p.h / 2;
                        }
                        // Twist the two fingers to rotate (delta from the start
                        // angle, added to the rotation at pinch start). Camera/
                        // gallery images rotate to ANY angle; the addressograph
                        // family + thumb impression + stamps snap to 90° steps.
                        // Selection pastes are non-rotatable (drag-and-place only).
                        if (p.rotatable !== false) {
                            const ang = Math.atan2(pts[1].y - pts[0].y, pts[1].x - pts[0].x);
                            let rot = this._placeStart.rot0 + (ang - this._placeStart.ang0);
                            if (p.snap90) {
                                const q = Math.PI / 2;
                                rot = Math.round(rot / q) * q;
                            }
                            p.rot = rot;
                        }
                        this._clampPlacement(p);
                    } else if (this._placeStart.mode === 'move') {
                        const { sx, sy } = this._placeScale();
                        p.x = this._placeStart.x0 + (e.clientX - this._placeStart.startX) * sx;
                        p.y = this._placeStart.y0 + (e.clientY - this._placeStart.startY) * sy;
                        this._clampPlacement(p);
                    }
                },

                onPlaceUp(e) {
                    if (e.pointerType === 'touch') this._placeTouches.delete(e.pointerId);
                    try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
                    if (this._placeTouches.size === 1) {
                        // Pinch lifted to one finger → resume moving with it.
                        const pt = [...this._placeTouches.values()][0];
                        const p = this._placing;
                        this._placeStart = { mode: 'move', startX: pt.x, startY: pt.y, x0: p.x, y0: p.y };
                    } else if (this._placeTouches.size === 0) {
                        this._placeStart = null;
                    }
                },

                // Bake the pending image onto the canvas at its placed rect.
                // Draws from a fresh (non-proxied) Image so drawImage accepts it.
                _commitPlacement() {
                    const p = this._placing;
                    if (!p || !this._ctx) { this._cancelPlacement(); return; }
                    const rect = { x: p.x, y: p.y, w: p.w, h: p.h }, rot = p.rot || 0, url = p.url;
                    const img = new Image();
                    img.onload = () => {
                        this._pushUndo();
                        this._ctx.save();
                        this._ctx.setTransform(1, 0, 0, 1, 0, 0);
                        this._ctx.globalCompositeOperation = 'source-over';
                        if (rot) {
                            // Rotate around the image center, matching the overlay
                            // (transform-origin: center), then draw centered.
                            this._ctx.translate(rect.x + rect.w / 2, rect.y + rect.h / 2);
                            this._ctx.rotate(rot);
                            this._ctx.drawImage(img, -rect.w / 2, -rect.h / 2, rect.w, rect.h);
                        } else {
                            this._ctx.drawImage(img, rect.x, rect.y, rect.w, rect.h);
                        }
                        this._ctx.restore();
                        try { URL.revokeObjectURL(url); } catch (_) {}
                    };
                    img.onerror = () => { try { URL.revokeObjectURL(url); } catch (_) {} };
                    img.src = url;
                    this._placing = null;
                    this._placeTouches.clear();
                    this._placeStart = null;
                },

                _cancelPlacement() {
                    const p = this._placing;
                    if (p) { try { URL.revokeObjectURL(p.url); } catch (_) {} }
                    this._placing = null;
                    this._placeTouches.clear();
                    this._placeStart = null;
                },

                // Clear every placed/drawn item on the current edit canvas.
                // Placements (addressograph / stamps / etc.) are baked into the
                // canvas, so there's no separate list — resetting the ink layer
                // removes them all. Cancels any in-progress placement first.
                // No-op (and no toast) when the edit canvas isn't mounted.
                clearAllPlacements() {
                    if (this._placing) this._cancelPlacement();
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return;
                    this._clearCanvas();
                    this.showToast('All placed items cleared');
                },

                // ── stamp painters ──
                // Each paints at the center of the canvas at native canvas
                // resolution so saved strokes line up with the printed form.
                // The user can drag-edit later (planned: post-place handle).
                // Render `paint(ctx, w, h)` onto an OFFSCREEN canvas of size
                // w×h, then enter interactive placement (drag + pinch) instead
                // of baking it straight onto the page — same flow as a picked
                // image. The user positions/resizes it, then taps Place.
                // `target` selects which editor receives the rendered block:
                // undefined/'ipd' → the patient page canvas, 'rb' → the Register
                // Book page canvas. Everything above this (the painters) is shared,
                // so the addressograph looks identical in both.
                _placeRendered(w, h, paint, opts, target) {
                    if (target === 'rb') { if (!this._rbCtx) return; }
                    else if (!this._ctx) this.initCanvas();
                    const off = document.createElement('canvas');
                    off.width  = Math.max(1, Math.round(w));
                    off.height = Math.max(1, Math.round(h));
                    const ctx = off.getContext('2d');
                    paint(ctx, off.width, off.height);
                    let url;
                    try { url = off.toDataURL('image/png'); } catch (_) { return; }
                    if (target === 'rb') this._rbBeginPlacement(url, off.width, off.height, opts);
                    else this._beginPlacement(url, off.width, off.height, opts);
                },

                // Initial rotation (radians) for a freshly placed item, derived
                // from the edit category's page orientation/rotation so images,
                // addressographs and stamps drop in aligned to a landscape/rotated
                // page. orientation=1 ⇒ landscape: rotation 1 ⇒ 270°, 2 ⇒ 90°.
                // orientation≠1 (portrait) ⇒ no initial rotation.
                _placementInitialRot() {
                    if (this._editCatOrientation !== 1) return 0;
                    if (this._editCatRotation === 1) return 270 * Math.PI / 180;
                    if (this._editCatRotation === 2) return 90 * Math.PI / 180;
                    return 0;
                },

                // Centre a rendered image on the canvas and enter placement,
                // scaling down to fit when the content is bigger than the page.
                _beginPlacement(url, w, h, opts) {
                    const cw = this._placeCanvasW(), ch = this._placeCanvasH();
                    // Fit factor. A camera/gallery image is of arbitrary size, so
                    // it is scaled down to 90% of the page to land fully visible.
                    // A SELECTION CLIP is different: it was cropped from a page in
                    // this very canvas-pixel space and must paste back at the size
                    // it was copied — the blanket 0.9 made every pasted region
                    // visibly smaller than the area selected. Such callers pass
                    // fit:1, which still clamps (via Math.min(1, …)) so a clip
                    // taken from a larger template cannot overflow a smaller page.
                    const fit = (opts && typeof opts.fit === 'number') ? opts.fit : 0.9;
                    const r = Math.min(1, (cw * fit) / w, (ch * fit) / h);
                    w *= r; h *= r;
                    const x = (cw - w) / 2, y = (ch - h) / 2;
                    this._placeTouches.clear();
                    this._placeStart = null;
                    // snap90:true — addressograph / QR / barcode / thumb impression
                    // / stamps rotate in 90° steps only (pinch-twist snaps).
                    // resizable defaults true; stamps pass false (placed at a fixed
                    // size, drag + 90° rotate only). rotatable defaults true; a
                    // selection paste passes false (drag-and-place only, no rotate).
                    const resizable = !opts || opts.resizable !== false;
                    const rotatable = !opts || opts.rotatable !== false;
                    // Selection pastes (non-rotatable) drop in upright; everything
                    // else inherits the page orientation/rotation as its start angle.
                    const rot = rotatable ? this._placementInitialRot() : 0;
                    this._placing = { url, x, y, w, h, rot, snap90: true, resizable, rotatable };
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Bordered white block filling an offscreen canvas (0,0,w,h).
                // Inset the stroke by half its width so the border isn't clipped.
                _blockOn(ctx, w, h, fill = '#ffffff', stroke = '#0f172a', strokeW = 1) {
                    ctx.save();
                    ctx.fillStyle = fill;
                    ctx.fillRect(0, 0, w, h);
                    ctx.strokeStyle = stroke;
                    ctx.lineWidth = strokeW;
                    ctx.strokeRect(strokeW / 2, strokeW / 2, w - strokeW, h - strokeW);
                    ctx.restore();
                },

                // `target` — see _placeRendered. Called with no argument by the IPD
                // editor, and with 'rb' by the Register Book editor.
                placeAddressograph(target, patient) {
                    // Details are table-driven: mst_hospital_admission_field rows
                    // with sticker_view = 1 (server returns them as sticker_fields,
                    // the same shape as the float-view header_fields). The core
                    // identity block (name + UHID / IPD / Age / Gender / Consult /
                    // Adm Date) is ALWAYS stamped — built from selectedPatient with
                    // the same helpers the header uses (genderLabel / fmtDateTime).
                    // The configured sticker fields follow, and the block height
                    // grows to fit everything.
                    // `patient` (2nd arg) renders the sticker for an EXPLICITLY chosen
                    // patient instead of the app's selected one — used by the Register
                    // Book, which has no patient context and picks one from a list.
                    // When set, its own fields win (the this.patient* getters describe
                    // the selected patient and would otherwise leak into the sticker).
                    const ov      = patient || null;
                    const sp      = ov || this.selectedPatient || {};
                    const fields  = sp.sticker_fields || [];
                    const consult = sp.doctor
                        ? (sp.doctor + (sp.consultant_unit ? ' (' + sp.consultant_unit + ')' : ''))
                        : '';
                    const uhidVal = ov ? (ov.uhid || '') : (this.patientUhid || sp.uhid || '');
                    const ipdVal  = ov ? (ov.ipd  || '') : (this.patientIp   || sp.ipd  || '');
                    // Name, with the relative (salutation + name) in braces when present.
                    let nameLine = (ov ? (ov.name || '') : (this.patientName || sp.name)) || 'Patient';
                    if (sp.relative_name) {
                        nameLine += ' (' + (sp.relative_salutation ? sp.relative_salutation + ' ' : '') + sp.relative_name + ')';
                    }

                    // Fonts (one place so measuring and painting stay in sync).
                    const nameFont = 'bold 28px system-ui, sans-serif';
                    const idFont   = '20px system-ui, sans-serif';
                    const fldFont  = '18px system-ui, sans-serif';

                    // Build the full line list: name, identity rows (Age + Gender
                    // share one row), then the dynamic sticker fields. The block is
                    // sized to fit these exactly — no fixed width / trailing space.
                    const lines = [{ text: nameLine, font: nameFont, h: 40, gap: 6 }];
                    lines.push({ text: 'UHID No: '  + (uhidVal || '—'), font: idFont, h: 30 });
                    lines.push({ text: 'IPD No: '   + (ipdVal  || '—'), font: idFont, h: 30 });
                    // Age (only when available, no "yrs" suffix) shares a row with Gender.
                    const ageGender = (sp.age ? 'Age: ' + sp.age + '    ' : '')
                                      + 'Gender: ' + (this.genderLabel(sp.gender) || '—');
                    lines.push({ text: ageGender, font: idFont, h: 30 });
                    lines.push({ text: 'Consult: '  + (consult || '—'), font: idFont, h: 30 });
                    lines.push({ text: 'Adm Date: ' + (sp.admitted_at ? this.fmtDateTime(sp.admitted_at) : '—'), font: idFont, h: 30 });
                    fields.forEach((f) => {
                        lines.push({ text: (f.label || '') + ': ' + (f.value || ''), font: fldFont, h: 30 });
                    });

                    // Measure with an offscreen context to size the block to content.
                    const sidePad = 16, topPad = 14, botPad = 14;
                    const meas = document.createElement('canvas').getContext('2d');
                    let maxW = 0, contentH = 0;
                    lines.forEach((ln) => {
                        meas.font = ln.font;
                        maxW = Math.max(maxW, meas.measureText(ln.text).width);
                        contentH += ln.h + (ln.gap || 0);
                    });
                    const w = Math.ceil(maxW) + sidePad * 2;
                    const h = topPad + Math.ceil(contentH) + botPad;

                    this._placeRendered(w, h, (ctx, W, H) => {
                        this._blockOn(ctx, W, H);
                        ctx.fillStyle = '#0f172a';
                        ctx.textAlign = 'left';
                        ctx.textBaseline = 'top';
                        let y = topPad;
                        lines.forEach((ln) => {
                            ctx.font = ln.font;
                            ctx.fillText(ln.text, sidePad, y);
                            y += ln.h + (ln.gap || 0);
                        });
                    }, undefined, target);
                },

                // Build the addressograph detail set once so the QR (full text)
                // and barcode (primary identifier) encode the SAME data the
                // printed addressograph shows. Mirrors placeAddressograph's rows.
                _addressographDetails() {
                    const sp      = this.selectedPatient || {};
                    const uhid    = String(this.patientUhid || sp.uhid || '').trim();
                    const ipd     = String(this.patientIp   || sp.ipd  || '').trim();
                    const consult = sp.doctor
                        ? (sp.doctor + (sp.consultant_unit ? ' (' + sp.consultant_unit + ')' : ''))
                        : '';
                    let name = this.patientName || sp.name || 'Patient';
                    if (sp.relative_name) {
                        name += ' (' + (sp.relative_salutation ? sp.relative_salutation + ' ' : '') + sp.relative_name + ')';
                    }
                    const rows = ['Name: ' + name];
                    if (uhid) rows.push('UHID No: ' + uhid);
                    if (ipd)  rows.push('IPD No: ' + ipd);
                    if (sp.age) rows.push('Age: ' + sp.age);
                    const g = this.genderLabel(sp.gender); if (g) rows.push('Gender: ' + g);
                    if (consult) rows.push('Consult: ' + consult);
                    if (sp.admitted_at) rows.push('Adm Date: ' + this.fmtDateTime(sp.admitted_at));
                    ((sp.sticker_fields) || []).forEach((f) => {
                        if (f && f.value != null && f.value !== '') rows.push((f.label || '') + ': ' + f.value);
                    });
                    return { uhid, ipd, name, text: rows.join('\n') };
                },

                // `target` — see _placeRendered ('rb' → Register Book canvas).
                placeQrAddressograph(target) {
                    // Real, scannable QR (qrcode-generator) encoding the FULL
                    // addressograph details, rendered crisply into a 150×150 image
                    // with the spec quiet zone. Square block — addressograph family
                    // (90° snap rotate, resizable).
                    if (typeof qrcode === 'undefined') {
                        this.showToast('QR generator unavailable offline', 'error');
                        return;
                    }
                    const payload = this._addressographDetails().text || (this.patientName || 'Patient');
                    let qr;
                    try {
                        // type 0 = auto-pick smallest version; 'M' error correction.
                        qr = qrcode(0, 'M');
                        qr.addData(payload);
                        qr.make();
                    } catch (e) {
                        // Payload too large for level M's max version — retry at 'L'.
                        try { qr = qrcode(0, 'L'); qr.addData(payload); qr.make(); }
                        catch (_) { this.showToast('QR data too large', 'error'); return; }
                    }
                    const count = qr.getModuleCount();
                    const SIZE  = 150;       // final image (px) — exact square
                    const QUIET = 4;         // quiet-zone modules (QR spec minimum)
                    const total = count + QUIET * 2;
                    // Float cell so the code + quiet zone fill the WHOLE square
                    // edge-to-edge. Each module is tiled from its rounded start to
                    // the next module's rounded start, so there are no seams/gaps
                    // and the result stays a clean, fully-filled square.
                    const cell = SIZE / total;
                    const at   = (i) => Math.round(i * cell);
                    this._placeRendered(SIZE, SIZE, (ctx, W, H) => {
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, W, H);
                        ctx.fillStyle = '#000000';
                        for (let r = 0; r < count; r++) {
                            const y0 = at(QUIET + r), y1 = at(QUIET + r + 1);
                            for (let c = 0; c < count; c++) {
                                if (qr.isDark(r, c)) {
                                    const x0 = at(QUIET + c), x1 = at(QUIET + c + 1);
                                    ctx.fillRect(x0, y0, x1 - x0, y1 - y0);
                                }
                            }
                        }
                    }, undefined, target);
                },

                // `target` — see _placeRendered ('rb' → Register Book canvas).
                placeBarcodeAddressograph(target) {
                    // Real, SCANNABLE Code128 barcode (JsBarcode) of the patient
                    // IDENTIFIER only — UHID, else IPD, else name. (A 1D barcode
                    // can't hold the full addressograph text and stay scannable at a
                    // fixed small size; the QR carries the full details.) The value
                    // is printed below the bars, and the whole symbol is centred —
                    // unscaled where possible — inside a fixed 290×100 block.
                    if (typeof JsBarcode === 'undefined') {
                        this.showToast('Barcode generator unavailable offline', 'error');
                        return;
                    }
                    const d = this._addressographDetails();
                    const value = (d.uhid || d.ipd || d.name || '').toString().trim() || 'NA';

                    const TARGET_W = 290, TARGET_H = 100;
                    const off = document.createElement('canvas');
                    try {
                        JsBarcode(off, value, {
                            format:       'CODE128',
                            width:        2,      // real module width → scannable
                            height:       64,
                            displayValue: true,
                            fontSize:     18,
                            textMargin:   2,
                            margin:       8,
                            background:   '#ffffff',
                            lineColor:    '#000000',
                        });
                    } catch (e) {
                        this.showToast('Barcode generation failed', 'error');
                        return;
                    }

                    // Centre the symbol inside the fixed 290×100 block. Scale DOWN
                    // only if a long value overflows — never up, so bars stay crisp.
                    this._placeRendered(TARGET_W, TARGET_H, (ctx, W, H) => {
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, W, H);
                        const r  = Math.min(1, W / off.width, H / off.height);
                        const dw = off.width * r, dh = off.height * r;
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'high';
                        ctx.drawImage(off, 0, 0, off.width, off.height,
                                      (W - dw) / 2, (H - dh) / 2, dw, dh);
                    }, undefined, target);
                },

                // Capture a live thumb impression from the attached scanner's
                // local agent (Mantra MFS100 or Morpho/IDEMIA — whichever
                // responds) and drop it onto the page as a movable image (same
                // interactive placement as a gallery image / stamp). Guarded so
                // a missing agent surfaces a clear toast rather than a silent
                // no-op.
                // `target` — undefined/'ipd' drops the capture on the patient page,
                // 'rb' on the Register Book page. Capture, cues and error handling
                // are identical either way.
                async placeThumbImpression(target) {
                    if (this.thumbCapturing) return;          // re-entrancy guard
                    // A patient is required only for the IPD page (the print is filed
                    // against that patient's record). The Register Book has no patient
                    // context at all — its pages are hospital-scoped — so capture is
                    // available there any time.
                    if (target !== 'rb' && !this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }

                    // Device-connected pre-check: when the native scanner bridge is
                    // present, ask it whether a supported reader is physically
                    // plugged in (vendor != UNKNOWN). If none, bail with a clear
                    // message instead of running the whole capture and timing out.
                    const st = this._thumbDeviceStatus();
                    if (st && (!st.vendor || String(st.vendor).toUpperCase() === 'UNKNOWN')) {
                        this.showToast('No fingerprint device connected. Please connect the scanner and try again.', 'error');
                        return;
                    }

                    if (target === 'rb') { if (!this._rbCtx) return; }
                    else if (!this._ctx) this.initCanvas();
                    this.thumbCapturing = true;
                    // Sticky prompt — stays for the whole capture window (up to
                    // ~25s) so the user knows to press their thumb; replaced by
                    // the success/error toast below.
                    this.showToast(st && st.model ? ('Place your thumb on ' + st.model + '…') : 'Place your thumb on the scanner…', 'success', true);
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    // Reader is active and about to scan — prompt the user once.
                    this._playCue('place_finger');
                    try {
                        const cap = await this._captureThumbImpression();
                        if (!cap || !cap.blob) {
                            this._playCue('timeout');
                            this.showToast('No fingerprint captured — try again.', 'error');
                            return;
                        }
                        // Re-encode to PNG so BMP/odd formats render + composite
                        // cleanly on the page, then enter interactive placement
                        // via the same path camera / gallery images use. Each
                        // capture is a fresh blob — no previous image is reused.
                        const pngBlob = await this._thumbToPngBlob(cap.blob);
                        if (target === 'rb') this._rbInsertImageFile(pngBlob || cap.blob);
                        else this._insertImageFile(pngBlob || cap.blob);
                        this._playCue('success');
                        this.showToast('Thumb captured (' + cap.deviceName + ') — drag to position, then Place', 'success');
                    } catch (e) {
                        const raw = (e && e.message) ? e.message : 'Thumb scanner not reachable';
                        this._playCue('timeout');
                        this.showToast(this._friendlyThumbError(raw), 'error');
                        plog('warn', 'thumb', 'capture failed: ' + raw);
                    } finally {
                        this.thumbCapturing = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Play a capture audio cue once (place_finger / success / timeout).
                // Served by the PWA from ./sounds/<name>.mp3 (see routes/pwa.php).
                // Best-effort: autoplay/permission failures are ignored.
                _playCue(name) {
                    try {
                        const a = new Audio('./sounds/' + name + '.mp3');
                        a.play().catch(() => {});
                    } catch (_) {}
                },

                // Query the native scanner bridge for {vendor, model, ready}. The
                // wrapper injects a status() method on one of the THUMB_BRIDGE
                // objects (e.g. window.PrescoScanner.status()). Returns the parsed
                // object, or null when no native bridge exposes status (e.g. a
                // plain browser or an HTTP-agent-only setup) — in which case the
                // caller skips the pre-check and lets the capture path report.
                _thumbDeviceStatus() {
                    for (const p of THUMB_BRIDGE.objectPaths) {
                        try {
                            const obj = window[p];
                            if (obj && typeof obj.status === 'function') {
                                const raw = obj.status();
                                if (typeof raw === 'string' && raw) { try { return JSON.parse(raw); } catch (_) { return null; } }
                                if (raw && typeof raw === 'object') return raw;
                            }
                        } catch (_) {}
                    }
                    // Also accept a bare window.thumbStatus()/getScannerStatus().
                    for (const mn of ['thumbStatus', 'getScannerStatus', 'scannerStatus']) {
                        try {
                            if (typeof window[mn] === 'function') {
                                const raw = window[mn]();
                                if (typeof raw === 'string' && raw) { try { return JSON.parse(raw); } catch (_) {} }
                                else if (raw && typeof raw === 'object') return raw;
                            }
                        } catch (_) {}
                    }
                    return null;
                },

                // Map raw scanner/bridge error codes to a friendly toast message.
                _friendlyThumbError(raw) {
                    const s = String(raw || '').toLowerCase();
                    if (s.includes('no_scanner') || s.includes('not connected') || s.includes('no device') || s.includes('device not found'))
                        return 'No fingerprint device connected. Please connect the scanner and try again.';
                    if (s.includes('permission'))
                        return 'USB permission denied. Replug the scanner and tap Allow.';
                    if (s.includes('timeout') || s.includes('timed out'))
                        return 'Capture timed out — place your thumb and try again.';
                    if (s.includes('empty_image') || s.includes('no image') || s.includes('bad quality'))
                        return 'No clear fingerprint captured — press your thumb firmly and try again.';
                    if (s.includes('not_ready') || s.includes('not_initialized'))
                        return 'Scanner is not ready yet — please try again in a moment.';
                    if (s.includes('capture_failed') || s.includes('capture failed'))
                        return 'Fingerprint capture failed — please try again.';
                    if (s.includes('unsupported_vendor'))
                        return 'This fingerprint device is not supported.';
                    if (s.includes('503') || s.includes('service unavailable'))
                        return 'Scanner service is running but reports it is unavailable (503) — make sure the reader is plugged in and detected by the agent.';
                    if (s.includes('cors') || s.includes('blocked from reading') || s.includes('wrapper-managed'))
                        return 'The scanner is reachable but the browser is blocking it (CORS/HTTPS). Use the in-app scanner (native bridge) — the localhost service can’t be read from this page.';
                    return raw;   // already user-facing (HTTP-path messages)
                },

                // POST to the scanner's local capture agent, trying every
                // device profile's endpoints (THUMB_CAPTURE.devices) until one
                // answers, then pull the base64 image out of the JSON / XML
                // response. Returns { blob, deviceName } or throws with a
                // user-facing message.
                async _captureThumbImpression() {
                    const cfg = THUMB_CAPTURE;
                    // Prefer the native-wrapper JS bridge when present (the
                    // wrapper owns the scanner; no localhost service to reach).
                    const viaBridge = await this._captureThumbViaBridge();
                    if (viaBridge) return viaBridge;

                    let lastErr = null;
                    let reached = false;          // any agent answered at all
                    let reachedDevice = null;     // an agent answered but gave no image
                    for (const dev of cfg.devices) {
                        for (const endpoint of dev.endpoints) {
                            let resp;
                            try {
                                const ctrl = new AbortController();
                                const timer = setTimeout(() => ctrl.abort(), cfg.timeoutMs);
                                try {
                                    resp = await fetch(endpoint, {
                                        method: dev.method,
                                        headers: dev.headers,
                                        body: (dev.method === 'GET' || dev.method === 'HEAD') ? undefined : dev.body,
                                        signal: ctrl.signal,
                                        // The agent is a separate localhost origin; no cookies.
                                        mode: 'cors',
                                        cache: 'no-store',
                                    });
                                } finally { clearTimeout(timer); }
                            } catch (e) {
                                // Refused / TLS / CORS / abort — try the next URL.
                                // The browser hides WHICH for security; the no-cors
                                // probe below disambiguates on total failure.
                                lastErr = e;
                                plog('warn', 'thumb', 'POST ' + endpoint + ' → ' + (e && e.name || 'error') + ': ' + (e && e.message || ''));
                                continue;
                            }
                            reached = true;
                            reachedDevice = dev.name;
                            const text = await resp.text().catch(() => '');
                            plog('info', 'thumb', 'POST ' + endpoint + ' → HTTP ' + resp.status + ' (' + text.length + ' bytes)');
                            // Some agents (MFS100) answer 200 but signal no-finger /
                            // timeout via an ErrorCode field — treat as an error.
                            const agentErr = this._extractThumbError(text);
                            if (!resp.ok || agentErr) {
                                lastErr = new Error((agentErr || ('Scanner error (' + resp.status + ')')) + ' — ' + dev.name);
                                // A 5xx WITHOUT an agent error means THIS service is
                                // up but unavailable (device not attached to it) —
                                // don't stop; try the other endpoints / devices.
                                if (!agentErr && resp.status >= 500) { plog('warn', 'thumb', 'HTTP ' + resp.status + ' from ' + dev.name + ' — trying next'); continue; }
                                // Otherwise it's a real capture error on the device
                                // reached (no finger, timeout) — report it.
                                throw lastErr;
                            }
                            const b64 = this._extractThumbImageBase64(text);
                            if (!b64) { lastErr = new Error('No image from ' + dev.name); continue; }
                            const blob = this._base64ToBlob(b64.data, b64.mime || cfg.defaultMime);
                            if (blob && blob.size) return { blob, deviceName: dev.name };
                            lastErr = new Error('Captured image was empty (' + dev.name + ')');
                        }
                    }
                    if (!reached) {
                        // Nothing answered over HTTP. Log whatever native bridge
                        // the wrapper injected (the real integration path here),
                        // then probe (mode:'no-cors') to tell apart "host
                        // unreachable / TLS-cert-untrusted" (probe throws) from
                        // "host IS up but CORS blocked the read" (probe resolves
                        // opaque) — the browser hides this from the real request.
                        const bridges = this._scanThumbBridges();
                        const up = await this._probeThumbEndpoints();
                        if (bridges.length) {
                            throw new Error('Scanner is wrapper-managed. No HTTP service, but these interfaces were found: ' + bridges.join(', ') + '. Tell me which one captures and I will wire it.');
                        }
                        if (up.length) {
                            throw new Error('Scanner service is running but the browser was blocked from reading it (CORS). The agent must allow this origin. See debug log.');
                        }
                        throw new Error('No thumb scanner reachable — not via the app wrapper bridge nor a localhost service. See debug log.');
                    }
                    throw (lastErr || new Error('Thumb capture failed' + (reachedDevice ? ' on ' + reachedDevice : '')));
                },

                // Reachability probe: hit each endpoint with mode:'no-cors'. A
                // running host returns an opaque response (resolves); an
                // unreachable host or untrusted TLS cert throws. Read-only; used
                // only to diagnose a total capture failure. Returns the list of
                // endpoints that responded.
                async _probeThumbEndpoints() {
                    const up = [];
                    for (const dev of THUMB_CAPTURE.devices) {
                        for (const endpoint of dev.endpoints) {
                            try {
                                const ctrl = new AbortController();
                                const timer = setTimeout(() => ctrl.abort(), 4000);
                                try {
                                    await fetch(endpoint, { method: 'GET', mode: 'no-cors', cache: 'no-store', signal: ctrl.signal });
                                    up.push(endpoint);
                                    plog('info', 'thumb', 'probe ' + endpoint + ' → reachable (opaque)');
                                } finally { clearTimeout(timer); }
                            } catch (e) {
                                plog('warn', 'thumb', 'probe ' + endpoint + ' → unreachable: ' + (e && e.message || e));
                            }
                        }
                    }
                    return up;
                },

                // Try to capture via a native-wrapper JS bridge (THUMB_BRIDGE).
                // Returns { blob, deviceName } or null when no bridge captured.
                // The bridge method may return the image synchronously, as a
                // Promise, or via a single callback(arg). Each candidate is
                // tried in turn; failures are logged, not fatal.
                async _captureThumbViaBridge() {
                    const methods = this._findThumbBridgeMethods();
                    if (!methods.length) return null;
                    for (const m of methods) {
                        try {
                            plog('info', 'thumb', 'bridge try ' + m.path + '()');
                            // Arm the global result hook BEFORE invoking — an
                            // Android @JavascriptInterface can't accept a JS
                            // callback arg, so it returns asynchronously by
                            // calling window.onThumbImpressionResult(...).
                            const resultP = new Promise((resolve) => { this._thumbBridgeResolve = resolve; });
                            let immediate;
                            try { immediate = m.fn(); } catch (_) { immediate = undefined; }
                            if (immediate && typeof immediate.then === 'function') {
                                try { immediate = await immediate; } catch (_) { immediate = undefined; }
                            }
                            let payload;
                            if (immediate !== undefined && immediate !== null && immediate !== true && immediate !== '') {
                                payload = { ok: true, data: immediate };          // synchronous bridge
                            } else {
                                const timeoutP = new Promise((resolve) => setTimeout(() => resolve({ ok: false, error: 'timeout' }), THUMB_CAPTURE.timeoutMs));
                                payload = await Promise.race([resultP, timeoutP]); // async-callback bridge
                            }
                            this._thumbBridgeResolve = null;
                            if (!payload || !payload.ok) { plog('warn', 'thumb', 'bridge ' + m.path + ' → ' + ((payload && payload.error) || 'no result')); continue; }
                            const blob = this._thumbBridgeResultToBlob(payload.data);
                            if (blob && blob.size) {
                                plog('info', 'thumb', 'bridge ' + m.path + ' captured ' + blob.size + ' bytes');
                                return { blob, deviceName: 'App device (' + m.path + ')' };
                            }
                            plog('warn', 'thumb', 'bridge ' + m.path + ' returned no usable image');
                        } catch (e) {
                            this._thumbBridgeResolve = null;
                            plog('warn', 'thumb', 'bridge ' + m.path + ' failed: ' + (e && e.message || e));
                        }
                    }
                    return null;
                },

                // Collect callable capture methods on the configured bridge
                // objects and on window itself.
                _findThumbBridgeMethods() {
                    const out = [];
                    const tryObj = (path, obj) => {
                        if (!obj) return;
                        for (const mn of THUMB_BRIDGE.methodNames) {
                            try { if (typeof obj[mn] === 'function') out.push({ path: path + '.' + mn, fn: obj[mn].bind(obj) }); } catch (_) {}
                        }
                    };
                    for (const p of THUMB_BRIDGE.objectPaths) {
                        try { tryObj(p, window[p]); } catch (_) {}
                    }
                    // iOS WKWebView: trigger capture by posting to a registered
                    // message handler. postMessage returns undefined, so the
                    // capture flow then awaits window.onThumbImpressionResult.
                    try {
                        const mh = window.webkit && window.webkit.messageHandlers;
                        if (mh) {
                            for (const name of (THUMB_BRIDGE.messageHandlers || [])) {
                                try {
                                    if (mh[name] && typeof mh[name].postMessage === 'function') {
                                        out.push({
                                            path: 'webkit.messageHandlers.' + name + '.postMessage',
                                            fn: () => { mh[name].postMessage(THUMB_BRIDGE.postBody); return undefined; },
                                        });
                                    }
                                } catch (_) {}
                            }
                        }
                    } catch (_) {}
                    for (const mn of THUMB_BRIDGE.methodNames) {
                        try { if (typeof window[mn] === 'function') out.push({ path: mn, fn: window[mn].bind(window) }); } catch (_) {}
                    }
                    return out;
                },

                // Normalise a bridge return value into an image Blob. Accepts a
                // Blob / ArrayBuffer / data: URL / raw base64 / JSON string or
                // object carrying a base64 image field (reuses the HTTP parser).
                _thumbBridgeResultToBlob(out) {
                    if (!out) return null;
                    if (out instanceof Blob) return out;
                    if (out instanceof ArrayBuffer) return new Blob([out], { type: THUMB_CAPTURE.defaultMime });
                    let s = (typeof out === 'string') ? out : null;
                    if (s) {
                        const dm = s.match(/^data:(image\/[a-z0-9.+-]+);base64,(.+)$/i);
                        if (dm) return this._base64ToBlob(dm[2], dm[1]);
                        const b64 = this._extractThumbImageBase64(s);
                        if (b64) return this._base64ToBlob(b64.data, b64.mime || THUMB_CAPTURE.defaultMime);
                        const clean = s.replace(/\s+/g, '');
                        if (clean.length > 256 && /^[A-Za-z0-9+/=]+$/.test(clean)) return this._base64ToBlob(clean, THUMB_CAPTURE.defaultMime);
                        return null;
                    }
                    if (typeof out === 'object') {
                        try { const b64 = this._extractThumbImageBase64(JSON.stringify(out)); if (b64) return this._base64ToBlob(b64.data, b64.mime || THUMB_CAPTURE.defaultMime); } catch (_) {}
                    }
                    return null;
                },

                // Diagnostic: enumerate whatever the native wrapper injected into
                // the page (objects / functions whose name hints at a device
                // bridge), so the exact capture API can be identified. Logged and
                // returned. Read-only.
                _scanThumbBridges() {
                    const hits = [];
                    // Globals a fresh iframe also has = standard browser baseline;
                    // anything on the real window NOT in it was injected by the
                    // wrapper/app/libraries. This reveals a wrapper bridge object
                    // whatever its name (the name-regex approach missed it).
                    let baseline = null;
                    try {
                        const f = document.createElement('iframe');
                        f.style.display = 'none';
                        (document.body || document.documentElement).appendChild(f);
                        baseline = new Set(Object.getOwnPropertyNames(f.contentWindow));
                        f.remove();
                    } catch (_) { baseline = null; }
                    // Our own / well-known library globals — filtered out as noise
                    // so a real bridge stands out.
                    const KNOWN = new Set([
                        'Alpine', 'lucide', 'QRCode', 'JsBarcode', 'pdfjsLib', 'workbox',
                        'plog', 'plogExportText', 'plogCount', 'plogClear', 'idbOpen',
                        'idbGet', 'idbPut', 'idbDelete', 'idbKvGet', 'idbKvSet', 'webpackChunk',
                        'ImageCapture', 'webkitSpeechRecognition',
                    ]);
                    // A native function (toString has "[native code]") is a
                    // standard browser API constructor (USBDevice, ImageCapture,
                    // Bluetooth, …), NOT a wrapper bridge — skip those. An
                    // injected bridge is an OBJECT (Android) or, rarely, a
                    // non-native function.
                    const isNative = (fn) => { try { return /\[native code\]/.test(Function.prototype.toString.call(fn)); } catch (_) { return false; } };
                    const objectHits = [], fnHits = [];
                    try {
                        const names = Object.getOwnPropertyNames(window);
                        for (const k of names) {
                            if (baseline && baseline.has(k)) continue;     // standard global
                            if (KNOWN.has(k)) continue;                    // our own / lib
                            if (/^(webkit|moz|chrome|ms)[A-Z]/.test(k)) continue;
                            let v; try { v = window[k]; } catch (_) { continue; }
                            const t = typeof v;
                            if (t === 'function') {
                                if (isNative(v)) continue;                 // standard API constructor
                                fnHits.push(k + ':function');
                                continue;
                            }
                            if (t !== 'object' || !v) continue;
                            if (v === window || v === document || (window.Node && v instanceof window.Node)) continue;
                            // Android addJavascriptInterface methods are often
                            // non-enumerable, so for-in / getOwnPropertyNames may
                            // return nothing — the object NAME is still the prize.
                            let fns = [];
                            try { for (const n in v) { try { if (typeof v[n] === 'function') fns.push(n); } catch (_) {} } } catch (_) {}
                            try { Object.getOwnPropertyNames(v).forEach(n => { try { if (typeof v[n] === 'function' && fns.indexOf(n) < 0) fns.push(n); } catch (_) {} }); } catch (_) {}
                            objectHits.push(k + ':object{' + fns.slice(0, 24).join(',') + '}');
                        }
                    } catch (_) {}
                    // Objects first — they're the likely bridges.
                    hits.push(...objectHits, ...fnHits);
                    try {
                        if (window.webkit && window.webkit.messageHandlers) {
                            hits.push('webkit.messageHandlers:{' + Object.keys(window.webkit.messageHandlers).join(',') + '}');
                        }
                    } catch (_) {}
                    plog('warn', 'thumb', 'bridge scan (injected globals): ' + (hits.join(' | ') || 'none found'));
                    return hits;
                },

                // Find a base64 image payload in the agent's response, whether
                // it answered with JSON (scan imageKeys at any depth) or XML
                // (read imageXmlTags / any attribute). Returns { data, mime } or
                // null. A data: URL value carries its own mime; raw base64 uses
                // the configured default.
                _extractThumbImageBase64(text) {
                    if (!text) return null;
                    const cfg = THUMB_CAPTURE;
                    const fromValue = (v) => {
                        if (typeof v !== 'string') return null;
                        const s = v.trim();
                        if (!s) return null;
                        const dm = s.match(/^data:(image\/[a-z0-9.+-]+);base64,(.+)$/i);
                        if (dm) return { mime: dm[1], data: dm[2] };
                        // Heuristic: a long base64-ish blob is the image.
                        if (s.length > 256 && /^[A-Za-z0-9+/=\r\n]+$/.test(s)) return { mime: null, data: s.replace(/\s+/g, '') };
                        return null;
                    };
                    // Try JSON first.
                    try {
                        const obj = JSON.parse(text);
                        const seen = new Set();
                        const walk = (node) => {
                            if (!node || typeof node !== 'object' || seen.has(node)) return null;
                            seen.add(node);
                            for (const key of cfg.imageKeys) {
                                if (node[key] != null) { const r = fromValue(String(node[key])); if (r) return r; }
                            }
                            for (const k of Object.keys(node)) {
                                const child = node[k];
                                if (child && typeof child === 'object') { const r = walk(child); if (r) return r; }
                                else { const r = fromValue(child); if (r) return r; }
                            }
                            return null;
                        };
                        const r = walk(obj);
                        if (r) return r;
                    } catch (_) { /* not JSON — fall through to XML/string */ }
                    // XML / string: read configured tags, then any data: URL.
                    for (const tag of cfg.imageXmlTags) {
                        const re = new RegExp('<' + tag + '[^>]*>([\\s\\S]*?)<\\/' + tag + '>', 'i');
                        const m = text.match(re);
                        if (m) { const r = fromValue(m[1]); if (r) return r; }
                        // Same name as an attribute: <Resp Data="...."/>
                        const reAttr = new RegExp(tag + '\\s*=\\s*"([^"]+)"', 'i');
                        const ma = text.match(reAttr);
                        if (ma) { const r = fromValue(ma[1]); if (r) return r; }
                    }
                    const dm = text.match(/data:image\/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+/i);
                    if (dm) return fromValue(dm[0]);
                    return null;
                },

                // Decide whether an agent response signals a capture error, and
                // if so return its human-readable message. Returns null on
                // success. Handles MFS100 (ErrorCode "0" == success; non-zero
                // carries ErrorDescription) and Morpho-style errInfo, without
                // mistaking a "Success" status field for an error.
                _extractThumbError(text) {
                    if (!text) return null;
                    let o = null;
                    try { o = JSON.parse(text); } catch (_) { o = null; }
                    if (o && typeof o === 'object') {
                        // MFS100: ErrorCode "0" == success, anything else fails.
                        const code = (o.ErrorCode !== undefined) ? o.ErrorCode
                                   : (o.errCode !== undefined) ? o.errCode : undefined;
                        if (code !== undefined && code !== null) {
                            if (String(code).trim() === '0') return null;
                            return o.ErrorDescription || o.errInfo || o.ErrorInfo || ('Scanner error ' + code);
                        }
                        // Generic explicit error fields (ignore "Success").
                        const e = o.errInfo || o.ErrInfo || o.error || o.Error;
                        if (e && !/^\s*success\s*$/i.test(String(e))) return String(e);
                        return null;
                    }
                    // XML / string fallback.
                    const ec = text.match(/ErrorCode\s*=\s*"([^"]*)"/i) || text.match(/<ErrorCode[^>]*>([\s\S]*?)<\/ErrorCode>/i);
                    if (ec) {
                        if (String(ec[1]).trim() === '0') return null;
                        const ed = text.match(/ErrorDescription\s*=\s*"([^"]*)"/i) || text.match(/<ErrorDescription[^>]*>([\s\S]*?)<\/ErrorDescription>/i);
                        return ed ? ed[1] : ('Scanner error ' + ec[1]);
                    }
                    const m = text.match(/errInfo\s*=\s*"([^"]+)"/i) || text.match(/<errInfo[^>]*>([\s\S]*?)<\/errInfo>/i);
                    return (m && !/^\s*success\s*$/i.test(m[1])) ? m[1] : null;
                },

                // base64 (no data: prefix) → Blob of the given mime.
                _base64ToBlob(b64, mime) {
                    try {
                        const bin = atob(b64);
                        const len = bin.length;
                        const bytes = new Uint8Array(len);
                        for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
                        return new Blob([bytes], { type: mime || 'application/octet-stream' });
                    } catch (_) { return null; }
                },

                // Decode an image Blob (incl. BMP) and re-encode it as a PNG Blob
                // so it composites cleanly onto the page. Returns null on failure
                // (caller falls back to the original blob).
                _thumbToPngBlob(blob) {
                    return new Promise((resolve) => {
                        const url = URL.createObjectURL(blob);
                        const img = new Image();
                        img.onload = () => {
                            try {
                                const c = document.createElement('canvas');
                                c.width = img.naturalWidth || img.width;
                                c.height = img.naturalHeight || img.height;
                                const ctx = c.getContext('2d');
                                // White matte behind the print so a transparent /
                                // grey scan reads cleanly on the white form.
                                ctx.fillStyle = '#ffffff';
                                ctx.fillRect(0, 0, c.width, c.height);
                                ctx.drawImage(img, 0, 0);
                                try { URL.revokeObjectURL(url); } catch (_) {}
                                c.toBlob((b) => resolve(b || null), 'image/png');
                            } catch (_) { try { URL.revokeObjectURL(url); } catch (e) {} resolve(null); }
                        };
                        img.onerror = () => { try { URL.revokeObjectURL(url); } catch (_) {} resolve(null); };
                        img.src = url;
                    });
                },

                // Stamps filtered by the search box (matches stamp_name,
                // case-insensitive). Empty query returns all.
                filteredStamps() {
                    const q = (this.stampSearch || '').trim().toLowerCase();
                    if (!q) return this.stamps;
                    return this.stamps.filter(s =>
                        String(s.name || '').toLowerCase().includes(q));
                },

                // ── Per-hospital stamps (mst_stamp) + offline image cache ──

                // GET /api/stamps → the hospital's active stamps. Network-first,
                // with an IndexedDB (kv) fallback so the menu still lists stamps
                // offline. Each stamp's image is then warmed into IndexedDB
                // (cache-first) so it can be placed without the network and
                // without tainting the canvas.
                async loadStamps() {
                    this.stampsLoading = true;
                    const key = 'stamps:' + this._hid();
                    let list = null;
                    try {
                        const resp = await fetch('./api/stamps', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.ok) {
                            const data = await resp.json();
                            list = Array.isArray(data && data.stamps) ? data.stamps : [];
                            try { await idbKvSet(key, list); } catch (_) { /* quota/private */ }
                        }
                    } catch (_) {
                        // Offline / server down — fall through to the cache below.
                    }
                    if (!list) {
                        try { list = await idbKvGet(key); } catch (_) { list = null; }
                    }
                    // Drop the previous load's thumbnail object URLs before remint.
                    this._revokeStampImageUrls();
                    this.stamps = (Array.isArray(list) ? list : []).map(s => ({
                        id:       s.id,
                        name:     s.name || '',
                        url:      s.url || '',     // presigned (online only); not used for canvas
                        thumbUrl: '',              // filled by cacheStampImage from the cached blob
                    }));
                    this.stampsLoading = false;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    // Warm every stamp image into IndexedDB + mint thumbnails.
                    // Cache-first, so re-runs only fetch genuinely-missing ones.
                    this.stamps.forEach(s => this.cacheStampImage(s));
                },

                // Ensure one stamp's image bytes are cached in IndexedDB and set
                // s.thumbUrl to a fresh object URL of the blob. Cache-first;
                // hits the same-origin byte proxy only to fill a missing image
                // or refresh one whose name changed. Mirrors cacheCategoryImage.
                async cacheStampImage(s) {
                    if (!s || s.id == null) return false;

                    let cached = null;
                    try { cached = await idbGet(STORE_STAMP_IMG, s.id); } catch (_) { cached = null; }
                    const haveBlob    = !!(cached && cached.blob);
                    const nameChanged = !cached || cached.name !== s.name;

                    if (haveBlob) s.thumbUrl = this._stampObjectUrl(cached.blob);
                    if (haveBlob && !nameChanged) return true;

                    // ?v=<name> doubles as the SW cache key so a renamed stamp
                    // can't be served a stale response. Retry transient busy
                    // statuses (the proxy holds a PHP-FPM worker during its S3 GET).
                    const url = './api/stamps/' + encodeURIComponent(s.id)
                              + '/image?v=' + encodeURIComponent(s.name || '');
                    const TRANSIENT = [502, 503, 429];
                    for (let attempt = 0; attempt < 3; attempt++) {
                        try {
                            const resp = await fetch(url, {
                                credentials: 'same-origin',
                                headers: { 'Accept': 'image/*' },
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return haveBlob; }
                            if (TRANSIENT.includes(resp.status)) {
                                if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                                return haveBlob;
                            }
                            if (!resp.ok) return haveBlob;
                            const blob = await resp.blob();
                            if (!blob || blob.size === 0) return haveBlob;
                            try { await idbPut(STORE_STAMP_IMG, { id: s.id, name: s.name, blob, updatedAt: Date.now() }); } catch (_) {}
                            s.thumbUrl = this._stampObjectUrl(blob);
                            return true;
                        } catch (_) {
                            if (attempt < 2) { await this._sleep(300 * (attempt + 1)); continue; }
                            return haveBlob;
                        }
                    }
                    return haveBlob;
                },

                // Return the cached image Blob for a stamp, fetching + storing it
                // via the same-origin proxy if not yet cached. Used at placement
                // time so the canvas is always drawn from same-origin bytes
                // (never the cross-origin presigned URL, which would taint it).
                async _ensureStampBlob(s) {
                    try {
                        const rec = await idbGet(STORE_STAMP_IMG, s.id);
                        if (rec && rec.blob) return rec.blob;
                    } catch (_) { /* fall through to fetch */ }
                    const url = './api/stamps/' + encodeURIComponent(s.id) + '/image';
                    try {
                        const resp = await fetch(url, {
                            credentials: 'same-origin',
                            headers: { 'Accept': 'image/*' },
                        });
                        if (!resp.ok) return null;
                        const blob = await resp.blob();
                        if (!blob || blob.size === 0) return null;
                        try { await idbPut(STORE_STAMP_IMG, { id: s.id, name: s.name, blob, updatedAt: Date.now() }); } catch (_) {}
                        return blob;
                    } catch (_) {
                        return null;   // offline and not cached — nothing to place
                    }
                },

                // Mint + track a stamp thumbnail object URL (revoked on reload).
                _stampObjectUrl(blob) {
                    const u = URL.createObjectURL(blob);
                    this._stampImageObjectUrls.push(u);
                    return u;
                },
                _revokeStampImageUrls() {
                    (this._stampImageObjectUrls || []).forEach((u) => {
                        try { URL.revokeObjectURL(u); } catch (_) { /* ignore */ }
                    });
                    this._stampImageObjectUrls = [];
                },

                // Place a stamp image onto the canvas. Reads the cached blob
                // (offline-safe, same-origin → no taint), sizes the placement to
                // the image's intrinsic dimensions (capped to the canvas), and
                // enters the interactive overlay. Stamps are fixed-size: drag +
                // 90° rotate only (resizable:false; _beginPlacement sets snap90).
                async placeStamp(s) {
                    // Use-stamps grant (p_id 85). The Stamps section is already
                    // hidden without it; guard here too so no code path places a
                    // stamp. Privileged roles (1/2/10) are granted server-side.
                    if (!(this.me && this.me.can_use_stamps)) {
                        this.showToast('You have not authority to Use Stamps.', 'error');
                        return;
                    }
                    if (!this._ctx) this.initCanvas();
                    const blob = await this._ensureStampBlob(s);
                    if (!blob) {
                        this.showToast('Stamp image unavailable offline', 'error');
                        return;
                    }
                    // Fresh object URL per placement so _commitPlacement /
                    // _cancelPlacement can revoke it without killing the thumbnail.
                    const url = URL.createObjectURL(blob);
                    const img = new Image();
                    img.onload = () => {
                        const cw = this._placeCanvasW(), ch = this._placeCanvasH();
                        const r = Math.min((cw * 0.35) / img.width, (ch * 0.35) / img.height, 1);
                        this._beginPlacement(url, img.width * r, img.height * r, { resizable: false });
                    };
                    img.onerror = () => { try { URL.revokeObjectURL(url); } catch (_) {} };
                    img.src = url;
                },

                async saveEdit() {
                    if (this._checkReadOnly()) return;
                    if (this._checkEditPages()) return;
                    if (this._checkDischargeEditWindow()) return;
                    if (!this.viewerCategory) return;

                    // Live save when the PWA is talking to Laravel (categories
                    // loaded from the server + a real selected patient + a
                    // real cat.id from mst_category). Otherwise fall back to
                    // the in-memory demo behaviour so file:// / static-host
                    // runs still work for design review.
                    const isLive = this.categoriesLive
                                && this._editCatId
                                && this.selectedPatientId;

                    if (isLive) {
                        return this._saveEditLive();
                    }

                    // ── DEMO PATH (in-memory, stays in edit + toasts, same
                    // UX as the live path) ────────────────────────────────
                    let imageDataUrl = null;
                    try { imageDataUrl = this.$refs.penCanvas && this.$refs.penCanvas.toDataURL('image/png'); }
                    catch (_) { /* tainted canvas — ignore */ }

                    if (this._editingRecordId) {
                        const id = this._editingRecordId;
                        const idx = this.viewerRecords.findIndex(r => r.id === id);
                        if (idx >= 0) {
                            this.viewerRecords[idx] = {
                                ...this.viewerRecords[idx],
                                image: imageDataUrl,
                                date: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }),
                                author: 'You',
                            };
                            this._persistCurrentCategoryRecords();
                            this._clearCanvas();
                            this._editingRecordId = null;
                            this._takeInitialSnapshot();
                            this.showToast('Page saved');
                            this.$nextTick(() => window.lucide && window.lucide.createIcons());
                            return;
                        }
                        this._editingRecordId = null;
                    }

                    const next = {
                        id: `${this.viewerCategory.i}-new-${Date.now()}`,
                        pageNo: this.viewerRecords.length + 1,
                        date: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }),
                        author: 'You',
                        image: imageDataUrl,
                    };
                    this.viewerRecords = [...this.viewerRecords, next];
                    this._persistCurrentCategoryRecords();
                    const cat = this.categories.find(c => c.i === this.viewerCategory.i);
                    if (cat) cat.count = this.viewerRecords.length;
                    this.viewerCategory.count = this.viewerRecords.length;
                    // Each Save = one new page; canvas clears, _editingRecordId
                    // stays null so the NEXT Save also creates a new page.
                    this._clearCanvas();
                    this._editingRecordId = null;
                    this._takeInitialSnapshot();
                    this.showToast('Page saved');
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Save handler for the live (Laravel-backed) PWA. Branches:
                //
                //   - New page  → POST /pwa/api/patients/{p}/categories/{c}/pages
                //                  → server INSERTs pma_patient_notes1 row +
                //                    type='1' pma_notes_logs row.
                //
                //   - Edit page → POST same URL + `/{id}` with _method=PUT in
                //                  the FormData → server UPDATEs the existing
                //                  pma_patient_notes1 row + INSERTs a fresh
                //                  type='2' pma_notes_logs row.
                //
                // We POST + spoof `_method=PUT` (instead of a real PUT) because
                // PHP doesn't populate $_FILES on PUT multipart requests;
                // Laravel's MethodOverride middleware translates the form
                // field back to a PUT route match server-side.
                //
                // The canvas captures stylus strokes ONLY — the category
                // background template is composited at view time by the
                // viewer overlay, so the saved PNG stays small and the same
                // category template can re-render behind any page.
                async _saveEditLive() {
                    const isEditing = !!this._editingRecordId;
                    const editingId = this._editingRecordId;

                    const canvas = this.$refs.penCanvas;
                    if (!canvas) {
                        alert('Canvas not ready. Try again.');
                        return;
                    }

                    // Show the progress dialog IMMEDIATELY — BEFORE the canvas→PNG
                    // encoding. toBlob() on a full-resolution canvas takes a couple
                    // of seconds on a tablet; if we open the dialog after it, the
                    // dialog appears ~3s late. Open it now and yield a frame
                    // ($nextTick → rAF) so it actually paints before the encode
                    // monopolises the main thread.
                    this.savingOpen = true;
                    this.pagesLoading = true;
                    this.pagesError = '';
                    await this.$nextTick();
                    await new Promise((r) => requestAnimationFrame(r));

                    // canvas.toBlob is async (Promise-wrap it). Tainted
                    // canvases (cross-origin image baked in) reject; treat
                    // that as a soft failure rather than crashing the UI.
                    const blob = await new Promise((resolve) => {
                        try { canvas.toBlob(resolve, 'image/png'); }
                        catch (_) { resolve(null); }
                    });
                    if (!blob) {
                        this.savingOpen = false;
                        this.pagesLoading = false;
                        alert('Could not capture the page. Try again.');
                        return;
                    }

                    // Editing a page that is itself still only in the offline queue
                    // (id "offline-<qid>", no server row yet) — keep it in the queue
                    // regardless of connectivity; PUTting to a non-numeric page id
                    // would 404. It uploads as a fresh page when the queue flushes.
                    const editingOfflinePage = isEditing
                        && typeof editingId === 'string'
                        && editingId.indexOf('offline-') === 0;

                    // No connectivity (or the offline-only page above)? Don't attempt
                    // the network — park the page in the offline queue and sync it on
                    // reconnect. This is the "user can still write and save with no
                    // internet" path. (OUTSIDE the try/finally below, so it clears the
                    // saving-dialog flags itself, like the !blob guard above.)
                    if (editingOfflinePage || navigator.onLine === false || this.patientsOffline) {
                        try { await this._saveEditOffline(blob, isEditing, editingId); }
                        finally { this.savingOpen = false; this.pagesLoading = false; }
                        return;
                    }

                    // Multipart body — token + spoofed method for PUT.
                    const fd = new FormData();
                    fd.append('file', blob, 'page-' + Date.now() + '.png');
                    if (this.csrfToken) fd.append('_token', this.csrfToken);
                    if (isEditing) fd.append('_method', 'PUT');

                    try {
                        const base = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                   + '/categories/' + encodeURIComponent(this._editCatId)
                                   + '/pages';
                        const url = isEditing
                            ? base + '/' + encodeURIComponent(editingId)
                            : base;

                        // Upload with automatic retries — SAVE_UPLOAD_MAX_ATTEMPTS
                        // total. A failure is either a network-level reject (device
                        // dropped offline mid-save, captive portal, DNS → fetch
                        // throws) OR a server error response (5xx / unexpected
                        // non-2xx). Either way we pause briefly and try again; if the
                        // LAST attempt also fails the page is parked in the offline
                        // queue and synced later, so the work is never lost.
                        // Deliberate responses a retry can't fix — 401 (auth), 419
                        // (CSRF), 423 (locked category) — short-circuit the loop and
                        // are handled on their own terms.
                        const maxAttempts = SAVE_UPLOAD_MAX_ATTEMPTS;
                        let resp = null;      // set only on a 2xx success
                        let handled = false;  // a 401/419/423 already returned/prompted
                        let lastError = '';
                        // Toast + wait shown before the NEXT attempt; skipped after
                        // the final one (nothing more to retry).
                        const beforeRetry = async (attempt) => {
                            if (attempt >= maxAttempts) return;
                            this.showToast('Upload failed — retrying (attempt ' + (attempt + 1) + ' of ' + maxAttempts + ')…', 'error');
                            if (SAVE_UPLOAD_RETRY_DELAY_MS > 0) {
                                await new Promise((r) => setTimeout(r, SAVE_UPLOAD_RETRY_DELAY_MS));
                            }
                        };
                        for (let attempt = 1; attempt <= maxAttempts; attempt++) {
                            let r = null;
                            try {
                                r = await fetch(url, {
                                    method: 'POST', // browsers / PHP handle multipart cleanest on POST
                                    credentials: 'same-origin',
                                    body: fd,
                                    headers: Object.assign(
                                        { 'Accept': 'application/json' },
                                        this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                                    ),
                                });
                            } catch (netErr) {
                                // Network-level failure — retryable.
                                lastError = (netErr && netErr.message) || String(netErr);
                                plog('warn', 'save', 'Upload attempt ' + attempt + '/' + maxAttempts + ' failed (network): ' + lastError);
                                await beforeRetry(attempt);
                                continue; // retry, or fall through to offline on the last pass
                            }

                            // Deliberate, non-retryable responses.
                            if (r.status === 401) { window.location.assign('./login'); handled = true; break; }
                            if (r.status === 419) {
                                // CSRF token mismatch — refresh and prompt retry.
                                await this.loadMe();
                                alert('Session refreshed. Please tap Save again.');
                                handled = true; break;
                            }
                            if (r.status === 423) {
                                // Category locked for this patient
                                // (tbl_category_blocked_for_patient.status = 1).
                                const data = await r.json().catch(() => null);
                                this.showToast((data && data.error) || 'You cannot add page in Locked Category.', 'error');
                                handled = true; break;
                            }
                            if (r.ok) { resp = r; break; }   // success — leave the loop

                            // Server error response (5xx / other non-2xx) — retryable.
                            const errData = await r.json().catch(() => null);
                            lastError = (errData && errData.error) || ('HTTP ' + r.status);
                            plog('warn', 'save', 'Upload attempt ' + attempt + '/' + maxAttempts + ' failed (server): ' + lastError);
                            await beforeRetry(attempt);
                            // retry, or fall through to offline on the last pass
                        }

                        // A 401/419/423 was fully handled inside the loop — stop.
                        if (handled) return;

                        // Every attempt failed (network or server). Do NOT auto-save
                        // offline or navigate away — leave the page exactly as it is
                        // (editor open, strokes intact) and let the USER decide what
                        // to do next via the decision dialog: Retry / Save offline /
                        // Keep editing. The captured blob + edit context are stashed
                        // so those choices don't have to re-encode the canvas.
                        // (The finally below clears the saving dialog, revealing this.)
                        if (!resp) {
                            plog('warn', 'save', 'Upload failed after ' + maxAttempts + ' attempts — awaiting user decision: ' + lastError);
                            this._failedSave = { blob, isEditing, editingId, error: lastError };
                            this.uploadFailedOpen = true;
                            // Surface the EXACT server/bucket exception as a long
                            // toast so the user can read why it failed (also shown
                            // inside the decision dialog).
                            if (lastError) this.showToast('Upload failed: ' + lastError, 'error', false, 15000);
                            this.$nextTick(() => window.lucide && window.lucide.createIcons());
                            return;
                        }

                        const data = await resp.json();
                        const newPage = data && data.page;
                        const isAllView = !!(this.viewerCategory && this.viewerCategory.isAll);
                        const savedCat  = this.categories.find(c => c.id === this._editCatId);

                        let savedRec = null;
                        if (isEditing) {
                            // Splice the updated record back at the same index.
                            // In the All view, preserve the category tags + the
                            // continuous number so it keeps rendering correctly.
                            if (newPage) {
                                const idx = this.viewerRecords.findIndex(r => r.id === editingId);
                                if (idx >= 0) {
                                    const old = this.viewerRecords[idx];
                                    this.viewerRecords.splice(idx, 1, isAllView ? {
                                        ...newPage,
                                        catId:       old.catId,
                                        catLabel:    old.catLabel,
                                        catColorHex: old.catColorHex,
                                        catBgUrl:    old.catBgUrl,
                                        globalNo:    old.globalNo,
                                    } : newPage);
                                }
                                savedRec = newPage;
                            }
                        } else if (newPage) {
                            // New page added — bump the saved-into category count.
                            if (savedCat) savedCat.count = (parseInt(savedCat.count, 10) || 0) + 1;
                            if (isAllView) {
                                // Re-aggregate so the new page lands in its own
                                // category group with correct continuous numbering,
                                // then re-open it.
                                await this.loadAllCategoryPages();
                                savedRec = this.viewerRecords.find(r => r.id === newPage.id) || null;
                            } else {
                                this.viewerRecords = [...this.viewerRecords, newPage];
                                if (savedCat) savedCat.count = this.viewerRecords.length;
                                if (this.viewerCategory) this.viewerCategory.count = this.viewerRecords.length;
                                savedRec = newPage;
                            }
                        }

                        // After Save: tear down the canvas edit session and
                        // drop the user on the just-saved page in detail mode
                        // (where the Edit button is the next obvious action).
                        // _clearCanvas wipes the pixel buffer so re-entering
                        // edit mode later starts clean; _editingRecordId is
                        // reset so the *next* Save (after pressing Edit again)
                        // routes correctly (PUT vs POST is decided from this).
                        this._clearCanvas();
                        this._editingRecordId = null;
                        this._takeInitialSnapshot();
                        this.showToast('Page saved');
                        if (savedRec) {
                            // openDetail() flips viewerMode → 'detail', sets
                            // viewerActiveRecord, and snaps the slider to the
                            // saved page. Edit button on the detail appbar
                            // becomes the next step.
                            this.openDetail(savedRec);
                        } else {
                            // Server returned no page payload — fall back to
                            // the grid view (still safer than leaving the
                            // user staring at a now-blank canvas).
                            this.viewerMode = (this.viewerRecords.length > 0) ? 'grid' : 'empty';
                        }
                    } catch (e) {
                        this.pagesError = String(e && e.message || e);
                        this.showToast('Save failed: ' + this.pagesError, 'error');
                    } finally {
                        this.pagesLoading = false;
                        this.savingOpen = false;   // dismiss the progress dialog
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // ── Upload-failed decision handlers ─────────────────────────
                // The page is still on screen exactly as the user left it; these
                // act on the stashed blob so nothing is re-encoded or lost.
                // Retry → run the whole save (with its 2-attempt retry) again.
                retryFailedSave() {
                    this.uploadFailedOpen = false;
                    this._failedSave = null;
                    this._saveEditLive();
                },
                // Save offline → park the stashed page in the write_queue (the old
                // automatic behaviour, now user-chosen) and leave the editor.
                async saveFailedOffline() {
                    const fs = this._failedSave;
                    this.uploadFailedOpen = false;
                    this._failedSave = null;
                    if (!fs) return;
                    this.savingOpen = true; this.pagesLoading = true;
                    try {
                        await this._saveEditOffline(fs.blob, fs.isEditing, fs.editingId,
                            'Page saved in Offline. It will upload automatically when the connection is back.');
                    } finally {
                        this.savingOpen = false; this.pagesLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },
                // Keep editing → just dismiss; strokes stay on the canvas so the
                // user can adjust and Save again (or copy the work out).
                dismissFailedSave() {
                    this.uploadFailedOpen = false;
                    this._failedSave = null;
                },

                // ── Offline save queue ──────────────────────────────────────
                // Park a page that couldn't be uploaded (no internet / upload
                // failed) into the write_queue IndexedDB store and show it as
                // saved. `_flushWriteQueue()` re-sends it once the backend is
                // reachable. Called from _saveEditLive's offline / network-error
                // branches; performs the SAME canvas teardown as a live success.
                // `toastMsg` overrides the default "saved offline" toast (the
                // upload-retry path passes a "failed after 2 attempts" message).
                async _saveEditOffline(blob, isEditing, editingId, toastMsg) {
                    const patientId = this.selectedPatientId;
                    const catId     = this._editCatId;

                    // Editing a page that is ITSELF still queued offline
                    // (id "offline-<qid>") → overwrite that queue entry's image in
                    // place rather than stacking a duplicate upload.
                    let editingOfflineQid = null;
                    if (isEditing && typeof editingId === 'string' && editingId.indexOf('offline-') === 0) {
                        const n = parseInt(editingId.slice('offline-'.length), 10);
                        if (!isNaN(n)) editingOfflineQid = n;
                    }

                    let qid = null;
                    try {
                        if (editingOfflineQid != null) {
                            const existing = await idbGet(STORE_WRITE_Q, editingOfflineQid).catch(() => null);
                            if (existing) {
                                existing.blob = blob;
                                existing.updatedAt = Date.now();
                                await idbPut(STORE_WRITE_Q, existing);
                                qid = editingOfflineQid;
                            }
                        }
                        if (qid == null) {
                            const op = isEditing ? 'update' : 'create';
                            qid = await idbAdd(STORE_WRITE_Q, {
                                op,
                                patientId,
                                catId,
                                // Server row id to overwrite (edit of an already-
                                // uploaded page); null for a brand-new page.
                                serverPageId: (op === 'update') ? editingId : null,
                                blob,
                                createdAt: Date.now(),
                                updatedAt: Date.now(),
                            });
                            // Fresh sync batch — reset the "done" counter so the
                            // chip reads 0/N again for this run of offline saves.
                            if (this.offlinePending === 0) {
                                if (this._offlineResetTimer) { clearTimeout(this._offlineResetTimer); this._offlineResetTimer = null; }
                                this.offlineUploaded = 0;
                            }
                            this.offlinePending += 1;
                        }
                    } catch (e) {
                        // IndexedDB unavailable / quota — can't persist offline.
                        // Leave the strokes on the canvas so the user can retry.
                        plog('error', 'save', 'Offline queue write failed: ' + (e && e.message || e));
                        this.showToast('Could not save offline (storage unavailable)', 'error');
                        return;
                    }
                    if (qid == null) {
                        this.showToast('Could not save offline (storage unavailable)', 'error');
                        return;
                    }

                    // Optimistic on-screen record so the page shows as saved.
                    let url = '';
                    try { url = URL.createObjectURL(blob); this._offlineUrls.push(url); } catch (_) {}
                    const nowLabel = new Date().toLocaleString('en-IN',
                        { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    const recId = 'offline-' + qid;

                    if (editingOfflineQid != null) {
                        const idx = this.viewerRecords.findIndex(r => r && r.id === recId);
                        if (idx >= 0) this.viewerRecords.splice(idx, 1,
                            { ...this.viewerRecords[idx], image: url, date: nowLabel, updatedAt: Date.now(), _offline: true });
                    } else if (isEditing) {
                        // Offline edit of a real server page — swap it in place but
                        // remember the server id so the eventual upload PUTs it.
                        const idx = this.viewerRecords.findIndex(r => r && String(r.id) === String(editingId));
                        const baseRec = idx >= 0 ? this.viewerRecords[idx] : {};
                        const rec = { ...baseRec, id: recId, image: url, date: nowLabel, updatedAt: Date.now(), _offline: true, _serverPageId: editingId };
                        if (idx >= 0) this.viewerRecords.splice(idx, 1, rec);
                        else this.viewerRecords = [...this.viewerRecords, rec];
                    } else {
                        const rec = {
                            id: recId,
                            pageNo: this.viewerRecords.length + 1,
                            date: nowLabel,
                            author: (this.me && this.me.user_name) || 'You',
                            image: url,
                            updatedAt: Date.now(),
                            _offline: true,
                        };
                        this.viewerRecords = [...this.viewerRecords, rec];
                        const savedCat = this.categories.find(c => c.id === catId);
                        if (savedCat) savedCat.count = (parseInt(savedCat.count, 10) || 0) + 1;
                        if (this.viewerCategory) this.viewerCategory.count = this.viewerRecords.length;
                    }
                    // Force reactivity for the splice() paths above.
                    this.viewerRecords = [...this.viewerRecords];

                    // Teardown identical to a successful live save.
                    this._clearCanvas();
                    this._editingRecordId = null;
                    this._takeInitialSnapshot();
                    this.showToast(toastMsg || 'Page successfully saved in Offline');
                    plog('info', 'save', 'Page queued offline (qid ' + qid + ', ' + (isEditing ? 'update' : 'create') + ')');

                    const savedRec = this.viewerRecords.find(r => r && r.id === recId) || null;
                    if (savedRec) this.openDetail(savedRec);
                    else this.viewerMode = (this.viewerRecords.length > 0) ? 'grid' : 'empty';
                },

                // Upload every queued page (oldest first) to the server, dropping
                // each from the queue on success and updating the "UP : done/total"
                // chip. Stops (leaves the rest for the next attempt) the moment
                // connectivity drops or a page is rejected, so it never hammers a
                // permanently-failing item. Idempotent + guarded — safe to call
                // from init, the `online` event, the recovery probe, and the 10s
                // poll.
                async _flushWriteQueue() {
                    if (this._flushingQueue) return;
                    if (navigator.onLine === false) return;
                    // Claim the flush lock SYNCHRONOUSLY — BEFORE the first await — so
                    // two near-simultaneous triggers (the 5s drain interval, the
                    // connectivity-recovery path, a post-419 retry) can't both slip
                    // past the `if (this._flushingQueue) return` guard during the
                    // idbGetAll await and upload every queued page TWICE.
                    this._flushingQueue = true;
                    let refreshedToken = false;
                    try {
                        let items = [];
                        try { items = await idbGetAll(STORE_WRITE_Q); } catch (_) { return; }
                        items = (items || []).filter(Boolean).sort((a, b) => (a.id || 0) - (b.id || 0));
                        this.offlinePending = items.length;   // keep the chip honest
                        if (!items.length) return;

                        for (const item of items) {
                            if (navigator.onLine === false) break;

                            // A delete op with no server row to target is a no-op
                            // (an offline page created AND deleted before syncing —
                            // shouldn't reach here, but drop it defensively).
                            if (item.op === 'delete' && !item.serverPageId) {
                                await idbDelete(STORE_WRITE_Q, item.id).catch(() => {});
                                this.offlinePending = Math.max(0, this.offlinePending - 1);
                                continue;
                            }

                            const fd = new FormData();
                            if (this.csrfToken) fd.append('_token', this.csrfToken);
                            const base = './api/patients/' + encodeURIComponent(item.patientId)
                                       + '/categories/' + encodeURIComponent(item.catId) + '/pages';
                            let url;
                            if (item.op === 'delete') {
                                // Delete a server page that was removed offline.
                                fd.append('_method', 'DELETE');
                                url = base + '/' + encodeURIComponent(item.serverPageId);
                            } else {
                                fd.append('file', item.blob, 'page-' + (item.id || Date.now()) + '.png');
                                if (item.op === 'update') fd.append('_method', 'PUT');
                                url = (item.op === 'update' && item.serverPageId)
                                    ? base + '/' + encodeURIComponent(item.serverPageId)
                                    : base;
                            }

                            let resp;
                            try {
                                resp = await fetch(url, {
                                    method: 'POST',
                                    credentials: 'same-origin',
                                    body: fd,
                                    headers: Object.assign({ 'Accept': 'application/json' },
                                        this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}),
                                });
                            } catch (netErr) {
                                plog('warn', 'sync', 'Queue upload network error, will retry: ' + (netErr && netErr.message || netErr));
                                break;   // still offline — retry on the next tick
                            }

                            if (resp.status === 401) { window.location.assign('./login'); break; }
                            if (resp.status === 419) {
                                // Stale CSRF — refresh once, then retry shortly.
                                await this.loadMe().catch(() => {});
                                refreshedToken = true;
                                break;
                            }
                            if (!resp.ok) {
                                // Genuine server rejection (e.g. 423 locked category,
                                // 403). Keep it queued so it succeeds once the block
                                // clears; stop this cycle so we don't spin on it.
                                const data = await resp.json().catch(() => null);
                                plog('error', 'sync', 'Queue upload rejected (HTTP ' + resp.status + '): ' + ((data && data.error) || ''));
                                break;
                            }

                            const data = await resp.json().catch(() => null);
                            const newPage = data && data.page;
                            await idbDelete(STORE_WRITE_Q, item.id).catch(() => {});
                            this.offlinePending  = Math.max(0, this.offlinePending - 1);
                            this.offlineUploaded += 1;
                            this._reconcileUploadedRecord(item, newPage);
                        }

                        // Authoritative pending count from the store.
                        try { this.offlinePending = (await idbGetAll(STORE_WRITE_Q)).length; } catch (_) {}

                        if (this.offlinePending === 0 && this.offlineUploaded > 0) {
                            this.showToast(this.offlineUploaded + ' offline page(s) uploaded', 'success');
                            plog('info', 'sync', 'Offline queue drained (' + this.offlineUploaded + ' uploaded)');
                            // Let the chip linger on "N/N" for a moment, then clear it.
                            if (this._offlineResetTimer) clearTimeout(this._offlineResetTimer);
                            this._offlineResetTimer = setTimeout(() => { this.offlineUploaded = 0; this._offlineResetTimer = null; }, 4000);
                            // Server counts changed — refresh the current patient's badges.
                            if (this.selectedPatientId && this.patientsLive) {
                                this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                            }
                        } else if (refreshedToken && this.offlinePending > 0 && navigator.onLine !== false) {
                            // Retry once with the freshly-minted CSRF token.
                            setTimeout(() => this._flushWriteQueue(), 400);
                        }
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    } finally {
                        this._flushingQueue = false;
                    }
                },

                // After a queued page uploads, if that offline record is still on
                // screen, adopt the real server id so future edits target the live
                // row (keep the already-correct local image to avoid a re-fetch).
                _reconcileUploadedRecord(item, newPage) {
                    if (!newPage) return;
                    if (String(this.selectedPatientId) !== String(item.patientId)) return;
                    const recId = 'offline-' + item.id;
                    const idx = this.viewerRecords.findIndex(r => r && r.id === recId);
                    if (idx < 0) return;
                    const old = this.viewerRecords[idx];
                    this.viewerRecords.splice(idx, 1, { ...old, ...newPage, image: old.image, _offline: false });
                    this.viewerRecords = [...this.viewerRecords];
                    if (this.viewerActiveRecord && this.viewerActiveRecord.id === recId) {
                        this.viewerActiveRecord = this.viewerRecords[idx];
                    }
                },

                // When a category opens, fold in any pages that were saved offline
                // for this (patient, category) but haven't uploaded yet — so they
                // keep showing as saved across navigation, not just in the session
                // they were drawn. Called from loadCategoryPages after the server /
                // cached list is assigned.
                async _mergeOfflinePages(patientId, catId) {
                    let items = [];
                    try { items = await idbGetAll(STORE_WRITE_Q); } catch (_) { return; }
                    const mine = (items || []).filter(it =>
                        it && String(it.patientId) === String(patientId) && String(it.catId) === String(catId));
                    if (!mine.length) return;
                    mine.sort((a, b) => (a.id || 0) - (b.id || 0));
                    mine.forEach(it => {
                        // Pending offline delete of a server page — hide that page
                        // from the view (it's removed on sync); add no record.
                        if (it.op === 'delete') {
                            if (it.serverPageId) {
                                const di = this.viewerRecords.findIndex(r => r && String(r.id) === String(it.serverPageId));
                                if (di >= 0) this.viewerRecords.splice(di, 1);
                            }
                            return;
                        }
                        const recId = 'offline-' + it.id;
                        if (this.viewerRecords.some(r => r && r.id === recId)) return; // already present
                        let url = '';
                        try { url = URL.createObjectURL(it.blob); this._offlineUrls.push(url); } catch (_) {}
                        const dateLabel = new Date(it.updatedAt || it.createdAt || Date.now()).toLocaleString('en-IN',
                            { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                        if (it.op === 'update' && it.serverPageId) {
                            const idx = this.viewerRecords.findIndex(r => r && String(r.id) === String(it.serverPageId));
                            if (idx >= 0) {
                                this.viewerRecords.splice(idx, 1, {
                                    ...this.viewerRecords[idx], id: recId, image: url, date: dateLabel,
                                    updatedAt: it.updatedAt || Date.now(), _offline: true, _serverPageId: it.serverPageId });
                                return;
                            }
                        }
                        this.viewerRecords.push({
                            id: recId,
                            pageNo: this.viewerRecords.length + 1,
                            date: dateLabel,
                            author: (this.me && this.me.user_name) || 'You',
                            image: url,
                            updatedAt: it.updatedAt || Date.now(),
                            _offline: true,
                        });
                    });
                    this.viewerRecords = [...this.viewerRecords];
                },

                // Reflect any pages queued in a previous session in the chip, then
                // try to flush them if we're online (called once from init()).
                async _initOfflineQueue() {
                    try { this.offlinePending = (await idbGetAll(STORE_WRITE_Q)).length; }
                    catch (_) { this.offlinePending = 0; }
                    this.offlineUploaded = 0;
                    if (this.offlinePending > 0 && navigator.onLine !== false) {
                        // Give loadMe() a moment to establish the session + CSRF.
                        setTimeout(() => this._flushWriteQueue(), 2500);
                    }
                },

                // Mirror viewerRecords into the per-patient store so the
                // changes survive switching patient / category / viewer.
                _persistCurrentCategoryRecords() {
                    if (!this._patientRecords[this.selectedPatientId]) {
                        this._patientRecords[this.selectedPatientId] = {};
                    }
                    this._patientRecords[this.selectedPatientId][this.viewerCategory.i] = [...this.viewerRecords];
                },

                // Show a transient bottom-of-screen toast. kind = 'success'
                // (emerald) | 'error' (rose). Auto-hides after 2.5s; calling
                // again before that resets the timer so back-to-back saves
                // keep the latest message visible for the full duration.
                showToast(message, kind = 'success', sticky = false, durationMs = 2500) {
                    this.toast.message = message;
                    this.toast.kind = kind;
                    this.toast.show = true;
                    if (this._toastTimer) clearTimeout(this._toastTimer);
                    // sticky = stay until the next showToast replaces it (used for
                    // long operations like the fingerprint capture prompt).
                    // durationMs lets callers hold a toast longer than the 2.5s
                    // default — e.g. an exact bucket-upload exception the user
                    // needs time to read.
                    if (!sticky) {
                        this._toastTimer = setTimeout(() => {
                            this.toast.show = false;
                        }, durationMs);
                    }
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Jump the slider to a specific page in detail mode.
                _showDetailAt(idx) {
                    this.viewerActiveIndex  = idx;
                    this.viewerActiveRecord = this.viewerRecords[idx] || null;
                    this.viewerMode = 'detail';
                    this.$nextTick(() => {
                        const el = this.$refs.pageSlider;
                        if (el) {
                            const prev = el.style.scrollBehavior;
                            el.style.scrollBehavior = 'auto';
                            el.scrollLeft = idx * el.clientWidth;
                            requestAnimationFrame(() => { el.style.scrollBehavior = prev || 'smooth'; });
                        }
                        window.lucide && window.lucide.createIcons();
                    });
                },

                closeViewer() {
                    // Closing the viewer with unsaved strokes? Ask to save/discard.
                    if (this._guardEditExit(() => this.closeViewer())) return;
                    // Discard any uncommitted placement when leaving the viewer.
                    if (this._placing) this._cancelPlacement();
                    this.viewerOpen = false;
                    this.viewerMode = 'grid';
                    this.viewerActiveRecord = null;
                },

                openBin(kind) {
                    this.binKind = kind || 'recycle';
                    this.binOpen = true;
                    this.rightOpen = false;
                    if (this.binKind === 'recycle') this.loadRecycleBin();
                    else if (this.binKind === 'offline') this.loadOfflineBin();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // ── Recycle bin operations (server-backed) ──
                currentBinItems() {
                    if (this.binKind === 'offline') return this._offlineBinItems;
                    if (this.binKind !== 'recycle') return [];
                    return this._serverBinItems;
                },

                // ── Offline bin ─────────────────────────────────────────────
                // The pages this user saved OFFLINE for the selected patient —
                // read straight from the write_queue IndexedDB store, newest
                // first. These are local, not-yet-uploaded strokes; nothing here
                // is on the server, so it's view-only (no restore / page log).
                async loadOfflineBin() {
                    // Free any objectURLs minted for the previous open.
                    this._offlineBinUrls.forEach((u) => { try { URL.revokeObjectURL(u); } catch (_) {} });
                    this._offlineBinUrls = [];
                    this._offlineBinItems = [];
                    if (!this.selectedPatientId) return;
                    this.binLoading = true;
                    try {
                        let queued = [];
                        try { queued = await idbGetAll(STORE_WRITE_Q); } catch (_) { queued = []; }
                        const mine = (queued || []).filter((q) =>
                            q && String(q.patientId) === String(this.selectedPatientId));
                        // Newest first — updatedAt (last edit) falls back to createdAt.
                        mine.sort((a, b) => ((b.updatedAt || b.createdAt || 0) - (a.updatedAt || a.createdAt || 0)));
                        this._offlineBinItems = mine.map((q) => {
                            const cat = this.categories.find((c) => c.id === q.catId) || {};
                            let url = '';
                            try { url = URL.createObjectURL(q.blob); this._offlineBinUrls.push(url); } catch (_) {}
                            const ts = q.updatedAt || q.createdAt || 0;
                            const savedLabel = ts ? new Date(ts).toLocaleString('en-IN',
                                { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—';
                            return {
                                id: 'offline-' + q.id,
                                _offlineTs: ts,
                                catLabel: cat.label || ('Category #' + (q.catId != null ? q.catId : '—')),
                                catColorHex: cat.colorHex || '#f59e0b',
                                catBgUrl: cat.bgUrl || '',
                                savedAt: savedLabel,
                                offlineOp: q.op === 'update' ? 'Edited offline' : 'Saved offline',
                                originalRecord: {
                                    image: url,
                                    pageNo: '—',
                                    date: savedLabel,
                                    author: (this.me && this.me.user_name) || 'You',
                                },
                            };
                        });
                    } catch (e) {
                        plog('error', 'offline', 'loadOfflineBin failed: ' + (e && e.message || e));
                        this._offlineBinItems = [];
                        this.showToast('Could not load offline pages', 'error');
                    } finally {
                        this.binLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Pull the patient's deleted-page history from the server,
                // ordered by category list order. Shapes each row into the
                // overlay's expected item form (originalRecord.{image,pageNo,…}).
                async loadRecycleBin() {
                    if (!this.selectedPatientId) { this._serverBinItems = []; return; }
                    this.binLoading = true;
                    try {
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId) + '/recycle-bin',
                            { credentials: 'same-origin', headers: { 'Accept': 'application/json' } }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this._serverBinItems = (data.items || []).map((it) => ({
                            id: it.id, noteId: it.noteId, catId: it.catId,
                            catLabel: it.catLabel, catColorHex: it.catColorHex, catBgUrl: it.bgUrl || '',
                            deletedBy: it.deletedBy, deletedAt: it.deletedAt, deviceId: it.deviceId,
                            originalRecord: { image: it.image, pageNo: it.pageNo, date: it.date, author: it.author },
                        }));
                    } catch (e) {
                        plog('error', 'recycle', 'loadRecycleBin failed: ' + (e && e.message || e));
                        this._serverBinItems = [];
                        this.showToast('Could not load the recycle bin', 'error');
                    } finally {
                        this.binLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                _binMutHeaders() {
                    return Object.assign({ 'Accept': 'application/json' },
                        this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {});
                },

                // Un-delete on the server (recreates the page), then drop it
                // from the bin and refresh the patient's category counts.
                async restoreFromRecycleBin(item) {
                    try {
                        const fd = new FormData();
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId) + '/recycle-bin/' + encodeURIComponent(item.id) + '/restore',
                            { method: 'POST', credentials: 'same-origin', body: fd, headers: this._binMutHeaders() }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap Restore again', 'error'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        this._serverBinItems = this._serverBinItems.filter((x) => x.id !== item.id);
                        this.showToast('Page restored', 'success');
                        if (this.selectedPatientId && this.patientsLive) {
                            this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                        }
                    } catch (e) {
                        plog('error', 'recycle', 'restore failed: ' + (e && e.message || e));
                        this.showToast('Restore failed', 'error');
                    } finally {
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Permanently drop a deleted page's history row (POST + _method=DELETE,
                // matching the page-delete spoof the server's MethodOverride expects).
                async purgeFromRecycleBin(item) {
                    try {
                        const fd = new FormData();
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        fd.append('_method', 'DELETE');
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId) + '/recycle-bin/' + encodeURIComponent(item.id),
                            { method: 'POST', credentials: 'same-origin', body: fd, headers: this._binMutHeaders() }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap again', 'error'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        this._serverBinItems = this._serverBinItems.filter((x) => x.id !== item.id);
                        this.showToast('Removed from recycle bin', 'success');
                    } catch (e) {
                        plog('error', 'recycle', 'purge failed: ' + (e && e.message || e));
                        this.showToast('Remove failed', 'error');
                    } finally {
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Right-drawer circular refresh button. Re-pull the hospital's
                // category list AND the selected patient's per-category counts so
                // the drawer reflects the latest saved pages for THIS patient.
                async refresh() {
                    if (this.categoriesLoading) return;   // already refreshing
                    plog('info', 'categories', 'Manual category refresh' + (this.selectedPatientId ? (' for patient ' + this.selectedPatientId) : ''));
                    try {
                        // Refresh the category list (cache-first prefetch inside is
                        // cheap for already-cached forms).
                        await this.loadCategories();
                        // Refresh THIS patient's counts so the (N) badges update.
                        if (this.selectedPatientId) {
                            if (this.patientsLive) {
                                await this.loadPatientCategoryCounts(this.selectedPatientId);
                            } else {
                                this._recomputeCategoryCountsForCurrentPatient();
                            }
                        }
                        this.showToast(this.selectedPatientId ? 'Categories updated' : 'Categories refreshed');
                    } catch (e) {
                        plog('error', 'categories', 'Category refresh failed: ' + (e && e.message || e));
                        this.showToast('Could not refresh categories', 'error');
                    } finally {
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },
            };
        }
    </script>

    <!--
        Back button inside the IPD section: double-press to go to Home.
        1st Back press  -> toast, stay in IPD.
        2nd Back press within 2s -> go to the PWA home (/pwa, derived by
        stripping the trailing /ipd from the current path).
    -->
    <script>
        (function () {
            var lastBack = 0;
            var homeUrl = location.pathname.replace(/\/ipd\/?$/, '') || '/';
            var toast, toastTimer;

            function showToast(msg) {
                if (!toast) {
                    toast = document.createElement('div');
                    toast.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:99999;background:#1e293b;color:#fff;font:14px system-ui,-apple-system,sans-serif;padding:8px 16px;border-radius:9999px;box-shadow:0 4px 16px rgba(0,0,0,.25);opacity:0;transition:opacity .3s;pointer-events:none;';
                    document.body.appendChild(toast);
                }
                toast.textContent = msg;
                toast.style.opacity = '1';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(function () { toast.style.opacity = '0'; }, 2000);
            }

            // Seed a sentinel entry so the first Back press is caught here.
            history.pushState(null, '', location.href);

            window.addEventListener('popstate', function () {
                var now = Date.now();
                if (now - lastBack <= 2000) {
                    // Second press within the window -> go to Home.
                    window.location.replace(homeUrl);
                } else {
                    // First press -> warn and stay in IPD.
                    lastBack = now;
                    showToast('Double press to go to Home');
                    history.pushState(null, '', location.href);
                }
            });
        })();
    </script>


</body></html>