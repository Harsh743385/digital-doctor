                    for (let i = 0; i < ports.length; i++) {
                        try {
                            const ac = new AbortController();
                            const to = setTimeout(() => ac.abort(), 2000);
                            try {
                                const resp = await fetch('http://127.0.0.1:' + ports[i] + '/device', {
                                    cache: 'no-store', headers: { 'Accept': 'application/json' }, signal: ac.signal,
                                });
