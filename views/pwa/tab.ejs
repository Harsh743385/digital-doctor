                    this.startEdit({
                        paste: rec.imageProxy || rec.image || null,
                        editingRecordId: rec.id,
                        catId: rec.catId != null ? rec.catId : undefined,
                        catBgUrl: rec.catBgUrl,
                    });
                },

                // Resolve which category an edit/add session targets. Explicit
                // opts.catId wins; in the All view the active page's category is
                // used; otherwise the open viewerCategory.
                _resolveEditCategory(opts) {
                    opts = opts || {};
                    if (opts.catId != null) {
                        return { id: opts.catId, bgUrl: opts.catBgUrl || '' };
                    }
                    if (this.viewerCategory && this.viewerCategory.isAll && this.viewerActiveRecord) {
                        return {
                            id:    this.viewerActiveRecord.catId,
                            bgUrl: this.viewerActiveRecord.catBgUrl || '',
                        };
                    }
                    return {
                        id:    (this.viewerCategory && this.viewerCategory.id) || null,
                        bgUrl: (this.viewerCategory && this.viewerCategory.bgUrl) || '',
                    };
                },

                backToGrid() {
                    this.viewerActiveRecord = null;
                    this.viewerMode = (this.viewerRecords.length > 0) ? 'grid' : 'empty';
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // App-bar Home: close the page viewer (detail/edit), any embedded
                // web page, documents grid, or floating PDF, and drop the user on
                // the GRID view of the currently selected category. If no category
                // is selected, fall back to the fresh main screen.
                // Left-drawer HOME → leave the IPD shell for the modules home
                // screen (home.blade.php). The shell is served at …/pwa/ipd, so
                // dropping the trailing /ipd lands on …/pwa (the home route).
                openModulesHome() {
                    if (this._guardEditExit(() => this.openModulesHome())) return;
                    const home = window.location.pathname.replace(/\/ipd\/?$/, '') || '/';
                    window.location.assign(home);
                },


                goHome() {
                    // Leaving an unsaved edit? Ask to save/discard first.
                    if (this._guardEditExit(() => this.goHome())) return;
                    // In the documents detail view → go back to the documents
                    // GRID (the uploaded-files thumbnails), staying in the docs
                    // pane. If there are no files, fall through to the form pane.
                    if (this.docViewOpen && this.docViewMode === 'detail' && this.docExisting.length > 0) {
                        this.docViewMode = 'grid';
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                        return;
                    }
                    this.webOpen     = false;
                    this.docViewOpen = false;
                    this.pdfOpen     = false;
                    if (this.viewerCategory) {
                        this.viewerActiveRecord = null;
                        this.viewerActiveIndex  = 0;
                        this.viewerMode = (this.viewerRecords.length > 0) ? 'grid' : 'empty';
                        this.viewerOpen = true;
                    } else {
                        this.viewerOpen = false;   // nothing selected → fresh main
                    }
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // View-only (p_id 56) applies ONLY to discharged / cancelled
                // patients — i.e. History & Cancelled modes. Live patients stay
                // fully editable even when the user holds the read-only right.
                // Privileged roles (1/2/10) are bypassed server-side, so they
                // never see read_only true at all.
                viewOnlyActive() {
                    if (!(this.me && this.me.read_only)) return false;
                    // Active for History / Cancelled modes, and also when the
                    // patient currently open is itself discharged — guards a
                    // stale viewer left open after switching back to Live mode.
                    // "Discharged" = patient_status == 2 (is_discharged), NOT merely
                    // a discharge datetime being present: a still-admitted patient
                    // with a tentative/cancelled discharge datetime stays editable.
                    if (this.patientMode !== 'live') return true;
                    return !!(this.selectedPatient && this.selectedPatient.is_discharged);
                },

                // Global view-only gate. Every add / edit / upload entry point
                // calls this first: when view-only is active for the patient in
                // context it toasts and bails.
                _checkReadOnly() {
                    if (this.viewOnlyActive()) {
                        this.showToast('You have View only access for Discharged patients.', 'error');
                        return true;
                    }
                    return false;
                },

                // Hand Written page add/edit grant (p_id 62). Users without the
                // grant get a toast instead of the editor. Privileged roles
                // (1/2/10) are granted server-side.
                _checkEditPages() {
                    if (!(this.me && this.me.can_edit_pages)) {
                        this.showToast('You have not authority to Edit pages', 'error');
                        return true;
                    }
                    return false;
                },

                // Discharged / cancelled patients: editing Hand Written pages is
                // allowed only within the after-discharge validity window (default
                // 24h, overridable per hospital), UNLESS the user holds p_id 80
                // (edit anytime). Returns true = blocked (and toasts). Live
                // patients are never blocked here. When no discharge datetime can
                // be parsed we don't block, to avoid false denials.
                _checkDischargeEditWindow() {
                    const p = this.selectedPatient;
                    // Only a truly discharged patient (patient_status == 2 →
                    // is_discharged) is gated. A discharge DATETIME on a still-
                    // admitted patient (status != 2) does NOT trigger the window.
                    const discharged = this.patientMode !== 'live' || !!(p && p.is_discharged);
                    if (!discharged) return false;
                    if (this.me && this.me.can_edit_discharged_anytime) return false;
                    const raw = p && p.discharged_at;
                    const ms = raw ? Date.parse(String(raw).replace(' ', 'T')) : NaN;
                    if (isNaN(ms)) return false;
                    const hours = Number(this.me && this.me.discharge_edit_validity_hours) || 24;
