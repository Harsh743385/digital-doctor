                                        <template x-if="p.photoSrc || p.photo"></template><img :src="p.photoSrc || p.photo" :alt="p.name" @error="p.photoSrc ? (p.photoSrc = '') : (p.photo = '')" class="w-16 h-16 rounded-2xl object-cover border border-blue-200 bg-slate-100" src="blob:https://prescoipd.com/2379a92c-11d9-4528-ba37-2e21d24abf7f" alt="Solanki Kunj Dilipkumar">
                                        <template x-if="!(p.photoSrc || p.photo)"></template>
                                    </div>

                                    <!-- Details column -->
                                    <div class="min-w-0 flex-1">
                                        <!-- Name (with salutation) + age in braces —
                                             shown FIRST. Colour by gender: 1=Male
