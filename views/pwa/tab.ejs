                            // Still surface any pages queued offline for this
                            // category even when there's no server / cached list.
                            await this._mergeOfflinePages(patientId, catId);
                            // Offline with nothing cached: DON'T show the error
                            // panel (it would hide the form) — fall to the empty
                            // state so the blank category template still renders.
                            // Online failures keep the error + Retry affordance.
                            if (navigator.onLine === false) {
                                this.pagesError = '';
                            } else if (e && e.name === 'AbortError') {
                                this.pagesError = 'Server took too long. Tap Retry.';
                            } else {
                                this.pagesError = String(e && e.message || e);
                            }
                        }
                    } finally {
                        clearTimeout(timeoutId);
                        this.pagesLoading = false;
                    }
                },

                // Aggregate loader for the "All IPD Categories" view. Fetches
                // every category that actually has saved pages (count > 0), in
                // category-display order, and concatenates the pages so they
                // read category-by-category. Each page is tagged with its
                // category's label / colour / template so the viewer can render
                // it against the right form even though no single category is
                // "open". Fetches run in parallel but the merge keeps display
                // order. Read-only — reuses the per-category pages endpoint.
                async loadAllCategoryPages() {
                    const pid = this.selectedPatientId;
                    if (!pid) { this.viewerRecords = []; return; }
                    this.pagesLoading = true;
                    this.pagesError = '';
                    try {
                        // Only categories with pages, in their list order
                        // (this.categories is already category_position-ordered).
                        const cats = this.categories.filter(
                            (c) => !c.isAll && c.id && (parseInt(c.count, 10) || 0) > 0
                        );
                        const settled = await Promise.all(
                            cats.map(async (c) => ({ c, pages: await this._fetchCategoryPages(pid, c.id) }))
                        );
                        const merged = [];
                        settled.forEach(({ c, pages }) => {
                            pages.forEach((pg) => merged.push({
                                ...pg,
                                catId: c.id,
                                catLabel: c.label,
                                _allCat: true,
                                catColorHex: c.colorHex || null,
                                catBgUrl: c.bgUrl || '',
                            }));
                        });
                        // Continuous page numbering across ALL categories: the
                        // first category's pages are 1..N1, the next continue
                        // N1+1.., up to the grand total (so "30 pages in all"
                        // reads 1..30 in category order). `globalNo` overrides
                        // the per-category pageNo only in the All view.
                        merged.forEach((r, i) => { r.globalNo = i + 1; });
