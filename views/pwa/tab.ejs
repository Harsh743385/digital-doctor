                    try { await idbReplaceAll(STORE_PATIENT_IMG, []); } catch (_) {}
                    try { localStorage.setItem(FLAG, '1'); } catch (_) {}
                    plog('info', 'app', 'Left-drawer offline cache cleared (one-time)');
                },
                _categoriesCacheKey(hospitalId) {
                    return 'pwa.categories.' + (hospitalId != null ? hospitalId : 'default');
                },
                _persistCategories(hospitalId, list) {
                    try { localStorage.setItem(this._categoriesCacheKey(hospitalId), JSON.stringify(list || [])); }
                    catch (_) { /* ignore */ }
                },
                _loadCachedCategories(hospitalId) {
                    try { return JSON.parse(localStorage.getItem(this._categoriesCacheKey(hospitalId)) || 'null'); }
                    catch (_) { return null; }
                },

                // IndexedDB kv keys (hospital-scoped) for the larger snapshots.
                _hid() { return (this.me && this.me.hospital_id != null) ? this.me.hospital_id : 'default'; },
                _patientsCacheKey(mode) { return 'patients:' + this._hid() + ':' + (mode || 'live'); },
                // ── Scroll-depth persistence (patient drawer) ──────────────────
                // localStorage (NOT IndexedDB) so it survives the WebView being
                // destroyed on long background AND is readable synchronously. One
                // small integer — the number of pages the clean list was scrolled
                // to — keyed per hospital + mode.
                _patientsDepthKey(mode) { return 'presco_pwa_patients_pages:' + this._hid() + ':' + (mode || 'live'); },
                _persistPatientsDepth(mode, pages) {
                    try {
                        const n = Math.max(1, Math.min(Math.trunc(Number(pages)) || 1, this.patientsMaxRestorePages));
                        localStorage.setItem(this._patientsDepthKey(mode), String(n));
                    } catch (_) { /* storage disabled — restore just won't fire */ }
                },
                _readPatientsDepth(mode) {
                    try {
                        const n = parseInt(localStorage.getItem(this._patientsDepthKey(mode)) || '1', 10);
