                get fabMenu() {
                    return [
                        { tab: 'assessment', label: 'Assessments',   icon: 'clipboard-check' },
                        { tab: 'emar',       label: 'eMAR',          icon: 'pill'            },
                        { tab: 'etar',       label: 'eTAR',          icon: 'heart-pulse'     },
