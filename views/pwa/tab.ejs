        <!-- Document Scanner — live camera → manual 4-corner crop.
             Shared by the Other Documents sheet and by every editor's
             Add image ▸ Doc Scanner (scanContext decides where the page
             goes; _scanZClass stacks it above whoever opened it). -->
        <div x-show="scanOpen" class="fixed inset-0 bg-slate-200 flex flex-col z-[90]" :class="_scanZClass()" style="display:none">
            <!-- LIVE: full-screen camera + Auto/Manual capture -->
            <template x-if="scanPhase === 'live'"></template><div class="absolute inset-0">
                    <!-- Full-screen camera feed -->
                    <video x-ref="scanVideo" autoplay="" playsinline="" muted="" class="absolute inset-0 w-full h-full object-cover bg-slate-200"></video>

                    <!-- Top bar (overlaid) — dark scrim only for caption legibility over the live video -->
                    <div class="absolute top-0 inset-x-0 flex items-center justify-between px-4 py-3 text-white bg-gradient-to-b from-slate-900/70 to-transparent">
                        <button type="button" @click="closeScanner()" class="p-1" aria-label="Close scanner">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                        <span class="text-sm font-medium">Document Scanner</span>
                        <span class="w-6"></span>
                    </div>

                    <!-- Auto | Manual toggle -->
                    <div class="absolute top-14 inset-x-0 flex justify-center">
                        <div class="inline-flex rounded-full bg-slate-900/55 p-1">
                            <button type="button" @click="setScanMode('auto')" class="px-5 py-1.5 rounded-full text-sm font-semibold transition bg-white text-slate-900" :class="scanMode === 'auto' ? 'bg-white text-slate-900' : 'text-white'">Auto</button>
                            <button type="button" @click="setScanMode('manual')" class="px-5 py-1.5 rounded-full text-sm font-semibold transition text-white" :class="scanMode === 'manual' ? 'bg-white text-slate-900' : 'text-white'">Manual</button>
                        </div>
                    </div>

                    <!-- Framing guide — dimmed once the page itself is outlined. -->
                    <div class="absolute inset-8 sm:inset-16 border-2 rounded-xl pointer-events-none transition border-white/40" :class="scanQuad ? 'border-transparent' : 'border-white/40'"></div>

                    <!-- DETECTED PAGE outline, tracked live (see _detectPageQuad).
                         Drawn in the video element's own box, with object-cover
                         undone by scanQuadPoints(). -->
                    <template x-if="scanQuad"></template>

                    <!-- AUTO: detection + "hold steady" progress -->
                    <div x-show="scanMode === 'auto'" class="absolute inset-x-0 bottom-10 flex flex-col items-center text-white px-10">
                        <div class="text-sm bg-slate-900/55 px-3 py-1.5 rounded-full mb-2" x-text="scanSteadyPct &gt;= 100 ? 'Capturing…' : (scanQuad ? 'Page detected — hold steady…' : 'Point at the page — looking for its edges')">Point at the page — looking for its edges</div>
                        <div class="w-52 h-2 rounded-full bg-white/25 overflow-hidden">
                            <div class="h-full bg-emerald-400 transition-all duration-100" :style="'width:' + scanSteadyPct + '%'" style="width:0%"></div>
                        </div>
                    </div>

                    <!-- MANUAL: shutter (also crops to the detected page) -->
                    <div x-show="scanMode === 'manual'" class="absolute inset-x-0 bottom-8 flex flex-col items-center gap-3" style="display: none;">
                        <div class="text-sm text-white bg-slate-900/55 px-3 py-1.5 rounded-full" x-text="scanQuad ? 'Page detected — tap to capture' : 'Point at the page, then tap to capture'">Point at the page, then tap to capture</div>
                        <button type="button" @click="captureScanFrame()" class="w-16 h-16 rounded-full bg-white ring-4 ring-white/40 active:scale-95 transition" aria-label="Capture"></button>
                    </div>
                </div>

            <!-- CROP: freeze frame + draggable corners -->
            <template x-if="scanPhase === 'crop'"></template>

            <!-- REVIEW: the flattened page + the enhancement options. NOTHING is
                 applied until one is picked here — every scan starts on Original
                 (scanFilter 'none'), and the choice resets for the next scan, so
                 enhancement is never silently on. -->
            <template x-if="scanPhase === 'review'"></template>
        </div>

        <!-- ============================================================ -->
        <!-- Selected-file preview — full screen (image or PDF)            -->
        <!-- ============================================================ -->
        <div x-show="docPreview" x-transition.opacity="" class="fixed inset-0 bg-slate-100 flex flex-col z-[96]" :class="(docContext === 'rb' || docContext === 'audit') ? 'z-[118]' : 'z-[96]'" style="display:none">
            <div class="flex items-center justify-between px-3 py-3 text-slate-700 gap-2 bg-white border-b border-slate-200 shadow-sm">
                <button type="button" @click="closeDocPreview()" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-slate-100">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    <span class="text-sm font-medium">Back</span>
                </button>
                <span class="text-sm font-medium truncate flex-1 text-center px-2 text-slate-800" x-text="docPreview &amp;&amp; docPreview.name"></span>
                <button type="button" @click="removeFromPreview()" x-show="previewMode === 'staged'" class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-rose-600 hover:bg-rose-50">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
                    <span class="text-sm font-medium">Remove</span>
                </button>
                <span x-show="previewMode !== 'staged'" class="w-12" style="display: none;"></span>
            </div>

            <div class="flex-1 relative overflow-auto flex items-center justify-center p-3">
                <template x-if="docPreview &amp;&amp; docPreview.kind === 'image'"></template>
                <template x-if="docPreview &amp;&amp; docPreview.kind === 'pdf'"></template>
                <template x-if="docPreview &amp;&amp; docPreview.kind === 'audio'"></template>
                <template x-if="docPreview &amp;&amp; docPreview.kind === 'video'"></template>

                <!-- Prev / Next through the active list (staged or uploaded) -->
                <button type="button" x-show="docPreviewIndex &gt; 0" @click="docPreviewPrev()" class="absolute left-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/55 text-white flex items-center justify-center hover:bg-slate-900/70" aria-label="Previous" style="display: none;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button type="button" x-show="docPreviewIndex &lt; _previewItems().length - 1" @click="docPreviewNext()" class="absolute right-2 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-slate-900/55 text-white flex items-center justify-center hover:bg-slate-900/70" aria-label="Next" style="display: none;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </div>

            <div class="text-center text-white/70 text-xs pb-3" x-show="_previewItems().length &gt; 1" x-text="(docPreviewIndex + 1) + ' / ' + _previewItems().length" style="display: none;">0 / 0</div>
        </div>

        <!-- ============================================================ -->
        <!-- Audio recorder (category 1991) — 5-min countdown + pause       -->
        <!-- ============================================================ -->
        <div x-show="audioOpen" class="fixed inset-0 z-[92] bg-gradient-to-b from-violet-50 via-white to-violet-50 text-slate-800 flex flex-col items-center justify-center px-6" style="display:none">
            <button type="button" @click="cancelAudio()" class="absolute top-4 right-4 p-2 rounded-full text-slate-500 hover:bg-slate-200/70" aria-label="Close">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>

            <div class="text-sm text-slate-500 mb-1">Audio Records · max 5:00</div>
            <div class="text-6xl font-bold tabular-nums mb-6 text-slate-800" :class="audioRemaining &lt;= 30 ? 'text-rose-600' : 'text-slate-800'" x-text="audioClock">5:00</div>

            <!-- Mic indicator — pulses while recording -->
            <div class="w-28 h-28 rounded-full flex items-center justify-center mb-8 transition-colors shadow-sm bg-violet-100 text-violet-600" :class="audioPhase === 'recording' ? 'bg-rose-500 text-white animate-pulse' : (audioPhase === 'paused' ? 'bg-amber-500 text-white' : 'bg-violet-100 text-violet-600')">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
            </div>

            <div class="flex items-center gap-4">
                <template x-if="audioPhase === 'idle'"></template><button type="button" @click="startAudioRec()" class="px-7 py-3 rounded-full bg-rose-600 hover:bg-rose-700 text-white font-semibold inline-flex items-center gap-2 shadow">
                        <span class="w-3 h-3 rounded-full bg-white"></span> Start Recording
                    </button>
                <template x-if="audioPhase === 'recording'"></template>
                <template x-if="audioPhase === 'paused'"></template>
                <template x-if="audioPhase === 'processing'"></template>
            </div>
            <div class="text-xs text-slate-400 mt-6" x-show="audioPhase !== 'idle'" style="display: none;">Recording auto-stops at 5 minutes.</div>
        </div>

        <!-- Audio label dialog — asked after recording, saved to note_remark -->
        <div x-show="audioLabelOpen" class="fixed inset-0 z-[94] bg-slate-900/60 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-5 text-slate-800">
                <div class="font-semibold text-lg mb-0.5">Label this recording</div>
                <div class="text-xs text-slate-500 mb-3">Saved with the audio (note remark).</div>
                <template x-if="audioUrl"></template>
                <input x-model="audioLabel" type="text" maxlength="255" placeholder="e.g. Patient consent / Doctor note" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-violet-500 focus:border-violet-500" @keydown.enter="saveAudioLabel()">
                <div class="flex justify-end gap-2 mt-4">
                    <button type="button" @click="cancelAudio()" :disabled="audioUploading" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Discard</button>
                    <button type="button" @click="saveAudioLabel()" :disabled="audioUploading || !audioLabel.trim()" class="px-4 py-2 bg-violet-600 hover:bg-violet-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-40" disabled="disabled">
                        <svg x-show="audioUploading" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="audioUploading ? 'Saving…' : 'Save'">Save</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Video recorder (category 1992) — 3-min countdown, front/back   -->
        <!-- ============================================================ -->
        <div x-show="videoOpen" class="fixed inset-0 z-[92] bg-slate-200 flex flex-col" style="display:none">
            <!-- Live camera preview fills the screen -->
            <video x-ref="recVideo" autoplay="" playsinline="" muted="" class="absolute inset-0 w-full h-full object-cover bg-slate-200" :class="videoFacing === 'user' ? 'scale-x-[-1]' : ''"></video>

            <!-- Top bar -->
            <div class="absolute top-0 inset-x-0 flex items-center justify-between px-4 py-3 text-white bg-gradient-to-b from-slate-900/70 to-transparent">
                <button type="button" @click="cancelVideo()" class="p-1" aria-label="Close">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
                <div class="flex flex-col items-center">
                    <div class="px-3 py-1 rounded-full bg-slate-900/55 text-sm font-bold tabular-nums text-white" :class="videoRemaining &lt;= 15 ? 'text-rose-300' : 'text-white'">
                        <span x-show="videoPhase === 'recording'" class="inline-block w-2 h-2 rounded-full bg-rose-500 mr-1.5 align-middle animate-pulse" style="display: none;"></span>
                        <span x-text="videoClock">3:00</span>
                    </div>
                    <div class="text-[11px] mt-1 text-white/80 tabular-nums" x-show="videoPhase !== 'idle'" :class="videoSizeMB &gt;= 36 ? 'text-rose-300' : 'text-white/80'" style="display: none;">
                        <span x-text="videoSizeMB.toFixed(1)">0.0</span> / 40 MB
                    </div>
                </div>
                <!-- Flip camera (only between takes) -->
                <button type="button" @click="flipVideoCamera()" class="p-1.5 rounded-full hover:bg-white/15" :class="videoPhase === 'idle' ? '' : 'opacity-30 pointer-events-none'" aria-label="Flip camera">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h3l2-2h8l2 2h3v12H3z"></path><path d="M9.5 13a2.5 2.5 0 0 0 4.7 1.2M14.5 11a2.5 2.5 0 0 0-4.7-1.2"></path><polyline points="9.8 9.8 9.8 12 12 12"></polyline><polyline points="14.2 14.2 14.2 12 12 12"></polyline></svg>
                </button>
            </div>

            <!-- Bottom controls -->
            <div class="absolute inset-x-0 bottom-0 px-4 py-6 bg-gradient-to-t from-slate-900/70 to-transparent flex flex-col items-center gap-3">
                <div class="flex items-center gap-4">
                    <template x-if="videoPhase === 'idle'"></template><button type="button" @click="startVideoRec()" class="w-16 h-16 rounded-full bg-rose-600 ring-4 ring-white/40 hover:bg-rose-700 active:scale-95 transition" aria-label="Start recording"></button>
                    <template x-if="videoPhase === 'recording'"></template>
                    <template x-if="videoPhase === 'paused'"></template>
                </div>
                <div class="text-xs text-white/70" x-show="videoPhase === 'idle'">Tap to record · max 3:00 · front/back camera</div>
                <div class="text-xs text-white/70" x-show="videoPhase !== 'idle'" style="display: none;">Recording auto-stops at 3 minutes</div>
            </div>
        </div>

        <!-- Video label dialog — asked after recording, saved to note_remark -->
        <div x-show="videoLabelOpen" class="fixed inset-0 z-[94] bg-slate-900/60 flex items-center justify-center p-4" style="display:none">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-5 text-slate-800">
                <div class="font-semibold text-lg mb-0.5">Label this recording</div>
                <div class="text-xs text-slate-500 mb-3">Saved with the video (note remark).</div>
                <template x-if="videoUrl"></template>
                <input x-model="videoLabel" type="text" maxlength="255" placeholder="e.g. Wound assessment / Procedure clip" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500" @keydown.enter="saveVideoLabel()">
                <div class="flex justify-end gap-2 mt-4">
                    <button type="button" @click="cancelVideo()" :disabled="videoUploading" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Discard</button>
                    <button type="button" @click="saveVideoLabel()" :disabled="videoUploading || !videoLabel.trim()" class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-40" disabled="disabled">
                        <svg x-show="videoUploading" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="videoUploading ? 'Uploading…' : 'Save'">Save</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Remark editor — add/update note_remark on a document -->
        <div x-show="remarkOpen" class="fixed inset-0 z-[94] bg-slate-900/60 flex items-center justify-center p-4" style="display:none" @keydown.escape.window="closeRemarkEditor()">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-5 text-slate-800">
                <div class="font-semibold text-lg mb-0.5" x-text="(_remarkItem &amp;&amp; _remarkItem.label) ? 'Edit remark' : 'Add remark'">Add remark</div>
                <div class="text-xs text-slate-500 mb-3">Free text, saved to the document's note remark.</div>
                <textarea x-model="remarkText" maxlength="255" rows="3" placeholder="Type a remark…" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                <div class="text-[11px] text-slate-400 text-right mt-1"><span x-text="(remarkText || '').length">0</span>/255</div>
                <div class="flex justify-end gap-2 mt-3">
                    <button type="button" @click="closeRemarkEditor()" :disabled="remarkSaving" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Cancel</button>
                    <button type="button" @click="saveRemark()" :disabled="remarkSaving" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                        <svg x-show="remarkSaving" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                        <span x-text="remarkSaving ? 'Saving…' : 'Save'">Save</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- ============================================================ -->
        <!-- Nursing quick-launch FAB. Appears once a patient is selected. -->
        <!-- Draggable anywhere on screen; tapping fans out the Digital    -->
        <!-- Nursing tabs. Sits above the drawers (z-70) but below the     -->
        <!-- full-screen overlays / toast. The <template x-if> wrapper is   -->
        <!-- required: the inner element carries :style, which can't share  -->
        <!-- an element with x-show (the style would clobber display:none). -->
        <!-- ============================================================ -->
        <template x-if="selectedPatientId"></template><div x-init="_fabSeed()" class="fixed z-[76] select-none" :style="fabStyle()" style="left:1974px; top:962px; touch-action:none;">
                <!-- Fan-out menu (opens toward whichever corner has room). -->
                <div x-show="fab.open" x-transition="" class="absolute flex gap-2 pb-1 bottom-16 flex-col-reverse right-0 items-end" :class="fabMenuClass()" style="display:none">
                    <template x-for="m in fabMenu" :key="m.tab"></template><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-check" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>
                            </span>
                            <span x-text="m.label">Assessments</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pill" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-pill"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"></path><path d="m8.5 8.5 7 7"></path></svg>
                            </span>
                            <span x-text="m.label">eMAR</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="heart-pulse" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-heart-pulse"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path><path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path></svg>
                            </span>
                            <span x-text="m.label">eTAR</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="activity" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-activity"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg>
                            </span>
                            <span x-text="m.label">Vital Sheet</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="thermometer" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-thermometer"><path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"></path></svg>
                            </span>
                            <span x-text="m.label">ICU/CCU</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-file-text"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                            </span>
                            <span x-text="m.label">Progress Notes</span>
                        </button><button type="button" @click="fabOpenTab(m.tab, m.label)" class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full bg-white shadow-lg border border-slate-200 text-slate-700 text-sm font-medium whitespace-nowrap hover:bg-cyan-50 hover:text-cyan-700 active:scale-95 transition">
                            <span class="w-7 h-7 rounded-full bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="droplet" aria-hidden="true" :data-lucide="m.icon" style="width:16px;height:16px;display:block;" class="lucide lucide-droplet"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"></path></svg>
                            </span>
                            <span x-text="m.label">I/O Chart</span>
                        </button>
