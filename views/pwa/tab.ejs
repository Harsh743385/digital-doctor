                },

                // POST a web-push subscription { endpoint, keys:{p256dh,auth} } to the
                // session-based subscribe route (stores it against session('user_id')).
                // Used by BOTH the standard Web Push path and the native bridge.
                async _savePushSubscription(subJson) {
