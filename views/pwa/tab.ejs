                        this.rbRecycle = this.rbRecycle.filter((r) => r.id !== item.id);
                        this.loadRegisterBooks();   // refresh category page counts
                        if (this.rbActiveCat && this.rbActiveCat.book_id === item.book_id) this.rbLoadPages(item.book_id);
                    } catch (_) {
                        this.showToast('Restore failed. Check your connection.', 'error');
                    }
                },
