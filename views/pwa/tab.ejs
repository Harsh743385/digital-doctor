form:translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y))}.active\:bg-slate-200:active{--tw-bg-opacity:1;background-color:rgb(226 232 240 / var(--tw-bg-opacity, 1))}.disabled\:cursor-not-allowed:disabled{cursor:not-allowed}.disabled\:opacity-30:disabled{opacity:0.3}.disabled\:opacity-40:disabled{opacity:0.4}.disabled\:opacity-50:disabled{opacity:0.5}.disabled\:opacity-60:disabled{opacity:0.6}@media (min-width: 640px){.sm\:inset-4{inset:1rem}.sm\:inset-16{inset:4rem}.sm\:order-1{order:1}.sm\:order-2{order:2}.sm\:order-3{order:3}.sm\:inline{display:inline}.sm\:w-72{width:18rem}.sm\:w-80{width:20rem}.sm\:max-w-lg{max-width:32rem}.sm\:max-w-md{max-width:28rem}.sm\:max-w-sm{max-width:24rem}.sm\:grid-cols-3{grid-template-columns:repeat(3, minmax(0, 1fr))}.sm\:flex-row{flex-direction:row}.sm\:items-center{align-items:center}.sm\:justify-end{justify-content:flex-end}.sm\:rounded-2xl{border-radius:1rem}.sm\:p-4{padding:1rem}.sm\:px-5{padding-left:1.25rem;padding-right:1.25rem}}@media (min-width: 768px){.md\:order-none{order:0}.md\:w-auto{width:auto}.md\:p-3{padding:0.75rem}.md\:p-6{padding:1.5rem}.md\:text-9xl{font-size:8rem;line-height:1}.md\:text-7xl{font-size:4.5rem;line-height:1}}@media (min-width: 1024px){.lg\:grid-cols-4{grid-template-columns:repeat(4, minmax(0, 1fr))}}@media (min-width: 1280px){.xl\:grid-cols-5{grid-template-columns:repeat(5, minmax(0, 1fr))}}</style></head>
<body>
    <div x-data="pwaApp()" x-init="init()" class="app-shell flex flex-col">
        <!-- No-internet marquee strip — shown when the device is offline OR
             connected to a network with no real internet (server unreachable /
             captive portal). noInternet() covers both. Scrolls continuously. -->
        <div class="net-marquee" x-show="noInternet()" role="status" aria-live="polite" style="">
            <div class="net-marquee__track">
                <span>No Internet Connection, Please Check WIFI settings</span>
                <span>No Internet Connection, Please Check WIFI settings</span>
            </div>
        </div>
        <!-- Top app header. Hidden while editing a page so the canvas toolbar
             (rendered at the top of edit mode) becomes the only top bar. -->
        <header x-show="!(viewerOpen &amp;&amp; viewerMode === 'edit')" class="relative text-white px-4 py-3 flex items-center shadow z-10" style="background-color: #67C2FF;">
<a href="/dashboard" title="Back to Presco Dashboard" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/20 hover:bg-white/30 text-white text-xs font-semibold mr-2 transition backdrop-blur-sm shadow-sm" style="text-decoration:none;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Dashboard</span></a>
            <!-- Left drawer: "« Patients". -->
            <button type="button" @click="leftOpen = !leftOpen" class="px-2.5 py-1.5 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40 mr-2 flex items-center gap-1.5 text-sm font-medium" :aria-label="leftOpen ? 'Close patients' : 'Open patients'" aria-label="Open patients">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevrons-left" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-chevrons-left"><path d="m11 17-5-5 5-5"></path><path d="m18 17-5-5 5-5"></path></svg>
                <span>Patients</span>
            </button>
            <!-- Home — close the open page viewer and show the selected
                 category's grid view. Shown only while viewing a page (same as
                 the page-log button). -->
            <button type="button" x-show="(viewerOpen &amp;&amp; viewerMode === 'detail') || (docViewOpen &amp;&amp; docViewMode === 'detail')" @click="goHome()" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center shadow mr-2 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Home" title="Home — category grid" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
            </button>
            <!-- Lock/Unlock the page being viewed — only for lockable categories
                 (not the All view). Same confirm flow as the thumbnail icon. -->
            <button type="button" x-show="viewerOpen &amp;&amp; viewerMode === 'detail' &amp;&amp; viewerCategory &amp;&amp; viewerCategory.locked &amp;&amp; !viewerCategory.isAll" @click="viewerActiveRecord &amp;&amp; (viewerActiveRecord.isLocked ? openUnlockNoteConfirm(viewerActiveRecord) : openLockNoteConfirm(viewerActiveRecord))" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center shadow mr-2 focus:outline-none focus:ring-2 focus:ring-white/40" :title="(viewerActiveRecord &amp;&amp; viewerActiveRecord.isLocked) ? 'Locked — tap to unlock this page' : 'Unlocked — tap to lock this page'" :aria-label="(viewerActiveRecord &amp;&amp; viewerActiveRecord.isLocked) ? 'Unlock page' : 'Lock page'" title="Unlocked — tap to lock this page" aria-label="Lock page" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock-open" aria-hidden="true" x-show="!(viewerActiveRecord &amp;&amp; viewerActiveRecord.isLocked)" style="width: 16px; height: 16px;" class="lucide lucide-lock-open"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 9.9-1"></path></svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock" aria-hidden="true" x-show="viewerActiveRecord &amp;&amp; viewerActiveRecord.isLocked" style="width: 16px; height: 16px; display: none;" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </button>
            <!-- Branding / hospital / user removed per request; this is just a
                 spacer now (no home redirect on tap). -->
            <div class="flex-1 min-w-0"></div>

            <!-- Centered brand title — shown when no page/document/webview is open. -->
            <span x-show="!viewerOpen &amp;&amp; !webOpen &amp;&amp; !(docViewOpen &amp;&amp; docViewMode === 'detail')" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-base font-bold tracking-wide whitespace-nowrap" style="display: none;">
                Presco-IPD
            </span>

            <!-- Eye viewer toggle — REPLACES the brand title while a webview page
                 (Digital Nursing / eMAR / eTAR / Daily Billing / …) is open, so
                 the "flip through the whole patient file" feature is reachable
                 from every webview, not just the handwritten-page editor. -->
            <button type="button" x-show="webOpen" @click="eyeOpen ? closeEye() : openEyeViewer(); $nextTick(() =&gt; window.lucide &amp;&amp; window.lucide.createIcons())" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-9 h-9 rounded-full flex items-center justify-center shadow focus:outline-none focus:ring-2 focus:ring-white/40 bg-white/20 hover:bg-white/30 text-white" :class="eyeOpen ? 'bg-white text-slate-800' : 'bg-white/20 hover:bg-white/30 text-white'" :title="eyeOpen ? 'Close eye viewer' : 'Eye viewer — flip through this patient\'s file'" :aria-label="eyeOpen ? 'Close eye viewer' : 'Open eye viewer'" title="Eye viewer — flip through this patient's file" aria-label="Open eye viewer" style="">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="eye" aria-hidden="true" :data-lucide="eyeOpen ? 'eye-off' : 'eye'" style="width:20px;height:20px;display:block;" class="lucide lucide-eye"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </button>

            <!-- Document page count (detail mode) — mirrors the pages "Page N / M". -->
            <span x-show="docViewOpen &amp;&amp; docViewMode === 'detail'" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-sm font-medium tabular-nums whitespace-nowrap" style="display: none;">
                Page <b x-text="docDetailIndex + 1">1</b><span class="opacity-70 mx-0.5">/</span><span x-text="docExisting.length">0</span>
            </span>

            <!-- Centered page actions: "Page N / M" + orange "Open" + the "+"
                 (new page). In the All view these appear in DETAIL mode and act
                 on the CURRENT page's own category (Open = edit it, + = add a new
                 page to that same category). Hidden while editing. -->
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-3" x-show="viewerOpen &amp;&amp; viewerMode !== 'edit'" style="display: none;">
                <!-- Clone (duplicate) the current page — visible once a page is
                     saved (has a note id). Hidden when the page is locked, since
                     a locked page can't be cloned, and hidden without the clone
                     grant (p_id 74; privileged roles 1/2/10 always allowed). -->
                <button type="button" x-show="me &amp;&amp; me.can_clone_pages &amp;&amp; viewerMode === 'detail' &amp;&amp; viewerActiveRecord &amp;&amp; viewerActiveRecord.id &amp;&amp; !viewerActiveRecord.isLocked" @click="openCloneConfirm()" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center shadow" aria-label="Clone page" title="Clone (duplicate) this page" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="copy" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-copy"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                </button>
                <span class="text-sm font-medium tabular-nums whitespace-nowrap" x-show="viewerMode === 'detail' || (viewerMode === 'empty' &amp;&amp; !(viewerCategory &amp;&amp; viewerCategory.isAll))" style="display: none;">
                    Page <b x-text="viewerMode === 'detail' ? activePageNo() : 1">1</b>
                    <span class="opacity-70 mx-0.5">/</span>
                    <span x-text="viewerMode === 'detail' ? viewerRecords.length : 1">1</span>
                </span>
                <button type="button" x-show="!viewOnlyActive() &amp;&amp; (viewerMode === 'detail' || (viewerMode === 'empty' &amp;&amp; !(viewerCategory &amp;&amp; viewerCategory.isAll)))" @click="viewerMode === 'detail' ? editCurrentPage() : startEdit()" class="px-4 py-1.5 rounded-full bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold shadow flex items-center gap-1.5" title="Open page to write" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-tool" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-pen-tool"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                    <span>Open</span>
                </button>
                <button type="button" x-show="!viewOnlyActive() &amp;&amp; viewerMode === 'detail'" @click="startEdit()" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center shadow" aria-label="New page" title="New page" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                </button>
            </div>

            <!-- Sign out moved to the forms drawer's Modules tab. -->

            <!-- Install PWA button (only when installable) -->
            <button x-show="installAvailable" type="button" @click="installPwa()" class="mr-2 px-2.5 py-1 rounded-full bg-white/15 hover:bg-white/25 text-xs font-medium flex items-center gap-1.5" title="Install Presco Tab as an app" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="download" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-download"><path d="M12 15V3"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path></svg>
                <span>Install app</span>
            </button>

            <!-- Offline indicator -->
            <span x-show="!isOnline" class="mr-2 px-2 py-1 rounded-full bg-amber-500 text-xs font-medium flex items-center gap-1" title="No network connection" style="display: none;">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-100"></span>
                Offline
            </span>

            <!-- Delete the document being viewed (uploaded files only) — HARD
                 delete from DB + storage, with a confirmation dialog. Sits to
                 the left of the page-log button. -->
            <button type="button" x-show="docViewOpen &amp;&amp; docViewMode === 'detail'" @click="askDeleteCurrentDoc()" class="mr-2 w-9 h-9 rounded-full bg-red-500 hover:bg-red-600 text-white flex items-center justify-center shadow shrink-0 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Delete file" title="Delete this file" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
            <!-- Share document — uploaded files only (the doc viewer is used
                 exclusively for categories 1991/1992/1993/1994/1997/1998/1999).
                 Between Delete and the page-log button. Opens a small menu to
                 either Print the file or Share it to another device. -->
            <div class="relative mr-2 shrink-0" x-show="docViewOpen &amp;&amp; docViewMode === 'detail'" style="display: none;">
                <button type="button" @click="docShareMenuOpen = !docShareMenuOpen; $nextTick(() =&gt; window.lucide &amp;&amp; window.lucide.createIcons())" class="w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white/40 flex items-center justify-center" aria-label="Share document" title="Share document">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="share-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-share-2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
                </button>
                <div x-show="docShareMenuOpen" x-transition.opacity="" @click.outside="docShareMenuOpen = false" class="absolute right-0 top-full mt-1.5 w-48 rounded-lg shadow-2xl overflow-hidden z-[70] text-sm font-medium text-slate-700 bg-white border border-slate-200 py-1" style="display:none">
                    <button type="button" @click="printCurrentDoc()" class="w-full text-left px-3 py-2.5 hover:bg-slate-100 flex items-center gap-2.5 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="printer" aria-hidden="true" style="width:17px;height:17px;display:block;" class="lucide lucide-printer"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>
                        <span>Print</span>
                    </button>
                    <button type="button" @click="shareCurrentDoc()" class="w-full text-left px-3 py-2.5 hover:bg-slate-100 flex items-center gap-2.5 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="share-2" aria-hidden="true" style="width:17px;height:17px;display:block;" class="lucide lucide-share-2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>
                        <span>Share to device</span>
                    </button>
                </div>
            </div>
            <!-- Star — sits immediately LEFT of the page-log button. Shown ONLY
                 while a SAVED page is open in the viewer (viewerOpen + detail);
                 deliberately NOT shown for uploaded documents (docViewOpen),
                 which are files rather than saved pages.
                 Saves the open page as a reusable IPD Page Template — see
                 starCurrentPage(). Filled amber (the style overrides lucide's
                 fill="none" presentation attribute). -->
            <!-- Templates — immediately LEFT of the star. Unlike the star (which
                 acts on an OPEN page), this one only needs a category open, so it
                 shows even when that category has no pages yet — you get a
                 template to start the first page from. Gated by p_id 93; see
                 templateIconVisible().
                 style="display:none" is required: without it the button renders
                 on EVERY screen until Alpine boots and evaluates x-show, which on
                 a slow tablet WebView reads as "always visible". -->
            <button type="button" x-show="templateIconVisible()" style="display:none" @click="openTemplatesForCurrentPage()" class="mr-2 w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white/40 flex items-center justify-center shrink-0" aria-label="Templates for this category" title="Templates for this category">
                <!-- `file-text` — the glyph the IPD Pages Templates section uses
                     for itself (its drawer menu item and its empty states). -->
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" style="width:21px;height:21px;display:block;" class="lucide lucide-file-text"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
            </button>
            <!-- HIDDEN unless the user holds p_id 94. -->
            <button type="button" x-show="savedPageInViewer() &amp;&amp; me &amp;&amp; me.can_star_page_template" style="display:none" @click="starCurrentPage()" class="mr-2 w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white/40 flex items-center justify-center shrink-0" aria-label="Save this page as a template" title="Save this page as a template">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="star" aria-hidden="true" style="width:21px;height:21px;display:block;fill:#facc15;color:#facc15;" class="lucide lucide-star"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
            </button>

            <!-- Page edit history — shown while viewing a saved page. Opens the
                 log panel for the current page's note_id (pma_notes_logs). Hidden
                 without the view-page-log grant (p_id 89; privileged roles 1/2/10
                 always allowed). Also hidden for the uploaded-document categories
                 (Audio/Video/Other/Lab/Bill/Radiology/Cardiology — cat ids
                 1991/1992/1993/1994/1997/1998/1999) which have no edit history. -->
            <button type="button" x-show="me &amp;&amp; me.can_view_page_log &amp;&amp; ((viewerOpen &amp;&amp; viewerMode === 'detail') || (docViewOpen &amp;&amp; docViewMode === 'detail' &amp;&amp; ![1991,1992,1993,1994,1997,1998,1999].includes(docCatId)))" @click="openPageLogsForCurrent()" class="mr-2 w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white/40 flex items-center justify-center shrink-0" aria-label="Page edit history" title="Page edit history" style="display: none;">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="watch" aria-hidden="true" style="width:21px;height:21px;display:block;" class="lucide lucide-watch"><path d="M12 10v2.2l1.6 1"></path><path d="m16.13 7.66-.81-4.05a2 2 0 0 0-2-1.61h-2.68a2 2 0 0 0-2 1.61l-.78 4.05"></path><path d="m7.88 16.36.8 4a2 2 0 0 0 2 1.61h2.72a2 2 0 0 0 2-1.61l.81-4.05"></path><circle cx="12" cy="12" r="6"></circle></svg>
            </button>

            <!-- Right drawer: "Forms »". -->
            <button type="button" @click="rightOpen = !rightOpen" class="px-2.5 py-1.5 rounded hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/40 flex items-center gap-1.5 text-sm font-medium" :aria-label="rightOpen ? 'Close forms' : 'Open forms'" aria-label="Open forms">
                <span>Forms</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevrons-right" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-chevrons-right"><path d="m6 17 5-5-5-5"></path><path d="m13 17 5-5-5-5"></path></svg>
            </button>
        </header>

        <!-- Main pane — the forms-browser empty state. Hidden while the page
             viewer is open, since the viewer takes over this same pane (it is
             NOT a full-screen activity; it renders in-flow below the app header). -->
        <main x-show="!viewerOpen &amp;&amp; !docViewOpen &amp;&amp; !webOpen" class="flex-1 flex flex-col items-center justify-center px-6 text-center" style="background-image: radial-gradient(circle at 50% 44%, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 58%), linear-gradient(135deg, rgb(103, 194, 255) 0%, rgb(191, 228, 255) 50%, rgb(103, 194, 255) 100%); display: none;">
            <!-- Presco brand mark — centred on the blue gradient.
                 Save the provided logo as ./icons/presco-logo.png. -->
            <img src="/pwa/files/presco-logo.png" alt="Presco" draggable="false" onerror="this.style.display='none'" class="w-64 sm:w-72 max-w-[55vw] h-auto select-none drop-shadow-lg">
            <button type="button" @click="leftOpen = true" class="mt-8 px-5 py-2 rounded-full bg-white/25 hover:bg-white/35 backdrop-blur text-white text-sm font-medium shadow-sm transition-colors flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevrons-left" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-chevrons-left"><path d="m11 17-5-5 5-5"></path><path d="m18 17-5-5 5-5"></path></svg>
                <span>Select a patient</span>
            </button>
            <div class="mt-6 text-xs text-white/70" x-show="selectedCategoryIndex !== null" x-transition.opacity="" style="display: none;">
                Last selected: #<span x-text="selectedCategoryIndex"></span>
                — <span class="font-mono" x-text="selectedCategoryLabel"></span>
            </div>
        </main>

        <!-- Shared backdrop for either drawer. Shows whenever a drawer is open
             — including over the in-flow viewer (drawers are z-40, above this
             z-30 backdrop, above the viewer pane) — so forms/patients can be
             switched without first closing the viewer. -->
        <div x-show="rightOpen || leftOpen" x-transition.opacity="" @click="rightOpen = false; leftOpen = false" class="fixed inset-0 bg-slate-900/30 z-30" style="display: none;"></div>

        <!-- ============================================================ -->
        <!-- Settings drawer — account identity card. Opened by the gear in   -->
        <!-- the patient-drawer header. Slides in from the left, above every   -->
        <!-- other drawer (own backdrop, z-[70]).                             -->
        <!-- ============================================================ -->
        <div x-show="settingsOpen" x-transition.opacity="" @click="settingsOpen = false; leftOpen = false" class="fixed inset-0 bg-slate-900/40 z-[65]" style="display:none"></div>
        <aside x-show="settingsOpen" x-transition:enter="transition transform ease-out duration-200" x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition transform ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="-translate-x-full" class="fixed inset-y-0 left-0 z-[70] w-[92vw] max-w-md bg-slate-50 shadow-2xl flex flex-col" style="display:none">
            <!-- Body — card pinned to the top; no header/close. Tap outside
                 (backdrop) closes this drawer and the patient drawer together. -->
            <div class="flex-1 overflow-auto">
                <!-- Account identity card (edge to edge — no surrounding margin).
                     All fields read from the cached `me` object + cached device
                     identity; nothing is fetched when the profile is opened. -->
                <div class="relative overflow-hidden text-white" style="background-image:
                        radial-gradient(circle at 88% -12%, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0) 44%),
                        radial-gradient(circle at 6% 108%, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0) 40%),
                        linear-gradient(135deg, #0a4f95 0%, #1a86e0 52%, #0b5fb0 100%);">
                    <!-- Brand row: logo + role pill -->
                    <div class="px-5 pt-4 flex items-center justify-between">
                        <img src="/pwa/files/presco-logo.png" alt="Presco" draggable="false" onerror="this.style.display='none'" class="h-7 w-auto select-none drop-shadow opacity-95">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/15 ring-1 ring-white/25 backdrop-blur text-[11px] font-semibold tracking-wide" x-text="accountTypeLabel() + ' Account'">Admin Account</span>
                    </div>

                    <!-- Avatar (initials) + name + hospital -->
                    <div class="px-5 pt-4 flex items-center gap-4">
                        <div class="w-16 h-16 rounded-full bg-white/15 ring-2 ring-white/40 shadow-inner flex items-center justify-center text-2xl font-bold shrink-0 select-none" x-text="userInitials()">AP</div>
                        <div class="min-w-0">
                            <div class="text-xl font-bold leading-tight truncate" x-text="me.user_name || '—'">ANAND SURGICAL HOSPITAL PVT.LTD</div>
                            <div class="mt-1 flex items-center gap-1.5 text-[13px] text-white/85 min-w-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="building-2" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-building-2 opacity-90 shrink-0"><path d="M10 12h4"></path><path d="M10 8h4"></path><path d="M14 21v-3a2 2 0 0 0-4 0v3"></path><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2"></path><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path></svg>
                                <span class="truncate" x-text="me.hospital_name || '—'">ANAND SURGICAL HOSPITAL PVT. LTD. (AHMEDABAD)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Contact rows -->
                    <div class="px-5 pt-4 pb-4 space-y-2 text-sm" x-show="me.mobile_no || me.email_id" style="display: none;">
                        <div class="flex items-center gap-2.5" x-show="me.mobile_no" style="display: none;">
                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-white/15 shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="phone" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-phone"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>
                            </span>
                            <span x-text="me.mobile_no"></span>
                        </div>
                        <div class="flex items-center gap-2.5" x-show="me.email_id" style="display: none;">
                            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-white/15 shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="mail" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
                            </span>
                            <span class="break-all" x-text="me.email_id"></span>
                        </div>
                    </div>

                    <!-- Device / Serial footer (tap Device Id to copy) -->
                    <div class="bg-black/25 px-5 py-2.5 flex items-center justify-between gap-3 text-[11px] font-medium text-white/85">
                        <button type="button" @click="copyDeviceId()" class="flex items-center gap-1.5 min-w-0 hover:text-white transition" title="Tap to copy Device Id">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="smartphone" aria-hidden="true" style="width:13px;height:13px;display:block;" class="lucide lucide-smartphone shrink-0"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path></svg>
                            <span class="truncate">Device : <span class="font-mono font-semibold" x-text="deviceId || '—'">—</span></span>
                        </button>
                        <span class="flex items-center gap-1.5 min-w-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="hash" aria-hidden="true" style="width:13px;height:13px;display:block;" class="lucide lucide-hash shrink-0"><line x1="4" x2="20" y1="9" y2="9"></line><line x1="4" x2="20" y1="15" y2="15"></line><line x1="10" x2="8" y1="3" y2="21"></line><line x1="16" x2="14" y1="3" y2="21"></line></svg>
                            <span class="truncate">Serial : <span class="font-mono font-semibold" x-text="serialNo || '—'">—</span></span>
                        </span>
                    </div>
                </div>

                <!-- Menu list -->
                <nav class="divide-y divide-slate-100">
                    <template x-for="item in settingsMenu" :key="item.label"></template><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="user-plus" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-user-plus shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Admit Patient</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="life-buoy" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-life-buoy shrink-0 text-red-600" :class="item.cls || 'text-slate-500'"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path><circle cx="12" cy="12" r="4"></circle></svg>
                            <span class="text-[15px] font-medium text-red-600" :class="item.cls || 'text-slate-700'" x-text="item.label">Create Presco Ticket for any kind of Issues</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="shopping-cart" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-shopping-cart shrink-0 text-blue-600" :class="item.cls || 'text-slate-500'"><path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18"></path><path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25"></path><circle cx="18" cy="20" r="2"></circle><circle cx="8" cy="20" r="2"></circle></svg>
                            <span class="text-[15px] font-medium text-blue-600" :class="item.cls || 'text-slate-700'" x-text="item.label">Presco Mart to buy Presco Products</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layers" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-layers shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Bulk Page view Of Admitted Patients</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-calendar shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Surgery (OT) Calender</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="bookmark" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-bookmark shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Next Followup Details</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left-right" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-arrow-left-right shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Exchange Bed</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="book" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-book shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Register Book Master</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="book-open" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-book-open shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Digital Register Book</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="file-text" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-file-text shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">IPD Pages Templates</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="bell" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-bell shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Notifications</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="shield-check" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-shield-check shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Hospital / NABH Policies</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="table" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-table shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><path d="M12 3v18"></path><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path><path d="M3 15h18"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Google Sheets</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-check" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-clipboard-check shrink-0 text-slate-500" :class="item.cls || 'text-slate-500'"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>
                            <span class="text-[15px] font-medium text-slate-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Audit &amp; Feedback</span>
                        </button><button type="button" @click="settingsMenuTap(item)" class="w-full flex items-center gap-3 px-4 py-3.5 text-left hover:bg-slate-100 active:bg-slate-200 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" :data-lucide="item.icon" style="width:20px;height:20px;display:block;" class="lucide lucide-log-out shrink-0 text-rose-700" :class="item.cls || 'text-slate-500'"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                            <span class="text-[15px] font-medium text-rose-700" :class="item.cls || 'text-slate-700'" x-text="item.label">Logout</span>
                        </button>
                </nav>
            </div>
        </aside>

        <!-- ============================================================ -->
        <!-- Floating full-screen window — opens a Settings-drawer menu link  -->
        <!-- in an iframe over the app (no navigation away). Top-most (z-[98]),-->
        <!-- dim backdrop, title bar + close; Esc also closes.                -->
        <!-- ============================================================ -->
        <div x-show="extOpen" x-transition.opacity="" @keydown.escape.window="extExitConfirmOpen ? (extExitConfirmOpen = false) : _requestCloseExternal()" class="fixed inset-0 z-[98] bg-slate-900/50" style="display:none">
            <div class="absolute inset-2 sm:inset-4 rounded-xl overflow-hidden shadow-2xl bg-white flex flex-col" :class="extLandscape ? 'ext-landscape' : ''">
                <div class="px-4 py-2.5 flex items-center gap-3 bg-slate-800 text-white shrink-0">
                    <div class="flex-1 min-w-0 font-semibold text-base truncate" x-text="extTitle || 'Presco'">Presco</div>
                    <button type="button" @click="_requestCloseExternal()" class="p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                    </button>
                </div>
                <!-- src bound only while open so closing stops the page. -->
                <iframe x-show="extOpen" :src="extOpen ? extUrl : ''" class="flex-1 min-h-0 w-full border-0 bg-white" :title="extTitle" allow="camera; microphone; clipboard-write; geolocation" src="/pwa/files/saved_resource.html" title="" style="display: none;"></iframe>
            </div>

            <!-- Exit confirmation for windows opened with confirmClose (Digital
                 Register Book). The embedded page can hold unsaved work that the
                 shell can't see, so a stray tap on X must not drop it. z above
                 the window itself (z-98). -->
            <div x-show="extExitConfirmOpen" x-transition.opacity="" class="fixed inset-0 z-[105] flex items-center justify-center p-6" style="display:none">
                <div class="absolute inset-0 bg-black/50" @click="extExitConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-log-out"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800" x-text="'Exit from ' + (extTitle || 'this section') + '.'">Exit from this section.</h2>
                    <p class="mt-2 text-sm text-slate-500" x-text="'Would you like to Exit from ' + (extTitle || 'this section') + '. Any unsaved work will be lost.'">Would you like to Exit from this section. Any unsaved work will be lost.</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="extExitConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="_closeExternal()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Exit</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- Register Book Master — fresh full-screen window (inset-0, no    -->
        <!-- margin). View-only searchable list of mst_register_book with a  -->
        <!-- right drawer (category bunch-filter + tapped-row details).      -->
        <!-- ============================================================ -->
        <div x-show="rbOpen" x-transition.opacity="" @keydown.escape.window="rbAddrPickerOpen ? rbCloseAddrPicker() : (rbDocRemarkOpen ? rbCloseDocRemark() : (rbDocDeleteConfirmOpen ? (rbDocDeleteConfirmOpen = false) : (rbDocPreviewOpen ? rbCloseDocPreview() : ((rbPageView === 'gallery' &amp;&amp; rbDocView === 'detail') ? rbDocBackToGrid() : (rbDeleteConfirmOpen ? (rbDeleteConfirmOpen = false) : (rbEditExitOpen ? rbEditExitCancel() : (rbExitConfirmOpen ? (rbExitConfirmOpen = false) : (rbPageView === 'edit' ? rbCancelEdit() : (rbRightOpen ? (rbRightOpen = false) : rbConfirmExit())))))))))" class="fixed inset-0 z-[99] bg-slate-100 flex flex-col" style="display:none">
            <!-- Header (normal) — hidden in edit mode (no back button while editing).
                 `relative` so the detail cluster can be absolutely centred. -->
            <div x-show="rbPageView !== 'edit'" class="relative shrink-0 flex items-center gap-1.5 px-3 py-3 text-white shadow" style="background-color:#67C2FF;">
                <!-- Back — confirms before leaving the Register Book section.
                     Shown in every non-edit view. -->
                <button type="button" @click="rbConfirmExit()" class="p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <!-- Home — in the page viewer AND in the document pager; returns to
                     the corresponding grid. -->
                <button type="button" x-show="rbPageView === 'detail'" @click="rbHome()" class="p-1.5 rounded hover:bg-white/15 shrink-0" title="Home" aria-label="Home" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                </button>
                <button type="button" x-show="rbPageView === 'gallery' &amp;&amp; rbDocView === 'detail'" @click="rbDocBackToGrid()" class="p-1.5 rounded hover:bg-white/15 shrink-0" title="Home" aria-label="Home" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                </button>
                <!-- In detail mode the title is capped so it truncates well before
                     the absolutely-centred Open · n/n · Add cluster. -->
                <div class="flex-1 min-w-0" :class="(rbPageView === 'detail' || rbPageView === 'gallery' || (rbPageView === 'grid' &amp;&amp; rbActiveCat &amp;&amp; rbPages.length === 0)) ? 'max-w-[38%]' : ''">
                    <div class="font-semibold text-base truncate" x-text="rbActiveCat ? rbActiveCat.book_type : 'Register Book Master'">Register Book Master</div>
                    <div x-show="rbActiveCat" class="text-[11px] text-white/70 truncate" x-text="(rbActiveCat &amp;&amp; rbActiveCat.category_code) || 'Register book pages'" style="display: none;">Register book pages</div>
                </div>

                <!-- Detail cluster: Open · page n/n · Add — absolutely CENTRED in
                     the app bar (independent of the title width on the left).
                     Navigation is by SWIPE — no prev/next arrows. -->
                <template x-if="rbPageView === 'detail'"></template>

                <!-- Empty-state cluster (grid, no pages) — SAME as IPD: "Page 1 / 1"
                     + an orange Open button that starts the first page. The bottom
                     floating + button is hidden in this state (see below). -->
                <template x-if="rbActiveCat &amp;&amp; rbPageView === 'grid' &amp;&amp; !rbPagesLoading &amp;&amp; !rbPagesError &amp;&amp; rbPages.length === 0"></template>

                <!-- Other Documents (gallery) cluster — file count + an Add button
                     to open the image/PDF capture sheet. Absolutely centred, like
                     the page clusters. -->
                <template x-if="rbActiveCat &amp;&amp; rbActiveCat.is_other &amp;&amp; rbPageView === 'gallery'"></template>

                <!-- Right drawer (category selector) — the ONLY right-side icon,
                     pinned to the far right end (ml-auto) so it can't overlap the
                     centred Open · n/n · Add cluster in the page viewer. Opens the
                     register list, so a separate list icon isn't needed. -->
                <button type="button" @click="rbRightOpen = !rbRightOpen" class="relative ml-auto p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Register books">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="book-open" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-book-open"><path d="M12 5v16"></path><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"></path></svg>
                </button>
            </div>

            <!-- Header (EDIT mode) — editing tools live in the app bar, like IPD.
                 No back button here; Save / Cancel end the edit. Popovers drop down. -->
            <div x-show="rbPageView === 'edit'" class="shrink-0 bg-slate-50 border-b border-slate-200 text-slate-600 shadow-sm relative z-30" style="display: none;">
                <!-- flex-wrap (NOT overflow-x-auto) so the row never clips the
                     tool dropdowns that open below it; on narrow screens the
                     toolbar wraps to a second line instead of scroll-clipping. -->
                <div class="flex flex-wrap items-center justify-center gap-1.5 px-2 py-2">
                    <!-- Pen -->
                    <div class="relative shrink-0">
                        <button type="button" @click="rbToolTap('pen')" :class="rbEditTool === 'pen' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center bg-slate-800 text-white" title="Pen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-line" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-pen-line"><path d="M13 21h8"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
                        </button>
                        <div x-show="rbPenOpen" @click.outside="rbPenOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Pen size <span x-text="rbPenSize">2</span></div>
                            <input type="range" min="1" max="20" x-model.number="rbPenSize" class="w-full">
                        </div>
                    </div>
                    <!-- Eraser -->
                    <div class="relative shrink-0">
                        <button type="button" @click="rbToolTap('eraser')" :class="rbEditTool === 'eraser' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Eraser">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="eraser" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-eraser"><path d="M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21"></path><path d="m5.082 11.09 8.828 8.828"></path></svg>
                        </button>
                        <div x-show="rbEraserOpen" @click.outside="rbEraserOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Eraser size <span x-text="rbEraserSize">24</span></div>
                            <input type="range" min="6" max="80" x-model.number="rbEraserSize" class="w-full">
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Undo / Redo -->
                    <button type="button" @click="rbUndo()" :disabled="!rbCanUndo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Undo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="undo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-undo-2"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg></button>
                    <button type="button" @click="rbRedo()" :disabled="!rbCanRedo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Redo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="redo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-redo-2"><path d="m15 14 5-5-5-5"></path><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"></path></svg></button>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Colour -->
                    <div class="relative shrink-0">
                        <button type="button" @click="rbColorOpen=!rbColorOpen; rbGalleryOpen=false; rbPasteMenuOpen=false" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Colour">
                            <span class="w-5 h-5 rounded-full border-2 border-slate-300" :style="'background-color:' + rbEditColor" style="background-color:#0000FF"></span>
                        </button>
                        <div x-show="rbColorOpen" @click.outside="rbColorOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 grid grid-cols-4 gap-2 w-44" style="display: none;">
