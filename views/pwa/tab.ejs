                    <!-- Copy / Paste intentionally removed from Audit & Feedback. -->
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Delete page — only when editing an existing page (hidden for a new page). Confirms first. -->
                    <button type="button" x-show="afEditingPageId != null" @click="afDeleteConfirmOpen = true" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Delete page" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    <!-- Reset -->
                    <button type="button" @click="afReset()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 shrink-0" title="Reset"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg></button>
                    <!-- Cancel -->
                    <button type="button" @click="afCancelEdit()" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-rose-100 text-rose-600 shrink-0" title="Cancel"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button>
                </div>
            </div>

            <!-- Body: pages area (main) + category selector (right drawer) -->
            <div class="flex-1 min-h-0 relative flex">
                <!-- MAIN: pages of the selected category. In EDIT and DETAIL
                     (page-viewer) modes it drops its padding + scroll so the page
                     fills the whole area edge-to-edge (fullscreen, like IPD); only
                     the grid keeps p-3 + scroll. -->
                <div class="flex-1 min-w-0 overflow-auto p-3" :class="(afPageView === 'edit' || afPageView === 'detail' || (afPageView === 'gallery' &amp;&amp; afDocView === 'detail') || (afPageView === 'grid' &amp;&amp; afActiveCat &amp;&amp; !afActiveCat.is_other &amp;&amp; afPages.length === 0)) ? 'overflow-hidden' : 'overflow-auto p-3'">
                    <!-- No category chosen yet -->
                    <div x-show="!afActiveCat &amp;&amp; afPageView !== 'recycle'" class="h-full flex flex-col items-center justify-center text-center text-slate-500 py-16">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-check" aria-hidden="true" style="width:40px;height:40px;" class="lucide lucide-clipboard-check text-slate-300"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>
                        <div class="mt-3 font-medium text-slate-600">Choose an audit form</div>
                        <div class="text-sm text-slate-400">Pick a category from the list to see its pages.</div>
                        <button type="button" @click="afRightOpen = true" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-800 text-white text-sm font-medium">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="clipboard-check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-clipboard-check"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg> Open list
                        </button>
                    </div>

                    <!-- RECYCLE BIN (soft-deleted pages) -->
                    <div x-show="afPageView === 'recycle'" style="display: none;">
                        <div class="flex items-center justify-between mb-3">
                            <button type="button" @click="afExitRecycle()" class="inline-flex items-center gap-1 text-sm text-slate-600 hover:text-slate-800">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> Back
                            </button>
                            <div class="font-semibold text-slate-700 flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg> Recycle Bin</div>
                            <button type="button" @click="afLoadRecycle()" class="p-1.5 rounded-full border border-slate-200 bg-white text-slate-500 hover:bg-slate-50" title="Refresh"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg></button>
                        </div>
                        <div x-show="afRecycleLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading…</div>
                        <div x-show="!afRecycleLoading &amp;&amp; afRecycleError" class="text-center text-rose-600 py-16" x-text="afRecycleError" style="display: none;"></div>
                        <template x-if="!afRecycleLoading &amp;&amp; !afRecycleError &amp;&amp; afRecycle.length === 0"></template><div class="text-center text-slate-500 py-16">Recycle bin is empty.</div>
                        <!-- Card list — SAME structure as the IPD recycle bin
                             (coloured top strip + form-template thumbnail with saved
                             strokes + metadata + Restore). The IPD "Page Log" button
                             is intentionally omitted (audit pages aren't patient-
                             scoped and have no page-log). -->
                        <div class="max-w-4xl mx-auto space-y-3">
                            <template x-for="pg in afRecycle" :key="pg.id"></template>
                        </div>
                    </div>

                    <!-- OTHER DOCUMENTS (gallery) — hospital-scoped uploaded image /
                         PDF files (audit_type_id 1993). Same grid → preview → delete
                         flow as the IPD Other Documents, minus remark & directory. -->
                    <div x-show="afActiveCat &amp;&amp; afActiveCat.is_other &amp;&amp; afPageView === 'gallery'" :class="afDocView === 'detail' ? 'h-full' : ''" class="" style="display: none;">
                        <div x-show="afDocsLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading documents…</div>
                        <div x-show="!afDocsLoading &amp;&amp; afDocsError" class="text-center text-rose-600 py-16" x-text="afDocsError" style="display: none;"></div>
                        <!-- Empty state (like IPD): icon + message + Add affordance. -->
                        <template x-if="!afDocsLoading &amp;&amp; !afDocsError &amp;&amp; afDocs.length === 0"></template><div class="text-center text-slate-500 py-20">
                                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-200 text-slate-400 mb-4">
                                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                                </div>
                                <div class="font-medium text-slate-700 mb-4">No documents yet</div>
                                <button type="button" @click="afAddOtherDocument()" class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Add document
                                </button>
                            </div>

                        <template x-if="!afDocsLoading &amp;&amp; !afDocsError &amp;&amp; afDocs.length"></template>
                    </div>

                    <!-- PAGES GRID — like the IPD viewer: category heading, date
                         groups, 3-up cards with datetime header + page# badge +
                         image + Created/Modified footer. -->
                    <div x-show="afActiveCat &amp;&amp; !afActiveCat.is_other &amp;&amp; afPageView === 'grid'" :class="!afPagesLoading &amp;&amp; !afPagesError &amp;&amp; afPages.length === 0 ? 'h-full' : ''" class="h-full" style="display: none;">
                        <div x-show="afPagesLoading" class="text-center text-slate-500 py-16" style="display: none;">Loading pages…</div>
                        <div x-show="!afPagesLoading &amp;&amp; afPagesError" class="text-center text-rose-600 py-16" x-text="afPagesError" style="display: none;"></div>
                        <!-- No pages yet → show a blank "Page 1" of this register's
                             form template filling the area (like the IPD empty
                             state), not a text message. It's display-only — the
                             app-bar "Page 1 / 1 · Open" button starts writing the
                             first page (same flow as IPD). -->
                        <template x-if="!afPagesLoading &amp;&amp; !afPagesError &amp;&amp; afPages.length === 0"></template><div class="h-full overflow-hidden bg-slate-200 flex flex-col">
                                <div class="bg-white shadow-xl w-full flex-1 flex flex-col">
                                    <div class="h-2 shrink-0" :style="'background-color:' + ((afActiveCat &amp;&amp; afActiveCat.color) || '#0d9488') + ';'" style="background-color:#0d9488;"></div>
                                    <div class="flex-1 relative overflow-hidden">
                                        <img x-show="afActiveBgUrl()" :src="afActiveBgUrl()" alt="" draggable="false" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none" src="https://prescoipd.com/v1/ipd/pwa/ipd" style="display: none;">
                                        <div x-show="!afActiveBgUrl()" class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
                                            <span class="text-5xl md:text-7xl font-black text-slate-200/50 rotate-[-20deg] tracking-widest text-center px-4" x-text="(afActiveCat &amp;&amp; afActiveCat.book_type || '').toUpperCase()"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        <!-- Date filter (dropdown + optional pickers + "Showing …") -->
                        <div x-show="!afPagesLoading &amp;&amp; !afPagesError &amp;&amp; afPages.length" class="mb-3" style="display: none;">
                            <div class="flex items-center gap-2 flex-wrap">
                                <div class="relative shrink-0">
                                    <button type="button" @click="afFilterMenuOpen = !afFilterMenuOpen" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 text-sm font-medium hover:bg-slate-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="sliders-horizontal" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-sliders-horizontal"><path d="M10 5H3"></path><path d="M12 19H3"></path><path d="M14 3v4"></path><path d="M16 17v4"></path><path d="M21 12h-9"></path><path d="M21 19h-5"></path><path d="M21 5h-7"></path><path d="M8 10v4"></path><path d="M8 12H3"></path></svg>
                                        <span x-text="afFilterModeLabel()">Default (This Month)</span>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down text-slate-400"><path d="m6 9 6 6 6-6"></path></svg>
                                    </button>
                                    <div x-show="afFilterMenuOpen" @click.outside="afFilterMenuOpen = false" class="absolute top-full mt-1 left-0 z-40 w-60 bg-white border border-slate-200 rounded-lg shadow-lg py-1" style="display: none;">
                                        <button type="button" @click="afSetFilterMode('default')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-teal-700 font-semibold" :class="afFilterMode === 'default' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg> Reset Filter to Default
                                        </button>
                                        <button type="button" @click="afSetFilterMode('between')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-slate-700" :class="afFilterMode === 'between' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar-range" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-calendar-range"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M16 2v3"></path><path d="M3 9h18"></path><path d="M8 2v3"></path><path d="M17 13h-6"></path><path d="M13 17H7"></path><path d="M7 13h.01"></path><path d="M17 17h.01"></path></svg> Between Date Forms
                                        </button>
                                        <button type="button" @click="afSetFilterMode('datewise')" class="w-full text-left px-4 py-2 text-sm hover:bg-slate-50 flex items-center gap-2 text-slate-700" :class="afFilterMode === 'datewise' ? 'text-teal-700 font-semibold' : 'text-slate-700'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="calendar" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-calendar"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path></svg> Datewise forms
                                        </button>
                                    </div>
                                </div>
                                <!-- Between: from → to (max 3 months, clamped on change) -->
                                <template x-if="afFilterMode === 'between'"></template>
                                <!-- Datewise: a single day -->
                                <template x-if="afFilterMode === 'datewise'"></template>
                            </div>
                            <div class="text-xs font-semibold text-slate-500 mt-1.5" x-text="afFilterLabel()">Showing From  To </div>
                        </div>

                        <!-- Category name — sits directly under the "Showing …" line. -->
                        <div x-show="afPages.length" class="text-lg font-bold text-teal-700 mb-1" x-text="afActiveCat &amp;&amp; afActiveCat.book_type" style="display: none;"></div>
                        <!-- Nothing matched the active date filter (pages exist, but none in range) — below the category name. -->
                        <template x-if="!afPagesLoading &amp;&amp; !afPagesError &amp;&amp; afPages.length &gt; 0 &amp;&amp; afGroupedPages().length === 0"></template>
                        <!-- Date groups -->
                        <template x-for="grp in afGroupedPages()" :key="grp.day"></template>
                    </div>

                    <!-- PAGE DETAIL (viewpager) — SWIPE to navigate (like IPD);
                         Open / n/n / Add live in the app bar. -->
                    <div x-show="afActiveCat &amp;&amp; afPageView === 'detail'" class="h-full" style="display: none;">
                        <div class="h-full overflow-x-auto flex snap-x snap-mandatory af-slider" x-ref="afSlider" id="afSlider" @scroll.passive="afOnSliderScroll()">
                            <template x-for="(pg, i) in afFilteredPages()" :key="pg.id"></template>
                        </div>
                    </div>

                    <!-- ══ PAGE EDITOR (canvas) ══ -->
                    <div x-show="afActiveCat &amp;&amp; afPageView === 'edit'" class="h-full flex flex-col" style="display: none;">
                        <!-- Canvas stage — full-screen category background with the
                             handwritten canvas overlaid at the same dimensions. -->
                        <!-- items-stretch (NOT items-center/justify-center) so the
                             page box fills the whole stage edge-to-edge like IPD —
                             no margins. z-0 keeps the canvas below the edit toolbar. -->
                        <div class="flex-1 min-h-0 bg-slate-200 relative z-0 overflow-hidden flex items-stretch" x-ref="afCanvasWrap" @touchstart="afTouchStart($event)" @touchmove="afTouchMove($event)" @touchend="afTouchEnd($event)" @touchcancel="afTouchEnd($event)">
                            <div class="relative shadow-lg w-full h-full" x-ref="afCanvasPage" :style="afPageStyle()" style="width:100%; height:100%;">
                                <!-- Background template — z-0 and pointer-events-none:
                                     it is DISPLAY-ONLY and sits BELOW the canvas, so it
                                     can never intercept the strokes (this is the IPD
                                     layering, made explicit). -->
                                <img x-show="afEditBgUrl()" :src="afEditBgUrl()" alt="" draggable="false" @load="afOnEditBgLoaded($event)" class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none z-0" src="https://prescoipd.com/v1/ipd/pwa/ipd" style="display: none;">
                                <!-- blank fallback so the page box is visible before/without a template -->
                                <div x-show="!afEditBgUrl()" class="absolute inset-0 bg-white pointer-events-none z-0"></div>
                                <!-- Drawing canvas — z-10, ON TOP of the background; the
                                     only layer that receives pointer events. -->
                                <!-- id= as well as x-ref — same reason as rbCanvas;
                                     see _afCanvasEl(). -->
                                <canvas x-ref="afCanvas" id="afCanvas" class="absolute inset-0 w-full h-full z-10" :style="'touch-action:none;' + (afEditTool === 'eraser' ? 'cursor:cell;' : 'cursor:crosshair;')" @pointerdown="afPointerDown($event)" @pointermove="afPointerMove($event)" @pointerup="afPointerUp($event)" @pointerleave="afPointerUp($event)" @pointercancel="afPointerUp($event)" style="touch-action:none;cursor:crosshair;"></canvas>

                                <!-- Pending image/stamp/selection placement: a movable,
                                     pinch-scalable/rotatable overlay positioned in
                                     canvas-pixel space (%), so it zooms/pans WITH the
                                     page. Only the item box captures pointers. -->
                                <template x-if="_afPlacing"></template>
                            </div>
                            <!-- Stylus-only hint (auto-hides). Shared showStylusHint
                                 state; only ever visible while the RB editor is open. -->
                            <div x-show="showStylusHint" x-transition.opacity="" class="absolute top-3 left-1/2 -translate-x-1/2 bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full shadow flex items-center gap-2 pointer-events-none z-30" style="display:none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-tool" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-pen-tool"><path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"></path><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"></path><path d="m3 3 6.586 6.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                                <span>Use a stylus to draw on this canvas</span>
                            </div>

                            <!-- Selection-mode hint (during a selective copy drag). -->
                            <div x-show="afSelectionMode === 'copy'" class="absolute top-3 left-1/2 -translate-x-1/2 bg-sky-100 text-sky-800 text-xs px-3 py-1.5 rounded-full shadow flex items-center gap-2 z-30" style="display:none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="box-select" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-box-select"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg>
                                <span>Drag with stylus to select an area</span>
                                <button type="button" @click="afCancelSelectiveCopy()" class="ml-1 underline text-sky-900">Cancel</button>
                            </div>
                            <!-- Live marquee rectangle (in wrap coords). -->
                            <template x-if="afSelectionMode === 'copy' &amp;&amp; _afSelectionRect"></template>

                            <!-- Placement action bar (resize / rotate / cancel / place).
                                 Lives in wrap coords so it stays put while the user
                                 moves the pending item. -->
                            <div x-show="_afPlacing" class="absolute bottom-4 left-1/2 -translate-x-1/2 z-40 flex items-center gap-1 bg-white rounded-full shadow-xl border border-slate-200 px-2 py-1.5" style="display:none">
                                <span class="hidden sm:inline text-[11px] text-slate-500 px-2" x-text="(_afPlacing &amp;&amp; _afPlacing.resizable === false &amp;&amp; _afPlacing.rotatable === false) ? 'Drag to position, then Place' : 'Drag to move · pinch to resize/rotate'">Drag to move · pinch to resize/rotate</span>
                                <button type="button" x-show="!(_afPlacing &amp;&amp; _afPlacing.resizable === false)" @click="_afScalePlacement(0.9)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Smaller">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="minus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-minus"><path d="M5 12h14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_afPlacing &amp;&amp; _afPlacing.resizable === false)" @click="_afScalePlacement(1.1)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Larger">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                                </button>
                                <button type="button" x-show="!(_afPlacing &amp;&amp; _afPlacing.rotatable === false)" @click="_afRotatePlacement(-90)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate left 90°">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-ccw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                </button>
                                <button type="button" x-show="!(_afPlacing &amp;&amp; _afPlacing.rotatable === false)" @click="_afRotatePlacement(90)" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-600 flex items-center justify-center" title="Rotate right 90°">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="rotate-cw" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                                </button>
                                <div class="w-px h-5 bg-slate-200 mx-1"></div>
                                <button type="button" @click="_afCancelPlacement()" class="px-3 py-1.5 rounded-full text-slate-600 hover:bg-slate-100 text-sm font-medium flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                                    <span>Cancel</span>
                                </button>
                                <button type="button" @click="_afCommitPlacement()" class="px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold flex items-center gap-1.5">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                    <span>Place</span>
                                </button>
                            </div>
                            <!-- hidden file input for gallery/place-image -->
                            <input type="file" accept="image/*" x-ref="afFileInput" class="hidden" @change="afOnPickImage($event)">
                        </div>
                    </div>
                </div>

                <!-- Right-drawer backdrop (full screen) -->
                <div x-show="afRightOpen" x-transition.opacity="" @click="afRightOpen = false" class="fixed inset-0 z-[65] bg-slate-900/40" style="display:none"></div>

                <!-- RIGHT DRAWER: category selector — FULL screen height -->
                <aside x-show="afRightOpen" x-transition:enter="transition transform ease-out duration-200" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition transform ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" class="fixed inset-y-0 right-0 z-[70] w-[92vw] max-w-md bg-white border-l border-slate-200 shadow-2xl flex flex-col" style="display:none">
                    <!-- No Recycle Bin entry here — Audit & Feedback deliberately
                         does NOT expose one (unlike the Register Book drawer). The
                         afPageView === 'recycle' panel + afOpenRecycle/afLoadRecycle
                         are kept but unreachable; re-add a button here to restore it. -->
                    <!-- Search bar (ditto IPD) + All Bunched dropdown + Close -->
                    <div class="shrink-0 px-3 py-2 flex items-center gap-2 border-b border-slate-100 bg-white">
                        <div class="flex-1 flex items-center gap-2 border border-slate-300 rounded-lg px-3 py-1.5 bg-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:16px;height:16px;color:#64748b;display:block;" class="lucide lucide-search"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                            <input type="search" placeholder="Search Audit &amp; Feedback Form" x-model="afSearch" class="flex-1 outline-none text-sm bg-transparent placeholder-slate-400">
                        </div>
                        <!-- Bunch filter — ditto copy of the IPD forms bunch picker -->
                        <div x-show="afBunchVisible()" class="relative shrink-0" style="display: none;">
                            <button type="button" @click="afBunchOpen = !afBunchOpen" class="border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm bg-white text-slate-700 flex items-center gap-1.5 min-w-[8rem] hover:bg-slate-50">
                                <span class="inline-block w-3 h-3 rounded border border-slate-300 flex-shrink-0" :style="afBunch &amp;&amp; afBunch !== '#00000000' ? ('background-color: ' + afBunch + ';') : 'background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);'" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                                <span class="flex-1 truncate text-left" x-text="afBunchLabel()">All Bunches</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="chevron-down" aria-hidden="true" :data-lucide="afBunchOpen ? 'chevron-up' : 'chevron-down'" style="width:14px;height:14px;display:block;" class="lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"></path></svg>
                            </button>
                            <div x-show="afBunchOpen" @click.outside="afBunchOpen = false" x-transition.opacity="" class="absolute right-0 top-full mt-1 z-30 min-w-[15rem] max-h-72 overflow-auto bg-white border border-slate-200 rounded-lg shadow-lg" style="display:none">
                                <button type="button" @click="afSelectBunch(null)" class="w-full text-left px-3 py-2 text-sm flex items-center gap-2 hover:bg-slate-50 border-b border-slate-100 transition font-semibold text-slate-800 bg-slate-50" :class="!afBunch ? 'font-semibold text-slate-800 bg-slate-50' : 'text-slate-700'">
                                    <span class="inline-block w-4 h-4 rounded border border-slate-300 flex-shrink-0" style="background:repeating-linear-gradient(45deg,#e2e8f0 0 4px,#fff 4px 8px);"></span>
                                    <span class="flex-1">All Bunches</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" x-show="!afBunch" style="width: 14px; height: 14px;" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>
                                </button>
                                <template x-for="opt in afBunchOptions()" :key="opt.colorHex"></template>
                            </div>
                        </div>
                        <button type="button" @click="afRightOpen = false" class="w-9 h-9 rounded-full hover:bg-slate-100 text-slate-500 flex items-center justify-center shrink-0" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
                        </button>
                    </div>
                    <!-- Category list — tap to open its pages -->
                    <div class="flex-1 min-h-0 overflow-auto p-3 space-y-2">
                        <div x-show="afLoading" class="text-center text-slate-400 py-8 text-sm" style="display: none;">Loading…</div>
                        <div x-show="!afLoading &amp;&amp; afError" class="text-center text-rose-600 py-8 text-sm" x-text="afError" style="display: none;"></div>
                        <template x-for="(row, i) in afFiltered()" :key="row.book_id"></template>

                        <!-- Other Documents — a hospital-scoped gallery of uploaded
                             image / PDF files (audit_type_id 1993), below the category list.
                             Same capture/upload/view flow as the IPD Other Documents. -->
                        <button type="button" @click="afOpenOtherDocuments()" class="w-full text-left rounded-xl border border-teal-200 bg-teal-50/60 shadow-sm hover:shadow transition flex items-stretch overflow-hidden mt-1" :class="afActiveCat &amp;&amp; afActiveCat.is_other ? 'ring-2 ring-teal-600' : ''">
                            <div class="w-11 shrink-0 flex items-center justify-center text-white" style="background-color:#0d9488">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="folder" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-folder"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0 px-3 py-2.5">
                                <div class="font-semibold text-slate-800 text-sm truncate">Other Documents</div>
                                <div class="text-[10px] text-slate-400">Uploaded image / PDF documents</div>
                            </div>
                            <div class="shrink-0 self-center pr-3 text-right">
                                <div class="text-lg font-bold leading-none text-teal-700" x-text="afDocs.length">0</div>
                                <div class="text-[9px] uppercase tracking-wide text-slate-400">files</div>
                            </div>
                        </button>
                    </div>
                </aside>

                <!-- Floating "New page" — grid mode only, hidden for inactive
                     registers AND when the register is empty (the app-bar "Page
                     1 / 1 · Open" cluster covers the empty case, like IPD). -->
                <button type="button" x-show="afActiveCat &amp;&amp; afActiveCat.active &amp;&amp; afPageView === 'grid' &amp;&amp; afPages.length &gt; 0" @click="afNewPage()" class="absolute bottom-5 right-5 z-20 w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg flex items-center justify-center active:scale-95 transition" title="New page" aria-label="New page" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:26px;height:26px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                </button>
            </div>

            <!-- Exit confirmation dialog -->
            <div x-show="afExitConfirmOpen" x-transition.opacity="" @keydown.escape.window="afExitConfirmOpen = false" class="fixed inset-0 z-[110] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="afExitConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="log-out" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-log-out"><path d="m16 17 5-5-5-5"></path><path d="M21 12H9"></path><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Exit from Audit &amp; Feedback Section.</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Exit from Audit &amp; Feedback Section.</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="afExitConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="closeAuditFeedback()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Exit</button>
                    </div>
                </div>
            </div>

            <!-- Unsaved-strokes guard — Save / Discard / Keep editing (mirrors the
                 IPD editor exit dialog). z above the RB overlay + its exit dialog. -->
            <div x-show="afEditExitOpen" x-transition.opacity="" @keydown.escape.window="afEditExitCancel()" class="fixed inset-0 z-[120] flex items-center justify-center p-4" style="display: none;">
                <div class="absolute inset-0 bg-slate-900/50" @click="afEditExitCancel()"></div>
                <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
                    <div class="px-5 py-3 bg-amber-500 text-white flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="alert-triangle" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-alert-triangle"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
                        <div class="flex-1 font-semibold">Unsaved changes</div>
                    </div>
                    <div class="p-5">
                        <p class="text-sm text-slate-600">
                            You have unsaved changes on this page. Do you want to save them
                            before leaving, or discard them?
                        </p>
                        <div class="flex flex-col gap-2 mt-5">
                            <button type="button" @click="afEditExitSave()" :disabled="afSaving" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 disabled:opacity-60 flex items-center justify-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                                <span x-text="afSaving ? 'Saving…' : 'Save page'">Save page</span>
                            </button>
                            <button type="button" @click="afEditExitDiscard()" class="w-full px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 flex items-center justify-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                <span>Discard changes</span>
                            </button>
                            <button type="button" @click="afEditExitCancel()" class="w-full px-4 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-slate-100">
                                Keep editing
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Audit Page confirmation — trash icon opens this; "Delete"
                 moves the page to the recycle bin (soft-delete). Above the RB
                 overlay; z below the unsaved-strokes guard is fine (mutually
                 exclusive with editing exit). -->
            <div x-show="afDeleteConfirmOpen" x-transition.opacity="" @keydown.escape.window="afDeleteConfirmOpen = false" class="fixed inset-0 z-[120] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="afDeleteConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Delete this Audit Page</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Delete this page</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="afDeleteConfirmOpen = false" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50">No</button>
                        <button type="button" @click="afDeleteConfirmPage()" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700">Delete</button>
                    </div>
                </div>
            </div>

            <!-- Other Documents — full-screen preview. Image renders vertically /
                 full width (scrollable); PDF renders in-panel via PDF.js. Above
                 the RB overlay (z-99); below the capture sheets (z-112+). -->
            <div x-show="afDocPreviewOpen" class="fixed inset-0 z-[108] bg-slate-900/90 flex flex-col" style="display:none">
                <div class="shrink-0 flex items-center gap-2 px-3 py-2.5 bg-slate-900 text-white">
                    <button type="button" @click="afCloseDocPreview()" class="p-1.5 rounded hover:bg-white/15" aria-label="Close">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                    </button>
                    <div class="flex-1 min-w-0 font-medium truncate" x-text="afDocPreviewItem ? ('Document · ' + _afFmt(afDocPreviewItem.added, 'dt')) : 'Document'">Document</div>
                    <button type="button" x-show="afDocPreviewItem" @click="afOpenDocRemark(afDocPreviewItem)" class="p-1.5 rounded hover:bg-white/15" :title="afDocPreviewItem &amp;&amp; afDocPreviewItem.remark ? 'Edit remark' : 'Add remark'" aria-label="Remark" title="Add remark" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pencil-line" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-pencil-line"><path d="M13 21h8"></path><path d="m15 5 4 4"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
                    </button>
                    <button type="button" x-show="afDocPreviewItem" @click="afAskDeleteDoc(afDocPreviewItem)" class="p-1.5 rounded hover:bg-rose-500/30 text-rose-300" title="Delete" aria-label="Delete" style="display: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:20px;height:20px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                </div>
                <div class="flex-1 min-h-0 overflow-auto">
                    <template x-if="afDocPreviewItem &amp;&amp; afDocPreviewItem.kind === 'image'"></template>
                    <template x-if="afDocPreviewItem &amp;&amp; afDocPreviewItem.kind === 'pdf'"></template>
                </div>
            </div>

            <!-- Delete Other Document confirmation (HARD delete, like IPD). -->
            <div x-show="afDocDeleteConfirmOpen" x-transition.opacity="" class="fixed inset-0 z-[122] flex items-center justify-center p-6" style="display: none;">
                <div class="absolute inset-0 bg-black/50" @click="afDocDeleteConfirmOpen = false"></div>
                <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                    <div class="mx-auto mb-3 w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="trash-2" aria-hidden="true" style="width:24px;height:24px;display:block;" class="lucide lucide-trash-2"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                    <h2 class="text-lg font-semibold text-slate-800">Delete this Document</h2>
                    <p class="mt-2 text-sm text-slate-500">Would you like to Delete this document</p>
                    <div class="mt-5 flex gap-2">
                        <button type="button" @click="afDocDeleteConfirmOpen = false" :disabled="afDocDeleteBusy" class="flex-1 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-medium hover:bg-slate-50 disabled:opacity-50">No</button>
                        <button type="button" @click="afDeleteDoc()" :disabled="afDocDeleteBusy" class="flex-1 py-2.5 rounded-xl bg-rose-600 text-white font-medium hover:bg-rose-700 disabled:opacity-50 inline-flex items-center justify-center gap-2">
                            <svg x-show="afDocDeleteBusy" class="animate-spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <span x-text="afDocDeleteBusy ? 'Deleting…' : 'Delete'">Delete</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Other Document remark editor (remark ONLY — no directory). -->
            <div x-show="afDocRemarkOpen" x-transition.opacity="" class="fixed inset-0 z-[124] bg-slate-900/60 flex items-center justify-center p-4" style="display: none;">
                <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-5 text-slate-800">
                    <div class="font-semibold text-lg mb-0.5" x-text="(_afDocRemarkItem &amp;&amp; _afDocRemarkItem.remark) ? 'Edit remark' : 'Add remark'">Add remark</div>
                    <div class="text-xs text-slate-500 mb-3">Free text, saved to the document's remark.</div>
                    <textarea x-model="afDocRemarkText" maxlength="255" rows="3" placeholder="Type a remark…" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                    <div class="text-[11px] text-slate-400 text-right mt-1"><span x-text="(afDocRemarkText || '').length">0</span>/255</div>
                    <div class="flex justify-end gap-2 mt-3">
                        <button type="button" @click="afCloseDocRemark()" :disabled="afDocRemarkSaving" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-lg text-sm disabled:opacity-40">Cancel</button>
                        <button type="button" @click="afSaveDocRemark()" :disabled="afDocRemarkSaving" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg text-sm font-semibold inline-flex items-center gap-2 disabled:opacity-50">
                            <svg x-show="afDocRemarkSaving" class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
                            <span x-text="afDocRemarkSaving ? 'Saving…' : 'Save'">Save</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- IPD PAGE TEMPLATES — opened from the Settings-drawer item        -->
        <!-- (p_id 92). Same shape as the Audit & Feedback window: a right    -->
        <!-- drawer listing every IPD page category, and the main area        -->
        <!-- showing that category's SAVED TEMPLATE PAGES as a grid.          -->
        <!-- ============================================================ -->
        <div x-show="tplOpen" x-transition.opacity="" @keydown.escape.window="tplRemarkOpen ? tplCloseRemark() : (tplExitConfirmOpen ? (tplExitConfirmOpen = false) : (tplExitOpen ? (tplExitOpen = false) : (tplDeleteConfirmOpen ? (tplDeleteConfirmOpen = false) : (tplView === 'edit' ? tplCancelEdit() : (tplView === 'detail' ? tplHome() : (tplView === 'recycle' ? tplExitRecycle() : (tplRightOpen ? (tplRightOpen = false) : tplConfirmExit())))))))" class="fixed inset-0 z-[99] bg-slate-100 flex flex-col" style="display:none">
            <!-- Header — back, title/active category, drawer toggle.
                 Hidden while the canvas editor is open (the editor has its own
                 toolbar), exactly like the Register Book window. -->
            <div x-show="tplView !== 'edit'" class="relative shrink-0 flex items-center gap-1.5 px-3 py-3 text-white shadow" style="background-color:#67C2FF;">
                <!-- Back — confirms before leaving the Templates section (and
                     settles unsaved editor strokes first). -->
                <button type="button" @click="tplConfirmExit()" class="p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-left" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
                </button>
                <!-- Home — only in the page viewer; returns to the templates grid. -->
                <button type="button" x-show="tplView === 'detail'" @click="tplHome()" class="p-1.5 rounded hover:bg-white/15 shrink-0" title="Home" aria-label="Home" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="home" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-home"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                </button>
                <!-- In the viewer the title is capped so it truncates well before
                     the absolutely-centred Open · n/n · Add cluster. -->
                <div class="flex-1 min-w-0" :class="tplView === 'detail' ? 'max-w-[38%]' : ''">
                    <div class="font-semibold text-base truncate" x-text="tplActiveCat ? tplActiveCat.label : 'IPD Page Templates'">IPD Page Templates</div>
                    <div class="text-[11px] text-white/70 truncate" x-text="tplActiveCat ? 'Saved template pages' : 'Choose a category'">Choose a category</div>
                </div>

                <!-- GRID: count + "new template" (icon-only add). Hidden in the
                     recycle bin, which has its own header row. -->
                <template x-if="tplView === 'grid'"></template><div class="flex items-center gap-2 shrink-0">
                        <span x-show="tplActiveCat &amp;&amp; !tplLoading &amp;&amp; !tplError" class="text-sm font-semibold whitespace-nowrap px-1" x-text="tplPages.length + ' template' + (tplPages.length === 1 ? '' : 's')" style="display: none;">0 templates</span>
                        <button type="button" x-show="tplActiveCat &amp;&amp; !tplLoading" @click="tplNew()" class="w-9 h-9 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shrink-0" title="New template" aria-label="New template" style="display: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="plus" aria-hidden="true" style="width:18px;height:18px;display:block;" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                        </button>
                    </div>

                <!-- VIEWER cluster: Open · n/n · Add — absolutely CENTRED, exactly
                     like the Register Book page viewer. Navigation is by SWIPE. -->
                <template x-if="tplView === 'detail'"></template>
                <!-- Right drawer (category selector) — the only right-side icon. -->
                <button type="button" @click="tplRightOpen = !tplRightOpen" class="relative ml-auto p-1.5 rounded hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white/40 shrink-0" aria-label="Categories">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layers" aria-hidden="true" style="width:22px;height:22px;display:block;" class="lucide lucide-layers"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>
                </button>
            </div>

            <!-- Header (EDIT mode) — editing tools in the app bar, like the
                 Register Book editor. Save / Cancel end the edit. -->
            <div x-show="tplView === 'edit'" class="shrink-0 bg-slate-50 border-b border-slate-200 text-slate-600 shadow-sm relative z-30" style="display: none;">
                <div class="flex flex-wrap items-center justify-center gap-1.5 px-2 py-2">
                    <!-- Pen -->
                    <div class="relative shrink-0">
                        <button type="button" @click="tplToolTap('pen')" :class="tplTool === 'pen' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center bg-slate-800 text-white" title="Pen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="pen-line" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-pen-line"><path d="M13 21h8"></path><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path></svg>
                        </button>
                        <div x-show="tplPenOpen" @click.outside="tplPenOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Pen size <span x-text="tplPenSize">2</span></div>
                            <input type="range" min="1" max="20" x-model.number="tplPenSize" class="w-full">
                        </div>
                    </div>
                    <!-- Eraser -->
                    <div class="relative shrink-0">
                        <button type="button" @click="tplToolTap('eraser')" :class="tplTool === 'eraser' ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Eraser">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="eraser" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-eraser"><path d="M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21"></path><path d="m5.082 11.09 8.828 8.828"></path></svg>
                        </button>
                        <div x-show="tplEraserOpen" @click.outside="tplEraserOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 w-44" style="display: none;">
                            <div class="text-xs text-slate-500 mb-1">Eraser size <span x-text="tplEraserSize">24</span></div>
                            <input type="range" min="6" max="80" x-model.number="tplEraserSize" class="w-full">
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Undo / Redo -->
                    <button type="button" @click="tplUndo()" :disabled="!tplCanUndo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Undo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="undo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-undo-2"><path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path></svg></button>
                    <button type="button" @click="tplRedo()" :disabled="!tplCanRedo" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600 disabled:opacity-30 shrink-0" title="Redo" disabled="disabled"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="redo-2" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-redo-2"><path d="m15 14 5-5-5-5"></path><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5A5.5 5.5 0 0 0 9.5 20H13"></path></svg></button>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Colour -->
                    <div class="relative shrink-0">
                        <button type="button" @click="tplColorOpen=!tplColorOpen" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Colour">
                            <span class="w-5 h-5 rounded-full border-2 border-slate-300" :style="'background-color:' + tplColor" style="background-color:#0000FF"></span>
                        </button>
                        <div x-show="tplColorOpen" @click.outside="tplColorOpen=false" class="absolute top-full mt-1 left-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg p-3 grid grid-cols-4 gap-2 w-44" style="display: none;">
                            <template x-for="col in rbPalette" :key="col"></template><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#0000FF; border-color:#0f172a"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#111827; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#dc2626; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#16a34a; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#ec4899; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#eab308; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#8b4513; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#f97316; border-color:transparent"></button><button type="button" @click="tplColor = col; tplColorOpen = false" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (tplColor===col ? '#0f172a' : 'transparent')" style="background-color:#7c3aed; border-color:transparent"></button>
                            <input type="color" x-model="tplColor" class="col-span-4 w-full h-8 mt-1 rounded border border-slate-200">
                        </div>
                    </div>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- SAVE -->
                    <button type="button" @click="tplSave()" :disabled="tplSaving" class="mx-2 inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-emerald-500 text-white text-sm font-semibold hover:bg-emerald-600 disabled:opacity-60 shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="save" aria-hidden="true" style="width:15px;height:15px;display:block;" class="lucide lucide-save"><path d="M15.2 3a2 2 0 0 1 1.4.6l3.8 3.8a2 2 0 0 1 .6 1.4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"></path><path d="M17 21v-7a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v7"></path><path d="M7 3v4a1 1 0 0 0 1 1h7"></path></svg>
                        <span x-text="tplSaving ? 'Saving…' : 'Save'">Save</span>
                    </button>
                    <span class="text-xs font-medium text-slate-500 px-1 whitespace-nowrap shrink-0" x-text="tplEditingId != null ? 'Editing' : 'New template'">New template</span>
                    <div class="w-px h-6 bg-slate-300 mx-1 shrink-0"></div>
                    <!-- Zoom lock -->
                    <button type="button" @click="tplToggleLock()" :class="tplLocked ? 'hover:bg-slate-200 text-slate-600' : 'bg-amber-500 text-white'" class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 hover:bg-slate-200 text-slate-600" :title="tplLocked ? 'Zoom locked (tap to enable pinch-zoom)' : 'Zoom enabled (tap to lock for drawing)'" title="Zoom locked (tap to enable pinch-zoom)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="lock" aria-hidden="true" x-show="tplLocked" style="width: 19px; height: 19px;" class="lucide lucide-lock"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="move" aria-hidden="true" x-show="!tplLocked" style="width: 19px; height: 19px; display: none;" class="lucide lucide-move"><path d="M12 2v20"></path><path d="m15 19-3 3-3-3"></path><path d="m19 9 3 3-3 3"></path><path d="M2 12h20"></path><path d="m5 9-3 3 3 3"></path><path d="m9 5 3-3 3 3"></path></svg>
                    </button>
                    <!-- ADD IMAGE — camera / gallery / stamps, same flow as the IPD
                         editor: the picked item becomes a movable, pinch-scalable
                         overlay painted onto the page only when you tap Place.
                         Sits right after the lock toggle. The popover opens to the
                         RIGHT edge (right-0, like IPD's gallery menu) because the
                         button is near the end of the toolbar row. -->
                    <div class="relative shrink-0">
                        <button type="button" @click="tplGalleryOpen=!tplGalleryOpen; tplColorOpen=false; tplPenOpen=false; tplEraserOpen=false" :class="tplGalleryOpen ? 'bg-slate-800 text-white' : 'hover:bg-slate-200 text-slate-600'" class="w-9 h-9 rounded-lg flex items-center justify-center hover:bg-slate-200 text-slate-600" title="Add image">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="image" aria-hidden="true" style="width:19px;height:19px;display:block;" class="lucide lucide-image"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                        </button>
                        <div x-show="tplGalleryOpen" @click.outside="tplGalleryOpen=false" class="absolute top-full mt-1 right-0 z-40 bg-white text-slate-700 border border-slate-200 rounded-lg shadow-lg py-2 w-64 max-h-[70vh] overflow-auto" style="display: none;">
                            <div class="px-3 pt-1 pb-2">
                                <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1.5">Add image</div>
                                <div class="grid grid-cols-2 gap-1.5">
                                    <button type="button" @click="tplCaptureCamera()" class="flex items-center justify-center gap-1.5 px-2 py-2 rounded bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="camera" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-camera"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"></path><circle cx="12" cy="13" r="3"></circle></svg><span>Camera</span></button>
                                    <button type="button" @click="tplPickImage()" class="flex items-center justify-center gap-1.5 px-2 py-2 rounded bg-slate-50 hover:bg-slate-100 text-slate-700 text-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="image" aria-hidden="true" style="width:16px;height:16px;display:block;" class="lucide lucide-image"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg><span>Gallery</span></button>
                                </div>
                                <!-- Doc Scanner — Auto/Manual capture, page crop and
                                     brightness correction, straight into placement. -->
                                <button type="button" @click="tplGalleryOpen=false; openScanner('tpl')" class="mt-1.5 w-full flex items-center justify-center gap-1.5 px-2 py-2 rounded bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-sm font-medium">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><line x1="7" y1="12" x2="17" y2="12"></line></svg>
                                    <span>Doc Scanner</span>
                                </button>
                            </div>
                            <div class="border-t border-slate-100 my-1"></div>
                            <!-- Stamps — the SHARED stamp list, searchable, same as the
                                 IPD / Register Book menus. The list stays visible for
                                 everyone; choosing one without the Use-stamps grant
                                 (p_id 85) is refused with a toast in tplPlaceStamp. -->
                            <div class="px-3 pt-1 pb-1 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Stamps</div>
                            <template x-if="stamps.length &gt; 0"></template><div class="px-3 pb-1.5">
                                    <div class="relative">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="search" aria-hidden="true" style="width:14px;height:14px;color:#94a3b8;display:block;position:absolute;left:8px;top:50%;transform:translateY(-50%);" class="lucide lucide-search"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
                                        <input type="text" x-model="stampSearch" placeholder="Search stamps…" @click.stop="" class="w-full pl-7 pr-7 py-1.5 text-sm rounded-md border border-slate-200 focus:outline-none focus:ring-2 focus:ring-teal-200 focus:border-teal-300">
                                        <button type="button" x-show="stampSearch" @click="stampSearch = ''" class="absolute right-1.5 top-1/2 -translate-y-1/2 p-0.5 rounded text-slate-400 hover:text-slate-600" title="Clear" style="display: none;"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="x" aria-hidden="true" style="width:14px;height:14px;display:block;" class="lucide lucide-x"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button>
                                    </div>
                                </div>
                            <template x-if="stampsLoading &amp;&amp; stamps.length === 0"></template>
                            <template x-if="!stampsLoading &amp;&amp; stamps.length === 0"></template>
                            <template x-if="stamps.length &gt; 0 &amp;&amp; filteredStamps().length === 0"></template>
                            <template x-for="s in filteredStamps()" :key="s.id"></template><button type="button" @click="tplPlaceStamp(s)" class="w-full text-left px-3 py-2 flex items-center gap-2.5 hover:bg-slate-50 text-sm text-slate-700">
                                    <span class="inline-flex items-center justify-center w-9 h-7 rounded bg-slate-50 border border-slate-200 overflow-hidden shrink-0">
                                        <img x-show="s.thumbUrl" :src="s.thumbUrl" alt="" draggable="false" class="max-w-full max-h-full object-contain" src="blob:https://prescoipd.com/1f86b36f-a6f2-413d-a7cd-caffedcf9fc2" style="">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="stamp" aria-hidden="true" x-show="!s.thumbUrl" style="width: 14px; height: 14px; color: rgb(148, 163, 184); display: none;" class="lucide lucide-stamp"><path d="M14 13V8.5C14 7 15 7 15 5a3 3 0 0 0-6 0c0 2 1 2 1 3.5V13"></path><path d="M20 15.5a2.5 2.5 0 0 0-2.5-2.5h-11A2.5 2.5 0 0 0 4 15.5V17a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1z"></path><path d="M5 22h14"></path></svg>
                                    </span>
                                    <span class="flex-1 truncate" :title="s.name" x-text="s.name" title="Allergic">Allergic</span>
                                </button><button type="button" @click="tplPlaceStamp(s)" class="w-full text-left px-3 py-2 flex items-center gap-2.5 hover:bg-slate-50 text-sm text-slate-700">
