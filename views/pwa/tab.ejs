            1999: { share: 'share_cardiology', del: 'del_cardiology', label: 'Cardiology Reports' },
            1994: { share: 'share_lab',        del: 'del_lab',        label: 'Laboratory Reports' },
            1998: { share: 'share_radiology',  del: 'del_radiology',  label: 'Radiology Reports' },
            1993: { share: 'share_other',      del: 'del_other',      label: 'Other Documents' },
            1991: { share: 'share_av',         del: 'del_av',         label: 'Audio & Video Records' },
