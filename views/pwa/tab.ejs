                                            <span x-show="p.ipd" class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 bg-slate-100 text-slate-600 border-slate-200" :class="isFlagged(p) ? 'bg-red-50 text-red-700 border-red-200' : 'bg-slate-100 text-slate-600 border-slate-200'">
                                                <span class="font-medium text-slate-500" :class="isFlagged(p) ? 'text-red-500' : 'text-slate-500'">IPD No.</span>
                                                <span class="font-semibold" x-text="p.ipd">IP/2026-2027/1597</span>
                                            </span>
                                            <span x-show="p.uhid" class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 bg-slate-100 text-slate-600 border-slate-200" :class="isFlagged(p) ? 'bg-red-50 text-red-700 border-red-200' : 'bg-slate-100 text-slate-600 border-slate-200'">
                                                <span class="font-medium text-slate-500" :class="isFlagged(p) ? 'text-red-500' : 'text-slate-500'">UHID No.</span>
                                                <span class="font-semibold" x-text="p.uhid">AS48095</span>
                                            </span>
                                        </div>

                                        <!-- MLC badge (red highlighter) + admission
                                             reason. The Floor / Department / Bed
                                             details that used to sit here now render
                                             below the consultant (plain, no box). -->
                                        <div class="mt-1 flex items-start gap-1.5 text-[11px]" x-show="p.mlc || p.admission_reason" style="display: none;">
                                            <span x-show="p.mlc" class="flex-none inline-flex items-center rounded-md bg-red-600 text-white text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">MLC</span>
                                            <span x-show="p.admission_reason" class="min-w-0 truncate rounded-full border border-orange-200 bg-orange-50 px-2 py-0.5 font-medium text-orange-700" x-text="p.admission_reason" style="display: none;"></span>
                                        </div>

                                        <!-- Clinical-flag badges: AL = allergic,
                                             UP = universal precaution. (MLC sits
                                             on the floor-details row above.) -->
                                        <div class="mt-1 flex flex-wrap items-center gap-1.5" x-show="p.allergic || p.precautive" style="display: none;">
                                            <span x-show="p.allergic" title="Allergic" class="inline-flex items-center rounded-md bg-amber-100 text-amber-800 border border-amber-300 text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">AL</span>
                                            <span x-show="p.precautive" title="Universal Precaution" class="inline-flex items-center rounded-md bg-violet-100 text-violet-800 border border-violet-300 text-[10px] font-bold px-1.5 py-0.5 tracking-wide" style="display: none;">UP</span>
                                        </div>

                                        <!-- Consulting doctor (next line) —
                                             name only, no label, no "Dr." prefix.
