                    // this patient (tbl_category_blocked_for_patient.status = 1,
                    // surfaced as cat.isLocked). Edits of an existing page
                    // (editingRecordId set) are governed by the per-page lock,
                    // so they don't trip this guard.
                    if (!opts.editingRecordId) {
                        const _target = this._resolveEditCategory(opts);
                        const _catObj = (this.categories || []).find(c => c && c.id === _target.id);
                        if (_catObj && _catObj.isLocked) {
                            this.showToast('You cannot add page in Locked Category.', 'error');
                            return;
                        }
                    }
                    this.viewerMode = 'edit';
                    // Reset toolbar state for the new entry.
                    this.editTool = 'pen';
                    this.editColor = this.palette[0];
                    // Default to LOCKED so the user can rest a palm and
                    // immediately draw without accidental zoom. Tap the
                    // lock icon to unlock for pinch-to-zoom.
                    this.editLocked = true;
                    this._undoStack = [];
                    this._redoStack = [];
                    // Never carry a half-written ink phrase into a new page (the
                    // Ink → Text mode itself stays as the user left it).
                    this._inkReset();
                    // Reset transform on every new entry.
                    this.zoom = 1; this.panX = 0; this.panY = 0;
                    this._touches.clear();
                    this._pinchStart = null;
                    this._pinchActive = false;
                    // Never carry a stale pending placement into a fresh editor —
                    // any uncommitted image/addressograph/stamp from a prior
                    // session is discarded on entry.
                    if (this._placing) this._cancelPlacement();
                    // Optional: queue a clipboard payload to paint onto the
                    // newly added page once the canvas finishes initialising.
                    //   opts.paste          = dataURL (full-page paste)
                    //   opts.pasteSelection = { dataUrl, w, h } (region paste)
                    //   opts.editingRecordId = id of the record being edited
                    //                          (Save updates in place; the
                    //                          Delete button is exposed.)
                    this._pendingPaste = opts.paste || null;
                    this._pendingSelectionPaste = opts.pasteSelection || null;
                    this._editingRecordId = opts.editingRecordId || null;
                    // Resolve the target category (handles the All view) — its id
                    // drives the save endpoint, its bgUrl the canvas backdrop.
                    const _editCat = this._resolveEditCategory(opts);
                    this._editCatId = _editCat.id;
                    // Page orientation/rotation for this category (looked up from the
                    // loaded category list; falls back to the open viewerCategory).
                    // Drives the initial rotation of placed items — see
                    // _placementInitialRot().
                    const _catObj = (this.categories || []).find(c => c && c.id === this._editCatId)
                                    || this.viewerCategory || {};
                    this._editCatOrientation = Number(_catObj.orientation || 0);
                    this._editCatRotation    = Number(_catObj.rotation || 0);
                    this.bgImageUrl   = _editCat.bgUrl || '';
                    this.bgNaturalW   = this._DEFAULT_W;
                    this.bgNaturalH   = this._DEFAULT_H;
                    // Re-arm the one-shot bg refresh for this edit session — see
                    // onBgImageError. A category opened >10 min after the drawer
                    // loaded has an expired presigned bgUrl; the error path mints
                    // a fresh one and retries before falling back to ruled paper.
                    this._editBgRetried = false;
                    this.$nextTick(() => {
                        window.lucide && window.lucide.createIcons();
                        this.initCanvas();
                        // Explicitly clear the canvas pixel buffer. initCanvas
                        // only resets when the dimensions change, so opening
                        // a fresh New-entry session on the same category as
                        // before would otherwise leave the previous strokes
                        // visible. clearRect runs regardless of dimensions.
                        this._clearCanvas();
                        // Paint the queued clipboard payload (if any) after the
                        // canvas is sized so the restore lands at the right
                        // resolution. Snapshot the "starting state" once the
                        // initial paint is complete so Reset can return here.
                        if (this._pendingPaste) {
                            const url = this._pendingPaste;
                            this._pendingPaste = null;
                            requestAnimationFrame(() =>
                                this._restoreFromDataUrl(url, () => this._takeInitialSnapshot()));
                        } else if (this._pendingSelectionPaste) {
                            const clip = this._pendingSelectionPaste;
                            this._pendingSelectionPaste = null;
                            // Blank canvas IS the starting state; the selection is
                            // then placed interactively (drag → Place) on top.
                            this._takeInitialSnapshot();
                            requestAnimationFrame(() => this._beginSelectionPlacement(clip));
                        } else {
                            // Blank starting canvas — snapshot it directly.
                            this._takeInitialSnapshot();
                        }
                    });
                },

                _takeInitialSnapshot() {
                    const canvas = this.$refs.penCanvas;
                    // These pixels become the new baseline, so the mutation count
                    // starts over — the ONLY place it is allowed to reset.
                    this._editMutations = 0;
                    if (!canvas) { this._initialSnapshot = null; return; }
                    try { this._initialSnapshot = canvas.toDataURL('image/png'); }
                    catch (_) { this._initialSnapshot = null; }
                },

                // Wipe the canvas pixel buffer + reset the undo/redo history.
                // Used after Save (so the next Save is a fresh new page), on
                // Discard (defensive — startEdit clears anyway, but covers
                // any path that re-enters edit mode without going through it),
                // and inside startEdit() so re-opening Edit on the same
                // category doesn't show the previous session's strokes.
                _clearCanvas() {
                    const canvas = this.$refs.penCanvas;
                    if (!canvas) return;
                    if (!this._ctx) this._ctx = canvas.getContext('2d');
                    this._ctx.clearRect(0, 0, canvas.width, canvas.height);
                    // Wiping IS a mutation relative to _initialSnapshot (which is
                    // not retaken here), so count it rather than reset — that
                    // keeps the exact-compare behaviour this path had before.
                    this._editMutations++;
                    this._undoStack = [];
                    this._redoStack = [];
                    this._inkReset();
                },

                // Fired when the background <img> finishes loading. Per spec:
                // "if category image dimensions are greater than 1536 x 1968,
                // apply the image in its ORIGINAL size on the canvas." So when
                // the native image exceeds the default in EITHER dimension we
                // adopt its exact native W x H (NOT a per-axis max — that would
                // skew the page aspect and misalign strokes / letterbox the
                // artwork). The page still fits the screen via the CSS
                // max-width/height clamps; only the backing-store resolution
                // changes. Smaller images keep the default 1536 x 1968 page.
                onBgImageLoaded(e) {
                    const img = e.target;
                    const w = img.naturalWidth  || this._DEFAULT_W;
                    const h = img.naturalHeight || this._DEFAULT_H;
                    if (w > this._DEFAULT_W || h > this._DEFAULT_H) {
                        this.bgNaturalW = w;
                        this.bgNaturalH = h;
                    } else {
                        this.bgNaturalW = this._DEFAULT_W;
                        this.bgNaturalH = this._DEFAULT_H;
                    }
                    this.$nextTick(() => this.initCanvas());
                },

                // Fetch a fresh presigned bgUrl for one category. The /categories
                // list presigns bgUrls once at drawer load; those die after 10
                // min (S3PresignedUrlService default). Returns '' on any failure.
                async fetchFreshCategoryBgUrl(catId) {
                    if (!catId) return '';
                    try {
                        const resp = await fetch('./api/categories/' + encodeURIComponent(catId) + '/image-url', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (!resp.ok) return '';
                        const data = await resp.json();
                        return (data && data.bgUrl) || '';
                    } catch (_) {
                        return '';
                    }
                },

                // Edit-canvas background <img> failed to load — almost always an
                // expired presigned URL (the drawer presigns once, 10-min TTL).
                // Mint a fresh URL and retry ONCE; if that still fails, clear
                // bgImageUrl so the ruled-paper fallback shows instead of a blank
                // white canvas the user can't orient on. The retry guard is
                // re-armed per edit session in startEdit, so a later (re-expired)
                // session gets its own retry.
                async onBgImageError(e) {
                    if (this._editBgRetried) { this.bgImageUrl = ''; return; }
                    this._editBgRetried = true;
                    // Use the EDIT session's category (handles the All view, where
                    // viewerCategory has no id — the page's own category is used).
                    const catId = this._editCatId;
                    const fresh = (this.categoriesLive && catId)
                        ? await this.fetchFreshCategoryBgUrl(catId)
                        : '';
                    if (fresh) {
                        this.bgImageUrl = fresh;
                        // Refresh the cached category's bgUrl so grid/detail
                        // backdrops for it reuse the fresh URL.
                        const c = this.categories.find(cc => cc.id === catId);
                        if (c) c.bgUrl = fresh;
                    } else {
                        this.bgImageUrl = '';
                    }
                },

                // Grid/detail backdrop <img> failed — refresh the cached bgUrl
                // once per open (re-armed in openCategory). Same 10-min expiry
                // cause as onBgImageError; here a blank backdrop is cosmetic
                // (saved pages render on top), so there's no ruled-paper fallback.
                async onViewerBgError(e) {
                    if (this._viewerBgRetried || !this.categoriesLive) return;
                    this._viewerBgRetried = true;
                    const cat = this.viewerCategory;
                    if (!cat || !cat.id) return;
                    const fresh = await this.fetchFreshCategoryBgUrl(cat.id);
                    if (fresh) cat.bgUrl = fresh;
                },

                // Discards the in-progress page and returns to the grid.
                // If the user hasn't made any changes since opening this
                // edit session (canvas matches the initial snapshot, or
                // canvas is blank), skip the confirmation — there's nothing
                // to lose. Otherwise open the confirmation modal.
                cancelEdit() {
                    if (this._isCanvasBlank() || this._isCanvasUnchanged()) {
                        this._discardEdit();
                    } else {
                        this.confirmDiscardOpen = true;
                    }
                },

                confirmDiscard() {
                    this.confirmDiscardOpen = false;
                    this._discardEdit();
                },

                // ── Unsaved-edit exit guard ─────────────────────────────────
                // True when the canvas editor is open AND has un-saved strokes.
                _hasUnsavedEdits() {
                    if (this.viewerMode !== 'edit') return false;
                    return !this._isCanvasUnchanged();
                },
                // Wrap any navigation that would leave the editor. If there are
                // unsaved changes, stash the action and pop the Save/Discard
                // dialog (returns true = intercepted, caller should bail). Returns
                // false when it's safe to proceed (no edits, or we're already
                // running the user's chosen action).
                _guardEditExit(action) {
                    if (this._skipEditGuard) return false;
                    if (!this._hasUnsavedEdits()) return false;
                    this._pendingExitAction = action;
                    this.confirmExitOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    return true;
                },
                // Run the stashed navigation, bypassing the guard so it doesn't
                // re-trigger on itself.
                _runPendingExit() {
                    const action = this._pendingExitAction;
                    this._pendingExitAction = null;
                    if (!action) return;
                    this._skipEditGuard = true;
                    try { action(); } finally { this._skipEditGuard = false; }
                },
                // Dialog: Save page → then continue. saveEdit() updates the
                // snapshot so the edit is no longer "dirty".
                async confirmExitSave() {
                    this.confirmExitOpen = false;
                    try { await this.saveEdit(); } catch (_) {}
                    this._runPendingExit();
                },
                // Dialog: Discard changes → drop the canvas, then continue.
                confirmExitDiscard() {
                    this.confirmExitOpen = false;
                    this._discardEdit();
                    this._runPendingExit();
                },
                // Dialog: Keep editing → cancel the navigation.
                confirmExitCancel() {
                    this.confirmExitOpen = false;
                    this._pendingExitAction = null;
                },

                _discardEdit() {
                    // Drop any pending placement (image / addressograph / stamp /
                    // QR / barcode / thumb impression) that was never committed —
                    // exiting the editor discards it so it can't bleed into the
                    // next edit session. Revokes the object URL too.
                    if (this._placing) this._cancelPlacement();
                    // Wipe the canvas so the next time the user enters edit
                    // mode (e.g. via "New entry" after a discard) starts from
                    // a clean buffer. startEdit() also clears, so this is
                    // defensive — covers any future path that re-enters edit
                    // without going through the standard initialiser.
                    this._clearCanvas();
                    // If we were editing an existing record, return to the
                    // slider showing that record. Otherwise drop back to grid.
                    if (this._editingRecordId) {
                        const idx = this.viewerRecords.findIndex(r => r.id === this._editingRecordId);
                        this._editingRecordId = null;
                        if (idx >= 0) {
                            this._showDetailAt(idx);
                            return;
                        }
                    }
                    this.backToGrid();
                },

                // ── Lock a category for the selected patient ──
                openLockConfirm(cat) {
                    if (!cat || cat.isLocked) return;
                    // Category lock is gated by the per-user application-tool
                    // right (other_permissions p_id = 95 / roles 1,2,10). The
                    // server re-checks too; this just gives immediate feedback.
                    if (!this.me.can_lock_category) { this.showToast('You have not authority to Lock Category Form.', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    this.lockTarget = cat;
                    this.lockAction = 'lock';
                    this.lockConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                openUnlockConfirm(cat) {
                    if (!cat || !cat.isLocked) return;
                    // Category unlock is gated by the per-user application-tool
                    // right (other_permissions p_id = 37 / roles 1,2,10). The
                    // server re-checks too; this just gives immediate feedback.
                    if (!this.me.can_unlock_category) { this.showToast('You have not authority to Unlock Category Form.', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    this.lockTarget = cat;
                    this.lockAction = 'unlock';
                    this.lockConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
