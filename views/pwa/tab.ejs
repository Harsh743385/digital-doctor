        const DOC_UPLOAD_CATEGORIES = {
            'Other Documents':    { catId: 1993, countKey: 'other',      color: '#0d9488' },
            'Laboratory Reports': { catId: 1994, countKey: 'lab',        color: '#2563eb' },
            'Radiology Report':   { catId: 1998, countKey: 'radiology',  color: '#db2777' },
            'Cardiology Report':  { catId: 1999, countKey: 'cardiology', color: '#9333ea' },
            'Bill Records':       { catId: 1997, countKey: 'bill',       color: '#d97706' },
            'Audio Records':      { catId: 1991, countKey: 'audio',      color: '#7c3aed', kind: 'audio' },
