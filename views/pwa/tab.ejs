<!DOCTYPE html>
<!-- saved from url=(0036)https://prescoipd.com/v1/ipd/pwa/ipd -->
<html lang="en-IN"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#67C2FF">
    <meta name="description" content="Presco Tab — Bedside EMR PWA">
    <title>Presco Tab</title>

    <!-- PWA manifest + iOS / Android shortcuts -->
    <link rel="manifest" href="https://prescoipd.com/v1/ipd/pwa/manifest.webmanifest">
    <link rel="icon" type="image/png" sizes="192x192" href="https://prescoipd.com/v1/ipd/pwa/icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="https://prescoipd.com/v1/ipd/pwa/icons/icon-512.png">
    <link rel="apple-touch-icon" sizes="192x192" href="https://prescoipd.com/v1/ipd/pwa/icons/icon-192.png">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Presco Tab">

    <!--
        Standalone Tablet PWA shell.

        - Right drawer: Forms browser (patient banner, bins, search, tabs,
          27 color-coded category rows with counts) per spec screenshot.
        - Tap a category -> viewer overlay opens with patient banner + a
          form page card (category color stripe + ruled paper).

        No backend wiring — pages render in demo mode. When this is
        deployed on a server (same origin as the IPD app), swap the
        `loadDemoPage()` call in `openCategory()` for a real fetch to
        /cms/ajax/bulk-page-view-data and render the returned HTML.
    -->

    <script src="https://cdn.tailwindcss.com/"></script>
    <script src="https://cdn.jsdelivr.net/npm/lucide@latest/dist/umd/lucide.min.js"></script>
    <!-- QR + barcode encoders for the addressograph codes (global `qrcode` /
         `JsBarcode`). Pinned + precached by sw.js so codes generate offline. -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <!-- lamejs — client-side MP3 encoder (audio recordings are transcoded to MP3) -->
    <script src="https://cdn.jsdelivr.net/npm/lamejs@1.2.1/lame.min.js"></script>
    <!-- PDF.js — render PDFs inline (mobile iframes don't render PDFs natively) -->
    <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
    <script defer="" src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }
        /* Register-book detail viewpager — swipe slider, no visible scrollbar. */
        .rb-slider { scrollbar-width: none; -ms-overflow-style: none; }
        .rb-slider::-webkit-scrollbar { display: none; }
        .af-slider { scrollbar-width: none; -ms-overflow-style: none; }
        .af-slider::-webkit-scrollbar { display: none; }
        /* Eye viewer: a PDF leaf is drawn by PDF.js into a canvas whose pixel size
           is fixed at render time, so it would ignore the zoom layer's width. Make
           it fill that width instead (aspect preserved) — the leaf is then
           re-rendered at the new size shortly after, so it sharpens up. */
        #eyeLeafBox canvas { width: 100%; height: auto; }
        /* Pre-mount background matches the app's idle gradient so there's no
           white flash before Alpine renders (the boot splash was removed). */
        html, body { height: 100%; margin: 0;
            background-image:
                radial-gradient(circle at 50% 44%, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 58%),
                linear-gradient(135deg, #67C2FF 0%, #BFE4FF 50%, #67C2FF 100%); }
        /* Suppress the native long-press menu (Download / Share / Print) on
           page + document thumbnails and previews. */
        img {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
        }
        /* Canvas patient-details strip — smoky translucent glass; recolour the
           (otherwise dark) text to light so it reads over the form. Scoped to
           this strip only, so the page-viewer banner is unaffected. */
        .canvas-pt-strip .text-slate-900,
        .canvas-pt-strip .text-slate-800 { color: #ffffff !important; }
        .canvas-pt-strip .text-slate-500,
        .canvas-pt-strip .text-slate-400 { color: #cbd5e1 !important; }
        /* Lock the page itself — only inner panes (patient list, viewer)
           scroll. Prevents the whole shell from bouncing/scrolling. */
        body { font-family: system-ui, -apple-system, "Source Sans Pro", sans-serif; -webkit-text-size-adjust: 100%; overscroll-behavior: none; overflow: hidden; }
        /* Full-viewport app shell. `100dvh` tracks the *dynamic* viewport so
           the layout fits exactly under mobile browser chrome (URL bar) on
           every resolution; `100vh` is the fallback for engines without dvh.
           overflow:hidden keeps the main screen itself non-scrollable. */
        .app-shell { height: 100vh; height: 100dvh; overflow: hidden; }
        /* Print the open PDF only: when printPdf() adds this class to <body>,
           hide everything except the rendered PDF canvases so the toolbar / app
           chrome never lands on paper. Each page on its own sheet. */
        @media print {
            body.printing-pdf * { visibility: hidden !important; }
            body.printing-pdf #pdfViewerBox,
            body.printing-pdf #pdfViewerBox * { visibility: visible !important; }
            body.printing-pdf #pdfViewerBox {
                position: fixed !important; inset: 0 !important;
                margin: 0 !important; padding: 0 !important;
                overflow: visible !important; background: #fff !important;
                display: block !important;
            }
            body.printing-pdf #pdfViewerBox canvas {
                box-shadow: none !important; display: block;
                width: 100% !important; height: auto !important;
                page-break-after: always;
            }
            /* Same, for the in-flow web pane's PDF (Discharge Summary preview). */
            body.printing-webpdf * { visibility: hidden !important; }
            body.printing-webpdf #webPdfBox,
            body.printing-webpdf #webPdfBox * { visibility: visible !important; }
            body.printing-webpdf #webPdfBox {
                position: fixed !important; inset: 0 !important;
                margin: 0 !important; padding: 0 !important;
                overflow: visible !important; background: #fff !important;
                display: block !important;
            }
            body.printing-webpdf #webPdfBox canvas {
                box-shadow: none !important; display: block;
                width: 100% !important; height: auto !important;
                page-break-after: always;
            }
        }
        /* Ruled-paper background for the demo form page card. */
        .form-paper {
            background-color: #fffefb;
            background-image: repeating-linear-gradient(
                to bottom,
                transparent 0,
                transparent 31px,
                #d4d4d8 31px,
                #d4d4d8 32px
            );
            background-position: 0 56px;
        }
        /* Edit-mode page box: FILLS the whole canvas area (X and Y) below the
           app bar — the category image is stretched to fit the screen. The
           underlying canvas keeps its native resolution; stroke mapping uses
           separate sx/sy so the non-uniform stretch stays aligned. */
        .canvas-page {
            width: 100%;
            height: 100%;
            position: relative;
            background: white;
        }
        /* ── IPD edit app bar: ONE LINE, ALWAYS ──────────────────────────────
           ~19 controls have to sit on a single row at tablet widths. Wrapping
           pushed icons onto a second line and stole canvas height.

           Done in CSS rather than by editing Tailwind classes on each button so
           the change is scoped to THIS bar — the Register Book, Audit & Feedback
           and Template editors have their own toolbars that must keep wrapping.

           The row SCROLLS horizontally rather than wrapping, so every control
           stays reachable at any width and none is ever squeezed.

           That is only safe because the popovers (pen size, eraser size,
           colour, ink language, gallery, copy, paste) are position:fixed —
           see .appbar-pop below. As absolutely-positioned children they would
           be clipped, since overflow-x:auto forces overflow-y to auto too. */
        .edit-appbar,
        .edit-appbar > div {
            flex-wrap: nowrap;
        }
        .edit-appbar {
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;              /* Firefox */
        }
        .edit-appbar::-webkit-scrollbar { display: none; }   /* Chrome/WebView */
        /* Nothing in the row may be squeezed or pushed down. */
        .edit-appbar > *,
        .edit-appbar > div > *,
        .edit-appbar > div > div > * {
            flex-shrink: 0;
        }
        /* Popovers opened FROM the app bar. Fixed, so the scrolling row cannot
           clip them; their left/top are computed against the trigger button by
           _placePopover(). Positions are written as individual style
           properties, never via an :style binding — a binding would clobber the
           display:none that x-show relies on. */
        .appbar-pop {
            position: fixed;
            z-index: 50;
        }
        /* No-internet marquee strip: a fixed red bar pinned to the bottom edge,
           with the message scrolling right→left continuously (the native
           <marquee> is deprecated, so this is a CSS keyframe equivalent). */
        .net-marquee {
            position: fixed;
            left: 0; right: 0; bottom: 0;
            z-index: 70;                 /* above drawers (z-40) + PDF (z-60) */
            background: #ef4444;          /* red-500 */
            color: #fff;
            overflow: hidden;
            white-space: nowrap;
            padding: 6px 0;
            font-size: 14px;
            font-weight: 600;
            box-shadow: 0 -1px 4px rgba(0,0,0,0.15);
            padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));
        }
        .net-marquee__track {
            display: inline-block;
            padding-left: 100%;           /* start off-screen right */
            animation: net-marquee-scroll 14s linear infinite;
        }
        .net-marquee__track span { padding: 0 3rem; }
        @keyframes net-marquee-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }

        /* Landscape-only page in the floating window (e.g. Digital Register
           Book). When the device is held in PORTRAIT, rotate the window 90° so
           the page fills the screen as landscape. In landscape the media query
           is off and the window shows normally (already landscape). Standard
           "rotate the viewport" recipe; !important beats the Tailwind inset/
           rounded utilities on the same element. */
        @media (orientation: portrait) {
            .ext-landscape {
                position: fixed !important;
                top: 0 !important;
                left: 100vw !important;
                right: auto !important;
                bottom: auto !important;
                width: 100vh !important;
                height: 100vw !important;
                margin: 0 !important;
                border-radius: 0 !important;
                transform-origin: 0 0 !important;
                transform: rotate(90deg) !important;
            }
        }
    </style>
