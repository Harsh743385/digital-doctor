le="'background-color:' + col + '; border-color:' + (rbEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#f97316; border-color:transparent"></button><button type="button" @click="rbSelectColor(col)" class="w-8 h-8 rounded-full border-2" :style="'background-color:' + col + '; border-color:' + (rbEditColor===col ? '#0f172a' : 'transparent')" style="background-color:#7c3aed; border-color:transparent"></button>
