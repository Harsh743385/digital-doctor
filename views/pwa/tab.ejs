                    ];
                },
                // Seed the button to the lower-right corner the first time it
                // paints (viewport size isn't known until then).
                _fabSeed() {
                    if (this.fab.x === null || this.fab.y === null) {
                        this.fab.x = Math.max(12, window.innerWidth  - 74);
                        this.fab.y = Math.max(12, window.innerHeight - 190);
                    }
                },
                // Inline position for the button's container. Kept off x-show
                // (an element can't carry both :style and x-show — the style
                // clobbers display:none), so the wrapper uses <template x-if>.
                fabStyle() {
                    this._fabSeed();
                    // touch-action:none MUST live inside the bound style (Alpine's
                    // :style would otherwise clobber a separate static style attr),
                    // so a touch-drag on the FAB never gets hijacked into a scroll.
                    return 'left:' + this.fab.x + 'px; top:' + this.fab.y + 'px; touch-action:none;';
                },
                // Fan-out direction: open the menu toward whichever corner has
                // room, so it never spills off-screen wherever the button sits.
                fabMenuClass() {
                    this._fabSeed();
                    const vTop  = this.fab.y > (window.innerHeight / 2);   // button low → menu above
                    const hRight = this.fab.x > (window.innerWidth  / 2);  // button right → align right
                    return (vTop ? 'bottom-16 flex-col-reverse ' : 'top-16 flex-col ')
                         + (hRight ? 'right-0 items-end' : 'left-0 items-start');
                },
                // Pointer-drag. Tracks movement past a small threshold so a
                // real drag doesn't fire the tap that toggles the menu. Uses
                // window listeners (pointer capture) so the drag survives the
                // pointer leaving the 56px button.
                // Smoothness rules — the drag used to write this.fab.x/y on EVERY
                // pointermove, which cost three things per event: an Alpine
                // reactive flush (re-running fabStyle() + fabMenuClass(), both of
                // which read window.innerWidth/Height), a `left`/`top` write =
                // full layout + paint, and no coalescing (a touch/stylus digitiser
                // reports faster than the screen refreshes). On a tablet WebView
                // that reads as lag. Now:
                //   • nothing reactive is touched mid-drag (`moved` is a local, and
                //     the resting position is committed once, on release);
                //   • movement is a translate3d on the wrapper — composited, so it
                //     never triggers layout;
                //   • moves are coalesced into ONE paint per animation frame.
                fabDown(e) {
                    this._fabSeed();
                    this.fab.moved = false;
                    // CAPTURE the pointer to the button. Without this, a fast touch
                    // drag leaves the 56px button and the WebView reinterprets the
                    // gesture as a scroll → fires pointercancel → the drag stops
                    // early (the "have to drag several times to move it" bug).
                    // Capturing routes every move/up/cancel to this element until
                    // release, so one continuous drag slides it smoothly.
                    const el = e.currentTarget;
                    // The POSITIONED element is the WRAPPER (it carries the :style
                    // left/top); the captured button is its child. Transforming the
                    // wrapper carries the fan-out menu along with the button.
                    const wrap = el.parentElement;
                    try { el.setPointerCapture(e.pointerId); } catch (_) {}
                    const startX = e.clientX, startY = e.clientY;
                    const baseX = this.fab.x, baseY = this.fab.y;
                    const SIZE = 56;
                    // Clamp bounds read ONCE — reading innerWidth/Height per move
                    // forces a layout flush against the pending style write.
                    const maxX = window.innerWidth  - SIZE - 6;
                    const maxY = window.innerHeight - SIZE - 6;
                    // `moved` stays a LOCAL until release: this.fab.moved is
                    // reactive, and flipping it mid-drag would make Alpine rewrite
                    // the wrapper's style attribute (wiping the transform).
                    // fabToggle() reads it on the click that follows pointerup.
                    let moved = false, pendX = baseX, pendY = baseY, frame = 0;
                    const paint = () => {
                        frame = 0;
                        if (!wrap) return;
                        wrap.style.transform =
                            'translate3d(' + (pendX - baseX) + 'px,' + (pendY - baseY) + 'px,0)';
                    };
                    if (wrap) wrap.style.willChange = 'transform';
                    const move = (ev) => {
                        const dx = ev.clientX - startX, dy = ev.clientY - startY;
                        if (!moved && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) moved = true;
                        if (!moved) return;
                        pendX = Math.min(Math.max(6, baseX + dx), maxX);
                        pendY = Math.min(Math.max(6, baseY + dy), maxY);
                        // Coalesce — however many moves arrive this frame, paint once.
                        if (!frame) frame = requestAnimationFrame(paint);
                        if (ev.cancelable) ev.preventDefault();
                    };
                    const up = () => {
                        if (frame) { cancelAnimationFrame(frame); frame = 0; }
                        if (wrap) {
                            if (moved) {
                                // Write the resting left/top inline BEFORE clearing
                                // the transform, so the button doesn't flash back to
                                // its start position while Alpine's :style catches up.
                                wrap.style.left = pendX + 'px';
                                wrap.style.top  = pendY + 'px';
                            }
                            wrap.style.transform = '';
                            wrap.style.willChange = '';
                        }
                        // The single reactive write for the whole drag.
                        if (moved) { this.fab.x = pendX; this.fab.y = pendY; }
                        this.fab.moved = moved;
                        try { el.releasePointerCapture(e.pointerId); } catch (_) {}
                        el.removeEventListener('pointermove', move);
                        el.removeEventListener('pointerup', up);
                        el.removeEventListener('pointercancel', up);
                    };
                    // With pointer capture, the events are dispatched to `el`, so we
                    // listen on it (not window) for a reliable, uninterrupted drag.
                    el.addEventListener('pointermove', move, { passive: false });
                    el.addEventListener('pointerup', up);
                    el.addEventListener('pointercancel', up);
                },
                // Tap on the button — toggle the fan-out (unless the press was
                // actually a drag, in which case swallow it).
                fabToggle() {
                    if (this.fab.moved) { this.fab.moved = false; return; }
                    this.fab.open = !this.fab.open;
                    if (this.fab.open) this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                // Open Digital Nursing on the chosen tab in its OWN floating
                // window (the z-[98] iframe overlay used by the Settings drawer /
                // Edit Patient), NOT the shared main pane. This keeps whatever is
                // open behind it (e.g. an in-progress handwritten page) untouched;
                // Esc / the title-bar ✕ closes the floating screen and returns.
                // Same permission gate as the drawer's Digital Nursing button;
                // ?tab= deep-links the page to the tapped feature.
                fabOpenTab(tab, label) {
                    this.fab.open = false;
                    if (!(this.me && this.me.can_digital_nursing) || this.viewOnlyActive()) {
                        this.showToast('You have not permission to Write or Edit Digital Nursing Record.', 'error');
                        return;
                    }
                    const url = this._ipdUrl('/cms/digital-nursing')
                        + '?patient_id=' + encodeURIComponent(this.selectedPatientId)
                        + '&hospital_id=' + encodeURIComponent((this.me && this.me.hospital_id) || '')
                        + '&tab=' + encodeURIComponent(tab);
                    this._openExternal(url, label);
                },

                // Operative Notes (Digital NABH). 0 records in
                // tbl_operative_notes_details → open the operative-notes web form
                // (carries user_id); >0 → open the streamed PDF. Both render in the
                // main pane; the unsaved-edit prompt is handled by openWebPage.
                openOperativeNotes() {
                    if ((this.docCounts.operative || 0) > 0) {
                        this.openWebPage(
                            'Operative Notes',
                            this._ipdUrl('/cms/ajax/operative-notes-pdf-stream'),
                            'bg-rose-600',
                            { disposition: 'inline' },
                            'pdf'
                        );
                        // Notes already exist → offer the floating pencil so the
                        // user can add to / amend them (unless in view-only mode).
                        this.webEditVisible = true;
                    } else {
                        // No record yet → this path CREATES one; blocked in
                        // view-only mode (existing records still open as a PDF above).
                        if (this._checkReadOnly()) return;
                        this.openWebPage(
                            'Operative Notes',
                            this._ipdUrl('/cms/operative-notes'),
                            'bg-rose-600',
                            { user_id: (this.me && this.me.user_id) || '' }
                        );
                    }
                },

                // Discharge Summary (Digital NABH). 0 records in tbl_discharge_summary
                // → open the discharge-summary web form; >0 → open the preview PDF
                // (report_type=4). Both render in the main pane. The unsaved-edit
                // prompt is handled by openWebPage's _guardEditExit.
                openDischargeSummary() {
                    if ((this.docCounts.discharge || 0) > 0) {
                        this.openWebPage(
                            'Discharge Summary',
                            this._ipdUrl('/cms/generate-discharge-summary-preview'),
                            'bg-blue-600',
                            { report_type: 4, embed: 1 },
                            'pdf'
                        );
                        // Summary already exists → offer the floating pencil so
                        // the user can amend it (unless in view-only mode).
                        this.webEditVisible = true;
                    } else {
                        // No record yet → this path CREATES one; blocked in
                        // view-only mode (existing summaries still open as a PDF above).
                        if (this._checkReadOnly()) return;
                        this.openWebPage(
                            'Discharge Summary',
                            this._ipdUrl('/cms/discharge-summary'),
                            'bg-blue-600'
                        );
                    }
                },

                // Orange bottom-left "Do signature" — shown over the Discharge
                // Summary / Operative Notes previews and the MRD Checklist Count
                // PDF. The capture flow itself is NOT wired yet (this build has
                // no sign endpoint for these documents — tbl_*_sign_mst only
                // configures signature TITLES), so the tap reports that rather
                // than failing silently. Point this at the capture screen once
                // the server side exists.
                doSignature(docTitle) {
                    if (this._checkReadOnly()) return;
                    const doc = docTitle || 'this document';
                    plog('info', 'signature', 'do-signature tapped doc=' + doc
                        + ' patient_id=' + (this.selectedPatientId || ''));
                    this.showToast('Signature for ' + doc + ' is not set up on this server yet.', 'error');
                },

                // Floating-pencil action from a preview PDF → re-open the
                // matching form so the user can add to / amend an existing
                // record. Dispatches on the pane title.
                editCurrentDoc() {
                    if (this.webTitle === 'Operative Notes') {
                        this.editOperativeNotes();
                    } else {
                        this.editDischargeSummary();
                    }
                },

                // Re-open the operative-notes form (carries user_id, like the
                // create path). Blocked in view-only mode.
                editOperativeNotes() {
                    if (this._checkReadOnly()) return;
                    this.openWebPage(
                        'Operative Notes',
                        this._ipdUrl('/cms/operative-notes'),
                        'bg-rose-600',
                        { user_id: (this.me && this.me.user_id) || '' }
                    );
                },

                // Re-open the discharge-summary form so the user can add to /
                // amend an existing summary. Blocked in view-only mode.
                editDischargeSummary() {
                    if (this._checkReadOnly()) return;
                    this.openWebPage(
                        'Discharge Summary',
                        this._ipdUrl('/cms/discharge-summary'),
                        'bg-blue-600'
                    );
                },

                // ── Admission Card (Digital NABH → Admission Form) ──────────
                // Needs a selected patient; opens the With/Without Header
                // chooser. activeDoc highlights the button's dot like openDoc.
                openAdmissionForm() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    this.activeDoc = 'Admission Form';
                    this.admissionChooserOpen = true;
                },

                // Build the cms/generate-admission-pdf URL for the selected
                // patient and show it in the in-app viewer. report_type 0 =
                // with header (default), 6 = without header. The path is
                // relative to /pwa/ipd → resolves to the app-root cms route,
                // authed by the shared session cookie.
                openAdmissionPdf(reportType) {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    const rt = Number(reportType) || 0;
                    let url = '../cms/generate-admission-pdf?patient_id=' + encodeURIComponent(this.selectedPatientId);
                    if (rt > 0) { url += '&report_type=' + rt; }
                    this.admissionChooserOpen = false;
                    this.openPdfViewer({
                        title:       rt === 6 ? 'Admission Card (Without Header)' : 'Admission Card (With Header)',
                        url:         url,
                        headerClass: 'bg-teal-600',
                        whatsapp:    true,   // send-admission-card recipients
                        share:       true,
                    });
                    plog('info', 'admission', 'open admission pdf patient_id=' + this.selectedPatientId + ' report_type=' + rt);
                },

                // ── Medi Link (Gallery | Labs) ──────────────────────────────
                // The Medlink web app, in the floating full-screen window (the
                // same z-98 shell the Settings-drawer links use) so the main
                // pane keeps whatever it was showing. Not patient-scoped.
                openMediLink() {
                    this.activeDoc = 'Medi Link';
                    this.rightOpen = false;
                    this._openExternal('https://medlink-web.vercel.app', 'Medi Link');
                    plog('info', 'medilink', 'opened medlink web app');
                },

                // ── Request to Patient for Feedback (Digital NABH) ──────────
                openFeedbackRequest() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    this.activeDoc       = 'Request to Patient for Feedback';
                    this.feedbackSending = false;
                    this.feedbackAskOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // "Fill Feedback Form here" — the form on THIS tablet, in a
                // floating full-screen window. Default target is the IPD app's
                // patient_feedback_form.php; a hospital listed in
                // FEEDBACK_FORM_URLS loads its own link instead.
                feedbackFillHere() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    const hid      = Number(this.me && this.me.hospital_id) || 0;
                    const override = this.FEEDBACK_FORM_URLS[hid] || '';
                    this.feedbackFormExternal = !!override;
                    this.feedbackFormUrl = override || (
                        this._ipdUrl('/cms/patient_feedback_form.php')
                        + '?hospital_id=' + encodeURIComponent(hid)
                        + '&pid=' + encodeURIComponent(this.selectedPatientId)
                    );
                    this.feedbackAskOpen  = false;
                    this.feedbackFormOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    plog('info', 'feedback', 'feedback form opened hospital_id=' + hid
                        + ' patient_id=' + this.selectedPatientId
                        + (override ? ' (external)' : ''));
                },

                closeFeedbackForm() {
                    this.feedbackFormOpen = false;
                },

                // Escape hatch for the off-site forms: Google pages refuse to be
                // framed, so hand the URL to the browser / native wrapper.
                openFeedbackFormInBrowser() {
                    if (!this.feedbackFormUrl) return;
                    window.open(this.feedbackFormUrl, '_blank', 'noopener');
                },

                // "Send Link to Whatsapp" — the existing IPD sender: WhatsApp
                // template google_review_1 to the patient's whatsapp_no (falling
                // back to contact_no), carrying this hospital's feedback link.
                // The server writes its own audit entry.
                async feedbackSendWhatsapp() {
                    if (this.feedbackSending) return;
                    const hospitalId = this.me && this.me.hospital_id;
                    if (!this.selectedPatientId || !hospitalId) {
                        this.showToast('Missing patient or hospital', 'error');
                        return;
                    }
                    this.feedbackSending = true;
                    try {
                        const body = new URLSearchParams();
                        body.append('patient_id', this.selectedPatientId);
                        body.append('hospital_id', hospitalId);
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch('../cms/ajax/send-feedback-link-whatsapp', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: Object.assign(
                                { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                            body: body.toString(),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap again', 'error'); return; }
                        const res = await resp.json().catch(() => ({}));
                        const ok  = res && Number(res.code) === 200;
                        this.showToast(
                            (res && (res.message || res.msg)) || (ok ? 'Feedback link sent on WhatsApp.' : 'Send failed'),
                            ok ? 'success' : 'error'
                        );
                        plog(ok ? 'info' : 'warn', 'feedback',
                            'whatsapp feedback link patient_id=' + this.selectedPatientId + ' ok=' + !!ok);
                        if (ok) this.feedbackAskOpen = false;
                    } catch (e) {
                        plog('warn', 'feedback', 'feedback link send failed: ' + (e && e.message || e));
                        this.showToast('Something went wrong', 'error');
                    } finally {
                        this.feedbackSending = false;
                    }
                },

                // ── Clinical Scale Type (Digital NABH) ──────────────────────
                // The row opens a chooser of the scales; picking one is where
                // its screen will hook in (nothing to open yet).
                openClinicalScale() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    this.activeDoc = 'Clinical Scale Type';
                    this.clinicalScaleOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                pickClinicalScale(scale) {
                    this.clinicalScaleOpen = false;
                    this.nabhComingSoon(scale);
                },

                // ── Diet Records (Digital NABH) ─────────────────────────────
                // Own full-screen window over the app; the main pane keeps
                // whatever it was showing.
                openDietRecords() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    this.activeDoc = 'Diet Records';
                    this.rightOpen = false;
                    this.dietOpen  = true;
                    this.loadDietList();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    plog('info', 'diet', 'open diet records patient_id=' + this.selectedPatientId);
                },

                // This patient's assign history. Server returns it newest-first;
                // groupedDietByDate() only buckets it by day.
                async loadDietList() {
                    if (!this.selectedPatientId) { this.dietList = []; return; }
                    this.dietListLoading = true;
                    try {
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId) + '/diet',
                            { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.dietList = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        plog('warn', 'diet', 'diet list load failed: ' + (e && e.message || e));
                        this.showToast('Could not load diet records', 'error');
                    } finally {
                        this.dietListLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // Bucket the history by calendar day, newest day first (and
                // newest row first inside each day). assign_at is MySQL
                // "Y-m-d H:i:s", so the date part sorts lexically.
                groupedDietByDate() {
                    const by = {};
                    for (const d of (this.dietList || [])) {
                        const key = String(d.assign_at || '').slice(0, 10);
                        (by[key] = by[key] || []).push(d);
                    }
                    return Object.keys(by)
                        .sort((a, b) => b.localeCompare(a))
                        .map((day) => ({
                            day: this.fmtDate(day) || day || '—',
                            records: by[day].slice().sort(
                                (a, b) => String(b.assign_at || '').localeCompare(String(a.assign_at || ''))
                            ),
                        }));
                },

                closeDietRecords() {
                    this.dietOpen = false;
                },

                // "Name (with salutation) (age/gender)" — the dialog title's
                // patient. Age and gender are dropped when the record doesn't
                // carry them, so the line never shows empty braces.
                patientNameAge() {
                    const p    = this.selectedPatient || {};
                    const name = p.name || this.patientName || '';
                    const age  = String(p.age == null ? '' : p.age).trim();
                    const gen  = this.genderLabel(p.gender);
                    const bits = [age, gen].filter(Boolean).join('/');
                    return name + (bits ? ' (' + bits + ')' : '');
                },

                // App-bar subtitle: the same line plus [IPD No].
                dietPatientLine() {
                    const p   = this.selectedPatient || {};
                    const ipd = p.ipd || this.patientIp || '';
                    return this.patientNameAge() + (ipd ? ' [' + ipd + ']' : '');
                },

                // App-bar "Assign Diet" → the dialog. The interval list is
                // refetched each time it opens so a master edited on the CMS
                // shows up without reloading the app.
                assignDiet() {
                    if (this._checkReadOnly()) return;
                    if (this._checkDietDischarge()) return;
                    this.dietIntervalListOpen = false;
                    this.dietIntervalSearch   = '';
                    this.dietIntervalId       = null;
                    this.dietIntervalError    = '';
                    this.dietTypeListOpen     = false;
                    this.dietTypeSearch       = '';
                    this.dietTypeId           = null;
                    this.dietRemark           = '';
                    this.dietSaving           = false;
                    this.dietEditId           = null;
                    this.dietEditOrigIntervalId = null;
                    // Stamped once, on open — the line must not tick while the
                    // user fills the form.
                    this.dietAssignAt         = new Date();
                    this.dietAssignAtLabel    = this.fmtDateTime(this.dietAssignAt);
                    this.dietAssignByLabel    = (this.me && this.me.user_name) || '';
                    this.dietAssignOpen       = true;
                    this.loadDietIntervals();
                    this.loadDietTypes();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    plog('info', 'diet', 'assign diet opened patient_id=' + (this.selectedPatientId || ''));
                },

                // Diet Records are FROZEN once the patient is discharged
                // (patient_status 2 → is_discharged): no add / update / delete
                // unless the user holds p_id 80, or is a doctor_type 3 account
                // (no restrictions at all). Stricter than the Hand Written
                // pages rule, which allows a validity window after discharge.
                // Returns true = blocked (and toasts).
                _checkDietDischarge() {
                    if (this.dietAnyDateUser()) return false;
                    const p = this.selectedPatient;
                    const discharged = this.patientMode !== 'live' || !!(p && p.is_discharged);
                    if (!discharged) return false;
                    if (this.me && this.me.can_edit_discharged_anytime) return false;   // p_id 80
                    this.showToast('Cannot Delete Diet Details After Patient Discharge', 'error');
                    return true;
                },

                // gm_user_master.doctor_type 3 (cached from /api/me at login):
                // may add / update / delete a Diet Record of ANY date. Everyone
                // else works on today's records only. Both endpoints re-check.
                dietAnyDateUser() {
                    return Number(this.me && this.me.doctor_type) === 3;
                },

                // Is this history row dated today? assign_at is MySQL
                // "Y-m-d H:i:s", so the date part compares as a string against
                // the device's local calendar day.
                dietRecordIsToday(rec) {
                    const day = String((rec && rec.assign_at) || '').slice(0, 10);
                    if (!day) return false;
                    const d   = new Date();
                    const pad = (n) => String(n).padStart(2, '0');
                    return day === d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
                },

                // ── History row: tap = edit, long-press = delete ────────────
                // Same 500ms press pattern the documents grid uses, including
                // swallowing the click the browser fires after a long-press so
                // it doesn't open the edit dialog on top of the confirmation.
                dietPressStart(d) {
                    this._clearDietPress();
                    this._dietPressTimer = setTimeout(() => this.dietAskDelete(d), 500);
                },
                _clearDietPress() {
                    if (this._dietPressTimer) { clearTimeout(this._dietPressTimer); this._dietPressTimer = null; }
                },
                dietPressEnd() { this._clearDietPress(); },

                dietAskDelete(d) {
                    this._clearDietPress();
                    if (!d) return;
                    // Swallow the click either way — a refused long-press must
                    // not fall through into the edit dialog.
                    this._suppressNextDietClick = true;
                    if (this._checkReadOnly()) return;
                    if (this._checkDietDischarge()) return;
                    // p_id 23 (server re-checks on the delete endpoint).
                    if (!(this.me && this.me.can_delete_diet)) {
                        this.showToast('You have not authority to do Delete Diet Records.', 'error');
                        return;
                    }
                    // Past / future dated rows: doctor_type 3 only.
                    if (!this.dietRecordIsToday(d) && !this.dietAnyDateUser()) {
                        this.showToast("Only today's Diet Records can be deleted.", 'error');
                        return;
                    }
                    this.dietDeleting  = false;
                    this.dietDeleteRec = d;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                dietCardClick(d) {
                    if (this._suppressNextDietClick) { this._suppressNextDietClick = false; return; }
                    this.openDietEdit(d);
                },

                // Confirmed delete. tbl_diet_data has no soft-delete column, so
                // the row is really removed — hence the named confirmation.
                async dietDeleteConfirmed() {
                    const rec = this.dietDeleteRec;
                    if (!rec || this.dietDeleting) return;
                    this.dietDeleting = true;
                    try {
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                + '/diet/' + encodeURIComponent(rec.id),
                            {
                                method: 'DELETE',
                                credentials: 'same-origin',
                                headers: Object.assign(
                                    { 'Accept': 'application/json' },
                                    this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                                ),
                            }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        const res = await resp.json().catch(() => ({}));
                        if (!resp.ok || !(res && res.ok)) {
                            const msg = (res && (res.error || res.message)) || ('Could not delete (HTTP ' + resp.status + ')');
                            this.showToast(msg, 'error');
                            plog('warn', 'diet', 'delete failed diet_id=' + rec.id + ': ' + msg);
                            return;
                        }
                        plog('info', 'diet', 'diet record deleted diet_id=' + rec.id
                            + ' patient_id=' + this.selectedPatientId);
                        this.dietDeleteRec = null;
                        this.showToast('Diet Record Deleted Successfully.', 'success');
                        this.loadDietList();
                    } catch (e) {
                        plog('warn', 'diet', 'delete diet failed: ' + (e && e.message || e));
                        this.showToast('Something went wrong', 'error');
                    } finally {
                        this.dietDeleting = false;
                    }
                },

                // Tap a history row → the SAME dialog in update mode, preloaded
                // with what was saved. The interval is set directly rather than
                // through dietIntervalPick(): re-opening an older record must
                // not fire the "time is expired" check on an interval the user
                // hasn't touched.
                openDietEdit(rec) {
                    if (!rec) return;
                    if (this._checkReadOnly()) return;
                    if (this._checkDietDischarge()) return;
                    // p_id 22 (server re-checks on the update endpoint).
                    if (!(this.me && this.me.can_update_diet)) {
                        this.showToast('You have not authority to do Update Diet Records.', 'error');
                        return;
                    }
                    // Past / future dated rows: doctor_type 3 only.
                    if (!this.dietRecordIsToday(rec) && !this.dietAnyDateUser()) {
                        this.showToast("Only today's Diet Records can be updated.", 'error');
                        return;
                    }
                    this.dietIntervalListOpen = false;
                    this.dietIntervalSearch   = '';
                    this.dietIntervalError    = '';
                    this.dietTypeListOpen     = false;
                    this.dietTypeSearch       = '';
                    this.dietRemark           = rec.remark || '';
                    this.dietSaving           = false;
                    this.dietEditId           = rec.id;
                    // The saved who/when stay on show — the edit is recorded
                    // separately in edited_by / edited_at.
                    this.dietAssignAt         = null;
                    this.dietAssignAtLabel    = this.fmtDateTime(rec.assign_at);
                    this.dietAssignByLabel    = rec.assigned_by || '';
                    this.dietAssignOpen       = true;
                    // Preselect from the SAVED ids the list carries.
                    this.dietIntervalId         = rec.interval_id || null;
                    this.dietTypeId             = rec.type_id     || null;
                    this.dietEditOrigIntervalId = this.dietIntervalId;
                    this.loadDietIntervals();
                    this.loadDietTypes();
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    plog('info', 'diet', 'diet edit opened diet_id=' + rec.id);
                },

                closeAssignDiet() {
                    this.dietIntervalListOpen = false;
                    this.dietTypeListOpen     = false;
                    this.dietAssignOpen       = false;
                },

                // mst_diet_interval for the session hospital. A failed fetch
                // leaves whatever was loaded before rather than blanking the
                // dropdown on a transient offline blip.
                async loadDietIntervals() {
                    this.dietIntervalLoading = true;
                    try {
                        const resp = await fetch('./api/masters/diet-intervals', {
                            credentials: 'same-origin', cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.dietIntervalOptions = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        plog('warn', 'diet', 'diet intervals load failed: ' + (e && e.message || e));
                        this.showToast('Could not load diet intervals', 'error');
                    } finally {
                        this.dietIntervalLoading = false;
                    }
                },

                // Footer "Assign Diet" → one tbl_diet_data row. Everything the
                // disabled state already guards is re-checked here: a stale
                // reactive value must never let a bad assign through, and the
                // interval's window can lapse while the form sits open.
                // hospital_id / dept_id / assign_by / assign_at are all set
                // server-side from the session and the patient row.
                async submitAssignDiet() {
                    if (this.dietSaving) return;
                    if (this._checkReadOnly()) return;
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    if (this.dietIntervalId === null) {
                        this.showToast('Please Select Diet Interval.', 'error');
                        return;
                    }
                    if (this.dietTypeId === null) {
                        this.showToast('Please Select Diet Type.', 'error');
                        return;
                    }
                    // Re-check the window only for an interval the user actually
                    // picked in this session — re-saving an older record with
                    // its original interval untouched must not be blocked by a
                    // window that closed hours ago.
                    if (this.dietIntervalId !== this.dietEditOrigIntervalId) {
                        const iv = (this.dietIntervalOptions || []).find((o) => o && o.id === this.dietIntervalId);
                        if (iv) { this.dietIntervalPick(iv); }
                        if (this.dietIntervalError) return;
                    }

                    const editing = this.dietEditId !== null;
                    const url = editing
                        ? ('./api/patients/' + encodeURIComponent(this.selectedPatientId)
                           + '/diet/' + encodeURIComponent(this.dietEditId))
                        : ('./api/patients/' + encodeURIComponent(this.selectedPatientId) + '/diet-assign');

                    this.dietSaving = true;
                    try {
                        const body = new URLSearchParams();
                        body.append('diet_interval_id', this.dietIntervalId);
                        body.append('diet_type_id', this.dietTypeId);
                        body.append('diet_remark', (this.dietRemark || '').trim());
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch(
                            url,
                            {
                                method: 'POST',
                                credentials: 'same-origin',
                                headers: Object.assign(
                                    { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                                    this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                                ),
                                body: body.toString(),
                            }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        const res = await resp.json().catch(() => ({}));
                        if (!resp.ok || !(res && res.ok)) {
                            const msg = (res && (res.error || res.message))
                                || ('Could not ' + (editing ? 'update' : 'assign') + ' diet (HTTP ' + resp.status + ')');
                            this.showToast(msg, 'error');
                            plog('warn', 'diet', (editing ? 'update' : 'assign') + ' failed: ' + msg);
                            return;
                        }
                        plog('info', 'diet', 'diet ' + (editing ? 'updated' : 'assigned')
                            + ' id=' + (res.diet_id || '')
                            + ' patient_id=' + this.selectedPatientId
                            + ' interval=' + this.dietIntervalId + ' type=' + this.dietTypeId);
                        this.showToast(
                            editing ? 'Diet Updated Successfully.' : 'Diet Assigned Successfully.',
                            'success'
                        );
                        this.closeAssignDiet();
                        // The new row belongs at the top of the history behind
                        // the dialog — refetch rather than splicing it in, so
                        // the joined names come from the server.
                        this.loadDietList();
                    } catch (e) {
                        plog('warn', 'diet', 'assign diet failed: ' + (e && e.message || e));
                        this.showToast('Something went wrong', 'error');
                    } finally {
                        this.dietSaving = false;
                    }
                },

                // mst_diet_type (active rows). Global master — no hospital
                // scoping — so it's the same list for every tenant.
                async loadDietTypes() {
                    this.dietTypeLoading = true;
                    try {
                        const resp = await fetch('./api/masters/diet-types', {
                            credentials: 'same-origin', cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.dietTypeOptions = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        plog('warn', 'diet', 'diet types load failed: ' + (e && e.message || e));
                        this.showToast('Could not load diet types', 'error');
                    } finally {
                        this.dietTypeLoading = false;
                    }
                },

                // Selected diet type's name, or the placeholder.
                dietTypeLabel() {
                    const hit = (this.dietTypeOptions || []).find(
                        (o) => o && o.id === this.dietTypeId
                    );
                    return hit ? hit.name : 'Select diet type…';
                },

                // Selected interval's name, or the placeholder.
                dietIntervalLabel() {
                    const hit = (this.dietIntervalOptions || []).find(
                        (o) => o && o.id === this.dietIntervalId
                    );
                    return hit ? hit.name : 'Select interval…';
                },

                // "08:00:00 – 10:00:00" for the dropdown row (either end alone
                // if the master only carries one of them).
                dietIntervalRange(opt) {
                    if (!opt) return '';
                    return [opt.start_time, opt.end_time].filter(Boolean).join(' – ');
                },

                // 'HH:MM[:SS]' → seconds since midnight, or null when the master
                // leaves the field blank / unparseable.
                _dietTimeSecs(v) {
                    const m = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(String(v || '').trim());
                    if (!m) return null;
                    const h = Number(m[1]), mi = Number(m[2]), s = Number(m[3] || 0);
                    if (h > 23 || mi > 59 || s > 59) return null;
                    return (h * 3600) + (mi * 60) + s;
                },

                // Picking an interval enforces its window: the assign is only
                // valid while the device clock sits between the master's
                // interval_start_time and interval_time. An interval with no
                // window configured is left unrestricted.
                dietIntervalPick(opt) {
                    if (!opt) return;
                    this.dietIntervalId       = opt.id;
                    this.dietIntervalListOpen = false;

                    const start = this._dietTimeSecs(opt.start_time);
                    const end   = this._dietTimeSecs(opt.end_time);
                    if (start === null || end === null) { this.dietIntervalError = ''; return; }

                    const d   = new Date();
                    const now = (d.getHours() * 3600) + (d.getMinutes() * 60) + d.getSeconds();
                    // end < start means the window crosses midnight (e.g. 22:00
                    // → 02:00), so "inside" is either side of the wrap.
                    const inside = (end >= start)
                        ? (now >= start && now <= end)
                        : (now >= start || now <= end);
                    if (inside) { this.dietIntervalError = ''; return; }

                    this.dietIntervalError =
                        'Diet Assign Interval Time is expired. Please Assign Diet before prior Time between '
                        + opt.start_time + ' to ' + opt.end_time + ' only.';
                    this.showToast(this.dietIntervalError, 'error');
                    plog('info', 'diet', 'interval "' + opt.name + '" outside window '
                        + opt.start_time + '-' + opt.end_time);
                },

                // Digital NABH rows whose target isn't wired yet (Clinical Scale
                // Type / Request to Patient for Feedback — Diet Records now has
                // its own window). Reports it rather than opening a 404. When
                // each destination is settled:
                //   • Clinical Scale Type → openWebPage(label, _ipdUrl('/cms/…'), 'bg-fuchsia-600')
                //   • Feedback request    → POST cms/ajax/send-feedback-link-whatsapp
                //     (patient_id + hospital_id), same shape as sendAdmissionWhatsapp()
                nabhComingSoon(label) {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    plog('info', 'nabh', 'tapped unwired NABH item "' + label
                        + '" patient_id=' + this.selectedPatientId);
                    this.showToast(label + ' is not set up on this server yet.', 'error');
                },

                // MRD Checklist Count — server-rendered PDF, print only (no
                // WhatsApp / Share). Absolute URL per the IPD deployment.
                openMrdPdf() {
                    if (!this.selectedPatientId) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    this.activeDoc = 'MRD CheckList Count';
                    this.openPdfViewer({
                        title:       'MRD Checklist Count',
                        url:         this._ipdUrl('/cms/generate-mrd-pdf?patient_id=') + encodeURIComponent(this.selectedPatientId),
                        headerClass: 'bg-violet-600',
                        whatsapp:    false,
                        share:       false,
                        sign:        true,   // orange bottom-left "Do signature"
                    });
                    plog('info', 'mrd', 'open mrd pdf patient_id=' + this.selectedPatientId);
                },

                // ── Full Patient File (Digital NABH → Full Patient File) ────
                // Fetches the manifest, opens the combined viewer, and renders
                // each section in order. The Admission / Operative / Discharge
                // PDFs reuse the same cms streams the single-doc buttons use
                // (rendered with PDF.js); handwritten + image documents render
                // as <img>; PDF documents render into their own per-doc boxes.
                // Open the IPD History for a returning patient. Fetches the
                // prior discharged admissions sharing this patient's mr_number;
                // exactly one → skip the list and open its Full Patient File
                // directly, otherwise show the list modal.
                // OPD History — same shape as openIpdHistory (fetch → list → open a
                // single result directly). The endpoint is not built yet: this repo
                // has no OPD tables at all, so a 404/501 surfaces a clear message
                // rather than a broken dialog. Wiring the server side is a one-file
                // change once the OPD source table is known.
                async openOpdHistory(p) {
                    const pid = p ? p.id : this.selectedPatientId;
                    if (!pid) { this.showToast('Select a patient first', 'error'); return; }
                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(pid) + '/opd-history', {
                            credentials: 'same-origin', headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 404 || resp.status === 501) {
                            this.showToast('OPD History is not configured on this server yet.', 'error');
                            return;
                        }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        const items = (data && data.items) || [];
                        if (!items.length) { this.showToast('No past OPD visits found.'); return; }
                        // Reuse the IPD history dialog — same card renderer.
                        this.ipdHistoryPatientName = p ? (p.name || '') : (this.patientName || '');
                        this.ipdHistoryItems   = items;
                        this.ipdHistoryLoading = false;
                        this.ipdHistoryOpen    = true;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    } catch (e) {
                        plog('warn', 'opdhistory', 'load failed: ' + (e && e.message || e));
                        this.showToast('Could not load OPD history', 'error');
                    }
                },
                async openIpdHistory(p) {
                    const pid = p ? p.id : this.selectedPatientId;
                    if (!pid) { this.showToast('Select a patient first', 'error'); return; }

                    this.ipdHistoryPatientName = p ? (p.name || '') : (this.patientName || '');
                    this.ipdHistoryItems   = [];
                    this.ipdHistoryLoading = true;
                    this.ipdHistoryOpen    = true;

                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(pid) + '/ipd-history', {
                            credentials: 'same-origin', headers: { 'Accept': 'application/json' },
                        });
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.ipdHistoryItems = data.items || [];
                    } catch (e) {
                        plog('warn', 'ipdhistory', 'load failed: ' + (e && e.message || e));
                        this.showToast('Could not load IPD history', 'error');
                        this.ipdHistoryOpen = false;
                        this.ipdHistoryLoading = false;
                        return;
                    }
                    this.ipdHistoryLoading = false;

                    // Single past admission → open its file straight away.
                    if (this.ipdHistoryItems.length === 1) {
                        this.openHistoryRecord(this.ipdHistoryItems[0]);
                        return;
                    }
                    this.$nextTick(() => { if (window.lucide) { try { lucide.createIcons(); } catch (_) {} } });
                    plog('info', 'ipdhistory', 'open patient_id=' + pid + ' count=' + this.ipdHistoryItems.length);
                },

                // Open one past admission's Full Patient File. The history item
                // already carries the header shape openFullFile() expects.
                openHistoryRecord(h) {
                    this.ipdHistoryOpen = false;
                    this.openFullFile(h);
                },

                // ── Eye viewer (floating patient-file flip window) ──────────
                // Loads the whole file for the selected patient and flattens it
                // into an ordered list of leaves: admission PDF → handwritten
                // pages → documents/reports → operative notes → discharge
                // summary. Each leaf is one « » step; PDFs render via PDF.js.
                async openEyeViewer() {
                    const pid = this.selectedPatientId;
                    if (!pid) { this.showToast('Select a patient first', 'error'); return; }
                    const hid = (this.me && this.me.hospital_id) || '';

                    this.eyePatientName = this.patientName || '';
                    this.eyeLeaves  = [];
                    this.eyeIndex   = 0;
                    this.eyeCat     = '';
                    this.eyeLocked  = false;
                    // Open MINIMISED (the floating quarter-screen card) so the form
                    // behind it stays visible and usable — the whole point of this
                    // being a non-modal window. Full screen is one tap away on the
                    // maximise button in the filter row.
                    this.eyeFull    = false;
                    this.eyeZoom    = 1;       // always open at 100%
                    this._eyePinch  = null;
                    this.eyeDX      = 0;
                    this.eyeDY      = 0;
                    this.eyeLoading = true;
                    this.eyeOpen    = true;
                    this._clearPdfBox('eyeLeafBox');

                    let data = { handwritten: [], documents: [], operative: false, discharge: false };
                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(pid) + '/full-file', {
                            credentials: 'same-origin', headers: { 'Accept': 'application/json' },
                        });
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const d = await resp.json();
                        data = {
                            handwritten: d.handwritten || [],
                            documents:   d.documents   || [],
                            operative:   !!d.operative,
                            discharge:   !!d.discharge,
                        };
                    } catch (e) {
                        plog('warn', 'eye', 'file load failed: ' + (e && e.message || e));
                        this.showToast('Could not load patient file', 'error');
                    }

                    // Flatten into the requested display order.
                    const leaves = [];
                    // 1. Admission form PDF — always first.
                    leaves.push({
                        type: 'pdf', cat: 'Admission Form', label: 'Admission Form',
                        src: '../cms/generate-admission-pdf?patient_id=' + encodeURIComponent(pid),
                    });
                    // 2. Handwritten pages — one leaf each.
                    (data.handwritten || []).forEach((hp) => {
                        const c = hp.category || 'Handwritten';
                        leaves.push({
                            type: 'hw', cat: c, label: c + (hp.date ? ' · ' + hp.date : ''),
                            image: hp.image, imageProxy: hp.imageProxy, bgImage: hp.bgImage,
                        });
                    });
                    // 3. Documents & reports (Other, Lab, Bill, Radiology, Cardiology).
                    (data.documents || []).forEach((dc) => {
                        const c = dc.label || 'Document';
                        const label = c + (dc.date ? ' · ' + dc.date : '');
                        if (dc.kind === 'pdf') {
                            leaves.push({ type: 'pdf', cat: c, label, src: dc.fileProxy });
                        } else {
                            leaves.push({ type: 'image', cat: c, label, fileProxy: dc.fileProxy });
                        }
                    });
                    // 4. Operative Notes PDF.
                    if (data.operative) {
                        leaves.push({
                            type: 'pdf', cat: 'Operative Notes', label: 'Operative Notes',
                            src: this._ipdUrl('/cms/ajax/operative-notes-pdf-stream')
                                + '?patient_id=' + encodeURIComponent(pid)
                                + '&hospital_id=' + encodeURIComponent(hid)
                                + '&disposition=inline',
                        });
                    }
                    // 5. Discharge Summary PDF.
                    if (data.discharge) {
                        leaves.push({
                            type: 'pdf', cat: 'Discharge Summary', label: 'Discharge Summary',
                            src: this._ipdUrl('/cms/generate-discharge-summary-preview')
                                + '?patient_id=' + encodeURIComponent(pid)
                                + '&hospital_id=' + encodeURIComponent(hid)
                                + '&report_type=4&embed=1',
                        });
                    }

                    this.eyeLeaves  = leaves;
                    this.eyeIndex   = 0;
                    this.eyeLoading = false;
                    this.$nextTick(() => {
                        if (window.lucide) { try { lucide.createIcons(); } catch (_) {} }
                        this._renderEyeLeaf();
                    });
                    plog('info', 'eye', 'open patient_id=' + pid + ' leaves=' + leaves.length);
                },

                // Distinct categories (with counts) for the filter dropdown.
                eyeCategories() {
                    const map = {};
                    (this.eyeLeaves || []).forEach((lf) => {
                        const k = lf.cat || 'Other';
                        map[k] = (map[k] || 0) + 1;
                    });
                    return Object.keys(map).map((name) => ({ name, count: map[name] }));
                },

                // Leaves after the category filter ('' = All).
                eyeFilteredLeaves() {
                    if (!this.eyeCat) { return this.eyeLeaves || []; }
                    return (this.eyeLeaves || []).filter((lf) => (lf.cat || 'Other') === this.eyeCat);
                },

                // Current leaf, index clamped to the filtered list.
                eyeCurrent() {
                    const list = this.eyeFilteredLeaves();
                    if (!list.length) { return null; }
                    let i = this.eyeIndex;
                    if (i < 0) { i = 0; }
                    if (i > list.length - 1) { i = list.length - 1; }
                    return list[i];
                },

                eyeSelectCat(c) {
                    this.eyeCat   = c || '';
                    this.eyeIndex = 0;
                    this._afterEyeNav();
                },

                eyePrev() {
                    if (this.eyeIndex > 0) { this.eyeIndex--; this._afterEyeNav(); }
                },
                eyeNext() {
                    if (this.eyeIndex < this.eyeFilteredLeaves().length - 1) { this.eyeIndex++; this._afterEyeNav(); }
                },

                // After any index/filter change: cancel the old PDF render and
                // render the new leaf once the DOM has updated.
                _afterEyeNav() {
                    this._clearPdfBox('eyeLeafBox');
                    this.$nextTick(() => this._renderEyeLeaf());
                },

                // Render the current leaf. PDF leaves go through PDF.js into
                // #eyeLeafBox; image/handwritten leaves are plain <img>.
                _renderEyeLeaf() {
                    const cur = this.eyeCurrent();
                    if (!cur) { return; }
                    if (cur.type === 'pdf') {
                        this._renderPdf(cur.src, 'eyeLeafBox');
                    } else {
                        this._clearPdfBox('eyeLeafBox');
                    }
                    if (window.lucide) { try { lucide.createIcons(); } catch (_) {} }
                },

                // Inline style for the floating card. Fullscreen → cover the
                // viewport; otherwise a quarter-ish window centred on screen and
                // shifted by the current drag offset (eyeDX/eyeDY).
                eyeCardStyle() {
                    if (this.eyeFull) {
                        return 'left:0;top:0;width:100vw;height:100vh;transform:none;';
                    }
                    // Quarter of the current screen: half the width × half the
                    // height = 1/4 of the viewport area.
                    return 'left:50%;top:50%;'
                        + 'width:50vw;height:50vh;'
                        + 'transform:translate(calc(-50% + ' + this.eyeDX + 'px),'
                        + ' calc(-50% + ' + this.eyeDY + 'px));';
                },

                // Drag the window by its header. Disabled while locked or
                // fullscreen, and ignored when the press lands on a control.
                // Pointer capture keeps the drag alive over the canvas/iframes.
                eyeDragStart(e) {
                    if (this.eyeLocked || this.eyeFull) { return; }
                    if (e.target.closest('button, a, input, select')) { return; }
                    const el = e.currentTarget;
                    try { el.setPointerCapture(e.pointerId); } catch (_) {}
                    const startX = e.clientX, startY = e.clientY;
                    const origX = this.eyeDX, origY = this.eyeDY;
                    const move = (ev) => {
                        this.eyeDX = origX + (ev.clientX - startX);
                        this.eyeDY = origY + (ev.clientY - startY);
                    };
                    const up = () => {
                        el.removeEventListener('pointermove', move);
                        el.removeEventListener('pointerup', up);
                        el.removeEventListener('pointercancel', up);
                        try { el.releasePointerCapture(e.pointerId); } catch (_) {}
                    };
                    el.addEventListener('pointermove', move);
                    el.addEventListener('pointerup', up);
                    el.addEventListener('pointercancel', up);
                },

                // Toggle this window between fullscreen and quarter-screen. The
                // box width changes, so re-render the current PDF leaf to refit.
                eyeToggleFull() {
                    this.eyeFull = !this.eyeFull;
                    this.$nextTick(() => { if (window.lucide) { try { lucide.createIcons(); } catch (_) {} } });
                    this._afterEyeNav();
                },

                // ── Zoom, scoped to THIS window ────────────────────────────
                // Applied with CSS `zoom` on the layer inside the scroll box (not a
                // transform): zoom participates in layout, so the overflow-auto body
                // grows with the page and becomes the pan surface. Nothing outside
                // the card is affected — the form/editor behind keeps its own scale.
                // Zoom is deliberately kept across « » page flips so a whole register
                // can be read at one magnification; it resets to 100% on open.
                // The WHOLE inline style is computed here (nothing static on the
                // element) so a Tailwind class can't half-apply and nothing gets
                // clobbered. At 100% this is width:100%;min-height:100% — i.e. the
                // original layout, so the un-zoomed view is unchanged.
                eyeZoomStyle() {
                    const pct = Math.round(this.eyeZoom * 100);
                    return 'width:' + pct + '%; min-height:' + pct + '%;';
                },
                // 100% is the floor — the page is already fitted to the window at
                // 100%, so zooming out further would just shrink it into empty space.
                _eyeSetZoom(z) {
                    const next = Math.max(1, Math.min(4, Math.round(z * 100) / 100));
                    if (next === this.eyeZoom) return;
                    this.eyeZoom = next;
                    // A PDF leaf is a raster canvas sized at render time, so it only
                    // stretches (and softens) with the box. Re-render it at the new
                    // width once the user stops adjusting, so zoomed PDFs stay sharp.
                    clearTimeout(this._eyeZoomTimer);
                    this._eyeZoomTimer = setTimeout(() => {
                        if (this.eyeOpen && this.eyeCurrent() && this.eyeCurrent().type === 'pdf') this._afterEyeNav();
                    }, 300);
                },
                eyeZoomIn()    { this._eyeSetZoom(this.eyeZoom + 0.25); },
                eyeZoomOut()   { this._eyeSetZoom(this.eyeZoom - 0.25); },
                eyeZoomReset() { this._eyeSetZoom(1); },
                // Two-finger pinch inside the body. One finger is left alone so
                // ordinary scrolling/panning still works — and a single-finger
                // DOUBLE TAP resets the page to its original 100% size.
                _eyePinch: null,
                _eyeTap: null,          // in-flight single-finger tap
                _eyeLastTap: 0,         // timestamp of the previous completed tap
                _eyePinchDist(t) {
                    const dx = t[0].clientX - t[1].clientX, dy = t[0].clientY - t[1].clientY;
                    return Math.sqrt(dx * dx + dy * dy);
                },
                eyeTouchStart(e) {
                    if (!e.touches) return;
                    if (e.touches.length === 2) {
                        this._eyePinch = { d: this._eyePinchDist(e.touches), z: this.eyeZoom };
                        this._eyeTap = null;          // a pinch is never a tap
                        return;
                    }
                    this._eyePinch = null;
                    if (e.touches.length === 1) {
                        const t = e.touches[0];
                        this._eyeTap = { x: t.clientX, y: t.clientY, moved: false };
                    }
                },
                eyeTouchMove(e) {
                    if (this._eyePinch && e.touches && e.touches.length === 2) {
                        const d = this._eyePinchDist(e.touches);
                        if (!d || !this._eyePinch.d) return;
                        e.preventDefault();   // pinch owns the gesture; don't also scroll
                        this._eyeSetZoom(this._eyePinch.z * (d / this._eyePinch.d));
                        return;
                    }
                    // A finger that travels is a scroll/pan, not a tap.
                    if (this._eyeTap && e.touches && e.touches.length === 1) {
                        const t = e.touches[0];
                        if (Math.abs(t.clientX - this._eyeTap.x) > 10 || Math.abs(t.clientY - this._eyeTap.y) > 10) {
                            this._eyeTap.moved = true;
                        }
                    }
                },
                eyeTouchEnd(e) {
                    if (!e.touches || e.touches.length < 2) this._eyePinch = null;
                    const tap = this._eyeTap;
                    this._eyeTap = null;
                    if (!tap || tap.moved) { this._eyeLastTap = 0; return; }
                    const now = Date.now();
                    // Second clean tap within 300ms → treat as a double tap.
                    if (this._eyeLastTap && (now - this._eyeLastTap) < 300) {
                        this._eyeLastTap = 0;
                        this.eyeZoomReset();
                        return;
                    }
                    this._eyeLastTap = now;
                },

                closeEye() {
                    this.eyeOpen = false;
                    this._clearPdfBox('eyeLeafBox');
                },

                async openFullFile(p) {
                    const pid = p ? p.id : this.selectedPatientId;
                    if (!pid) {
                        this.showToast('Select a patient first', 'error');
                        return;
                    }
                    // Self-contained header — doesn't clobber the drawer's
                    // selected-patient state when opened straight from a card.
                    this.fullFilePatientName = p ? (p.name || '') : (this.patientName || '');
                    this.fullFilePatient     = p || null;
                    this.fullFileInfoOpen    = true;
                    this.fullFileHwCategory  = '';
                    this.fullFileHwIndex     = 0;
                    this.fullFileActive   = 'ff-sec-admission';
                    this.fullFileData     = { handwritten: [], documents: [], operative: false, discharge: false };
                    this.fullFileLoading  = true;
                    this.fullFileOpen     = true;
                    this.rightOpen        = false;

                    const hid = (this.me && this.me.hospital_id) || '';

                    try {
                        const resp = await fetch('./api/patients/' + encodeURIComponent(pid) + '/full-file', {
                            credentials: 'same-origin', headers: { 'Accept': 'application/json' },
                        });
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.fullFileData = {
                            handwritten: data.handwritten || [],
                            documents:   data.documents   || [],
                            operative:   !!data.operative,
                            discharge:   !!data.discharge,
                        };
                    } catch (e) {
                        plog('warn', 'fullfile', 'manifest load failed: ' + (e && e.message || e));
                        this.showToast('Could not load patient file', 'error');
                    }
                    this.fullFileLoading = false;

                    // Render the PDF sections once their DOM exists.
                    this.$nextTick(() => {
                        // 1. Admission Form — always available from cms (relative
                        // path resolves to the app-root cms route, shared session).
                        this._renderPdf('../cms/generate-admission-pdf?patient_id=' + encodeURIComponent(pid), 'ffAdmissionBox');

                        // 3. PDF documents — each into its own box.
                        (this.fullFileData.documents || []).forEach((d) => {
                            if (d.kind === 'pdf') { this._renderPdf(d.fileProxy, 'ffdoc-' + d.id); }
                        });

                        // 4. Operative Notes — cms inline stream (only if present).
                        if (this.fullFileData.operative) {
                            this._renderPdf(
                                this._ipdUrl('/cms/ajax/operative-notes-pdf-stream')
                                + '?patient_id=' + encodeURIComponent(pid)
                                + '&hospital_id=' + encodeURIComponent(hid)
                                + '&disposition=inline',
                                'ffOperativeBox'
                            );
                        }
                        // 5. Discharge Summary — cms preview PDF (report_type=4).
                        if (this.fullFileData.discharge) {
                            this._renderPdf(
                                this._ipdUrl('/cms/generate-discharge-summary-preview')
                                + '?patient_id=' + encodeURIComponent(pid)
                                + '&hospital_id=' + encodeURIComponent(hid)
                                + '&report_type=4&embed=1',
                                'ffDischargeBox'
                            );
                        }

                        // Section-nav highlight follows the scroll position.
                        const scroller = document.getElementById('ffScroll');
                        if (scroller && !scroller._ffBound) {
                            scroller._ffBound = true;
                            scroller.addEventListener('scroll', () => this._ffSyncActive());
                        }
                        if (window.lucide) { try { lucide.createIcons(); } catch (_) {} }
                    });
                    plog('info', 'fullfile', 'open patient_id=' + pid);
                },

                // Highlight the section nearest the top of the scroll viewport.
                _ffSyncActive() {
                    const scroller = document.getElementById('ffScroll');
                    if (!scroller) return;
                    const top = scroller.getBoundingClientRect().top;
                    let best = this.fullFileSections[0].id, bestDist = Infinity;
                    this.fullFileSections.forEach((s) => {
                        const el = document.getElementById(s.id);
                        if (!el) return;
                        const d = Math.abs(el.getBoundingClientRect().top - top - 8);
                        if (d < bestDist) { bestDist = d; best = s.id; }
                    });
                    this.fullFileActive = best;
                },

                scrollFullFile(id) {
                    this.fullFileActive = id;
                    const el = document.getElementById(id);
                    if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
                },

                // Distinct handwritten categories (with page counts) for the
                // Handwritten section's filter chips. Empty category → 'Uncategorized'.
                fullFileHwCategories() {
                    const map = {};
                    (this.fullFileData.handwritten || []).forEach((p) => {
                        const k = p.category || 'Uncategorized';
                        map[k] = (map[k] || 0) + 1;
                    });
                    return Object.keys(map).map((name) => ({ name, count: map[name] }));
                },

                // Handwritten pages filtered by the selected category chip
                // (empty selection = All).
                fullFileHandwrittenFiltered() {
                    const sel = this.fullFileHwCategory;
                    const all = this.fullFileData.handwritten || [];
                    if (!sel) { return all; }
                    return all.filter((p) => (p.category || 'Uncategorized') === sel);
                },

                // Current handwritten page for the one-at-a-time carousel
                // (clamped to the filtered list). null when there are none.
                fullFileHwCurrent() {
                    const list = this.fullFileHandwrittenFiltered();
                    if (!list.length) { return null; }
                    let i = this.fullFileHwIndex;
                    if (i < 0) { i = 0; }
                    if (i > list.length - 1) { i = list.length - 1; }
                    return list[i];
                },
                fullFileHwPrev() {
                    if (this.fullFileHwIndex > 0) { this.fullFileHwIndex--; }
                },
                fullFileHwNext() {
                    if (this.fullFileHwIndex < this.fullFileHandwrittenFiltered().length - 1) { this.fullFileHwIndex++; }
                },

                // Short gender label (1=M, 2=F, 3=O) for the floating details.
                ffGender(g) {
                    g = String(g);
                    return g === '1' ? 'M' : (g === '2' ? 'F' : (g === '3' ? 'O' : ''));
                },

                // Gender + age pill on the patient card: "F · 25" when age is
                // known, else the full gender word ("Female").
                genderAgePill(p) {
                    // Always use the full label (Male / Female / Other). When an age
                    // is present, append it after the full label ("Female · 25").
                    const g = String(p.gender || '');
                    const full = g === '1' ? 'Male' : (g === '2' ? 'Female' : (g === '3' ? 'Other' : ''));
                    if (p.age) { return (full ? full + ' · ' : '') + p.age; }
                    return full;
                },

                closeFullFile() {
                    this.fullFileOpen = false;
                    // Cancel any in-flight PDF renders bound to these boxes.
                    ['ffAdmissionBox', 'ffOperativeBox', 'ffDischargeBox'].forEach((b) => {
                        if (this._clearPdfBox) { this._clearPdfBox(b); }
                    });
                },

                // Reusable PDF viewer. Floats ON TOP of the main screen, leaving
                // any ongoing task untouched underneath; back / Esc returns to it.
                // opts: { title, url, headerClass, whatsapp, share }.
                openPdfViewer(opts) {
                    const o = opts || {};
                    this.pdfTitle        = o.title || 'PDF';
                    this.pdfUrl          = o.url || '';
                    this.pdfHeaderClass  = o.headerClass || 'bg-teal-600';
                    this.pdfShowWhatsapp = !!o.whatsapp;
                    this.pdfShowShare    = !!o.share;
                    this.pdfSignVisible  = !!o.sign;
                    this.waMenuOpen      = false;
                    this.rightOpen       = false;
                    this.pdfOpen         = true;
                    // Render straight into the viewer — no manual "open" step.
                    this.$nextTick(() => this._renderPdf(this.pdfUrl, 'pdfViewerBox'));
                },

                // Draw a PDF into the given box id with PDF.js, page by page (same
                // approach as _renderPdfInto for documents). Used by BOTH the
                // floating viewer (#pdfViewerBox) and the in-flow web pane
                // (#webPdfBox). A per-box monotonic token lets a quick switch /
                // close cancel an in-flight render so stale pages never land in it.
                async _renderPdf(url, boxId) {
                    boxId = boxId || 'pdfViewerBox';
                    const box = document.getElementById(boxId);
                    if (!box) return;
                    this._pdfTokens = this._pdfTokens || {};
                    const token = (this._pdfTokens[boxId] = (this._pdfTokens[boxId] || 0) + 1);
                    if (typeof pdfjsLib === 'undefined') {
                        box.innerHTML = '<div class="text-sm text-slate-500 py-8">PDF viewer unavailable</div>';
                        return;
                    }
                    box.innerHTML = '<div class="text-sm text-slate-500 py-8">Loading…</div>';
                    try {
                        if (!pdfjsLib.GlobalWorkerOptions.workerSrc) {
                            pdfjsLib.GlobalWorkerOptions.workerSrc =
                                'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
                        }
                        // Same-origin (the IPD app, same host) → cookies carry the
                        // session; withCredentials makes PDF.js send them.
                        const pdf = await pdfjsLib.getDocument({ url: url, withCredentials: true }).promise;
                        if (token !== this._pdfTokens[boxId]) return;   // superseded
                        box.innerHTML = '';
                        const maxW = Math.max(280, (box.clientWidth || 600) - 24);
                        for (let p = 1; p <= pdf.numPages; p++) {
                            const page = await pdf.getPage(p);
                            if (token !== this._pdfTokens[boxId]) return;
                            const base  = page.getViewport({ scale: 1 });
                            const scale = Math.min(2, maxW / base.width);
                            const vp    = page.getViewport({ scale });
                            const canvas = document.createElement('canvas');
                            canvas.width = vp.width; canvas.height = vp.height;
                            canvas.className = 'shadow bg-white max-w-full';
                            box.appendChild(canvas);
                            await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
                        }
                    } catch (e) {
                        if (token !== this._pdfTokens[boxId]) return;
                        box.innerHTML = '<div class="text-sm text-rose-600 py-8">Could not load PDF</div>';
                        plog('warn', 'pdf', 'render failed: ' + (e && e.message || e));
                    }
                },

                // Cancel an in-flight render for a box and empty it.
                _clearPdfBox(boxId) {
                    this._pdfTokens = this._pdfTokens || {};
                    this._pdfTokens[boxId] = (this._pdfTokens[boxId] || 0) + 1;
                    const box = document.getElementById(boxId);
                    if (box) box.innerHTML = '';
                },

                closePdfViewer() {
                    this.pdfOpen = false;
                    this.pdfUrl  = '';
                    this.waMenuOpen = false;
                    this._clearPdfBox('pdfViewerBox');
                },

                // POST to the IPD app's send-admission-card-whatsapp endpoint
                // (same shared session). The recipient is derived server-side
                // from the action_type — patient / relative / consultant /
                // referred doctor. Returns { code, msg }.
                async sendAdmissionWhatsapp(actionType) {
                    if (this.waSending) return;
                    const hospitalId = this.me && this.me.hospital_id;
                    if (!this.selectedPatientId || !hospitalId) {
                        this.showToast('Missing patient or hospital', 'error');
                        return;
                    }
                    this.waMenuOpen = false;
                    this.waSending = true;
                    this.showToast('Sending on WhatsApp…');
                    try {
                        const body = new URLSearchParams();
                        body.append('patient_id', this.selectedPatientId);
                        body.append('hospital_id', hospitalId);
                        body.append('action_type', actionType);
                        if (this.csrfToken) body.append('_token', this.csrfToken);
                        const resp = await fetch('../cms/ajax/send-admission-card-whatsapp', {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: Object.assign(
                                { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                            body: body.toString(),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap again', 'error'); return; }
                        const res = await resp.json().catch(() => ({}));
                        const ok  = res && Number(res.code) === 200;
                        this.showToast((res && (res.msg || res.message)) || (ok ? 'Sent' : 'Send failed'), ok ? 'success' : 'error');
                    } catch (e) {
                        plog('warn', 'admission', 'whatsapp send failed: ' + (e && e.message || e));
                        this.showToast('Something went wrong', 'error');
                    } finally {
                        this.waSending = false;
                    }
                },

                // Share the current PDF via the Web Share API — the actual file
                // when the platform supports file sharing, else the link.
                async sharePdf() {
                    this.waMenuOpen = false;
                    const title = this.pdfTitle || 'Document';
                    const abs   = new URL(this.pdfUrl, window.location.href).href;
                    try {
                        if (navigator.canShare) {
                            const resp = await fetch(abs, { credentials: 'same-origin' });
                            if (resp.ok) {
                                const blob = await resp.blob();
                                const file = new File([blob], 'document.pdf', { type: 'application/pdf' });
                                if (navigator.canShare({ files: [file] })) {
                                    await navigator.share({ files: [file], title });
                                    return;
                                }
                            }
                        }
                        if (navigator.share) {
                            await navigator.share({ title, url: abs });
                            return;
                        }
                        this.showToast('Sharing not supported on this device', 'error');
                    } catch (e) {
                        if (e && e.name === 'AbortError') return;   // user dismissed the sheet
                        plog('warn', 'pdf', 'share failed: ' + (e && e.message || e));
                        this.showToast('Could not share', 'error');
                    }
                },

                // Print the rendered PDF. The body class scopes the print
                // stylesheet to that box's canvases so nothing else is printed.
                printPdf()    { this.waMenuOpen = false; this._printWithClass('printing-pdf'); },     // floating viewer (#pdfViewerBox)
                printWebPdf() { this._printWithClass('printing-webpdf'); },                            // in-flow pane (#webPdfBox)
                _printWithClass(cls) {
                    document.body.classList.add(cls);
                    const cleanup = () => {
                        document.body.classList.remove(cls);
                        window.removeEventListener('afterprint', cleanup);
                    };
                    window.addEventListener('afterprint', cleanup);
                    try { window.print(); } catch (_) { cleanup(); }
                },

                // Gallery | Labs document-button tap. "Other Documents" opens the
                // image/PDF capture sheet (below); the rest are still placeholders
                // (no upload/list/link flow wired yet) and just acknowledge the tap.
                async openDoc(name) {
                    // App-tool upload rights (other_permissions; privileged roles
                    // bypass server-side). Audio + Video share one grant.
                    // `viewIfDenied` categories (p_id 65/64/43/102/31/27) let the user
                    // ENTER + VIEW uploaded files when the grant is missing — only
                    // the upload "+" is withheld (docUploadAllowed=false).
                    const DOC_RIGHTS = {
                        'Other Documents':    { flag: 'can_other_documents',   msg: 'You have not permission for Upload Other Documents.',           viewIfDenied: true },
                        'Laboratory Reports': { flag: 'can_lab_reports',        msg: 'You have not permission for Upload Laboratory Reports.',         viewIfDenied: true },
                        'Radiology Report':   { flag: 'can_radiology_reports',  msg: 'You have not permission for Upload Radiology (Laboratory) Report.', viewIfDenied: true },
                        'Cardiology Report':  { flag: 'can_cardiology_records', msg: 'You have not permission for Upload Cardiology Records.',        viewIfDenied: true },
                        'Audio Records':      { flag: 'can_audio_video',        msg: 'You have not permission for Upload Audio & Video Records.',      viewIfDenied: true },
                        'Video Records':      { flag: 'can_audio_video',        msg: 'You have not permission for Upload Audio & Video Records.',      viewIfDenied: true },
                        'Bill Records':       { flag: 'can_bill_records',        msg: 'You have not permission for Upload Billing Files.',              viewIfDenied: true },
                    };
                    // Patient (IPD) context — reset any register-book routing so the
                    // shared capture sheet uploads to pma_patient_notes1, not the gallery.
                    this.docContext = 'ipd';
                    const right   = DOC_RIGHTS[name];
                    const hasRight = !right || !!this.me[right.flag];
                    // No grant + not a view-allowed category → block entry (old behaviour).
                    if (right && !hasRight && !right.viewIfDenied) { this.showToast(right.msg, 'error'); return; }
                    // View-allowed but no grant → enter, but withhold upload.
                    this.docUploadAllowed = hasRight;
                    this.docUploadDenyMsg = (right && right.msg) || 'You have not permission to upload.';

                    const cfg = DOC_UPLOAD_CATEGORIES[name];
                    if (!cfg) { this.activeDoc = name || ''; this.showToast((name || 'Document') + ' — coming soon'); return; }
                    // Leaving a form being edited? Ask to save/discard first.
                    if (this._guardEditExit(() => this.openDoc(name))) return;
                    this.activeDoc = name || '';   // highlights this button's dot

                    this._clearHandWrittenSelection();   // leaving the Hand Written tab
                    // Documents and the form-page viewer share the main pane — only
                    // one at a time. Close the open form, any embedded web page,
                    // and any floating PDF viewer so the Documents view shows.
                    this.viewerOpen = false;
                    this.webOpen = false;
                    this.pdfOpen = false;
                    this.viewerMode = 'grid';
                    this.viewerActiveRecord = null;

                    // Switching to a different category → drop any files staged
                    // for the previous one so uploads can't cross categories.
                    if (this.docCatId && this.docCatId !== cfg.catId) {
                        this.docFiles.splice(0).forEach((f) => { if (f.url) { try { URL.revokeObjectURL(f.url); } catch (_) {} } });
                    }
                    this.docCatId = cfg.catId;
                    this.docSheetTitle = name;
                    this.docViewTitle = name;
                    this.docCatColor = cfg.color || '#0d9488';

                    // Show the main-window grid (with a spinner) while we check for
                    // past records: none → jump straight to capture (file picker or
                    // audio recorder); some → stay on the grid to review first.
                    this.rightOpen = false;
                    this.docViewMode = 'grid';
                    this.docViewOpen = true;
                    await this.loadDocExisting();
                    if (this.docExisting.length === 0) {
                        // View-only users (p_id 56, discharged/cancelled patients)
                        // and users lacking this category's upload grant don't get
                        // dropped into the capture flow for an empty category —
                        // leave them on the (empty) grid instead.
                        if (this.viewOnlyActive() || !this.docUploadAllowed) return;
                        this.docViewOpen = false;
                        if (cfg.kind === 'audio') this.openAudioRecorder();
                        else if (cfg.kind === 'video') this.openVideoRecorder();
                        else this.otherDocOpen = true;   // capture dialog (Image / PDF)
                    }
                },

                // Floating "+" on the documents grid → open the capture flow for
                // the category already being viewed (recorder for audio/video, else dialog).
                addDocUpload() {
                    if (this._checkReadOnly()) return;
                    // No upload grant for this category → view-only; refuse upload.
                    if (!this.docUploadAllowed) { this.showToast(this.docUploadDenyMsg, 'error'); return; }
                    if (this.docCatId === 1991) this.openAudioRecorder();
                    else if (this.docCatId === 1992) this.openVideoRecorder();
                    else this.otherDocOpen = true;
                },

                // ── Audio recorder (category 1991) ───────────────────────────
                get audioClock() {
                    const s = Math.max(0, this.audioRemaining);
                    const m = Math.floor(s / 60), ss = s % 60;
                    return m + ':' + (ss < 10 ? '0' : '') + ss;
                },
                openAudioRecorder() {
                    this._resetAudio();
                    this.audioRemaining = 300;
                    this.audioPhase = 'idle';
                    this.audioOpen = true;
                },
                _resetAudio() {
                    this._stopAudioTimer();
                    try { if (this._audioRec && this._audioRec.state !== 'inactive') this._audioRec.stop(); } catch (_) {}
                    this._stopAudioStream();
                    if (this.audioUrl) { try { URL.revokeObjectURL(this.audioUrl); } catch (_) {} }
                    this.audioUrl = ''; this._audioRec = null; this._audioChunks = [];
                    this._audioBlob = null; this.audioLabel = ''; this.audioLabelOpen = false;
                },
                _stopAudioTimer() { if (this._audioTimer) { clearInterval(this._audioTimer); this._audioTimer = null; } },
                _stopAudioStream() { if (this._audioStream) { try { this._audioStream.getTracks().forEach((t) => t.stop()); } catch (_) {} this._audioStream = null; } },
                _pickAudioMime() {
                    const types = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4', 'audio/ogg;codecs=opus', 'audio/ogg'];
                    for (const t of types) { if (window.MediaRecorder && MediaRecorder.isTypeSupported(t)) return t; }
                    return '';
                },
                async startAudioRec() {
                    try {
                        this._audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    } catch (e) {
                        plog('warn', 'audio', 'getUserMedia failed: ' + (e && e.message));
                        this.showToast('Microphone permission denied', 'error');
                        return;
                    }
                    this._audioChunks = [];
                    this._audioMime = this._pickAudioMime();
                    try {
                        this._audioRec = this._audioMime
                            ? new MediaRecorder(this._audioStream, { mimeType: this._audioMime })
                            : new MediaRecorder(this._audioStream);
                    } catch (_) { this._audioRec = new MediaRecorder(this._audioStream); }
                    this._audioRec.ondataavailable = (ev) => { if (ev.data && ev.data.size) this._audioChunks.push(ev.data); };
                    this._audioRec.onstop = () => this._finishAudio();
                    this._audioRec.start();
                    this.audioPhase = 'recording';
                    this._startAudioTimer();
                },
                _startAudioTimer() {
                    this._stopAudioTimer();
                    this._audioTimer = setInterval(() => {
                        if (this.audioPhase !== 'recording') return;
                        this.audioRemaining = Math.max(0, this.audioRemaining - 1);
                        if (this.audioRemaining <= 0) this.stopAudioRec();   // 5 min up
                    }, 1000);
                },
                pauseAudioRec() {
                    if (this._audioRec && this._audioRec.state === 'recording') {
                        try { this._audioRec.pause(); } catch (_) {}
                        this.audioPhase = 'paused';
                        this._stopAudioTimer();
                    }
                },
                resumeAudioRec() {
                    if (this._audioRec && this._audioRec.state === 'paused') {
                        try { this._audioRec.resume(); } catch (_) {}
                        this.audioPhase = 'recording';
                        this._startAudioTimer();
                    }
                },
                stopAudioRec() {
                    this._stopAudioTimer();
                    if (this._audioRec && this._audioRec.state !== 'inactive') {
                        try { this._audioRec.stop(); } catch (_) { this._finishAudio(); }
                    } else { this._finishAudio(); }
                },
                async _finishAudio() {
                    this._stopAudioStream();
                    const srcMime = (this._audioMime || 'audio/webm').split(';')[0];
                    const recorded = new Blob(this._audioChunks, { type: srcMime });
                    this._audioIsMp3 = false;

                    // Transcode the take to MP3 (128 kbps mono) so the saved file
                    // is compressed but voice-transparent. Falls back to the raw
                    // recording only if the encoder is unavailable/fails.
                    this.audioPhase = 'processing';
                    try {
                        this._audioBlob = await this._encodeMp3(recorded);
                        this._audioIsMp3 = true;
                    } catch (e) {
                        plog('warn', 'audio', 'MP3 encode failed, keeping original: ' + (e && e.message || e));
                        this._audioBlob = recorded;
                    }

                    if (this.audioUrl) { try { URL.revokeObjectURL(this.audioUrl); } catch (_) {} }
                    this.audioUrl = (this._audioBlob && this._audioBlob.size) ? URL.createObjectURL(this._audioBlob) : '';
                    this.audioPhase = 'done';
                    this.audioLabelOpen = true;   // ask for a label before upload
                },

                // Decode the recorded audio to PCM and re-encode as MP3 with lamejs
                // (mono, 128 kbps). Lossy container → MP3, but at a bitrate that is
                // transparent for speech, while cutting size hard.
                async _encodeMp3(blob) {
                    if (!window.lamejs || !lamejs.Mp3Encoder) throw new Error('lamejs not loaded');
                    const arr = await blob.arrayBuffer();
                    const AC = window.AudioContext || window.webkitAudioContext;
                    const ctx = new AC();
                    let audioBuf;
                    try {
                        audioBuf = await ctx.decodeAudioData(arr);
                    } finally { /* ctx closed below */ }

                    const sampleRate = audioBuf.sampleRate;     // 44100 / 48000 — both MP3-valid
                    // Mix down to mono.
                    const n = audioBuf.length;
                    const chs = audioBuf.numberOfChannels;
                    const mono = new Float32Array(n);
                    for (let c = 0; c < chs; c++) {
                        const d = audioBuf.getChannelData(c);
                        for (let i = 0; i < n; i++) mono[i] += d[i] / chs;
                    }
                    // Float (-1..1) → Int16 PCM.
                    const samples = new Int16Array(n);
                    for (let i = 0; i < n; i++) {
                        const s = Math.max(-1, Math.min(1, mono[i]));
                        samples[i] = s < 0 ? s * 0x8000 : s * 0x7FFF;
                    }
                    try { ctx.close(); } catch (_) {}

                    const enc = new lamejs.Mp3Encoder(1, sampleRate, 128);   // mono, 128 kbps
                    const block = 1152;
                    const out = [];
                    for (let i = 0; i < samples.length; i += block) {
                        const buf = enc.encodeBuffer(samples.subarray(i, i + block));
                        if (buf.length > 0) out.push(buf);
                    }
                    const end = enc.flush();
                    if (end.length > 0) out.push(end);
                    return new Blob(out, { type: 'audio/mpeg' });
                },
                cancelAudio() {
                    this._resetAudio();
                    this.audioOpen = false;
                    this.audioPhase = 'idle';
                },
                async saveAudioLabel() {
                    const label = (this.audioLabel || '').trim();
                    if (!label) { this.showToast('Please enter a label', 'error'); return; }
                    if (!this._audioBlob || !this._audioBlob.size) { this.showToast('No recording captured', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    if (this.audioUploading) return;
                    this.audioUploading = true;
                    try {
                        const ext = this._audioIsMp3 ? 'mp3'
                                  : (this._audioMime.indexOf('mp4') >= 0 ? 'mp4'
                                     : (this._audioMime.indexOf('ogg') >= 0 ? 'ogg' : 'webm'));
                        const fd = new FormData();
                        fd.append('file', this._audioBlob, 'audio_' + Date.now() + '.' + ext);
                        fd.append('category_type_id', 1991);
                        fd.append('note_remark', label);
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        const resp = await fetch('./api/patients/' + encodeURIComponent(this.selectedPatientId) + '/other-documents', {
                            method: 'POST', credentials: 'same-origin', body: fd,
                            headers: Object.assign({ 'Accept': 'application/json' }, this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap Save again', 'error'); this.audioUploading = false; return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        this.showToast('Audio saved', 'success');
                        this._resetAudio();
                        this.audioOpen = false;
                        if (this.selectedPatientId && this.patientsLive) this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                        // Show the audio grid (main window).
                        this.docCatId = 1991; this.docViewTitle = 'Audio Records'; this.docCatColor = '#7c3aed';
                        this.docViewMode = 'grid';
                        this.docViewOpen = true;
                        this.loadDocExisting();
                    } catch (e) {
                        plog('error', 'audio', 'upload failed: ' + (e && e.message || e));
                        this.showToast('Audio upload failed', 'error');
                    } finally {
                        this.audioUploading = false;
                    }
                },

                // ── Video recorder (category 1992) ───────────────────────────
                get videoClock() {
                    const s = Math.max(0, this.videoRemaining);
                    const m = Math.floor(s / 60), ss = s % 60;
                    return m + ':' + (ss < 10 ? '0' : '') + ss;
                },
                async openVideoRecorder() {
                    this._resetVideo();
                    this.videoRemaining = 180;
                    this.videoPhase = 'idle';
                    this.videoOpen = true;
                    await this._startVideoPreview();   // live camera preview before recording
                },
                _resetVideo() {
                    this._stopVideoTimer();
                    try { if (this._videoRec && this._videoRec.state !== 'inactive') this._videoRec.stop(); } catch (_) {}
                    this._stopVideoStream();
                    if (this.videoUrl) { try { URL.revokeObjectURL(this.videoUrl); } catch (_) {} }
                    this.videoUrl = ''; this._videoRec = null; this._videoChunks = [];
                    this._videoBlob = null; this.videoLabel = ''; this.videoLabelOpen = false;
                    this._videoBytes = 0; this.videoSizeMB = 0;
                },
                _stopVideoTimer() { if (this._videoTimer) { clearInterval(this._videoTimer); this._videoTimer = null; } },
                _stopVideoStream() { if (this._videoStream) { try { this._videoStream.getTracks().forEach((t) => t.stop()); } catch (_) {} this._videoStream = null; } },
                async _startVideoPreview() {
                    this._stopVideoStream();
                    try {
                        this._videoStream = await navigator.mediaDevices.getUserMedia({
                            video: { facingMode: { ideal: this.videoFacing }, width: { ideal: 1280 }, height: { ideal: 720 } },
                            audio: true,
                        });
                    } catch (e) {
                        plog('warn', 'video', 'getUserMedia failed: ' + (e && e.message));
                        this.showToast('Camera/mic permission denied', 'error');
                        this.videoOpen = false;
                        return;
                    }
                    this.$nextTick(() => {
                        const v = this.$refs.recVideo;
                        if (v) { v.srcObject = this._videoStream; v.muted = true; v.play().catch(() => {}); }
                    });
                },
                // Flip front/back — only between takes (idle), restarts the preview.
                async flipVideoCamera() {
                    if (this.videoPhase !== 'idle') return;
                    this.videoFacing = this.videoFacing === 'environment' ? 'user' : 'environment';
                    await this._startVideoPreview();
                },
                _pickVideoMime() {
                    const types = [
                        'video/mp4;codecs=h264,aac', 'video/mp4;codecs=avc1.640028,mp4a.40.2', 'video/mp4',
                        'video/webm;codecs=h264,opus', 'video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm',
                    ];
                    for (const t of types) { if (window.MediaRecorder && MediaRecorder.isTypeSupported(t)) return t; }
                    return '';
                },
                startVideoRec() {
                    if (!this._videoStream) { this.showToast('Camera not ready', 'error'); return; }
                    this._videoChunks = [];
                    this._videoBytes = 0;
                    this.videoSizeMB = 0;
                    this._videoMime = this._pickVideoMime();
                    this._videoExt = this._videoMime.indexOf('mp4') >= 0 ? 'mp4' : 'webm';
                    // Compress: ~1.4 Mbps video + 96 kbps audio → a full 3-min clip
                    // is ~34 MB, safely under the 40 MB cap.
                    const opts = { videoBitsPerSecond: 1400000, audioBitsPerSecond: 96000 };
                    if (this._videoMime) opts.mimeType = this._videoMime;
                    try { this._videoRec = new MediaRecorder(this._videoStream, opts); }
                    catch (_) { try { this._videoRec = new MediaRecorder(this._videoStream); } catch (e) { this.showToast('Recording not supported', 'error'); return; } }

                    // 40 MB hard cap — auto-stop a touch early (38.5 MB) so the final
                    // file, after the closing flush, is always ≤ 40 MB.
                    const CAP_BYTES = Math.round(38.5 * 1024 * 1024);
                    this._videoRec.ondataavailable = (ev) => {
                        if (ev.data && ev.data.size) {
                            this._videoChunks.push(ev.data);
                            this._videoBytes += ev.data.size;
                            this.videoSizeMB = +(this._videoBytes / (1024 * 1024)).toFixed(1);
                            if (this._videoBytes >= CAP_BYTES && this.videoPhase === 'recording') {
                                this.showToast('Reached the 40 MB limit — stopping', 'success');
                                this.stopVideoRec();
                            }
                        }
                    };
                    this._videoRec.onstop = () => this._finishVideo();
                    this._videoRec.start(1000);   // 1s timeslice so size is tracked live
                    this.videoPhase = 'recording';
                    this._startVideoTimer();
                },
                _startVideoTimer() {
                    this._stopVideoTimer();
                    this._videoTimer = setInterval(() => {
                        if (this.videoPhase !== 'recording') return;
                        this.videoRemaining = Math.max(0, this.videoRemaining - 1);
                        if (this.videoRemaining <= 0) this.stopVideoRec();   // 3 min up
                    }, 1000);
                },
                pauseVideoRec() {
                    if (this._videoRec && this._videoRec.state === 'recording') {
                        try { this._videoRec.pause(); } catch (_) {}
                        this.videoPhase = 'paused';
                        this._stopVideoTimer();
                    }
                },
                resumeVideoRec() {
                    if (this._videoRec && this._videoRec.state === 'paused') {
                        try { this._videoRec.resume(); } catch (_) {}
                        this.videoPhase = 'recording';
                        this._startVideoTimer();
                    }
                },
                stopVideoRec() {
                    this._stopVideoTimer();
                    if (this._videoRec && this._videoRec.state !== 'inactive') {
                        try { this._videoRec.stop(); } catch (_) { this._finishVideo(); }
                    } else { this._finishVideo(); }
                },
                _finishVideo() {
                    this._stopVideoStream();   // release the camera
                    const mime = (this._videoMime || 'video/mp4').split(';')[0];
                    this._videoBlob = new Blob(this._videoChunks, { type: mime });
                    if (this.videoUrl) { try { URL.revokeObjectURL(this.videoUrl); } catch (_) {} }
                    this.videoUrl = this._videoBlob.size ? URL.createObjectURL(this._videoBlob) : '';
                    this.videoPhase = 'done';
                    this.videoLabelOpen = true;   // ask for a label before upload
                },
                cancelVideo() {
                    this._resetVideo();
                    this.videoOpen = false;
                    this.videoPhase = 'idle';
                },
                // Grab a poster frame (~1s in) from the recorded clip as a JPEG,
                // resized to ≤640px. Returns null on any failure (non-fatal).
                _captureVideoThumbnail(blob) {
                    return new Promise((resolve) => {
                        let done = false;
                        const finish = (r) => { if (!done) { done = true; try { URL.revokeObjectURL(url); } catch (_) {} resolve(r); } };
                        let url = '';
                        try {
                            url = URL.createObjectURL(blob);
                            const v = document.createElement('video');
                            v.muted = true; v.playsInline = true; v.preload = 'metadata'; v.src = url;
                            const grab = () => {
                                try {
                                    const w = v.videoWidth, h = v.videoHeight;
                                    if (!w || !h) return finish(null);
                                    const scale = Math.min(1, 640 / Math.max(w, h));
                                    const cw = Math.round(w * scale), ch = Math.round(h * scale);
                                    const c = document.createElement('canvas'); c.width = cw; c.height = ch;
                                    c.getContext('2d').drawImage(v, 0, 0, cw, ch);
                                    c.toBlob((b) => finish(b), 'image/jpeg', 0.8);
                                } catch (_) { finish(null); }
                            };
                            v.onloadeddata = () => {
                                const t = (v.duration && isFinite(v.duration) && v.duration > 1.2) ? 1.0 : 0;
                                if (t > 0) { try { v.currentTime = t; } catch (_) { grab(); } } else { grab(); }
                            };
                            v.onseeked = grab;
                            v.onerror = () => finish(null);
                            setTimeout(() => finish(null), 4000);   // safety timeout
                        } catch (_) { finish(null); }
                    });
                },
                async saveVideoLabel() {
                    const label = (this.videoLabel || '').trim();
                    if (!label) { this.showToast('Please enter a label', 'error'); return; }
                    if (!this._videoBlob || !this._videoBlob.size) { this.showToast('No recording captured', 'error'); return; }
                    if (this._videoBlob.size > 40 * 1024 * 1024) { this.showToast('Recording exceeds the 40 MB limit', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }
                    if (this.videoUploading) return;
                    this.videoUploading = true;
                    try {
                        // Generate + attach a poster thumbnail (best-effort).
                        const thumb = await this._captureVideoThumbnail(this._videoBlob);
                        const fd = new FormData();
                        fd.append('file', this._videoBlob, 'video_' + Date.now() + '.' + (this._videoExt || 'mp4'));
                        if (thumb) fd.append('thumbnail', thumb, 'thumb_' + Date.now() + '.jpg');
                        fd.append('category_type_id', 1992);
                        fd.append('note_remark', label);
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        const resp = await fetch('./api/patients/' + encodeURIComponent(this.selectedPatientId) + '/other-documents', {
                            method: 'POST', credentials: 'same-origin', body: fd,
                            headers: Object.assign({ 'Accept': 'application/json' }, this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap Save again', 'error'); this.videoUploading = false; return; }
                        if (resp.status === 413) { this.showToast('Video too large for the server limit', 'error'); this.videoUploading = false; return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        this.showToast('Video saved', 'success');
                        this._resetVideo();
                        this.videoOpen = false;
                        if (this.selectedPatientId && this.patientsLive) this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                        this.docCatId = 1992; this.docViewTitle = 'Video Records'; this.docCatColor = '#0891b2';
                        this.docViewMode = 'grid';
                        this.docViewOpen = true;
                        this.loadDocExisting();
                    } catch (e) {
                        plog('error', 'video', 'upload failed: ' + (e && e.message || e));
                        this.showToast('Video upload failed', 'error');
                    } finally {
                        this.videoUploading = false;
                    }
                },

                // Fetch the patient's already-uploaded files for the active
                // category and show them in the thumbnail grid.
                async loadDocExisting() {
                    this.docExisting = [];
                    this._pdfRendered = {};
                    // Drop any stale multi-select state from a previous category.
                    this.docSelectMode = false;
                    this.docSelectedIds = [];
                    if (!this.selectedPatientId || !this.docCatId) return;
                    this.docExistingLoading = true;
                    try {
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                            + '/other-documents?category_type_id=' + encodeURIComponent(this.docCatId),
                            { credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' } }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const data = await resp.json();
                        this.docExisting = Array.isArray(data && data.items) ? data.items : [];
                    } catch (e) {
                        plog('warn', 'other-docs', 'loadDocExisting failed: ' + (e && e.message || e));
                        this.docExisting = [];
                    } finally {
                        this.docExistingLoading = false;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    }
                },

                // ── Other Documents: collect image / PDF files ──────────────
                // Capture-only for now; the actual upload is a TODO (see
                // submitOtherDocuments). Files are held in this.docFiles with a
                // blob + preview object URL until upload is wired.

                closeOtherDoc() {
                    this.otherDocOpen = false;
                    this.otherDocImageOpen = false;
                },

                async _addDocFile(file, kind) {
                    if (!file) return;
                    // Compress images (device photos / camera / scans) before they're
                    // held or uploaded — smaller files, still sharp for documents.
                    if (kind === 'image') {
                        file = await this._compressImage(file);
                    }
                    const url = (kind === 'image') ? URL.createObjectURL(file) : '';
                    this.docFiles.push({
                        id: 'doc_' + Date.now() + '_' + Math.round(performance.now()) + '_' + this.docFiles.length,
                        kind,
                        name: file.name || (kind === 'image' ? 'scan.jpg' : 'document.pdf'),
                        size: file.size || 0,
                        url,
                        blob: file,
                    });
                },

                // Downscale (long edge → MAX_DIM) + re-encode as JPEG at a quality
                // that keeps document text crisp while cutting file size hard.
                // Leaves non-raster types (SVG/GIF) and already-small images alone,
                // and falls back to the original file on any failure.
                async _compressImage(file, maxDim = 2200, quality = 0.85) {
                    if (!file || !/^image\//i.test(file.type || '')) return file;
                    if (/svg|gif/i.test(file.type)) return file;   // don't rasterize these
                    const url = URL.createObjectURL(file);
                    try {
                        const img = await new Promise((resolve, reject) => {
                            const im = new Image();
                            im.onload = () => resolve(im);
                            im.onerror = reject;
                            im.src = url;
                        });
                        const w = img.naturalWidth || img.width;
                        const h = img.naturalHeight || img.height;
                        if (!w || !h) return file;

                        const scale = Math.min(1, maxDim / Math.max(w, h));
                        const ow = Math.round(w * scale), oh = Math.round(h * scale);
                        const canvas = document.createElement('canvas');
                        canvas.width = ow; canvas.height = oh;
                        const ctx = canvas.getContext('2d');
                        ctx.imageSmoothingEnabled = true;
                        ctx.imageSmoothingQuality = 'high';
                        ctx.drawImage(img, 0, 0, ow, oh);

                        const blob = await new Promise((res) => canvas.toBlob(res, 'image/jpeg', quality));
                        if (!blob) return file;
                        // If it wasn't downscaled and compression didn't help, keep the original.
                        if (scale === 1 && blob.size >= (file.size || Infinity)) return file;

                        const base = (file.name || 'image').replace(/\.[^.]+$/i, '');
                        return new File([blob], base + '.jpg', { type: 'image/jpeg', lastModified: Date.now() });
                    } catch (_) {
                        return file;
                    } finally {
                        try { URL.revokeObjectURL(url); } catch (_) {}
                    }
                },

                removeDocFile(id) {
                    const i = this.docFiles.findIndex((d) => d.id === id);
                    if (i < 0) return;
                    const f = this.docFiles[i];
                    if (f.url) { try { URL.revokeObjectURL(f.url); } catch (_) {} }
                    this.docFiles.splice(i, 1);
                },

                // ── Full-screen file preview ─────────────────────────────────
                // Works over two lists: 'staged' (docFiles, local blobs not yet
                // uploaded) and 'existing' (docExisting, already-uploaded files
                // with presigned URLs). Prev/Next steps through whichever list
                // the preview was opened from.
                _previewItems() {
                    return this.previewMode === 'existing' ? this.docExisting : this.docFiles;
                },
                openDocPreview(item) {            // staged file
                    this.previewMode = 'staged';
                    const i = this.docFiles.findIndex((d) => d.id === (item && item.id));
                    if (i < 0) return;
                    this._showPreviewAt(i);
                },
                openExistingPreview(item) {       // already-uploaded file
                    this.previewMode = 'existing';
                    const i = this.docExisting.findIndex((d) => d.id === (item && item.id));
                    if (i < 0) return;
                    this._showPreviewAt(i);
                },
                _showPreviewAt(i) {
                    this._revokePreviewUrl();
                    const item = this._previewItems()[i];
                    if (!item) { this.closeDocPreview(); return; }
                    this.docPreviewIndex = i;
                    if (this.previewMode === 'existing') {
                        // Server files already carry a presigned URL (image + pdf).
                        this.docPreviewUrl = item.url || '';
                        this._previewOwnsUrl = false;
                    } else if (item.kind === 'pdf') {
                        this.docPreviewUrl = item.blob ? URL.createObjectURL(item.blob) : '';
                        this._previewOwnsUrl = !!this.docPreviewUrl;
                    } else {
                        this.docPreviewUrl = item.url || (item.blob ? URL.createObjectURL(item.blob) : '');
                        this._previewOwnsUrl = !item.url;   // only revoke a URL we created
                    }
                    this.docPreview = item;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                docPreviewNext() {
                    if (this.docPreviewIndex < this._previewItems().length - 1) this._showPreviewAt(this.docPreviewIndex + 1);
                },
                docPreviewPrev() {
                    if (this.docPreviewIndex > 0) this._showPreviewAt(this.docPreviewIndex - 1);
                },
                removeFromPreview() {            // staged files only
                    if (!this.docPreview || this.previewMode !== 'staged') return;
                    const i = this.docPreviewIndex;
                    this.removeDocFile(this.docPreview.id);
                    if (this.docFiles.length === 0) { this.closeDocPreview(); return; }
                    this._showPreviewAt(Math.min(i, this.docFiles.length - 1));
                },
                closeDocPreview() {
                    this._revokePreviewUrl();
                    this.docPreview = null;
                    this.docPreviewIndex = -1;
                    this.previewMode = 'staged';
                },
                _revokePreviewUrl() {
                    if (this._previewOwnsUrl && this.docPreviewUrl) {
                        try { URL.revokeObjectURL(this.docPreviewUrl); } catch (_) {}
                    }
                    this.docPreviewUrl = '';
                    this._previewOwnsUrl = false;
                },

                // Lazy, dedicated inputs so these never collide with the canvas
                // image-insert input (_fileInput / _cameraInput).
                _docInput(refKey, accept, multiple, capture, kind) {
                    if (this[refKey]) return this[refKey];
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = accept;
                    if (multiple) input.multiple = true;
                    if (capture) input.capture = 'environment';
                    input.style.display = 'none';
                    input.addEventListener('change', () => {
                        const files = Array.from(input.files || []);
                        input.value = '';
                        if (!files.length) return;
                        // Images (device files AND camera) get the crop step first,
                        // one file at a time; PDFs are added as-is.
                        if (kind === 'image') { this._cropDocImages(files); return; }
                        files.forEach((f) => this._addDocFile(f, kind));
                        this.showToast(files.length + ' file(s) added', 'success');
                    });
                    document.body.appendChild(input);
                    this[refKey] = input;
                    return input;
                },

                // Crop every picked / captured document image before it joins the
                // upload tray. Multi-select is walked one file at a time: crop the
                // first, it lands in the tray, the next one opens — Cancel skips
                // just that image and keeps the queue moving. Used by BOTH the
                // patient Other Documents sheet and the Register Book / Audit
                // galleries (they share this sheet via docContext).
                _cropDocImages(files) {
                    this._docCropQueue = files.slice();
                    let added = 0;
                    const next = () => {
                        const f = (this._docCropQueue || []).shift();
                        if (!f) {
                            this._docCropQueue = null;
                            if (added) this.showToast(added + ' file(s) added', 'success');
                            return;
                        }
                        this._openCropper(
                            f,
                            (blob) => {
                                const base = String(f.name || 'image').replace(/\.[^.]+$/, '');
                                const file = new File([blob], base + '.png', { type: 'image/png' });
                                // _addDocFile compresses + stages; wait so the tray
                                // order matches the order the pages were cropped.
                                Promise.resolve(this._addDocFile(file, 'image'))
                                    .then(() => { added++; })
                                    .catch(() => {})
                                    .then(next);
                            },
                            next                      // cancelled / unreadable → skip it
                        );
                    };
                    next();
                },

                pickDocImages() {            // single OR multiple from the device
                    this.otherDocImageOpen = false;
                    this._docInput('_docImgInput', 'image/*', true, false, 'image').click();
                },
                captureDocPhoto() {          // single photo from the camera
                    this.otherDocImageOpen = false;
                    this._docInput('_docCamInput', 'image/*', false, true, 'image').click();
                },
                pickDocPdfs() {              // one or more PDF files
                    this._docInput('_docPdfInput', 'application/pdf', true, false, 'pdf').click();
                },

                // ── Document Scanner (full-screen camera; auto + manual capture) ──
                // `context` decides where the finished page goes: 'doc' (default,
                // the Other Documents upload sheet) or an editor key — 'ipd',
                // 'rb', 'af', 'tpl' — which drops the scan straight into that
                // editor's placement overlay. Everything else (live camera,
                // Auto/Manual, corner crop, enhancement) is identical.
                async openScanner(context) {
                    this.otherDocImageOpen = false;
                    this.scanContext = context || 'doc';
                    this.scanPhase = 'live';
                    this.scanImgUrl = '';
                    this.scanSteadyPct = 0;
                    this.scanFilter = 'none';    // enhancement always starts off
                    this.scanOpen = true;
                    try {
                        // Ask for a high resolution so scans are crisp.
                        this._scanStream = await navigator.mediaDevices.getUserMedia({
                            video: {
                                facingMode: { ideal: 'environment' },
                                width: { ideal: 1920 }, height: { ideal: 1080 },
                            },
                            audio: false,
                        });
                        this.$nextTick(() => {
                            const v = this.$refs.scanVideo;
                            if (v) { v.srcObject = this._scanStream; v.play().catch(() => {}); }
                            this._startScanLoop();   // detection runs in both modes
                        });
                    } catch (err) {
                        plog('warn', 'scanner', 'getUserMedia failed: ' + (err && err.message));
                        this.scanOpen = false;
                        // No camera (e.g. desktop) → fall back to the OS camera /
                        // file picker of whoever opened the scanner.
                        this._scanFallbackCapture();
                    }
                },

                // Camera unavailable → the plain capture path for this context
                // (which still goes through the crop step for the editors).
                _scanFallbackCapture() {
                    switch (this.scanContext) {
                        case 'ipd': this.captureFromCamera(); break;
                        case 'rb':  this.rbCaptureCamera();   break;
                        case 'af':  this.afCaptureCamera();   break;
                        case 'tpl': this.tplCaptureCamera();  break;
                        default:    this.captureDocPhoto();
                    }
                },

                // Stack the scanner above whichever surface opened it: the editors
                // are full-screen overlays in the 90s, the RB/Audit document sheets
                // sit at 114/116, and the crop overlay owns 130.
                _scanZClass() {
                    if (this.scanContext && this.scanContext !== 'doc') return 'z-[128]';
                    return (this.docContext === 'rb' || this.docContext === 'audit') ? 'z-[116]' : 'z-[90]';
                },

                _stopScanStream() {
                    if (this._scanStream) {
                        try { this._scanStream.getTracks().forEach((t) => t.stop()); } catch (_) {}
                        this._scanStream = null;
                    }
                },

                // Switch Auto ↔ Manual capture while the camera is live. The
                // detection loop runs in BOTH modes — Manual still gets the live
                // outline and still captures cropped to the detected page.
                setScanMode(mode) {
                    this.scanMode = mode === 'manual' ? 'manual' : 'auto';
                    this._scanSteady = 0;
                    this.scanSteadyPct = 0;
                    if (this.scanOpen && this.scanPhase === 'live' && !this._scanAutoTimer) {
                        this._startScanLoop();
                    }
                },

                // ── live page detection + auto capture ────────────────────────
                // ~7×/s: find the page in the frame (see _detectPageQuad), show it
                // as the blue outline, and in AUTO mode fire the capture once that
                // quad has held still for ~1s. Capturing "whatever is in frame" is
                // only the last-resort fallback, after ~8s of steady-but-undetected
                // view — otherwise a page that just won't detect would trap the
                // user in the live view forever.
                _startScanLoop() {
                    this._stopScanLoop();
                    this._scanSteady = 0;
                    this._scanNoDetect = 0;
                    this.scanQuad = null;
                    const NEED = 6;             // ~0.85s of a stable detected quad
                    const BLIND = 55;           // ~8s before the whole-frame fallback

                    this._scanAutoTimer = setInterval(() => {
                        if (this.scanPhase !== 'live' || !this.scanOpen) return;
                        const v = this.$refs.scanVideo;
                        if (!v || !v.videoWidth) return;

                        const quad = this._detectPageQuad(v);
                        if (quad) {
                            // Stable = every corner within ~1.5% of the frame of
                            // where it was last tick (hand-shake tolerance).
                            const prev = this._scanQuadPrev;
                            let stable = false;
                            if (prev) {
                                let worst = 0;
                                for (let i = 0; i < 4; i++) {
                                    worst = Math.max(worst, Math.hypot(quad[i].x - prev[i].x, quad[i].y - prev[i].y));
                                }
                                stable = worst < 0.015;
                            }
                            this._scanQuadPrev = quad;
                            this.scanQuad = quad;
                            this._scanNoDetect = 0;
                            this._scanSteady = stable ? this._scanSteady + 1 : 0;
                            this.scanSteadyPct = Math.min(100, Math.round(this._scanSteady / NEED * 100));
                            if (this.scanMode === 'auto' && this._scanSteady >= NEED) {
                                this._stopScanLoop();
                                this.captureScanFrame();
                            }
                            return;
                        }

                        // No page found this tick.
                        this._scanQuadPrev = null;
                        this.scanQuad = null;
                        this._scanSteady = 0;
                        this.scanSteadyPct = 0;
                        this._scanNoDetect = (this._scanNoDetect || 0) + 1;
                        if (this.scanMode === 'auto' && this._scanNoDetect >= BLIND) {
                            this._stopScanLoop();
                            this.showToast('Page edges not found — captured the full frame. Drag the corners to the page.', 'error');
                            this.captureScanFrame();
                        }
                    }, 145);
                },

                // Find the page in a video frame and return its 4 corners as
                // fractions of the frame, ordered TL, TR, BR, BL (the order the
                // perspective warp expects). Pure JS, no OpenCV:
                //   1. shrink the frame to 160×120 grayscale — the page's own text
                //      disappears at that size, leaving paper vs background,
                //   2. Otsu-threshold into bright (paper) / dark (desk),
                //   3. keep the largest connected bright blob,
                //   4. its extremes along x+y and x−y are the quad's corners
                //      (the standard trick — works for a rotated page too),
                //   5. reject the result unless it really looks like a page:
                //      big enough, convex, and the quad actually FILLS the blob
                //      (so a hand, a lamp or a white wall doesn't pass).
                // Returns null when nothing convincing is in frame.
                _detectPageQuad(v) {
                    const DW = 160, DH = 120, N = DW * DH;
                    if (!this._scanDetCtx) {
                        const cv = document.createElement('canvas');
                        cv.width = DW; cv.height = DH;
                        this._scanDetCtx = cv.getContext('2d', { willReadFrequently: true });
                    }
                    const ctx = this._scanDetCtx;
                    let px;
                    try {
                        ctx.drawImage(v, 0, 0, DW, DH);
                        px = ctx.getImageData(0, 0, DW, DH).data;
                    } catch (_) { return null; }

                    // 1. grayscale + histogram
                    const g = new Uint8Array(N);
                    const hist = new Int32Array(256);
                    for (let i = 0; i < N; i++) {
                        const o = i * 4;
                        const y = (px[o] * 0.299 + px[o + 1] * 0.587 + px[o + 2] * 0.114) | 0;
                        g[i] = y; hist[y]++;
                    }

                    // 2. Otsu threshold
                    let total = 0;
                    for (let t = 0; t < 256; t++) total += t * hist[t];
                    let sumB = 0, wB = 0, best = -1, thr = 128, mBb = 0, mFb = 0;
                    for (let t = 0; t < 256; t++) {
                        wB += hist[t];
                        if (!wB) continue;
                        const wF = N - wB;
                        if (!wF) break;
                        sumB += t * hist[t];
                        const mB = sumB / wB, mF = (total - sumB) / wF;
                        const between = wB * wF * (mB - mF) * (mB - mF);
                        if (between > best) { best = between; thr = t; mBb = mB; mFb = mF; }
                    }
                    // Paper must be clearly brighter than the surface it lies on.
                    if (mFb - mBb < 26) return null;

                    // 3a. Close the bright mask (dilate → erode, 3×3). Printed
                    //     lines and handwriting punch dark holes in the paper;
                    //     without this the page fragments into hundreds of tiny
                    //     blobs and the largest one is a scrap between two lines.
                    //     Closing preserves the outer page boundary. Out-of-frame
                    //     neighbours are skipped, so a page running off the edge
                    //     doesn't get eroded away.
                    const bright = new Uint8Array(N);
                    for (let i = 0; i < N; i++) bright[i] = g[i] > thr ? 1 : 0;
                    const dil = new Uint8Array(N), mask = new Uint8Array(N);
                    const morph = (src, dst, dilate) => {
                        const seek = dilate ? 0 : 1;        // value we're still looking to flip
                        for (let y = 0; y < DH; y++) {
                            for (let x = 0; x < DW; x++) {
                                let hit = seek;
                                for (let dy = -1; dy <= 1 && hit === seek; dy++) {
                                    const yy = y + dy;
                                    if (yy < 0 || yy >= DH) continue;
                                    for (let dx = -1; dx <= 1; dx++) {
                                        const xx = x + dx;
                                        if (xx < 0 || xx >= DW) continue;
                                        const v = src[yy * DW + xx];
                                        if (dilate) { if (v) { hit = 1; break; } }
                                        else if (!v) { hit = 0; break; }
                                    }
                                }
                                dst[y * DW + x] = hit;
                            }
                        }
                    };
                    morph(bright, dil, true);
                    morph(dil, mask, false);

                    // 3b. largest connected component of the mask (4-neighbour
                    //     flood fill with an explicit stack — no recursion).
                    const lab = new Int32Array(N);          // 0 = unvisited
                    const stack = new Int32Array(N);
                    let bestId = 0, bestSize = 0, bestSeed = -1, id = 0;
                    for (let s = 0; s < N; s++) {
                        if (lab[s] || !mask[s]) continue;
                        id++;
                        let sp = 0, size = 0;
                        stack[sp++] = s; lab[s] = id;
                        while (sp > 0) {
                            const p = stack[--sp];
                            size++;
                            const x = p % DW, y = (p / DW) | 0;
                            if (x > 0      && !lab[p - 1]  && mask[p - 1])  { lab[p - 1]  = id; stack[sp++] = p - 1; }
                            if (x < DW - 1 && !lab[p + 1]  && mask[p + 1])  { lab[p + 1]  = id; stack[sp++] = p + 1; }
                            if (y > 0      && !lab[p - DW] && mask[p - DW]) { lab[p - DW] = id; stack[sp++] = p - DW; }
                            if (y < DH - 1 && !lab[p + DW] && mask[p + DW]) { lab[p + DW] = id; stack[sp++] = p + DW; }
                        }
                        if (size > bestSize) { bestSize = size; bestId = id; bestSeed = s; }
                    }
                    if (bestSeed < 0) return null;
                    // A page fills a real part of the view, but "everything is
                    // bright" means we're looking at a wall, not a document.
                    if (bestSize < N * 0.12 || bestSize > N * 0.97) return null;

                    // 4. corners = extremes of (x+y) and (x−y) within the blob
                    let tl = 0, tr = 0, br = 0, bl = 0;
                    let sMin = Infinity, sMax = -Infinity, dMin = Infinity, dMax = -Infinity;
                    for (let p = 0; p < N; p++) {
                        if (lab[p] !== bestId) continue;
                        const x = p % DW, y = (p / DW) | 0;
                        const sum = x + y, dif = x - y;
                        if (sum < sMin) { sMin = sum; tl = p; }
                        if (sum > sMax) { sMax = sum; br = p; }
                        if (dif > dMax) { dMax = dif; tr = p; }
                        if (dif < dMin) { dMin = dif; bl = p; }
                    }
                    const pt = (p) => ({ x: (p % DW) + 0.5, y: ((p / DW) | 0) + 0.5 });
                    const q = [pt(tl), pt(tr), pt(br), pt(bl)];

                    // 5. sanity: convex, not degenerate, and it must cover the blob.
                    const cross = (o, a, b) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
                    let sign = 0;
                    for (let i = 0; i < 4; i++) {
                        const c = cross(q[i], q[(i + 1) % 4], q[(i + 2) % 4]);
                        if (Math.abs(c) < 1) return null;             // collinear corners
                        const s = c > 0 ? 1 : -1;
                        if (!sign) sign = s; else if (s !== sign) return null;   // concave
                    }
                    const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
                    const minSide = Math.min(dist(q[0], q[1]), dist(q[1], q[2]), dist(q[2], q[3]), dist(q[3], q[0]));
                    if (minSide < DW * 0.18) return null;             // too thin to be a page
                    let area2 = 0;
                    for (let i = 0; i < 4; i++) {
                        const a = q[i], b = q[(i + 1) % 4];
                        area2 += a.x * b.y - b.x * a.y;
                    }
                    const quadArea = Math.abs(area2) / 2;
                    // The quad must MATCH the blob, both ways: much smaller and the
                    // blob isn't a quadrilateral (a hand, a plate — a circle scores
                    // ~1.6); much larger and the corners are noise.
                    const fillRatio = bestSize / quadArea;
                    if (quadArea < 1 || fillRatio < 0.75 || fillRatio > 1.25) return null;

                    return q.map((c) => ({ x: c.x / DW, y: c.y / DH }));
                },

                // Detected quad → polygon points in the video element's own box,
                // undoing object-cover (the feed is cropped to fill the screen, so
                // frame fractions are NOT element fractions).
                scanQuadPoints() {
                    const q = this.scanQuad;
                    if (!q || q.length !== 4) return '';
                    let ox = 0, oy = 0, sw = 100, sh = 100;
                    const v = this.$refs.scanVideo;
                    if (v && v.videoWidth && v.clientWidth) {
                        const ew = v.clientWidth, eh = v.clientHeight;
                        const s = Math.max(ew / v.videoWidth, eh / v.videoHeight);   // object-cover
                        const dw = v.videoWidth * s, dh = v.videoHeight * s;
                        ox = (ew - dw) / 2 / ew * 100; sw = dw / ew * 100;
                        oy = (eh - dh) / 2 / eh * 100; sh = dh / eh * 100;
                    }
                    return q.map((c) => (ox + c.x * sw).toFixed(2) + ',' + (oy + c.y * sh).toFixed(2)).join(' ');
                },

                _stopScanLoop() {
                    if (this._scanAutoTimer) { clearInterval(this._scanAutoTimer); this._scanAutoTimer = null; }
                    this._scanQuadPrev = null;
                    this._scanSteady = 0;
                    this._scanNoDetect = 0;
                },

                closeScanner() {
                    this._stopScanLoop();
                    this._stopScanStream();
                    if (this.scanImgUrl) { try { URL.revokeObjectURL(this.scanImgUrl); } catch (_) {} }
                    if (this.scanPreviewUrl) { try { URL.revokeObjectURL(this.scanPreviewUrl); } catch (_) {} }
                    this.scanImgUrl = '';
                    this.scanPreviewUrl = '';
                    this._scanSrc = null;
                    this._scanWarped = null;
                    this._scanFiltered = null;
                    this.scanSteadyPct = 0;
                    this.scanQuad = null;
                    this.scanOpen = false;
                    this.scanPhase = 'live';
                },

                // Grab the current video frame at full sensor resolution, freeze it,
                // and seed the crop corners from the DETECTED page (both Auto and
                // Manual) — a small outward margin keeps the page edge itself inside
                // the quad. Only when nothing was detected does it fall back to the
                // old inset box for the user to drag.
                captureScanFrame() {
                    const v = this.$refs.scanVideo;
                    if (!v || !v.videoWidth) { this.showToast('Camera not ready yet', 'error'); return; }
                    const quad = this.scanQuad;
                    this._stopScanLoop();
                    const c = document.createElement('canvas');
                    c.width = v.videoWidth;
                    c.height = v.videoHeight;
                    c.getContext('2d').drawImage(v, 0, 0, c.width, c.height);
                    this._scanSrc = c;
                    c.toBlob((b) => {
                        if (this.scanImgUrl) { try { URL.revokeObjectURL(this.scanImgUrl); } catch (_) {} }
                        this.scanImgUrl = b ? URL.createObjectURL(b) : '';
                    }, 'image/jpeg', 0.92);
                    if (quad && quad.length === 4) {
                        const cx = (quad[0].x + quad[1].x + quad[2].x + quad[3].x) / 4;
                        const cy = (quad[0].y + quad[1].y + quad[2].y + quad[3].y) / 4;
                        const PAD = 1.012;                   // ~1% outward from the centre
                        this.scanCorners = quad.map((p) => ({
                            x: Math.min(1, Math.max(0, cx + (p.x - cx) * PAD)),
                            y: Math.min(1, Math.max(0, cy + (p.y - cy) * PAD)),
                        }));
                    } else {
                        this.scanCorners = [
                            { x: 0.08, y: 0.08 }, { x: 0.92, y: 0.08 },
                            { x: 0.92, y: 0.92 }, { x: 0.08, y: 0.92 },
                        ];
                    }
                    this.scanPhase = 'crop';
                    this._stopScanStream();   // freeze; no need to keep the camera hot
                },

                retakeScan() {
                    this.scanImgUrl = '';
                    if (this.scanPreviewUrl) { try { URL.revokeObjectURL(this.scanPreviewUrl); } catch (_) {} }
                    this.scanPreviewUrl = '';
                    this._scanSrc = null;
                    this._scanWarped = null;
                    this._scanFiltered = null;
                    this.openScanner(this.scanContext);   // keep the destination
                },

                // Corner-handle drag (pointer events on the crop overlay).
                scanDragStart(idx, ev) {
                    this._scanDragIdx = idx;
                    // Capture on the crop box (not the handle) so its pointermove/up
                    // keep firing even if the finger strays off the small handle.
                    const box = this.$refs.scanCropBox;
                    try { box && box.setPointerCapture && box.setPointerCapture(ev.pointerId); } catch (_) {}
                },
                scanDragMove(ev) {
                    if (this._scanDragIdx < 0) return;
                    const box = this.$refs.scanCropBox;
                    if (!box) return;
                    const r = box.getBoundingClientRect();
                    const x = Math.min(1, Math.max(0, (ev.clientX - r.left) / r.width));
                    const y = Math.min(1, Math.max(0, (ev.clientY - r.top) / r.height));
                    this.scanCorners[this._scanDragIdx] = { x, y };
                },
                scanDragEnd() { this._scanDragIdx = -1; },

                scanPolyPoints() {
                    return this.scanCorners.map((c) => c.x + ',' + c.y).join(' ');
                },

                // Perspective-correct the selected quad into a flat rectangle and
                // add the result as an image document.
                async applyScanCrop() {
                    if (!this._scanSrc || this.scanCorners.length !== 4) return;
                    this.scanBusy = true;
                    await new Promise((r) => setTimeout(r, 0));   // let the spinner paint
                    try {
                        const sw = this._scanSrc.width, sh = this._scanSrc.height;
                        const src = this.scanCorners.map((c) => ({ x: c.x * sw, y: c.y * sh }));
                        const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
                        let outW = Math.round((dist(src[0], src[1]) + dist(src[3], src[2])) / 2);
                        let outH = Math.round((dist(src[0], src[3]) + dist(src[1], src[2])) / 2);
                        // Keep the warp cheap: cap the long edge.
                        const cap = 1600, mx = Math.max(outW, outH);
                        if (mx > cap) { const k = cap / mx; outW = Math.round(outW * k); outH = Math.round(outH * k); }
                        outW = Math.max(1, outW); outH = Math.max(1, outH);

                        // Flatten the page and hand over to the review step, where
                        // the enhancement options live. The warp output is kept
                        // UNFILTERED so switching filters never compounds them.
                        this._scanWarped = this._warpPerspective(this._scanSrc, src, outW, outH);
                        this.scanPhase = 'review';
                        await this._renderScanPreview();
                    } catch (err) {
                        plog('error', 'scanner', 'warp failed: ' + (err && err.message));
                        this.showToast('Could not process the scan', 'error');
                    } finally {
                        this.scanBusy = false;
                    }
                },

                // ── review step: pick an enhancement, then use the scan ────────
                // Renders the current filter onto a copy of the warped page (the
                // original is never touched) and shows it as the preview.
                async _renderScanPreview() {
                    const wcv = this._scanWarped;
                    if (!wcv) return;
                    this.scanBusy = true;
                    await new Promise((r) => setTimeout(r, 0));   // let the spinner paint
                    try {
                        const cv = document.createElement('canvas');
                        cv.width = wcv.width; cv.height = wcv.height;
                        cv.getContext('2d').drawImage(wcv, 0, 0);
                        this._applyScanFilter(cv, this.scanFilter);
                        this._scanFiltered = cv;
                        const blob = await new Promise((res) => cv.toBlob(res, 'image/jpeg', 0.92));
                        if (this.scanPreviewUrl) { try { URL.revokeObjectURL(this.scanPreviewUrl); } catch (_) {} }
                        this.scanPreviewUrl = blob ? URL.createObjectURL(blob) : '';
                    } finally {
                        this.scanBusy = false;
                    }
                },

                setScanFilter(key) {
                    if (this.scanBusy || this.scanFilter === key) return;
                    this.scanFilter = key;
                    this._renderScanPreview();
                },

                scanFilterHint() {
                    const f = this.scanFilters.find((x) => x.key === this.scanFilter);
                    return f ? f.hint : '';
                },

                // Apply the chosen enhancement in place. Everything except
                // 'none' starts from _enhanceScan (flat lighting + contrast);
                // grayscale and B&W then reduce that result.
                _applyScanFilter(cv, filter) {
                    if (!filter || filter === 'none') return;
                    this._enhanceScan(cv);
                    if (filter === 'enhance') return;
                    const ctx = cv.getContext('2d', { willReadFrequently: true });
                    const img = ctx.getImageData(0, 0, cv.width, cv.height);
                    const d = img.data;
                    if (filter === 'gray') {
                        for (let i = 0; i < d.length; i += 4) {
                            const y = (d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114) | 0;
                            d[i] = d[i + 1] = d[i + 2] = y;
                        }
                    } else {                                  // 'bw'
                        // The enhance pass already put paper at ~245, so a fixed
                        // cut is safe here — no second adaptive threshold needed.
                        for (let i = 0; i < d.length; i += 4) {
                            const y = d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114;
                            const v = y > 168 ? 255 : 0;
                            d[i] = d[i + 1] = d[i + 2] = v;
                        }
                    }
                    ctx.putImageData(img, 0, 0);
                },

                // Put a finished scan onto the editor page the scanner was opened
                // from. This lives in ONE place because the hand-over is where a
                // scan can silently vanish: the editors' insert helpers bail out
                // with a bare `return` when their 2D context is missing (which can
                // happen after a long camera session), leaving the scanner closed
                // and the page unchanged with nothing said. Here the context is
                // recovered from the canvas element first, and if the placement
                // still doesn't appear the user is told why.
                _placeScanOnPage(blob, target) {
                    if (!blob) return;
                    // Recover the drawing context from the live canvas if it was
                    // lost. _*CanvasEl() resolve by id as well as by $ref, so they
                    // work even when Alpine has re-rendered the editor.
                    let ok = true;
                    if (target === 'rb') {
                        if (!this._rbCtx) { const el = this._rbCanvasEl(); this._rbCtx = el ? el.getContext('2d') : null; }
                        ok = !!this._rbCtx;
                    } else if (target === 'af') {
                        if (!this._afCtx) { const el = this._afCanvasEl(); this._afCtx = el ? el.getContext('2d') : null; }
                        ok = !!this._afCtx;
                    } else if (target === 'tpl') {
                        if (!this._tplCtx) { const el = this._tplCanvasEl(); this._tplCtx = el ? el.getContext('2d') : null; }
                        ok = !!this._tplCtx;
                    } else {
                        if (!this._ctx) this.initCanvas();
                        ok = !!this._ctx;
                    }
                    if (!ok) {
                        this.showToast('The page editor is no longer open — reopen the page, then scan again.', 'error');
                        return;
                    }

                    switch (target) {
                        case 'rb':  this._rbInsertImageFile(blob);  break;
                        case 'af':  this._afInsertImageFile(blob);  break;
                        case 'tpl': this._tplInsertImageFile(blob); break;
                        default:    this._insertImageFile(blob);
                    }

                    // The insert lands on the image's load event. Confirm it
                    // actually produced a pending placement rather than assuming.
                    setTimeout(() => {
                        const placed = (target === 'rb')  ? this._rbPlacing
                                     : (target === 'af')  ? this._afPlacing
                                     : (target === 'tpl') ? this._tplPlacing
                                     : this._placing;
                        if (placed) this.showToast('Scan ready — drag to position, then Place', 'success');
                        else this.showToast('The scan could not be placed on this page — try Add image ▸ Camera.', 'error');
                    }, 600);
                },

                // Commit the previewed page to wherever the scanner was opened from.
                async useScan() {
                    const cv = this._scanFiltered || this._scanWarped;
                    if (!cv || this.scanBusy) return;
                    this.scanBusy = true;
                    try {
                        const blob = await new Promise((res) => cv.toBlob(res, 'image/jpeg', 0.92));
                        if (!blob) { this.showToast('Could not process the scan', 'error'); return; }
                        // Editors take the scan straight into placement — the
                        // 4-corner step already cropped it, so the rect cropper
                        // would only ask the user to crop twice. Hand the page
                        // over BEFORE closing the scanner: closing resets scan
                        // state and re-renders, and the insert finishes on an
                        // image load event, so it must already be under way.
                        if (this.scanContext && this.scanContext !== 'doc') {
                            const target = this.scanContext;
                            this._placeScanOnPage(blob, target);
                            this.closeScanner();
                            return;
                        }
                        const file = new File([blob], 'scan_' + Date.now() + '.jpg', { type: 'image/jpeg' });
                        await this._addDocFile(file, 'image');
                        this.showToast('Scanned page added', 'success');
                        this.closeScanner();
                    } catch (err) {
                        plog('error', 'scanner', 'use scan failed: ' + (err && err.message));
                        this.showToast('Could not process the scan', 'error');
                    } finally {
                        this.scanBusy = false;
                    }
                },

                // Inverse-map each output pixel through the homography that sends the
                // output rectangle's corners to the 4 source corners (TL,TR,BR,BL),
                // bilinear-sampling the source. Pure JS — no OpenCV dependency.
                _warpPerspective(srcCanvas, src, outW, outH) {
                    const sctx = srcCanvas.getContext('2d');
                    const sImg = sctx.getImageData(0, 0, srcCanvas.width, srcCanvas.height);
                    const sData = sImg.data, sW = srcCanvas.width, sH = srcCanvas.height;

                    // Output-corner → source-corner homography (h8 = 1).
                    const dst = [{ x: 0, y: 0 }, { x: outW, y: 0 }, { x: outW, y: outH }, { x: 0, y: outH }];
                    const H = this._homography(dst, src);

                    const out = document.createElement('canvas');
                    out.width = outW; out.height = outH;
                    const octx = out.getContext('2d');
                    const oImg = octx.createImageData(outW, outH);
                    const oData = oImg.data;

                    for (let y = 0; y < outH; y++) {
                        for (let x = 0; x < outW; x++) {
                            const den = H[6] * x + H[7] * y + 1;
                            const sx = (H[0] * x + H[1] * y + H[2]) / den;
                            const sy = (H[3] * x + H[4] * y + H[5]) / den;
                            const o = (y * outW + x) * 4;
                            if (sx < 0 || sy < 0 || sx >= sW - 1 || sy >= sH - 1) {
                                oData[o] = oData[o + 1] = oData[o + 2] = 255; oData[o + 3] = 255;
                                continue;
                            }
                            const x0 = sx | 0, y0 = sy | 0, fx = sx - x0, fy = sy - y0;
                            const i00 = (y0 * sW + x0) * 4, i10 = i00 + 4, i01 = i00 + sW * 4, i11 = i01 + 4;
                            for (let ch = 0; ch < 3; ch++) {
                                const top = sData[i00 + ch] * (1 - fx) + sData[i10 + ch] * fx;
                                const bot = sData[i01 + ch] * (1 - fx) + sData[i11 + ch] * fx;
                                oData[o + ch] = (top * (1 - fy) + bot * fy) | 0;
                            }
                            oData[o + 3] = 255;
                        }
                    }
                    octx.putImageData(oImg, 0, 0);
                    // Returned RAW — enhancement is chosen on the review step.
                    return out;
                },

                // ── document enhancement (brightness / shadow correction) ──
                // A phone photo of a page is unevenly lit: a shadow down one
                // side, a bright hot-spot under the lamp, grey "white" paper.
                // Fix it the way scanner apps do, in two passes:
                //   1. Estimate the ILLUMINATION by shrinking the page to a
                //      thumbnail and stretching it back up — a cheap large-radius
                //      blur that holds the lighting gradient but none of the ink.
                //      Dividing the pixel by that background flattens the
                //      lighting, so paper reads the same white everywhere and a
                //      shadowed corner stops being grey.
                //   2. Stretch the contrast (black/white points) so ink goes
                //      properly dark and the paper goes properly white.
                // Colour is preserved — each channel is scaled by the same
                // factor — so blue pen stays blue instead of going black.
                // Operates on the canvas in place.
                _enhanceScan(cv) {
                    const w = cv.width, h = cv.height;
                    if (!w || !h) return;
                    const ctx = cv.getContext('2d', { willReadFrequently: true });
                    const img = ctx.getImageData(0, 0, w, h);
                    const d = img.data;

                    // 1. Illumination map: ~1/24 scale, then scaled back up (the
                    //    browser's smoothing does the interpolation for us).
                    const bw = Math.max(2, Math.round(w / 24));
                    const bh = Math.max(2, Math.round(h / 24));
                    const small = document.createElement('canvas');
                    small.width = bw; small.height = bh;
                    const sctx = small.getContext('2d');
                    sctx.imageSmoothingEnabled = true;
                    sctx.imageSmoothingQuality = 'high';
                    sctx.drawImage(cv, 0, 0, bw, bh);

                    const bgc = document.createElement('canvas');
                    bgc.width = w; bgc.height = h;
                    const bctx = bgc.getContext('2d', { willReadFrequently: true });
                    bctx.imageSmoothingEnabled = true;
                    bctx.imageSmoothingQuality = 'high';
                    bctx.drawImage(small, 0, 0, w, h);
                    const bg = bctx.getImageData(0, 0, w, h).data;

                    // 2. Divide out the lighting, then stretch [BLACK..WHITE] to
                    //    the full range. PAPER is the level the flattened paper
                    //    lands on; the clamp on the background keeps a very dark
                    //    photo from being amplified into noise.
                    const PAPER = 245, BLACK = 34, WHITE = 238;
                    const span = 255 / (WHITE - BLACK);
                    for (let i = 0; i < d.length; i += 4) {
                        const lum = Math.max(28, bg[i] * 0.299 + bg[i + 1] * 0.587 + bg[i + 2] * 0.114);
                        const k = PAPER / lum;
                        for (let c = 0; c < 3; c++) {
                            let v = (d[i + c] * k - BLACK) * span;
                            d[i + c] = v < 0 ? 0 : (v > 255 ? 255 : v);
                        }
                    }
                    ctx.putImageData(img, 0, 0);
                },

                // Solve the 3×3 homography (8 DOF) mapping src[i] → dst[i] for 4 pairs.
                _homography(srcPts, dstPts) {
                    const A = [], b = [];
                    for (let i = 0; i < 4; i++) {
                        const s = srcPts[i], d = dstPts[i];
                        A.push([s.x, s.y, 1, 0, 0, 0, -s.x * d.x, -s.y * d.x]); b.push(d.x);
                        A.push([0, 0, 0, s.x, s.y, 1, -s.x * d.y, -s.y * d.y]); b.push(d.y);
                    }
                    const h = this._solve8(A, b);
                    return [h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]];
                },

                // Gaussian elimination with partial pivoting for an 8×8 system.
                _solve8(A, b) {
                    const n = 8, M = A.map((row, i) => row.concat(b[i]));
                    for (let col = 0; col < n; col++) {
                        let piv = col;
                        for (let r = col + 1; r < n; r++) if (Math.abs(M[r][col]) > Math.abs(M[piv][col])) piv = r;
                        [M[col], M[piv]] = [M[piv], M[col]];
                        const d = M[col][col] || 1e-9;
                        for (let r = 0; r < n; r++) {
                            if (r === col) continue;
                            const f = M[r][col] / d;
                            for (let c = col; c <= n; c++) M[r][c] -= f * M[col][c];
                        }
                    }
                    const x = new Array(n);
                    for (let i = 0; i < n; i++) x[i] = M[i][n] / (M[i][i] || 1e-9);
                    return x;
                },

                // Upload the collected files to the Other Documents bucket
                // (pma_patient_notes1, category_type_id = 1993). One request per
                // file, sequential; each success drops that file from the tray so
                // a partial failure leaves only the unsent ones for a retry.
                async submitOtherDocuments() {
                    // Register-book gallery upload (hospital-scoped, no patient).
                    if (this.docContext === 'rb') return this._submitRbDocuments();
                    if (this.docContext === 'audit') return this._submitAfDocuments();
                    if (this.docUploading) return;
                    const n = this.docFiles.length;
                    if (!n) { this.showToast('No files added yet', 'error'); return; }
                    if (!this.selectedPatientId) { this.showToast('Select a patient first', 'error'); return; }

                    this.docUploading = true;
                    let ok = 0, fail = 0, lastErr = '';
                    const catId = this.docCatId || 1993;
                    const url = './api/patients/' + encodeURIComponent(this.selectedPatientId) + '/other-documents';

                    for (const item of [...this.docFiles]) {
                        try {
                            const fd = new FormData();
                            fd.append('file', item.blob, item.name || (item.kind === 'pdf' ? 'document.pdf' : 'image.jpg'));
                            fd.append('category_type_id', catId);
                            if (this.csrfToken) fd.append('_token', this.csrfToken);
                            const resp = await fetch(url, {
                                method: 'POST',
                                credentials: 'same-origin',
                                body: fd,
                                headers: Object.assign({ 'Accept': 'application/json' },
                                    this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}),
                            });
                            if (resp.status === 401) { window.location.assign('./login'); return; }
                            if (resp.status === 419) {
                                await this.loadMe();
                                this.showToast('Session refreshed — tap Upload again', 'error');
                                this.docUploading = false;
                                return;
                            }
                            if (!resp.ok) {
                                // Surface the EXACT server / bucket exception.
                                const data = await resp.json().catch(() => null);
                                throw new Error((data && data.error) || ('HTTP ' + resp.status));
                            }
                            ok++;
                            this.removeDocFile(item.id);   // sent → clear from the tray
                        } catch (e) {
                            fail++;
                            lastErr = (e && e.message) || String(e);
                            plog('error', 'other-docs', 'upload failed (' + (item.name || '') + '): ' + lastErr);
                        }
                    }

                    this.docUploading = false;
                    if (ok > 0) {
                        this.showToast(ok + ' file(s) uploaded' + (fail ? (', ' + fail + ' failed: ' + lastErr) : ''),
                            fail ? 'error' : 'success', false, fail ? 15000 : 2500);
                        if (this.selectedPatientId && this.patientsLive) {
                            this.loadPatientCategoryCounts(this.selectedPatientId).catch(() => {});
                        }
                        // Close the capture dialog + the right drawer, then show the
                        // uploaded files in the MAIN window (thumbnail grid → viewer).
                        if (fail === 0) {
                            this.docViewTitle = this.docSheetTitle;
                            this.otherDocOpen = false;
                            this.otherDocImageOpen = false;
                            this.rightOpen = false;
                            this.docViewMode = 'grid';
                            this.docViewOpen = true;
                            this.loadDocExisting();
                        }
                    } else {
                        this.showToast('Upload failed: ' + (lastErr || 'please try again'), 'error', false, 15000);
                    }
                },

                closeDocView() {
                    this.docViewOpen = false;
                    this.docViewMode = 'grid';
                },

                // Document page viewer (same shape as the category pages detail,
                // minus the edit button). Opens in-pane on a thumbnail tap.
                openDocDetail(item) {
                    const i = this.docExisting.findIndex((d) => d.id === (item && item.id));
                    this.docDetailIndex = i < 0 ? 0 : i;
                    this.docViewMode = 'detail';
                    // Jump the slider to the tapped page once it's rendered.
                    this.$nextTick(() => {
                        const el = this.$refs.docSlider;
                        if (el) el.scrollLeft = this.docDetailIndex * el.clientWidth;
                        this._renderActivePdf();
                    });
                },
                get activeDocFile() {
                    return this.docExisting[this.docDetailIndex] || null;
                },
                // Active page tracked from the slider's scroll position.
                onDocScroll(e) {
                    const el = e.target;
                    if (!el || !el.clientWidth) return;
                    const idx = Math.round(el.scrollLeft / el.clientWidth);
                    if (idx >= 0 && idx < this.docExisting.length && idx !== this.docDetailIndex) {
                        this.docDetailIndex = idx;
                        this._renderActivePdf();
                    }
                },
                // Dot tap → smooth-scroll the slider to that page.
                docDetailGo(i) {
                    const el = this.$refs.docSlider;
                    const clamped = Math.max(0, Math.min(this.docExisting.length - 1, i));
                    this.docDetailIndex = clamped;
                    if (el) el.scrollTo({ left: clamped * el.clientWidth, behavior: 'smooth' });
                    this._renderActivePdf();
                },
                closeDocDetail() { this.docViewMode = 'grid'; },

                // ── Multi-select delete (long-press on the document grid) ──
                // A long press on any card enters selection mode; tapping cards
                // then toggles their tick. The chosen files are HARD-deleted
                // (DB + S3) after a confirmation.
                docPressStart(d) {
                    this._clearDocPress();
                    this._docPressTimer = setTimeout(() => this.docCardLongPress(d), 500);
                },
                _clearDocPress() {
                    if (this._docPressTimer) { clearTimeout(this._docPressTimer); this._docPressTimer = null; }
                },
                docPressEnd() { this._clearDocPress(); },

                docCardLongPress(d) {
                    this._clearDocPress();
                    if (!d) return;
                    if (!this.docSelectMode) { this.docSelectMode = true; this.docSelectedIds = []; }
                    if (!this.isDocSelected(d)) this.docSelectedIds.push(d.id);
                    // Swallow the click that fires right after a touch/long-press
                    // so it doesn't immediately toggle the item back off.
                    this._suppressNextDocClick = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                docCardClick(d) {
                    if (this._suppressNextDocClick) { this._suppressNextDocClick = false; return; }
                    if (this.docSelectMode) { this.toggleDocSelect(d); return; }
                    this.openDocDetail(d);
                },

                toggleDocSelect(d) {
                    if (!d) return;
                    const i = this.docSelectedIds.indexOf(d.id);
                    if (i >= 0) this.docSelectedIds.splice(i, 1);
                    else this.docSelectedIds.push(d.id);
                },
                isDocSelected(d) { return !!d && this.docSelectedIds.includes(d.id); },

                toggleSelectAllDocs() {
                    if (this.docSelectedIds.length === this.docExisting.length) this.docSelectedIds = [];
                    else this.docSelectedIds = this.docExisting.map((d) => d.id);
                },

                exitDocSelect() {
                    this.docSelectMode = false;
                    this.docSelectedIds = [];
                    this._suppressNextDocClick = false;
                },

                // Open the confirm dialog for the current selection (grid).
                askDeleteSelected() {
                    if (!this.docSelectedIds.length) { this.showToast('Select at least one file', 'error'); return; }
                    if (!this._docActionAllowed('del')) return;
                    this.docDeleteTargets = [...this.docSelectedIds];
                    this.docDeleteConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Open the confirm dialog for the file open in the page viewer.
                askDeleteCurrentDoc() {
                    if (!this._docActionAllowed('del')) return;
                    const d = this.activeDocFile;
                    if (!d || !d.id) { this.showToast('No file to delete', 'error'); return; }
                    this.docDeleteTargets = [d.id];
                    this.docDeleteConfirmOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Share the document open in the page viewer via the Web Share
                // API. Shares the actual file when the platform supports file
                // sharing (fetched through the same-origin proxy so S3 CORS
                // doesn't block the blob read), else falls back to the presigned
                // link. Mirrors sharePdf().
                // Per-document Share / Delete grant check. action = 'share'|'del'.
                // Returns true when allowed; otherwise toasts and returns false.
                _docActionAllowed(action) {
                    const p = DOC_ACTION_PERMS[this.docCatId];
                    if (!p) return true;                 // category not gated
                    if (this.me[p[action]]) return true; // user holds the grant
                    const verb = action === 'share' ? 'Share' : 'Delete';
                    this.showToast('You have not permission to ' + verb + ' ' + p.label + '.', 'error');
                    return false;
                },

                async shareCurrentDoc() {
                    this.docShareMenuOpen = false;
                    if (!this._docActionAllowed('share')) return;
                    const d = this.activeDocFile;
                    if (!d || !d.id) { this.showToast('No file to share', 'error'); return; }
                    const title = d.label || d.name || 'Document';
                    const meta  = {
                        image: { ext: 'jpg', mime: 'image/jpeg' },
                        pdf:   { ext: 'pdf', mime: 'application/pdf' },
                        audio: { ext: 'mp3', mime: 'audio/mpeg' },
                        video: { ext: 'mp4', mime: 'video/mp4' },
                    }[d.kind] || { ext: 'bin', mime: 'application/octet-stream' };
                    const safe = (title.replace(/[^\w.-]+/g, '_') || 'document') + '.' + meta.ext;
                    const proxy = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                + '/other-documents/' + encodeURIComponent(d.id) + '/file';
                    try {
                        // File share only — never share the presigned link.
                        if (navigator.canShare) {
                            const resp = await fetch(proxy, { credentials: 'same-origin' });
                            if (resp.ok) {
                                const blob = await resp.blob();
                                const file = new File([blob], safe, { type: blob.type || meta.mime });
                                if (navigator.canShare({ files: [file] })) {
                                    await navigator.share({ files: [file], title });
                                    return;
                                }
                            }
                        }
                        this.showToast('File sharing is not supported on this device', 'error');
                    } catch (e) {
                        if (e && e.name === 'AbortError') return;   // user dismissed the sheet
                        plog('warn', 'other-docs', 'share failed: ' + (e && e.message || e));
                        this.showToast('Could not share this file', 'error');
                    }
                },

                // Print the document open in the page viewer. Loads the file
                // (via the same-origin proxy, so the browser renders the real
                // image/PDF) into a hidden iframe and prints just that frame.
                // Audio/video have nothing to print.
                printCurrentDoc() {
                    this.docShareMenuOpen = false;
                    const d = this.activeDocFile;
                    if (!d || !d.id) { this.showToast('No file to print', 'error'); return; }
                    if (d.kind === 'audio' || d.kind === 'video') {
                        this.showToast('Audio / video files cannot be printed', 'error');
                        return;
                    }
                    const proxy = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                + '/other-documents/' + encodeURIComponent(d.id) + '/file';
                    try {
                        const old = document.getElementById('docPrintFrame');
                        if (old) old.remove();
                        const frame = document.createElement('iframe');
                        frame.id = 'docPrintFrame';
                        frame.setAttribute('aria-hidden', 'true');
                        frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden;';
                        frame.src = proxy;
                        frame.onload = () => {
                            try {
                                frame.contentWindow.focus();
                                frame.contentWindow.print();
                            } catch (err) {
                                plog('warn', 'other-docs', 'print frame failed: ' + (err && err.message || err));
                                this.showToast('Could not print this file', 'error');
                            }
                        };
                        document.body.appendChild(frame);
                    } catch (e) {
                        plog('warn', 'other-docs', 'print failed: ' + (e && e.message || e));
                        this.showToast('Could not print this file', 'error');
                    }
                },

                async confirmDocDelete() {
                    if (this.docDeleteBusy) return;
                    const ids = [...this.docDeleteTargets];
                    if (!ids.length || !this.selectedPatientId) { this.docDeleteConfirmOpen = false; return; }
                    this.docDeleteBusy = true;

                    let ok = 0, fail = 0;
                    for (const id of ids) {
                        // eslint-disable-next-line no-await-in-loop
                        const done = await this._deleteOneDoc(id);
                        if (done) ok++; else fail++;
                    }

                    this.docDeleteBusy = false;
                    this.docDeleteConfirmOpen = false;
                    this.docDeleteTargets = [];
                    this.exitDocSelect();

                    if (ok) this.showToast(ok + (ok === 1 ? ' file deleted' : ' files deleted'), 'success');
                    if (fail) this.showToast(fail + (fail === 1 ? ' file could not be deleted' : ' files could not be deleted'), 'error');

                    // Refresh the grid; drop back to it if the viewer was open.
                    this.docViewMode = 'grid';
                    await this.loadDocExisting();
                    this.docDetailIndex = 0;
                    // Refresh the Gallery|Labs "(N)" badges (live mode only).
                    if (this.patientsLive && this.selectedPatientId) {
                        this.loadPatientCategoryCounts(this.selectedPatientId);
                    }
                },

                // POST + _method=DELETE (same spoof as _deletePageLive) → the
                // hard-delete endpoint. Returns true on success.
                async _deleteOneDoc(noteId) {
                    const fd = new FormData();
                    fd.append('_method', 'DELETE');
                    if (this.csrfToken) fd.append('_token', this.csrfToken);
                    try {
                        const url = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                  + '/other-documents/' + encodeURIComponent(noteId);
                        const resp = await fetch(url, {
                            method: 'POST',
                            credentials: 'same-origin',
                            body: fd,
                            headers: Object.assign(
                                { 'Accept': 'application/json' },
                                this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}
                            ),
                        });
                        if (resp.status === 401) { window.location.assign('./login'); return false; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed. Tap delete again.', 'error'); return false; }
                        return resp.ok;
                    } catch (e) {
                        plog('error', 'other-docs', '_deleteOneDoc failed: ' + (e && e.message || e));
                        return false;
                    }
                },

                // Render the active page's PDF inline with PDF.js (once per doc).
                _renderActivePdf() {
                    const item = this.activeDocFile;
                    if (!item || item.kind !== 'pdf' || this._pdfRendered[item.id]) return;
                    this.$nextTick(() => this._renderPdfInto(item));
                },
                async _renderPdfInto(item) {
                    const box = document.getElementById('pdfbox-' + item.id);
                    if (!box || this._pdfRendered[item.id]) return;
                    if (typeof pdfjsLib === 'undefined') {
                        box.innerHTML = '<div class="text-sm text-slate-500 py-8">PDF viewer unavailable</div>';
                        return;
                    }
                    this._pdfRendered[item.id] = true;
                    box.innerHTML = '<div class="text-sm text-slate-500 py-8">Loading PDF…</div>';
                    try {
                        if (!pdfjsLib.GlobalWorkerOptions.workerSrc) {
                            pdfjsLib.GlobalWorkerOptions.workerSrc =
                                'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
                        }
                        // Fetch via the same-origin proxy so PDF.js isn't blocked
                        // by S3 CORS (the bucket may not grant it).
                        const pdfUrl = './api/patients/' + encodeURIComponent(this.selectedPatientId)
                                     + '/other-documents/' + encodeURIComponent(item.id) + '/file';
                        const pdf = await pdfjsLib.getDocument({ url: pdfUrl, withCredentials: true }).promise;
                        box.innerHTML = '';
                        const maxW = Math.max(280, (box.clientWidth || 600) - 16);
                        for (let p = 1; p <= pdf.numPages; p++) {
                            const page = await pdf.getPage(p);
                            const base = page.getViewport({ scale: 1 });
                            const scale = Math.min(2, maxW / base.width);
                            const vp = page.getViewport({ scale });
                            const canvas = document.createElement('canvas');
                            canvas.width = vp.width; canvas.height = vp.height;
                            canvas.className = 'shadow bg-white max-w-full';
                            box.appendChild(canvas);
                            await page.render({ canvasContext: canvas.getContext('2d'), viewport: vp }).promise;
                        }
                    } catch (e) {
                        this._pdfRendered[item.id] = false;   // allow a retry
                        box.innerHTML = '<div class="text-sm text-rose-600 py-8">Could not load PDF</div>';
                        plog('warn', 'pdf', 'render failed: ' + (e && e.message || e));
                    }
                },

                // ── Remark (note_remark) add/update ──────────────────────────
                openRemarkEditor(item) {
                    this._remarkItem = item;
                    this.remarkText = (item && item.label) || '';
                    this.remarkOpen = true;
                },
                closeRemarkEditor() {
                    this.remarkOpen = false;
                    this._remarkItem = null;
                    this.remarkText = '';
                },
                async saveRemark() {
                    const item = this._remarkItem;
                    if (!item || !this.selectedPatientId || this.remarkSaving) return;
                    const text = (this.remarkText || '').trim();
                    this.remarkSaving = true;
                    try {
                        const fd = new FormData();
                        fd.append('note_remark', text);
                        if (this.csrfToken) fd.append('_token', this.csrfToken);
                        const resp = await fetch(
                            './api/patients/' + encodeURIComponent(this.selectedPatientId)
                            + '/other-documents/' + encodeURIComponent(item.id) + '/remark',
                            { method: 'POST', credentials: 'same-origin', body: fd,
                              headers: Object.assign({ 'Accept': 'application/json' }, this.csrfToken ? { 'X-CSRF-TOKEN': this.csrfToken } : {}) }
                        );
                        if (resp.status === 401) { window.location.assign('./login'); return; }
                        if (resp.status === 419) { await this.loadMe(); this.showToast('Session refreshed — tap Save again', 'error'); this.remarkSaving = false; return; }
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        // Update in place so the grid + detail reflect it instantly.
                        item.label = text;
                        if (!text && item.name && item.kind !== 'image' && item.kind !== 'pdf') { /* keep name */ }
                        this.showToast('Remark saved', 'success');
                        this.closeRemarkEditor();
                    } catch (e) {
                        plog('error', 'other-docs', 'remark save failed: ' + (e && e.message || e));
                        this.showToast('Could not save remark', 'error');
                    } finally {
                        this.remarkSaving = false;
                    }
                },

                // Uploaded files grouped by day, newest first (newest files first
                // within each day too) — mirrors the pages grid's date grouping.
                groupedDocByDate() {
                    const by = {};
                    for (const d of this.docExisting) {
                        const key = d.day || d.date || '';
                        (by[key] = by[key] || []).push(d);
                    }
                    return Object.keys(by)
                        .map((day) => ({
                            day,
                            records: by[day].slice().sort((a, b) => (b.createdAt || '').localeCompare(a.createdAt || '')),
                            _sort: (by[day][0] && by[day][0].createdAt) || '',
                        }))
                        .sort((a, b) => (b._sort || '').localeCompare(a._sort || ''));
                },

                // Force the latest app shell without a logout/login. Asks the
                // service worker to re-check for a new version, then reloads —
                // the SW's network-first navigation fetches the fresh index.html.
                // Force the latest app shell: wipe the Cache Storage (app shell +
                // runtime assets), pull the freshest service worker, then reload
                // from the network so recent changes show immediately. The offline
                // IndexedDB layer (census / pages / outbox) is left intact.
                async refreshApp() {
                    plog('info', 'app', 'Manual refresh — clearing caches');
                    this.showToast('Updating…');

                    // 1. Delete every Cache Storage bucket (the stale shell + assets).
                    try {
                        if (window.caches && caches.keys) {
                            const names = await caches.keys();
                            await Promise.all(names.map((n) => caches.delete(n)));
                            plog('info', 'app', 'Cleared ' + names.length + ' cache(s)');
                        }
                    } catch (e) { plog('warn', 'app', 'cache clear failed: ' + (e && e.message)); }

                    // 2. Pull + activate the newest service worker so the next load
                    //    is served fresh (network-first nav + a re-primed cache).
                    try {
                        if (navigator.serviceWorker && navigator.serviceWorker.getRegistration) {
                            const reg = await navigator.serviceWorker.getRegistration();
                            if (reg) {
                                try { await reg.update(); } catch (_) {}
                                if (reg.waiting) { try { reg.waiting.postMessage('SKIP_WAITING'); } catch (_) {} }
                            }
                        }
                    } catch (_) {}

                    // 3. Hard reload from the network.
                    setTimeout(() => { try { window.location.reload(); } catch (_) {} }, 200);
                },

                // ── Activity log (Modules tab) ──────────────────────────────
                // Refresh the entry counter shown in the UI.
                async refreshLogCount() { this.logCount = await plogCount(); },
                // Download ONLY the problems (errors + warnings) — not routine
                // activity — as a presco-ipd-log file. Button lives at the top of
                // the patient-list drawer.
                async downloadErrorLog() {
                    try {
                        plog('info', 'log', 'Error-log export requested');
                        const text  = await plogExportText(['error', 'warn']);
                        const blob  = new Blob([text], { type: 'text/plain;charset=utf-8' });
                        const url   = URL.createObjectURL(blob);
                        const a     = document.createElement('a');
                        const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
                        a.href = url;
                        a.download = 'presco-ipd-log-errors-' + stamp + '.txt';
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        setTimeout(() => URL.revokeObjectURL(url), 5000);
                        this.showToast('Error log exported — save it to Documents');
                    } catch (e) {
                        this.showToast('Could not export error log', 'error');
                    }
                },
                // Export the whole log to a text file named presco-ipd-log so it
                // can be saved into the device's Documents folder (or shared).
                async downloadLog() {
                    try {
                        plog('info', 'log', 'Log export requested');
                        const text = await plogExportText();
                        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
                        const url  = URL.createObjectURL(blob);
                        const a    = document.createElement('a');
                        // Date-stamped so multiple exports don't overwrite; the
                        // base name is presco-ipd-log as requested.
                        const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
                        a.href = url;
                        a.download = 'presco-ipd-log-' + stamp + '.txt';
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        setTimeout(() => URL.revokeObjectURL(url), 5000);
                        this.showToast('Log exported — save it to Documents');
                    } catch (e) {
                        this.showToast('Could not export log', 'error');
                    }
                },
                // Wipe the local log after the user has saved what they need.
                async clearLog() {
                    await plogClear();
                    await this.refreshLogCount();
                    plog('info', 'log', 'Log cleared by user');
                    this.showToast('Activity log cleared');
                },
                // Serial no for the drawer's Hand Written category list: the
                // "All IPD Categories" row is 0, then the actual categories start
                // at 1. Robust when the All row is filtered out by search/bunch
                // (then the first real category is still 1, not 0).
                catSerialNo(cat, idx) {
                    if (cat && cat.isAll) return 0;
                    // Reads the flag visibleCategories() just computed instead of
                    // re-running the filter. This used to call
                    // filteredCategories() once PER ROW, so an n-category drawer
                    // did n+3 full passes per render — and, worse, gave every row
                    // effect a dependency on every category's .count/.disabled/
                    // .label/.colorHex. That O(n²) dependency graph is what made
                    // loadPatientCategoryCounts()'s 2n property writes explode
                    // into millions of Alpine queue operations on patient select.
                    return this._catFirstIsAll ? idx : (idx + 1);
                },

                // The rows actually rendered: the filtered list capped at
                // categoriesRenderLimit. Growing the cap (onCategoryListScroll)
                // appends the next page without refetching anything.
                //
                // Also stashes the two derived values the rest of the template
                // needs — the true filtered total for the footer, and whether the
                // pinned "All" row survived the filter (catSerialNo) — so nothing
                // else has to re-run the filter.
                visibleCategories() {
                    const list = this.filteredCategories();
                    this._catFilteredLen = list.length;
                    this._catFirstIsAll  = !!(list[0] && list[0].isAll);
                    // Footer total — the "All IPD Categories" row is pinned first
                    // and isn't a real category (no form image behind it), so it
                    // is left out of the count. Windowing still uses
                    // _catFilteredLen, which counts every rendered row.
                    this._catRealLen = list.length - (this._catFirstIsAll ? 1 : 0);
                    return list.length > this.categoriesRenderLimit
                        ? list.slice(0, this.categoriesRenderLimit)
                        : list;
                },

                // Loaded categories excluding the synthetic "All IPD Categories"
                // row (always index 0 when present) — the footer's denominator.
                categoriesRealTotal() {
                    const list = this.categories || [];
                    return list.length - ((list[0] && list[0].isAll) ? 1 : 0);
                },

                // True while more filtered rows exist than are being rendered.
                categoriesHasMore() {
                    return this._catFilteredLen > this.categoriesRenderLimit;
                },

                // Reset the window back to the first page. Called whenever the
                // list's CONTENT changes under the user — a different patient
                // (disabled categories appear/disappear with their page counts),
                // a new search term, or a bunch filter — so they never land
                // mid-way down a list they haven't scrolled.
                resetCategoryWindow() {
                    this.categoriesRenderLimit = CATEGORIES_PAGE;
                },

                // Infinite scroll for the category list. Mirrors
                // onPatientListScroll's 120px threshold, but there's no fetch:
                // the rows are already in memory, so this just widens the slice.
                // Gated on the Hand Written tab because the scroll container is
                // shared by all three drawer tabs.
                onCategoryListScroll(e) {
                    if (this.activeTab !== 'hand-written') return;
                    if (!this.categoriesHasMore()) return;
                    const el = e && e.target;
                    if (!el) return;
                    if (el.scrollTop + el.clientHeight < el.scrollHeight - 120) return;
                    this.showMoreCategories();
                },

                // Append the next page of rows. Also the "show more" button's
                // handler, so CATEGORIES_PAGE stays in one place — Alpine
                // evaluates template expressions via new Function(), which does
                // not close over this script's module-level consts.
                showMoreCategories() {
                    if (!this.categoriesHasMore()) return;
                    this.categoriesRenderLimit += CATEGORIES_PAGE;
                    // New rows carry <i data-lucide> placeholders that only become
                    // SVGs once lucide converts them.
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                filteredCategories() {
                    const q = (this.search || '').trim().toLowerCase();
                    const bunch = this.bunchFilter;
                    const norm = (v) => (v || '').toString().toLowerCase();
                    return this.categories.filter((c) => {
                        // Disabled (status 'D') categories show ONLY when the
                        // selected patient has written pages in them (count > 0).
                        // No patient / no pages => hidden. The backend already
                        // gated them by the user's category permission.
                        if (c.disabled && !((c.count || 0) > 0)) return false;
                        if (q && !c.label.toLowerCase().includes(q)) return false;
                        if (bunch && norm(c.colorHex) !== norm(bunch)) return false;
                        return true;
                    });
                },

                // Distinct category_color_code values across the loaded
                // categories, each carrying the corresponding category_code
                // as its label. "#00000000" (transparent / unset) gets the
                // explicit "Blank Color" label. Sorted so the blank bunch
                // floats to the top (right after "All Bunches"); coloured
                // bunches keep their colour-code order otherwise. One
                // category_color_code may have multiple category_code
                // values across rows — we pick the FIRST non-empty code as
                // the label so the dropdown isn't ambiguous.
                bunchOptions() {
                    const norm = (v) => (v || '').toString().toLowerCase();
                    const map = new Map();
                    this.categories.forEach((c) => {
                        const key = norm(c.colorHex) || '#00000000';
                        if (!map.has(key)) {
                            map.set(key, {
                                colorHex: key,
                                label:    (c.code && String(c.code).trim()) || '',
                                count:    1,
                            });
                        } else {
                            const entry = map.get(key);
                            entry.count += 1;
                            // Promote first non-empty code into label.
                            if (!entry.label && c.code) entry.label = String(c.code).trim();
                        }
                    });
                    const opts = Array.from(map.values()).map((o) => ({
                        ...o,
                        // Blank bunch — special-case the display label.
                        displayLabel: o.colorHex === '#00000000'
                            ? 'Blank Color'
                            : (o.label || o.colorHex),
                    }));
                    // Blank first (sort key empty-string → blank floats up),
                    // then the rest in stable insertion order.
                    opts.sort((a, b) => (a.colorHex === '#00000000' ? -1 : b.colorHex === '#00000000' ? 1 : 0));
                    return opts;
                },

                // Hide the bunch picker entirely when there's nothing to
                // pick between — either the categories haven't loaded yet
                // OR every category shares the blank #00000000 colour code
                // (so a bunch filter would be a no-op).
                bunchFilterVisible() {
                    const opts = this.bunchOptions();
                    if (opts.length <= 1 && (opts[0] && opts[0].colorHex === '#00000000')) {
                        return false;
                    }
                    return opts.length > 0;
                },

                // Resolved label for the currently-selected bunch — feeds
                // the dropdown trigger button's text.
                bunchFilterLabel() {
                    if (!this.bunchFilter) return 'All Bunches';
                    const match = this.bunchOptions().find(o => o.colorHex === this.bunchFilter);
                    return match ? match.displayLabel : 'All Bunches';
                },

                selectBunch(colorHex) {
                    this.bunchFilter     = colorHex || null;
                    this.bunchFilterOpen = false;
                    // Different filter → different list, so start at page one.
                    this.resetCategoryWindow();
                },
                filteredPatients() {
                    const q = (this.patientSearch || '').trim().toLowerCase();
                    if (!q) return this.patients;
                    return this.patients.filter(p =>
                        (p.name || '').toLowerCase().includes(q)
                        || (p.uhid || '').toLowerCase().includes(q)
                        || (p.ipd || '').toLowerCase().includes(q)
                    );
                },

                // Format a DB datetime ("Y-m-d H:i:s" or ISO 8601) into the
                // canonical UI shape `dd-mm-yyyy hh:mm a` (e.g. "28-05-2026 03:45 pm").
                // Used everywhere a saved-page timestamp is rendered. Returns
                // the input untouched if it's already a non-parseable string,
                // so a server that ever drops a pre-formatted value still
                // shows up sanely.
                fmtDateTime(value) {
                    if (!value) return '';
                    // MySQL "Y-m-d H:i:s" isn't a valid ISO string in Safari —
                    // swap the space for a 'T' before Date() parses it.
                    const iso = typeof value === 'string'
                        ? value.replace(' ', 'T')
                        : value;
                    const d = new Date(iso);
                    if (isNaN(d.getTime())) return String(value);
                    const pad = n => String(n).padStart(2, '0');
                    let h = d.getHours();
                    const ampm = h >= 12 ? 'pm' : 'am';
                    h = h % 12; if (h === 0) h = 12;
                    return pad(d.getDate())
                        + '-' + pad(d.getMonth() + 1)
                        + '-' + d.getFullYear()
                        + ' ' + pad(h) + ':' + pad(d.getMinutes()) + ' ' + ampm;
                },

                // Hospitalization duration as "Xd Yh Zm" (e.g. "2d 5h 18m").
                //   - Live mode      : admission → NOW (pass no endAt; reads
                //                      this.nowTick so Alpine re-evaluates each
                //                      minute via the init() ticker).
                //   - History/Cancel : admission → DISCHARGE (pass discharged_at).
                // Parses DB-native "Y-m-d H:i:s" like fmtDateTime (space→'T' for
                // Safari). Returns '' when admit time is missing/invalid, and
                // 'NA' when the span is negative (discharge before admission /
                // clock skew).
                hospitalizeDuration(admittedAt, endAt) {
                    const toMs = (v) => {
                        if (!v) return NaN;
                        const iso = typeof v === 'string' ? v.replace(' ', 'T') : v;
                        return new Date(iso).getTime();
                    };
                    const start = toMs(admittedAt);
                    if (isNaN(start)) return '';
                    // No endAt → Live: tick against the reactive clock.
                    const end = (endAt === undefined || endAt === null || endAt === '')
                        ? this.nowTick
                        : toMs(endAt);
                    if (isNaN(end)) return '';
                    const ms = end - start;
                    if (ms < 0) return 'NA';
                    const mins  = Math.floor(ms / 60000);
                    const days  = Math.floor(mins / 1440);
                    const hours = Math.floor((mins % 1440) / 60);
                    const m     = mins % 60;
                    return days + 'd ' + hours + 'h ' + m + 'm';
                },

                // Whole-day count of the stay (admission → end). Same parsing /
                // end-time rules as hospitalizeDuration; reads this.nowTick for
                // Live so it stays current. Returns null on missing/invalid/
                // negative span. Drives the long-stay highlight.
                hospitalizeDays(admittedAt, endAt) {
                    const toMs = (v) => {
                        if (!v) return NaN;
                        const iso = typeof v === 'string' ? v.replace(' ', 'T') : v;
                        return new Date(iso).getTime();
                    };
                    const start = toMs(admittedAt);
                    if (isNaN(start)) return null;
                    const end = (endAt === undefined || endAt === null || endAt === '')
                        ? this.nowTick
                        : toMs(endAt);
                    if (isNaN(end)) return null;
                    const ms = end - start;
                    if (ms < 0) return null;
                    return Math.floor(ms / 86400000);
                },

                // Long-stay highlight: non-Cash payment (pmode !== '0') AND the
                // stay exceeds 15 days. Used to flag the admission-duration pill
                // yellow.
                isLongStayHighlight(p) {
                    if (!p || String(p.pmode) === '0') return false;
                    const d = this.hospitalizeDays(p.admitted_at, this.patientMode === 'live' ? null : p.discharged_at);
                    return d !== null && d > 15;
                },

                // Department name only, for the horizontal clearance strip. The
                // word "Discharged" repeats on every pill, so it's dropped here —
                // the strip is captioned "Discharge Cleared" and the full label
                // stays in each pill's tooltip.
                dischargeShortLabel(label) {
                    const M = {
                        'Clinically Discharged':       'Clinical',
                        'Pharmacy Discharged':         'Pharmacy',
                        'Pharmacy Implant Discharged': 'Implant',
                        'OT Pharmacy Discharged':      'OT Pharmacy',
                        'Lab Discharged':              'Lab',
                        'Radiology Discharged':        'Radiology',
                        'Billing Discharged':          'Billing',
                    };
                    return M[label] || String(label || '').replace(/\s*Discharged$/i, '');
                },
                // "20 Jun 01:23 pm" — compact enough to keep several clearance
                // pills on one row. The YEAR is dropped (not the date: departments
                // can clear on different days, so day/month must stay visible);
                // the full timestamp remains in the tooltip.
                fmtDateTimeShort(value) {
                    if (!value) return '';
                    const iso = typeof value === 'string' ? value.replace(' ', 'T') : value;
                    const d = new Date(iso);
                    if (isNaN(d.getTime())) return String(value);
                    const pad = n => String(n).padStart(2, '0');
                    const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                    let h = d.getHours();
                    const ampm = h >= 12 ? 'pm' : 'am';
                    h = h % 12; if (h === 0) h = 12;
                    return pad(d.getDate()) + ' ' + MON[d.getMonth()]
                        + ' ' + pad(h) + ':' + pad(d.getMinutes()) + ' ' + ampm;
                },

                // Colour code per departmental discharge-milestone type, for the
                // horizontal pills under the payment row.
                dischargePillClass(label) {
                    const M = {
                        'Clinically Discharged':       'bg-amber-50 text-amber-700 border-amber-200',
                        'Pharmacy Discharged':         'bg-emerald-50 text-emerald-700 border-emerald-200',
                        'Pharmacy Implant Discharged': 'bg-teal-50 text-teal-700 border-teal-200',
                        'OT Pharmacy Discharged':      'bg-purple-50 text-purple-700 border-purple-200',
                        'Lab Discharged':              'bg-sky-50 text-sky-700 border-sky-200',
                        'Radiology Discharged':        'bg-indigo-50 text-indigo-700 border-indigo-200',
                        'Billing Discharged':          'bg-rose-50 text-rose-700 border-rose-200',
                    };
                    return M[label] || 'bg-slate-50 text-slate-700 border-slate-200';
                },

                // "dd MMM yyyy hh:mm a" (e.g. 05 Jun 2026 09:30 am) — used for
                // the grid card's top meta bar. Same DB-native parsing as
                // fmtDateTime (space→'T' for Safari).
                fmtDateMon(value) {
                    if (!value) return '';
                    const iso = typeof value === 'string' ? value.replace(' ', 'T') : value;
                    const d = new Date(iso);
                    if (isNaN(d.getTime())) return String(value);
                    const pad = n => String(n).padStart(2, '0');
                    const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                    let h = d.getHours();
                    const ampm = h >= 12 ? 'pm' : 'am';
                    h = h % 12; if (h === 0) h = 12;
                    return pad(d.getDate())
                        + ' ' + MON[d.getMonth()]
                        + ' ' + d.getFullYear()
                        + ' ' + pad(h) + ':' + pad(d.getMinutes()) + ' ' + ampm;
                },

                // Date-only (dd-mm-yyyy) — used for the grid's date sub-headers.
                fmtDate(value) {
                    if (!value) return '';
                    const iso = typeof value === 'string' ? value.replace(' ', 'T') : value;
                    const d = new Date(iso);
                    if (isNaN(d.getTime())) return String(value);
                    const pad = n => String(n).padStart(2, '0');
                    return pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
                },

                // Group the viewer records for the grid: category → date → pages.
                // ORDER: categories in category order (the order records arrive —
                // the All view feeds them in category-display order; a single grid
                // is one category); dates newest-first; pages newest-first within
                // a date (datetime-wise). createdAt is DB-native 'YYYY-MM-DD HH:MM:SS'
                // so its string compares lexicographically = chronologically.
                groupedViewerRecords() {
                    const cats = [];
                    const catBy = {};
                    (this.viewerRecords || []).forEach((rec) => {
                        const label = this.recCatLabel(rec) || 'Pages';
                        const catKey = (rec.catId != null ? 'c' + rec.catId : 'l' + label);
                        let cat = catBy[catKey];
                        if (!cat) {
                            cat = { key: catKey, label, colorHex: this.recCatColorHex(rec), dates: [], _byDate: {} };
                            catBy[catKey] = cat;
                            cats.push(cat);
                        }
                        // YYYY-MM-DD (sortable) from createdAt; dd-mm-yyyy for display.
                        const ymd = String(rec.createdAt || '').slice(0, 10);
                        const dLabel = ymd ? (ymd.slice(8, 10) + '-' + ymd.slice(5, 7) + '-' + ymd.slice(0, 4)) : '—';
                        let dg = cat._byDate[ymd];
                        if (!dg) {
                            dg = { key: catKey + '|' + ymd, sortKey: ymd, label: dLabel, records: [] };
                            cat._byDate[ymd] = dg;
                            cat.dates.push(dg);
                        }
                        dg.records.push(rec);
                    });
                    const isAll = !!(this.viewerCategory && this.viewerCategory.isAll);
                    cats.forEach((cat) => {
                        if (isAll) {
                            // All view: order by the CONTINUOUS page number (1..total)
                            // — oldest date first, pages ascending by globalNo.
                            cat.dates.sort((a, b) => (a.sortKey || '').localeCompare(b.sortKey || ''));
                            cat.dates.forEach((dg) => {
                                dg.records.sort((a, b) => (a.globalNo || 0) - (b.globalNo || 0));
                            });
                        } else {
                            // Single category: datetime-wise, newest first.
                            cat.dates.sort((a, b) => (b.sortKey || '').localeCompare(a.sortKey || ''));
                            cat.dates.forEach((dg) => {
                                dg.records.sort((a, b) =>
                                    String(b.createdAt || '').localeCompare(String(a.createdAt || '')));
                            });
                        }
                    });
                    return cats;
                },

                // ── date-range picker ────────────────────────────────────
                // Local yyyy-mm-dd for a Date (no UTC shift). yyyy-mm-dd
                // strings compare lexicographically, so plain </> works for
                // range maths.
                _ymd(d) {
                    const pad = n => String(n).padStart(2, '0');
                    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
                },
                // dd-mm-yyyy for display from a yyyy-mm-dd string.
                dpDisplay(ymd) {
                    if (!ymd) return '';
                    const [y, m, d] = ymd.split('-');
                    return d + '-' + m + '-' + y;
                },
                // Open the dialog: seed working range from the committed
                // filter. Leave the start empty when no filter is set so the
                // first tap can pick ANY day — including past admission dates
                // (a patient may have been admitted before today). The view
                // still opens on the current month (anchor → dpToday).
                openDatePicker() {
                    const today = new Date();
                    this.dpToday = this._ymd(today);
                    this.dpFrom = this.filterDateFrom || '';
                    this.dpTo   = this.filterDateTo   || '';
                    const anchor = this.dpFrom || this.dpToday;
                    const [y, m] = anchor.split('-');
                    this.dpViewYear  = parseInt(y, 10);
                    this.dpViewMonth = parseInt(m, 10) - 1;
                    this.datePickerOpen = true;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                dpShiftMonth(delta) {
                    let m = this.dpViewMonth + delta;
                    let y = this.dpViewYear;
                    while (m < 0)  { m += 12; y -= 1; }
                    while (m > 11) { m -= 12; y += 1; }
                    this.dpViewMonth = m;
                    this.dpViewYear  = y;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },
                dpMonthLabel() {
                    const names = ['January','February','March','April','May','June',
                                   'July','August','September','October','November','December'];
                    return names[this.dpViewMonth] + ' ' + this.dpViewYear;
                },
                // Day cells for the view month: leading nulls pad to the
                // first weekday (Sun=0), then {day, ymd} objects.
                dpDays() {
                    const first = new Date(this.dpViewYear, this.dpViewMonth, 1);
                    const lead = first.getDay();
                    const daysInMonth = new Date(this.dpViewYear, this.dpViewMonth + 1, 0).getDate();
                    const cells = [];
                    for (let i = 0; i < lead; i++) cells.push(null);
                    for (let d = 1; d <= daysInMonth; d++) {
                        cells.push({ day: d, ymd: this._ymd(new Date(this.dpViewYear, this.dpViewMonth, d)) });
                    }
                    return cells;
                },
                // A day is disabled once a start is chosen (and no end yet)
                // if it falls before the start — no back-dated end date.
                dpDisabled(ymd) {
                    return !!this.dpFrom && !this.dpTo && ymd < this.dpFrom;
                },
                // True for days strictly between the two endpoints.
                dpInRange(ymd) {
                    return !!this.dpFrom && !!this.dpTo && ymd > this.dpFrom && ymd < this.dpTo;
                },
                // Range selection: first tap (or a tap after a complete
                // range) sets the start and clears the end; the next valid
                // tap sets the end. Earlier days are blocked by dpDisabled.
                dpSelectDay(ymd) {
                    if (this.dpDisabled(ymd)) return;
                    if (!this.dpFrom || (this.dpFrom && this.dpTo)) {
                        this.dpFrom = ymd;
                        this.dpTo = '';
                    } else {
                        // dpFrom set, dpTo empty, ymd >= dpFrom (earlier days
                        // are disabled). Tapping the start again yields a
                        // single-day range.
                        this.dpTo = ymd;
                    }
                },
                // Commit the working range and refetch. A start with no end
                // is treated as a single-day filter (to = from).
                dpApply() {
                    if (!this.dpFrom) return;
                    this.filterDateFrom = this.dpFrom;
                    this.filterDateTo   = this.dpTo || this.dpFrom;
                    this.datePickerOpen = false;
                    this.onFilterChange();
                },
                // Remove the committed date filter, reset the working range to
                // today, and refetch. Closes the dialog.
                dpClearFilter() {
                    this.filterDateFrom = '';
                    this.filterDateTo   = '';
                    this.dpFrom = '';
                    this.dpTo   = '';
                    this.datePickerOpen = false;
                    this.onFilterChange();
                },

                // ── init (called from x-init="init()") ──
                init() {
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    // Resolve the Device Id / Serial No for the Settings card in the
                    // background (best-effort; no-op when the device bridge is absent).
                    this._resolveDeviceIdentity();
                    // ── Native-wrapper fingerprint bridge (result hooks) ──
                    // A WebView wrapper that captures the thumb natively returns
                    // the image to the page by calling (via evaluateJavascript):
                    //   window.onThumbImpressionResult('<base64 or data: URL>')  on success
                    //   window.onThumbImpressionError('<message>')               on failure
                    // _captureThumbViaBridge() arms a one-shot resolver these
                    // hooks complete. Harmless no-op until a wrapper calls them.
                    window.onThumbImpressionResult = (data) => {
                        plog('info', 'thumb', 'wrapper result received (' + (data ? String(data).length : 0) + ' chars)');
                        const r = this._thumbBridgeResolve; this._thumbBridgeResolve = null;
                        if (r) r({ ok: true, data });
                    };
                    window.onThumbImpressionError = (msg) => {
                        plog('warn', 'thumb', 'wrapper error: ' + msg);
                        const r = this._thumbBridgeResolve; this._thumbBridgeResolve = null;
                        if (r) r({ ok: false, error: msg || 'Capture failed' });
                    };
                    // ── Native ML Kit Digital Ink Recognition (result hooks) ──
                    // _recognizeInk() posts the strokes to window.PrescoInk and
                    // awaits one of these. Same one-shot-resolver shape as the
                    // thumb bridge; harmless no-op outside the wrapper.
                    window.onInkRecognitionResult = (data) => {
                        plog('info', 'ink', 'wrapper result: ' + String(data === undefined ? '' : data).slice(0, 200));
                        const r = this._inkResolve; this._inkResolve = null;
                        if (r) r({ ok: true, data });
                    };
                    window.onInkRecognitionError = (msg) => {
                        plog('warn', 'ink', 'wrapper error: ' + msg);
                        const r = this._inkResolve; this._inkResolve = null;
                        if (r) r({ ok: false, error: msg || 'Recognition failed' });
                    };
                    // Network status. Coming back online, refresh the feeds that
                    // may have been rendered from cache while offline (and, in a
                    // later stage, flush the offline write queue).
                    // Safety net for exits that bypass the in-app guards (full
                    // reload, Refresh App, logout, tab close): warn via the
                    // browser's native prompt when the canvas has unsaved strokes.
                    // Every canvas surface must be listed here — IPD, Register Book
                    // AND Audit & Feedback each keep their own editor state.
                    window.addEventListener('beforeunload', (e) => {
                        if (this._hasUnsavedEdits() || this._rbHasUnsavedEdits() || this._afHasUnsavedEdits()) { e.preventDefault(); e.returnValue = ''; }
                    });
                    window.addEventListener('online', () => { plog('info', 'net', 'Browser online event'); this._recoverOnline(); });
                    window.addEventListener('offline', async () => {
                        // The DOM 'offline' event also fires spuriously on some
                        // WebViews/networks. Confirm with a real ping before showing
                        // any offline UI — if the backend still answers, ignore it.
                        if (await this._pingBackend(2500)) {
                            plog('info', 'net', 'Ignored spurious offline event — backend still reachable');
                            return;
                        }
                        this.isOnline = false;
                        plog('warn', 'net', 'Device offline — showing cached data, Live mode only');
                        // Only Live mode works offline. If the user was viewing
                        // History/Cancelled when the connection dropped, switch
                        // them back to Live so they aren't stranded on an uncached
                        // view (setPatientMode → loadPatients → offline census).
                        if (this.patientMode !== 'live') {
                            this.patientModeOpen = false;
                            this.setPatientMode('live');
                        }
                    });
                    // Connectivity-recovery poll. The browser's `online` event does
                    // NOT fire for a captive-portal / "connected but no real
                    // internet" → real-internet transition (navigator.onLine was
                    // true the whole time), so relying on it alone leaves the app
                    // stuck in Offline (cached) mode. Probe every 5s (down from 10s)
                    // so recovery from a real blip is quick; the ping is DB-free so
                    // the extra cadence is cheap. Re-probe on regaining focus too.
                    setInterval(() => {
                        this._probeConnectivityIfOffline();
                        this._detectLostConnectivity();
                        // Drain any pages saved offline as soon as we're back online.
                        if (navigator.onLine !== false && this.offlinePending > 0) this._flushWriteQueue();
                    }, 5000);
                    // Re-stamp the reactive clock every minute so the Live-mode
                    // hospitalization-duration labels tick up on their own.
                    setInterval(() => { this.nowTick = Date.now(); }, 60000);
                    document.addEventListener('visibilitychange', () => {
                        if (!document.hidden) this._probeConnectivityIfOffline();
                    });
                    // beforeinstallprompt may fire after Alpine init
                    window.addEventListener('pwa-installable', () => {
                        this.installAvailable = true;
                        this.$nextTick(() => window.lucide && window.lucide.createIcons());
                    });
                    window.addEventListener('pwa-installed', () => {
                        this.installAvailable = false;
                        this.isPwaInstalled = true;
                    });

                    // (The first patient's demo records are seeded lazily in
                    // _seedDemoCategories(), only when the design-review demo feeds
                    // are used — the live app starts with empty patients/categories
                    // so neither flashes before its real feed loads.)

                    // Edge-swipe gestures to open/close the side drawers.
                    this.initSwipeGestures();

                    // Show how many log entries are stored (Modules tab counter).
                    this.refreshLogCount();
                    plog('info', 'app', 'App initialised (online=' + navigator.onLine + ')');

                    // Surface any pages queued offline in a previous session and
                    // (if online) start uploading them.
                    this._initOfflineQueue();

                    // One-time wipe of the right-drawer offline cache (stale
                    // category list + cached form templates), THEN pull the
                    // logged-in user + hospital from the Laravel session via
                    // /pwa/api/me. Silent on failure so this PWA still works when
                    // hosted statically (no Laravel behind it).
                    Promise.all([this._clearDrawerCacheOnce(), this._clearLeftDrawerCacheOnce()])
                        .finally(() => this.loadMe());
                },

                // Touch swipe gestures for the side drawers:
                //   • swipe right from the LEFT screen edge  → open left (patients)
                //   • swipe left  from the RIGHT screen edge → open right (forms)
                //   • swipe the opposite way while a drawer is open → close it
                // Guards: ignored while the full-screen viewer or a modal is up,
                // and only fires for clearly-horizontal swipes past a threshold
                // so it never hijacks vertical list scrolling.
                initSwipeGestures() {
                    const EDGE   = 32;   // px from the edge to start an "open" swipe
                    const THRESH = 60;   // min horizontal travel to count as a swipe
                    const RATIO  = 1.3;  // horizontal must beat vertical by this factor
                    let startX = 0, startY = 0, tracking = false;

                    const onStart = (e) => {
                        // Block only while a modal overlay (date picker) is up.
                        // Edge-swipes open the drawers in EVERY mode now — incl.
                        // the viewer and the canvas editor — because the
                        // open-logic below still requires the swipe to START at
                        // the screen edge, so a middle swipe (detail page-flip /
                        // canvas drawing) is never hijacked.
                        if (this.datePickerOpen || this.pageLogsOpen) { tracking = false; return; }
                        const t = e.touches ? e.touches[0] : e;
                        startX = t.clientX;
                        startY = t.clientY;
                        tracking = true;
                    };
                    const onEnd = (e) => {
                        if (!tracking) return;
                        tracking = false;
                        const t  = e.changedTouches ? e.changedTouches[0] : e;
                        const dx = t.clientX - startX;
                        const dy = t.clientY - startY;

                        // Register Book Master window owns its OWN right drawer
                        // (rbRightOpen). While it's open, route edge swipes there and
                        // leave the IPD drawers alone. Skip while editing (the canvas
                        // handles pinch/pan touches itself).
                        if (this.rbOpen) {
                            // Editing (canvas pinch/pan) and the page viewer (its own
                            // swipe slider) handle their own touches — don't hijack them.
                            if (this.rbPageView === 'edit' || this.rbPageView === 'detail') return;
                            if (Math.abs(dx) < THRESH) return;
                            if (Math.abs(dx) < Math.abs(dy) * RATIO) return;
                            const rw = window.innerWidth;
                            if (dx < 0) {           // swipe right → left: open from the right edge
                                if (!this.rbRightOpen && startX >= rw - EDGE) this.rbRightOpen = true;
                            } else {                // swipe left → right: close it
                                if (this.rbRightOpen) this.rbRightOpen = false;
                            }
                            return;
                        }

                        // Audit & Feedback window owns its own right drawer (afRightOpen).
                        if (this.afOpen) {
                            if (this.afPageView === 'edit' || this.afPageView === 'detail') return;
                            if (Math.abs(dx) < THRESH) return;
                            if (Math.abs(dx) < Math.abs(dy) * RATIO) return;
                            const rwA = window.innerWidth;
                            if (dx < 0) {
                                if (!this.afRightOpen && startX >= rwA - EDGE) this.afRightOpen = true;
                            } else {
                                if (this.afRightOpen) this.afRightOpen = false;
                            }
                            return;
                        }

                        // Tap (not a swipe): open the drawer for the screen HALF
                        // tapped — left half → patients, right half → forms. Only
                        // when both drawers are closed, no full-screen viewer is up,
                        // the canvas editor isn't active, and the tap isn't on an
                        // interactive control / surface that needs the touch.
                        const TAP = 10;
                        if (Math.abs(dx) < TAP && Math.abs(dy) < TAP) {
                            if (this.leftOpen || this.rightOpen) return;
                            if (this.pdfOpen || this.fullFileOpen) return;
                            if (this.datePickerOpen || this.pageLogsOpen) return;
                            if (this.viewerMode === 'edit') return;
                            const tgt = e.target;
                            if (tgt && tgt.closest && tgt.closest(
                                'button, a, input, select, textarea, label, [role="button"], [contenteditable], canvas, iframe'
                            )) return;
                            if (t.clientX < window.innerWidth / 2) { this.leftOpen = true; }
                            else { this.rightOpen = true; }
                            return;
                        }

                        if (Math.abs(dx) < THRESH) return;            // too short
                        if (Math.abs(dx) < Math.abs(dy) * RATIO) return; // too vertical
                        const w = window.innerWidth;
                        // Opening a drawer over the full-screen PDF viewer (z-60,
                        // above the drawers) would leave the drawer hidden behind
                        // it — so close that viewer when an edge swipe opens a
                        // drawer (the user is navigating away anyway).
                        const openingDrawer = (dx > 0 && !this.rightOpen && !this.leftOpen && startX <= EDGE)
                                           || (dx < 0 && !this.leftOpen && !this.rightOpen && startX >= w - EDGE);
                        if (openingDrawer && this.pdfOpen) this.closePdfViewer();
                        if (dx > 0) {
                            // swipe right → close the right drawer, else open left from edge
                            if (this.rightOpen) this.rightOpen = false;
                            else if (!this.leftOpen && startX <= EDGE) this.leftOpen = true;
                        } else {
                            // swipe left → close the left drawer, else open right from edge
                            if (this.leftOpen) this.leftOpen = false;
                            else if (!this.rightOpen && startX >= w - EDGE) this.rightOpen = true;
                        }
                    };

                    window.addEventListener('touchstart', onStart, { passive: true });
                    window.addEventListener('touchend',   onEnd,   { passive: true });
                },

                // GET /pwa/api/me — flat JSON of session identity.
                // 401 means the session expired -> bounce back to the login
                // screen so the user re-authenticates.
                // Design-review fallback ONLY. When the PWA is opened without a
                // Laravel backend (a static / file:// host where ./api/me 404s or
                // is unreachable and there's no cached session), show the built-in
                // demo roster so the UI can still be reviewed. This is NEVER hit in
                // production: a real deployment answers /api/me with a session (or
                // 401 → login), so loadPatients() supplies the real feed and this
                // is skipped. No-ops once any real/cached data is present.
                _seedDemoPatients() {
                    if (this.patientsLive) return;
                    if (Array.isArray(this.patients) && this.patients.length) return;
                    this.patients = PATIENTS;
                    this.patientsLoading = false;
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Design-review fallback for the right-drawer category list — same
                // no-backend conditions as _seedDemoPatients(). Seeds the stub
                // FORM_CATEGORIES plus the first patient's demo records so the
                // page-count badges look right. Never runs in production.
                _seedDemoCategories() {
                    if (this.categoriesLive) return;
                    if (Array.isArray(this.categories) && this.categories.length) return;
                    this.categories = FORM_CATEGORIES;
                    this.categoriesLoading = false;
                    // Seed records for the first patient using the hardcoded counts
                    // from the spec screenshot so the demo "looks right".
                    this._patientRecords[PATIENTS[0].id] = {};
                    this.categories.forEach((cat) => {
                        if (cat.count > 0) {
                            this._patientRecords[PATIENTS[0].id][cat.i] = this.buildStubRecords(cat);
                        }
                    });
                    this.$nextTick(() => window.lucide && window.lucide.createIcons());
                },

                // Seed BOTH demo feeds together — used by every no-backend path.
                _seedDemoData() {
                    this._seedDemoPatients();
                    this._seedDemoCategories();
                },

                async loadMe() {
                    // Offline fast-path — but only when CONFIRMED offline. We used
                    // to branch on navigator.onLine === false alone, which is false
                    // for the first few seconds of an Android WebView cold start even
                    // on a healthy network, so the app always booted into offline
                    // mode and recovered ~10s later. _looksOffline() confirms with a
                    // real ping first, so a healthy connection goes straight online.
                    if (await this._looksOffline()) {
                        this.isOnline = false;   // confirmed offline — keep the flag honest
                        const cachedMe = this._loadCachedMe();
                        if (cachedMe && cachedMe.user_id) {
                            this.me = cachedMe;
                            this.csrfToken = '';
                            this.$nextTick(() => window.lucide && window.lucide.createIcons());
                            this.loadCategories();   // network-first, IndexedDB fallback
                            this.loadStamps();
                            this.loadPatients();     // offline fast-path restores census
                        } else {
                            // Offline cold start with no cached session — clear the
                            // loading state (falls back to the demo feeds).
                            this._seedDemoData();
                        }
                        return;
                    }
                    try {
                        const resp = await fetch('./api/me', {
                            credentials: 'same-origin',
                            cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
                        if (resp.status === 401) {
                            // Session ended server-side — clear the cached identity
                            // so the offline fast-path can't resurrect it, then go
                            // to login.
                            this._clearCachedMe();
                            window.location.assign('./login');
                            return;
                        }
                        if (!resp.ok) {
                            // A static host with no backend 404s ./api/me → show the
                            // design-review demo feeds. A real server that errors
                            // (5xx etc.) must NEVER show fake patients/categories —
                            // just clear the loading states and leave them empty.
                            if (resp.status === 404) { this._seedDemoData(); }
                            else { this.patientsLoading = false; this.categoriesLoading = false; }
                            return;
                        }
                        const data = await resp.json();
                        if (data && typeof data === 'object') {
                            this.me = {
                                user_id:        data.user_id       ?? null,
                                user_name:      data.user_name     || '',
                                user_type:      data.user_type     || '',
                                email_id:       data.email_id      || '',
                                mobile_no:      data.mobile_no     || '',
                                // SHA-256 of the hospital eraser password, cached at
                                // login so the eraser prompt validates instantly
                                // (and offline) without a per-attempt round-trip.
                                eraser_password_hash: data.eraser_password_hash || '',
                                // Web-push VAPID public key (empty = push disabled).
                                vapid_public_key: data.vapid_public_key || '',
                                // Audit gate passwords (SHA-256; '' = unset) + the
                                // per-hospital float-register flag. Cached at login
                                // for future use (persisted with the rest of `me`).
                                audit_password_hash:       data.audit_password_hash       || '',
                                super_audit_password_hash: data.super_audit_password_hash || '',
                                // Per-hospital 0/1 feature flags (cached with `me`).
                                want_float_register:       parseInt(data.want_float_register, 10)  || 0,
                                timestamp_in_seal:         parseInt(data.timestamp_in_seal, 10)    || 0,
                                photo_watermark:           parseInt(data.photo_watermark, 10)      || 0,
                                no_ipd_file_activity:      parseInt(data.no_ipd_file_activity, 10) || 0,
                                consult_wise_pt_only:      parseInt(data.consult_wise_pt_only, 10) || 0,
                                // Patient-history buttons on the patient card — each
                                // shows ONLY when its mst_hospital flag is 1. Cached
                                // with the rest of `me` (localStorage 'pwa.me'), so
                                // the list renders correctly offline; the cache is
                                // rewritten at login and by the Refresh-app button.
                                patient_history_display:   parseInt(data.patient_history_display, 10) || 0,
                                opd_history:               parseInt(data.opd_history, 10)             || 0,
                                hospital_id:      data.hospital_id   ?? null,
                                hospital_name:    data.hospital_name || '',
                                // Deployment base = APP_URL from env (carries the
                                // /v1/ipd prefix); used to build absolute CMS links
                                // like the patient discharge-form.
                                app_url:          data.app_url        || '',
                                // Application-tool grants for patient add/edit/discharge
                                // (other_permissions p_id 81/83/79; roles 1/2/10 bypass).
                                can_add_new_patient:     !!data.can_add_new_patient,
                                can_edit_patient:        !!data.can_edit_patient,
                                can_discharge_patient:   !!data.can_discharge_patient,
                                can_register_book:       !!data.can_register_book,
                                can_ipd_page_templates:  !!data.can_ipd_page_templates,
                                // App-bar icons on a saved page: template (p_id 93)
                                // and star (p_id 94). Each is hidden without its grant.
                                can_page_template_icon:  !!data.can_page_template_icon,
                                can_star_page_template:  !!data.can_star_page_template,
                                // Diet Records: update (p_id 22) / delete (23).
                                can_update_diet:         !!data.can_update_diet,
                                can_delete_diet:         !!data.can_delete_diet,
                                // gm_user_master.doctor_type — 3 works on Diet
                                // Records of any date; others only on today's.
                                doctor_type:             Number(data.doctor_type) || 0,
                                // No active diet type for this hospital → the
                                // Diet Records row is hidden from the drawer.
                                has_diet_types:          !!data.has_diet_types,
                                can_lock_pages:          !!data.can_lock_pages,
                                can_unlock_pages:        !!data.can_unlock_pages,
                                can_transfer_page:       !!data.can_transfer_page,
                                can_edit_pages:          !!data.can_edit_pages,
                                can_delete_pages:        !!data.can_delete_pages,
                                can_clone_pages:         !!data.can_clone_pages,
                                can_copy_paste_pages:    !!data.can_copy_paste_pages,
                                can_change_stroke:       !!data.can_change_stroke,
                                can_use_stamps:          !!data.can_use_stamps,
                                can_add_remark_dir:      !!data.can_add_remark_dir,
                                can_view_page_log:       !!data.can_view_page_log,
                                can_use_eraser:          !!data.can_use_eraser,
                                can_eraser_password:     !!data.can_eraser_password,
                                can_rb_eraser:           !!data.can_rb_eraser,
                                can_edit_discharged_anytime: !!data.can_edit_discharged_anytime,
                                discharge_edit_validity_hours: parseInt(data.discharge_edit_validity_hours, 10) || 24,
                                can_lock_category:       !!data.can_lock_category,
                                can_unlock_category:     !!data.can_unlock_category,
                                can_digital_nursing:     !!data.can_digital_nursing,
                                can_digital_requisition: !!data.can_digital_requisition,
                                can_daily_billing:       !!data.can_daily_billing,
                                can_digital_notes:       !!data.can_digital_notes,
                                can_operative_notes:     !!data.can_operative_notes,
                                can_discharge_summary:   !!data.can_discharge_summary,
                                can_other_documents:     !!data.can_other_documents,
                                can_lab_reports:         !!data.can_lab_reports,
                                can_radiology_reports:   !!data.can_radiology_reports,
                                can_cardiology_records:  !!data.can_cardiology_records,
                                can_audio_video:         !!data.can_audio_video,
                                can_bill_records:        !!data.can_bill_records,
                                hide_bill_records:       !!data.hide_bill_records,
                                hide_cardiology_records: !!data.hide_cardiology_records,
                                hide_admission_form:     !!data.hide_admission_form,
                                hide_recycle_bin:        !!data.hide_recycle_bin,
                                hide_mrd_checklist:      !!data.hide_mrd_checklist,
                                hide_other_documents:    !!data.hide_other_documents,
                                hide_lab_reports:        !!data.hide_lab_reports,
                                hide_radiology_reports:  !!data.hide_radiology_reports,
                                hide_audio_records:      !!data.hide_audio_records,
                                hide_video_records:      !!data.hide_video_records,
                                hide_created_datetime:   !!data.hide_created_datetime,
                                hide_modified_datetime:  !!data.hide_modified_datetime,
                                hide_patient_modes:      !!data.hide_patient_modes,
                                read_only:               !!data.read_only,
                                share_bill:       !!data.share_bill,       del_bill:       !!data.del_bill,
                                share_cardiology: !!data.share_cardiology, del_cardiology: !!data.del_cardiology,
                                share_lab:        !!data.share_lab,        del_lab:        !!data.del_lab,
                                share_radiology:  !!data.share_radiology,  del_radiology:  !!data.del_radiology,
                                share_other:      !!data.share_other,      del_other:      !!data.del_other,
                                share_av:         !!data.share_av,         del_av:         !!data.del_av,
                            };
                            this.csrfToken = data.csrf_token || '';
                            // Persist identity so a later OFFLINE cold-start can
                            // still resolve the user + hospital and render the
                            // cached category list (see the catch below).
                            this._persistMe(this.me);
                            this.$nextTick(() => window.lucide && window.lucide.createIcons());

                            // Now that we know the session is live, swap the
                            // demo patient + category lists out for the real
                            // feeds. Fire in parallel — they don't depend on
                            // each other. Masters (Floor/Dept/Ward dropdowns)
                            // load alongside so the filter row populates
                            // before the user opens the drawer.
                            if (this.me.user_id) {
                                this.loadPatients();
                                this.loadCategories();
                                this.loadMasters();
                                this.loadStamps();
                                // Snapshot the COMPLETE Live census in the
                                // background so ALL live patients are visible
                                // offline, not just the on-screen page.
                                this.prefetchAllLivePatients();
                                // Pull the hospital's employees + face embeddings
                                // (server-proxied) and cache them for offline
                                // face login.
                                this.loadEmployees();
