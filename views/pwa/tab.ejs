                    try { w = window.open(url, '_blank', 'noopener'); } catch (_) { w = null; }
                    if (!w) { window.location.assign(url); }
                },
                // Copy the resolved Device Id (same value shown on the login +
                // home screens) to the clipboard. No-op when it's unresolved.
                copyDeviceId() {
                    if (!this.deviceId) return;
                    try {
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(this.deviceId);
                        }
                    } catch (_) {}
                    this.showToast('Device Id copied');
                },
                // Log out by submitting a POST form to ./logout. The shell is static
                // HTML, so its boot-time CSRF token (from ./api/me) can be EMPTY or
                // stale after an offline-looking Android WebView cold start — which
                // is what produced the 419 Page Expired. To fix it permanently we
                // fetch a FRESH token for the CURRENT session immediately before
                // posting, so the token always matches. (/pwa/logout is also
                // CSRF-exempt server-side as a second safety net.)
                async _doLogout() {
                    // Purge the cached identity FIRST so a later cold start can't
                    // restore this account even if the POST is delayed.
                    this._clearCachedMe();
                    // Grab a fresh CSRF token for this session (SW bypasses /api/,
                    // so this is always a live network fetch). Offline → keep
                    // whatever we have and let the exempt route accept it.
                    let token = this.csrfToken || '';
                    try {
                        const r = await fetch('./api/me', {
                            credentials: 'same-origin', cache: 'no-store',
                            headers: { 'Accept': 'application/json' },
                        });
